@using Microsoft.AspNetCore.Components.Web
@using QMgr.Web.Services
@inject NavigationManager Navigation
@inject IOrganizationApiService OrganizationApi

<!DOCTYPE html>
@*
    data-theme is stamped here, on the host document, for the public display screens.

    It has to be here rather than only on DisplayLayout/KioskLayout because prerendering is off
    (see <Routes> below): with no prerender, nothing a layout renders reaches the first paint, so
    a display screen would show the default dark chrome until the circuit connects — the
    first-paint flash Phase 62 fixed. App.razor is server-rendered on every request regardless of
    render mode, so this is the one place that survives it.

    The layouts still set data-theme on their own wrapper. That is not redundant: this covers the
    window before the circuit connects, theirs covers everything after, and the inner value wins
    for its subtree. Null renders no attribute at all, so admin pages are untouched and keep
    setting their own theme from localStorage.
*@
@* The tenant's palette goes on <html>, for the same reason data-theme does: this file is
   server-rendered on every request whatever the render mode, so it is the ONE place that colours
   the pixels shown before any layout has rendered. Without it the "Initializing…" splash, and the
   first paint of every public page, are Q-Mgr's wine on a school's own domain — which is the most
   visible place the white-labelling can leak. Empty on the platform host, where the shell's own
   wrapper still brands the signed-in view. *@
<html lang="en" data-theme="@_publicDisplayTheme" style="@_host.BrandingStyle">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@_host.AppName" />
    <meta name="application-name" content="@_host.AppName" />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="msapplication-TileColor" content="@(_host.Branding.PrimaryColor ?? ProductMark.WineDark)" />
    <meta name="description" content="@(_host.IsTenantHost ? $"{_host.AppName} — {ProductBrand.Tagline}." : $"{ProductBrand.Name} — {ProductBrand.Description}")" />
    <base href="/" />
    @*
        PWA manifest. One endpoint for every host since the rebrand (Program.cs, /app-manifest.json): on a
        tenant host it carries THEIR app name and icon, on ours it carries ProductBrand.Name. The static
        manifest.json it replaced typed the product name twice and linked a route that never existed.
    *@
    <link rel="manifest" href="/app-manifest.json" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Poppins:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Radzen (for components only) -->
    <link rel="stylesheet" href="@Assets["_content/Radzen.Blazor/css/material-base.css"]" />
    <!-- PDF flip-book viewer. page-flip 2.0.7 ships no dist/css (the URL this used to point at is
         a 404, which is why the book rendered at zero size for months) — its stylesheet is
         vendored into pdf-flipbook.css along with the viewer's own chrome. -->
    <link rel="stylesheet" href="@Assets["css/pdf-flipbook.css"]" />
    <!-- Custom Styles -->
    <link rel="stylesheet" href="@Assets["css/layout.css"]" />
    <link rel="stylesheet" href="@Assets["css/qm-theme.css"]" />
    <link rel="stylesheet" href="@Assets["css/q-components.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <!-- Component Styles -->
    <link rel="stylesheet" href="@Assets["css/components/admin.css"]" />
    <link rel="stylesheet" href="@Assets["css/doc-page.css"]" />
    <link rel="stylesheet" href="@Assets["css/auth-pages.css"]" />
    <!-- Favicons and Icons -->
    @* A tenant host wears the tenant's favicon where they have uploaded one; everything else falls
       back to ours, per icon rather than all-or-nothing, so a school with a logo and no favicon
       still gets a sensible tab. *@
    @if (_host.IsTenantHost && !string.IsNullOrWhiteSpace(_host.Branding.FaviconUrl))
    {
        <link rel="icon" href="@_host.Branding.FaviconUrl" />
        <link rel="apple-touch-icon" href="@_host.Branding.FaviconUrl" />
    }
    else
    {
        @* Ours, all under /brand/ (ProductBrand.Assets): the SVGs are drawn from ProductMark on request,
           the PNGs are rendered from them by scripts/brand/render-brand-assets.mjs. *@
        <link rel="icon" type="image/svg+xml" href="@ProductBrand.Assets.Favicon" />
        <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
        <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
        <link rel="mask-icon" href="@ProductBrand.Assets.MarkMono" color="@ProductMark.WineDark" />
    }
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    @*
        Prerendering is OFF (2026-09-06), and the reason is the login page.

        With it on, Blazor server-renders the login form as a REAL native <form method="post">
        with live inputs, before the circuit exists. Anything typed into that form in that window
        is discarded the moment Blazor takes over and re-renders from an empty model, and pressing
        Enter submits it natively — a full page load. That is the long-standing "the login page
        reloads while I am typing" report, root-caused here. Measured: static POST forms on /login
        went 1 -> 0 and served <input> elements 10 -> 0 with this flag.

        Login.razor and its three siblings each declared prerender:false themselves for exactly
        this reason and it never did anything — a page-level @rendermode inside an
        already-interactive subtree is silently ignored, and the mode was fixed here at the root.
        Putting the mode on the LAYOUTS instead is not an option either: a layout takes its page
        as a RenderFragment in Body, and the framework refuses to pass a delegate across a
        render-mode boundary ("Cannot pass the parameter 'Body' ... cannot be serialized").
        Per-page modes with a static <Routes> would work, but then MainLayout renders statically
        and the whole admin shell — sidebar, notifications, branch switcher — goes dead.

        The cost of turning it off is the first-paint flash on the public display screens, which
        is why data-theme is stamped on <html> above: that path is server-rendered regardless of
        render mode, so those screens keep a correct first paint without prerendering.
    *@
    @* Viewer carries the browser's address and user agent into the circuit (see ViewerRequestInfo):
       this host request is the only place the Web app ever sees them. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" Viewer="_viewer" TenantHost="_host" />

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss"><i class="bi bi-x-lg"></i></a>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js"]"></script>
    <script src="@Assets["js/layout.js"]"></script>
    <script src="@Assets["js/mediaPlayer.js"]"></script>
    <script src="@Assets["js/print-service.js"]"></script>
    <script src="@Assets["js/share-utils.js"]"></script>
    <script src="@Assets["js/q-select.js"]"></script>
    <script src="@Assets["js/brand.js"]"></script>
    <script src="@Assets["js/qFileUpload.js"]"></script>
    <!-- PDF flip-book viewer. pdf.js (~340KB) and page-flip are NOT loaded here: this file runs on
         every page of the app, and only a handful ever show a PDF. pdfFlipbook.js injects both the
         first time a flipbook is actually opened. -->
    <script src="@Assets["js/pdfFlipbook.js"]"></script>
    <!-- "Publish to Library" on the printable reports: renders the report to a PDF in the
         browser (html2pdf, loaded on demand from the CDN) and uploads it. Client-side only —
         no PDF renderer on the server, per the no-server-dependencies rule. -->
    <script src="@Assets["js/reportPublish.js"]"></script>
    <!-- Spotify Web Playback SDK (background music for image-gallery signage) -->
    <script src="@Assets["js/spotifyPlayer.js"]"></script>
    <script src="https://sdk.scdn.co/spotify-player.js"></script>
    <!-- Visitor badge QR: generation (qrcodejs) and camera-based scanning (jsQR) -->
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
    <script src="@Assets["js/visitorBadge.js"]"></script>
    <!-- Client-side Excel/CSV parsing for roster bulk import (SheetJS — parses in the browser, no server-side dependency) -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="@Assets["js/rosterImport.js"]"></script>
    <script src="@Assets["js/importDocuments.js"]"></script>
    <script src="@Assets["js/dataExport.js"]"></script>
    <script src="@Assets["js/notificationSound.js"]"></script>
    <script src="@Assets["js/calendarView.js"]"></script>
    <script src="@Assets["js/planPdf.js"]"></script>
    <script src="@Assets["js/qStackTable.js"]"></script>
    <!-- Ambient falling-bar backdrop for public auth/document pages -->
    <script src="@Assets["js/ambientBackground.js"]"></script>
    <!-- PWA Service Worker Registration -->
    <script src="@Assets["js/pwa.js"]"></script>
</body>
</html>

@code {
    /// <summary>
    /// "dark"/"light" for a public display screen, else null (which renders no attribute).
    /// </summary>
    private string? _publicDisplayTheme;

    /// <summary>The host request, available here because this file is statically server-rendered on every request.</summary>
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private ViewerRequestInfo? _viewer;

    /// <summary>
    /// Which host this browser arrived on. Resolved HERE and nowhere else — this file is the only
    /// one in the app that can see Request.Host at all, and on a Blazor Server circuit there is no
    /// request left to read afterwards. Defaults to the platform look, which is also what every
    /// failure below falls back to.
    /// </summary>
    private TenantHostContext _host = TenantHostContext.Platform;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);

        if (HttpContext != null)
        {
            // Behind nginx the real address is the first X-Forwarded-For entry; locally it is the
            // connection's. The API truncates it before storing.
            var forwarded = HttpContext.Request.Headers["X-Forwarded-For"].FirstOrDefault()?.Split(',').FirstOrDefault()?.Trim();
            var ip = string.IsNullOrWhiteSpace(forwarded) ? HttpContext.Connection.RemoteIpAddress?.ToString() : forwarded;
            _viewer = new ViewerRequestInfo(ip, HttpContext.Request.Headers.UserAgent.ToString());
        }

        // The tenant host. One API call per request, cached API-side by the feature resolver, and
        // it answers "not a tenant domain" for the platform's own host in a single indexed lookup.
        // Deliberately NOT gated on a route allowlist the way the display-theme fetch below is:
        // the host is the same for every page, and the sign-in page is exactly the one that needs it.
        var requestHost = HttpContext?.Request.Host.Host;
        if (!string.IsNullOrWhiteSpace(requestHost))
        {
            var branding = await OrganizationApi.GetBrandingForHostAsync(requestHost);
            _host = new TenantHostContext(requestHost, branding);
        }

        // Gated on the route allowlist, not merely on "the path contains a GUID": this runs for
        // every request in the app, and /admin/students/{studentId}/picture would otherwise fetch
        // branding for a student id on every admin page load.
        if (!PublicDisplayRoute.IsPublicDisplay(uri.AbsolutePath))
            return;

        var branchId = PublicDisplayRoute.BranchIdFromUri(uri);
        if (branchId is null)
            return;

        try
        {
            var branding = await OrganizationApi.GetBranchBrandingAsync(branchId.Value);
            _publicDisplayTheme = branding.DisplayTheme is "light" ? "light" : "dark";
        }
        catch
        {
            // The host document must render even if the API is unreachable. Leaving this null
            // falls back to the app's dark-first default, which is what the screen showed before
            // this existed — a themed screen is worth a round-trip, never worth a blank page.
        }
    }
}
