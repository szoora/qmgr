        public string Name { get; set; } = "";
        public string Address { get; set; } = "";
    }

    private class NotificationItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public string Type { get; set; } = "info";
        public string? IconClass { get; set; }
        public string? ActionUrl { get; set; }
        public DateTime CreatedAt { get; set; }
        public bool IsRead { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        clockTimer?.Dispose();

        // Unsubscribe from notification events
        NotificationHub.OnNotificationReceived -= HandleNewNotification;
        NotificationHub.OnUnreadCountUpdated -= HandleUnreadCountUpdate;
        NotificationHub.OnPermissionsChanged -= HandlePermissionsChanged;

        if (moduleStateSubscribed)
        {
            ModuleState.OnChanged -= HandleModuleStateChanged;
        }

        if (moduleGuardSubscribed)
        {
            NavigationManager.LocationChanged -= HandleLocationChangedForModuleGuard;
        }

        // Stop the SignalR connection
        await NotificationHub.StopAsync();
    }
