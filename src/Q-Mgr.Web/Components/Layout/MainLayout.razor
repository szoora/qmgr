@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject IPermissionService PermissionService
@inject IQueueApiService QueueApi
@inject IJSRuntime JSRuntime
@inject IBranchStateService BranchState
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject INotificationApiService NotificationApi
@inject INotificationClientService NotificationHub
@inject IToastService ToastService
@inject AuthenticationStateProvider AuthStateProvider
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Shared
@using QMgr.Web.Services
@inject ILocalStorageService LocalStorage
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IAppInitializationService AppInit
@inject IConfiguration Configuration

@* Show loading state until authentication is determined *@
@if (!authChecked)
{
    <div class="qm-app-loading" data-theme="@currentTheme">
        <div class="loading-content">
            <img src="/images/icon-512.svg" alt="Q-Mgr" class="loading-logo" />
            <div class="spinner-border text-primary mt-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="loading-text mt-2">Initializing...</p>
        </div>
        <style>
            .qm-app-loading {
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                background: var(--bg-color);
            }
            .loading-content {
                text-align: center;
            }
            .loading-logo {
                display: block;
                margin: 0 auto;
                width: 80px;
                height: 80px;
            }
            .loading-text {
                color: var(--text-secondary);
            }
        </style>
    </div>
}
else
{
<div class="qm-app" data-theme="@currentTheme">
    <!-- Top Header -->
    <header class="qm-header">
        <div class="header-left">
            <button class="sidebar-toggle" @onclick="ToggleSidebar">
                <i class="bi bi-list"></i>
            </button>
            <a href="/" @onclick="CollapseSidebarOnMobile" class="brand">
                <span class="brand-logo">
                    <img src="/images/icon-512@(currentTheme == "light" ? "-light" : "").svg" alt="Q-Mgr" />
                </span>
                <span class="brand-text">Q-Mgr</span>
            </a>
        </div>

        <div class="header-right">
            <!-- Server Connection Status -->
            <ConnectionIndicator />

            <!-- Theme Toggle -->
            <button class="header-btn" @onclick="ToggleTheme" title="@(currentTheme == "dark" ? "Switch to Light Mode" : "Switch to Dark Mode")">
                <i class="bi @(currentTheme == "dark" ? "bi-sun" : "bi-moon-stars")"></i>
            </button>

            <!-- Notifications -->
            <div class="header-notifications">
                <button class="header-btn" @onclick="ToggleNotifications">
                    <i class="bi bi-bell"></i>
                    @if (notificationCount > 0)
                    {
                        <span class="notification-badge">@(notificationCount > 99 ? "99+" : notificationCount.ToString())</span>
                    }
                </button>
            </div>

            <!-- Date/Time -->
            <div class="header-datetime">
                <span class="date">@currentDateTime.ToString("ddd, MMM dd")</span>
                <span class="time">@currentDateTime.ToString("HH:mm")</span>
            </div>

            <!-- User Dropdown -->
            <div class="dropdown">
                <button class="user-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">
                        <span>@(currentUser?.FullName?.Substring(0, 1).ToUpper() ?? "U")</span>
                    </div>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-header">@(currentUser?.FullName ?? "User")</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                    <li><a class="dropdown-item" href="admin/settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                    <li><a class="dropdown-item" href="@ApiDocsUrl" target="_blank"><i class="bi bi-book me-2"></i>API Documentation</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#" @onclick="Logout" @onclick:preventDefault><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <aside class="qm-sidebar @(sidebarExpanded ? "expanded" : "collapsed")">
        <nav class="sidebar-nav">
            <ul class="nav-menu">
                @if (canViewDashboard)
                {
                    <li class="nav-item">
                        <a href="/" @onclick="CollapseSidebarOnMobile" class="nav-link @(IsActive("/") ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                }

                <!-- Queue Management -->
                @if ((canViewQueue || canManageQueue) && HasModule(ModuleCodes.CoreQueue))
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("queue") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("queue"))" @onclick:preventDefault>
                            <i class="bi bi-people"></i>
                            <span>Queue Management</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="queue/board" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/queue/board") ? "active" : "")"><i class="bi bi-view-list"></i>Live Queue Board</a></li>
                            <li><a href="admin/appointments" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/appointments") ? "active" : "")"><i class="bi bi-calendar-check"></i>Appointments</a></li>
                            @if (canManageQueue)
                            {
                                <li><a href="queue/counter" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/queue/counter") ? "active" : "")"><i class="bi bi-display"></i>Counter Terminal</a></li>
                            }
                            <li><a href="@($"kiosk/branch/{BranchState.CurrentBranchId}")" @onclick="CollapseSidebarOnMobile" class="@(IsActive($"/kiosk/branch/{BranchState.CurrentBranchId}") ? "active" : "")"><i class="bi bi-hand-index-thumb"></i>Self-Service Kiosk</a></li>
                            <li><a href="@($"queue/display/{BranchState.CurrentBranchId}")" @onclick="CollapseSidebarOnMobile" class="@(IsActive($"/queue/display/{BranchState.CurrentBranchId}") ? "active" : "")"><i class="bi bi-tv"></i>Customer Display</a></li>
                        </ul>
                    </li>
                }

                @* These were one "Visitor & Safeguarding" group until the module was split. They are
                   separate now because they sell separately: a bank or clinic buys the visitor book
                   and never opens a welfare ledger, and "safeguarding" is school language that means
                   nothing to them. A school buys both and sees both groups. *@
                @if (canViewVisitors && HasModule(ModuleCodes.VisitorManagement))
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("visitor-management") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("visitor-management"))" @onclick:preventDefault>
                            <i class="bi bi-person-badge"></i>
                            <span>Visitor Management</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="admin/visitors" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/visitors") ? "active" : "")"><i class="bi bi-person-badge"></i>Visitors On Site</a></li>
                            <li><a href="admin/visitors/expected" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/visitors/expected") ? "active" : "")"><i class="bi bi-calendar-check"></i>Expected Visitors</a></li>
                            @* Roll-call has to be findable in a hurry, so it earns its own row
                               rather than living behind a menu on the visitor page. *@
                            <li><a href="admin/visitors/evacuation" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/visitors/evacuation") ? "active" : "")"><i class="bi bi-fire"></i>Evacuation Roll-Call</a></li>
                        </ul>
                    </li>
                }

                @if ((canViewStudents || canViewWelfare || canViewWelfareReports) && HasModule(ModuleCodes.StudentWelfare))
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("student-welfare") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("student-welfare"))" @onclick:preventDefault>
                            <i class="bi bi-mortarboard-fill"></i>
                            <span>Student Welfare</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            @if (canViewStudents)
                            {
                                <li><a href="admin/visitors/roster" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/visitors/roster") ? "active" : "")"><i class="bi bi-people-fill"></i>Student Roster</a></li>
                            }
                            @if (canViewWelfare)
                            {
                                <li><a href="admin/welfare-categories" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/welfare-categories") ? "active" : "")"><i class="bi bi-clipboard2-pulse"></i>Welfare Categories</a></li>
                                <li><a href="admin/welfare-my-actions" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/welfare-my-actions") ? "active" : "")"><i class="bi bi-check2-circle"></i>My Welfare Actions</a></li>
                            }
                            @if (canViewWelfareReports)
                            {
                                <li><a href="admin/welfare-reports" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/welfare-reports") ? "active" : "")"><i class="bi bi-bar-chart-line-fill"></i>Welfare Reports</a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Integrations & API Access (was one buried line inside Administration) -->
                @if (canViewApiClients && HasModule(ModuleCodes.IntegrationsApi))
                {
                    <li class="nav-item">
                        <a href="admin/api-clients" @onclick="CollapseSidebarOnMobile" class="nav-link @(IsActive("/admin/api-clients") ? "active" : "")">
                            <i class="bi bi-braces"></i>
                            <span>Integrations & API</span>
                        </a>
                    </li>
                }

                <!-- Engagement & Communications (Digital Signage + Campaign Marketing + Feedback —
                     one module, was 3 scattered nav homes before: a "Digital Signage" submenu, a
                     standalone "Campaign Marketing" item, and Feedback split between Reports &
                     Administration. Matches the Visitor & Safeguarding / Integrations & API
                     consolidation pattern below. -->
                @if ((canViewContent || canViewMarketing || canViewFeedback) && HasModule(ModuleCodes.EngagementCommunications))
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("engagement") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("engagement"))" @onclick:preventDefault>
                            <i class="bi bi-broadcast"></i>
                            <span>Engagement & Communications</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            @if (canViewContent)
                            {
                                <li><a href="content/media" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/content/media") ? "active" : "")"><i class="bi bi-images"></i>Media Library</a></li>
                                <li><a href="content/playlists" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/content/playlists") ? "active" : "")"><i class="bi bi-music-note-list"></i>Playlists</a></li>
                                <li><a href="content/campaigns" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/content/campaigns") ? "active" : "")"><i class="bi bi-easel-fill"></i>Display Campaigns</a></li>
                                <li><a href="content/zones" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/content/zones") ? "active" : "")"><i class="bi bi-grid-3x3"></i>Display Zones</a></li>
                                <li><a href="content/schedules" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/content/schedules") ? "active" : "")"><i class="bi bi-calendar-week"></i>Schedules</a></li>
                                <li><a href="@($"display/signage/{BranchState.CurrentBranchId}")" @onclick="CollapseSidebarOnMobile" class="@(IsActive($"/display/signage/{BranchState.CurrentBranchId}") ? "active" : "")"><i class="bi bi-fullscreen"></i>Full-Screen Signage</a></li>
                            }
                            @if (canViewMarketing)
                            {
                                <li><a href="admin/marketing" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/marketing") ? "active" : "")"><i class="bi bi-megaphone-fill"></i>Campaign Marketing</a></li>
                            }
                            @if (canViewFeedback)
                            {
                                <li><a href="admin/feedback" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/feedback") ? "active" : "")"><i class="bi bi-chat-dots"></i>Feedback Management</a></li>
                                <li><a href="reports/feedback" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/reports/feedback") ? "active" : "")"><i class="bi bi-bar-chart-line-fill"></i>Feedback Reports</a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Reports & Analytics -->
                @* Every report belongs to some module, so the whole group disappears rather than
                   opening onto an empty submenu when none of them are available. *@
                @if (canViewReports && (ModuleAllows("/reports") || (canViewVisitors && ModuleAllows("/reports/visitors"))))
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("reports") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("reports"))" @onclick:preventDefault>
                            <i class="bi bi-graph-up"></i>
                            <span>Reports & Analytics</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            @if (ModuleAllows("/reports"))
                            {
                                <li><a href="reports" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/reports") ? "active" : "")"><i class="bi bi-bar-chart"></i>Overview</a></li>
                            }
                            @if (ModuleAllows("/reports/queue"))
                            {
                                <li><a href="reports/queue" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/reports/queue") ? "active" : "")"><i class="bi bi-activity"></i>Queue Analytics</a></li>
                                <li><a href="reports/counters" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/reports/counters") ? "active" : "")"><i class="bi bi-speedometer"></i>Counter Performance</a></li>
                            }
                            @if (canViewVisitors && ModuleAllows("/reports/visitors"))
                            {
                                <li><a href="reports/visitors" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/reports/visitors") ? "active" : "")"><i class="bi bi-person-badge"></i>Visitors</a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Administration -->
                @if (CanViewAdminSection)
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("admin") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("admin"))" @onclick:preventDefault>
                            <i class="bi bi-shield-lock"></i>
                            <span>Administration</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            @if (canViewBranches)
                            {
                                <li><a href="admin/branches" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/branches") ? "active" : "")"><i class="bi bi-building"></i>Branches</a></li>
                            }
                            @* Every item below pairs its RBAC check with ModuleAllows, which reads the
                               same ModuleRouteMap the navigation guard and the API middleware use — so
                               an item is visible exactly when it is reachable. Branches, Users & Roles,
                               Industry, Branding, Notifications and System Settings carry no module:
                               they are base product, available to every tenant. *@
                            @if (canViewCounters && ModuleAllows("/admin/counters"))
                            {
                                <li><a href="admin/counters" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/counters") ? "active" : "")"><i class="bi bi-door-open"></i>Counters Setup</a></li>
                            }
                            @if (canViewServiceTypes && ModuleAllows("/admin/service-types"))
                            {
                                <li><a href="admin/service-types" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/service-types") ? "active" : "")"><i class="bi bi-tags"></i>Service Types</a></li>
                            }
                            @if (canViewUsers || canViewRoles)
                            {
                                <li><a href="admin/users" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/users") ? "active" : "")"><i class="bi bi-people-fill"></i>Users & Roles</a></li>
                            }
                            @if (canViewSettings && ModuleAllows("/admin/printer-settings"))
                            {
                                <li><a href="admin/printer-settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/printer-settings") ? "active" : "")"><i class="bi bi-printer"></i>Printer Settings</a></li>
                                <li><a href="admin/kiosk-settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/kiosk-settings") ? "active" : "")"><i class="bi bi-display"></i>Kiosk Settings</a></li>
                            }
                            @if (canViewSettings)
                            {
                                <li><a href="admin/industry" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/industry") ? "active" : "")"><i class="bi bi-buildings"></i>Industry Settings</a></li>
                                <li><a href="admin/branding-settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/branding-settings") ? "active" : "")"><i class="bi bi-palette"></i>Branding Settings</a></li>
                            }
                            @if (canViewSettings && ModuleAllows("/admin/integrations"))
                            {
                                <li><a href="admin/integrations" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/integrations") ? "active" : "")"><i class="bi bi-plug"></i>Integrations</a></li>
                            }
                            @if (canViewSettings && ModuleAllows("/admin/customer-links"))
                            {
                                <li><a href="admin/customer-links" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/customer-links") ? "active" : "")"><i class="bi bi-share"></i>Customer Links</a></li>
                            }
                            @if (canViewNotifications)
                            {
                                <li><a href="admin/notification-settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/notification-settings") ? "active" : "")"><i class="bi bi-bell-fill"></i>Notifications</a></li>
                            }
                            @if (canViewSettings)
                            {
                                <li><a href="admin/settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/settings") ? "active" : "")"><i class="bi bi-sliders"></i>System Settings</a></li>
                            }
                        </ul>
                    </li>
                }

                <!-- Billing & Subscription -->
                @if (canViewBilling)
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("billing") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("billing"))" @onclick:preventDefault>
                            <i class="bi bi-credit-card"></i>
                            <span>Billing</span>
                            @if (unpurchasedModuleCount > 0)
                            {
                                <span class="nav-badge" title="@unpurchasedModuleCount module(s) available">@unpurchasedModuleCount</span>
                            }
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="billing/overview" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/overview") ? "active" : "")"><i class="bi bi-grid"></i>Overview</a></li>
                            <li>
                                <a href="billing/modules" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/modules") ? "active" : "")">
                                    <i class="bi bi-grid-3x3-gap-fill"></i>Modules
                                    @if (unpurchasedModuleCount > 0)
                                    {
                                        <span class="nav-badge">@unpurchasedModuleCount</span>
                                    }
                                </a>
                            </li>
                            <li><a href="billing/subscription" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/subscription") ? "active" : "")"><i class="bi bi-star"></i>Legacy Plan (deprecated)</a></li>
                            <li><a href="billing/invoices" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/invoices") ? "active" : "")"><i class="bi bi-receipt"></i>Invoices</a></li>
                            <li><a href="billing/payment-methods" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/payment-methods") ? "active" : "")"><i class="bi bi-wallet2"></i>Payment Methods</a></li>
                            <li><a href="billing/usage" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/billing/usage") ? "active" : "")"><i class="bi bi-bar-chart-line"></i>Usage & Limits</a></li>
                        </ul>
                    </li>
                }

                <!-- Platform Administration (SuperAdmin only) -->
                @if (canViewPlatformAdmin)
                {
                    <li class="nav-item has-submenu @(IsMenuExpanded("platform") ? "open" : "")">
                        <a href="#" class="nav-link" @onclick="@(() => ToggleMenu("platform"))" @onclick:preventDefault>
                            <i class="bi bi-cpu"></i>
                            <span>Platform Admin</span>
                            <i class="bi bi-chevron-down submenu-arrow"></i>
                        </a>
                        <ul class="submenu">
                            <li><a href="platform/dashboard" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/platform/dashboard") ? "active" : "")"><i class="bi bi-speedometer2"></i>Platform Dashboard</a></li>
                            <li><a href="platform/tenants" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/platform/tenants") ? "active" : "")"><i class="bi bi-building"></i>Tenant Management</a></li>
                            <li><a href="admin/platform-settings" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/platform-settings") ? "active" : "")"><i class="bi bi-gear"></i>Platform Settings</a></li>
                            <li><a href="admin/platform-spotify" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/platform-spotify") ? "active" : "")"><i class="bi bi-spotify"></i>Spotify Integration</a></li>
                            <li><a href="admin/docs" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/admin/docs") ? "active" : "")"><i class="bi bi-journal-richtext"></i>Docs Management</a></li>
                            <li><a href="platform/analytics" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/platform/analytics") ? "active" : "")"><i class="bi bi-graph-up-arrow"></i>Platform Analytics</a></li>
                            <li><a href="platform/system-health" @onclick="CollapseSidebarOnMobile" class="@(IsActive("/platform/system-health") ? "active" : "")"><i class="bi bi-heart-pulse"></i>System Health</a></li>
                        </ul>
                    </li>
                }
            </ul>
        </nav>

        <!-- Branch Selector -->
        <div class="sidebar-footer">
            <div class="branch-selector" @onclick="ShowBranchSelector">
                <i class="bi bi-building"></i>
                <div class="branch-info">
                    <span class="branch-label">Current Branch</span>
                    <span class="branch-name">@(currentBranch?.Name ?? "Select branch")</span>
                </div>
                <i class="bi bi-chevron-expand"></i>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="qm-main @(sidebarExpanded ? "" : "expanded")">
        <div class="page-container">
            @Body
        </div>

        <!-- Footer -->
        <footer class="qm-footer">
            <span>&copy; @DateTime.Now.Year Q-Mgr Queue Management System</span>
            <div class="footer-links">
                <a href="@ApiDocsUrl" target="_blank">API Docs</a>
                <span class="version">v1.0.0</span>
            </div>
        </footer>
    </main>

    <!-- Branch Selector Modal -->
    <QModal Visible="@showBranchDialog" VisibleChanged="@((bool v) => showBranchDialog = v)" Title="@((isSuperAdmin && selectedSuperAdminOrgId == null) ? "Select Organization" : "Select Branch")" Icon="building" Size="md" NoPadding="true">
        <ChildContent>
            @if (isSuperAdmin && selectedSuperAdminOrgId == null)
            {
                @if (loadingSuperAdminOrgs)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-hourglass-split fs-1 d-block mb-2"></i>
                        <p class="mb-0">Loading organizations...</p>
                    </div>
                }
                else if (!superAdminOrgOptions.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-building fs-1 d-block mb-2"></i>
                        <p class="mb-0">No organizations found</p>
                    </div>
                }
                else
                {
                    <div class="branch-list">
                        @foreach (var org in superAdminOrgOptions)
                        {
                            <div class="branch-item" @onclick="() => SelectSuperAdminOrg(org)">
                                <i class="bi bi-building"></i>
                                <div class="branch-item-info">
                                    <span class="branch-item-name">@org.Name</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                @if (isSuperAdmin)
                {
                    <div class="px-3 pt-3 pb-1">
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="ChangeSuperAdminOrg">
                            <i class="bi bi-arrow-left"></i> Change organization (@selectedSuperAdminOrgName)
                        </button>
                    </div>
                }
                @if (!availableBranches.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-building fs-1 d-block mb-2"></i>
                        <p class="mb-2">No branches available</p>
                        <small>Please configure branches in Administration &gt; Branches</small>
                    </div>
                }
                else
                {
                    <div class="branch-list">
                        @foreach (var branch in availableBranches)
                        {
                            <div class="branch-item @(branch.Id == currentBranch?.Id ? "active" : "")" @onclick="() => SelectBranch(branch)">
                                <i class="bi @(branch.Id == currentBranch?.Id ? "bi-check-circle-fill" : "bi-building")"></i>
                                <div class="branch-item-info">
                                    <span class="branch-item-name">@branch.Name</span>
                                    <span class="branch-item-address">@branch.Address</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </ChildContent>
    </QModal>

    <!-- Notifications Panel -->
    @if (showNotifications)
    {
        <div class="modal-backdrop show" @onclick="() => showNotifications = false"></div>
        <div class="notifications-panel">
            <div class="notifications-header">
                <h6>Notifications</h6>
                <QButton Text="Mark all read" Icon="check2-all" Variant="link" Size="sm" OnClick="MarkAllRead" />
            </div>
            <div class="notifications-list">
                @if (!notifications.Any())
                {
                    <div class="notifications-empty">
                        <i class="bi bi-bell-slash"></i>
                        <span>No new notifications</span>
                    </div>
                }
                else
                {
                    @foreach (var notification in notifications)
                    {
                        <div class="notification-item @(notification.IsRead ? "" : "unread")">
                            <div class="notification-icon @notification.Type">
                                <i class="bi @GetNotificationIcon(notification.Type)"></i>
                            </div>
                            <div class="notification-content">
                                <span class="notification-title">@notification.Title</span>
                                <span class="notification-message">@notification.Message</span>
                                <span class="notification-time">@HumanizeDateTime(notification.CreatedAt)</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Connection Lost Overlay -->
    <ConnectionOverlay />
</div>

<ToastHost />
}

@code {
    private bool authChecked = false;
    private bool sidebarExpanded = true;
    private UserInfo? currentUser;
    private bool isSuperAdmin = false;
    private string currentTheme = "light";
    private DateTime currentDateTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;
    private HashSet<string> expandedMenus = new() { "queue" };

    // Branch selector
    private BranchInfo? currentBranch;
    private List<BranchInfo> availableBranches = new();
    private bool showBranchDialog = false;

    // SuperAdmin has no branches of their own (their tenant context is the Platform org), so
    // GET api/v1/branches always comes back empty for them - they pick an organization first,
    // same pattern as the "Add User" org picker (UsersSetup.razor), then branches are loaded
    // for that specific org via BranchesController's organizationId override param.
    private List<OrgOption> superAdminOrgOptions = new();
    private Guid? selectedSuperAdminOrgId;
    private string? selectedSuperAdminOrgName;
    private bool loadingSuperAdminOrgs = false;

    // Notifications
    private int notificationCount = 0;
    private bool showNotifications = false;
    private List<NotificationItem> notifications = new();

    // Permissions - cached for menu visibility
    private bool canViewDashboard = false;
    private bool canViewQueue = false;
    private bool canManageQueue = false;
    private bool canViewContent = false;
    private bool canViewReports = false;
    private bool canViewBranches = false;
    private bool canViewCounters = false;
    private bool canViewServiceTypes = false;
    private bool canViewUsers = false;
    private bool canViewRoles = false;
    private bool canViewSettings = false;
    private bool canViewNotifications = false;
    private bool canViewApiClients = false;
    private bool canViewFeedback = false;
    private bool canViewVisitors = false;
    private bool canViewStudents = false;
    private bool canViewWelfare = false;
    private bool canViewWelfareReports = false;
    private bool canViewMarketing = false;
    private bool canViewBilling = false;
    private bool canViewPlatformAdmin = false;

    // Modular subscription system: which of the 4 modules this org currently has active.
    // SuperAdmin bypasses this entirely (sees everything, same bypass used everywhere else).
    // Backed by IModuleStateService (scoped, shared with Modules.razor) rather than local fields,
    // so a purchase/removal made from the Modules page updates this layout's nav/badge live
    // instead of staying stale until a full page reload — MainLayout persists across navigation
    // in Blazor Server and never re-runs OnInitializedAsync on its own.
    private int unpurchasedModuleCount => ModuleState.UnpurchasedCount;
    // Fails open when the module list could not be fetched: an empty set then means "we don't
    // know", not "you own nothing", and hiding a customer's paid features during an API blip is
    // worse than briefly showing an item the API would refuse anyway.
    private bool HasModule(string moduleCode) =>
        isSuperAdmin || !ModuleState.LoadSucceeded || ModuleState.ActiveModuleCodes.Contains(moduleCode);
    private bool tokensInitialized = false;
    private string ApiDocsUrl = "/api/docs";

    protected override async Task OnInitializedAsync()
    {
        // During pre-rendering, TokenStorageService is empty and localStorage isn't available
        // We'll load everything in OnAfterRenderAsync instead
        currentUser = await AuthService.GetCurrentUserAsync();

        // If we have a user from TokenStorageService (already logged in this session)
        if (currentUser != null)
        {
            isSuperAdmin = await PermissionService.IsSuperAdminAsync();

            // Load permissions for menu visibility
            await LoadPermissionsAsync();
            await LoadActiveModulesAsync();

            // Load branches
            await LoadBranches();

            // Load notifications
            await LoadNotifications();

            await BuildApiDocsUrlAsync();

            // Mark auth as checked since we already have a user
            authChecked = true;
            tokensInitialized = true;
        }
        // If no user, don't set authChecked yet - wait for OnAfterRenderAsync to load tokens from localStorage

        // Start clock timer
        clockTimer = new System.Threading.Timer(async _ =>
        {
            currentDateTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        // Load theme preference (works even without auth)
        // This will be called after first render when JS interop is available
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load theme from localStorage (requires JS interop)
            try
            {
                var savedTheme = await LocalStorage.GetItemAsync<string>("qmgr-theme");
                if (!string.IsNullOrEmpty(savedTheme))
                {
                    currentTheme = savedTheme;
                }
                await JSRuntime.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme', '{currentTheme}')");
            }
            catch { }

            // Start collapsed on a phone/tablet viewport - the sidebar renders as a
            // full-screen overlay below 993px (see layout.css), so defaulting it open
            // would cover the page the user is trying to look at on first load.
            try
            {
                if (await JSRuntime.InvokeAsync<bool>("qmgrLayout.isMobileViewport"))
                {
                    sidebarExpanded = false;
                    StateHasChanged();
                }
            }
            catch { }
        }

        if (firstRender && !tokensInitialized)
        {
            try
            {
                // Load tokens from localStorage into TokenStorageService on first render
                // This is when JavaScript interop is available
                await AppInit.InitializeAsync();
                tokensInitialized = true;

                // Reload user info now that tokens are available
                currentUser = await AuthService.GetCurrentUserAsync();

                // If we now have a user, refresh the UI
                if (currentUser != null)
                {
                    isSuperAdmin = await PermissionService.IsSuperAdminAsync();
                    await LoadPermissionsAsync();
                    await LoadBranches();
                    await LoadNotifications();
                    await BuildApiDocsUrlAsync();

                    // Mark auth as checked and show the app
                    authChecked = true;
                    StateHasChanged();
                }
                else
                {
                    // No auth found, redirect to login
                    // Get the current path for return URL
                    var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                    if (string.IsNullOrEmpty(currentPath) ||
                        currentPath.StartsWith("login", StringComparison.OrdinalIgnoreCase) ||
                        currentPath.StartsWith("unauthorized", StringComparison.OrdinalIgnoreCase))
                    {
                        NavigationManager.NavigateTo("/login", forceLoad: true);
                    }
                    else
                    {
                        NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString("/" + currentPath)}", forceLoad: true);
                    }
                }
            }
            catch (Exception ex)
            {
                // Log error and redirect to login
                Console.WriteLine($"Error loading auth state: {ex.Message}");
                NavigationManager.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    private async Task LoadBranches()
    {
        await BranchState.InitializeAsync();

        try
        {
            // Load branches from API
            var response = await Http.GetAsync("api/v1/branches");
            if (response.IsSuccessStatusCode)
            {
                var apiBranches = await response.Content.ReadFromJsonAsync<List<BranchApiDto>>(JsonOptions);
                availableBranches = apiBranches?.Select(b => new BranchInfo
                {
                    Id = b.Id,
                    Name = b.Name,
                    Address = b.Address ?? ""
                }).ToList() ?? new List<BranchInfo>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                // BUG FIX: a 403 here (e.g. Staff, which has no branches.view permission by
                // design) previously fell straight through to the code below with
                // availableBranches still empty, which Dashboard.razor reads as "this
                // organization has zero branches" and shows the "create your first branch"
                // onboarding wizard - wrong and confusing for a Staff user whose org already
                // has branches and who is already assigned to one. Fall back to the caller's
                // own AssignedBranchId/Name via ProfileController.GetProfile, which - unlike
                // BranchesController - is self-scoped and needs no special permission.
                var profileResponse = await Http.GetAsync("api/v1/profile");
                if (profileResponse.IsSuccessStatusCode)
                {
                    var profile = await profileResponse.Content.ReadFromJsonAsync<ProfileBranchDto>(JsonOptions);
                    if (profile?.AssignedBranchId != null)
                    {
                        availableBranches = new List<BranchInfo>
                        {
                            new BranchInfo { Id = profile.AssignedBranchId.Value, Name = profile.AssignedBranchName ?? "My Branch" }
                        };
                    }
                }
            }
        }
        catch
        {
            // Fallback to empty list if API fails
            availableBranches = new List<BranchInfo>();
        }

        // Update branch availability in state service
        BranchState.SetBranchAvailability(availableBranches.Count);

        // Set current branch if branches exist
        if (availableBranches.Any())
        {
            currentBranch = availableBranches.FirstOrDefault(b => b.Id == BranchState.CurrentBranchId)
                            ?? availableBranches.FirstOrDefault();

            // Update BranchState if we selected a branch
            if (currentBranch != null && BranchState.CurrentBranchId != currentBranch.Id)
            {
                await BranchState.SetBranchAsync(currentBranch.Id, currentBranch.Name);
            }
        }
    }

    private record BranchApiDto
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
        public string? Address { get; init; }
        public bool IsActive { get; init; }
    }

    private record ProfileBranchDto
    {
        public Guid? AssignedBranchId { get; init; }
        public string? AssignedBranchName { get; init; }
    }

    private async Task LoadNotifications()
    {
        try
        {
            // Fetch notifications from API
            var apiNotifications = await NotificationApi.GetNotificationsAsync(false, 20);
            notifications = apiNotifications.Select(n => new NotificationItem
            {
                Id = n.Id,
                Title = n.Title,
                Message = n.Message,
                Type = MapNotificationType(n.Type),
                IconClass = n.IconClass,
                CreatedAt = n.CreatedAt,
                IsRead = n.IsRead,
                ActionUrl = n.ActionUrl
            }).ToList();

            notificationCount = await NotificationApi.GetUnreadCountAsync();

            // Connect to SignalR for real-time updates. BUG FIX: RenderMode.InteractiveServer
            // prerenders by default, so OnInitializedAsync (and therefore LoadNotifications)
            // genuinely runs twice per page load — once during the static prerender pass,
            // once again for the real interactive circuit. Each invocation used to open its
            // own live HubConnection (they're separate component/DI-scope instances, so the
            // Phase 15 per-instance dedup fix in NotificationClientService doesn't cover this
            // case), so a single server-side notification broadcast rendered as 2 duplicate
            // entries — confirmed live: 1 real DB row, 2 items in the dropdown, on a single
            // fresh page load. Only ever open the connection for the real interactive circuit.
            if (currentUser != null && RendererInfo.IsInteractive)
            {
                await ConnectToNotificationHub(currentUser.Id);
            }
        }
        catch
        {
            // Fallback to empty notifications if API fails
            notifications = new List<NotificationItem>();
            notificationCount = 0;
        }
    }

    private async Task LoadPermissionsAsync()
    {
        canViewDashboard = await PermissionService.HasPermissionAsync(Permissions.DashboardView);
        canViewQueue = await PermissionService.HasPermissionAsync(Permissions.QueueView);
        canManageQueue = await PermissionService.HasPermissionAsync(Permissions.QueueManage);
        canViewContent = await PermissionService.HasPermissionAsync(Permissions.ContentView);
        canViewReports = await PermissionService.HasPermissionAsync(Permissions.ReportsView);
        canViewBranches = await PermissionService.HasPermissionAsync(Permissions.BranchesView);
        canViewCounters = await PermissionService.HasPermissionAsync(Permissions.CountersView);
        canViewServiceTypes = await PermissionService.HasPermissionAsync(Permissions.ServiceTypesView);
        canViewUsers = await PermissionService.HasPermissionAsync(Permissions.UsersView);
        canViewRoles = await PermissionService.HasPermissionAsync(Permissions.RolesView);
        canViewSettings = await PermissionService.HasPermissionAsync(Permissions.SettingsView);
        canViewNotifications = await PermissionService.HasPermissionAsync(Permissions.NotificationsView);
        canViewApiClients = await PermissionService.HasPermissionAsync(Permissions.ApiClientsView);
        canViewFeedback = await PermissionService.HasPermissionAsync(Permissions.FeedbackView);
        canViewVisitors = await PermissionService.HasPermissionAsync(Permissions.VisitorsView);
        canViewStudents = await PermissionService.HasPermissionAsync(Permissions.StudentsView);
        canViewWelfare = await PermissionService.HasPermissionAsync(Permissions.WelfareView);
        canViewWelfareReports = await PermissionService.HasPermissionAsync(Permissions.WelfareReportsView);
        canViewMarketing = await PermissionService.HasPermissionAsync(Permissions.MarketingView);
        canViewBilling = await PermissionService.HasPermissionAsync(Permissions.BillingView);
        canViewPlatformAdmin = await PermissionService.HasPermissionAsync(Permissions.PlatformAdmin);
    }

    // An unpurchased module is fully invisible in the nav (per explicit direction — a per-module
    // "locked" row doesn't scale past a handful of modules). The only nav-level advertising signal
    // is the count badge on "Billing" below, which opens the Modules marketplace where they're
    // actually named. SuperAdmin never goes through this at all (HasModule short-circuits true).
    private bool moduleStateSubscribed = false;

    private async Task LoadActiveModulesAsync()
    {
        if (isSuperAdmin) return;

        if (!moduleStateSubscribed)
        {
            ModuleState.OnChanged += HandleModuleStateChanged;
            moduleStateSubscribed = true;
        }

        await ModuleState.LoadAsync(ModuleApi);

        // Hiding a nav item is not access control — the page is still one pasted URL away. This
        // layout wraps every authenticated page, so guarding here covers all of them at once and
        // cannot drift from the sidebar, since both read ModuleRouteMap.
        if (!moduleGuardSubscribed)
        {
            NavigationManager.LocationChanged += HandleLocationChangedForModuleGuard;
            moduleGuardSubscribed = true;
        }
        EnforceModuleAccessForCurrentPage();
    }

    private void HandleModuleStateChanged()
    {
        // A module the tenant just removed should also close any page they are sitting on.
        InvokeAsync(() =>
        {
            EnforceModuleAccessForCurrentPage();
            StateHasChanged();
        });
    }

    private bool moduleGuardSubscribed;

    private void HandleLocationChangedForModuleGuard(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(EnforceModuleAccessForCurrentPage);

    /// <summary>
    /// Sends the user to the Modules marketplace if the page they are on belongs to a module their
    /// organization has not bought, rather than letting the page load and fail piecemeal against a
    /// wall of 403s from the API.
    /// </summary>
    private void EnforceModuleAccessForCurrentPage()
    {
        // Until the module list has actually loaded — or if the call failed — everything would
        // look unpurchased, so never redirect on that basis. The API enforces this regardless.
        if (!ModuleState.IsLoaded || !ModuleState.LoadSucceeded || isSuperAdmin) return;

        var path = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var required = ModuleRouteMap.RequiredModuleForPage(path);
        if (required == null || ModuleState.ActiveModuleCodes.Contains(required)) return;

        ToastService.Notify(
            ToastSeverity.Info,
            "Module required",
            canViewBilling
                ? "That feature belongs to a module your organization hasn't added yet."
                : "That feature isn't included in your organization's current modules. Ask an administrator to add it.");

        // Only send people to the marketplace if they could actually buy something there; staff
        // without billing access would just bounce off that page's own permission check.
        NavigationManager.NavigateTo(canViewBilling ? "/billing/modules" : "/");
    }

    /// <summary>
    /// Whether a nav item pointing at <paramref name="path"/> should be shown. Permission checks
    /// stay with the caller; this only answers the subscription half.
    /// </summary>
    private bool ModuleAllows(string path)
    {
        var required = ModuleRouteMap.RequiredModuleForPage(path);
        return required == null || HasModule(required);
    }

    // BUG FIX: this link previously pointed at the API's internal ApiBaseUrl - correct for Web's
    // own server-side HTTP calls, but that value is an unreachable loopback address (127.0.0.1)
    // from the *browser's* point of view in production. ApiPublicUrl is a distinct config value
    // set to the real public hostname (see build-linux.ps1). The API docs route now also requires
    // login (Program.cs), and a plain browser navigation carries no Authorization header, so the
    // current access token is appended as ?access_token= - the same query-string mechanism this
    // app already uses for SignalR hub negotiation.
    private async Task BuildApiDocsUrlAsync()
    {
        try
        {
            var publicUrl = Configuration["ApiPublicUrl"] ?? Http.BaseAddress!.ToString();
            var token = await AuthService.GetAccessTokenAsync();
            // Trailing slash deliberate: Scalar 302-redirects "/api/docs" -> "/api/docs/", and
            // that redirect drops the ?access_token= query string entirely, so the browser's
            // follow-up request arrives unauthenticated. Requesting the already-canonical
            // trailing-slash URL sidesteps the redirect (and the dropped token) altogether.
            var baseDocsUrl = new Uri(new Uri(publicUrl), "/api/docs/").ToString();
            ApiDocsUrl = string.IsNullOrEmpty(token)
                ? baseDocsUrl
                : $"{baseDocsUrl}?access_token={Uri.EscapeDataString(token)}";
        }
        catch { }
    }

    // Helper property to check if admin section should be visible
    private bool CanViewAdminSection =>
        canViewBranches || canViewCounters || canViewServiceTypes || canViewWelfare || canViewWelfareReports ||
        canViewUsers || canViewRoles || canViewSettings ||
        canViewNotifications || canViewApiClients || canViewFeedback;

    private async Task ConnectToNotificationHub(Guid userId)
    {
        try
        {
            // BUG FIX: this method can genuinely run more than once for the same circuit
            // (OnInitializedAsync during prerendering, then again in OnAfterRenderAsync for
            // the real interactive circuit — and possibly a further retry if the first
            // StartAsync attempt fails, which the web-run.log confirmed actually happens:
            // "Failed to connect" immediately followed by a later successful "Connected" on
            // the same page load). `+=` is not idempotent — subscribing twice registers the
            // same handler twice, so a single server-side broadcast fires HandleNewNotification
            // twice and renders as 2 duplicate entries even though only one HubConnection ends
            // up alive (confirmed live: 1 real DB row, 2 items in the dropdown, on a single
            // fresh page load, with the server log showing exactly one successful "Connected").
            // Unsubscribe first so re-entry can never double-register.
            NotificationHub.OnNotificationReceived -= HandleNewNotification;
            NotificationHub.OnUnreadCountUpdated -= HandleUnreadCountUpdate;
            NotificationHub.OnPermissionsChanged -= HandlePermissionsChanged;
            NotificationHub.OnNotificationReceived += HandleNewNotification;
            NotificationHub.OnUnreadCountUpdated += HandleUnreadCountUpdate;
            NotificationHub.OnPermissionsChanged += HandlePermissionsChanged;

            // Start the connection
            await NotificationHub.StartAsync(userId, currentBranch?.Id);
        }
        catch
        {
            // Silently fail - notifications will still work via polling
        }
    }

    /// <summary>
    /// An admin changed this user's role or the role's permissions. Re-fetch the permission set
    /// and rebuild the nav flags so buttons and menu items stop reflecting the old role. Server-
    /// side checks already enforce the new set; this only closes the client-side UI lag.
    /// </summary>
    private async Task HandlePermissionsChanged()
    {
        await InvokeAsync(async () =>
        {
            await PermissionService.RefreshAsync();
            await LoadPermissionsAsync();
            if (AuthStateProvider is CustomAuthenticationStateProvider provider)
            {
                provider.NotifyAuthenticationStateChanged();
            }
            ToastService.Notify(ToastSeverity.Info, "Access updated", "Your permissions were changed by an administrator. Menus and actions have been refreshed.");
            StateHasChanged();
        });
    }

    private async Task HandleNewNotification(NotificationDto notification)
    {
        await InvokeAsync(() =>
        {
            notifications.Insert(0, new NotificationItem
            {
                Id = notification.Id,
                Title = notification.Title,
                Message = notification.Message,
                Type = MapNotificationType(notification.Type),
                IconClass = notification.IconClass,
                CreatedAt = notification.CreatedAt,
                IsRead = notification.IsRead,
                ActionUrl = notification.ActionUrl
            });

            // Keep only the latest 20 notifications
            if (notifications.Count > 20)
            {
                notifications = notifications.Take(20).ToList();
            }

            notificationCount++;
            StateHasChanged();
        });
    }

    private async Task HandleUnreadCountUpdate(int count)
    {
        await InvokeAsync(() =>
        {
            notificationCount = count;
            StateHasChanged();
        });
    }

    private static string MapNotificationType(string type) => type switch
    {
        "TokenCreated" => "info",
        "TokenCalled" => "success",
        "TokenReminder" => "warning",
        "TokenCancelled" => "error",
        "SystemAlert" => "warning",
        "CounterAlert" => "warning",
        _ => "info"
    };

    private void ToggleSidebar()
    {
        sidebarExpanded = !sidebarExpanded;
    }

    // On mobile the sidebar renders as a full-screen overlay (see layout.css's
    // max-width:576px rules), so it must close itself after a real navigation -
    // previously only the hamburger button could open/close it, so every tap on a
    // nav link left the overlay covering the page it just navigated to.
    private async Task CollapseSidebarOnMobile()
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("qmgrLayout.isMobileViewport"))
            {
                sidebarExpanded = false;
            }
        }
        catch { }
    }

    private async Task ToggleTheme()
    {
        currentTheme = currentTheme == "dark" ? "light" : "dark";
        try
        {
            await LocalStorage.SetItemAsync("qmgr-theme", currentTheme);
            // Apply theme to html element for Radzen dialogs
            await JSRuntime.InvokeVoidAsync("eval", $"document.documentElement.setAttribute('data-theme', '{currentTheme}')");
        }
        catch { }
        StateHasChanged();
    }

    private void ToggleMenu(string menuKey)
    {
        if (expandedMenus.Contains(menuKey))
            expandedMenus.Remove(menuKey);
        else
            expandedMenus.Add(menuKey);
    }

    private bool IsMenuExpanded(string menuKey) => expandedMenus.Contains(menuKey);

    // Exact match only — a StartsWith fallback used to live here to catch dynamic-segment routes
    // (Customer Display/Full-Screen Signage append a branch ID the nav link itself doesn't know
    // ahead of time), but it silently double-highlighted any nav item whose route was a literal
    // string-prefix of another item's, e.g. "/admin/visitors" matching "/admin/visitors/roster",
    // or "Overview" (/reports) matching every other /reports/* sub-page. Callers with a genuinely
    // dynamic route now pass the fully-resolved path (same one used in their own href) instead.
    private bool IsActive(string path)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(currentPath)) currentPath = "/";
        else currentPath = "/" + currentPath;

        return currentPath.Equals(path, StringComparison.OrdinalIgnoreCase);
    }

    private async Task ShowBranchSelector()
    {
        showBranchDialog = true;
        if (isSuperAdmin && selectedSuperAdminOrgId == null)
        {
            await LoadSuperAdminOrganizations();
        }
    }

    private async Task LoadSuperAdminOrganizations()
    {
        if (superAdminOrgOptions.Any()) return;
        loadingSuperAdminOrgs = true;
        try
        {
            var response = await Http.GetAsync("api/v1/admin/tenants?pageSize=200");
            if (response.IsSuccessStatusCode)
            {
                var paged = await response.Content.ReadFromJsonAsync<PagedResultDto<TenantSummaryDto>>(JsonOptions);
                superAdminOrgOptions = paged?.Items.Select(o => new OrgOption { Id = o.Id, Name = o.Name }).ToList() ?? new();
            }
        }
        catch
        {
            superAdminOrgOptions = new();
        }
        loadingSuperAdminOrgs = false;
    }

    private async Task SelectSuperAdminOrg(OrgOption org)
    {
        selectedSuperAdminOrgId = org.Id;
        selectedSuperAdminOrgName = org.Name;
        availableBranches = new();
        try
        {
            var response = await Http.GetAsync($"api/v1/branches?organizationId={org.Id}");
            if (response.IsSuccessStatusCode)
            {
                var apiBranches = await response.Content.ReadFromJsonAsync<List<BranchApiDto>>(JsonOptions);
                availableBranches = apiBranches?.Select(b => new BranchInfo
                {
                    Id = b.Id,
                    Name = b.Name,
                    Address = b.Address ?? ""
                }).ToList() ?? new();
            }
        }
        catch
        {
            availableBranches = new();
        }
        BranchState.SetBranchAvailability(availableBranches.Count);
    }

    private void ChangeSuperAdminOrg()
    {
        selectedSuperAdminOrgId = null;
        selectedSuperAdminOrgName = null;
        availableBranches = new();
    }

