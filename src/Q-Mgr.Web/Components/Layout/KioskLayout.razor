@inherits LayoutComponentBase
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using QMgr.Web.Services
@inject IOrganizationApiService OrganizationApi
@inject NavigationManager Navigation
@inject IBranchStateService BranchState
@inject AuthenticationStateProvider AuthStateProvider

<div class="kiosk-layout" data-theme="@displayTheme" style="@brandingStyle">
    @Body
</div>

<ToastHost />

<style>
    .kiosk-layout {
        min-height: 100vh;
        overflow: hidden;
    }
</style>

@code {
    private string brandingStyle = string.Empty;
    private string displayTheme = "dark";

    // Same resolution as DisplayLayout (and as KioskMode/FeedbackEntry themselves):
    // route GUID -> ?branch= -> signed-in user's selected branch -> null. A @layout can't
    // receive its page's [Parameter]/[SupplyParameterFromQuery] values (it wraps *above*
    // Body in the render tree), so the branch is read back out of the resolved URL.
    // Never falls back to a demo GUID: with no branch the layout just skips branding
    // and the page renders its own "no branch" guidance state.
    private async Task<Guid?> ResolveBranchIdAsync()
    {
        var uri = new Uri(Navigation.Uri);

        foreach (var segment in uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries))
        {
            if (Guid.TryParse(segment, out var fromPath) && fromPath != Guid.Empty)
                return fromPath;
        }

        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("branch", out var raw)
            && Guid.TryParse(raw.ToString(), out var fromQuery)
            && fromQuery != Guid.Empty)
            return fromQuery;

        // BranchStateService is the *admin's* selected branch (localStorage) — only
        // meaningful, and only trusted, when someone is actually signed in on this browser.
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true)
        {
            await BranchState.InitializeAsync();
            if (BranchState.CurrentBranchId != Guid.Empty)
                return BranchState.CurrentBranchId;
        }

        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        var branchId = await ResolveBranchIdAsync();
        if (branchId == null)
            return; // No branch -> default (dark, unbranded) look; the page shows the guidance state.

        var branding = await OrganizationApi.GetBranchBrandingAsync(branchId.Value);

        // Applies regardless of WhitelabelEnabled — dark/light is a basic display
        // preference available on every plan, unlike the colors/logo below.
        displayTheme = branding.DisplayTheme is "light" ? "light" : "dark";

        if (!branding.WhitelabelEnabled)
            return;

        var overrides = new List<string>();
        AddIfValidColor(overrides, "--qm-primary", branding.PrimaryColor);
        AddIfValidColor(overrides, "--qm-secondary", branding.SecondaryColor);
        AddIfValidColor(overrides, "--qm-accent-orange", branding.AccentColor);

        if (overrides.Count > 0)
            brandingStyle = string.Join("; ", overrides);
    }

    private static readonly Regex HexColor = new(@"^#[0-9a-fA-F]{3,8}$", RegexOptions.Compiled);

    private static void AddIfValidColor(List<string> overrides, string cssVar, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value) && HexColor.IsMatch(value))
            overrides.Add($"{cssVar}: {value}");
    }
}
