</style>

@code {
    private Guid selectedCounterId;
    private string counterStatus = "Inactive";
    private TokenDto? currentToken;
    private List<TokenDto> waitingTokens = new();
    private List<TokenDto> filteredWaitingTokens = new();
    private List<CounterDto> counters = new();
    private int servedToday = 0;
    private DateTime? serviceStartTime;
    private string? serviceFilter;
    private List<FilterOption> serviceFilterOptions = new() { new FilterOption { Text = "All Services", Value = "" } };

    // Confirm dialog state
    private bool showCompleteConfirm = false;
    private bool showNoShowConfirm = false;

    // Transfer dialog state
    private bool showTransferDialog = false;
    private Guid transferTargetCounterId = Guid.Empty;
    private string? transferReason;
    private bool transferInProgress = false;
    private List<CounterDto> transferTargetOptions = new();

    private Guid BranchId => BranchState.CurrentBranchId;

    protected override async Task OnInitializedAsync()
    {
        // Check permission - require QueueManage for counter terminal
        if (!await PermissionService.HasPermissionAsync(Permissions.QueueManage))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        // Subscribe to branch changes
        BranchState.OnBranchChanged += HandleBranchChanged;

        await LoadCounters();
        await SignalR.ConnectAsync(BranchId);
        SignalR.OnTokenCalled += HandleTokenCalled;
        SignalR.OnTokenCompleted += HandleTokenCompleted;
    }

    private async Task LoadCounters()
    {
        counters = await QueueApi.GetCountersAsync(BranchId);
        selectedCounterId = Guid.Empty;
        currentToken = null;
        counterStatus = "Inactive";
        StateHasChanged();
    }

    private async void HandleBranchChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadCounters();
            await SignalR.ConnectAsync(BranchId);
        });
    }

    private async Task OnCounterSelected(Guid counterId)
    {
        selectedCounterId = counterId;
        if (selectedCounterId != Guid.Empty)
        {
            counterStatus = "Active";
            await LoadWaitingTokens();
        }
    }

    private void OnFilterSelected(string filter)
    {
        serviceFilter = filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrEmpty(serviceFilter))
        {
            filteredWaitingTokens = waitingTokens;
        }
        else
        {
            filteredWaitingTokens = waitingTokens.Where(t => t.ServiceType?.Code == serviceFilter).ToList();
        }
    }

    private async Task LoadWaitingTokens()
    {
        waitingTokens = await QueueApi.GetWaitingTokensAsync(BranchId);
        ApplyFilter();
    }

    private async Task CallNext()
    {
        TokenDto? token;
        try
        {
            token = await QueueApi.CallNextTokenAsync(selectedCounterId);
        }
        catch (Exception)
        {
            NotificationService.Notify(ToastSeverity.Error, "Call Next Failed", "Something went wrong calling the next customer. Please try again — if it keeps happening, contact support.");
            return;
        }

        if (token != null)
        {
            currentToken = token;
            counterStatus = "Serving";
            serviceStartTime = DateTime.Now;
            await LoadWaitingTokens();
            NotificationService.Notify(ToastSeverity.Success, "Token Called", $"Now serving {token.DisplayNumber}");
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Info, "No Waiting Tokens", "There are no customers waiting in the queue.");
        }
    }

    private async Task CallSpecific(Guid tokenId)
    {
        var token = await QueueApi.CallSpecificTokenAsync(selectedCounterId, tokenId);
        if (token != null)
        {
            currentToken = token;
            counterStatus = "Serving";
            serviceStartTime = DateTime.Now;
            await LoadWaitingTokens();
            NotificationService.Notify(ToastSeverity.Success, "Token Called", $"Now serving {token.DisplayNumber}");
        }
    }

    private void CompleteService()
    {
        if (currentToken == null) return;
        showCompleteConfirm = true;
    }

    private async Task HandleCompleteConfirm(bool confirmed)
    {
        showCompleteConfirm = false;
        if (confirmed && currentToken != null)
        {
            await QueueApi.CompleteServiceAsync(selectedCounterId, currentToken.Id, null);
            currentToken = null;
            counterStatus = "Active";
            serviceStartTime = null;
            servedToday++;
            await LoadWaitingTokens();
            NotificationService.Notify(ToastSeverity.Success, "Service Completed");
        }
    }

    private void MarkNoShow()
    {
        if (currentToken == null) return;
        showNoShowConfirm = true;
    }

    private async Task HandleNoShowConfirm(bool confirmed)
    {
        showNoShowConfirm = false;
        if (confirmed && currentToken != null)
        {
            await QueueApi.MarkNoShowAsync(selectedCounterId, currentToken.Id);
            currentToken = null;
            counterStatus = "Active";
            serviceStartTime = null;
            await LoadWaitingTokens();
            NotificationService.Notify(ToastSeverity.Warning, "Marked as No-Show");
        }
    }

    private async Task RecallToken()
    {
        if (currentToken == null) return;
        // Re-announce the token
        NotificationService.Notify(ToastSeverity.Info, "Token Recalled", $"Re-calling {currentToken.DisplayNumber}");
        // Trigger announcement via SignalR
    }

    private void TransferToken()
    {
        if (currentToken == null) return;

        // Matches the backend's own guard rails (TransferTokenCommandHandler, Phase 19):
        // same-branch, Active status, and not the counter the token is already at.
        transferTargetOptions = counters
            .Where(c => c.Id != selectedCounterId && c.Status == CounterStatus.Active)
            .ToList();

        if (!transferTargetOptions.Any())
        {
            NotificationService.Notify(ToastSeverity.Warning, "No Available Counters",
                "There are no other active counters in this branch to transfer to.");
            return;
        }

        transferTargetCounterId = Guid.Empty;
        transferReason = null;
        showTransferDialog = true;
    }

    private void CancelTransfer()
    {
        showTransferDialog = false;
        transferTargetCounterId = Guid.Empty;
        transferReason = null;
    }

    private async Task ConfirmTransfer()
    {
        if (currentToken == null || transferTargetCounterId == Guid.Empty) return;

        transferInProgress = true;
        try
        {
            var result = await QueueApi.TransferTokenAsync(selectedCounterId, currentToken.Id, transferTargetCounterId, transferReason);
            if (result != null)
            {
                var destName = transferTargetOptions.FirstOrDefault(c => c.Id == transferTargetCounterId)?.DisplayName ?? "the selected counter";
                showTransferDialog = false;
                currentToken = null;
                counterStatus = "Active";
                serviceStartTime = null;
                await LoadWaitingTokens();
                NotificationService.Notify(ToastSeverity.Success, "Token Transferred", $"Transferred to {destName}");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Transfer Failed",
                    "Could not transfer the token. It may no longer be active, or the destination counter may no longer be available.");
            }
        }
        finally
        {
            transferInProgress = false;
        }
    }

    private async Task ToggleBreak()
    {
        if (counterStatus == "OnBreak")
        {
            counterStatus = "Active";
            NotificationService.Notify(ToastSeverity.Success, "Back to Active", "You're now ready to serve customers");
        }
        else
        {
            counterStatus = "OnBreak";
            NotificationService.Notify(ToastSeverity.Warning, "On Break", "Counter is now on break");
        }
    }

    private void HandleTokenCalled(TokenDto token)
    {
        InvokeAsync(async () =>
        {
            await LoadWaitingTokens();
            StateHasChanged();
        });
    }

    private void HandleTokenCompleted(Guid tokenId)
    {
        InvokeAsync(async () =>
        {
            await LoadWaitingTokens();
            StateHasChanged();
        });
    }

    private string GetStatusClass()
    {
        return counterStatus.ToLower() switch
        {
            "serving" => "serving",
            "active" => "active",
            "onbreak" => "onbreak",
            _ => "inactive"
        };
    }

    private string GetServingDuration()
    {
        if (serviceStartTime == null) return "";
        var duration = DateTime.Now - serviceStartTime.Value;
        return $"{(int)duration.TotalMinutes}:{duration.Seconds:00}";
    }

    public void Dispose()
    {
        BranchState.OnBranchChanged -= HandleBranchChanged;
        SignalR.OnTokenCalled -= HandleTokenCalled;
        SignalR.OnTokenCompleted -= HandleTokenCompleted;
    }

    private class FilterOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
