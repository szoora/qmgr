@page "/queue/board"
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Shared.UI
@inject IQueueApiService QueueApi
@inject ISignalRService SignalR
@inherits BranchAwareComponentBase
@inject IConfiguration Configuration
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Queue Board - Q-Mgr</PageTitle>

<div class="qb-queue-board">
    <!-- Header -->
    <div class="qb-board-header">
        <div class="qb-header-left">
            <h1>Queue Management Board</h1>
            <span class="qb-branch-name">@BranchName</span>
        </div>
        <div class="qb-header-right">
            @if (canCancelTokens)
            {
                @* Selection is an explicit mode, not always-on: this board refreshes itself over
                   SignalR, and stray checkboxes on a moving list invite the wrong ticket. *@
                <QButton Text="@(selectionMode ? "Done" : "Clear tickets")" Variant="@(selectionMode ? "primary" : "secondary")" Size="sm" OnClick="@ToggleSelectionMode" />
            }
            <span class="qb-current-time">@QDateFormat.TS(currentTime)</span>
            <span class="qb-current-date">@QDateFormat.Long(currentTime)</span>
        </div>
    </div>

    <div class="qb-board-content">
        <!-- Now Serving Section -->
        <div class="qb-now-serving-section">
            <h2>Now Serving</h2>
            <div class="qb-counters-grid">
                @if (counters != null && counters.Any())
                {
                    @foreach (var counter in counters.Where(c => c.Status == CounterStatus.Active))
                    {
                        <div class="qb-counter-card @(counter.CurrentToken != null ? "qb-serving" : "qb-available")">
                            <div class="qb-counter-number">@counter.DisplayName</div>
                            @if (counter.CurrentToken != null)
                            {
                                <div class="qb-token-display @(IsNewToken(counter.CurrentToken.Id) ? "qb-flash" : "")">
                                    @counter.CurrentToken.DisplayNumber
                                </div>
                                <div class="qb-customer-name">@(counter.CurrentToken.Customer?.Name ?? "Customer")</div>
                            }
                            else
                            {
                                <div class="qb-token-display qb-empty">---</div>
                                <div class="qb-status-text">Available</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="qb-no-counters">No active counters</div>
                }
            </div>
        </div>

        <!-- Waiting Queue Section -->
        <div class="qb-waiting-section">
            <h2>Waiting Queue <span class="qb-count">(@(waitingTokens?.Count ?? 0))</span></h2>

            @if (selectionMode && waitingTokens is { Count: > 0 })
            {
                <div class="qb-batch-bar">
                    <button type="button" class="qb-select-all" @onclick="ToggleSelectAll">
                        @(AllWaitingSelected ? "Clear selection" : "Select all waiting")
                    </button>
                    <span class="qb-batch-count">@selectedTokenIds.Count.ToString("N0") selected</span>
                    <QButton Text="Cancel tickets" Icon="x-circle" Size="sm" Variant="danger"
                             Disabled="@(selectedTokenIds.Count == 0)" OnClick="@RunCancelBatch" />
                </div>
            }

            <div class="qb-waiting-list">
                @if (waitingTokens != null && waitingTokens.Any())
                {
                    @foreach (var token in (selectionMode ? waitingTokens : waitingTokens.Take(20)))
                    {
                        <div class="qb-waiting-item @(token.Priority == TokenPriority.Priority ? "qb-priority" : "") @(token.Priority == TokenPriority.VIP ? "qb-vip" : "")">
                            @if (selectionMode)
                            {
                                <input type="checkbox" class="qb-waiting-check"
                                       checked="@selectedTokenIds.Contains(token.Id)"
                                       @onchange="@(e => ToggleSelection(token.Id, (bool)(e.Value ?? false)))"
                                       aria-label="@($"Select ticket {token.DisplayNumber}")" />
                            }
                            <span class="qb-token-number">@token.DisplayNumber</span>
                            <span class="qb-service-type">@(token.ServiceType?.Name ?? "General")</span>
                            @if (token.Priority != TokenPriority.Normal)
                            {
                                <span class="qb-priority-badge">@token.Priority</span>
                            }
                        </div>
                    }
                    @if (!selectionMode && waitingTokens.Count > 20)
                    {
                        <div class="qb-more-waiting">+@(waitingTokens.Count - 20) more waiting...</div>
                    }
                }
                else
                {
                    <div class="qb-no-waiting">No customers waiting</div>
                }
            </div>
        </div>
    </div>

    <!-- Statistics Footer -->
    <div class="qb-board-footer">
        <div class="qb-stat-item">
            <span class="qb-stat-value">@(waitingTokens?.Count ?? 0)</span>
            <span class="qb-stat-label">Waiting</span>
        </div>
        <div class="qb-stat-item">
            <span class="qb-stat-value">@(counters?.Count(c => c.Status == CounterStatus.Active) ?? 0)</span>
            <span class="qb-stat-label">Active Counters</span>
        </div>
        <div class="qb-stat-item">
            <span class="qb-stat-value">@avgWaitTime min</span>
            <span class="qb-stat-label">Avg Wait Time</span>
        </div>
        <div class="qb-stat-item">
            <span class="qb-stat-value">@servedToday</span>
            <span class="qb-stat-label">Served Today</span>
        </div>
    </div>
</div>

<style>
    .qb-batch-bar { display: flex; align-items: center; gap: 12px; padding: 8px 12px; margin-bottom: 10px; border: 1px solid var(--qm-primary); border-radius: var(--qm-radius-md); background: var(--qm-primary-light); }
    .qb-select-all { background: none; border: none; padding: 0; cursor: pointer; font: inherit; font-size: 13px; color: var(--qm-primary); text-decoration: underline; }
    .qb-batch-count { margin-left: auto; font-size: 13px; font-variant-numeric: tabular-nums; }
    .qb-waiting-check { width: 16px; height: 16px; margin-right: 10px; accent-color: var(--qm-primary); cursor: pointer; }

    .qb-queue-board {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--qm-bg-dark);
        color: var(--qm-text-primary);
        font-family: var(--qm-font-primary);
        overflow: hidden;
    }

    .qb-board-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 40px;
        background: var(--qm-bg-card);
        border-bottom: 2px solid var(--qm-primary);
    }

    .qb-board-header h1 {
        margin: 0;
        color: var(--qm-text-primary);
    }

    .qb-branch-name {
        color: var(--qm-primary);
        font-size: 16px;
    }

    .qb-header-right {
        text-align: right;
    }

    .qb-current-time {
        display: block;
        font-size: 36px;
        font-weight: bold;
        color: var(--qm-primary);
    }

    .qb-current-date {
        font-size: 14px;
        color: var(--qm-text-secondary);
    }

    .qb-board-content {
        flex: 1;
        display: flex;
        gap: 20px;
        padding: 20px 40px;
        overflow: hidden;
    }

    .qb-now-serving-section {
        flex: 2;
        display: flex;
        flex-direction: column;
    }

    .qb-now-serving-section h2,
    .qb-waiting-section h2 {
        margin: 0 0 20px 0;
        font-size: 24px;
        color: var(--qm-primary);
        border-bottom: 2px solid var(--qm-primary);
        padding-bottom: 10px;
    }

    .qb-count {
        color: var(--qm-warning);
    }

    .qb-counters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        flex: 1;
    }

    .qb-counter-card {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        padding: 25px;
        text-align: center;
        border: 2px solid var(--qm-border);
        transition: all 0.3s ease;
    }

    .qb-counter-card.qb-serving {
        border-color: var(--qm-success);
        background: color-mix(in srgb, var(--qm-success) 15%, var(--qm-bg-card));
    }

    .qb-counter-card.qb-available {
        border-color: var(--qm-primary);
    }

    .qb-counter-number {
        font-size: 18px;
        font-weight: 600;
        color: var(--qm-text-secondary);
        margin-bottom: 15px;
    }

    .qb-token-display {
        font-size: 48px;
        font-weight: bold;
        color: var(--qm-primary);
        margin: 10px 0;
    }

    .qb-token-display.qb-empty {
        color: var(--qm-text-muted);
    }

    .qb-token-display.qb-flash {
        animation: qb-flash 0.5s ease-in-out 3;
    }

    @@keyframes qb-flash {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.1); }
    }

    .qb-customer-name {
        color: var(--qm-text-secondary);
        font-size: 14px;
    }

    .qb-status-text {
        color: var(--qm-primary);
        font-size: 14px;
    }

    .qb-waiting-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
    }

    .qb-waiting-list {
        flex: 1;
        overflow-y: auto;
    }

    .qb-waiting-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 12px 15px;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 8px;
        border-left: 4px solid var(--qm-primary);
    }

    .qb-waiting-item.qb-priority {
        border-left-color: var(--qm-warning);
        background: color-mix(in srgb, var(--qm-warning) 10%, var(--qm-bg-card));
    }

    .qb-waiting-item.qb-vip {
        border-left-color: var(--qm-accent-pink);
        background: color-mix(in srgb, var(--qm-accent-pink) 10%, var(--qm-bg-card));
    }

    .qb-token-number {
        font-size: 18px;
        font-weight: bold;
        min-width: 80px;
    }

    .qb-service-type {
        flex: 1;
        color: var(--qm-text-secondary);
        font-size: 14px;
    }

    .qb-priority-badge {
        background: var(--qm-warning);
        color: var(--qm-text-dark);
        padding: 2px 8px;
        border-radius: var(--qm-radius-sm);
        font-size: 11px;
        font-weight: bold;
    }

    .qb-waiting-item.qb-vip .qb-priority-badge {
        background: var(--qm-accent-pink);
        color: var(--qm-text-on-primary);
    }

    .qb-no-counters, .qb-no-waiting {
        text-align: center;
        color: var(--qm-text-muted);
        padding: 40px;
        font-size: 18px;
    }

    .qb-more-waiting {
        text-align: center;
        color: var(--qm-primary);
        padding: 10px;
        font-style: italic;
    }

    .qb-board-footer {
        display: flex;
        justify-content: space-around;
        padding: 20px 40px;
        background: var(--qm-bg-card);
        border-top: 2px solid var(--qm-primary);
    }

    .qb-stat-item {
        text-align: center;
    }

    .qb-stat-value {
        display: block;
        font-size: 32px;
        font-weight: bold;
        color: var(--qm-primary);
    }

    .qb-stat-label {
        font-size: 14px;
        color: var(--qm-text-secondary);
    }

    /* Scrollbar styling */
    .qb-waiting-list::-webkit-scrollbar {
        width: 8px;
    }

    .qb-waiting-list::-webkit-scrollbar-track {
        background: var(--qm-bg-dark);
        border-radius: var(--qm-radius-sm);
    }

    .qb-waiting-list::-webkit-scrollbar-thumb {
        background: var(--qm-primary);
        border-radius: var(--qm-radius-sm);
    }
</style>

<QBatchDialog @ref="batchDialog" BranchId="@BranchId" OnQueued="@OnBatchQueued" />

@code {
    private Guid BranchId => BranchState.CurrentBranchId;
    private string BranchName => BranchState.CurrentBranchName ?? "Select Branch";
    private List<CounterDto>? counters;
    private List<TokenDto>? waitingTokens;
    private DateTime currentTime = DateTime.Now;
    private int avgWaitTime = 0;
    private int servedToday = 0;
    private HashSet<Guid> newTokenIds = new();
    private System.Threading.Timer? timer;

    // ---- Bulk cancellation -------------------------------------------------------------------
    //
    // Closing time, a cancelled clinic, a machine that went down: the queue is emptied in one
    // move far more often than ticket by ticket. Selection only exists while the mode is on, and
    // a ticket that leaves the board over SignalR drops out of the selection with it — the count
    // on the bar is always tickets that are still waiting.

    private bool canCancelTokens;
    private bool selectionMode;
    private readonly HashSet<Guid> selectedTokenIds = new();
    private QBatchDialog? batchDialog;

    private bool AllWaitingSelected =>
        waitingTokens is { Count: > 0 } && waitingTokens.All(t => selectedTokenIds.Contains(t.Id));

    private void ToggleSelectionMode()
    {
        selectionMode = !selectionMode;
        if (!selectionMode) selectedTokenIds.Clear();
    }

    private void ToggleSelection(Guid id, bool selected)
    {
        if (selected) selectedTokenIds.Add(id); else selectedTokenIds.Remove(id);
    }

    private void ToggleSelectAll()
    {
        if (waitingTokens == null) return;
        if (AllWaitingSelected) selectedTokenIds.Clear();
        else foreach (var t in waitingTokens) selectedTokenIds.Add(t.Id);
    }

    private async Task RunCancelBatch()
    {
        if (batchDialog == null || selectedTokenIds.Count == 0) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.CancelTokens,
            Ids = selectedTokenIds.ToList()
        });
    }

    private async Task OnBatchQueued(BatchAcceptedDto accepted)
    {
        selectedTokenIds.Clear();
        selectionMode = false;
        await LoadData();
    }


    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.QueueView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        canCancelTokens = await PermissionService.HasPermissionAsync(Permissions.TokensCancel);

        // Initialize branch state
        await BranchState.InitializeAsync();
        TrackBranch();

        // Start clock timer
        timer = new System.Threading.Timer(async _ =>
        {
            currentTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        // Load initial data
        await LoadData();

        // Connect to SignalR
        await ConnectSignalR();
    }

    private async Task ConnectSignalR()
    {
        try
        {
            await SignalR.ConnectAsync(BranchId);
            SignalR.OnTokenCreated += HandleTokenCreated;
            SignalR.OnTokenCalled += HandleTokenCalled;
            SignalR.OnTokenCompleted += HandleTokenCompleted;
            SignalR.OnQueueUpdated += HandleQueueUpdated;
            SignalR.OnCounterStatusChanged += HandleCounterStatusChanged;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR connection failed: {ex.Message}");
        }
    }

    /// <summary>
    /// The branch changed under the page. The guard on an unchanged or empty branch, the
    /// marshalling onto the renderer and the StateHasChanged afterwards all live in
    /// BranchAwareComponentBase now, so only the page-specific reset and reload remain.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        // The SignalR connection is per branch: reconnect before reloading, or the board keeps
        // receiving the previous branch's tokens.
        await ConnectSignalR();
        await LoadData();
    }

    private async Task LoadData()
    {
        var countersTask = QueueApi.GetCountersAsync(BranchId);
        var tokensTask = QueueApi.GetWaitingTokensAsync(BranchId);
        var statusTask = QueueApi.GetQueueStatusAsync(BranchId);

        await Task.WhenAll(countersTask, tokensTask, statusTask);

        counters = await countersTask;
        waitingTokens = await tokensTask;

        var status = await statusTask;
        if (status != null)
        {
            avgWaitTime = (int)status.Summary.AverageWaitMinutes;
            servedToday = status.Summary.TotalCompletedToday;
        }

        await InvokeAsync(StateHasChanged);
    }

    private bool IsNewToken(Guid tokenId) => newTokenIds.Contains(tokenId);

    private async void HandleTokenCreated(TokenDto token)
    {
        if (token.BranchId == BranchId)
        {
            waitingTokens ??= new();
            waitingTokens.Insert(0, token);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleTokenCalled(TokenDto token)
    {
        if (token.BranchId == BranchId)
        {
            // Add to new tokens for qb-flash effect
            newTokenIds.Add(token.Id);

            // Remove from waiting list
            waitingTokens?.RemoveAll(t => t.Id == token.Id);
            selectedTokenIds.Remove(token.Id);

            // Update counter display
            if (counters != null && token.CounterId.HasValue)
            {
                var counter = counters.FirstOrDefault(c => c.Id == token.CounterId.Value);
                if (counter != null)
                {
                    var index = counters.IndexOf(counter);
                    counters[index] = counter with { CurrentToken = token };
                }
            }

            await InvokeAsync(StateHasChanged);

            // Remove qb-flash effect after 3 seconds
            _ = Task.Delay(3000).ContinueWith(async _ =>
            {
                newTokenIds.Remove(token.Id);
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async void HandleTokenCompleted(Guid tokenId)
    {
        // Update counter to show qb-available
        if (counters != null)
        {
            var counter = counters.FirstOrDefault(c => c.CurrentToken?.Id == tokenId);
            if (counter != null)
            {
                var index = counters.IndexOf(counter);
                counters[index] = counter with { CurrentToken = null };
            }
        }
        servedToday++;
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleQueueUpdated(QueueStatusDto status)
    {
        avgWaitTime = (int)status.Summary.AverageWaitMinutes;
        servedToday = status.Summary.TotalCompletedToday;
        await LoadData();
    }

    private async void HandleCounterStatusChanged(CounterStatusDto counterStatus)
    {
        await LoadData();
    }

    public void Dispose()
    {
        timer?.Dispose();
        SignalR.OnTokenCreated -= HandleTokenCreated;
        SignalR.OnTokenCalled -= HandleTokenCalled;
        SignalR.OnTokenCompleted -= HandleTokenCompleted;
        SignalR.OnQueueUpdated -= HandleQueueUpdated;
        SignalR.OnCounterStatusChanged -= HandleCounterStatusChanged;
    }
}
