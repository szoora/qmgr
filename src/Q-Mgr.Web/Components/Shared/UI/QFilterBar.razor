@namespace QMgr.Web.Components.Shared.UI

@*
    A row of filter controls with an optional action group at the end. Keeps the .filter-bar class
    because layout.css already targets it in the mobile rules; Wrap centres the items for a bar of
    mixed heights (a search box beside labelled selects).
*@

<div class="q-filter-bar filter-bar @(Wrap ? "filter-bar--wrap q-filter-bar--wrap" : "") @Class" @attributes="AdditionalAttributes">
    @ChildContent
    @if (Actions != null)
    {
        <div class="q-filter-bar__actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Align items to the centre rather than the baseline of their labels.</summary>
    [Parameter] public bool Wrap { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
