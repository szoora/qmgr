@namespace QMgr.Web.Components.Shared.UI

@*
    aria-hidden by default: this renders an empty <i> whose glyph comes from a font, so it carries
    no text a screen reader can read and announcing it adds noise beside the label it decorates.
    Where an icon is the ONLY content of a control, the accessible name belongs on that control
    (aria-label on the button), not here. @attributes is splatted last on purpose, so a caller that
    genuinely needs aria-hidden="false" can still override it.
*@
<i class="q-icon @GetIconClass() @GetSizeClass() @Class" aria-hidden="true" @attributes="AdditionalAttributes"></i>

@code {
    /// <summary>
    /// Icon name (Bootstrap Icons without 'bi-' prefix, or full class name)
    /// </summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>
    /// Icon size: sm, md, lg, xl, or custom CSS size
    /// </summary>
    [Parameter] public string Size { get; set; } = "md";

    /// <summary>
    /// Icon color (CSS color or variant name)
    /// </summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Additional HTML attributes
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetIconClass()
    {
        if (string.IsNullOrEmpty(Name)) return "bi";

        // If already has 'bi' class or other prefix
        if (Name.Contains(' ') || Name.StartsWith("bi-"))
            return $"bi {Name}";

        return $"bi bi-{Name}";
    }

    private string GetSizeClass()
    {
        return Size.ToLowerInvariant() switch
        {
            "xs" => "q-icon--xs",
            "sm" or "small" => "q-icon--sm",
            "lg" or "large" => "q-icon--lg",
            "xl" => "q-icon--xl",
            "2xl" => "q-icon--2xl",
            _ => "q-icon--md"
        };
    }
}
