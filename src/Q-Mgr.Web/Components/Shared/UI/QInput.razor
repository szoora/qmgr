@namespace QMgr.Web.Components.Shared.UI
@typeparam TValue

<div class="q-input-wrapper @(HasError ? "q-input-wrapper--error" : "") @(Disabled ? "q-input-wrapper--disabled" : "") @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="q-input__label" for="@inputId">
            @Label
            @if (Required)
            {
                <span class="q-input__required">*</span>
            }
        </label>
    }

    <div class="q-input__container @(HasFocus ? "q-input__container--focused" : "")">
        @if (!string.IsNullOrEmpty(IconLeft))
        {
            <i class="@GetIconClass(IconLeft) q-input__icon q-input__icon--left"></i>
        }

        @* @bind:get/@bind:set, never value="…" plus a hand-written @oninput. Only a @bind directive
           makes the compiler emit SetUpdatesAttributeName("value"), which is what tells the renderer
           to accept the text the browser already holds when an input event arrives. Without it every
           keystroke's re-render diffs against the value from the previous render, sends that older
           value back and overwrites what the user has typed since — lagging text and dropped
           characters on any connection that is not near-instant. See dotnet/aspnetcore#14242. *@
        @if (Type == "textarea")
        {
            <textarea id="@inputId"
                      class="q-input q-input--textarea"
                      placeholder="@Placeholder"
                      disabled="@Disabled"
                      readonly="@ReadOnly"
                      rows="@Rows"
                      @onfocus="HandleFocus"
                      @onblur="HandleBlur"
                      @bind:get="currentText"
                      @bind:set="HandleInput"
                      @bind:event="oninput"
                      @attributes="AdditionalAttributes"></textarea>
        }
        else
        {
            <input id="@inputId"
                   type="@Type"
                   class="q-input"
                   placeholder="@Placeholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   maxlength="@MaxLength"
                   min="@Min"
                   max="@Max"
                   step="@Step"
                   list="@List"
                   @onfocus="HandleFocus"
                   @onblur="HandleBlur"
                   @bind:get="currentText"
                   @bind:set="HandleInput"
                   @bind:event="oninput"
                   @attributes="AdditionalAttributes" />
        }

        @if (!string.IsNullOrEmpty(IconRight))
        {
            <i class="@GetIconClass(IconRight) q-input__icon q-input__icon--right"></i>
        }

        @if (Type == "password" && ShowPasswordToggle)
        {
            @* Icon-only, so the name lives here. It states the action the click performs, not the
               current state, and aria-pressed exposes that state separately. *@
            <button type="button" class="q-input__toggle" aria-label="@(showPassword ? "Hide password" : "Show password")"
                    aria-pressed="@(showPassword ? "true" : "false")" @onclick="TogglePasswordVisibility" tabindex="-1">
                <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
            </button>
        }

        @if (Clearable && !string.IsNullOrEmpty(Value?.ToString()))
        {
            @* Names the field it clears where one is known — "Clear" alone is ambiguous on a form
               with several clearable inputs. *@
            <button type="button" class="q-input__clear" aria-label="@(string.IsNullOrWhiteSpace(Label) ? "Clear field" : $"Clear {Label}")"
                    @onclick="Clear" tabindex="-1">
                <i class="bi bi-x" aria-hidden="true"></i>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(HelperText) && !HasError)
    {
        <span class="q-input__helper">@HelperText</span>
    }

    @if (HasError && !string.IsNullOrEmpty(ErrorMessage))
    {
        <span class="q-input__error">@ErrorMessage</span>
    }
</div>

@code {
    private string inputId = $"q-input-{Guid.NewGuid():N}";
    private bool HasFocus;
    private bool showPassword;

    // The text in the box, held apart from Value because the two legitimately differ while typing:
    // an int field can be blank or read "1." for a moment without a parseable Value behind it.
    // Rendering Value directly would snap such a field back on the next re-render of the page.
    private string? currentText;

    // The last Value this component either received or reported. A Value arriving that differs from
    // it is an outside change (a form reset, a record loaded) and replaces the text; one that merely
    // echoes what the user typed does not.
    private TValue? lastValue;
    private bool valueSynced;

    /// <summary>
    /// The current value
    /// </summary>
    [Parameter] public TValue? Value { get; set; }

    /// <summary>
    /// Callback when value changes
    /// </summary>
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>
    /// Input label
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Placeholder text
    /// </summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Input type: text, password, email, number, tel, url, textarea
    /// </summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>
    /// Whether the field is required
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Whether the input is disabled
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether the input is read-only
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Maximum length for text input
    /// </summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>
    /// Minimum value for number input
    /// </summary>
    [Parameter] public string? Min { get; set; }

    /// <summary>
    /// Maximum value for number input
    /// </summary>
    [Parameter] public string? Max { get; set; }

    /// <summary>
    /// Step value for number input
    /// </summary>
    [Parameter] public string? Step { get; set; }

    /// <summary>
    /// Links this input to a native &lt;datalist&gt; by id, turning it into a SUGGESTED field: the
    /// known values are offered, and anything else typed is still accepted. Use it where a closed
    /// picker would be wrong — guardian relationship, home language, religion — because forcing a
    /// fixed list there only pushes real answers into "Other".
    /// </summary>
    [Parameter] public string? List { get; set; }

    /// <summary>
    /// Number of rows for textarea
    /// </summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>
    /// Bootstrap icon for left side
    /// </summary>
    [Parameter] public string? IconLeft { get; set; }

    /// <summary>
    /// Bootstrap icon for right side
    /// </summary>
    [Parameter] public string? IconRight { get; set; }

    /// <summary>
    /// Whether to show password toggle button
    /// </summary>
    [Parameter] public bool ShowPasswordToggle { get; set; } = true;

    /// <summary>
    /// Whether to show clear button
    /// </summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>
    /// Helper text shown below input
    /// </summary>
    [Parameter] public string? HelperText { get; set; }

    /// <summary>
    /// Whether the input has an error
    /// </summary>
    [Parameter] public bool HasError { get; set; }

    /// <summary>
    /// Error message to display
    /// </summary>
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Additional HTML attributes
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Called on focus
    /// </summary>
    [Parameter] public EventCallback OnFocus { get; set; }

    /// <summary>
    /// Called on blur
    /// </summary>
    [Parameter] public EventCallback OnBlur { get; set; }

    protected override void OnParametersSet()
    {
        if (!valueSynced || !EqualityComparer<TValue?>.Default.Equals(Value, lastValue))
        {
            currentText = Value?.ToString();
            lastValue = Value;
            valueSynced = true;
        }
    }

    private string GetIconClass(string icon)
    {
        if (string.IsNullOrEmpty(icon)) return "";
        if (icon.StartsWith("bi-")) return $"bi {icon}";
        return $"bi bi-{icon}";
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
        Type = showPassword ? "text" : "password";
    }

    private async Task HandleFocus()
    {
        HasFocus = true;
        await OnFocus.InvokeAsync();
    }

    private async Task HandleBlur()
    {
        HasFocus = false;
        await OnBlur.InvokeAsync();
    }

    private async Task HandleInput(string? text)
    {
        currentText = text;

        // Text that does not parse yet ("" or "1." in an int field) stays in the box and is not
        // reported; the last good Value stands until it does.
        if (!TryParse(text, out var parsed))
            return;

        lastValue = parsed;
        await ValueChanged.InvokeAsync(parsed!);
    }

    private static bool TryParse(string? text, out TValue? result)
    {
        result = default;

        if (typeof(TValue) == typeof(string))
        {
            result = (TValue)(object)(text ?? "");
            return true;
        }
        if (typeof(TValue) == typeof(int) && int.TryParse(text, out var intVal))
        {
            result = (TValue)(object)intVal;
            return true;
        }
        if (typeof(TValue) == typeof(int?))
        {
            if (string.IsNullOrEmpty(text))
                return true;
            if (int.TryParse(text, out var nullableIntVal))
            {
                result = (TValue)(object)nullableIntVal;
                return true;
            }
            return false;
        }
        if (typeof(TValue) == typeof(decimal) && decimal.TryParse(text, out var decVal))
        {
            result = (TValue)(object)decVal;
            return true;
        }
        if (typeof(TValue) == typeof(double) && double.TryParse(text, out var dblVal))
        {
            result = (TValue)(object)dblVal;
            return true;
        }

        return false;
    }

    private async Task Clear()
    {
        currentText = "";
        lastValue = default;
        await ValueChanged.InvokeAsync(default);
    }
}
