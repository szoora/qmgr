                      letter-spacing: .06em; }
    .q-import__bar { height: 8px; border-radius: 999px; background: var(--qm-bg-secondary); overflow: hidden; }
    .q-import__bar-fill { height: 100%; background: var(--qm-primary); transition: width .3s ease; }
