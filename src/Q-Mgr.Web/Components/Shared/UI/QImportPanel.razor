@typeparam TRow
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@using QMgr.Application.Import.Documents
@inject IJSRuntime JS
@inject IToastService Toast
@inject INotificationClientService NotificationClient
@implements IDisposable

@*
    One home for a bulk import's whole client-side journey: choose a sheet, read it, validate it
    hard, show what will happen, send it, watch it run, and read what it did.

    Q-Mgr had two of these — the student roster and the staff list — built months apart. They shared
    only rosterImport.sheetToCsv (SheetJS in the browser, so the server needs no Excel library) and
    CsvText. Everything above that was copied, and the copies had already drifted in the way copies
    do: the student page watched progress over SignalR while the staff page polled on a
    System.Threading.Timer, for the same job, broadcasting the same events. There was never a reason
    for two mechanisms — the staff import simply landed later and hand-rolled one. Uniformity here is
    structural rather than promised: both callers run this component, so neither can drift again.

    LIVE PROGRESS IS SIGNALR, WITH A SLOW RECONCILING POLL BEHIND IT. The push is what makes it feel
    live; the poll exists only because a dropped frame or a reconnect would otherwise leave the bar
    frozen at 40% on a job that finished. It ticks every 10s, only while a job is running, and stops
    the moment the job is terminal — it is a safety net, not the mechanism.
*@

<div class="q-import">

    @* ---------- The steps. A file becomes rows through four of them, and the reader can go back
         one at any time before anything is sent: nothing leaves the browser until Import. ---------- *@
    @if (stage != Stage.Running)
    {
        <ol class="q-import__steps" aria-label="Import steps">
            <li class="@StepClass(Stage.Pick)"><span>1</span> Choose a file</li>
            <li class="@StepClass(Stage.Map)"><span>2</span> Match the columns</li>
            <li class="@StepClass(Stage.Review)"><span>3</span> Check and import</li>
        </ol>
    }

    @* ---------- 1. Choose a file ---------- *@
    @if (stage == Stage.Pick)
    {
        <div class="q-import__pick">
            <label class="q-import__drop" for="@InputId">
                <QIcon Name="file-earmark-spreadsheet" />
                <span class="q-import__drop-main">@(preview == null ? "Choose an Excel or CSV file" : FileName)</span>
                <span class="q-import__drop-sub">.xlsx, .xls, .csv, .json, .ndjson, or a table in a .docx, .doc or text .pdf — read here, nothing is sent until you press Import</span>
            </label>
            <InputFile id="@InputId" OnChange="OnFileSelected" accept="@ImportDocumentReading.Accept" class="q-import__file" />

            @if (TemplateRows.Count > 0 || Columns.Count > 0)
            {
                <QDataExport TItem="ImportTemplateRow" Title="@($"{Noun} import template")" FileStem="@TemplateFileStem"
                             Columns="@BuildTemplateColumns()" RowProvider="@TemplateRowsAsync"
                             Formats="ExportFormat.Csv | ExportFormat.Excel" Text="Download template" Variant="ghost" />
            }
        </div>

    }

    @if (Options is not null && stage != Stage.Running)
    {
        <div class="q-import__options">@Options</div>
    }

    @* ---------- 2. Match the columns ----------
         The step this whole component exists for. Alias matching makes the first guess; everything
         here is the reader correcting it, because a header we do not recognise would otherwise be
         silently lost and a school's own export names half its columns something we never listed. *@
    @if (stage == Stage.Map && grid is not null)
    {
        <div class="q-import__map">

            <div class="q-import__map-file">
                <div>
                    <strong>@FileName</strong>
                    <span class="q-import__map-sub">@dataRowCount row(s) · @grid.ColumnCount column(s)</span>
                </div>
                @if (sheetNames.Count > 1)
                {
                    <label class="q-import__map-inline">
                        <span>Sheet</span>
                        <QSelect TValue="string" TItem="string" Items="@sheetNames" Value="@sheetName"
                                 ValueChanged="@OnSheetChanged" ValueSelector="@(n => n)" TextSelector="@(n => n)" />
                    </label>
                }
                <label class="q-import__map-inline">
                    <span>Header row</span>
                    <QSelect TValue="int" TItem="ColumnOption" Items="@headerRowOptions" Value="@grid.HeaderRowIndex"
                             ValueChanged="@OnHeaderRowChanged" ValueSelector="@(o => o.Index)" TextSelector="@(o => o.Label)" />
                </label>
            </div>

            @if (mappingProblems.Count > 0)
            {
                <div class="q-import__banner q-import__banner--error">
                    <strong><QIcon Name="exclamation-octagon" /> Still to match</strong>
                    <ul class="q-import__problems">
                        @foreach (var p in mappingProblems) { <li>@p</li> }
                    </ul>
                </div>
            }

            <div class="q-import__map-rows">
                @foreach (var column in Columns)
                {
                    var binding = mapping.For(column.Name);
                    <div class="q-import__map-row @(IsUnfilled(column) ? "q-import__map-row--missing" : "")">
                        <div class="q-import__map-field">
                            <span class="q-import__map-name">@column.DisplayName</span>
                            @if (column.Required)
                            {
                                <span class="q-import__req">@(CoveredByAlternative(column) ? "Covered" : "Required")</span>
                            }
                            @if (!string.IsNullOrEmpty(column.Hint))
                            {
                                <span class="q-import__map-hint">@column.Hint</span>
                            }
                        </div>

                        <div class="q-import__map-pick">
                            <QSelect TValue="int" TItem="ColumnOption" Items="@columnOptions" Value="@binding.Primary"
                                     ValueChanged="@(i => SetSource(column.Name, 0, i))"
                                     ValueSelector="@(o => o.Index)" TextSelector="@(o => o.Label)" />

                            @if (binding.Sources.Count > 1)
                            {
                                <div class="q-import__join">
                                    <span class="q-import__join-label">joined with</span>
                                    <QSelect TValue="string" TItem="JoinerOption" Items="@joinerOptions" Value="@binding.Joiner"
                                             ValueChanged="@(j => SetJoiner(column.Name, j))"
                                             ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Label)" />
                                    <QSelect TValue="int" TItem="ColumnOption" Items="@columnOptions" Value="@binding.Sources[1]"
                                             ValueChanged="@(i => SetSource(column.Name, 1, i))"
                                             ValueSelector="@(o => o.Index)" TextSelector="@(o => o.Label)" />
                                </div>
                            }
                            else if (binding.IsMapped)
                            {
                                <QButton Text="Join another column" Icon="plus-lg" Size="sm" Variant="ghost"
                                         OnClick="@(() => AddJoin(column.Name))" />
                            }

                            <span class="q-import__sample">@SampleFor(binding)</span>
                        </div>
                    </div>
                }
            </div>

            @if (UnusedHeaders.Count > 0)
            {
                <p class="q-import__headers">
                    Read and ignored: @string.Join(", ", UnusedHeaders)
                </p>
            }

            <div class="q-import__actions">
                <QButton Text="Choose a different file" Icon="arrow-counterclockwise" Variant="ghost" OnClick="Reset" />
                <QButton Text="Continue" Icon="arrow-right" Variant="primary" OnClick="ContinueToReview"
                         Disabled="@(mappingProblems.Count > 0)" Loading="@checkingExisting" />
            </div>
        </div>
    }

    @* ---------- 3. What is wrong with the FILE ---------- *@
    @if (preview is not null && preview.FileProblems.Count > 0)
    {
        <div class="q-import__banner q-import__banner--error">
            <strong><QIcon Name="exclamation-octagon" /> This file cannot be imported</strong>
            <ul class="q-import__problems">
                @foreach (var p in preview.FileProblems)
                {
                    <li>@p</li>
                }
            </ul>
        </div>
    }

    @* ---------- 3. The preview and its tally ---------- *@
    @if (stage == Stage.Review && preview is not null && preview.Rows.Count > 0)
    {
        @* The page's OWN answer to something it found in the rows, above the row list — the roster
           puts its missing-classes panel here. It sits at the check step because that is where the
           reader is deciding whether to commit, and a fact they can act on belongs beside that
           decision rather than repeated down every row. *@
        @if (Review is not null)
        {
            <div class="q-import__review">@Review(preview.Rows.Where(r => r.Row is not null).Select(r => r.Row!).ToList())</div>
        }

        @* ALREADY HERE. Asked before anything is sent, not reported afterwards: a person importing a
             whole staff list needs to say whether this file is the new truth for people already on
             file, or whether it is only adding the ones who are missing. *@
        @if (existing is { Count: > 0 })
        {
            <div class="q-import__banner q-import__banner--info">
                <strong><QIcon Name="people" /> @existing.Count of these @Noun@(existing.Count == 1 ? " is" : "s are") already here</strong>

                @* WHAT WOULD MOVE. "23 already here" reads as 23 decisions when 20 of them would
                     change nothing at all, so say which is which — the fields, never the values. *@
                @if (existing.Changed > 0)
                {
                    <p class="q-import__map-sub qi-changed">
                        <strong>@existing.Changed</strong> of them @(existing.Changed == 1 ? "has" : "have") something different in this file@(existing.Unchanged > 0 ? $"; the other {existing.Unchanged} would not change at all" : "").
                    </p>
                    @if (existing.ChangeSamples.Count > 0)
                    {
                        <ul class="qi-changes">
                            @foreach (var c in existing.ChangeSamples)
                            {
                                <li><strong>@c.Who</strong> — @string.Join(", ", c.Fields)</li>
                            }
                            @if (existing.Changed > existing.ChangeSamples.Count)
                            {
                                <li class="qi-changes__more">and @(existing.Changed - existing.ChangeSamples.Count) more</li>
                            }
                        </ul>
                    }
                }
                else if (existing.Sample.Count > 0)
                {
                    <p class="q-import__map-sub">@string.Join(" · ", existing.Sample)@(existing.Count > existing.Sample.Count ? " and others" : "")</p>
                }

                <label class="q-import__radio">
                    <input type="radio" name="q-import-existing" checked="@updateExisting" @onchange="@(() => updateExisting = true)" />
                    <span><strong>Update them</strong> with what is in this file. Their role, permissions and password are never changed by an import.</span>
                </label>
                <label class="q-import__radio">
                    <input type="radio" name="q-import-existing" checked="@(!updateExisting)" @onchange="@(() => updateExisting = false)" />
                    <span><strong>Leave them as they are</strong> — add only the @(Noun)s who are missing.</span>
                </label>
            </div>
        }

        @* MIGHT BE THE SAME PERSON TWICE. A likeness is a question, never a refusal — two children on
             one roll really do share a name — so this asks for a confirmation and holds the import
             until it is given, rather than dropping rows on a guess. *@
        @if (existing is not null && existing.PossibleDuplicates.Count > 0)
        {
            <div class="q-import__banner q-import__banner--warn qi-dupes">
                <strong><QIcon Name="exclamation-triangle" /> @existing.PossibleDuplicates.Count @(existing.PossibleDuplicates.Count == 1 ? "name looks" : "names look") like the same @Noun twice</strong>
                <ul class="qi-changes">
                    @foreach (var d in existing.PossibleDuplicates.Take(8))
                    {
                        <li><strong>@d.Name</strong> — @d.Detail</li>
                    }
                    @if (existing.PossibleDuplicates.Count > 8)
                    {
                        <li class="qi-changes__more">and @(existing.PossibleDuplicates.Count - 8) more</li>
                    }
                </ul>
                <QCheckbox Value="@duplicatesConfirmed" ValueChanged="@(v => duplicatesConfirmed = v)" Class="qi-confirm q-checkbox-row--top"
                           Label="@($"I have checked these — they are different {Noun}s, or the same one and I mean to update them.")" />
            </div>
        }

        <div class="q-import__tally">
            <div class="q-import__tile q-import__tile--ok">
                <span class="value">@preview.Importable</span><span class="label">Ready to import</span>
            </div>
            @if (preview.Warned > 0)
            {
                <div class="q-import__tile q-import__tile--warn">
                    <span class="value">@preview.Warned</span><span class="label">With a warning</span>
                </div>
            }
            @if (preview.Rejected > 0)
            {
                <div class="q-import__tile q-import__tile--bad">
                    <span class="value">@preview.Rejected</span><span class="label">Will be skipped</span>
                </div>
            }
        </div>

        @if (preview.Headers.Count > 0)
        {
            <p class="q-import__headers">
                Columns read@(headerLine > 1 ? $" from row {headerLine}" : ""): @string.Join(", ", preview.Headers)
            </p>
        }
        else
        {
            <p class="q-import__headers">No header row found — columns were read in the template's order.</p>
        }

        @* What the cleaning changed, counted. A transformation is a statement, not a secret. *@
        @if (preview.Cleaned.Count > 0)
        {
            <p class="q-import__headers">
                Tidied on the way in: @string.Join(" · ", preview.Cleaned.OrderByDescending(c => c.Value).Select(c => $"{c.Value} {c.Key}"))
            </p>
        }

        <div class="q-import__table-wrap">
            <table class="q-table q-stack q-import__table">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>@Noun</th>
                        <th>Outcome</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in preview.Rows.Take(MaxPreviewRows))
                    {
                        <tr class="@(r.Error != null ? "q-import__row--bad" : r.Warnings.Count > 0 ? "q-import__row--warn" : "")">
                            <td>@r.RowNumber</td>
                            <td>
                                @if (RowSummary is not null && r.Row is not null)
                                {
                                    @RowSummary(r.Row)
                                }
                                else
                                {
                                    <span class="q-import__cells">@string.Join(" · ", r.Cells.Take(4))</span>
                                }
                            </td>
                            <td>
                                @if (r.Error != null)
                                {
                                    <span class="q-import__bad"><QIcon Name="x-circle" /> @r.Error</span>
                                }
                                else if (r.Warnings.Count > 0)
                                {
                                    <span class="q-import__warn"><QIcon Name="exclamation-triangle" /> @string.Join("; ", r.Warnings)</span>
                                }
                                else
                                {
                                    <span class="q-import__ok"><QIcon Name="check-circle" /> Ready</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (preview.Rows.Count > MaxPreviewRows)
            {
                <p class="q-import__more">Showing the first @MaxPreviewRows of @preview.Rows.Count rows. Every row is validated, not just these.</p>
            }
        </div>

        <div class="q-import__actions">
            <QButton Text="Back to the columns" Icon="arrow-left" Variant="ghost" OnClick="@(() => stage = Stage.Map)" Disabled="@starting" />
            <QButton Text="Choose a different file" Icon="arrow-counterclockwise" Variant="ghost" OnClick="Reset" Disabled="@starting" />
            <QButton Text="@ImportButtonText" Icon="cloud-upload" Variant="primary"
                     OnClick="Start" Loading="@starting" Disabled="@(!preview.CanImport || starting || NeedsDuplicateAnswer)" />
        </div>
        @if (NeedsDuplicateAnswer)
        {
            <p class="q-import__note qi-blocked">Confirm the names above before importing.</p>
        }
        @if (preview.Rejected > 0)
        {
            <p class="q-import__note">Rows with a problem are left out of the import. Fix them in the file and import it again — the ones that succeeded are not re-created.</p>
        }
    }

    @* ---------- 4. Running, then the summary ---------- *@
    @if (job is not null)
    {
        <div class="q-import__progress">
            <div class="q-import__progress-head">
                <span class="q-import__status q-import__status--@job.Status.ToString().ToLowerInvariant()">@StatusLabel(job.Status)</span>
                <span>@job.ProcessedRows / @job.TotalRows rows</span>
                @if (!IsTerminal(job.Status))
                {
                    <span class="q-import__live">@(liveSince == null ? "" : "live")</span>
                }
            </div>
            <div class="q-import__bar" role="progressbar" aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100">
                <div class="q-import__bar-fill @(IsTerminal(job.Status) ? "done" : "")" style="width:@(Percent)%"></div>
            </div>

            <div class="q-import__tally">
                <div class="q-import__tile q-import__tile--ok"><span class="value">@job.CreatedCount</span><span class="label">Created</span></div>
                <div class="q-import__tile"><span class="value">@job.UpdatedCount</span><span class="label">Updated</span></div>
                <div class="q-import__tile q-import__tile--warn"><span class="value">@job.DuplicateCount</span><span class="label">Duplicates</span></div>
                <div class="q-import__tile q-import__tile--bad"><span class="value">@job.FailedCount</span><span class="label">Failed</span></div>
            </div>

            @if (job.Status == RosterImportStatus.Failed && !string.IsNullOrWhiteSpace(job.FailureReason))
            {
                <div class="q-import__banner q-import__banner--error"><strong><QIcon Name="exclamation-octagon" /> The import could not run</strong><p>@job.FailureReason</p></div>
            }

            @if (IsTerminal(job.Status))
            {
                <p class="q-import__summary">@SummarySentence()</p>
                <div class="q-import__actions">
                    <QButton Text="@(showEntries ? "Hide the row-by-row result" : "Show the row-by-row result")"
                             Icon="list-check" Variant="secondary" OnClick="ToggleEntries" Loading="@loadingEntries" />
                    <QButton Text="Import another file" Icon="plus-lg" Variant="ghost" OnClick="Reset" />
                </div>
            }

            @if (showEntries && entries.Count > 0)
            {
                <div class="q-import__table-wrap">
                    <table class="q-table q-stack q-import__table">
                        <thead><tr><th>Row</th><th>@Noun</th><th>Outcome</th><th>Detail</th></tr></thead>
                        <tbody>
                            @foreach (var e in entries)
                            {
                                <tr class="@(e.Outcome == RosterImportRowOutcome.Failed ? "q-import__row--bad" : e.Outcome == RosterImportRowOutcome.DuplicateInFile ? "q-import__row--warn" : "")">
                                    <td>@e.RowNumber</td>
                                    <td>@(string.IsNullOrWhiteSpace(e.StudentName) ? "—" : e.StudentName)</td>
                                    <td><span class="q-import__outcome q-import__outcome--@e.Outcome.ToString().ToLowerInvariant()">@e.Outcome</span></td>
                                    <td>@e.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@* Panel-owned names only (q-import__*): a component <style> is NOT scoped in Blazor, so redefining a
   shared class here would restyle it app-wide for as long as this page is open — the trap
   scripts/e2e/style-leak-check.mjs exists to catch. Every value is a --qm-* token. *@
<style>
    .q-import { display: flex; flex-direction: column; gap: var(--qm-block-gap, 10px); }

    .q-import__steps { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
    .q-import__step { display: flex; align-items: center; gap: 6px; font-size: var(--qm-text-sm);
                      color: var(--qm-text-muted); padding: 4px 10px; border: 1px solid var(--qm-border);
                      border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); }
    .q-import__step span { display: inline-flex; align-items: center; justify-content: center;
                           width: 18px; height: 18px; border-radius: 50%; font-size: var(--qm-text-xs);
                           background: var(--qm-border); color: var(--qm-text-secondary); }
    .q-import__step--now { color: var(--qm-text-primary); border-color: var(--qm-primary); }
    .q-import__step--now span { background: var(--qm-primary); color: var(--qm-text-on-primary); }
    .q-import__step--done { color: var(--qm-text-secondary); }
    .q-import__step--done span { background: var(--qm-success); color: var(--qm-text-on-primary); }

    .q-import__pick { display: flex; flex-wrap: wrap; align-items: center; gap: var(--q-row-gap, 8px); }
    .q-import__drop { flex: 1 1 260px; min-width: 0; display: flex; flex-direction: column; gap: 2px;
                      align-items: center; text-align: center; cursor: pointer; padding: 18px;
                      border: 1px dashed var(--qm-border); border-radius: var(--qm-radius-lg);
                      background: var(--qm-bg-secondary); }
    .q-import__drop:hover { border-color: var(--qm-primary); }
    .q-import__drop-main { font-family: var(--qm-font-display); font-weight: 600; }
    .q-import__drop-sub, .q-import__map-sub, .q-import__sample, .q-import__headers, .q-import__more,
    .q-import__note { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .q-import__file { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
    .q-import__options { display: flex; flex-direction: column; gap: var(--qm-field-gap, 12px); }

    .q-import__map { display: flex; flex-direction: column; gap: var(--qm-block-gap, 10px); }
    .q-import__map-file { display: flex; flex-wrap: wrap; align-items: end; gap: var(--q-row-gap, 8px) 16px;
                          padding: 10px 12px; border: 1px solid var(--qm-border);
                          border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); }
    .q-import__map-file > div:first-child { display: flex; flex-direction: column; margin-right: auto; min-width: 0; }
    .q-import__map-inline { display: flex; flex-direction: column; gap: 2px; font-size: var(--qm-text-sm);
                            color: var(--qm-text-secondary); min-width: 180px; }

    .q-import__map-rows { display: flex; flex-direction: column; }
    .q-import__map-row { display: grid; grid-template-columns: minmax(150px, 230px) minmax(0, 1fr);
                         gap: 10px 16px; padding: 9px 0; border-bottom: 1px solid var(--qm-border); }
    .q-import__map-row:last-child { border-bottom: 0; }
    .q-import__map-row--missing { background: rgba(var(--qm-danger-rgb), .07); }
    .q-import__map-field { display: flex; flex-direction: column; gap: 2px; }
    .q-import__map-name { font-family: var(--qm-font-display); font-weight: 600; font-size: var(--qm-text-base); }
    .q-import__map-hint { font-size: var(--qm-text-xs); color: var(--qm-text-muted); }
    .q-import__map-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-width: 0; }
    .q-import__map-pick > * { min-width: 0; }
    .q-import__req { align-self: flex-start; font-size: var(--qm-text-xs); font-weight: 600;
                     letter-spacing: .04em; text-transform: uppercase; color: var(--qm-danger);
                     background: rgba(var(--qm-danger-rgb), .12); border-radius: 999px; padding: 1px 8px; }
    .q-import__join { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .q-import__join-label { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }

    .q-import__banner { display: flex; flex-direction: column; gap: 6px; padding: 12px 14px;
                        border-radius: var(--qm-radius-md); border: 1px solid var(--qm-border);
                        background: var(--qm-bg-secondary); font-size: var(--qm-text-base); }
    .q-import__banner--error { border-left: 3px solid var(--qm-danger); }
    .q-import__banner--info { border-left: 3px solid var(--qm-primary); }
    .q-import__banner--warn { border-left: 3px solid var(--qm-warning); }
    .qi-changed { color: var(--qm-text-primary); }
    .qi-changes { margin: 2px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 3px;
                  font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .qi-changes__more { list-style: none; margin-left: -18px; font-style: italic; }
    .qi-confirm { margin-top: 4px; }
    .qi-blocked { color: var(--qm-warning); }
    .q-import__problems { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px;
                          font-size: var(--qm-text-sm); }
    .q-import__radio { display: flex; align-items: flex-start; gap: 8px; font-size: var(--qm-text-sm); }

    .q-import__tally { display: flex; flex-wrap: wrap; gap: var(--q-row-gap, 8px); }
    .q-import__tile { flex: 1 1 120px; display: flex; flex-direction: column; padding: 10px 12px;
                      border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md);
                      background: var(--qm-bg-card); }
    .q-import__tile .value { font-family: var(--qm-font-display); font-size: var(--qm-text-stat); font-weight: 700;
                             font-variant-numeric: tabular-nums; }
