</style>

@code {
    /// <summary>The branch whose SignalR group carries this job's progress.</summary>
    [Parameter, EditorRequired] public Guid BranchId { get; set; }

    /// <summary>DOM id for the file input — unique per page.</summary>
    [Parameter, EditorRequired] public string InputId { get; set; } = "q-import-file";

    /// <summary>"student", "person" — used in every sentence this panel writes.</summary>
    [Parameter] public string Noun { get; set; } = "row";

    /// <summary>Declared columns, with the aliases real spreadsheets use.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ImportColumn> Columns { get; set; } = Array.Empty<ImportColumn>();

    /// <summary>Turns one mapped row into TRow, or explains why it cannot.</summary>
    [Parameter, EditorRequired]
    public Func<IReadOnlyList<string>, Dictionary<string, int>, int, (TRow? Row, string? Error, List<string> Warnings)> BuildRow { get; set; } = default!;

    /// <summary>The value that must not repeat within one file (an email, a student code).</summary>
    [Parameter] public Func<TRow, string?>? DuplicateKey { get; set; }

    /// <summary>What that key is called in the refusal — "email address", "student code".</summary>
    [Parameter] public string DuplicateNoun { get; set; } = "value";

    /// <summary>
    /// Sends the importable rows and returns the job id. The options carry what the reader decided on
    /// the review step — today, whether rows that already exist are updated or left alone.
    /// </summary>
    [Parameter, EditorRequired] public Func<List<TRow>, ImportOptions, Task<Guid>> StartAsync { get; set; } = default!;

    /// <summary>
    /// Asks the server which of these rows already exist, so the reader is asked BEFORE anything is
    /// sent rather than told afterwards. Optional: a page with no cheap way to ask simply does not
    /// show the question, and the import behaves as it always did.
    /// </summary>
    [Parameter] public Func<List<TRow>, Task<ImportExisting>>? CheckExistingAsync { get; set; }

    /// <summary>
    /// Names this import kind so a mapping can be remembered for it — "staff", "roster", "welfare".
    /// A remembered mapping is only ever re-applied to a file whose header row is the same shape, so
    /// a different export gets the automatic guess rather than somebody else's answer.
    /// </summary>
    [Parameter] public string? MappingKey { get; set; }

    /// <summary>Re-reads the job — used by the reconciling poll and once when it lands.</summary>
    [Parameter, EditorRequired] public Func<Guid, Task<RosterImportJobDto?>> LoadJobAsync { get; set; } = default!;

    /// <summary>The per-row outcomes, fetched only when the reader asks to see them.</summary>
    [Parameter] public Func<Guid, Task<List<RosterImportJobEntryDto>>>? LoadEntriesAsync { get; set; }

    /// <summary>Extra controls shown beside the file picker (delivery mode, "update existing", …).</summary>
    [Parameter] public RenderFragment? Options { get; set; }

    /// <summary>
    /// Rendered at the CHECK step, above the rows, with the parsed rows handed to it. For anything
    /// the page can say about the file as a whole and the reader can act on before committing —
    /// the roster lists the classes this branch has not got and offers to add or map each one.
    /// A per-row warning cannot do that job: the same sentence on 1,584 rows is noise.
    /// </summary>
    [Parameter] public RenderFragment<List<TRow>>? Review { get; set; }

    /// <summary>How a parsed row is described in the preview. Falls back to the first few cells.</summary>
    [Parameter] public RenderFragment<TRow>? RowSummary { get; set; }

    /// <summary>
    /// Example rows the downloadable template ships with, each aligned to <see cref="Columns"/>.
    /// The declared columns ARE the template, so there is no second list to keep in step.
    /// </summary>
    [Parameter] public IReadOnlyList<IReadOnlyList<string>> TemplateRows { get; set; } = Array.Empty<IReadOnlyList<string>>();

    [Parameter] public string TemplateFileStem { get; set; } = "import-template";

    /// <summary>A sheet bigger than this is refused before it is read.</summary>
    [Parameter] public long MaxFileBytes { get; set; } = 5 * 1024 * 1024;

    [Parameter] public int MaxPreviewRows { get; set; } = 200;

    /// <summary>Raised when the job reaches a terminal state, so the page can refresh its own list.</summary>
    [Parameter] public EventCallback OnCompleted { get; set; }

    /// <summary>
    /// The name of the sheet the reader chose, raised as soon as it is read. The page needs it for
    /// SourceFileName on the import job — the column the Import History modal shows so somebody can
    /// tell last Tuesday's upload from this morning's. StudentRoster passed a field that nothing
    /// ever assigned (CS0649, on every build) once its own file picker moved in here, so every
    /// roster import since has recorded a null name.
    /// </summary>
    [Parameter] public EventCallback<string?> OnFileChosen { get; set; }

    /// <summary>Where the reader is. Running covers the job and its result, which have no way back.</summary>
    private enum Stage { Pick, Map, Review, Running }

    private Stage stage = Stage.Pick;
    private ImportGrid? grid;
    private List<string> sheetNames = new();
    /// <summary>The chosen file read as a document (.docx, .doc, .pdf); null for a sheet, which SheetJS reads.</summary>
    private ImportDocument? document;
    private string? sheetName;
    private List<ColumnOption> columnOptions = new();
    private List<ColumnOption> headerRowOptions = new();
    /// <summary>What can go between two joined columns. "Nothing" is first because S1 + A is S1A.</summary>
    private static readonly List<JoinerOption> joinerOptions = new()
    {
        new JoinerOption(string.Empty, "nothing"), new JoinerOption(" ", "a space"),
        new JoinerOption("-", "a dash"), new JoinerOption("/", "a slash"), new JoinerOption(", ", "a comma"),
    };

    public sealed record JoinerOption(string Value, string Label);
    private List<string> mappingProblems = new();
    private int dataRowCount;
    private ImportExisting? existing;

    /// <summary>
    /// The reader has looked at the names that might be one person twice. It gates the import rather
    /// than the file: dropping a row on a likeness would be the system deciding two children are one,
    /// which it cannot know — the sign-up guard follows the same rule (near-proof refuses, a likeness asks).
    /// </summary>
    private bool duplicatesConfirmed;

    private bool NeedsDuplicateAnswer => existing is not null && existing.PossibleDuplicates.Count > 0 && !duplicatesConfirmed;
    private bool updateExisting = true, checkingExisting;

    /// <summary>An option in one of the mapping step's pickers: a file column, or a row of the sheet.</summary>
    public sealed record ColumnOption(int Index, string Label);

    private ImportPreview<TRow>? preview;
    private ImportMapping mapping = new();

    /// <summary>
    /// The sheet as text, kept so a change to an import OPTION can re-validate the rows already read
    /// rather than making somebody choose the file again. Changing which way round a name column is
    /// written is exactly that: the file has not changed, the reading of it has.
    /// </summary>
    private string? lastCsv;
    /// <summary>Which line of the file turned out to be the header, so the panel can say so.</summary>
    private int headerLine;
    private RosterImportJobDto? job;
    private List<RosterImportJobEntryDto> entries = new();
    private string? FileName;
    private bool starting, showEntries, loadingEntries, subscribed, disposed;
    private DateTime? liveSince;
    private System.Threading.Timer? reconcileTimer;
    private bool completedRaised;

    private int Percent => job is { TotalRows: > 0 } j ? Math.Clamp(j.ProcessedRows * 100 / j.TotalRows, 0, 100) : 0;

    private string ImportButtonText => preview is null
        ? "Import"
        : preview.Importable == 1 ? $"Import 1 {Noun}" : $"Import {preview.Importable} {Noun}s";

    protected override void OnInitialized()
    {
        NotificationClient.OnRosterImportProgressReceived += HandleProgress;
        subscribed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The group membership is what makes the push arrive; NotificationClientService replays it
        // on every reconnect, so joining once here is enough.
        if (firstRender && BranchId != Guid.Empty)
        {
            try { await NotificationClient.JoinBranchAsync(BranchId); } catch { /* the poll still covers us */ }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            if (e.File.Size > MaxFileBytes)
            {
                Toast.Notify(ToastSeverity.Warning, "That file is too large",
                    $"Keep the sheet under {MaxFileBytes / (1024 * 1024)} MB — split it, or delete the other sheets in the workbook.");
                return;
            }

            FileName = e.File.Name;
            await OnFileChosen.InvokeAsync(FileName);

            // A Word document or a text PDF: its tables are offered as the "sheets", the one that best matches this
            // import's columns first, and the chosen table becomes CSV for the unchanged path below (plan §4).
            document = null;
            if (DocumentReader.IsDocumentName(FileName))
            {
                document = await ImportDocumentReading.ReadAsync(JS, InputId, FileName);
                if (document.Tables.Count == 0)
                    throw new ImportDocumentException($"\"{FileName}\" has no table in it. The rows to import must be in a table.");
                sheetNames = ImportDocumentReading.TableLabels(document);
                var best = DocumentReader.BestTable(document, cell => Columns.Any(c => c.Matches(cell)));
                sheetName = sheetNames[Math.Max(0, best)];
                await ReadSheetAsync();
                return;
            }

            // Excel, CSV and JSON alike are read in the BROWSER; only text comes back, which is why
            // this product needs no server-side Excel library (a standing constraint) and why nothing
            // leaves the machine until Import is pressed.
            var sheets = await JS.InvokeAsync<SheetInfo[]>("rosterImport.sheets", InputId);
            sheetNames = sheets.Select(s => s.Name).ToList();
            sheetName = sheetNames.FirstOrDefault();

            await ReadSheetAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not read that file", ex.Message);
        }
    }

    private sealed record SheetInfo(string Name, int Rows);

    /// <summary>Reads the chosen sheet, finds its header row, guesses the mapping and offers it.</summary>
    private async Task ReadSheetAsync()
    {
        lastCsv = document != null
            ? ImportDocumentReading.ToCsv(document, Math.Max(0, sheetNames.IndexOf(sheetName ?? string.Empty)))
            : await JS.InvokeAsync<string>("rosterImport.sheetToCsv", InputId, sheetName);
        grid = ImportParsing.ReadGrid(lastCsv, Columns);
        mapping = ImportParsing.AutoMap(grid, Columns);
        await RestoreRememberedMappingAsync();
        RefreshMappingOptions();
        preview = null;
        existing = null;
        duplicatesConfirmed = false;
        stage = Stage.Map;
    }

    private async Task OnSheetChanged(string name)
    {
        sheetName = name;
        try { await ReadSheetAsync(); }
        catch (Exception ex) { Toast.Notify(ToastSeverity.Error, "Could not read that sheet", ex.Message); }
    }

    private void OnHeaderRowChanged(int rowIndex)
    {
        if (grid is null) return;
        grid.HeaderRowIndex = rowIndex;
        mapping = ImportParsing.AutoMap(grid, Columns);
        RefreshMappingOptions();
    }

    /// <summary>
    /// Rebuilds what the pickers offer and re-checks what is still missing. Called after anything
    /// that changes the file's shape or the mapping, so the Continue button is never enabled against
    /// a mapping that cannot produce rows.
    /// </summary>
    private void RefreshMappingOptions()
    {
        if (grid is null) return;
        var headers = grid.Headers;
        columnOptions = new List<ColumnOption> { new(-1, "— not matched —") };
        for (var i = 0; i < headers.Count; i++)
        {
            var label = string.IsNullOrWhiteSpace(headers[i]) ? $"Column {i + 1}" : headers[i];
            columnOptions.Add(new ColumnOption(i, label));
        }

        headerRowOptions = new List<ColumnOption> { new(-1, "No header row — read in the template's order") };
        for (var i = 0; i < Math.Min(12, grid.AllRows.Count); i++)
        {
            var preview = string.Join(" · ", grid.AllRows[i].Take(4).Where(c => c.Trim().Length > 0));
            headerRowOptions.Add(new ColumnOption(i, $"Row {i + 1}: {(preview.Length > 60 ? preview[..60] + "…" : preview)}"));
        }

        dataRowCount = grid.DataRows.Count();
        mappingProblems = ImportParsing.MappingProblems(Columns, mapping);
    }

    private void SetSource(string column, int position, int fileColumn)
    {
        var binding = mapping.For(column);
        if (fileColumn < 0)
        {
            if (position < binding.Sources.Count) binding.Sources.RemoveAt(position);
        }
        else if (position < binding.Sources.Count) binding.Sources[position] = fileColumn;
        else binding.Sources.Add(fileColumn);
        RefreshMappingOptions();
    }

    /// <summary>
    /// Two columns into one field: "Class" + "Stream" is the case this exists for, and the joiner
    /// defaults to nothing because S1 + A is S1A, not "S1 A".
    /// </summary>
    private void AddJoin(string column)
    {
        var binding = mapping.For(column);
        if (binding.Sources.Count == 0 || binding.Sources.Count > 1) return;
        var next = columnOptions.FirstOrDefault(o => o.Index >= 0 && o.Index != binding.Sources[0]);
        if (next is null) return;
        binding.Sources.Add(next.Index);
        RefreshMappingOptions();
    }

    private void SetJoiner(string column, string joiner)
    {
        mapping.For(column).Joiner = joiner;
        RefreshMappingOptions();
    }

    /// <summary>
    /// The first real value the file holds for a declared field, with the mapping as it stands. It is
    /// how a page's own Options can ask a question ABOUT the data — "which way round is this name
    /// written?" — at the mapping step, before a single row has been built.
    /// </summary>
    public string? FirstValueOf(string column)
    {
        if (grid is null || !mapping.Bindings.TryGetValue(column, out var binding) || !binding.IsMapped) return null;
        foreach (var row in grid.DataRows.Take(40))
        {
            var joined = string.Join(binding.Joiner, binding.Sources
                .Select(i => i >= 0 && i < row.Count ? row[i].Trim() : string.Empty)
                .Where(v => v.Length > 0));
            if (joined.Length > 0) return joined;
        }
        return null;
    }

    private string SampleFor(ImportBinding binding)
    {
        if (grid is null || !binding.IsMapped) return string.Empty;
        var samples = new List<string>();
        foreach (var row in grid.DataRows.Take(40))
        {
            var joined = string.Join(binding.Joiner, binding.Sources
                .Select(i => i >= 0 && i < row.Count ? row[i].Trim() : string.Empty)
                .Where(v => v.Length > 0));
            if (joined.Length == 0 || samples.Contains(joined)) continue;
            samples.Add(joined);
            if (samples.Count == 2) break;
        }
        return samples.Count == 0 ? "every row is empty here" : "e.g. " + string.Join(" · ", samples);
    }

    /// <summary>A required field with nothing to fill it, and no mapped stand-in.</summary>
    private bool IsUnfilled(ImportColumn column)
        => column.Required && !mapping.IsMapped(column.Name) && !CoveredByAlternative(column);

    private bool CoveredByAlternative(ImportColumn column)
        => column.SatisfiedBy is { Length: > 0 } alt && mapping.IsMapped(alt);

    private List<string> UnusedHeaders
    {
        get
        {
            if (grid is null || !grid.HasHeader) return new();
            var used = mapping.Bindings.Values.SelectMany(b => b.Sources).ToHashSet();
            return grid.Headers.Select((h, i) => (h, i))
                .Where(x => !used.Contains(x.i) && x.h.Trim().Length > 0)
                .Select(x => x.h).ToList();
        }
    }

    private string StepClass(Stage s) => s == stage ? "q-import__step q-import__step--now"
        : (int)s < (int)stage ? "q-import__step q-import__step--done" : "q-import__step";

    /// <summary>
    /// Validates every row with the mapping the reader confirmed, then asks the server which of them
    /// already exist. A failure to ask is not a failure to import: the question is a courtesy, the
    /// server decides what happens to a duplicate either way.
    /// </summary>
    private async Task ContinueToReview()
    {
        if (lastCsv is null) return;
        Build(lastCsv);
        await RememberMappingAsync();
        if (preview is null || preview.FileProblems.Count > 0) { stage = Stage.Map; return; }

        existing = null;
        duplicatesConfirmed = false;
        if (CheckExistingAsync is not null && preview.Importable > 0)
        {
            checkingExisting = true;
            try { existing = await CheckExistingAsync(preview.Rows.Where(r => r.Importable).Select(r => r.Row!).ToList()); }
            catch { existing = null; }
            finally { checkingExisting = false; }
        }

        stage = Stage.Review;
    }

    // ---- remembering a mapping ------------------------------------------------------------------
    // Keyed by the import kind AND a fingerprint of the header row, so next term's export of the same
    // shape maps itself while a different file gets the automatic guess instead of a stale answer.
    private string? MappingStorageKey => MappingKey is { Length: > 0 } k && grid is not null
        ? $"qmgr-import-map:{k}:{ImportParsing.Fingerprint(grid)}"
        : null;

    private async Task RememberMappingAsync()
    {
        if (MappingStorageKey is not { } key) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(mapping.Bindings);
            await JS.InvokeVoidAsync("localStorage.setItem", key, json);
        }
        catch { /* a browser with storage off still imports; it just does not remember */ }
    }

    private async Task RestoreRememberedMappingAsync()
    {
        if (MappingStorageKey is not { } key) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            if (string.IsNullOrWhiteSpace(json)) return;
            var saved = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, ImportBinding>>(json);
            if (saved is null || saved.Count == 0) return;
            mapping.Bindings = new Dictionary<string, ImportBinding>(saved, StringComparer.OrdinalIgnoreCase);
        }
        catch { /* a stored mapping that cannot be read is simply not used */ }
    }

    /// <summary>
    /// Reads the sheet into a grid, works out WHICH ROW is the header (a real export puts a title in
    /// row 1 and the headers in row 2, which used to leave every column unmapped and every row
    /// refused), maps the columns, cleans the values and validates every row.
    ///
    /// The mapping is automatic here — alias matching, as it has always been. The reader's own
    /// mapping step is Phase 3 of docs/plans/BULK_IMPORT_SYSTEM.md and slots in at exactly this
    /// point: it replaces `AutoMap` with a mapping the person confirmed, and nothing below changes,
    /// because Resolve already hands BuildRow the cells in the declared order whatever filled them.
    /// </summary>
    private void Build(string csv)
    {
        var grid = ImportParsing.ReadGrid(csv, Columns);
        mapping = ImportParsing.AutoMap(grid, Columns);
        var p = new ImportPreview<TRow> { Headers = grid.HasHeader ? grid.Headers : new() };
        headerLine = grid.HasHeader ? grid.HeaderRowIndex + 1 : 0;

        var data = grid.DataRows.ToList();
        if (data.Count == 0)
        {
            p.FileProblems.Add("The sheet has no rows.");
            preview = p;
            return;
        }

        // A required field nothing fills is a FILE problem, reported once, rather than the same error
        // repeated against every row. "This, or that" lives in ImportColumn.SatisfiedBy.
        foreach (var problem in ImportParsing.MappingProblems(Columns, mapping)) p.FileProblems.Add(problem);

        if (p.FileProblems.Count == 0)
        {
            for (var i = 0; i < data.Count; i++)
            {
                var number = grid.LineNumberOf(i);   // the line number in the reader's own file
                var (cells, map) = ImportParsing.Resolve(data[i], Columns, mapping, p.Cleaned);
                var (row, error, warnings) = BuildRow(cells, map, number);
                var pr = new ImportPreviewRow<TRow> { RowNumber = number, Row = row, Error = error, Cells = cells };
                foreach (var w in warnings) pr.Warnings.Add(w);
                p.Rows.Add(pr);
            }

            if (DuplicateKey is not null)
                ImportParsing.FlagDuplicatesWithinFile(p, DuplicateKey, DuplicateNoun);
        }

        preview = p;
    }

    /// <summary>
    /// Re-reads the sheet already chosen, with whatever the caller's options now say. Called by a page
    /// whose Options change how a row is BUILT — the name order, today — so the preview on screen is
    /// always the import that would actually run.
    /// </summary>
    public void RebuildPreview()
    {
        if (lastCsv is null || job is not null) return;
        Build(lastCsv);
        StateHasChanged();
    }

    private async Task Start()
    {
        if (preview is null || !preview.CanImport || starting) return;
        starting = true;
        try
        {
            var rows = preview.Rows.Where(r => r.Importable).Select(r => r.Row!).ToList();
            var jobId = await StartAsync(rows, new ImportOptions { UpdateExisting = updateExisting });
            completedRaised = false;
            job = await LoadJobAsync(jobId) ?? new RosterImportJobDto { Id = jobId, BranchId = BranchId, TotalRows = rows.Count };
            preview = null;
            stage = Stage.Running;
            StartReconciling(jobId);
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "The import could not be started", ex.Message);
        }
        finally
        {
            starting = false;
        }
    }

    /// <summary>
    /// The push is the mechanism; this is the safety net. A dropped frame or a reconnect would
    /// otherwise leave the bar frozen on a job that has actually finished, which reads as a hang.
    /// Ten seconds is slow enough not to matter and fast enough that nobody waits on a stale bar.
    /// </summary>
    private void StartReconciling(Guid jobId)
    {
        reconcileTimer?.Dispose();
        reconcileTimer = new System.Threading.Timer(async _ =>
        {
            if (disposed) return;
            try
            {
                var latest = await LoadJobAsync(jobId);
                if (latest is null) return;
                await InvokeAsync(() => Apply(latest));
            }
            catch { /* a missed reconcile is retried on the next tick; the job runs regardless */ }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task HandleProgress(RosterImportProgressEvent e)
    {
        if (job is null || e.JobId != job.Id) return;
        liveSince = DateTime.UtcNow;
        await InvokeAsync(() => Apply(job with
        {
            Status = e.Status,
            TotalRows = e.TotalRows,
            ProcessedRows = e.ProcessedRows,
            CreatedCount = e.CreatedCount,
            UpdatedCount = e.UpdatedCount,
            DuplicateCount = e.DuplicateCount,
            FailedCount = e.FailedCount
        }));
    }

    private void Apply(RosterImportJobDto latest)
    {
        if (disposed) return;
        job = latest;
        if (IsTerminal(latest.Status))
        {
            reconcileTimer?.Dispose();
            reconcileTimer = null;
            if (!completedRaised)
            {
                completedRaised = true;
                _ = OnCompleted.InvokeAsync();
            }
        }
        StateHasChanged();
    }

    private async Task ToggleEntries()
    {
        if (showEntries) { showEntries = false; return; }
        if (LoadEntriesAsync is null || job is null) return;
        loadingEntries = true;
        try { entries = await LoadEntriesAsync(job.Id); showEntries = true; }
        catch (Exception ex) { Toast.Notify(ToastSeverity.Error, "Could not load the rows", ex.Message); }
        finally { loadingEntries = false; }
    }

    private void Reset()
    {
        reconcileTimer?.Dispose();
        reconcileTimer = null;
        job = null; preview = null; entries = new();
        showEntries = false; FileName = null; liveSince = null; completedRaised = false;
        stage = Stage.Pick; grid = null; lastCsv = null; existing = null; updateExisting = true; duplicatesConfirmed = false;
        sheetNames = new(); sheetName = null; mappingProblems = new(); mapping = new(); document = null;
    }

    private static bool IsTerminal(RosterImportStatus s)
        => s is RosterImportStatus.Completed or RosterImportStatus.CompletedWithErrors or RosterImportStatus.Failed;

    private static string StatusLabel(RosterImportStatus s) => s switch
    {
        RosterImportStatus.Pending => "Queued",
        RosterImportStatus.Processing => "Importing",
        RosterImportStatus.Completed => "Done",
        RosterImportStatus.CompletedWithErrors => "Done, with problems",
        RosterImportStatus.Failed => "Could not run",
        _ => s.ToString()
    };

    /// <summary>One sentence a person can act on, rather than four numbers they have to add up.</summary>
    private string SummarySentence()
    {
        if (job is null) return string.Empty;
        var parts = new List<string>();
        if (job.CreatedCount > 0) parts.Add($"{job.CreatedCount} created");
        if (job.UpdatedCount > 0) parts.Add($"{job.UpdatedCount} updated");
        if (job.DuplicateCount > 0) parts.Add($"{job.DuplicateCount} already existed and {(job.DuplicateCount == 1 ? "was" : "were")} left alone");
        if (job.FailedCount > 0) parts.Add($"{job.FailedCount} could not be imported");

        if (parts.Count == 0) return $"Nothing changed — all {job.TotalRows} row(s) were already up to date.";
        var body = parts.Count == 1 ? parts[0] : string.Join(", ", parts.Take(parts.Count - 1)) + " and " + parts[^1];
        var tail = job.FailedCount > 0 ? " Open the row-by-row result to see which rows and why." : "";
        return $"Of {job.TotalRows} row(s): {body}.{tail}";
    }

    /// <summary>
    /// The template's columns come straight from <see cref="Columns"/>, so the file a reader
    /// downloads and the file this panel can read are the same thing by construction — the pair
    /// cannot drift the way two hand-maintained lists would.
    /// </summary>
    private IReadOnlyList<ExportColumn<ImportTemplateRow>> BuildTemplateColumns()
        => Columns.Select((c, i) => new ExportColumn<ImportTemplateRow>(
               c.Required ? c.Name + " *" : c.Name,
               r => r.At(i))).ToList();

    private Task<ExportRows<ImportTemplateRow>> TemplateRowsAsync()
        => Task.FromResult(new ExportRows<ImportTemplateRow>(
               TemplateRows.Select(r => new ImportTemplateRow(r)).ToList(), false));

    public void Dispose()
    {
        disposed = true;
        if (subscribed) NotificationClient.OnRosterImportProgressReceived -= HandleProgress;
        reconcileTimer?.Dispose();
    }
}
