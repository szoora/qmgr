    .q-import__table-wrap { overflow-x: auto; }
    .q-import__row--bad td { background: rgba(var(--qm-danger-rgb), .08); }
    .q-import__row--warn td { background: rgba(var(--qm-warning-rgb), .10); }
    .q-import__ok { color: var(--qm-success); }
    .q-import__warn { color: var(--qm-warning); }
    .q-import__bad { color: var(--qm-danger); }
