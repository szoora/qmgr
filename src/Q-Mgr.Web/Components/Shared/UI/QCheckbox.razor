@namespace QMgr.Web.Components.Shared.UI

@* A click anywhere inside a <label> is re-dispatched to its control, so a QInfo button nested in
   this one would toggle the box. It is a SIBLING, in a row beside it — the same rule as QInput. *@
@* Class goes on the WRAPPER, not the label: the wrapper is the element a parent flex row lays
   out, and every caller's Class is a layout rule (flex, margin). Putting it on the label meant
   .q-bulkbar__all, .jr-pick and .notif-unread were all inert — three copies of "flex: 0 0 auto"
   styling something that is not a flex item. *@
<span class="q-field__label-row q-checkbox-row @Class">
<label class="q-checkbox @(Disabled ? "q-checkbox--disabled" : "") @(Value ? "q-checkbox--checked" : "")">
    <input type="checkbox"
           class="q-checkbox__input"
           checked="@Value"
           disabled="@Disabled"
           @onchange="HandleChange"
           @attributes="AdditionalAttributes" />
    <span class="q-checkbox__box">
        @if (Value)
        {
            <i class="bi bi-check q-checkbox__icon"></i>
        }
    </span>
    @if (!string.IsNullOrEmpty(Label) || ChildContent != null)
    {
        <span class="q-checkbox__label">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Label
            }
            @if (Required)
            {
                <span class="q-checkbox__required">*</span>
            }
        </span>
    }
</label>
@if (!string.IsNullOrWhiteSpace(Hint))
{
    <QInfo Text="@Hint" Label="@Label" />
}
</span>

@code {
    /// <summary>
    /// The sentence explaining what switching this on DOES, in a QInfo beside it rather than as a
    /// paragraph underneath. A warning still belongs on the page.
    /// </summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>
    /// Whether the checkbox is checked
    /// </summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>
    /// Callback when checked state changes
    /// </summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// Label text
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Whether the checkbox is disabled
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Renders the required asterisk next to the label — same convention as QInput/QSelect/
    /// QDatePicker. Purely visual; actual enforcement is a DataAnnotations/validation concern.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Additional CSS classes
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Custom label content
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional HTML attributes
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (!Disabled)
        {
            var newValue = (bool)(e.Value ?? false);
            Value = newValue;
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}
