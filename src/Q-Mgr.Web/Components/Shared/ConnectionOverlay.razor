@using QMgr.Web.Services
@inject IConnectionMonitorService ConnectionMonitor
@inject IBrandContext Brand
@implements IDisposable

@* A white-labelled tenant sees THEIR mark here, not ours. This overlay covers the whole screen at
   the moment the product is least reassuring, so it is the worst place to hand somebody another
   company's name. The logo and the name come from IBrandContext, which the shell has already
   resolved for this session, and every colour is a --qm-* token so the palette follows too. *@

@if (ShowOverlay)
{
    <div class="connection-overlay @(IsReconnecting ? "reconnecting" : "disconnected")">
        <div class="overlay-content">
            @if (!string.IsNullOrWhiteSpace(Brand.FaviconUrl))
            {
                <img class="overlay-brand" src="@Brand.FaviconUrl" alt="@Brand.AppName" />
            }

            <div class="overlay-icon">
                @if (IsReconnecting)
                {
                    <div class="reconnecting-spinner">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                }
                else
                {
                    <i class="bi bi-wifi-off"></i>
                }
            </div>

            <h2>@Title</h2>
            <p class="message">@Message</p>

            @if (ConnectionMonitor.LastConnectedAt.HasValue)
            {
                <p class="last-connected">
                    Last connected: @GetTimeAgo(ConnectionMonitor.LastConnectedAt.Value)
                </p>
            }

            @if (!IsReconnecting)
            {
                <div class="overlay-actions">
                    <button class="btn-retry" @onclick="RetryConnection">
                        <i class="bi bi-arrow-clockwise"></i>
                        Try Again
                    </button>
                </div>

                @* The three generic tips that were here told a reader nothing they had not already
                   thought of. One line, naming the only thing that is actually theirs to check. *@
                <p class="troubleshooting">Your work is kept. Check your connection and try again.</p>
            }
            else
            {
                <div class="retry-info">
                    <p>Attempt @ConnectionMonitor.ReconnectAttempts of 3</p>
                    <div class="retry-progress">
                        <div class="retry-bar" style="width: @(ConnectionMonitor.ReconnectAttempts * 33.33)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .connection-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        /* The scrim reads as the product, not as a black sheet: the brand at a low alpha over a
           near-opaque dark ground, so a rebranded tenant is still recognisably theirs. */
        background: rgba(var(--qm-primary-rgb), 0.16);
        backdrop-filter: blur(3px);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .overlay-brand {
        display: block;
        width: 40px;
        height: 40px;
        margin: 0 auto 14px;
        object-fit: contain;
        border-radius: var(--qm-radius-md);
    }


    .overlay-content {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 480px;
        width: 90%;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .overlay-icon {
        font-size: 64px;
        margin-bottom: 24px;
    }

    .connection-overlay.disconnected .overlay-icon {
        color: var(--qm-danger);
    }

    .connection-overlay.reconnecting .overlay-icon {
        color: var(--qm-warning);
    }

    .reconnecting-spinner {
        display: inline-block;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .overlay-content h2 {
        margin: 0 0 12px;
        font-size: var(--qm-text-stat);
        font-weight: 700;
        color: var(--qm-text-primary);
    }

    .overlay-content .message {
        margin: 0 0 16px;
        font-size: var(--qm-text-md);
        color: var(--qm-text-secondary);
        line-height: 1.6;
    }

    .last-connected {
        font-size: var(--qm-text-base);
        color: var(--qm-text-muted);
        margin-bottom: 24px;
    }

    .overlay-actions {
        margin-bottom: 32px;
    }

    .btn-retry {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 32px;
        background: var(--qm-gradient-primary);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-on-primary);
        font-size: var(--qm-text-md);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-retry:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(var(--qm-primary-rgb), 0.3);
    }

    .btn-retry:active {
        transform: translateY(0);
    }

    .btn-retry i {
        font-size: var(--qm-text-lg);
    }

    .troubleshooting {
        text-align: left;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-xl);
        padding: 16px 20px;
    }

    .troubleshooting-title {
        margin: 0 0 8px;
        font-size: var(--qm-text-base);
        font-weight: 600;
        color: var(--qm-text-secondary);
    }

    .troubleshooting ul {
        margin: 0;
        padding-left: 20px;
        color: var(--qm-text-muted);
        font-size: var(--qm-text-base);
    }

    .troubleshooting li {
        margin-bottom: 4px;
    }

    .retry-info {
        margin-top: 24px;
    }

    .retry-info p {
        margin: 0 0 12px;
        font-size: var(--qm-text-base);
        color: var(--qm-text-muted);
    }

    .retry-progress {
        height: 4px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
    }

    .retry-bar {
        height: 100%;
        background: var(--qm-warning);
        transition: width 0.3s ease;
    }

    /* Light mode */
    [data-theme="light"] .connection-overlay {
        background: rgba(var(--qm-primary-rgb), 0.10);
    }

    [data-theme="light"] .overlay-content {
        background: var(--qm-bg-card);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
    }

    [data-theme="light"] .btn-retry {
        color: var(--qm-text-on-primary);
    }
</style>

@code {
    private bool ShowOverlay => ConnectionMonitor.Status == ConnectionStatus.Disconnected ||
                                 ConnectionMonitor.Status == ConnectionStatus.Reconnecting;

    private bool IsReconnecting => ConnectionMonitor.Status == ConnectionStatus.Reconnecting;

    private string Title => IsReconnecting ? "Reconnecting..." : "Connection Lost";

    private string Message => IsReconnecting
        ? "Reconnecting."
        : ConnectionMonitor.StatusMessage;

    protected override void OnInitialized()
    {
        ConnectionMonitor.OnStatusChanged += HandleStatusChanged;
    }

    private void HandleStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task RetryConnection()
    {
        await ConnectionMonitor.CheckConnectionAsync();
    }

    private string GetTimeAgo(DateTime dateTime)
    {
        var diff = DateTime.Now - dateTime;

        if (diff.TotalSeconds < 60)
            return "just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} minute{((int)diff.TotalMinutes != 1 ? "s" : "")} ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} hour{((int)diff.TotalHours != 1 ? "s" : "")} ago";

        return QDateFormat.CDT(dateTime);
    }

    public void Dispose()
    {
        ConnectionMonitor.OnStatusChanged -= HandleStatusChanged;
    }
}
