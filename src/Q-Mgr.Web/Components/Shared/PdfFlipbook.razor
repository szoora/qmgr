@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="pdf-flipbook @CssClass @(isFullscreen ? "pdf-flipbook--fullscreen" : "")"
     id="@rootId"
     tabindex="0"
     @onkeydown="HandleKeyDown"
     @onkeydown:preventDefault="true">

    @if (isLoading)
    {
        <div class="pdf-flipbook-status">
            <QSpinner Size="lg" />
            <span>Loading document...</span>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="pdf-flipbook-status">
            <QIcon Name="exclamation-triangle-fill" />
            <span>@errorMessage</span>
            <a href="@Url" target="_blank" class="pdf-flipbook-fallback-link">
                <QIcon Name="box-arrow-up-right" /> Open PDF in new tab
            </a>
        </div>
    }

    <div class="pdf-flipbook-body" style="@(isLoading || errorMessage != null ? "display:none;" : "")">
        @if (ShowThumbnails && showThumbRail)
        {
            <div class="pdf-flipbook-thumbs" id="@thumbsId"></div>
        }

        <div class="pdf-flipbook-main">
            @if (ShowToolbar)
            {
                <div class="pdf-flipbook-toolbar">
                    @if (ShowThumbnails)
                    {
                        <QButton Icon="grid-3x3-gap-fill" Variant="secondary" Size="sm" OnClick="@(() => showThumbRail = !showThumbRail)" Title="@(showThumbRail ? "Hide thumbnails" : "Show thumbnails")" />
                    }
                    <div class="pdf-flipbook-zoom">
                        <QButton Icon="dash-lg" Variant="secondary" Size="sm" OnClick="@ZoomOut" Disabled="@(zoomLevel <= MinZoom)" Title="Zoom out" />
                        <span class="pdf-flipbook-zoom-level">@($"{zoomLevel * 100:F0}%")</span>
                        <QButton Icon="plus-lg" Variant="secondary" Size="sm" OnClick="@ZoomIn" Disabled="@(zoomLevel >= MaxZoom)" Title="Zoom in" />
                    </div>
                    <QButton Icon="@(isFullscreen ? "fullscreen-exit" : "fullscreen")" Variant="secondary" Size="sm" OnClick="@ToggleFullscreen" Title="@(isFullscreen ? "Exit fullscreen" : "Fullscreen")" />
                    <a href="@Url" target="_blank" class="pdf-flipbook-toolbar-link" title="Open original in new tab">
                        <QIcon Name="box-arrow-up-right" />
                    </a>
                </div>
            }

            <div class="pdf-flipbook-container" id="@containerId" style="transform: scale(@zoomLevel.ToString(System.Globalization.CultureInfo.InvariantCulture));"></div>

            @if (ShowControls && pageCount > 1)
            {
                <div class="pdf-flipbook-controls">
                    <QButton Icon="chevron-left" Variant="secondary" Size="sm" OnClick="@PreviousPage" Disabled="@(currentPage <= 1)" Title="Previous page" />
                    <span class="pdf-flipbook-page-indicator">Page @currentPage of @pageCount</span>
                    <QButton Icon="chevron-right" Variant="secondary" Size="sm" OnClick="@NextPage" Disabled="@(currentPage >= pageCount)" Title="Next page" />
                </div>
            }
        </div>
    </div>
</div>

<style>
    .pdf-flipbook {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: var(--qm-bg-dark, #0a0a0a);
        overflow: hidden;
        outline: none;
    }

    .pdf-flipbook--fullscreen {
        background: #000;
    }

    .pdf-flipbook-status {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        color: var(--qm-text-secondary, rgba(255, 255, 255, 0.6));
        padding: 40px;
        text-align: center;
    }

    .pdf-flipbook-status .q-icon {
        font-size: 40px;
    }

    .pdf-flipbook-fallback-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        color: var(--qm-primary);
        text-decoration: none;
        font-size: 14px;
    }

    .pdf-flipbook-fallback-link:hover {
        text-decoration: underline;
    }

    .pdf-flipbook-body {
        display: flex;
        width: 100%;
        height: 100%;
        min-height: 0;
    }

    .pdf-flipbook-thumbs {
        width: 96px;
        flex-shrink: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 10px;
        background: rgba(0, 0, 0, 0.3);
        border-right: 1px solid var(--qm-border, rgba(255, 255, 255, 0.08));
    }

    .pdf-flipbook-thumb {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 4px;
        border: 2px solid transparent;
        border-radius: var(--qm-radius-sm, 3px);
        background: none;
        cursor: pointer;
        width: 100%;
    }

    .pdf-flipbook-thumb img {
        width: 100%;
        border-radius: 2px;
        display: block;
    }

    .pdf-flipbook-thumb span {
        font-size: 11px;
        color: var(--qm-text-secondary, rgba(255, 255, 255, 0.6));
    }

    .pdf-flipbook-thumb:hover {
        border-color: var(--qm-primary-light, rgba(140, 47, 82, 0.4));
    }

    .pdf-flipbook-thumb--active {
        border-color: var(--qm-primary);
    }

    .pdf-flipbook-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
    }

    .pdf-flipbook-toolbar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 8px;
        flex-shrink: 0;
    }

    .pdf-flipbook-zoom {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .pdf-flipbook-zoom-level {
        font-size: 12px;
        color: var(--qm-text-secondary, rgba(255, 255, 255, 0.6));
        min-width: 40px;
        text-align: center;
    }

    .pdf-flipbook-toolbar-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: var(--qm-radius-sm, 3px);
        color: var(--qm-text-secondary, rgba(255, 255, 255, 0.7));
        text-decoration: none;
    }

    .pdf-flipbook-toolbar-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: var(--qm-primary);
    }

    .pdf-flipbook-container {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 0;
        overflow: auto;
        transform-origin: center center;
        transition: transform 0.15s ease;
    }

    .pdf-flipbook-container .pdf-flipbook-surface {
        margin: 0 auto;
    }

    .pdf-flipbook-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 12px;
        flex-shrink: 0;
    }

    .pdf-flipbook-page-indicator {
        font-size: 13px;
        color: var(--qm-text-secondary, rgba(255, 255, 255, 0.7));
        min-width: 110px;
        text-align: center;
    }
</style>

@code {
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public bool AutoAdvance { get; set; } = false;
    [Parameter] public int PageDurationSeconds { get; set; } = 6;
    [Parameter] public bool ShowControls { get; set; } = true;
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public bool ShowThumbnails { get; set; } = true;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public EventCallback OnMediaEnded { get; set; }
    [Parameter] public EventCallback OnMediaError { get; set; }

    private const double MinZoom = 0.5;
    private const double MaxZoom = 2.5;
    private const double ZoomStep = 0.25;

    private readonly string instanceId = Guid.NewGuid().ToString("N");
    private string rootId => $"pdf-flip-root-{instanceId}";
    private string containerId => $"pdf-flip-{instanceId}";
    private string thumbsId => $"pdf-flip-thumbs-{instanceId}";

    private DotNetObjectReference<PdfFlipbook>? dotNetRef;
    private bool isLoading = true;
    private string? errorMessage;
    private int pageCount = 0;
    private int currentPage = 1;
    private string? loadedUrl;
    private bool showThumbRail = true;
    private double zoomLevel = 1.0;
    private bool isFullscreen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDocument();
        }
        else if (loadedUrl != Url && !string.IsNullOrEmpty(Url))
        {
            // Playlist advanced to a different PDF item reusing this same component instance.
            zoomLevel = 1.0;
            await LoadDocument();
        }
    }

    private async Task LoadDocument()
    {
        if (string.IsNullOrEmpty(Url))
            return;

        isLoading = true;
        errorMessage = null;
        loadedUrl = Url;
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            var result = await JS.InvokeAsync<FlipbookInitResult>(
                "pdfFlipbookInterop.init", containerId, thumbsId, Url, dotNetRef, AutoAdvance, PageDurationSeconds);

            if (result.Success)
            {
                pageCount = result.PageCount;
                currentPage = 1;
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Unable to display this PDF.";
                if (OnMediaError.HasDelegate)
                    await OnMediaError.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to display this PDF.";
            Console.WriteLine($"PDF flipbook load failed: {ex.Message}");
            if (OnMediaError.HasDelegate)
                await OnMediaError.InvokeAsync();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NextPage() => await JS.InvokeVoidAsync("pdfFlipbookInterop.next", containerId);
    private async Task PreviousPage() => await JS.InvokeVoidAsync("pdfFlipbookInterop.prev", containerId);

    private void ZoomIn()
    {
        zoomLevel = Math.Min(MaxZoom, Math.Round(zoomLevel + ZoomStep, 2));
    }

    private void ZoomOut()
    {
        zoomLevel = Math.Max(MinZoom, Math.Round(zoomLevel - ZoomStep, 2));
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync("pdfFlipbookInterop.toggleFullscreen", rootId);
        // isFullscreen itself is updated via the JS fullscreenchange listener
        // (OnFullscreenChanged below) so it stays correct even if the user
        // exits fullscreen natively (Escape key) rather than via this button.
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
            case " ":
                await NextPage();
                break;
            case "ArrowLeft":
                await PreviousPage();
                break;
            case "+":
            case "=":
                ZoomIn();
                break;
            case "-":
                ZoomOut();
                break;
            case "f":
            case "F":
                await ToggleFullscreen();
                break;
        }
    }

    [JSInvokable]
    public void OnPageFlipped(int page, int totalPages)
    {
        currentPage = page;
        pageCount = totalPages;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool fullscreen)
    {
        isFullscreen = fullscreen;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFlipbookEnded()
    {
        if (OnMediaEnded.HasDelegate)
            await OnMediaEnded.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pdfFlipbookInterop.dispose", containerId);
        }
        catch
        {
            // Ignore — circuit may already be gone
        }

        dotNetRef?.Dispose();
    }

    private record FlipbookInitResult
    {
        public bool Success { get; init; }
        public int PageCount { get; init; }
        public string? ErrorMessage { get; init; }
    }
}
