@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Interactive PDF flip-book.

    Styles live in wwwroot/css/pdf-flipbook.css rather than in a <style> block here, because the
    vendored page-flip rules (.stf__*) are global by nature and the file also documents why they
    have to be vendored at all.

    Two behaviours worth knowing before editing the markup:

    - The loading/error panel is an ABSOLUTE OVERLAY, never `display: none` on the body. page-flip
      measures its container on construction; a container inside a `display: none` subtree measures
      0x0, and the book is then permanently sized to nothing. The old version hid the body while
      loading and this is one of the two reasons nothing ever appeared.

    - The root's keydown handler must NOT preventDefault unconditionally. The search box and the
      page-number box are inside the root, and blanket-preventing the default killed typing in
      them. Those inputs stop propagation instead, so the shortcuts below only ever see keys
      pressed outside a field.
*@

<div class="pdf-flipbook @CssClass @(isFullscreen ? "pdf-flipbook--fullscreen" : "") @(SignageMode ? "pdf-flipbook--signage" : "")"
     id="@rootId"
     tabindex="0"
     @onkeydown="HandleKeyDown">

    <div class="pdf-flipbook-body">
        @if (ShowThumbnails && showThumbRail)
        {
            <div class="pdf-flipbook-thumbs" id="@thumbsId"></div>
        }

        <div class="pdf-flipbook-main">
            @if (ShowToolbar)
            {
                <div class="pdf-flipbook-toolbar">
                    @if (ShowThumbnails)
                    {
                        <QButton Icon="grid-3x3-gap-fill" Variant="secondary" Size="sm"
                                 OnClick="@ToggleThumbRail"
                                 Title="@(showThumbRail ? "Hide page thumbnails" : "Show page thumbnails")"
                                 aria-label="@(showThumbRail ? "Hide page thumbnails" : "Show page thumbnails")" />
                    }

                    @if (ShowSearch)
                    {
                        <div class="pdf-flipbook-search">
                            @* @bind (not value= plus @oninput) is required here — see the "Text inputs
                               must use @bind" section in CLAUDE.md. @bind:after debounces into the
                               actual search so a keystroke does not start a document-wide scan. *@
                            <input type="search"
                                   placeholder="Search document"
                                   aria-label="Search document"
                                   @bind="searchText"
                                   @bind:event="oninput"
                                   @bind:after="QueueSearch"
                                   @onkeydown="HandleSearchKey"
                                   @onkeydown:stopPropagation="true" />
                            <span class="pdf-flipbook-search-count">@SearchCountLabel</span>
                            <QButton Icon="chevron-up" Variant="secondary" Size="sm"
                                     OnClick="@(() => StepMatch(-1))" Disabled="@(matchTotal == 0)"
                                     Title="Previous match" aria-label="Previous match" />
                            <QButton Icon="chevron-down" Variant="secondary" Size="sm"
                                     OnClick="@(() => StepMatch(1))" Disabled="@(matchTotal == 0)"
                                     Title="Next match" aria-label="Next match" />
                        </div>
                        <div class="pdf-flipbook-toolbar-sep"></div>
                    }

                    <div class="pdf-flipbook-toolbar-group">
                        <QButton Icon="@(viewMode == "single" ? "file-earmark" : "book")"
                                 Variant="secondary" Size="sm" OnClick="@ToggleViewMode"
                                 Disabled="@(pageCount <= 1)"
                                 Title="@(viewMode == "single" ? "Switch to two-page spread" : "Switch to single page")"
                                 aria-label="@(viewMode == "single" ? "Switch to two-page spread" : "Switch to single page")" />
                    </div>

                    <div class="pdf-flipbook-toolbar-sep"></div>

                    <div class="pdf-flipbook-toolbar-group">
                        <QButton Icon="dash-lg" Variant="secondary" Size="sm" OnClick="@ZoomOut"
                                 Disabled="@(zoomLevel <= MinZoom)" Title="Zoom out" aria-label="Zoom out" />
                        <span class="pdf-flipbook-zoom-level">@($"{zoomLevel * 100:F0}%")</span>
                        <QButton Icon="plus-lg" Variant="secondary" Size="sm" OnClick="@ZoomIn"
                                 Disabled="@(zoomLevel >= MaxZoom)" Title="Zoom in" aria-label="Zoom in" />
                        <QButton Icon="aspect-ratio" Variant="secondary" Size="sm" OnClick="@ResetZoom"
                                 Disabled="@(Math.Abs(zoomLevel - 1.0) < 0.001)"
                                 Title="Fit to screen" aria-label="Fit to screen" />
                    </div>

                    <div class="pdf-flipbook-toolbar-sep"></div>

                    <QButton Icon="@(isFullscreen ? "fullscreen-exit" : "fullscreen")"
                             Variant="secondary" Size="sm" OnClick="@ToggleFullscreen"
                             Title="@(isFullscreen ? "Exit full screen" : "Full screen")"
                             aria-label="@(isFullscreen ? "Exit full screen" : "Full screen")" />

                    <a href="@Url" target="_blank" rel="noopener"
                       class="pdf-flipbook-toolbar-link"
                       title="Open the original PDF in a new tab"
                       aria-label="Open the original PDF in a new tab">
                        <QIcon Name="box-arrow-up-right" />
                    </a>
                </div>
            }

            <div class="pdf-flipbook-stage" id="@containerId"></div>

            @if (ShowControls && pageCount > 1)
            {
                <div class="pdf-flipbook-controls">
                    <QButton Icon="chevron-left" Variant="secondary" Size="sm" OnClick="@PreviousPage"
                             Disabled="@(currentPage <= 1)" Title="Previous page" aria-label="Previous page" />
                    <span class="pdf-flipbook-page-indicator">
                        Page
                        <input type="number" min="1" max="@pageCount"
                               aria-label="Page number"
                               @bind="pageInput"
                               @bind:after="JumpToTypedPage"
                               @onkeydown:stopPropagation="true" />
                        of @pageCount
                    </span>
                    <QButton Icon="chevron-right" Variant="secondary" Size="sm" OnClick="@NextPage"
                             Disabled="@(currentPage >= pageCount)" Title="Next page" aria-label="Next page" />
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="pdf-flipbook-status">
            <QSpinner Size="lg" />
            <span>@LoadingLabel</span>
            @if (pageCount > 0)
            {
                <div class="pdf-flipbook-status-progress">
                    <span style="width:@(RenderPercent)%"></span>
                </div>
            }
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="pdf-flipbook-status">
            <QIcon Name="exclamation-triangle-fill" />
            <span>@errorMessage</span>
            <a href="@Url" target="_blank" rel="noopener" class="pdf-flipbook-fallback-link">
                <QIcon Name="box-arrow-up-right" /> Open PDF in new tab
            </a>
        </div>
    }
</div>

@code {
    [Parameter] public string Url { get; set; } = "";

    /// <summary>Turn pages on a timer. Set by signage; off for a person reading at their own pace.</summary>
    [Parameter] public bool AutoAdvance { get; set; } = false;

    /// <summary>Seconds each page (or spread) stays on screen while auto-advancing.</summary>
    [Parameter] public int PageDurationSeconds { get; set; } = 6;

    /// <summary>
    /// Return to page one at the end instead of raising <see cref="OnMediaEnded"/>. This is what a
    /// single-document signage screen wants: it never ends, it just starts again.
    /// </summary>
    [Parameter] public bool Loop { get; set; } = false;

    /// <summary>Fade the chrome out after a few idle seconds, the way an unattended screen should.</summary>
    [Parameter] public bool SignageMode { get; set; } = false;

    [Parameter] public bool ShowControls { get; set; } = true;
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public bool ShowThumbnails { get; set; } = true;
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public EventCallback OnMediaEnded { get; set; }
    [Parameter] public EventCallback OnMediaError { get; set; }

    private const double MinZoom = 0.5;
    private const double MaxZoom = 4.0;
    private const double ZoomStep = 0.25;

    private readonly string instanceId = Guid.NewGuid().ToString("N");
    private string rootId => $"pdf-flip-root-{instanceId}";
    private string containerId => $"pdf-flip-{instanceId}";
    private string thumbsId => $"pdf-flip-thumbs-{instanceId}";

    private DotNetObjectReference<PdfFlipbook>? dotNetRef;
    private bool isLoading = true;
    private string? errorMessage;
    private int pageCount;
    private int currentPage = 1;
    private int pageInput = 1;
    private int renderedPages;
    private string? loadedUrl;
    private bool showThumbRail = true;
    private double zoomLevel = 1.0;
    private bool isFullscreen;
    private string viewMode = "spread";

    private string searchText = "";
    private int matchTotal;
    private int matchCurrent;
    private CancellationTokenSource? searchDebounce;

    private string LoadingLabel => pageCount == 0
        ? "Loading document..."
        : $"Preparing pages ({renderedPages} of {pageCount})";

    private int RenderPercent => pageCount == 0 ? 0 : (int)Math.Round(renderedPages * 100.0 / pageCount);

    private string SearchCountLabel => string.IsNullOrWhiteSpace(searchText)
        ? ""
        : matchTotal == 0 ? "No match" : $"{matchCurrent} / {matchTotal}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDocument();
        }
        else if (loadedUrl != Url && !string.IsNullOrEmpty(Url))
        {
            // The playlist advanced to a different PDF on this same component instance.
            zoomLevel = 1.0;
            viewMode = "spread";
            searchText = "";
            matchTotal = 0;
            matchCurrent = 0;
            await LoadDocument();
        }
    }

    private async Task LoadDocument()
    {
        if (string.IsNullOrEmpty(Url)) return;

        isLoading = true;
        errorMessage = null;
        pageCount = 0;
        renderedPages = 0;
        currentPage = 1;
        pageInput = 1;
        loadedUrl = Url;
        StateHasChanged();

        dotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            var result = await JS.InvokeAsync<FlipbookInitResult>("pdfFlipbookInterop.init", new
            {
                containerId,
                thumbsId,
                rootId,
                url = Url,
                dotNetRef,
                autoAdvance = AutoAdvance,
                pageDurationSeconds = PageDurationSeconds,
                loop = Loop,
                viewMode
            });

            if (result.Success)
            {
                pageCount = result.PageCount;
                currentPage = 1;
                pageInput = 1;
                if (pageCount == 1) viewMode = "single";
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Unable to display this PDF.";
                if (OnMediaError.HasDelegate) await OnMediaError.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to display this PDF.";
            Console.WriteLine($"PDF flipbook load failed: {ex.Message}");
            if (OnMediaError.HasDelegate) await OnMediaError.InvokeAsync();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NextPage() => await JS.InvokeVoidAsync("pdfFlipbookInterop.next", containerId);

    private async Task PreviousPage() => await JS.InvokeVoidAsync("pdfFlipbookInterop.prev", containerId);

    private async Task JumpToTypedPage()
    {
        var target = Math.Clamp(pageInput, 1, Math.Max(1, pageCount));
        pageInput = await JS.InvokeAsync<int>("pdfFlipbookInterop.goToPage", containerId, target);
    }

    private void ToggleThumbRail() => showThumbRail = !showThumbRail;

    private async Task ToggleViewMode()
    {
        var wanted = viewMode == "single" ? "spread" : "single";
        viewMode = await JS.InvokeAsync<string>("pdfFlipbookInterop.setViewMode", containerId, wanted);
    }

    private Task ZoomIn() => SetZoom(Math.Min(MaxZoom, Math.Round(zoomLevel + ZoomStep, 2)));

    private Task ZoomOut() => SetZoom(Math.Max(MinZoom, Math.Round(zoomLevel - ZoomStep, 2)));

    private Task ResetZoom() => SetZoom(1.0);

    private async Task SetZoom(double zoom)
    {
        zoomLevel = await JS.InvokeAsync<double>("pdfFlipbookInterop.setZoom", containerId, zoom);
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync("pdfFlipbookInterop.toggleFullscreen", rootId);
        // isFullscreen is updated from OnFullscreenChanged instead of here, so it stays right when
        // the user leaves full screen with Escape rather than with this button.
    }

    /// <summary>
    /// Debounces typing into one search. Cancelling the previous delay rather than searching on
    /// every keystroke matters more than usual here: the first search walks the text of every page.
    /// </summary>
    private async Task QueueSearch()
    {
        searchDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        searchDebounce = cts;

        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await RunSearch();
    }

    private async Task RunSearch()
    {
        try
        {
            var result = await JS.InvokeAsync<SearchResult>("pdfFlipbookInterop.search", containerId, searchText);
            matchTotal = result.Total;
            matchCurrent = result.Current;
            if (result.Page > 0) currentPage = pageInput = result.Page;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"PDF flipbook search failed: {ex.Message}");
        }
    }

    private async Task StepMatch(int delta)
    {
        if (matchTotal == 0) return;
        var result = await JS.InvokeAsync<SearchResult>("pdfFlipbookInterop.stepMatch", containerId, delta);
        matchTotal = result.Total;
        matchCurrent = result.Current;
        if (result.Page > 0) currentPage = pageInput = result.Page;
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (matchTotal > 0) await StepMatch(e.ShiftKey ? -1 : 1);
            else await RunSearch();
        }
        else if (e.Key == "Escape")
        {
            searchText = "";
            matchTotal = 0;
            matchCurrent = 0;
            await JS.InvokeVoidAsync("pdfFlipbookInterop.clearSearch", containerId);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowRight":
            case "PageDown":
            case " ":
                await NextPage();
                break;
            case "ArrowLeft":
            case "PageUp":
                await PreviousPage();
                break;
            case "Home":
                pageInput = 1;
                await JumpToTypedPage();
                break;
            case "End":
                pageInput = pageCount;
                await JumpToTypedPage();
                break;
            case "+":
            case "=":
                await ZoomIn();
                break;
            case "-":
                await ZoomOut();
                break;
            case "0":
                await ResetZoom();
                break;
            case "f":
            case "F":
                await ToggleFullscreen();
                break;
            case "d":
            case "D":
                await ToggleViewMode();
                break;
        }
    }

    [JSInvokable]
    public void OnPageFlipped(int page, int totalPages)
    {
        currentPage = page;
        pageInput = page;
        pageCount = totalPages;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnRenderProgress(int rendered, int total)
    {
        renderedPages = rendered;
        pageCount = total;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool fullscreen)
    {
        isFullscreen = fullscreen;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFlipbookEnded()
    {
        if (OnMediaEnded.HasDelegate) await OnMediaEnded.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        searchDebounce?.Cancel();
        searchDebounce?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("pdfFlipbookInterop.dispose", containerId);
        }
        catch
        {
            // Circuit may already be gone.
        }

        dotNetRef?.Dispose();
    }

    private record FlipbookInitResult
    {
        public bool Success { get; init; }
        public int PageCount { get; init; }
        public string? ErrorMessage { get; init; }
    }

    private record SearchResult
    {
        public int Total { get; init; }
        public int Current { get; init; }
        public int Page { get; init; }
    }
}
