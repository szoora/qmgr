@namespace QMgr.Web.Components.Shared
@using QMgr.Web.Services

@*
    THE COPYRIGHT LINE, AND THE ONE HOME FOR IT.

    Before this there were eight copies of the same sentence and they did not agree. Five pages —
    Docs, a docs article, Privacy, Support and Terms — carried the literal
    "© 2026 SACC Software Limited. All rights reserved." with the YEAR TYPED IN, so every one of
    them would have read 2026 for ever. The shell's footer had two branches of its own, and
    EmailTemplates a ninth. A white-labelled tenant met our name on whichever of them nobody had
    remembered to check.

    IT SWAPS THE NAME; IT NEVER HIDES THE LINE. There used to be a sibling, PoweredBy, which
    answered the other half — whether "Powered by SACC Software" appears at all — by rendering
    nothing when the entitlement was held. It was deleted on 2026-09-22 once the nine public pages
    moved onto this component and it had no callers left. A copyright is not the same decision: it
    is never hidden, because a document has to carry one. The paid entitlement still decides, through
    the same AttributionRemoved flag PoweredBy read — set, the line credits the TENANT; unset, us.

    THE FUTURE HOOK IS ALREADY HERE. `Text` overrides the whole line, so when a privileged tenant
    is allowed to set their own wording it arrives through that one parameter and every surface
    picks it up at once. Nothing else needs to change, and no second copy has to be found.
*@

<p class="q-copyright @Class">@Line</p>

@code {
    /// <summary>
    /// Which host the browser arrived on. On a public page nobody is signed in, so the host is the
    /// only thing that can say whose name belongs at the foot; the signed-in shell passes the
    /// organisation instead, which is the split described above.
    /// </summary>
    [CascadingParameter] public TenantHostContext Host { get; set; } = TenantHostContext.Platform;

    /// <summary>
    /// The name to credit, when the caller already knows it — the signed-in shell passes the
    /// ORGANISATION's name, because most tenants sign in on the platform address and should not
    /// need a domain of their own to see themselves here.
    ///
    /// A PUBLIC page leaves it null and the host answers instead (below). Requiring every caller
    /// to pass it would put the same rule in eight places, and the one that forgot would credit US
    /// at the foot of a page the tenant had paid to clear — with nothing looking broken.
    /// </summary>
    [Parameter] public string? Owner { get; set; }

    /// <summary>
    /// True when this deployment's attribution has been bought out, so the line credits the tenant
    /// rather than us. Null falls back to the host's own answer.
    /// </summary>
    [Parameter] public bool? Attributed { get; set; }

    /// <summary>
    /// A short descriptor after the name — "Front Office" in the shell. Left out on a legal page,
    /// where the line is a copyright notice rather than a product signature.
    /// </summary>
    [Parameter] public string? Suffix { get; set; }

    /// <summary>Adds "All rights reserved." — the legal pages want it; the app shell does not.</summary>
    [Parameter] public bool RightsReserved { get; set; }

    /// <summary>
    /// THE EXTENSION POINT. A complete replacement for the line. Nothing sets it today; when a
    /// privileged tenant may write their own footer, it is read once, here, and every surface that
    /// renders this component follows. Deliberately a parameter rather than a new stored column:
    /// there is nothing to store until somebody may set it.
    /// </summary>
    [Parameter] public string? Text { get; set; }

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// The year is DateTime.Now, never typed. Five pages hard-coded 2026 and would have gone on
    /// saying it — the single most certain bug in a copyright line.
    /// </summary>
    private string Line
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Text)) return Text!;

            var removed = Attributed ?? Host.AttributionRemoved;

            // Whose name goes here, in the order the answer is most reliable: what the caller
            // said, then the host it arrived on, then ours. The host branch is what lets a public
            // page render this with no parameters at all — Host.AppName is the tenant's own brand
            // name, and IsTenantHost is checked so a blank Owner in the SHELL cannot quietly turn
            // "SACC" into the platform's own product name.
            //
            // "SACC", not "SACC Software Limited" (user decision 2026-09-23): the line is a
            // copyright notice, not a legal identification — Terms and Privacy name the company in
            // full, because there it is the contracting party. The mobile sign-in screen and the
            // email footer say the same, so the three cannot drift.
            var who = "SACC";
            if (removed)
            {
                if (!string.IsNullOrWhiteSpace(Owner)) who = Owner!;
                else if (Host.IsTenantHost) who = Host.AppName;
            }

            var line = $"© {DateTime.Now.Year} {who}";
            if (!string.IsNullOrWhiteSpace(Suffix)) line += $" · {Suffix}";
            if (RightsReserved) line += ". All rights reserved.";
            return line;
        }
    }
}
