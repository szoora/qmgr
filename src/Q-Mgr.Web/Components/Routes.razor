@using System.Collections.Concurrent
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@* Both of these are needed for the two tags below to resolve to real components. Without them
   Razor treats <RedirectToLogin /> and <Pages.Unauthorized /> as unknown HTML elements and emits
   them literally — they render nothing and do nothing, which is exactly what was happening until
   2026-09-06 (build warning RZ10012 on the two lines below). _Imports.razor pulls in
   QMgr.Web.Components, but a partial namespace prefix like "Pages." does not resolve a component
   tag, and Shared is not imported globally, so both are declared here explicitly rather than
   widening _Imports — putting every page component (Login, Register, Docs …) into global tag
   scope would invite name collisions across the whole app. *@
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Pages

@using QMgr.Web.Services

<CascadingAuthenticationState>
  @* The browser's address and agent, from App.razor's host request (see ViewerRequestInfo). *@
  <CascadingValue Value="Viewer" IsFixed="true">
  @* Which host this browser arrived on, and what it should look like (see TenantHostContext).
     IsFixed because the host cannot change within a circuit — the circuit IS one host. *@
  <CascadingValue Value="TenantHost" IsFixed="true">
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            @if (RequiresAuthorization(routeData.PageType))
            {
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <Unauthorized />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
            }
            else
            {
                @* A page with no [Authorize] goes through a plain RouteView, and that is a
                   security-neutral choice with one real effect. AuthorizeRouteView renders its
                   "Authorizing" and "NotAuthorized" states inside DefaultLayout — MainLayout — and
                   NOT inside the page's own @layout. The auth state here comes from localStorage
                   through JS interop, so for an anonymous visitor it is never ready synchronously,
                   and every public page (the share viewer, login, the kiosk) spent its first render
                   inside MainLayout, whose own check then sent the visitor to /login with a full
                   page load. On a warm server the real page usually won the race; on the first
                   circuit after a restart — which is what a deploy does to every open tab — it
                   lost, reproducibly. Found 2026-09-15 on the shared-document page.

                   No page in this app carries [Authorize] today: the shell's protection is
                   MainLayout's own redirect, which RouteView keeps because it still applies the
                   page's layout. The branch above is kept for any page that does add it. *@
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            }
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not Found</PageTitle>
            <LayoutView Layout="typeof(Layout.KioskLayout)">
                <div style="text-align: center; padding: 50px;">
                    <h1>404 - Page Not Found</h1>
                    <p>The requested page could not be found.</p>
                    <a href="/">Return to Dashboard</a>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
  </CascadingValue>
  </CascadingValue>
</CascadingAuthenticationState>

@inject ViewerRequestContext ViewerContext

@code {
    /// <summary>Set by App.razor from the host request; null on any render path that has no HttpContext.</summary>
    [Parameter] public ViewerRequestInfo? Viewer { get; set; }

    /// <summary>Which host this browser arrived on, resolved once by App.razor. Never null.</summary>
    [Parameter] public TenantHostContext TenantHost { get; set; } = TenantHostContext.Platform;

    /// <summary>
    /// Hands the browser's address and agent to the per-circuit context that
    /// AuthenticationMessageHandler reads, so every authenticated API call relays them
    /// (the staff activity log records them; see ViewerRequestContext).
    /// </summary>
    protected override void OnParametersSet() => ViewerContext.Set(Viewer);

    private static readonly ConcurrentDictionary<Type, bool> AuthorizationByPage = new();

    /// <summary>
    /// The same test AuthorizeRouteView applies (AttributeAuthorizeDataCache): an [Authorize]
    /// somewhere on the page type, unless an [AllowAnonymous] is there too.
    /// </summary>
    private static bool RequiresAuthorization(Type pageType) => AuthorizationByPage.GetOrAdd(pageType, static t =>
    {
        var attributes = t.GetCustomAttributes(inherit: true);
        if (attributes.Any(a => a is IAllowAnonymous)) return false;
        return attributes.Any(a => a is IAuthorizeData);
    });
}
