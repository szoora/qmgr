    private async Task SubmitFeedback()
    {
        if (feedbackRating == 0 || generatedTicket == null) return;

        isSubmittingFeedback = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                Rating = feedbackRating,
                Comment = feedbackComment,
                Category = selectedCategory,
                CustomerName = customerName,
                CustomerPhone = customerPhone
            };

            var response = await Http.PostAsJsonAsync(
                $"api/v1/branches/{branchId}/tokens/{generatedTicket!.TokenId}/feedback",
                request, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                feedbackSubmitted = true;
                NotificationService.Notify(ToastSeverity.Success, "Thank You!", "Your feedback has been submitted.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to submit feedback. Please try again.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to submit feedback: {ex.Message}");
        }
        finally
        {
            isSubmittingFeedback = false;
            StateHasChanged();
        }
    }

    private async Task GenerateFeedbackLink()
    {
        if (generatedTicket == null) return;

        try
        {
            var response = await Http.PostAsync(
                $"api/v1/branches/{branchId}/tokens/{generatedTicket!.TokenId}/feedback-link",
                null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<FeedbackLinkResponse>(JsonOptions);
                feedbackLinkCode = result?.FeedbackCode;
                StateHasChanged();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to generate feedback link.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to generate link: {ex.Message}");
        }
    }

