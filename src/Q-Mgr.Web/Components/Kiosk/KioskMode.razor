@code {
    [Parameter] public string? IndustryParam { get; set; }

    private IndustryType currentIndustry = IndustryType.General;
    private List<ServiceTypeQueueDto> serviceTypes = new();
    private ServiceTypeQueueDto? selectedService;
    private TokenDto? generatedToken;
    private bool showTicket = false;
    private bool showCustomerForm = false;
    private string? customerName;
    private string? customerPhone;
    private DateTime currentDateTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;

    // Feedback state
    private bool showFeedbackModal = false;
    private bool feedbackSubmitted = false;
    private bool isSubmittingFeedback = false;
    private int feedbackRating = 0;
    private int hoverRating = 0;
    private FeedbackCategory selectedCategory = FeedbackCategory.General;
    private string? feedbackComment;
    private string? feedbackLinkCode;
    private string? ticketFeedbackCode;

    // Kiosk settings & auto-redirect timer
    private KioskSettingsDto? kioskSettings;
    private System.Threading.Timer? redirectTimer;
    private int countdownSeconds;
    private bool ticketPrinted = false;

    private readonly List<(FeedbackCategory Value, string Label, string Icon)> feedbackCategories = new()
    {
        (FeedbackCategory.General, "General", "chat"),
        (FeedbackCategory.ServiceQuality, "Service", "star-fill"),
        (FeedbackCategory.WaitTime, "Wait Time", "clock-history"),
        (FeedbackCategory.StaffBehavior, "Staff", "person"),
        (FeedbackCategory.Facility, "Facility", "building"),
        (FeedbackCategory.Other, "Other", "three-dots")
    };

    private Guid BranchId => BranchState.CurrentBranchId;

    protected override async Task OnInitializedAsync()
    {
        // Initialize branch state
        await BranchState.InitializeAsync();

        // If no branch is configured, auto-select the first available branch
        if (BranchState.CurrentBranchId == Guid.Empty)
        {
            try
            {
                var response = await Http.GetAsync("api/v1/branches");
                if (response.IsSuccessStatusCode)
                {
                    var branches = await response.Content.ReadFromJsonAsync<List<BranchApiDto>>(JsonOptions);
                    var firstBranch = branches?.FirstOrDefault(b => b.IsActive);
                    if (firstBranch != null)
                    {
                        await BranchState.SetBranchAsync(firstBranch.Id, firstBranch.Name);
                    }
                }
            }
            catch
            {
                // Unable to load branches - will show error when trying to create token
            }
        }

        // Industry is configured by admin in Organization settings
        // URL parameter is only for admin preview/testing purposes
        if (!string.IsNullOrEmpty(IndustryParam) && Enum.TryParse<IndustryType>(IndustryParam, true, out var industry))
        {
            currentIndustry = industry; // Admin preview mode
        }
        else
        {
            // Production: Load from organization settings via API
            // TODO: currentIndustry = await QueueApi.GetOrganizationIndustryAsync(BranchId);
        }

        await LoadServiceTypes();
        await LoadKioskSettings();

        // Start clock timer for real-time display
        clockTimer = new System.Threading.Timer(async _ =>
        {
            currentDateTime = DateTime.Now;
            await InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private async Task LoadKioskSettings()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/branches/{BranchId}/kiosk-settings");
            if (response.IsSuccessStatusCode)
            {
                kioskSettings = await response.Content.ReadFromJsonAsync<KioskSettingsDto>(JsonOptions);
            }
        }
        catch
        {
            // Use defaults if settings can't be loaded
            kioskSettings = new KioskSettingsDto();
        }
        kioskSettings ??= new KioskSettingsDto();
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
        StopRedirectTimer();
    }

    private void StartRedirectTimer()
    {
        StopRedirectTimer();
        countdownSeconds = kioskSettings?.TicketDisplayTimeoutSeconds ?? 15;
        ticketPrinted = false;

        redirectTimer = new System.Threading.Timer(async _ =>
        {
            countdownSeconds--;
            if (countdownSeconds <= 0)
            {
                StopRedirectTimer();

                // Auto-print if enabled and not already printed
                if (kioskSettings?.AutoPrintBeforeRedirect == true && !ticketPrinted && generatedToken != null)
                {
                    await InvokeAsync(PrintToken);
                }

                await InvokeAsync(CloseTicket);
            }
            await InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    private void StopRedirectTimer()
    {
        redirectTimer?.Dispose();
        redirectTimer = null;
    }

    private void ResetRedirectTimer()
    {
        if (redirectTimer != null)
        {
            countdownSeconds = kioskSettings?.TicketDisplayTimeoutSeconds ?? 15;
        }
    }

    private async Task LoadServiceTypes()
    {
        var status = await QueueApi.GetQueueStatusAsync(BranchId);
        serviceTypes = status?.ServiceTypes ?? new();
    }

    private async Task SelectService(ServiceTypeQueueDto serviceType)
    {
        selectedService = serviceType;
        // Option: Show customer form first
        // showCustomerForm = true;
        // Or directly create token
        await CreateToken();
    }

    private async Task SubmitCustomerInfo()
    {
        showCustomerForm = false;
        await CreateToken();
    }

    private async Task SkipCustomerInfo()
    {
        customerName = null;
        customerPhone = null;
        showCustomerForm = false;
        await CreateToken();
    }

    private async Task CreateToken()
    {
        if (selectedService == null) return;

        // Check if branch is configured
        if (BranchId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Error, "Configuration Error", "No branch configured. Please contact administrator.");
            return;
        }

        generatedToken = await QueueApi.CreateTokenAsync(BranchId, selectedService.Code,
            new CustomerDto { Name = customerName, Phone = customerPhone });

        if (generatedToken != null)
        {
            showTicket = true;
            await LoadServiceTypes();

            // Generate feedback link for the ticket
            try
            {
                var feedbackResponse = await Http.PostAsync(
                    $"api/v1/branches/{BranchId}/tokens/{generatedToken.Id}/feedback-link",
                    null);

                if (feedbackResponse.IsSuccessStatusCode)
                {
                    var result = await feedbackResponse.Content.ReadFromJsonAsync<FeedbackLinkResponse>(JsonOptions);
                    ticketFeedbackCode = result?.FeedbackCode;
                }
            }
            catch
            {
                // Feedback link generation is not critical
            }

            // Check if auto-print is enabled and print automatically
            await CheckAndAutoPrint();

            // Start the auto-redirect timer
            StartRedirectTimer();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to generate token. Please try again.");
        }
    }

    private async Task CheckAndAutoPrint()
    {
        if (generatedToken == null) return;

        try
        {
            // Get printer settings to check if auto-print is enabled
            var settingsResponse = await Http.GetAsync($"api/v1/branches/{BranchId}/printer-settings");
            if (settingsResponse.IsSuccessStatusCode)
            {
                var settings = await settingsResponse.Content.ReadFromJsonAsync<PrinterSettingsResponse>(JsonOptions);
                if (settings?.AutoPrintOnTokenCreate == true)
                {
                    // Auto-print is enabled, trigger print
                    await PrintToken();
                }
            }
        }
        catch
        {
            // Auto-print check is not critical - user can still print manually
        }
    }

    private async Task PrintToken()
    {
        if (generatedToken == null)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "No token to print.");
            return;
        }

        NotificationService.Notify(ToastSeverity.Info, "Printing...", "Preparing your ticket...");

        try
        {
            // Get print data from API
            var response = await Http.GetAsync($"api/v1/branches/{BranchId}/tokens/{generatedToken.Id}/print-data");

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(ToastSeverity.Error, "Print Error", "Failed to get print data.");
                return;
            }

            var printData = await response.Content.ReadFromJsonAsync<PrintDataResponse>(JsonOptions);

            if (printData == null)
            {
                NotificationService.Notify(ToastSeverity.Error, "Print Error", "Invalid print data received.");
                return;
            }

            // Get method name from enum value
            var methodName = await JSRuntime.InvokeAsync<string>("QMgrPrint.getMethodName", (int)printData.PreferredMethod);

            // Initialize print service with preferred method
            await JSRuntime.InvokeVoidAsync("QMgrPrint.init", methodName);

            // Prepare print data object for JavaScript
            var jsPrintData = new
            {
                htmlContent = printData.HtmlContent,
                escPosData = printData.EscPosData,
                printerName = printData.PrinterName,
                printerIpAddress = printData.PrinterIpAddress,
                printerPort = printData.PrinterPort
            };

            // Execute print
            var result = await JSRuntime.InvokeAsync<PrintJsResult>("QMgrPrint.print", jsPrintData);

            if (result.Success)
            {
                ticketPrinted = true;
                ResetRedirectTimer(); // Give user more time after printing
                NotificationService.Notify(ToastSeverity.Success, "Print Sent", result.Message ?? "Please collect your ticket from the printer.");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Warning, "Print Notice", result.Message ?? "Print may not have completed. Please check the printer.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Print Error", $"Failed to print: {ex.Message}");
        }
    }

