@page "/queue/kiosk"
@page "/kiosk"
@page "/kiosk/{IndustryParam}"
@page "/kiosk/branch/{BranchId:guid}"
@page "/kiosk/branch/{BranchId:guid}/{IndustryParam}"
@layout KioskLayout
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using System.Text.Json
@inject IQueueApiService QueueApi
@inject IBranchStateService BranchState
@inject IOrganizationApiService OrganizationApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IToastService NotificationService
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject JsonSerializerOptions JsonOptions
@inject NavigationManager Navigation

@*
    URL scheme (the "/kiosk/branch/…" segment exists because "/kiosk/{IndustryParam}" is a
    catch-all string route — a bare "/kiosk/{guid}" would be swallowed as an industry name):
      /kiosk                                   -> signed-in admin only: their selected branch
      /kiosk/{industry}                        -> same, with an industry-theme preview
      /kiosk/branch/{branchId}                 -> public, shareable (what Customer Links emits)
      /kiosk/branch/{branchId}/{industry}      -> public + industry-theme preview
      /kiosk?branch={branchId}                 -> also accepted (query form)
*@

@if (branchState != BranchResolveState.Ready)
{
    <div class="kiosk-container @GetIndustryClass()">
        @if (branchState == BranchResolveState.Resolving)
        {
            <div class="branch-state" role="status" aria-live="polite">
                <QSpinner Size="lg" />
                <span class="visually-hidden">Loading the services offered at this branch.</span>
            </div>
        }
        else if (branchState == BranchResolveState.NoBranch)
        {
            <div class="branch-state" role="alert">
                <QIcon Name="geo-alt" aria-hidden="true" />
                <h1>No branch selected</h1>
                <p>
                    Open this screen from <strong>Customer Links</strong> in the admin, or add the
                    branch ID to the URL: <code>/kiosk/branch/{branchId}</code>
                </p>
            </div>
        }
        else
        {
            <div class="branch-state" role="alert">
                <QIcon Name="exclamation-triangle" aria-hidden="true" />
                <h1>This branch link is not valid</h1>
                <p>
                    The branch may have been removed or deactivated. Open a fresh link from
                    <strong>Customer Links</strong> in the admin.
                </p>
            </div>
        }
    </div>
}
else
{
<div class="kiosk-container @GetIndustryClass()">
    <!-- Header -->
    <header class="kiosk-header">
        <div class="header-content">
            <div class="logo-area">
                <div class="logo-icon">
                    <QIcon Name="@GetIndustryIcon()" aria-hidden="true" />
                </div>
                <div class="logo-meta">
                    <span class="logo-text">@GetHeaderTitle()</span>
                    @if (!string.IsNullOrWhiteSpace(branchInfo?.Name))
                    {
                        <span class="branch-label">@branchInfo!.Name</span>
                    }
                </div>
            </div>
            @* The clock updates every second. It is deliberately NOT a live region: announcing
               it would talk over everything else a screen-reader user is trying to hear. *@
            <div class="header-info" aria-live="off">
                <span class="datetime">@currentDateTime.ToString("dddd, MMMM dd, yyyy")</span>
                <span class="time">@currentDateTime.ToString("HH:mm:ss")</span>
            </div>
        </div>
        <div class="welcome-section">
            <h1>@GetWelcomeMessage()</h1>
            <p>@GetInstructionMessage()</p>
        </div>
    </header>

    <!-- Services Grid -->
    <main class="kiosk-body">
        <h2 class="visually-hidden">Choose a service</h2>
        <div class="kiosk-body-inner">
        @* Real button elements, not clickable divs: a kiosk is a public terminal and these tiles
           have to be reachable with a keyboard, a switch or a screen reader, not just a
           fingertip. The .service-card rule below resets the browser's button styling so the
           tiles look exactly as they did before. *@
        <div class="services-grid" role="group" aria-label="Services offered at this branch">
            @foreach (var serviceType in serviceTypes)
            {
                var description = string.IsNullOrWhiteSpace(serviceType.Description)
                    ? GetServiceDescription(serviceType.Code)
                    : serviceType.Description!;
                <button type="button"
                        class="service-card"
                        aria-label="@($"Get a ticket for {serviceType.Name}. {description}. {serviceType.WaitingCount} people are waiting, about {serviceType.EstimatedWaitMinutes} minutes.")"
                        disabled="@isIssuingTicket"
                        @onclick="@(() => SelectService(serviceType))">
                    <span class="service-icon-wrapper">
                        <span class="service-icon">
                            <QIcon Name="@GetServiceIcon(serviceType.Code)" aria-hidden="true" />
                        </span>
                    </span>
                    <span class="service-content">
                        <span class="service-name">@serviceType.Name</span>
                        <span class="service-description">@description</span>
                    </span>
                    <span class="service-stats" aria-hidden="true">
                        <span class="stat">
                            <span class="stat-value">@serviceType.WaitingCount</span>
                            <span class="stat-label">Waiting</span>
                        </span>
                        <span class="stat-divider"></span>
                        <span class="stat">
                            <span class="stat-value">~@serviceType.EstimatedWaitMinutes</span>
                            <span class="stat-label">Minutes</span>
                        </span>
                    </span>
                    <span class="service-action" aria-hidden="true">
                        <span>Tap to Get Ticket</span>
                        <QIcon Name="hand-index-fill" />
                    </span>
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(issueError))
        {
            <div class="kiosk-error" role="alert">
                <QIcon Name="exclamation-triangle-fill" aria-hidden="true" />
                <span>@issueError</span>
            </div>
        }
        </div>
    </main>

    <!-- Footer -->
    <footer class="kiosk-footer">
        <div class="footer-content">
            <span>Need assistance? Please ask our staff for help.</span>
            <div class="language-selector" role="group" aria-label="Kiosk language">
                <button type="button" class="lang-btn active" aria-pressed="true" aria-label="Show this kiosk in English">EN</button>
                <button type="button" class="lang-btn" aria-pressed="false" aria-label="Show this kiosk in Arabic">AR</button>
            </div>
        </div>
    </footer>
</div>
}

<!-- Ticket Modal -->
@if (showTicket)
{
    <div class="ticket-overlay @GetIndustryClass()" @onclick="CloseTicket">
        <div class="ticket-modal" role="dialog" aria-modal="true" aria-labelledby="kiosk-ticket-title" @onclick:stopPropagation="true">
            <div class="ticket-success">
                <div class="success-icon">
                    <QIcon Name="check-circle-fill" aria-hidden="true" />
                </div>
                <h2 id="kiosk-ticket-title">Your Ticket</h2>
            </div>

            @* assertive, unlike everything else on this screen: the customer has just asked for
               a number and this is the answer — it has to interrupt, not queue behind other
               announcements. *@
            <div class="ticket-number-display" role="status" aria-live="assertive">
                <span class="ticket-number">@generatedTicket?.DisplayNumber</span>
                <span class="visually-hidden">
                    Your ticket number is @SpellOut(generatedTicket?.DisplayNumber).
                    You are number @generatedTicket?.Position in the queue,
                    about @generatedTicket?.EstimatedWaitMinutes minutes.
                </span>
            </div>

            <div class="ticket-info">
                <div class="info-row">
                    <span class="info-label">Service</span>
                    <span class="info-value">@(generatedTicket?.ServiceTypeName ?? selectedService?.Name)</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Position</span>
                    <span class="info-value">#@generatedTicket?.Position in queue</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Estimated Wait</span>
                    <span class="info-value">@generatedTicket?.EstimatedWaitMinutes minutes</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Time Issued</span>
                    <span class="info-value">@(generatedTicket?.IssuedAt.ToLocalTime().ToString("HH:mm"))</span>
                </div>
            </div>

            <div class="ticket-qr">
                @* A real QR (qrcodejs, already loaded app-wide) pointing at this ticket's own
                   status page, so the customer can walk away and still watch their place in
                   the queue from their phone. Falls back to the placeholder glyph if the
                   library did not load. *@
                <div class="qr-code-box" id="kiosk-ticket-qr"></div>
                @if (!ticketQrRendered)
                {
                    <div class="qr-placeholder">
                        <QIcon Name="qr-code" aria-hidden="true" />
                    </div>
                }
                <span>Scan to follow your place in the queue</span>
                <span class="ticket-status-url">@TicketStatusUrl()</span>
            </div>

            @if (!string.IsNullOrEmpty(ticketFeedbackCode))
            {
                <div class="ticket-feedback-url">
                    <QIcon Name="chat-square-text-fill" aria-hidden="true" />
                    <div class="feedback-url-info">
                        <span class="feedback-url-label">Give feedback later:</span>
                        <span class="feedback-url-code">@(Navigation.BaseUri)feedback/@ticketFeedbackCode</span>
                    </div>
                </div>
            }

            <div class="ticket-actions">
                <button type="button" class="ticket-btn primary" aria-label="Print this ticket on the kiosk printer" @onclick="PrintToken">
                    <QIcon Name="printer-fill" aria-hidden="true" />
                    <span>Print Ticket</span>
                </button>
                <button type="button" class="ticket-btn secondary" aria-label="Send this ticket number to a phone by text message" @onclick="SendSMS">
                    <QIcon Name="chat-dots-fill" aria-hidden="true" />
                    <span>Send SMS</span>
                </button>
            </div>

            <div class="ticket-notice">
                <QIcon Name="info-circle-fill" aria-hidden="true" />
                <p>Please wait in the waiting area. Your number will be displayed on the screen when called.</p>
            </div>

            <div class="feedback-prompt">
                <button type="button" class="feedback-prompt-btn" aria-label="Rate your experience at this branch" @onclick="ShowFeedbackModal">
                    <QIcon Name="chat-square-text-fill" aria-hidden="true" />
                    <span>Rate Your Experience</span>
                </button>
            </div>

            @if (kioskSettings?.ShowCountdown == true && redirectTimer != null)
            {
                @* aria-live="off": this ticks once a second and would otherwise drown out the
                   ticket number itself. *@
                <button type="button" class="countdown-display" aria-live="off"
                        aria-label="Stay on this screen. This ticket closes automatically in @countdownSeconds seconds."
                        @onclick="ResetRedirectTimer">
                    <QIcon Name="clock-history" aria-hidden="true" />
                    <span>Returning to home in @countdownSeconds seconds...</span>
                    <small>Tap anywhere to stay on this screen</small>
                </button>
            }

            <button type="button" class="close-btn" aria-label="Close this ticket and return to the list of services" @onclick="CloseTicket">
                <QIcon Name="x-lg" aria-hidden="true" />
            </button>
        </div>
    </div>
}

<!-- Feedback Modal -->
@if (showFeedbackModal)
{
    <div class="feedback-overlay @GetIndustryClass()" @onclick="CloseFeedbackModal">
        <div class="feedback-modal" role="dialog" aria-modal="true" aria-labelledby="kiosk-feedback-title" @onclick:stopPropagation="true">
            <button type="button" class="close-btn" aria-label="Close the feedback form without sending it" @onclick="CloseFeedbackModal">
                <QIcon Name="x-lg" aria-hidden="true" />
            </button>

            @if (!feedbackSubmitted)
            {
                <div class="feedback-header">
                    <div class="feedback-icon">
                        <QIcon Name="emoji-smile-fill" aria-hidden="true" />
                    </div>
                    <h2 id="kiosk-feedback-title">How was your experience?</h2>
                    <p>Your feedback helps us improve our services</p>
                </div>

                <div class="star-rating" role="group" aria-label="Rate your experience out of five stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var rating = i;
                        <button type="button"
                                class="star-btn @(feedbackRating >= rating ? "active" : "") @(hoverRating >= rating ? "hover" : "")"
                                aria-pressed="@(feedbackRating == rating ? "true" : "false")"
                                aria-label="@($"Rate your experience {rating} out of 5 stars")"
                                @onclick="@(() => SetRating(rating))"
                                @onmouseenter="@(() => hoverRating = rating)"
                                @onmouseleave="@(() => hoverRating = 0)">
                            <QIcon Name="@(feedbackRating >= rating || hoverRating >= rating ? "star-fill" : "star")" aria-hidden="true" />
                        </button>
                    }
                </div>

                <div class="rating-label" role="status" aria-live="polite">
                    @GetRatingLabel()
                </div>

                <div class="feedback-categories">
                    <p class="category-label" id="kiosk-feedback-category-label">What can we improve?</p>
                    <div class="category-chips" role="group" aria-labelledby="kiosk-feedback-category-label">
                        @foreach (var cat in feedbackCategories)
                        {
                            <button type="button"
                                    class="category-chip @(selectedCategory == cat.Value ? "selected" : "")"
                                    aria-pressed="@(selectedCategory == cat.Value ? "true" : "false")"
                                    aria-label="@($"This feedback is about {cat.Label}")"
                                    @onclick="@(() => selectedCategory = cat.Value)">
                                <QIcon Name="@cat.Icon" aria-hidden="true" />
                                <span>@cat.Label</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="feedback-comment">
                    <label class="visually-hidden" for="kiosk-feedback-comment">Share your thoughts about your visit. This is optional.</label>
                    <textarea id="kiosk-feedback-comment"
                              @bind="feedbackComment"
                              placeholder="Share your thoughts (optional)..."
                              rows="3"></textarea>
                </div>

                <div class="feedback-actions">
                    <button type="button" class="feedback-btn secondary" aria-label="Skip giving feedback" @onclick="CloseFeedbackModal">
                        Skip
                    </button>
                    <button type="button" class="feedback-btn primary" @onclick="SubmitFeedback" disabled="@(feedbackRating == 0 || isSubmittingFeedback)">
                        @if (isSubmittingFeedback)
                        {
                            <QIcon Name="arrow-repeat" class="spinning" aria-hidden="true" />
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <QIcon Name="send-fill" aria-hidden="true" />
                            <span>Submit Feedback</span>
                        }
                    </button>
                </div>

                <div class="feedback-link-section">
                    <p>Prefer to give feedback later?</p>
                    <button type="button" class="get-link-btn" aria-label="Get a code so you can give feedback later" @onclick="GenerateFeedbackLink">
                        <QIcon Name="link-45deg" aria-hidden="true" />
                        <span>Get Feedback Link</span>
                    </button>
                    @if (!string.IsNullOrEmpty(feedbackLinkCode))
                    {
                        <div class="feedback-link-display" role="status" aria-live="polite">
                            <span class="link-code">@feedbackLinkCode</span>
                            <span class="link-hint">Visit: yoursite.com/feedback/@feedbackLinkCode</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="feedback-success" role="status" aria-live="polite">
                    <div class="success-animation">
                        <div class="success-checkmark">
                            <QIcon Name="check-circle-fill" aria-hidden="true" />
                        </div>
                    </div>
                    <h2 id="kiosk-feedback-title">Thank You!</h2>
                    <p>Your feedback has been submitted successfully.</p>
                    <p class="thank-you-message">We appreciate you taking the time to help us improve.</p>
                    <button type="button" class="feedback-btn primary" aria-label="Close the feedback form" @onclick="CloseFeedbackModal">
                        <QIcon Name="check-lg" aria-hidden="true" />
                        <span>Done</span>
                    </button>
                </div>
            }
        </div>
    </div>
}

<!-- Customer Info Modal -->
@if (showCustomerForm)
{
    <div class="ticket-overlay @GetIndustryClass()" @onclick="@(() => showCustomerForm = false)">
        <div class="customer-form-modal" role="dialog" aria-modal="true" aria-labelledby="kiosk-customer-title" @onclick:stopPropagation="true">
            <h2 id="kiosk-customer-title">Customer Information</h2>
            <p>Optional: Enter your details for notifications</p>

            <div class="form-group">
                <label for="kiosk-customer-name">Name</label>
                <input id="kiosk-customer-name" type="text" autocomplete="name" maxlength="120" @bind="customerName" placeholder="Your name" />
            </div>

            <div class="form-group">
                <label for="kiosk-customer-phone">Phone Number</label>
                <input id="kiosk-customer-phone" type="tel" autocomplete="tel" maxlength="32" @bind="customerPhone" placeholder="+1234567890" />
            </div>

            <div class="form-actions">
                <button type="button" class="form-btn secondary" aria-label="Skip entering your details and get a ticket" @onclick="SkipCustomerInfo">Skip</button>
                <button type="button" class="form-btn primary" aria-label="Continue and get a ticket" @onclick="SubmitCustomerInfo">Continue</button>
            </div>
        </div>
    </div>
}

<style>
    .kiosk-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--kiosk-gradient, linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 100%));
        overflow: hidden;
    }

    /* Industry-specific themes */
    .kiosk-container.industry-general,
    .ticket-overlay.industry-general,
    .feedback-overlay.industry-general {
        --kiosk-gradient: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 100%);
        /* Not var(--qm-primary): that token is tuned for light dashboard backgrounds
           and fails WCAG AA here (as low as 1.98:1, needs 3:1+) against this always-dark
           kiosk gradient. Fixed, lighter wine accent scoped to this dark-only context instead.
           accent-dark is also used as .ticket-btn.primary's hover background, which
           pairs with dark (#0f0f1a) button text — #8c2f52 there was only 2.96:1 against
           that dark text (needs 4.5:1 at 16px/600), so accent-dark here is a *lighter*
           tint than accent, not a literal "darker" shade. */
        --kiosk-accent: #d1567f;
        --kiosk-accent-dark: #e0759e;
    }

    .kiosk-container.industry-hospital,
    .ticket-overlay.industry-hospital,
    .feedback-overlay.industry-hospital {
        --kiosk-gradient: linear-gradient(135deg, #1a0f0f 0%, #2e1a1a 100%);
        --kiosk-accent: #ef4444;
        /* Lightened from #dc2626 (3.94:1 vs the dark #0f0f1a button text — fails 4.5:1) */
        --kiosk-accent-dark: #e56060;
    }

    .kiosk-container.industry-bank,
    .ticket-overlay.industry-bank,
    .feedback-overlay.industry-bank {
        --kiosk-gradient: linear-gradient(135deg, #0f1a0f 0%, #1a2e1a 100%);
        --kiosk-accent: #22c55e;
        --kiosk-accent-dark: #16a34a;
    }

    .kiosk-container.industry-pharmacy,
    .ticket-overlay.industry-pharmacy,
    .feedback-overlay.industry-pharmacy {
        --kiosk-gradient: linear-gradient(135deg, #1a0f1a 0%, #2e1a2e 100%);
        /* Lightened from #3b5169 (2.33:1 against this gradient, 2.28:1 as text on it — both
           fail) and #9333ea (3.54:1 vs dark button text — fails 4.5:1). */
        --kiosk-accent: #82a3c9;
        --kiosk-accent-dark: #b06ef0;
    }

    .kiosk-container.industry-electronicsshop,
    .ticket-overlay.industry-electronicsshop,
    .feedback-overlay.industry-electronicsshop {
        --kiosk-gradient: linear-gradient(135deg, #1a1a0f 0%, #2e2e1a 100%);
        --kiosk-accent: #f59e0b;
        --kiosk-accent-dark: #f59e0b;
    }

    .kiosk-container.industry-government,
    .ticket-overlay.industry-government,
    .feedback-overlay.industry-government {
        --kiosk-gradient: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 100%);
        --kiosk-accent: #3b82f6;
        /* Lightened from #2563eb (3.68:1 vs the dark #0f0f1a button text — fails 4.5:1) */
        --kiosk-accent-dark: #467aee;
    }

    .kiosk-container.industry-telecom,
    .ticket-overlay.industry-telecom,
    .feedback-overlay.industry-telecom {
        --kiosk-gradient: linear-gradient(135deg, #1a0f1a 0%, #2e1a2a 100%);
        --kiosk-accent: #ec4899;
        /* Lightened from #db2777 (4.14:1 vs the dark #0f0f1a button text — fails 4.5:1) */
        --kiosk-accent-dark: #df3d85;
    }

    .kiosk-container.industry-restaurant,
    .ticket-overlay.industry-restaurant,
    .feedback-overlay.industry-restaurant {
        --kiosk-gradient: linear-gradient(135deg, #1a100a 0%, #2e1a10 100%);
        --kiosk-accent: #f97316;
        --kiosk-accent-dark: #ea580c;
    }

    /* Header */
    .kiosk-header {
        padding: 30px 40px;
        color: white;
        background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, transparent 100%);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }

    .logo-area {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .logo-icon {
        width: 60px;
        height: 60px;
        background: var(--kiosk-accent);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 30px rgba(140, 47, 82, 0.3);
    }

    .logo-icon .q-icon {
        font-size: 32px;
        color: #0f0f1a;
    }

    .logo-meta {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .logo-text {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .branch-label {
        font-size: 15px;
        font-weight: 500;
        opacity: 0.75;
    }

    /* Branch-resolution states (no branch / invalid link / resolving). Token-only so
       they follow the layout's [data-theme] automatically; sits on the industry gradient. */
    .branch-state {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 40px;
        text-align: center;
        color: var(--qm-text-primary);
        font-family: var(--qm-font-primary);
    }

    .branch-state .q-icon {
        font-size: 64px;
        color: var(--qm-text-muted);
    }

    .branch-state h1 {
        margin: 0;
        font-family: var(--qm-font-display);
        font-size: 28px;
        font-weight: 700;
    }

    .branch-state p {
        margin: 0;
        max-width: 560px;
        font-size: 16px;
        line-height: 1.6;
        color: var(--qm-text-secondary);
    }

    .branch-state code {
        font-family: var(--qm-font-mono);
        font-size: 14px;
        padding: 2px 8px;
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-sm);
        color: var(--qm-text-primary);
    }

    .header-info {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        background: rgba(255,255,255,0.05);
        padding: 12px 20px;
        border-radius: var(--qm-radius-xl);
        backdrop-filter: blur(10px);
    }

    .header-info .datetime {
        font-size: 14px;
        opacity: 0.7;
    }

    .header-info .time {
        font-size: 36px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        color: var(--kiosk-accent);
    }

    .welcome-section {
        text-align: center;
    }

    .welcome-section h1 {
        font-size: 56px;
        font-weight: 800;
        margin: 0 0 16px;
        color: white;
        text-shadow: 0 0 40px rgba(255,255,255,0.1);
    }

    .welcome-section p {
        font-size: 22px;
        opacity: 0.8;
        margin: 0;
    }

    /* Body */
    .kiosk-body {
        flex: 1;
        padding: 0 40px 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        max-width: 1400px;
        width: 100%;
    }

    /* The tile is a real button element for keyboard, switch and screen-reader access. These first four
       declarations undo the browser's own button styling so it renders exactly as the old
       div did, and everything below them is the original rule, unchanged. */
    .service-card {
        appearance: none;
        -webkit-appearance: none;
        font: inherit;
        text-align: inherit;
        width: 100%;
        color: inherit;
        margin: 0;

        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--qm-radius-xl);
        padding: 32px;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(20px);
    }

    .service-card:disabled {
        opacity: 0.55;
        cursor: progress;
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--kiosk-accent), var(--kiosk-accent-dark));
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .service-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, var(--kiosk-accent) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-12px) scale(1.02);
        border-color: var(--kiosk-accent);
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4), 0 0 40px rgba(140, 47, 82, 0.15);
    }

    .service-card:hover::before {
        opacity: 1;
    }

    .service-card:hover::after {
        opacity: 0.05;
    }

    .service-card:active {
        transform: translateY(-6px) scale(0.98);
    }

    .service-icon-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 24px;
        position: relative;
        z-index: 1;
    }

    .service-icon {
        width: 90px;
        height: 90px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s ease;
    }

    .service-icon .q-icon {
        font-size: 40px;
        color: var(--kiosk-accent);
    }

    .service-card:hover .service-icon {
        background: var(--kiosk-accent);
        border-color: var(--kiosk-accent);
        transform: scale(1.1);
        box-shadow: 0 0 30px rgba(140, 47, 82, 0.4);
    }

    .service-card:hover .service-icon .q-icon {
        color: #0f0f1a;
    }

    .service-content {
        display: block;
        text-align: center;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }

    /* display:block because these were heading and paragraph elements before the tile became a button — a button's
       content must be phrasing, so they are span elements now and need the block behaviour back. */
    .service-name {
        display: block;
        font-size: 22px;
        font-weight: 700;
        color: white;
        margin: 0 0 8px;
    }

    /* 14px -> 17px: this screen is read standing up, at arm's length or further. */
    .service-description {
        display: block;
        font-size: 17px;
        color: rgba(255, 255, 255, 0.75);
        margin: 0;
    }

    .service-stats {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 24px;
        padding: 20px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 16px;
        position: relative;
        z-index: 1;
    }

    .stat {
        text-align: center;
    }

    .stat-value {
        display: block;
        font-size: 28px;
        font-weight: 800;
        color: var(--kiosk-accent);
        font-family: 'JetBrains Mono', monospace;
    }

    /* 11px -> 14px: legible from standing distance. */
    .stat-label {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.65);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .stat-divider {
        width: 1px;
        height: 40px;
        background: rgba(255, 255, 255, 0.1);
    }

    .service-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--kiosk-accent);
        font-weight: 600;
        font-size: 17px;
        position: relative;
        z-index: 1;
    }

    /* Anonymous ticket issuing can fail for reasons the customer needs told plainly
       (queue full, too many requests from this terminal). */
    .kiosk-error {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        max-width: 900px;
        margin: 24px auto 0;
        padding: 18px 24px;
        border-radius: var(--qm-radius-xl);
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        color: #f59e0b;
        font-size: 18px;
        font-weight: 600;
        text-align: center;
    }

    /* .kiosk-body is a centring flex row; this wrapper keeps the grid full-width inside it
       while giving the error message somewhere to sit underneath. */
    .kiosk-body-inner {
        width: 100%;
        max-width: 1400px;
    }

    .service-action .q-icon {
        font-size: 22px;
        animation: pulse-tap 2s infinite;
    }

    @@keyframes pulse-tap {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.2); }
    }

    /* Footer */
    .kiosk-footer {
        padding: 24px 40px;
        background: rgba(0, 0, 0, 0.3);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: rgba(255, 255, 255, 0.75);
        font-size: 17px;
    }

    .language-selector {
        display: flex;
        gap: 10px;
    }

    .lang-btn {
        padding: 10px 20px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.05);
        color: white;
        border-radius: var(--qm-radius-lg);
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .lang-btn:hover, .lang-btn.active {
        background: var(--kiosk-accent);
        color: #0f0f1a;
        border-color: var(--kiosk-accent);
    }

    /* Ticket Modal */
    .ticket-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        animation: fadeIn 0.3s ease;
        backdrop-filter: blur(10px);
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .ticket-modal {
        background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 480px;
        width: 90%;
        position: relative;
        animation: slideUp 0.4s ease;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), 0 0 60px rgba(140, 47, 82, 0.1);
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(50px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .close-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--kiosk-accent);
    }

    .close-btn .q-icon {
        font-size: 20px;
        color: rgba(255, 255, 255, 0.6);
    }

    .ticket-success {
        text-align: center;
        margin-bottom: 24px;
    }

    .success-icon {
        width: 90px;
        height: 90px;
        background: rgba(34, 197, 94, 0.15);
        border: 2px solid rgba(34, 197, 94, 0.3);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .success-icon .q-icon {
        font-size: 48px;
        color: #22c55e;
    }

    .ticket-success h2 {
        font-size: 24px;
        margin: 0;
        color: white;
    }

    .ticket-number-display {
        text-align: center;
        padding: 32px;
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        margin-bottom: 24px;
    }

    .ticket-number {
        font-size: 90px;
        font-weight: 800;
        color: var(--kiosk-accent);
        line-height: 1;
        font-family: 'JetBrains Mono', monospace;
        text-shadow: 0 0 40px rgba(140, 47, 82, 0.4);
    }

    .ticket-info {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
        margin-bottom: 24px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: rgba(255, 255, 255, 0.65);
        font-size: 16px;
    }

    .info-value {
        font-weight: 600;
        color: white;
    }

    .ticket-qr {
        text-align: center;
        margin-bottom: 24px;
    }

    .qr-placeholder {
        width: 110px;
        height: 110px;
        background: white;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
    }

    .qr-placeholder .q-icon {
        font-size: 70px;
        color: #0f0f1a;
    }

    .ticket-qr span {
        display: block;
        font-size: 15px;
        color: rgba(255, 255, 255, 0.65);
    }

    .qr-code-box {
        display: inline-block;
        line-height: 0;
        background: white;
        padding: 10px;
        border-radius: var(--qm-radius-xl);
        margin: 0 auto 12px;
    }

    .qr-code-box:empty {
        display: none;
    }

    .ticket-status-url {
        margin-top: 6px;
        font-family: var(--qm-font-mono, 'JetBrains Mono', monospace);
        font-size: 13px !important;
        word-break: break-all;
        opacity: 0.75;
    }

    .ticket-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 24px;
    }

    .ticket-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 18px 24px;
        border-radius: var(--qm-radius-xl);
        border: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .ticket-btn.primary {
        background: var(--kiosk-accent);
        color: #0f0f1a;
    }

    .ticket-btn.primary:hover {
        background: var(--kiosk-accent-dark);
        box-shadow: 0 0 30px rgba(140, 47, 82, 0.3);
    }

    .ticket-btn.secondary {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.15);
    }

    .ticket-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.25);
    }

    .ticket-feedback-url {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.2);
        border-radius: var(--qm-radius-xl);
        margin-bottom: 20px;
    }

    .ticket-feedback-url > .q-icon {
        color: #22c55e;
        font-size: 24px;
        flex-shrink: 0;
    }

    .feedback-url-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
        overflow: hidden;
    }

    .feedback-url-label {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .feedback-url-code {
        font-size: 15px;
        font-weight: 500;
        color: #22c55e;
        word-break: break-all;
    }

    .ticket-notice {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 18px;
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.2);
        border-radius: var(--qm-radius-xl);
    }

    .ticket-notice .q-icon {
        color: #f59e0b;
        font-size: 22px;
        flex-shrink: 0;
    }

    .ticket-notice p {
        margin: 0;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.8);
        line-height: 1.5;
    }

    /* Countdown Display — a real button element (it was a clickable div), so the browser's button
       chrome is reset here and the visual result is unchanged. */
    .countdown-display {
        appearance: none;
        -webkit-appearance: none;
        font: inherit;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 16px 20px;
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: var(--qm-radius-xl);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .countdown-display:hover {
        background: rgba(59, 130, 246, 0.25);
        border-color: rgba(59, 130, 246, 0.5);
    }

    .countdown-display .q-icon {
        color: #3b82f6;
        font-size: 24px;
    }

    .countdown-display span {
        font-size: 15px;
        color: #3b82f6;
        font-weight: 500;
    }

    .countdown-display small {
        font-size: 12px;
        color: rgba(59, 130, 246, 0.7);
    }

    /* Customer Form Modal */
    .customer-form-modal {
        background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        padding: 40px;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
    }

    .customer-form-modal h2 {
        margin: 0 0 8px;
        font-size: 26px;
        color: white;
    }

    .customer-form-modal > p {
        color: rgba(255, 255, 255, 0.6);
        margin: 0 0 28px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 10px;
        color: rgba(255, 255, 255, 0.8);
    }

    .form-group input {
        width: 100%;
        padding: 16px 18px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        font-size: 16px;
        color: white;
        transition: all 0.3s ease;
    }

    .form-group input::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--kiosk-accent);
        background: rgba(255, 255, 255, 0.08);
    }

    .form-actions {
        display: flex;
        gap: 14px;
        margin-top: 32px;
    }

    .form-btn {
        flex: 1;
        padding: 18px;
        border-radius: var(--qm-radius-xl);
        border: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .form-btn.primary {
        background: var(--kiosk-accent);
        color: #0f0f1a;
    }

    .form-btn.primary:hover {
        box-shadow: 0 0 30px rgba(140, 47, 82, 0.3);
    }

    .form-btn.secondary {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.15);
    }

    .form-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.12);
    }

    /* Feedback Prompt Button */
    .feedback-prompt {
        margin-top: 20px;
        text-align: center;
    }

    .feedback-prompt-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        background: linear-gradient(135deg, #f59e0b 0%, #f59e0b 100%);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: #0f0f1a;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        animation: pulse-feedback 2s infinite;
    }

    .feedback-prompt-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 0 30px rgba(245, 158, 11, 0.4);
    }

    @@keyframes pulse-feedback {
        0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
        50% { box-shadow: 0 0 20px 10px rgba(245, 158, 11, 0.2); }
    }

    /* Feedback Modal */
    .feedback-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1100;
        animation: fadeIn 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .feedback-modal {
        background: linear-gradient(145deg, #1a1a2e 0%, #0f0f1a 100%);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 560px;
        width: 90%;
        position: relative;
        animation: slideUp 0.4s ease;
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), 0 0 60px rgba(140, 47, 82, 0.1);
        max-height: 90vh;
        overflow-y: auto;
    }

    .feedback-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .feedback-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #f59e0b 0%, #f59e0b 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .feedback-icon .q-icon {
        font-size: 44px;
        color: #0f0f1a;
    }

    .feedback-header h2 {
        margin: 0 0 8px;
        font-size: 28px;
        color: white;
    }

    .feedback-header p {
        margin: 0;
        color: rgba(255, 255, 255, 0.6);
        font-size: 16px;
    }

    /* Star Rating */
    .star-rating {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-bottom: 16px;
    }

    .star-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .star-btn .q-icon {
        font-size: 36px;
        color: rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    .star-btn:hover, .star-btn.hover {
        background: rgba(245, 158, 11, 0.1);
        border-color: rgba(245, 158, 11, 0.3);
        transform: scale(1.1);
    }

    .star-btn:hover .q-icon, .star-btn.hover .q-icon {
        color: #f59e0b;
    }

    .star-btn.active {
        background: rgba(245, 158, 11, 0.15);
        border-color: #f59e0b;
    }

    .star-btn.active .q-icon {
        color: #f59e0b;
        text-shadow: 0 0 20px rgba(245, 158, 11, 0.5);
    }

    .rating-label {
        text-align: center;
        font-size: 18px;
        font-weight: 600;
        color: var(--kiosk-accent);
        min-height: 28px;
        margin-bottom: 24px;
    }

    /* Categories */
    .feedback-categories {
        margin-bottom: 24px;
    }

    .category-label {
        text-align: center;
        margin: 0 0 16px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
    }

    .category-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .category-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        color: rgba(255, 255, 255, 0.75);
        font-size: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-chip .q-icon {
        font-size: 18px;
    }

    .category-chip:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .category-chip.selected {
        background: rgba(140, 47, 82, 0.15);
        border-color: var(--kiosk-accent);
        color: var(--kiosk-accent);
    }

    /* Comment */
    .feedback-comment {
        margin-bottom: 24px;
    }

    .feedback-comment textarea {
        width: 100%;
        padding: 16px 18px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: white;
        resize: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .feedback-comment textarea::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .feedback-comment textarea:focus {
        outline: none;
        border-color: var(--kiosk-accent);
        background: rgba(255, 255, 255, 0.08);
    }

    /* Actions */
    .feedback-actions {
        display: flex;
        gap: 14px;
        margin-bottom: 24px;
    }

    .feedback-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 18px 24px;
        border-radius: var(--qm-radius-xl);
        border: none;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .feedback-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .feedback-btn.primary {
        background: var(--kiosk-accent);
        color: #0f0f1a;
    }

    .feedback-btn.primary:hover:not(:disabled) {
        box-shadow: 0 0 30px rgba(140, 47, 82, 0.3);
    }

    .feedback-btn.secondary {
        background: rgba(255, 255, 255, 0.08);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.15);
    }

    .feedback-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.12);
    }

    .spinning {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Feedback Link Section */
    .feedback-link-section {
        text-align: center;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .feedback-link-section > p {
        margin: 0 0 12px;
        color: rgba(255, 255, 255, 0.5);
        font-size: 13px;
    }

    .get-link-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-lg);
        color: rgba(255, 255, 255, 0.7);
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .get-link-btn:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--kiosk-accent);
        color: var(--kiosk-accent);
    }

    .feedback-link-display {
        margin-top: 16px;
        padding: 16px;
        background: rgba(140, 47, 82, 0.1);
        border: 1px solid rgba(140, 47, 82, 0.2);
        border-radius: var(--qm-radius-xl);
    }

    .link-code {
        display: block;
        font-size: 24px;
        font-weight: 700;
        color: var(--kiosk-accent);
        font-family: 'JetBrains Mono', monospace;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .link-hint {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
    }

