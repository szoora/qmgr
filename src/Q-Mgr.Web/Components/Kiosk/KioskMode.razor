    .feedback-success {
        text-align: center;
        padding: 20px 0;
    }

    .success-animation {
        margin-bottom: 24px;
    }

    .success-checkmark {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: success-pop 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .success-checkmark .q-icon {
        font-size: 56px;
        color: white;
    }

    @@keyframes success-pop {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }

    .feedback-success h2 {
        margin: 0 0 12px;
        font-size: 32px;
        color: white;
    }

    .feedback-success p {
        margin: 0 0 8px;
        color: rgba(255, 255, 255, 0.7);
        font-size: 16px;
    }

    .thank-you-message {
        color: rgba(255, 255, 255, 0.5) !important;
        font-size: 14px !important;
        margin-bottom: 24px !important;
    }

    /* ================================
       Accessibility: focus + reduced motion
       Public terminals are used with keyboards, switches and assistive tech, not only
       fingertips, so every interactive element needs a focus ring that is visible against
       both the dark and the light kiosk backgrounds. --qm-text-primary is the right token
       for that here (rather than --qm-primary): it is defined per [data-theme] in
       qm-theme.css and is by definition the highest-contrast foreground for whichever
       theme KioskLayout has applied.
       ================================ */
    .kiosk-container :focus-visible,
    .ticket-overlay :focus-visible,
    .feedback-overlay :focus-visible {
        outline: 3px solid var(--qm-text-primary);
        outline-offset: 3px;
        border-radius: var(--qm-radius-sm);
    }

    /* Anything relying on a mouse-only :hover also gets the same treatment on focus, so a
       keyboard user sees the same affordance a pointer user does. */
    .service-card:focus-visible {
        transform: translateY(-12px) scale(1.02);
        border-color: var(--kiosk-accent);
    }

    /* Honour the OS "reduce motion" setting: this screen otherwise pulses, bounces, pops and
       slides, which is exactly the class of animation that triggers vestibular symptoms. */
    @@media (prefers-reduced-motion: reduce) {
        .kiosk-container *,
        .kiosk-container *::before,
        .kiosk-container *::after,
        .ticket-overlay *,
        .ticket-overlay *::before,
        .ticket-overlay *::after,
        .feedback-overlay *,
        .feedback-overlay *::before,
        .feedback-overlay *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }

        .service-card:hover,
        .service-card:focus-visible {
            transform: none;
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
