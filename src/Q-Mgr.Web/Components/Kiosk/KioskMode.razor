    private async Task CreateToken()
    {
        if (selectedService == null || isIssuingTicket) return;

        // Check if branch is configured
        if (branchId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Error, "Configuration Error", "No branch configured. Please contact administrator.");
            return;
        }

        isIssuingTicket = true;
        issueError = null;
        StateHasChanged();

        PublicTicketResult result;
        try
        {
            // POST api/v1/branches/{branchId}/queue/tokens — the anonymous endpoint. The old
            // call went to the [Authorize]d POST .../tokens, which meant this screen only ever
            // worked while a staff member happened to be signed in on the terminal.
            result = await QueueApi.IssuePublicTokenAsync(branchId, new PublicJoinQueueRequest
            {
                ServiceTypeId = selectedService.Id,
                ServiceTypeCode = selectedService.Code,
                CustomerName = customerName,
                CustomerPhone = customerPhone
            });
        }
        finally
        {
            isIssuingTicket = false;
        }

        if (!result.Success)
        {
            // Shown in the page, not only as a toast: on a wall-mounted terminal a toast that
            // fades after a few seconds is easy to miss while you are still looking at the tiles.
            issueError = result.Message ?? "We could not issue a ticket right now. Please ask a member of staff.";
            NotificationService.Notify(
                result.IsQueueFull || result.IsRateLimited ? ToastSeverity.Warning : ToastSeverity.Error,
                result.IsQueueFull ? "Queue full" : "Ticket not issued",
                issueError);
            await InvokeAsync(StateHasChanged);
            return;
        }

        generatedTicket = result.Ticket;
        ticketQrRendered = false;
        showTicket = true;
        await LoadServiceTypes();

        // Generate feedback link for the ticket. This endpoint is still [Authorize]d
        // (feedback.view), so on an unattended terminal it simply 401s and the ticket shows
        // without a feedback code — deliberately non-fatal rather than blocking the ticket.
        try
        {
            var feedbackResponse = await Http.PostAsync(
                $"api/v1/branches/{branchId}/tokens/{generatedTicket!.TokenId}/feedback-link",
                null);

            if (feedbackResponse.IsSuccessStatusCode)
            {
                var feedbackResult = await feedbackResponse.Content.ReadFromJsonAsync<FeedbackLinkResponse>(JsonOptions);
                ticketFeedbackCode = feedbackResult?.FeedbackCode;
            }
        }
        catch
        {
            // Feedback link generation is not critical
        }

        // Check if auto-print is enabled and print automatically
        await CheckAndAutoPrint();

        // Start the auto-redirect timer
        StartRedirectTimer();

        await InvokeAsync(StateHasChanged);
        await RenderTicketQrAsync();
    }

    /// <summary>The customer's own status page for this ticket — what the QR encodes.</summary>
    private string TicketStatusUrl() =>
        generatedTicket == null
            ? string.Empty
            : $"{Navigation.BaseUri.TrimEnd('/')}/ticket/{branchId}/{Uri.EscapeDataString(generatedTicket.DisplayNumber)}";

    private async Task RenderTicketQrAsync()
    {
        if (generatedTicket == null) return;

        try
        {
            // visitorBadge.renderQr wraps qrcodejs, which is already loaded app-wide in
            // App.razor — no new dependency, and no server-side rendering cost.
            await JSRuntime.InvokeVoidAsync("visitorBadge.renderQr", "kiosk-ticket-qr", TicketStatusUrl());
            ticketQrRendered = true;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // The placeholder glyph stays visible; the printed/shown URL still works.
            ticketQrRendered = false;
        }
    }

    /// <summary>
    /// "A007" read aloud as "A 0 0 7" rather than "A seven" — a ticket number is a sequence of
    /// characters, not a quantity, and screen readers otherwise run the digits together.
    /// </summary>
    private static string SpellOut(string? value) =>
        string.IsNullOrWhiteSpace(value) ? string.Empty : string.Join(" ", value.ToCharArray());

    private async Task CheckAndAutoPrint()
    {
        if (generatedTicket == null) return;

        try
        {
            // Get printer settings to check if auto-print is enabled
            var settingsResponse = await Http.GetAsync($"api/v1/branches/{branchId}/printer-settings");
            if (settingsResponse.IsSuccessStatusCode)
            {
                var settings = await settingsResponse.Content.ReadFromJsonAsync<PrinterSettingsResponse>(JsonOptions);
                if (settings?.AutoPrintOnTokenCreate == true)
                {
                    // Auto-print is enabled, trigger print
                    await PrintToken();
                }
            }
        }
        catch
        {
            // Auto-print check is not critical - user can still print manually
        }
    }

    private async Task PrintToken()
    {
        if (generatedTicket == null)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "No token to print.");
            return;
        }

        NotificationService.Notify(ToastSeverity.Info, "Printing...", "Preparing your ticket...");

        try
        {
            // Get print data from API
            var response = await Http.GetAsync($"api/v1/branches/{branchId}/tokens/{generatedTicket!.TokenId}/print-data");

            if (!response.IsSuccessStatusCode)
            {
                // GET .../tokens/{tokenId}/print-data is still [Authorize]d (tokens.view), so on
                // an unattended terminal with no staff session this is a 401, not a printer
                // fault. Say so plainly instead of "failed to get print data", and point at the
                // number that is already on screen.
                var unauthenticated = response.StatusCode is System.Net.HttpStatusCode.Unauthorized
                    or System.Net.HttpStatusCode.Forbidden;

                NotificationService.Notify(
                    unauthenticated ? ToastSeverity.Warning : ToastSeverity.Error,
                    unauthenticated ? "Printing unavailable" : "Print Error",
                    unauthenticated
                        ? "This terminal cannot print without a staff sign-in. Please note your ticket number from the screen."
                        : "Failed to get print data.");
                return;
            }

            var printData = await response.Content.ReadFromJsonAsync<PrintDataResponse>(JsonOptions);

            if (printData == null)
            {
                NotificationService.Notify(ToastSeverity.Error, "Print Error", "Invalid print data received.");
                return;
            }

            // Get method name from enum value
            var methodName = await JSRuntime.InvokeAsync<string>("QMgrPrint.getMethodName", (int)printData.PreferredMethod);

            // Initialize print service with preferred method
            await JSRuntime.InvokeVoidAsync("QMgrPrint.init", methodName);

            // Prepare print data object for JavaScript
            var jsPrintData = new
            {
                htmlContent = printData.HtmlContent,
                escPosData = printData.EscPosData,
                printerName = printData.PrinterName,
                printerIpAddress = printData.PrinterIpAddress,
                printerPort = printData.PrinterPort
            };

            // Execute print
            var result = await JSRuntime.InvokeAsync<PrintJsResult>("QMgrPrint.print", jsPrintData);

            if (result.Success)
            {
                ticketPrinted = true;
                ResetRedirectTimer(); // Give user more time after printing
                NotificationService.Notify(ToastSeverity.Success, "Print Sent", result.Message ?? "Please collect your ticket from the printer.");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Warning, "Print Notice", result.Message ?? "Print may not have completed. Please check the printer.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Print Error", $"Failed to print: {ex.Message}");
        }
    }

