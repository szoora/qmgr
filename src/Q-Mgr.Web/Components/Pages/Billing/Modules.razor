@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Payments
@inject IModuleApiService ModuleApi
@inject IPaymentApiService PaymentApi
@inject IModuleStateService ModuleState
@inject IToastService NotificationService
@inject NavigationManager Navigation
@inject IPermissionService PermissionService

@*
    Modules — a section of the Billing hub (/billing?tab=modules), and where every module gate,
    every "upgrade" refusal and every trial email sends people (BillingLinks.Modules). No @page.

    Rebuilt 2026-09-19 from a grid of cards of very different heights into one row per module. The tab
    is open to everyone signed in, because the module gates send everyone here; Add / Pay / Remove are
    shown only to a holder of billing.manage, since the API refuses anybody else.

    Paying (2026-09-19): through the sacc.ug gateway, by Mobile Money or — when the platform has switched
    it on — by card through the gateway's card page. Only the ways to pay that GET payment-providers says
    are usable are offered; nothing is offered "in case". Stripe is used only if the platform configured
    it, which it has not by default. The module is activated on the SERVER when the gateway confirms the
    money; this dialog only reports it, and closing it loses nothing.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Modules</h1>
        <p class="subtitle">What this account uses, and what it could add.</p>
    </Title>
    <Actions>
        <QButton Icon="arrow-repeat" Text="Refresh" Variant="secondary" OnClick="@LoadAsync" Disabled="@isLoading" />
    </Actions>
</QPageActions>

@if (TrialingModuleName != null && canManage)
{
    <p class="mod-gate"><QIcon Name="info-circle" /><span>Pay for <strong>@TrialingModuleName</strong> to unlock adding another module.</span></p>
}

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading modules...</span></div>
}
else
{
    <QCard NoPadding="true">
        <div class="table-wrap">
            <table class="data-table q-stack">
                <thead><tr><th>Module</th><th class="num">Price</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var module in catalog)
                    {
                        var status = mine.FirstOrDefault(m => m.ModuleCode == module.Code);
                        var purchased = status?.Purchased ?? false;
                        <tr>
                            <td class="mod-name">
                                <div class="mod-title"><strong>@module.Name</strong>@if (!string.IsNullOrWhiteSpace(module.Description)) { <QInfo Label="@module.Name" Text="@module.Description" /> }</div>
                                <span class="mod-desc">@module.Description</span>
                            </td>
                            <td class="num">
                                UGX @module.MonthlyPriceUgx.ToString("N0")<span class="mod-sub">/mo · UGX @module.AnnualPriceUgx.ToString("N0")/yr</span>
                                @if (purchased && status!.AgreedPriceUgx is { } agreed && agreed != ListPriceFor(module, status.BillingCycle))
                                {
                                    <span class="mod-sub mod-sub--block"><QIcon Name="lock-fill" /> You pay UGX @agreed.ToString("N0")@(status.BillingCycle == "Annual" ? "/yr" : "/mo")</span>
                                }
                            </td>
                            <td>
                                <QChip Text="@StatusLabel(purchased ? status!.Status : null)" Variant="@StatusVariant(purchased ? status!.Status : null)" Size="sm" />
                                @if (purchased && status!.Status == "Trialing" && status.TrialEndsAt.HasValue)
                                {
                                    <span class="mod-sub mod-sub--block">Trial ends @QDateFormat.D(status.TrialEndsAt.Value)</span>
                                }
                                @if (purchased && status!.GrantedByPlatformAdmin)
                                {
                                    <span class="mod-sub mod-sub--block">Granted by platform admin</span>
                                }
                            </td>
                            <td class="row-actions">
                                @if (!canManage)
                                {
                                    @* Nothing: a person without billing.manage cannot add or remove, and is not offered to. *@
                                }
                                else if (purchased)
                                {
                                    @if (status!.Status == "Trialing")
                                    {
                                        <QButton Text="Pay" Icon="credit-card" Variant="primary" Size="sm" OnClick="@(() => OpenPurchaseModal(module))" />
                                    }
                                    <QButton Text="Remove" Variant="ghost" Size="sm" OnClick="@(() => OpenRemoveConfirm(module.Code, module.Name))" />
                                }
                                else if (TrialingModuleName != null)
                                {
                                    <QButton Text="Add" Icon="plus-lg" Variant="secondary" Size="sm" Disabled="true" Title="@($"Pay for {TrialingModuleName} first")" />
                                }
                                else
                                {
                                    <QButton Text="Add" Icon="plus-lg" Variant="primary" Size="sm" OnClick="@(() => OpenPurchaseModal(module))" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </QCard>
}

<!-- Purchase Modal -->
<QModal Visible="@showPurchaseModal" VisibleChanged="@OnPurchaseModalVisibleChanged" Title="@PurchaseModalTitle" Icon="grid-3x3-gap-fill" Size="md">
    <ChildContent>
        @if (purchaseTarget != null)
        {
            <p class="mod-modal-desc">@purchaseTarget.Description</p>

            @if (providers == null)
            {
                <div class="loading-container"><QSpinner /><span>Checking the ways to pay...</span></div>
            }
            else if (!PaymentOptions.Any())
            {
                <p class="mod-gate"><QIcon Name="exclamation-circle" /><span>Payments are not available right now. Please try again later, or contact support.</span></p>
            }
            else
            {
                <p class="form-required-note"><span class="q-input__required">*</span> Required</p>
                <div class="form-row">
                    <QSelect TValue="string" TItem="string" Value="@purchaseBillingCycle" ValueChanged="@((string v) => purchaseBillingCycle = v)"
                             Items="@(new[] { "Monthly", "Annual" })" Label="Billing cycle" Required="true" Disabled="@Locked"
                             TextSelector="@(c => $"{c} — UGX {(c == "Annual" ? purchaseTarget.AnnualPriceUgx : purchaseTarget.MonthlyPriceUgx):N0}")"
                             HasError="@(attempted && string.IsNullOrEmpty(purchaseBillingCycle))" ErrorMessage="Choose a billing cycle." />
                    <QSelect TValue="string" TItem="(string Value, string Text)" Value="@paymentMethod" ValueChanged="@((string v) => { paymentMethod = v; fieldErrors.Clear(); })"
                             Items="@PaymentOptions" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Text)" Label="Pay by" Required="true" Disabled="@Locked"
                             HasError="@(attempted && string.IsNullOrEmpty(paymentMethod))" ErrorMessage="Choose how to pay." />
                </div>

                @if (paymentMethod == PaymentMethodCodes.MobileMoney)
                {
                    <MobileMoneyNumberField @bind-Value="purchasePhone" Disabled="@Locked" ShowErrors="@attempted" ServerError="@FieldError("phoneNumber")" />
                }
                else if (paymentMethod == PaymentMethodCodes.Card && CardViaGateway)
                {
                    <div class="form-row">
                        <QInput TValue="string" @bind-Value="payerName" Label="Name on the card" Required="true" MaxLength="100" Disabled="@Locked"
                                HasError="@(NameError != null)" ErrorMessage="@NameError" />
                        <QInput TValue="string" @bind-Value="payerEmail" Label="Email for the receipt" Type="email" Required="true" MaxLength="254" Disabled="@Locked"
                                HasError="@(EmailError != null)" ErrorMessage="@EmailError" />
                    </div>
                    <p class="mod-sub">You will finish the payment on the gateway's secure card page, then come back here.</p>
                }
                else if (paymentMethod == PaymentMethodCodes.Card)
                {
                    <p class="mod-sub">You will be taken to Stripe's secure page to enter the card, then brought back here.</p>
                }

                <div class="mod-total">
                    <span>Due now</span>
                    <strong>UGX @DueNow.ToString("N0")</strong>
                </div>

                @if (pendingReference is { } reference)
                {
                    <PaymentWait ReferenceId="@reference" Poll="@ModuleApi.GetPurchaseStatusAsync" Method="@paymentMethod"
                                 PhoneDisplay="@UgandaPhone.Display(purchasePhone)" OnSettled="@OnPurchaseSettled" />
                }
                else if (!string.IsNullOrEmpty(submitError))
                {
                    <p class="form-error"><QIcon Name="exclamation-circle" /> @submitError</p>
                }
            }
        }
    </ChildContent>
    <FooterContent>
        @if (pendingReference != null)
        {
            <QButton Text="Close" Variant="secondary" OnClick="@ClosePurchaseModal" />
            @if (purchaseFailed)
            {
                <QButton Text="Try again" Icon="arrow-repeat" Variant="primary" OnClick="@TryAgain" />
            }
        }
        else
        {
            <QButton Text="Cancel" Variant="secondary" OnClick="@ClosePurchaseModal" Disabled="@submitting" />
            @if (PaymentOptions.Any())
            {
                <QButton Text="@SubmitText" Icon="@(paymentMethod == PaymentMethodCodes.Card ? "credit-card" : "phone")" Variant="primary"
                         OnClick="SubmitPurchase" Loading="@submitting" Disabled="@submitting" />
            }
        }
    </FooterContent>
</QModal>

<!-- Returning from the gateway's card page -->
<QModal Visible="@(returnReference != null)" VisibleChanged="@((bool v) => { if (!v) returnReference = null; })" Title="Card payment" Icon="credit-card" Size="sm">
    <ChildContent>
        @if (returnReference is { } reference)
        {
            <PaymentWait ReferenceId="@reference" Poll="@ModuleApi.GetPurchaseStatusAsync" Method="@PaymentMethodCodes.Card" OnSettled="@OnPurchaseSettled" />
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="secondary" OnClick="@(() => returnReference = null)" />
    </FooterContent>
</QModal>

<!-- Remove Confirm Modal -->
<QModal Visible="@showRemoveModal" VisibleChanged="@((bool v) => showRemoveModal = v)" Title="@($"Remove {removeTargetName}?")" Icon="exclamation-triangle" Size="sm">
    <ChildContent>
        <p>Its features leave the navigation straight away. You can add it back any time from this tab.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="secondary" OnClick="@(() => showRemoveModal = false)" />
        <QButton Text="Remove" Icon="trash" Variant="danger" OnClick="ConfirmRemove" />
    </FooterContent>
</QModal>

<style>
    /* The rows are the shared .data-table; these are the module row's own parts. */
    .mod-title { display: flex; align-items: center; gap: 6px; }
    .mod-desc { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
                max-width: 60ch; font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .mod-sub { font-size: var(--qm-text-xs); color: var(--qm-text-muted); font-weight: 400; }
    .mod-sub--block { display: block; margin-top: 2px; }
    .mod-gate { display: flex; align-items: center; gap: 6px; margin: 0 0 var(--qm-block-gap, 10px);
                font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .mod-modal-desc { color: var(--qm-text-muted); margin-top: 0; }
    .mod-total { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--qm-field-gap, 12px);
                 padding-top: var(--qm-field-gap, 12px); border-top: 1px solid var(--qm-border); font-size: var(--qm-text-sm); }
    .mod-total strong { font-size: var(--qm-text-md, 15px); font-variant-numeric: tabular-nums; }
</style>

@code {
    /// <summary>True when the Billing hub hosts this section (always, since 2026-09-19).</summary>
    [Parameter] public bool Embedded { get; set; }

    private bool isLoading = true;

    /// <summary>billing.manage — the API's own gate on purchase and removal.</summary>
    private bool canManage;

    /// <summary>Which ways to pay are usable right now (GET billing/payment-providers) — null while
    /// it is being read. Nothing is offered that this does not list.</summary>
    private PaymentProvidersDto? providers;

    private IReadOnlyList<(string Value, string Text)> PaymentOptions
    {
        get
        {
            var options = new List<(string, string)>();
            if (providers?.MobileMoneyEnabled == true) options.Add((PaymentMethodCodes.MobileMoney, "Mobile Money (MTN, Airtel)"));
            if (providers?.CardEnabled == true) options.Add((PaymentMethodCodes.Card, "Card (Visa, Mastercard)"));
            return options;
        }
    }

    private bool CardViaGateway => providers?.CardProvider == "sacc";

    private static string StatusVariant(string? status) => status switch
    {
        "Active" => "success",
        "Trialing" => "warning",
        "PastDue" => "danger",
        _ => "muted"
    };

    private List<ModuleCatalogItem> catalog = new();
    private List<OrganizationModuleStatusDto> mine = new();

    // Server-side enforcement lives in ModulesController's TRIAL_IN_PROGRESS check — this is just
    // the matching client-side UX layer, derived from the already-loaded status list.
    private string? TrialingModuleName => mine.FirstOrDefault(m => m.Status == "Trialing")?.ModuleName;

    private static string StatusLabel(string? status) => status switch
    {
        "Active" => "Active",
        "Trialing" => "On trial",
        "PastDue" => "Payment overdue",
        "Cancelled" => "Removed",
        _ => "Not added"
    };

    /// <summary>The catalog's price for the cycle a holder is actually on, so an agreed price is only
    /// called out when it genuinely differs from what a new customer would pay today.</summary>
    private static decimal ListPriceFor(ModuleCatalogItem module, string? billingCycle) =>
        billingCycle == "Annual" ? module.AnnualPriceUgx : module.MonthlyPriceUgx;

    private string PurchaseModalTitle =>
        purchaseTarget != null && mine.FirstOrDefault(m => m.ModuleCode == purchaseTarget.Code)?.Status == "Trialing"
            ? $"Pay for {purchaseTarget.Name}"
            : $"Add {purchaseTarget?.Name}";

    // ------------------------------------------------------------------ purchase dialog state

    private bool showPurchaseModal;
    private ModuleCatalogItem? purchaseTarget;
    private string purchaseBillingCycle = "Monthly";
    private string paymentMethod = "";
    private string? purchasePhone;
    private string? payerName;
    private string? payerEmail;
    private string? renewalNumber;

    /// <summary>Submit has been tried: every required field now shows its error, not just touched ones.</summary>
    private bool attempted;
    private bool submitting;
    private string? submitError;
    private readonly Dictionary<string, string> fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The payment the gateway now holds; the dialog is locked and reports it.</summary>
    private Guid? pendingReference;

    /// <summary>The held payment ended without the money: the verdict stays on screen with a way to retry.</summary>
    private bool purchaseFailed;

    /// <summary>A card payment being returned from (?ref= on the checkout return link).</summary>
    private Guid? returnReference;

    private bool Locked => submitting || pendingReference != null;

    private decimal DueNow => purchaseTarget == null ? 0
        : purchaseBillingCycle == "Annual" ? purchaseTarget.AnnualPriceUgx : purchaseTarget.MonthlyPriceUgx;

    private string SubmitText => paymentMethod == PaymentMethodCodes.Card
        ? "Continue to card payment"
        : $"Send prompt · UGX {DueNow:N0}";

    private string? FieldError(string field) => fieldErrors.TryGetValue(field, out var message) ? message : null;

    private string? NameError =>
        FieldError("payerName") ?? (attempted && string.IsNullOrWhiteSpace(payerName) ? "Enter the name on the card."
            : attempted && payerName!.Trim().Length < 3 ? "Enter the full name on the card." : null);

    private string? EmailError =>
        FieldError("payerEmail") ?? (attempted && string.IsNullOrWhiteSpace(payerEmail) ? "Enter an email address for the receipt."
            : attempted && !LooksLikeEmail(payerEmail) ? "Enter a valid email address, e.g. bursar@school.ug." : null);

    private static bool LooksLikeEmail(string? value) =>
        !string.IsNullOrWhiteSpace(value) && System.Net.Mail.MailAddress.TryCreate(value.Trim(), out var address) && address.Address == value.Trim();

    private bool showRemoveModal;
    private string removeTargetCode = "";
    private string removeTargetName = "";

    protected override async Task OnInitializedAsync()
    {
        canManage = await PermissionService.HasPermissionAsync(Permissions.BillingManage);
        await LoadAsync();

        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        var checkoutResult = query["checkout"];
        if (checkoutResult == "success" && Guid.TryParse(query["ref"], out var reference))
        {
            // Back from the gateway's card page. The redirect is not the verdict — the page can return
            // before the money is confirmed — so this follows the payment until it is.
            returnReference = reference;
            Navigation.NavigateTo(BillingLinks.Modules, replace: true);
        }
        else if (checkoutResult == "success")
        {
            // Stripe, when configured: its webhook activates the module; this only says so.
            NotificationService.Notify(ToastSeverity.Success, "Payment complete", "Your module is now active.");
            Navigation.NavigateTo(BillingLinks.Modules, replace: true);
        }
        else if (checkoutResult == "cancelled")
        {
            NotificationService.Notify(ToastSeverity.Info, "Checkout cancelled", "No charge was made.");
            Navigation.NavigateTo(BillingLinks.Modules, replace: true);
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        catalog = await ModuleApi.GetCatalogAsync();
        try
        {
            mine = await ModuleApi.GetMineAsync();
        }
        catch
        {
            mine = new();
            NotificationService.Notify(ToastSeverity.Error, "Could not load your modules", "What you own could not be read just now. Refresh to try again.");
        }
        isLoading = false;
    }

    private async Task OpenPurchaseModal(ModuleCatalogItem module)
    {
        purchaseTarget = module;
        purchaseBillingCycle = "Monthly";
        paymentMethod = "";
        payerName = null;
        payerEmail = null;
        attempted = false;
        submitting = false;
        submitError = null;
        fieldErrors.Clear();
        pendingReference = null;
        purchaseFailed = false;
        showPurchaseModal = true;
        StateHasChanged();

        // Read every time the dialog opens: the platform can switch a way to pay on or off at any moment.
        try
        {
            providers = await PaymentApi.GetProvidersAsync();
        }
        catch
        {
            providers = new PaymentProvidersDto(false, false, null, false);
            submitError = "The ways to pay could not be read just now. Close this and try again.";
        }

        if (PaymentOptions.Count > 0) paymentMethod = PaymentOptions[0].Value;

        if (renewalNumber == null)
        {
            try { renewalNumber = (await PaymentApi.GetRenewalNumberAsync()).PhoneNumber ?? ""; }
            catch { renewalNumber = ""; }
        }
        purchasePhone = string.IsNullOrEmpty(renewalNumber) ? null : UgandaPhone.Display(renewalNumber);
    }

    private bool Validate()
    {
        attempted = true;
        fieldErrors.Clear();
        if (string.IsNullOrEmpty(purchaseBillingCycle) || string.IsNullOrEmpty(paymentMethod)) return false;
        if (paymentMethod == PaymentMethodCodes.MobileMoney) return MobileMoneyNumberField.IsValid(purchasePhone);
        if (paymentMethod == PaymentMethodCodes.Card && CardViaGateway) return NameError == null && EmailError == null;
        return true;
    }

    private async Task SubmitPurchase()
    {
        if (purchaseTarget == null || submitting) return;
        submitError = null;
        if (!Validate())
        {
            submitError = "Complete the fields marked in red.";
            return;
        }

        submitting = true;
        StateHasChanged();
        try
        {
            // Stripe only when the platform configured it (and no gateway card channel exists).
            if (paymentMethod == PaymentMethodCodes.Card && !CardViaGateway)
            {
                var card = await ModuleApi.PurchaseWithCardAsync(purchaseTarget.Code, purchaseBillingCycle);
                if (card.RequiresCheckout && !string.IsNullOrEmpty(card.CheckoutUrl))
                {
                    Navigation.NavigateTo(card.CheckoutUrl, forceLoad: true);
                    return;
                }
                NotificationService.Notify(ToastSeverity.Success, "Module added", card.Message ?? $"{purchaseTarget.Name} is now active.");
                await FinishAsync();
                return;
            }

            var request = new ModulePurchaseRequest(
                purchaseBillingCycle,
                paymentMethod,
                paymentMethod == PaymentMethodCodes.MobileMoney ? purchasePhone?.Trim() : null,
                paymentMethod == PaymentMethodCodes.Card ? payerEmail?.Trim() : null,
                paymentMethod == PaymentMethodCodes.Card ? payerName?.Trim() : null);

            var result = await ModuleApi.PurchaseAsync(purchaseTarget.Code, request);

            if (result.State == PaymentStates.Succeeded)
            {
                // Development's simulated gateway settles at once.
                NotificationService.Notify(ToastSeverity.Success, "Module added", result.Message);
                await FinishAsync();
                return;
            }

            if (!string.IsNullOrEmpty(result.RedirectUrl))
            {
                // The gateway's card page. The Modules tab follows the payment when the payer returns.
                Navigation.NavigateTo(result.RedirectUrl, forceLoad: true);
                return;
            }

            pendingReference = result.ReferenceId;
            if (pendingReference == null) submitError = result.Message;
        }
        catch (ApiFieldException ex)
        {
            foreach (var (field, message) in ex.Errors) fieldErrors[field] = message;
            submitError = ex.Message;
        }
        catch (Exception ex)
        {
            submitError = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task OnPurchaseSettled(PaymentStatusDto status)
    {
        if (status.State == PaymentStates.Succeeded)
        {
            NotificationService.Notify(ToastSeverity.Success, "Payment received", $"{status.Description} — your module is active.");
            returnReference = null;
            await FinishAsync();
        }
        else
        {
            // The panel keeps the verdict on screen, with Try again.
            purchaseFailed = true;
            await LoadAsync();
        }
    }

    private async Task FinishAsync()
    {
        showPurchaseModal = false;
        pendingReference = null;
        await LoadAsync();
        await ModuleState.RefreshAsync(ModuleApi);
    }

    private void OnPurchaseModalVisibleChanged(bool visible)
    {
        if (!visible) ClosePurchaseModal();
    }

    private void ClosePurchaseModal()
    {
        if (submitting) return;
        if (pendingReference != null && !purchaseFailed)
            NotificationService.Notify(ToastSeverity.Info, "Payment still open",
                "If you approve the prompt, the module is activated on its own — there is nothing more to do here.");
        showPurchaseModal = false;
        pendingReference = null;
        purchaseFailed = false;
    }

    private void TryAgain()
    {
        pendingReference = null;
        purchaseFailed = false;
        submitError = null;
    }

    private void OpenRemoveConfirm(string code, string name)
    {
        removeTargetCode = code;
        removeTargetName = name;
        showRemoveModal = true;
    }

    private async Task ConfirmRemove()
    {
        try
        {
            await ModuleApi.RemoveModuleAsync(removeTargetCode, null);
            NotificationService.Notify(ToastSeverity.Success, "Module removed", $"{removeTargetName} has been removed.");
            showRemoveModal = false;
            await LoadAsync();
            await ModuleState.RefreshAsync(ModuleApi);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not remove module", ex.Message);
        }
    }
}
