        font-size: 12px;
    }

    .security-badge i {
        color: var(--qm-success);
    }

    .empty-state {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 64px 24px;
        margin-bottom: 24px;
        text-align: center;
    }

    .empty-state i {
        color: var(--qm-text-muted);
        margin-bottom: 16px;
    }

    .empty-state h3 {
        margin: 16px 0 8px 0;
        color: var(--qm-text-primary);
    }

    .empty-state p {
        color: var(--qm-text-secondary);
        margin-bottom: 0;
    }

    .error-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        text-align: center;
    }

    .error-card i {
        color: var(--qm-danger);
        margin-bottom: 16px;
    }

    .error-card h3 {
        margin: 16px 0 8px 0;
        color: var(--qm-text-primary);
    }

    .error-card p {
        color: var(--qm-text-secondary);
        margin-bottom: 24px;
    }

    .method-preview {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
    }

    .method-preview i {
        color: var(--qm-primary);
    }

    .method-preview div {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .alert {
        padding: 12px 16px;
        border-radius: var(--qm-radius-lg);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-warning {
        background: color-mix(in srgb, var(--qm-warning) 15%, transparent);
        border: 1px solid var(--qm-warning);
        color: var(--qm-warning);
    }

    .alert-warning i {
        color: var(--qm-warning);
    }

    @@media (max-width: 768px) {
        .payment-methods-grid {
            grid-template-columns: 1fr;
        }

        .security-info {
            flex-direction: column;
        }

        .add-payment-card {
            padding: 32px 20px;
        }
    }
</style>

@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool hasError = false;
    private string errorMessage = "";
    private bool showDeleteConfirmation = false;
    private bool showStripeCheckout = false;
    private bool canManageBilling = false;
    private bool stripeEnabled = true;

    private List<PaymentMethodDto> paymentMethods = new();
    private PaymentMethodDto? methodToDelete;

    protected override async Task OnInitializedAsync()
    {
        var hasPermission = await PermissionService.HasPermissionAsync("billing.view");
        if (!hasPermission)
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }

        canManageBilling = await PermissionService.HasPermissionAsync(Permissions.BillingManage);

        await LoadPaymentProviders();
        await LoadPaymentMethods();
    }

    private async Task LoadPaymentProviders()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PaymentProvidersResponse>("api/v1/billing/payment-providers", JsonOptions);
            stripeEnabled = result?.StripeEnabled ?? true;
        }
        catch
        {
            // Fail open — if this check itself fails, fall back to showing the button rather
            // than silently hiding a working feature; OpenStripeCheckout still handles a real
            // failure from Stripe itself if it comes to that.
            stripeEnabled = true;
        }
    }

    private async Task LoadPaymentMethods()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";

        try
        {
            var response = await Http.GetAsync("api/v1/billing/payment-methods");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PaymentMethodsResponse>(JsonOptions);
                paymentMethods = result?.PaymentMethods ?? new();
            }
            else
            {
                hasError = true;
                errorMessage = $"Failed to load payment methods: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Console.WriteLine($"Error loading payment methods: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenStripeCheckout()
    {
        showStripeCheckout = true;
    }

    private void CloseStripeCheckout()
    {
        showStripeCheckout = false;
    }

    private async Task ProceedToStripe()
    {
        isProcessing = true;

        try
        {
            // Create a Stripe checkout session for adding payment method
            var response = await Http.PostAsJsonAsync("api/v1/billing/portal-session", new
            {
                ReturnUrl = $"{Navigation.BaseUri}billing/payment-methods"
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PortalSessionResponse>(JsonOptions);
                if (!string.IsNullOrEmpty(result?.Url))
                {
                    // Redirect to Stripe billing portal
                    await JSRuntime.InvokeVoidAsync("open", result.Url, "_self");
                }
            }
            else
            {
                Console.WriteLine("Failed to create Stripe portal session");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating Stripe session: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            showStripeCheckout = false;
        }
    }

    private async Task SetAsDefault(PaymentMethodDto method)
    {
        isProcessing = true;

        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/billing/payment-methods/{method.Id}/set-default", new { });
            if (response.IsSuccessStatusCode)
            {
                await LoadPaymentMethods();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting default payment method: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowDeleteConfirmation(PaymentMethodDto method)
    {
        methodToDelete = method;
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        methodToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (methodToDelete == null) return;

        isProcessing = true;

        try
        {
            var response = await Http.DeleteAsync($"api/v1/billing/payment-methods/{methodToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                showDeleteConfirmation = false;
                methodToDelete = null;
                await LoadPaymentMethods();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting payment method: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetCardIcon(string brand) => brand?.ToLower() switch
    {
        "visa" => "credit-card",
        "mastercard" => "credit-card-2-front",
        "amex" or "american express" => "credit-card",
        "discover" => "credit-card",
        "diners" or "diners club" => "credit-card",
        "jcb" => "credit-card",
        "unionpay" => "credit-card",
        _ => "wallet2"
    };

    // DTOs
    private record PaymentMethodsResponse
    {
        public List<PaymentMethodDto> PaymentMethods { get; init; } = new();
    }

    private record PaymentProvidersResponse
    {
        public bool StripeEnabled { get; init; }
        public bool MobileMoneyEnabled { get; init; }
    }

    private record PaymentMethodDto
    {
        public string Id { get; init; } = "";
        public string Brand { get; init; } = "";
        public string Last4 { get; init; } = "";
        public int ExpMonth { get; init; }
        public int ExpYear { get; init; }
        public string? CardholderName { get; init; }
        public string? Country { get; init; }
        public bool IsDefault { get; init; }
        public DateTime CreatedAt { get; init; }
    }

    private record PortalSessionResponse
    {
        public string Url { get; init; } = "";
    }
}
