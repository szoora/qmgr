@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Payments
@using System.Text.Json
@inject HttpClient Http
@inject IPaymentApiService PaymentApi
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject JsonSerializerOptions JsonOptions
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

@*
    Payment — a section of the Billing hub (/billing?tab=payment). No @page of its own.

    Reworked 2026-09-19 for the sacc.ug gateway. The tab says which ways this account can pay — read
    from GET billing/payment-providers, the ONE availability rule, so a way to pay the platform has not
    switched on is shown as off and never offered — and holds the renewal number: the Mobile Money
    number renewals are charged to. That number lived on the organization from sign-up and no screen
    showed or changed it. Stripe's cards-on-file table appears only when the platform has configured
    Stripe, which it has not by default.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Payment</h1>
        <p class="subtitle">How this account pays for its modules.</p>
    </Title>
    <Actions>
        <QButton Icon="arrow-repeat" Text="Refresh" Variant="secondary" OnClick="@LoadAsync" Disabled="@isLoading" />
        @if (StripeOn && canManageBilling)
        {
            <QButton Text="Add card" Icon="plus-lg" Variant="primary" OnClick="@(() => showStripeCheckout = true)" Disabled="@isProcessing" />
        }
    </Actions>
</QPageActions>

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading payment settings...</span></div>
}
else if (hasError)
{
    <QEmptyState Icon="exclamation-triangle-fill" Title="Payment settings not loaded" Text="@errorMessage">
        <Action><QButton Text="Try again" Icon="arrow-repeat" Variant="primary" OnClick="@LoadAsync" /></Action>
    </QEmptyState>
}
else
{
    <QCard Title="Ways to pay" Icon="wallet2" NoPadding="true">
        <HeaderActions>
            <QInfo Label="Payment security" Align="right"
                   Text="Mobile Money is approved on the phone that pays, with its own PIN; nothing is taken without it. Card details are entered on the payment gateway's own secure page, never on this platform, which never sees or stores a card number." />
        </HeaderActions>
        <ChildContent>
            <div class="table-wrap">
                <table class="data-table q-stack">
                    <thead><tr><th>Method</th><th>How it works</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr>
                            <td><QIcon Name="phone" /> <strong>Mobile Money</strong></td>
                            <td>MTN or Airtel. A prompt is sent to the phone for each payment; renewals go to the renewal number below.</td>
                            <td><QChip Text="@(providers.MobileMoneyEnabled ? "Available" : "Off")" Variant="@(providers.MobileMoneyEnabled ? "success" : "muted")" Size="sm" /></td>
                        </tr>
                        <tr>
                            <td><QIcon Name="credit-card" /> <strong>Card</strong></td>
                            <td>@(StripeOn ? "A card kept on file with Stripe and charged each period." : "Visa or Mastercard, paid on the gateway's secure card page when you add a module.")</td>
                            <td><QChip Text="@(providers.CardEnabled ? "Available" : "Off")" Variant="@(providers.CardEnabled ? "success" : "muted")" Size="sm" /></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </QCard>

    @* Always shown (2026-09-19): the number belongs to the account, not to whether Mobile Money happens to be
       switched on today, and an administrator looking for where to change it must be able to find it. *@
    <div id="renewal-number">
        <QCard Title="Renewal number" Icon="phone">
            <HeaderActions>
                <QInfo Label="Renewal number" Align="right"
                       Text="When a module renews, a Mobile Money prompt for the amount due is sent to this number. The invoice is marked paid only once the payment is approved. You can also pay any open invoice by hand from the Invoices tab." />
            </HeaderActions>
            <ChildContent>
                @if (!providers.MobileMoneyEnabled)
                {
                    <p class="pm-note"><QIcon Name="info-circle" /> Mobile Money is not switched on for this platform right now. The number is kept and used once it is.</p>
                }
                @if (canManageBilling)
                {
                    <p class="form-required-note"><span class="q-input__required">*</span> Required</p>
                    <div class="form-row">
                        <MobileMoneyNumberField @bind-Value="renewalInput" Label="Number renewals are charged to" Disabled="@savingRenewal"
                                                ShowErrors="@renewalAttempted" ServerError="@renewalServerError"
                                                Hint="@(renewal?.Display is { } shown ? $"Currently {shown}" : "No number set yet — renewals cannot be collected.")" />
                    </div>
                    <div class="form-actions">
                        <QButton Text="@(renewal?.PhoneNumber == null ? "Save number" : "Change number")" Icon="check-lg" Variant="primary" OnClick="@SaveRenewalAsync"
                                 Loading="@savingRenewal" Disabled="@(savingRenewal || !RenewalChanged)" />
                        @if (renewal?.PhoneNumber != null)
                        {
                            <QButton Text="Remove number" Icon="trash" Variant="ghost" OnClick="@(() => confirmRemoveRenewal = true)" Disabled="@savingRenewal" />
                        }
                    </div>
                }
                else
                {
                    <p class="pm-readonly">@(renewal?.Display is { } shown ? $"{shown} ({renewal.Operator})" : "No number set yet.")</p>
                }
            </ChildContent>
        </QCard>
    </div>

    @if (StripeOn)
    {
        @if (paymentMethods.Any())
        {
            <QCard Title="Cards on file" Icon="credit-card-fill" NoPadding="true">
                <div class="table-wrap">
                    <table class="data-table q-stack">
                        <thead><tr><th>Card</th><th>Expires</th><th>Added</th><th></th><th></th></tr></thead>
                        <tbody>
                            @foreach (var method in paymentMethods)
                            {
                                <tr>
                                    <td><QIcon Name="credit-card" /> <strong>@method.CardBrand</strong> •••• @method.CardLast4</td>
                                    <td class="num">@(method.CardExpMonth?.ToString("D2") ?? "--")/@(method.CardExpYear?.ToString() ?? "----")</td>
                                    <td>@(method.CreatedAt.HasValue ? QDateFormat.D(method.CreatedAt.Value) : "—")</td>
                                    <td>@if (method.IsDefault) { <QChip Text="Default" Variant="primary" Size="sm" Icon="star-fill" /> }</td>
                                    <td class="row-actions">
                                        @if (canManageBilling)
                                        {
                                            @if (!method.IsDefault)
                                            {
                                                <QButton Text="Make default" Variant="ghost" Size="sm" OnClick="@(() => SetAsDefault(method))" Disabled="@isProcessing" />
                                            }
                                            <QButton Icon="trash" Variant="ghost" Size="sm" Title="Remove card" OnClick="@(() => ShowDeleteConfirmation(method))" Disabled="@isProcessing" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </QCard>
        }
        else
        {
            <QEmptyState Icon="credit-card" Title="No cards on file"
                         Text="Add a card to be charged automatically, or pay by Mobile Money when you add a module." />
        }
    }
}

<!-- Remove renewal number -->
<QModal @bind-Visible="confirmRemoveRenewal" Title="Remove the renewal number?" Icon="exclamation-triangle-fill" Size="sm">
    <ChildContent>
        <p>Renewals will no longer be charged automatically. Each renewal invoice will wait on the Invoices tab until somebody pays it.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="secondary" OnClick="@(() => confirmRemoveRenewal = false)" Disabled="@savingRenewal" />
        <QButton Text="Remove number" Icon="trash" Variant="danger" OnClick="@RemoveRenewalAsync" Loading="@savingRenewal" Disabled="@savingRenewal" />
    </FooterContent>
</QModal>

<!-- Delete Confirmation Modal -->
<QModal @bind-Visible="showDeleteConfirmation" Title="Remove this card?" Icon="exclamation-triangle-fill" Size="sm" OnClose="@CancelDelete">
    <ChildContent>
        @if (methodToDelete != null)
        {
            <p><strong>@methodToDelete.CardBrand</strong> •••• @methodToDelete.CardLast4 will be removed from this account.</p>
            @if (methodToDelete.IsDefault)
            {
                <p class="pm-warning"><QIcon Name="exclamation-triangle-fill" /> This is the default card. Set another as default first if any module is paid by card.</p>
            }
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="secondary" OnClick="@CancelDelete" Disabled="@isProcessing" />
        <QButton Text="Remove card" Icon="trash" Variant="danger" OnClick="@ConfirmDelete" Disabled="@isProcessing" Loading="@isProcessing" />
    </FooterContent>
</QModal>

<!-- Stripe Checkout Modal -->
<QModal @bind-Visible="showStripeCheckout" Title="Add a card" Icon="credit-card-fill" Size="sm">
    <ChildContent>
        <p>You will be taken to Stripe's secure page to enter the card, then brought back here.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="secondary" OnClick="@(() => showStripeCheckout = false)" Disabled="@isProcessing" />
        <QButton Text="Continue to Stripe" Icon="arrow-right" Variant="primary" OnClick="@ProceedToStripe" Disabled="@isProcessing" Loading="@isProcessing" />
    </FooterContent>
</QModal>

<style>
    .pm-warning { display: flex; gap: 6px; align-items: flex-start; color: var(--qm-warning); margin: 8px 0 0; }
    .pm-readonly { margin: 0; font-variant-numeric: tabular-nums; }
    .pm-note { display: flex; gap: 6px; align-items: flex-start; margin: 0 0 var(--qm-field-gap, 12px); color: var(--qm-text-muted); }
</style>

@code {
    /// <summary>True when the Billing hub hosts this section (always, since 2026-09-19).</summary>
    [Parameter] public bool Embedded { get; set; }

    private bool isLoading = true;
    private bool isProcessing;
    private bool hasError;
    private string errorMessage = "";
    private bool showDeleteConfirmation;
    private bool showStripeCheckout;
    private bool canManageBilling;

    private PaymentProvidersDto providers = new(false, false, null, false);
    private bool StripeOn => providers.StripeEnabled;

    private RenewalNumberDto? renewal;
    private string? renewalInput;
    private bool renewalAttempted;
    private bool savingRenewal;
    private string? renewalServerError;
    private bool confirmRemoveRenewal;

    private bool RenewalChanged =>
        !string.Equals(UgandaPhone.Normalize(renewalInput), renewal?.PhoneNumber ?? "", StringComparison.Ordinal);

    private List<PaymentMethodDto> paymentMethods = new();
    private PaymentMethodDto? methodToDelete;

    protected override async Task OnInitializedAsync()
    {
        // The hub gates this tab on billing.view; the section does not redirect on its own.
        canManageBilling = await PermissionService.HasPermissionAsync(Permissions.BillingManage);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";
        try
        {
            providers = await PaymentApi.GetProvidersAsync();
            renewal = await PaymentApi.GetRenewalNumberAsync();
            renewalInput = renewal.PhoneNumber is { } stored ? UgandaPhone.Display(stored) : null;
            renewalAttempted = false;
            renewalServerError = null;

            paymentMethods = new();
            if (StripeOn)
            {
                var response = await Http.GetAsync("api/v1/billing/payment-methods");
                if (response.IsSuccessStatusCode)
                    paymentMethods = (await response.Content.ReadFromJsonAsync<PaymentMethodsResponse>(JsonOptions))?.PaymentMethods ?? new();
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveRenewalAsync()
    {
        renewalAttempted = true;
        renewalServerError = null;
        if (!MobileMoneyNumberField.IsValid(renewalInput)) return;

        savingRenewal = true;
        try
        {
            renewal = await PaymentApi.UpdateRenewalNumberAsync(renewalInput!.Trim());
            renewalInput = renewal.Display;
            renewalAttempted = false;
            ToastService.Notify(ToastSeverity.Success, "Renewal number saved", $"Renewals will be charged to {renewal.Display}.");
        }
        catch (ApiFieldException ex)
        {
            renewalServerError = ex.For("phoneNumber") ?? ex.Message;
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Number not saved", ex.Message);
        }
        finally
        {
            savingRenewal = false;
        }
    }

    private async Task RemoveRenewalAsync()
    {
        savingRenewal = true;
        try
        {
            renewal = await PaymentApi.ClearRenewalNumberAsync();
            renewalInput = null;
            renewalAttempted = false;
            renewalServerError = null;
            confirmRemoveRenewal = false;
            ToastService.Notify(ToastSeverity.Success, "Renewal number removed", "Renewals will wait on the Invoices tab to be paid.");
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Number not removed", ex.Message);
        }
        finally
        {
            savingRenewal = false;
        }
    }

    private async Task ProceedToStripe()
    {
        isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/billing/portal-session", new
            {
                ReturnUrl = Navigation.BaseUri.TrimEnd('/') + BillingLinks.Payment
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PortalSessionResponse>(JsonOptions);
                if (!string.IsNullOrEmpty(result?.Url))
                    await JSRuntime.InvokeVoidAsync("open", result.Url, "_self");
            }
            else
            {
                ToastService.Notify(ToastSeverity.Warning, "Card not added",
                    await ApiErrorService.GetErrorMessageAsync(response, "Stripe could not be opened just now."));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Card not added", ex.Message);
        }
        finally
        {
            isProcessing = false;
            showStripeCheckout = false;
        }
    }

    private async Task SetAsDefault(PaymentMethodDto method)
    {
        isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/billing/payment-methods/{method.Id}/set-default", new { });
            if (response.IsSuccessStatusCode)
            {
                ToastService.Notify(ToastSeverity.Success, "Default updated", $"{method.CardBrand} •••• {method.CardLast4} is now your default payment method.");
                await LoadAsync();
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Could not set default", await ApiErrorService.GetErrorMessageAsync(response, "The payment method could not be updated."));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Could not set default", ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ShowDeleteConfirmation(PaymentMethodDto method)
    {
        methodToDelete = method;
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
        methodToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (methodToDelete == null) return;
        isProcessing = true;
        try
        {
            var response = await Http.DeleteAsync($"api/v1/billing/payment-methods/{methodToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                showDeleteConfirmation = false;
                methodToDelete = null;
                ToastService.Notify(ToastSeverity.Success, "Payment method removed", "The card has been detached from your account.");
                await LoadAsync();
            }
            else
            {
                ToastService.Notify(ToastSeverity.Error, "Could not remove", await ApiErrorService.GetErrorMessageAsync(response, "The payment method could not be removed."));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(ToastSeverity.Error, "Could not remove", ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private record PaymentMethodsResponse
    {
        public List<PaymentMethodDto> PaymentMethods { get; init; } = new();
    }

    private record PortalSessionResponse
    {
        public string Url { get; init; } = "";
    }
}
