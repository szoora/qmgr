@page "/billing/subscription"
@using System.Text.Json
@inject HttpClient Http
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject JsonSerializerOptions JsonOptions

<PageTitle>Subscription Management - Q-Mgr</PageTitle>

<div class="page-header">
    <div class="header-left">
        <h1>
            <QIcon Name="star-fill" Size="32" />
            Subscription Management
        </h1>
        <div class="breadcrumb">
            <a href="/billing/overview">Billing</a>
            <span>/</span>
            <span>Subscription</span>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="webster-spinner"></div>
        <span class="loading-text">Loading subscription details...</span>
    </div>
}
else
{
    @if (currentPlan != null)
    {
        <!-- Current Plan Card -->
        <div class="current-plan-card">
            <div class="plan-header">
                <div>
                    <span class="plan-badge @GetPlanClass(currentPlan.PlanCode)">@currentPlan.PlanName</span>
                    <h2>Your Current Plan</h2>
                </div>
                <div class="plan-price">
                    <span class="currency">@currentPlan.Currency</span>
                    <span class="amount">@currentPlan.MonthlyPrice.ToString("N2")</span>
                    <span class="period">/month</span>
                </div>
            </div>
            <div class="plan-features">
                @foreach (var feature in currentPlan.Features)
                {
                    <div class="feature-item">
                        <QIcon Name="check-circle-fill" />
                        <span>@feature</span>
                    </div>
                }
            </div>
            <div class="plan-actions">
                @if (currentPlan.PlanCode != "enterprise")
                {
                    <QButton Text="Upgrade Plan"
                             Icon="arrow-up-circle-fill"
                             Variant="primary"
                             OnClick="@(() => showUpgradeDialog = true)" />
                }
                @if (currentPlan.PlanCode != "free")
                {
                    <QButton Text="Cancel Subscription"
                             Icon="x-circle-fill"
                             Variant="outline-danger"
                             OnClick="@(() => showCancelDialog = true)" />
                }
            </div>
        </div>
    }
    else
    {
        <!-- No plan selected yet — the common state for a trialing org that hasn't subscribed -->
        <div class="current-plan-card trial-banner">
            <div class="plan-header">
                <div>
                    <span class="plan-badge @(IsTrialExpired ? "status-expired" : "status-trial")">
                        @(organizationStatus ?? "Trialing")
                    </span>
                    <h2>
                        @if (trialEndsAt.HasValue && !IsTrialExpired)
                        {
                            <text>@TrialDaysRemaining day@(TrialDaysRemaining == 1 ? "" : "s") left in your free trial</text>
                        }
                        else if (IsTrialExpired)
                        {
                            <text>Your free trial has ended</text>
                        }
                        else
                        {
                            <text>No active plan</text>
                        }
                    </h2>
                </div>
            </div>
            <p class="text-muted">
                @if (IsTrialExpired)
                {
                    <text>Choose a plan below to keep using Q-Mgr — your data is safe and waiting.</text>
                }
                else
                {
                    <text>Pick a plan any time before your trial ends on @trialEndsAt?.ToString("MMMM dd, yyyy") to keep uninterrupted access.</text>
                }
            </p>
        </div>
    }

    <!-- Available Plans -->
    <div class="plans-section">
        <h2>Available Plans</h2>
        <div class="plans-grid">
            @foreach (var plan in availablePlans)
            {
                <div class="plan-card @(plan.PlanCode == currentPlan?.PlanCode ? "current" : "") @(plan.IsPopular ? "popular" : "")">
                    @if (plan.IsPopular)
                    {
                        <div class="popular-badge">Most Popular</div>
                    }
                    <div class="plan-card-header">
                        <h3>@plan.PlanName</h3>
                        <div class="price">
                            <span class="currency">@plan.Currency</span>
                            <span class="amount">@plan.MonthlyPrice.ToString("N0")</span>
                            <span class="period">/mo</span>
                        </div>
                        <p class="plan-description">@plan.Description</p>
                    </div>
                    <div class="plan-card-features">
                        @foreach (var feature in plan.Features)
                        {
                            <div class="feature">
                                <QIcon Name="check" />
                                <span>@feature</span>
                            </div>
                        }
                    </div>
                    <div class="plan-card-footer">
                        @if (currentPlan != null && plan.PlanCode == currentPlan.PlanCode)
                        {
                            <QButton Text="Current Plan" Icon="check-circle-fill" Variant="secondary" Disabled="true" />
                        }
                        else if (currentPlan == null || IsUpgrade(plan.PlanCode))
                        {
                            <QButton Text="@(currentPlan == null ? "Choose Plan" : "Upgrade")" Icon="arrow-up-circle-fill" Variant="primary" OnClick="@(() => SelectPlan(plan))" />
                        }
                        else
                        {
                            <QButton Text="Downgrade" Icon="arrow-down-circle-fill" Variant="outline-primary" OnClick="@(() => SelectPlan(plan))" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Billing History -->
    <div class="billing-history">
        <h2>Billing History</h2>
        @if (billingHistory.Count == 0)
        {
            <p class="history-empty">
                No billing events yet. Invoices are on the <a href="/billing/invoices">Invoices</a> page.
            </p>
        }
        else
        {
            <div class="history-timeline">
                @foreach (var evt in billingHistory)
                {
                    <div class="timeline-item">
                        <div class="timeline-marker @evt.Type"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <span class="timeline-title">@evt.Title</span>
                                <span class="timeline-date">@evt.Date.ToString("MMM dd, yyyy")</span>
                            </div>
                            <p class="timeline-description">@evt.Description</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Upgrade Confirmation Dialog -->
<QModal Visible="@(showUpgradeDialog && selectedPlan != null)"
        VisibleChanged="@((bool v) => showUpgradeDialog = v)"
        Title="@(selectedPlan != null ? $"Upgrade to {selectedPlan.PlanName}?" : "Upgrade Plan")"
        Icon="arrow-up-circle-fill"
        Size="md">
    <ChildContent>
        @if (selectedPlan != null)
        {
            <p>You're about to upgrade from <strong>@currentPlan?.PlanName</strong> to <strong>@selectedPlan.PlanName</strong>.</p>
            <div class="upgrade-summary">
                <div class="summary-row">
                    <span>New Monthly Price:</span>
                    <strong>@selectedPlan.Currency @selectedPlan.MonthlyPrice.ToString("N2")/month</strong>
                </div>
                <div class="summary-row">
                    <span>Prorated Credit:</span>
                    <strong>-@currentPlan?.Currency @proratedCredit.ToString("N2")</strong>
                </div>
                <div class="summary-row total">
                    <span>Due Today:</span>
                    <strong>@selectedPlan.Currency @dueToday.ToString("N2")</strong>
                </div>
            </div>
            <p class="text-muted small mt-3">Your new plan will take effect immediately and you'll be charged the prorated amount for the remainder of this billing period.</p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@(() => showUpgradeDialog = false)" />
        <QButton Text="Confirm Upgrade" Icon="check-lg" Variant="primary" OnClick="@ConfirmUpgrade" Disabled="@isProcessing" />
    </FooterContent>
</QModal>

<!-- Cancel Subscription Dialog -->
<QModal @bind-Visible="showCancelDialog" Title="Cancel Subscription" Icon="exclamation-triangle-fill" Size="md">
    <ChildContent>
        <p>Are you sure you want to cancel your subscription?</p>
        <ul class="text-muted">
            <li>Your account will remain active until @currentPlan?.NextBillingDate?.ToString("MMMM dd, yyyy")</li>
            <li>After that, you'll be downgraded to the Free plan</li>
            <li>You can reactivate anytime before the end of your billing period</li>
        </ul>
        <div class="form-group mt-3">
            <label>Please tell us why you're cancelling (optional):</label>
            <textarea class="form-control" @bind="cancellationReason" rows="3" placeholder="Your feedback helps us improve..."></textarea>
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Keep Subscription" Icon="check-lg" Variant="secondary" OnClick="@(() => showCancelDialog = false)" />
        <QButton Text="Confirm Cancellation" Icon="x-circle-fill" Variant="danger" OnClick="@ConfirmCancellation" Disabled="@isProcessing" />
    </FooterContent>
</QModal>

