@code {
    private bool isLoading = true;
    private bool isProcessing = false;
    private bool showUpgradeDialog = false;
    private bool showCancelDialog = false;
    private string cancellationReason = "";
    private decimal proratedCredit = 0;
    private decimal dueToday = 0;

    private SubscriptionPlan? currentPlan;
    private SubscriptionPlan? selectedPlan;
    private List<SubscriptionPlan> availablePlans = new();
    private List<BillingEvent> billingHistory = new();
    private string? organizationStatus;
    private DateTime? trialEndsAt;

    private bool IsTrialExpired => trialEndsAt.HasValue && trialEndsAt.Value <= DateTime.UtcNow;
    private int TrialDaysRemaining => trialEndsAt.HasValue
        ? Math.Max(0, (int)Math.Ceiling((trialEndsAt.Value - DateTime.UtcNow).TotalDays))
        : 0;

    protected override async Task OnInitializedAsync()
    {
        var hasPermission = await PermissionService.HasPermissionAsync("billing.manage");
        if (!hasPermission)
        {
            Navigation.NavigateTo("/unauthorized");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            // Load current subscription. SubscriptionDto (api/v1/billing/subscription) only has
            // PlanCode/PlanName — no pricing/description/features — so also fetch that plan's
            // full PlanDto by code to get the rest.
            // The endpoint returns a *different* shape — { hasSubscription: false, status,
            // trialEndsAt } — when the org has no Subscription row yet, which is the normal
            // state for every trialing org that hasn't picked a plan. Probe for that first;
            // deserializing it straight into SubscriptionApiDto used to leave PlanCode null,
            // which then built a request to plans/{null} that 500'd and left this whole page
            // blank (the "no subscription" branch below never even ran).
            var response = await Http.GetAsync("api/v1/billing/subscription");
            if (response.IsSuccessStatusCode)
            {
                var raw = await response.Content.ReadAsStringAsync();
                var probe = JsonSerializer.Deserialize<SubscriptionProbeDto>(raw, JsonOptions);
                if (probe?.HasSubscription == false)
                {
                    organizationStatus = probe.Status;
                    trialEndsAt = probe.TrialEndsAt;
                }
                else
                {
                    var subscriptionDto = JsonSerializer.Deserialize<SubscriptionApiDto>(raw, JsonOptions);
                    if (subscriptionDto != null)
                    {
                        PlanApiDto? currentPlanDetails = null;
                        var planResponse = await Http.GetAsync($"api/v1/billing/plans/{subscriptionDto.PlanCode}");
                        if (planResponse.IsSuccessStatusCode)
                        {
                            currentPlanDetails = await planResponse.Content.ReadFromJsonAsync<PlanApiDto>(JsonOptions);
                        }

                        currentPlan = new SubscriptionPlan
                        {
                            PlanCode = subscriptionDto.PlanCode,
                            PlanName = subscriptionDto.PlanName,
                            Description = currentPlanDetails?.Description ?? "",
                            MonthlyPrice = currentPlanDetails?.MonthlyPriceUsd ?? 0,
                            Currency = "USD",
                            Features = ParseFeatureNames(currentPlanDetails?.Features),
                            NextBillingDate = subscriptionDto.CurrentPeriodEnd
                        };
                    }
                }
            }

            // Load available plans (PlanDto shape — Code/Name/MonthlyPriceUsd/Features-as-JSON,
            // not the PlanCode/PlanName/MonthlyPrice/Features-as-list shape this page displays).
            var plansResponse = await Http.GetAsync("api/v1/billing/plans");
            if (plansResponse.IsSuccessStatusCode)
            {
                var planDtos = await plansResponse.Content.ReadFromJsonAsync<List<PlanApiDto>>(JsonOptions) ?? new();
                availablePlans = planDtos.Select(p => new SubscriptionPlan
                {
                    PlanCode = p.Code,
                    PlanName = p.Name,
                    Description = p.Description ?? "",
                    MonthlyPrice = p.MonthlyPriceUsd,
                    Currency = "USD",
                    Features = ParseFeatureNames(p.Features),
                    IsPopular = !string.IsNullOrEmpty(p.Badge)
                }).ToList();
            }

            // Load billing history (Type/Title/Description/Date — same field names as
            // BillingController's BillingEventDto, so this deserializes directly).
            var historyResponse = await Http.GetAsync("api/v1/billing/history");
            if (historyResponse.IsSuccessStatusCode)
            {
                billingHistory = await historyResponse.Content.ReadFromJsonAsync<List<BillingEvent>>(JsonOptions) ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading subscription data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectPlan(SubscriptionPlan plan)
    {
        selectedPlan = plan;
        CalculateProration();
        showUpgradeDialog = true;
    }

    private void CalculateProration()
    {
        if (currentPlan == null || selectedPlan == null) return;

        // Simple calculation - in reality this would be more complex
        var daysRemaining = (currentPlan.NextBillingDate - DateTime.UtcNow)?.Days ?? 0;
        var daysInMonth = 30;
        proratedCredit = (currentPlan.MonthlyPrice / daysInMonth) * daysRemaining;
        dueToday = (selectedPlan.MonthlyPrice / daysInMonth) * daysRemaining - proratedCredit;
    }

    private async Task ConfirmUpgrade()
    {
        if (selectedPlan == null) return;

        isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/billing/subscription/upgrade", new
            {
                NewPlanCode = selectedPlan.PlanCode
            });

            if (response.IsSuccessStatusCode)
            {
                showUpgradeDialog = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error upgrading subscription: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ConfirmCancellation()
    {
        isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/billing/subscription/cancel", new
            {
                Reason = cancellationReason
            });

            if (response.IsSuccessStatusCode)
            {
                showCancelDialog = false;
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cancelling subscription: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private bool IsUpgrade(string planCode)
    {
        var planOrder = new[] { "free", "starter", "professional", "enterprise" };
        var currentIndex = Array.IndexOf(planOrder, currentPlan?.PlanCode?.ToLower() ?? "free");
        var newIndex = Array.IndexOf(planOrder, planCode.ToLower());
        return newIndex > currentIndex;
    }

    private string GetPlanClass(string planCode) => planCode.ToLower() switch
    {
        "free" => "plan-free",
        "starter" => "plan-starter",
        "professional" => "plan-professional",
        "enterprise" => "plan-enterprise",
        _ => ""
    };

    private record SubscriptionPlan
    {
        public string PlanCode { get; init; } = "";
        public string PlanName { get; init; } = "";
        public string Description { get; init; } = "";
        public decimal MonthlyPrice { get; init; }
        public string Currency { get; init; } = "USD";
        public List<string> Features { get; init; } = new();
        public bool IsPopular { get; init; }
        public DateTime? NextBillingDate { get; init; }
    }

    private record BillingEvent
    {
        public string Type { get; init; } = "";
        public string Title { get; init; } = "";
        public string Description { get; init; } = "";
        public DateTime Date { get; init; }
    }

    /// <summary>
    /// Mirrors BillingController's PlanDto exactly (Code/Name/MonthlyPriceUsd/Features-as-JSON) —
    /// used purely for deserializing api/v1/billing/plans[/{code}], then mapped into the
    /// display-shaped SubscriptionPlan above. Deserializing straight into SubscriptionPlan used
    /// to fail silently (wrong field names) or throw (Features: JSON object string into
    /// List&lt;string&gt;), leaving "Available Plans" empty and pricing stuck at $0.
    /// </summary>
    private record PlanApiDto
    {
        public string Name { get; init; } = "";
        public string Code { get; init; } = "";
        public string? Description { get; init; }
        public decimal MonthlyPriceUsd { get; init; }
        public string? Badge { get; init; }
        public string? Features { get; init; }
    }

    /// <summary>Mirrors BillingController's SubscriptionDto exactly.</summary>
    private record SubscriptionApiDto
    {
        public string PlanCode { get; init; } = "";
        public string PlanName { get; init; } = "";
        public DateTime CurrentPeriodEnd { get; init; }
    }

    /// <summary>
    /// Mirrors the { hasSubscription: false, status, trialEndsAt } shape GET
    /// api/v1/billing/subscription returns when the org has no Subscription row — HasSubscription
    /// is null (absent from the JSON) for the normal case, and explicitly false only for this one.
    /// </summary>
    private record SubscriptionProbeDto
    {
        public bool? HasSubscription { get; init; }
        public string? Status { get; init; }
        public DateTime? TrialEndsAt { get; init; }
    }

    /// <summary>
    /// PlanDto.Features is a JSON object string like {"api_access": true, "white_label": false}
    /// (feature-code -> enabled). Turns the enabled ones into readable display names.
    /// </summary>
    private static List<string> ParseFeatureNames(string? featuresJson)
    {
        if (string.IsNullOrWhiteSpace(featuresJson))
            return new();

        try
        {
            var flags = JsonSerializer.Deserialize<Dictionary<string, bool>>(featuresJson);
            if (flags == null)
                return new();

            return flags
                .Where(kv => kv.Value)
                .Select(kv => System.Globalization.CultureInfo.InvariantCulture.TextInfo
                    .ToTitleCase(kv.Key.Replace('_', ' ')))
                .ToList();
        }
        catch (JsonException)
        {
            return new();
        }
    }
}
