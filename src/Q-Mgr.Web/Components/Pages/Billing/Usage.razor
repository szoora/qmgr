@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions

@*
    Usage — a section of the Billing hub (/billing?tab=usage). No @page of its own.

    Rebuilt 2026-09-19. Each limit was a full-width bordered card about 120px tall, five of them a
    screen of nothing, with the bar drawn backwards (the UNUSED part in wine, the used part green, so
    5% looked nearly full). It is one QBarList now — a row per limit, the bar is the share used, and
    colour carries state. Three real bugs went with the old page:

      * STORAGE WAS SHOWN A THOUSAND-FOLD SMALL. The API sends megabytes (StorageUsedMb, and the
        limits endpoint's "storage" in MB); the page formatted them as BYTES, so 6 MB read "6 B" and a
        5,000 MB limit "4.88 KB". FormatMb below is the only formatter, and it takes megabytes.
      * A RAW KEY REACHED THE PAGE. The label map expected "apiCalls"; the API sends "api_calls", so
        the row was titled "api_calls". LimitLabel is keyed on what the API actually sends.
      * "API calls" is INTEGRATION traffic only since 2026-09-17 (people signed in to the product are
        never metered), and the label says so.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Usage</h1>
        <p class="subtitle">What this account has used this month against its limits.</p>
    </Title>
    <Actions>
        <QButton Icon="arrow-repeat" Text="Refresh" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
    </Actions>
</QPageActions>

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading usage...</span></div>
}
else if (hasError)
{
    <QEmptyState Icon="exclamation-triangle-fill" Title="Usage could not be loaded" Text="@errorMessage">
        <Action><QButton Text="Try again" Icon="arrow-repeat" Variant="primary" OnClick="@LoadData" /></Action>
    </QEmptyState>
}
else
{
    <QCard Title="Limits" Icon="speedometer2" Subtitle="@PeriodLabel">
        <QBarList Items="@LimitBars" Max="100" MinPercent="1" EmptyText="No limits apply to this account." />
    </QCard>

    <QStatRow>
        <QStatTile Icon="ticket-perforated-fill" Variant="primary" Value="@N(currentUsage?.TokensServed)" Label="Tokens served" Sub="This month" />
        <QStatTile Icon="chat-dots-fill" Variant="info" Value="@N(currentUsage?.SmsSent)" Label="SMS sent" Sub="This month" />
        <QStatTile Icon="envelope-fill" Variant="secondary" Value="@N(currentUsage?.EmailsSent)" Label="Emails sent" Sub="This month" />
        <QStatTile Icon="megaphone-fill" Variant="warning" Value="@N(currentUsage?.AdImpressions)" Label="Ad impressions" Sub="This month" />
    </QStatRow>

    <QCard Title="Last 12 months" Icon="graph-up">
        <HeaderActions>
            <QSelect TValue="string" TItem="(string Value, string Text)" @bind-Value="selectedMetric"
                     Items="@MetricOptions" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Text)" />
        </HeaderActions>
        <ChildContent>
            <QBarList Items="@HistoryBars" EmptyText="No earlier months recorded yet." />
        </ChildContent>
    </QCard>
}

@code {
    /// <summary>True when the Billing hub hosts this section (always, since 2026-09-19).</summary>
    [Parameter] public bool Embedded { get; set; }

    /// <summary>Keyed on what the API sends: GET billing/limits uses these keys. Anything unknown
    /// falls back to a readable version of the key, never the raw key itself.</summary>
    private static string LimitLabel(string key) => key switch
    {
        "tokens" => "Tokens issued",
        "api_calls" => "Integration API calls",
        "storage" => "Storage",
        "users" => "Active users",
        "branches" => "Branches",
        _ => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(key.Replace('_', ' '))
    };

    private static readonly string[] LimitOrder = { "tokens", "api_calls", "users", "branches", "storage" };

    private static readonly (string Value, string Text)[] MetricOptions =
    {
        ("tokens", "Tokens issued"), ("api_calls", "Integration API calls"), ("users", "Active users"),
        ("branches", "Branches"), ("storage", "Storage")
    };

    private bool isLoading = true;
    private bool hasError;
    private string errorMessage = "";
    private UsageDto? currentUsage;
    private List<UsageDto> usageHistory = new();
    private Dictionary<string, LimitInfo> limits = new();
    private string selectedMetric = "tokens";

    private string PeriodLabel => currentUsage == null
        ? "This month"
        : QDateFormat.MYLong(new DateTime(currentUsage.Year, currentUsage.Month, 1));

    /// <summary>One row per limit. The bar is the SHARE USED, coloured by state; the figure says how
    /// much of how much. A limit at or past 80% says how many are left, because that is what somebody
    /// about to be refused needs to know.</summary>
    private IReadOnlyList<QBarItem> LimitBars => limits
        .OrderBy(kv => Array.IndexOf(LimitOrder, kv.Key) is var i && i >= 0 ? i : 99)
        .Select(kv =>
        {
            var v = kv.Value;
            var unlimited = v.max <= 0;
            var pct = unlimited ? 0 : Math.Min(100, v.percentUsed);
            var figure = unlimited
                ? $"{Format(kv.Key, v.current)} · no limit"
                : $"{Format(kv.Key, v.current)} of {Format(kv.Key, v.max)} · {v.percentUsed.ToString("0.#", CultureInfo.InvariantCulture)}%";
            string? hint = unlimited ? null
                : !v.withinLimit ? "limit reached"
                : v.percentUsed >= 80 ? $"{Format(kv.Key, v.remaining)} left"
                : null;
            return new QBarItem(LimitLabel(kv.Key), (decimal)pct, figure, StateColor(v), Hint: hint);
        })
        .ToList();

    private static string StateColor(LimitInfo v) =>
        !v.withinLimit || v.percentUsed >= 100 ? "var(--qm-danger)"
        : v.percentUsed >= 80 ? "var(--qm-warning)"
        : "var(--qm-success)";

    private IReadOnlyList<QBarItem> HistoryBars => usageHistory
        .OrderBy(u => u.Year).ThenBy(u => u.Month)
        .Select(u =>
        {
            var value = MetricValue(u, selectedMetric);
            return new QBarItem(QDateFormat.MY(new DateTime(u.Year, u.Month, 1)), value, Format(selectedMetric, (long)value));
        })
        .ToList();

    private static decimal MetricValue(UsageDto u, string metric) => metric switch
    {
        "tokens" => u.TokensCreated,
        "api_calls" => u.ApiCalls,
        "users" => u.ActiveUsers,
        "branches" => u.ActiveBranches,
        "storage" => u.StorageUsedMb,
        _ => 0
    };

    /// <summary>The one formatter. Storage is MEGABYTES everywhere the API sends it.</summary>
    private static string Format(string key, long value) =>
        key == "storage" ? FormatMb(value) : value.ToString("N0", CultureInfo.InvariantCulture);

    private static string FormatMb(long mb) => mb >= 1024
        ? $"{(mb / 1024d).ToString("0.#", CultureInfo.InvariantCulture)} GB"
        : $"{mb.ToString("N0", CultureInfo.InvariantCulture)} MB";

    private static string N(int? v) => (v ?? 0).ToString("N0", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";

        try
        {
            var usageResponse = await Http.GetAsync("api/v1/billing/usage");
            if (usageResponse.IsSuccessStatusCode)
                currentUsage = await usageResponse.Content.ReadFromJsonAsync<UsageDto>(JsonOptions);

            var historyResponse = await Http.GetAsync("api/v1/billing/usage/history?months=12");
            if (historyResponse.IsSuccessStatusCode)
                usageHistory = await historyResponse.Content.ReadFromJsonAsync<List<UsageDto>>(JsonOptions) ?? new();

            var limitsResponse = await Http.GetAsync("api/v1/billing/limits");
            if (limitsResponse.IsSuccessStatusCode)
            {
                var limitsData = await limitsResponse.Content.ReadFromJsonAsync<LimitsResponse>(JsonOptions);
                limits = limitsData?.Limits ?? new();
            }
            else
            {
                hasError = true;
                errorMessage = await ApiErrorService.GetErrorMessageAsync(limitsResponse, "The limits could not be read.");
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private record UsageDto
    {
        public int Year { get; init; }
        public int Month { get; init; }
        public int TokensCreated { get; init; }
        public int TokensServed { get; init; }
        public int ApiCalls { get; init; }
        public int ActiveUsers { get; init; }
        public int ActiveBranches { get; init; }
        public long StorageUsedMb { get; init; }
        public int SmsSent { get; init; }
        public int EmailsSent { get; init; }
        public int AdImpressions { get; init; }
    }

    private record LimitsResponse
    {
        public Guid OrganizationId { get; init; }
        public Dictionary<string, LimitInfo> Limits { get; init; } = new();
    }

    private record LimitInfo
    {
        public long current { get; init; }
        public long max { get; init; }
        public long remaining { get; init; }
        public double percentUsed { get; init; }
        public bool withinLimit { get; init; }
    }
}
