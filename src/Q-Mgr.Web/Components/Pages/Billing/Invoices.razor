@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared.UI
@inject HttpClient Http
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject JsonSerializerOptions JsonOptions
@inject IJSRuntime JSRuntime
@inject IToastService NotificationService
@inject IPaymentApiService PaymentApi
@using QMgr.Domain.Payments

@*
    Invoices — a section of the Billing hub (/billing?tab=invoices). No @page of its own: see
    CLAUDE.md, "A hub owns the route; its sections own nothing". Rebuilt 2026-09-19 onto the shared
    parts every other list uses: the filter bar on one row, a data table that stacks on a phone, the
    shared empty state, and the Refresh button on the hub's title row through QPageActions.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Invoices</h1>
        <p class="subtitle">Every invoice this account has been sent.</p>
    </Title>
    <Actions>
        <QButton Icon="arrow-repeat" Text="Refresh" Variant="secondary" OnClick="@LoadInvoices" Disabled="@isLoading" />
    </Actions>
</QPageActions>

@if (isLoading && !invoices.Any())
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading invoices...</span></div>
}
else if (hasError)
{
    <QEmptyState Icon="exclamation-triangle-fill" Title="Invoices could not be loaded" Text="@errorMessage">
        <Action><QButton Text="Try again" Icon="arrow-repeat" Variant="primary" OnClick="@LoadInvoices" /></Action>
    </QEmptyState>
}
else
{
    @* All time by default: a billing history is read to find one invoice, not to survey a period. *@
    <QFilterBar>
        <QSelect TValue="string" TItem="string" @bind-Value="filterStatus" @bind-Value:after="ApplyFilters"
                 Items="@statusOptions" Placeholder="All statuses" AllowClear="true" />
        <QDateRangePicker Range="@filterRange" RangeChanged="@OnRangeChanged"
                          Presets="@DateRangePresets.WithAllTime" ShowCaption="false" />
        @if (!string.IsNullOrEmpty(filterStatus) || !filterRange.IsAllTime)
        {
            <QButton Text="Clear" Icon="x-lg" Variant="ghost" Size="sm" OnClick="@ClearFilters" />
        }
    </QFilterBar>

    @if (filteredInvoices.Any())
    {
        <QCard NoPadding="true">
            <div class="table-wrap">
                <table class="data-table q-stack">
                    <thead>
                        <tr><th>Invoice</th><th>Date</th><th>Due</th><th class="num">Amount</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in GetPaginatedInvoices())
                        {
                            var overdue = invoice.Status == "Open" && invoice.DueDate < DateTime.UtcNow;
                            <tr>
                                <td><strong>@invoice.InvoiceNumber</strong></td>
                                <td>@QDateFormat.D(invoice.InvoiceDate)</td>
                                <td class="@(overdue ? "inv-overdue" : "")">@QDateFormat.D(invoice.DueDate)</td>
                                <td class="num">@invoice.Currency @invoice.Total.ToString("N2")</td>
                                <td>
                                    <QChip Text="@invoice.Status" Variant="@GetStatusBadgeVariant(invoice.Status)" Size="sm" />
                                    @if (invoice.PaidAt.HasValue)
                                    {
                                        <span class="inv-paid">Paid @QDateFormat.C(invoice.PaidAt.Value)</span>
                                    }
                                </td>
                                <td class="row-actions">
                                    @if (CanPay(invoice))
                                    {
                                        <QButton Text="Pay" Icon="phone" Variant="primary" Size="sm" OnClick="@(() => OpenPay(invoice))" />
                                    }
                                    <QButton Icon="eye" Variant="ghost" Size="sm" Title="View invoice" OnClick="@(() => ViewInvoice(invoice))" />
                                    @if (!string.IsNullOrEmpty(invoice.PdfUrl))
                                    {
                                        <QButton Icon="download" Variant="ghost" Size="sm" Title="Download PDF" OnClick="@(() => DownloadInvoice(invoice))" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </QCard>

        @if (TotalPages > 1)
        {
            <QPager Count="@filteredInvoices.Count" PageSize="@pageSize"
                    PageIndex="@(currentPage - 1)" PageIndexChanged="@(i => currentPage = i + 1)" ItemLabel="invoices" />
        }
    }
    else if (invoices.Any())
    {
        <QEmptyState Icon="funnel" Title="Nothing matches" Text="No invoice matches these filters.">
            <Action><QButton Text="Clear filters" Icon="x-lg" Variant="secondary" OnClick="@ClearFilters" /></Action>
        </QEmptyState>
    }
    else
    {
        <QEmptyState Icon="receipt" Title="No invoices yet" Text="An invoice appears here each time a module is paid for." />
    }
}

<!-- Invoice Details Modal -->
<QModal @bind-Visible="showInvoiceDetails"
        Title="@(selectedInvoice != null ? $"Invoice {selectedInvoice.InvoiceNumber}" : "Invoice")"
        Icon="receipt"
        Size="lg">
    <ChildContent>
        @if (selectedInvoice != null)
        {
                    @if (isLoadingDetails)
                    {
                        <div class="loading-container"><QSpinner /><span>Loading the invoice...</span></div>
                    }
                    else if (invoiceDetails != null)
                    {
                        <div class="invoice-details">
                            <div class="invoice-document-header">
                                <div class="invoice-from">
                                    <div class="invoice-from-logo">
                                        <QIcon Name="collection-fill" />
                                        <span>Q-Mgr</span>
                                    </div>
                                    <p class="invoice-from-tagline">Front-Office Platform</p>
                                </div>

                                <div class="invoice-to">
                                    <h6 class="invoice-to-heading">Invoice Information</h6>
                                    <div class="invoice-to-number">
                                        Invoice No: <strong>@invoiceDetails.InvoiceNumber</strong>
                                        <QChip Text="@invoiceDetails.Status" Variant="@GetStatusBadgeVariant(invoiceDetails.Status)" Size="sm" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(invoiceDetails.BillingName))
                                    {
                                        <p class="invoice-to-billto"><small>Bill to:</small> @invoiceDetails.BillingName</p>
                                        <ul class="invoice-to-address">
                                            @if (!string.IsNullOrEmpty(invoiceDetails.OrganizationAddress))
                                            {
                                                <li>@invoiceDetails.OrganizationAddress</li>
                                            }
                                            @if (!string.IsNullOrEmpty(invoiceDetails.BillingEmail))
                                            {
                                                <li><strong>Email:</strong> @invoiceDetails.BillingEmail</li>
                                            }
                                            @if (!string.IsNullOrEmpty(invoiceDetails.OrganizationPhone))
                                            {
                                                <li><strong>Phone:</strong> @invoiceDetails.OrganizationPhone</li>
                                            }
                                        </ul>
                                    }

                                    <div class="invoice-to-dates">
                                        <span>Invoice Date: @QDateFormat.D(invoiceDetails.InvoiceDate)</span>
                                        <span>Due Date: @QDateFormat.D(invoiceDetails.DueDate)</span>
                                        @if (invoiceDetails.PaidAt.HasValue)
                                        {
                                            <span>Paid Date: @QDateFormat.D(invoiceDetails.PaidAt.Value)</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (parsedLineItems.Any())
                            {
                                <div class="invoice-line-items">
                                    <h6>Line Items</h6>
                                    <table class="line-items-table">
                                        <thead>
                                            <tr>
                                                <th class="text-start">Description</th>
                                                <th class="text-end">Qty</th>
                                                <th class="text-end">Unit Rate</th>
                                                <th class="text-end">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in parsedLineItems)
                                            {
                                                <tr>
                                                    <td class="text-start">@item.Description</td>
                                                    <td class="text-end">@item.Quantity</td>
                                                    <td class="text-end">@invoiceDetails.Currency @item.UnitPrice.ToString("N2")</td>
                                                    <td class="text-end">@invoiceDetails.Currency @item.Total.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(invoiceDetails.LineItems))
                            {
                                <div class="invoice-line-items">
                                    <h6>Line Items</h6>
                                    <div class="line-items-list">
                                        <pre class="line-items-content">@invoiceDetails.LineItems</pre>
                                    </div>
                                </div>
                            }

                            <div class="invoice-amounts">
                                <div class="amount-row">
                                    <span>Subtotal</span>
                                    <strong>@invoiceDetails.Currency @invoiceDetails.Subtotal.ToString("N2")</strong>
                                </div>
                                @if (invoiceDetails.TaxAmount > 0)
                                {
                                    <div class="amount-row">
                                        <span>Tax</span>
                                        <strong>@invoiceDetails.Currency @invoiceDetails.TaxAmount.ToString("N2")</strong>
                                    </div>
                                }
                                <div class="amount-row total">
                                    <span>Total</span>
                                    <strong>@invoiceDetails.Currency @invoiceDetails.Total.ToString("N2")</strong>
                                </div>
                                @if (invoiceDetails.AmountPaid > 0)
                                {
                                    <div class="amount-row paid">
                                        <span>Amount Paid</span>
                                        <strong>@invoiceDetails.Currency @invoiceDetails.AmountPaid.ToString("N2")</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    }
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="secondary" OnClick="@CloseInvoiceDetails" />
        @if (selectedInvoice != null && CanPay(selectedInvoice))
        {
            <QButton Text="Pay now" Icon="phone" Variant="primary" OnClick="@PayFromDetails" />
        }
        @if (selectedInvoice != null && !string.IsNullOrEmpty(selectedInvoice.PdfUrl))
        {
            <QButton Text="Download PDF" Icon="download" Variant="primary" OnClick="@(() => DownloadInvoice(selectedInvoice))" />
        }
    </FooterContent>
</QModal>

<!-- Pay an invoice by Mobile Money -->
<QModal Visible="@(payTarget != null)" VisibleChanged="@((bool v) => { if (!v) ClosePay(); })" Title="@($"Pay {payTarget?.InvoiceNumber}")" Icon="phone" Size="sm">
    <ChildContent>
        @if (payTarget != null)
        {
            <p class="form-required-note"><span class="q-input__required">*</span> Required</p>
            <MobileMoneyNumberField @bind-Value="payPhone" Disabled="@(paySubmitting || payReference != null)" ShowErrors="@payAttempted" ServerError="@payFieldError" />
            <div class="inv-due">
                <span>Amount due</span>
                <strong>@payTarget.Currency @AmountDue(payTarget).ToString("N0")</strong>
            </div>
            @if (payReference is { } reference)
            {
                <PaymentWait ReferenceId="@reference" Poll="@PaymentApi.GetPaymentAsync" PhoneDisplay="@UgandaPhone.Display(payPhone)" OnSettled="@OnPaySettled" />
            }
            else if (!string.IsNullOrEmpty(payError))
            {
                <p class="form-error"><QIcon Name="exclamation-circle" /> @payError</p>
            }
        }
    </ChildContent>
    <FooterContent>
        @if (payReference != null)
        {
            <QButton Text="Close" Variant="secondary" OnClick="@ClosePay" />
            @if (payFailed)
            {
                <QButton Text="Try again" Icon="arrow-repeat" Variant="primary" OnClick="@RetryPay" />
            }
        }
        else
        {
            <QButton Text="Cancel" Variant="secondary" OnClick="@ClosePay" Disabled="@paySubmitting" />
            <QButton Text="@PayButtonText" Icon="phone" Variant="primary" OnClick="@SubmitPay" Loading="@paySubmitting" Disabled="@paySubmitting" />
        }
    </FooterContent>
</QModal>

