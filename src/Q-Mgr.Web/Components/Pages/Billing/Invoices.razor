@code {
    private bool isLoading = true;
    private bool isLoadingDetails = false;
    private bool hasError = false;
    private string errorMessage = "";
    private bool showInvoiceDetails = false;

    private List<InvoiceDto> invoices = new();
    private List<InvoiceDto> filteredInvoices = new();
    private InvoiceDto? selectedInvoice;
    private InvoiceDto? invoiceDetails;
    private List<LineItem> parsedLineItems = new();

    // Filters
    private string? filterStatus;
    // Defaults to All time: a billing history is read to find one invoice, not to survey a period,
    // so hiding older invoices behind a default window would be actively unhelpful.
    private DateRange filterRange = DateRange.AllTime();
    // The ledger's own statuses (InvoiceStatus). This list offered "Pending", "Overdue" and "Failed",
    // none of which an invoice is ever given, so filtering by them always came back empty.
    private List<string> statusOptions = new() { "Open", "Paid", "Void", "Uncollectible" };

    // Pagination
    private int currentPage = 1;
    private int pageSize = 20;
    private int TotalPages => (int)Math.Ceiling(filteredInvoices.Count / (double)pageSize);

    /// <summary>True when the Billing hub hosts this section (always, since 2026-09-19).</summary>
    [Parameter] public bool Embedded { get; set; }

    // ------------------------------------------------------------------ paying an invoice (2026-09-19)

    private bool canManage;
    private bool mobileMoneyOn;
    private string? renewalNumber;

    private InvoiceDto? payTarget;
    private string? payPhone;
    private bool payAttempted;
    private bool paySubmitting;
    private string? payError;
    private string? payFieldError;
    private Guid? payReference;
    private bool payFailed;

    private static decimal AmountDue(InvoiceDto invoice) => Math.Max(0, invoice.Total - invoice.AmountPaid);

    private string PayButtonText => payTarget == null ? "Send prompt" : $"Send prompt · {payTarget.Currency} {AmountDue(payTarget):N0}";

    /// <summary>An open UGX invoice with something left to pay, for a holder of billing.manage, when
    /// Mobile Money is switched on — exactly what POST invoices/{id}/pay accepts.</summary>
    private bool CanPay(InvoiceDto invoice) =>
        canManage && mobileMoneyOn && invoice.Status == "Open" && invoice.Currency == "UGX" && AmountDue(invoice) > 0;

    private void PayFromDetails()
    {
        var target = selectedInvoice;
        CloseInvoiceDetails();
        OpenPay(target);
    }

    private void OpenPay(InvoiceDto? invoice)
    {
        if (invoice == null) return;
        payTarget = invoice;
        payPhone = string.IsNullOrEmpty(renewalNumber) ? null : UgandaPhone.Display(renewalNumber);
        payAttempted = false;
        paySubmitting = false;
        payError = null;
        payFieldError = null;
        payReference = null;
        payFailed = false;
    }

    private void RetryPay()
    {
        payReference = null;
        payFailed = false;
        payError = null;
    }

    private async Task SubmitPay()
    {
        if (payTarget == null || paySubmitting) return;
        payAttempted = true;
        payError = null;
        payFieldError = null;
        if (!MobileMoneyNumberField.IsValid(payPhone))
        {
            payError = "Complete the fields marked in red.";
            return;
        }

        paySubmitting = true;
        try
        {
            var result = await PaymentApi.PayInvoiceAsync(payTarget.Id, payPhone!.Trim());
            if (result.State == PaymentStates.Succeeded)
            {
                NotificationService.Notify(ToastSeverity.Success, "Invoice paid", result.Message);
                payTarget = null;
                await LoadInvoices();
                return;
            }
            payReference = result.ReferenceId;
            if (payReference == null) payError = result.Message;
        }
        catch (ApiFieldException ex)
        {
            payFieldError = ex.For("phoneNumber") ?? (ex.Code == "INVALID_PHONE" ? ex.Message : null);
            payError = ex.Message;
        }
        catch (Exception ex)
        {
            payError = ex.Message;
        }
        finally
        {
            paySubmitting = false;
        }
    }

    private async Task OnPaySettled(PaymentStatusDto status)
    {
        if (status.State == PaymentStates.Succeeded)
        {
            NotificationService.Notify(ToastSeverity.Success, "Invoice paid", $"{payTarget?.InvoiceNumber} is paid. A receipt is on its way by email.");
            payTarget = null;
            payReference = null;
        }
        else
        {
            payFailed = true;
        }
        await LoadInvoices();
    }

    private void ClosePay()
    {
        if (paySubmitting) return;
        if (payReference != null && !payFailed)
            NotificationService.Notify(ToastSeverity.Info, "Payment still open", "If you approve the prompt, the invoice is marked paid on its own.");
        payTarget = null;
        payReference = null;
        payFailed = false;
    }

    protected override async Task OnInitializedAsync()
    {
        // The hub gates this tab on billing.view; the section does not redirect on its own.
        canManage = await PermissionService.HasPermissionAsync(Permissions.BillingManage);
        if (canManage)
        {
            try
            {
                mobileMoneyOn = (await PaymentApi.GetProvidersAsync()).MobileMoneyEnabled;
                if (mobileMoneyOn) renewalNumber = (await PaymentApi.GetRenewalNumberAsync()).PhoneNumber;
            }
            catch
            {
                // Pay stays hidden: the invoices themselves still load and read correctly.
                mobileMoneyOn = false;
            }
        }
        await LoadInvoices();

        // BillingLinks.Invoice(id) opens one invoice: the overview's "view" link and any email that
        // names an invoice. Nothing read this key before 2026-09-19, so the link opened the list.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        if (Guid.TryParse(query["invoice"], out var invoiceId)
            && invoices.FirstOrDefault(i => i.Id == invoiceId) is { } target)
        {
            await ViewInvoice(target);
        }
    }

    private async Task LoadInvoices()
    {
        isLoading = true;
        hasError = false;
        errorMessage = "";

        try
        {
            var response = await Http.GetAsync($"api/v1/billing/invoices?page=1&pageSize=1000");
            if (response.IsSuccessStatusCode)
            {
                invoices = await response.Content.ReadFromJsonAsync<List<InvoiceDto>>(JsonOptions) ?? new();
                ApplyFilters();
            }
            else
            {
                hasError = true;
                errorMessage = $"Failed to load invoices: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
            Console.WriteLine($"Error loading invoices: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        currentPage = 1;
        filteredInvoices = invoices.Where(i =>
        {
            if (!string.IsNullOrEmpty(filterStatus) && i.Status != filterStatus)
                return false;

            // IsAllTime skips the comparison entirely rather than comparing against a sentinel
            // date — the range's own "complete record" state, not a magic year.
            if (!filterRange.IsAllTime)
            {
                var day = DateOnly.FromDateTime(i.InvoiceDate);
                if (day < filterRange.From || day > filterRange.To)
                    return false;
            }

            return true;
        }).OrderByDescending(i => i.InvoiceDate).ToList();
    }

    private void OnRangeChanged(DateRange range)
    {
        filterRange = range;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        filterStatus = null;
        filterRange = DateRange.AllTime();
        ApplyFilters();
    }

    private List<InvoiceDto> GetPaginatedInvoices()
    {
        return filteredInvoices
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void SelectInvoice(InvoiceDto invoice)
    {
        selectedInvoice = invoice;
    }

    private async Task ViewInvoice(InvoiceDto invoice)
    {
        selectedInvoice = invoice;
        showInvoiceDetails = true;
        isLoadingDetails = true;

        try
        {
            var response = await Http.GetAsync($"api/v1/billing/invoices/{invoice.Id}");
            if (response.IsSuccessStatusCode)
            {
                invoiceDetails = await response.Content.ReadFromJsonAsync<InvoiceDto>(JsonOptions);
                parsedLineItems = TryParseLineItems(invoiceDetails?.LineItems);
            }
            else
            {
                // The details modal opens either way, so a silent failure showed an empty invoice
                // — which for a billing document reads as "this invoice has no line items", not
                // "we could not fetch it".
                NotificationService.Notify(ToastSeverity.Error, "Could not load the invoice",
                    await ApiErrorService.GetErrorMessageAsync(response, "The invoice details could not be loaded."));
            }
        }
        catch (Exception ex)
        {
            // Console.WriteLine here was the exact pattern CLAUDE.md records as having hidden the
            // Subscription.razor DTO bug: the only trace was the server's own stdout.
            NotificationService.Notify(ToastSeverity.Error, "Could not load the invoice", ex.Message);
        }
        finally
        {
            isLoadingDetails = false;
        }
    }

    private List<LineItem> TryParseLineItems(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new();

        try
        {
            return JsonSerializer.Deserialize<List<LineItem>>(json, JsonOptions) ?? new();
        }
        catch (JsonException)
        {
            // Malformed/unexpected shape — the raw-text fallback in the markup handles this.
            return new();
        }
    }

    private void CloseInvoiceDetails()
    {
        showInvoiceDetails = false;
        invoiceDetails = null;
        parsedLineItems = new();
    }

    private async Task DownloadInvoice(InvoiceDto invoice)
    {
        if (string.IsNullOrEmpty(invoice.PdfUrl))
            return;

        try
        {
            // Open PDF in new tab
            await JSRuntime.InvokeVoidAsync("open", invoice.PdfUrl, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading invoice: {ex.Message}");
        }
    }

    private string GetStatusBadgeVariant(string status) => status.ToLower() switch
    {
        "paid" => "success",
        "open" => "warning",
        "uncollectible" => "danger",
        _ => "muted"
    };


    private record LineItem
    {
        public string Description { get; init; } = "";
        public int Quantity { get; init; }
        public decimal UnitPrice { get; init; }
        public decimal Total { get; init; }
    }
}
