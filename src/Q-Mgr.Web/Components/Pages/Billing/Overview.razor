@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using System.Globalization
@using System.Text.Json
@inject HttpClient Http
@inject IPermissionService PermissionService
@inject IModuleApiService ModuleApi
@inject IPaymentApiService PaymentApi
@using QMgr.Domain.Payments
@inject NavigationManager Navigation
@inject JsonSerializerOptions JsonOptions

@*
    Overview — the first tab of the Billing hub (/billing, /billing?tab=overview). No @page.

    Rebuilt 2026-09-19. The old page was a half-width "Current Plan" card beside empty space, then
    two big section cards repeating the Invoices and Payment Methods pages — and nothing at a
    glance. It is four figures and two short tables now. Two silent bugs went with it:

      * EVERY RECENT INVOICE READ 0. The page kept its own InvoiceDto with an Amount the API has never
        sent (it is Total). It reads the shared QMgr.Application.DTOs.InvoiceDto now.
      * PAYMENT METHODS WERE ALWAYS NONE. It read GET billing/payment-methods as a bare list; the API
        answers { paymentMethods: [...] }, the read threw, and a bare catch swallowed it. This tab no
        longer shows payment methods at all — the Payment tab owns them.

    What a module costs comes from the module's AGREED price when one was captured, else the list
    price — the grandfathering rule in CLAUDE.md ("never charge from a catalog row"). An annual price
    is shown as its monthly share so the total is one comparable figure.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Billing</h1>
        <p class="subtitle">What this account pays for.</p>
    </Title>
    <Actions>
        <QButton Icon="arrow-repeat" Text="Refresh" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
    </Actions>
</QPageActions>

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading billing...</span></div>
}
else
{
    <QStatRow>
        <QStatTile Icon="@PlanIcon" Variant="@PlanVariant" Value="@PlanValue" Label="Plan" Sub="@PlanSub" />
        <QStatTile Icon="cash-stack" Variant="primary" Value="@($"UGX {MonthlyTotal.ToString("N0", CultureInfo.InvariantCulture)}")" Label="Per month"
                   Sub="@(Held.Any() ? $"{Held.Count} module{(Held.Count == 1 ? "" : "s")}" : "Nothing held")" />
        <QStatTile Icon="grid-3x3-gap-fill" Variant="info" Value="@($"{Held.Count} of {catalog.Count}")" Label="Modules" Href="@BillingLinks.Modules"
                   Sub="@(catalog.Count > Held.Count ? $"{catalog.Count - Held.Count} more available" : "All modules held")" />
        <QStatTile Icon="calendar-event" Variant="@RenewalVariant" Value="@RenewalValue" Label="Next renewal" Sub="@RenewalLabel" />
        <QStatTile Icon="phone" Variant="@(renewalNumber?.PhoneNumber == null ? "warning" : "default")"
                   Value="@(renewalNumber?.Display ?? "Not set")" Label="Renewal number" Href="@RenewalNumberLink"
                   Sub="@(renewalNumber?.PhoneNumber == null ? "Set the number renewals are charged to" : $"{renewalNumber.Operator} · Change")" />
    </QStatRow>

    @if (unpaidCount > 0)
    {
        <p class="ov-alert"><QIcon Name="exclamation-triangle-fill" /><span>@unpaidCount invoice@(unpaidCount == 1 ? " is" : "s are") waiting to be paid. <a href="@BillingLinks.Invoices">See invoices</a></span></p>
    }

    <div class="ov-grid">
        <QCard Title="Your modules" Icon="grid-3x3-gap-fill" NoPadding="true">
            <HeaderActions>
                <QButton Text="Manage" Icon="arrow-right" Variant="ghost" Size="sm" OnClick="@(() => Navigation.NavigateTo(BillingLinks.Modules))" />
            </HeaderActions>
            <ChildContent>
                @if (Held.Any())
                {
                    <div class="table-wrap">
                        <table class="data-table q-stack">
                            <thead><tr><th>Module</th><th>Status</th><th class="num">Per month</th></tr></thead>
                            <tbody>
                                @foreach (var m in Held)
                                {
                                    <tr>
                                        <td><strong>@m.ModuleName</strong></td>
                                        <td>
                                            <QChip Text="@StatusLabel(m.Status)" Variant="@StatusVariant(m.Status)" Size="sm" />
                                            @if (m.Status == "Trialing" && m.TrialEndsAt.HasValue)
                                            {
                                                <span class="ov-sub">Trial ends @QDateFormat.D(m.TrialEndsAt.Value)</span>
                                            }
                                        </td>
                                        <td class="num">@(MonthlyPrice(m) is { } p ? $"UGX {p.ToString("N0", CultureInfo.InvariantCulture)}" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <QEmptyState Class="q-empty--compact" Icon="grid-3x3-gap" Title="No modules yet" Text="Add one from the Modules tab." />
                }
            </ChildContent>
        </QCard>

        <QCard Title="Recent invoices" Icon="receipt" NoPadding="true">
            <HeaderActions>
                <QButton Text="All invoices" Icon="arrow-right" Variant="ghost" Size="sm" OnClick="@(() => Navigation.NavigateTo(BillingLinks.Invoices))" />
            </HeaderActions>
            <ChildContent>
                @if (recentInvoices.Any())
                {
                    <div class="table-wrap">
                        <table class="data-table q-stack">
                            <thead><tr><th>Invoice</th><th>Date</th><th class="num">Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var inv in recentInvoices)
                                {
                                    <tr>
                                        <td><a href="@BillingLinks.Invoice(inv.Id)">@inv.InvoiceNumber</a></td>
                                        <td>@QDateFormat.D(inv.InvoiceDate)</td>
                                        <td class="num">@inv.Currency @inv.Total.ToString("N2", CultureInfo.InvariantCulture)</td>
                                        <td><QChip Text="@inv.Status" Variant="@InvoiceVariant(inv.Status)" Size="sm" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <QEmptyState Class="q-empty--compact" Icon="receipt" Title="No invoices yet" Text="One appears each time a module is paid for." />
                }
            </ChildContent>
        </QCard>
    </div>
}

<style>
    /* Two short tables side by side on a desktop, one above the other on a phone. The tables
       themselves are the shared .data-table; nothing here sizes type or controls. */
    .ov-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        gap: var(--qm-block-gap, 10px);
        align-items: start;
        margin-top: var(--qm-block-gap, 10px);
    }
    .ov-grid > .q-card { margin-top: 0; }
    .ov-sub { display: block; margin-top: 2px; font-size: var(--qm-text-xs); color: var(--qm-text-muted); }
    .ov-alert {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        margin: var(--qm-block-gap, 10px) 0 0; padding: 8px 12px;
        border: 1px solid var(--qm-warning); border-radius: var(--qm-radius-md);
        color: var(--qm-text-primary); font-size: var(--qm-text-sm);
    }
    .ov-alert .bi { color: var(--qm-warning); }
    @@media (max-width: 640px) {
        .ov-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    /// <summary>True when the Billing hub hosts this section (always, since 2026-09-19).</summary>
    [Parameter] public bool Embedded { get; set; }

    private bool isLoading = true;
    private List<ModuleCatalogItem> catalog = new();
    private List<OrganizationModuleStatusDto> mine = new();
    private List<InvoiceDto> recentInvoices = new();
    private int unpaidCount;

    private string? organizationStatus;
    private DateTime? trialEndsAt;
    private BillingOverview? billingInfo;

    /// <summary>The modules this account holds right now — active, on trial or overdue. A removed
    /// module is not "held" and costs nothing.</summary>
    private List<OrganizationModuleStatusDto> Held => mine
        .Where(m => m.Purchased && m.Status is "Active" or "Trialing" or "PastDue")
        .OrderBy(m => m.ModuleName)
        .ToList();

    /// <summary>What one module costs per month: its agreed price when one was captured (in the
    /// cycle it was agreed in), else the catalog's list price. An annual price is shown as its
    /// monthly share. Null when the module is not in the catalog.</summary>
    private decimal? MonthlyPrice(OrganizationModuleStatusDto m)
    {
        var item = catalog.FirstOrDefault(c => c.Code == m.ModuleCode);
        var annual = m.BillingCycle == "Annual";
        decimal? price = m.AgreedPriceUgx ?? (item == null ? null : annual ? item.AnnualPriceUgx : item.MonthlyPriceUgx);
        return price is { } p ? Math.Round(annual ? p / 12m : p) : null;
    }

    private decimal MonthlyTotal => Held.Sum(m => MonthlyPrice(m) ?? 0);

    // The account's state, said once. A trialing account with no subscription row is the normal
    // state for every new tenant (see OverviewProbeDto).
    private string CurrentStatus => billingInfo?.Status is { Length: > 0 } s ? s : organizationStatus ?? (Held.Any() ? "Active" : "");

    private int TrialDaysRemaining => trialEndsAt.HasValue
        ? Math.Max(0, (int)Math.Ceiling((trialEndsAt.Value - DateTime.UtcNow).TotalDays))
        : 0;

    private string PlanValue => CurrentStatus switch
    {
        "Trialing" => "Trial",
        "Active" => "Active",
        "PastDue" => "Payment overdue",
        "Suspended" => "Suspended",
        "Cancelled" => "Cancelled",
        _ => Held.Any() ? "Active" : "No modules"
    };

    private string PlanSub => CurrentStatus == "Trialing" && trialEndsAt.HasValue
        ? (TrialDaysRemaining == 0 ? "Trial ends today" : $"{TrialDaysRemaining} days left · ends {QDateFormat.D(trialEndsAt.Value)}")
        : Held.Any() ? string.Join(", ", Held.Select(h => h.ModuleName)) : "Add a module to begin";

    private string PlanVariant => CurrentStatus switch
    {
        "Active" => "success",
        "Trialing" => "warning",
        "PastDue" or "Suspended" or "Cancelled" => "danger",
        _ => "secondary"
    };

    private string PlanIcon => CurrentStatus == "Trialing" ? "hourglass-split" : "star-fill";

    private int DaysUntilRenewal => billingInfo?.NextBillingDate is { } d ? (d - DateTime.UtcNow).Days : 0;

    /// <summary>The renewal said definitively, never as a countdown that can go negative ("-15" was
    /// once on screen in production). A date that has passed is OVERDUE.</summary>
    private string RenewalValue => billingInfo?.NextBillingDate == null
        ? "—"
        : DaysUntilRenewal switch { < 0 => "Overdue", 0 => "Today", 1 => "Tomorrow", var d => $"{d} days" };

    private string RenewalLabel => billingInfo?.NextBillingDate is { } next
        ? $"Renews {QDateFormat.D(next)}"
        : CurrentStatus == "Trialing" ? "After the trial" : "No renewal date";

    private string RenewalVariant => billingInfo?.NextBillingDate == null ? "secondary"
        : DaysUntilRenewal switch { < 0 => "danger", <= 7 => "warning", _ => "secondary" };

    private static string StatusLabel(string? status) => status switch
    {
        "Active" => "Active",
        "Trialing" => "On trial",
        "PastDue" => "Payment overdue",
        "Cancelled" => "Removed",
        _ => "Not added"
    };

    private static string StatusVariant(string? status) => status switch
    {
        "Active" => "success",
        "Trialing" => "warning",
        "PastDue" => "danger",
        _ => "muted"
    };

    private static string InvoiceVariant(string status) => status.ToLowerInvariant() switch
    {
        "paid" => "success",
        "pending" => "warning",
        "overdue" or "failed" => "danger",
        _ => "muted"
    };

    /// <summary>The number renewals are charged to — shown here so it can be found, changed on the Payment tab.</summary>
    private RenewalNumberDto? renewalNumber;

    private static readonly string RenewalNumberLink = BillingLinks.Payment + "#renewal-number";

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            catalog = await ModuleApi.GetCatalogAsync();
            try { mine = await ModuleApi.GetMineAsync(); } catch { mine = new(); }

            try { renewalNumber = await PaymentApi.GetRenewalNumberAsync(); } catch { renewalNumber = null; }

            // Returns a differently-shaped { hasSubscription: false, status, trialEndsAt } body when
            // the account has no Subscription row — every trialing account that has not paid yet.
            var response = await Http.GetAsync("api/v1/billing/overview");
            if (response.IsSuccessStatusCode)
            {
                var raw = await response.Content.ReadAsStringAsync();
                var probe = JsonSerializer.Deserialize<OverviewProbeDto>(raw, JsonOptions);
                if (probe?.HasSubscription == false)
                {
                    organizationStatus = probe.Status;
                    trialEndsAt = probe.TrialEndsAt;
                }
                else
                {
                    billingInfo = JsonSerializer.Deserialize<BillingOverview>(raw, JsonOptions);
                }
            }

            // The API pages by page/pageSize; there is no "limit" parameter (the old call passed one
            // and got twenty back).
            var invoicesResponse = await Http.GetAsync("api/v1/billing/invoices?page=1&pageSize=5");
            if (invoicesResponse.IsSuccessStatusCode)
            {
                recentInvoices = await invoicesResponse.Content.ReadFromJsonAsync<List<InvoiceDto>>(JsonOptions) ?? new();
                // "Open" is the ledger's word for unpaid (InvoiceStatus). This counted "Pending" and "Overdue",
                // which no invoice is ever given, so the banner never appeared.
                unpaidCount = recentInvoices.Count(i => i.Status == "Open");
            }
        }
        catch
        {
            // A partial overview is still an overview: each figure falls back to its own empty state.
        }
        finally
        {
            isLoading = false;
        }
    }

    private record OverviewProbeDto
    {
        public bool? HasSubscription { get; init; }
        public string? Status { get; init; }
        public DateTime? TrialEndsAt { get; init; }
    }

    private record BillingOverview
    {
        public string Status { get; init; } = "";
        public DateTime? NextBillingDate { get; init; }
    }
}
