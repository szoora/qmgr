    private async Task ChangeStatusAsync()
    {
        if (detail == null) return;
        saving = true;
        try
        {
            var request = new CancelSchoolEventRequest
            {
                Reason = string.IsNullOrWhiteSpace(cancelReason) ? null : cancelReason.Trim(),
                NotifyAudience = statusNotify,
                EditScope = detail.Recurrence != null ? statusScope : EventEditScopes.This,
                RowVersion = detail.RowVersion
            };
            detail = cancelling
                ? await CalendarApi.CancelEventAsync(branchId, detail.Id, request)
                : await CalendarApi.ReinstateEventAsync(branchId, detail.Id, request);
            Toast.Notify(ToastSeverity.Success, cancelling ? "Event cancelled" : "Event back on", detail.Title);
            showStatus = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, cancelling ? "Could not cancel the event" : "Could not put the event back on", ex.Message);
        }
        finally { saving = false; }
    }

