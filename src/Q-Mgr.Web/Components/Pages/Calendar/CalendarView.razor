        .cal-detail { grid-template-columns: minmax(0, 1fr); gap: 2px; }
        .cal-detail dd { margin-bottom: 6px; }
    }
</style>

@code {
    [Parameter] public bool Embedded { get; set; }

    private const string TermView = "term";
    private const string MonthView = "month";
    private const string AgendaView = "agenda";
    private const string AllCategories = "all";
    private const string NoRepeat = "none";
    private const string TodayAnchor = "cal-today-anchor";
    private const int MaxPerCell = 3;

    private static readonly IReadOnlyList<QTab> ViewTabs = new List<QTab>
    {
        new(TermView, "Term", "bookmark-star"),
        new(MonthView, "Month", "calendar3"),
        new(AgendaView, "Agenda", "list-ul"),
    };

    private static readonly IReadOnlyList<QTab> ScopeTabs = new List<QTab>
    {
        new(CalendarScopes.Mine, "My events", "person"),
        new(CalendarScopes.All, "Whole school", "buildings"),
    };

    private sealed record RepeatOption(string Key, string Label);
    private static readonly List<RepeatOption> RepeatOptions = new()
    {
        new(NoRepeat, "Does not repeat"),
        new("weekly", "Every week"),
        new("fortnightly", "Every other week"),
    };

    private static readonly IReadOnlyList<QRadioOption<string>> EditScopeOptions = new List<QRadioOption<string>>
    {
        new(EventEditScopes.This, "This one"),
        new(EventEditScopes.Following, "This and the following ones"),
        new(EventEditScopes.All, "All of them"),
    };

    private static readonly string[] WeekdayNames = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private Guid branchId;
    private Guid organizationId;
    private bool isLoading = true;
    private string view = TermView;
    private string scope = CalendarScopes.Mine;
    private bool showPast;
    private bool showDuties = true;
    private DateOnly anchor;
    private bool anchorFromLink;
    private Guid? eventFromLink;
    private CalendarRangeDto? range;
    private TimeZoneInfo zone = TimeZoneInfo.Utc;
    private string category = AllCategories;
    private string search = string.Empty;
    private bool scrollPending;

    /// <summary>B10: every load takes a number; an answer that is not the latest is dropped, not drawn.</summary>
    private int loadSequence;

    /// <summary>The term the Term view is showing, when one covers the anchor. Null falls back to 13 weeks.</summary>
    private PerformancePeriodDto? loadedTerm;

    private bool showDetail, showDay, showEditor, showDelete, showStatus, showRegister, showLibrary, saving;
    private SchoolEventDto? detail;
    private DateOnly? dayOpen;

    private Guid? editingId;
    private bool editingSeries;
    private string editScope = EventEditScopes.This;
    private SaveSchoolEventRequest form = new();
    private DateTime? formStart, formEnd, formStartTime, formEndTime;
    private bool formAllDay = true;
    private string repeatFrequency = NoRepeat;
    private DateTime? repeatUntil;
    private bool repeatTermTimeOnly = true;
    private string? attachmentName;
    private string? formProblem;
    private EventClashDto? clash;
    private string? clashCheckedFor;
    private readonly Dictionary<string, string> errors = new(StringComparer.OrdinalIgnoreCase);

    private bool cancelling;
    private string statusScope = EventEditScopes.This;
    private string? cancelReason;
    private bool statusNotify = true;

    private StaffAudienceDto registerExpected = new();
    private List<Guid> registerRecorders = new();
    private DateTime? registerStart, registerEnd;
    private bool registerNotify = true;
    private string? registerProblem;

    private List<string> classes = new();
    private List<string> rooms = new();
    private AudienceOptionsDto options = new();
    private bool lookupsLoaded;
    private bool canViewLibrary;

    /// <summary>The SCHOOL's today (B9): from the server, which reads the branch's zone. Never DateTime.Today.</summary>
    private DateOnly Today => range?.Today is { } t && t != default ? t : BranchClock.Today(zone);

    /// <summary>One thing on a day: a school event, or one of my own duties.</summary>
    private sealed record DayItem(SchoolEventDto? Event, StaffDutyDto? Duty, DateTime? DutyStart, DateTime? DutyEnd, StaffDutyDto? LinkedDuty = null)
    {
        public bool AllDay => Event != null && string.IsNullOrWhiteSpace(Event.StartTime);
        /// <summary>"HH:mm" for ordering; all-day sorts first.</summary>
        public string SortTime => Event != null ? (Event.StartTime ?? "") : QDateFormat.T(DutyStart!.Value);
    }

    protected override async Task OnInitializedAsync()
    {
        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        var prefs = await UiPreferences.LoadAsync(branchId);
        view = prefs.Calendar?.View ?? TermView;
        scope = CalendarScopes.Normalize(prefs.Calendar?.Scope);
        showPast = prefs.Calendar?.ShowPast ?? false;
        showDuties = prefs.Calendar?.ShowDuties ?? true;
        zone = BranchClock.Resolve(UiPreferences.TimeZone);
        anchor = BranchClock.Today(zone);
        ReadQuery();
        TrackBranch();
        var me = await AuthService.GetCurrentUserAsync();
        organizationId = me?.OrganizationId ?? Guid.Empty;
        canViewLibrary = await PermissionService.HasPermissionAsync(Permissions.ContentView);
        await LoadAsync();
        if (eventFromLink is { } id) await OpenLinkedEventAsync(id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Term and Agenda arrive scrolled to this week when earlier weeks are shown (E1). With them hidden, today's week
        // is already the first thing on the page.
        if (!scrollPending || range == null) return;
        scrollPending = false;
        try { await JS.InvokeAsync<bool>("qmgrCalendar.scrollTo", TodayAnchor); }
        catch (JSException) { /* nothing to scroll to */ }
    }

    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        lookupsLoaded = false;
        classes = new(); rooms = new(); options = new();
        range = null;
        await LoadAsync();
    }

    /// <summary>?view=, ?date=, ?scope= and ?event= on arrival. The hub owns ?tab=.</summary>
    private void ReadQuery()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("view", out var v) && v.ToString() is TermView or MonthView or AgendaView) view = v.ToString();
        if (query.TryGetValue("scope", out var s)) scope = CalendarScopes.Normalize(s.ToString());
        if (query.TryGetValue("date", out var d) && CalendarDisplay.ParseIso(d.ToString()) is { } parsed) { anchor = parsed; anchorFromLink = true; }
        if (query.TryGetValue("event", out var e) && Guid.TryParse(e.ToString(), out var id)) eventFromLink = id;
    }

    /// <summary>The address carries the view, so a link opens the same thing. Replaced, never pushed: a view change is not a page.</summary>
    private void SyncUrl()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query).ToDictionary(k => k.Key, k => (string?)k.Value.ToString());
        query["view"] = view;
        query["scope"] = scope;
        query["date"] = CalendarDisplay.Iso(anchor);
        query.Remove("event");
        var target = QueryHelpers.AddQueryString(uri.GetLeftPart(UriPartial.Path), query);
        if (target != Navigation.Uri) Navigation.NavigateTo(target, replace: true);
    }

    // ---- The range ------------------------------------------------------------------------------

    private (DateOnly From, DateOnly To) MonthSpan()
    {
        var first = new DateOnly(anchor.Year, anchor.Month, 1);
        var last = first.AddMonths(1).AddDays(-1);
        return (first, last);
    }

    private (DateOnly From, DateOnly To) GridSpan()
    {
        var (first, last) = MonthSpan();
        var from = CalendarDisplay.MondayOf(first);
        var to = CalendarDisplay.MondayOf(last).AddDays(6);
        return (from, to);
    }

    private (DateOnly From, DateOnly To) LoadedSpan() => view switch
    {
        MonthView => GridSpan(),
        AgendaView => MonthSpan(),
        _ => loadedTerm != null ? (loadedTerm.Start, loadedTerm.End) : (CalendarDisplay.MondayOf(anchor), CalendarDisplay.MondayOf(anchor).AddDays(13 * 7 - 1))
    };

    private async Task LoadAsync()
    {
        if (branchId == Guid.Empty) { isLoading = false; range = null; return; }
        var mine = ++loadSequence;
        isLoading = true;
        try
        {
            if (view == TermView)
            {
                // The term is found from the range answer itself: ask for the anchor's own day, and widen to that term.
                var probe = await CalendarApi.GetRangeAsync(branchId, anchor, anchor, scope);
                if (mine != loadSequence) return;
                loadedTerm = probe.Terms.FirstOrDefault(t => t.Start <= anchor && t.End >= anchor);
                if (!string.IsNullOrWhiteSpace(probe.TimeZone)) zone = BranchClock.Resolve(probe.TimeZone);
            }
            var (from, to) = LoadedSpan();
            var answer = await CalendarApi.GetRangeAsync(branchId, from, to, scope);
            if (mine != loadSequence) return; // a newer press has already asked for something else
            range = answer;
            if (!string.IsNullOrWhiteSpace(answer.TimeZone)) zone = BranchClock.Resolve(answer.TimeZone);
            if (!range.Categories.Contains(category) && category != AllCategories) category = AllCategories;
            scrollPending = view != MonthView && showPast;
        }
        catch (Exception ex)
        {
            if (mine != loadSequence) return;
            range ??= new CalendarRangeDto();
            Toast.Notify(ToastSeverity.Error, "Could not load the calendar", ex.Message);
        }
        finally
        {
            if (mine == loadSequence) isLoading = false;
        }
    }

    private async Task ChangeViewAsync(string key)
    {
        if (key == view) return;
        view = key;
        await SavePreferencesAsync();
        SyncUrl();
        await LoadAsync();
    }

    private async Task ChangeScopeAsync(string key)
    {
        if (key == scope) return;
        scope = CalendarScopes.Normalize(key);
        await SavePreferencesAsync();
        SyncUrl();
        await LoadAsync();
    }

    private async Task SetShowPastAsync(bool value)
    {
        showPast = value;
        scrollPending = value && view != MonthView;
        await SavePreferencesAsync();
    }

    private async Task SetShowDutiesAsync(bool value)
    {
        showDuties = value;
        await SavePreferencesAsync();
    }

    /// <summary>A view choice follows the person; saved quietly — failing to remember a view is not worth a message.</summary>
    private Task SavePreferencesAsync()
    {
        var current = UiPreferences.Current;
        return UiPreferences.SaveAsync(current with
        {
            Calendar = (current.Calendar ?? new CalendarViewPreferencesDto()) with { View = view, Scope = scope, ShowPast = showPast, ShowDuties = showDuties }
        }, quiet: true);
    }

    private async Task MoveAsync(int step)
    {
        if (view == TermView)
        {
            if (loadedTerm != null)
                anchor = step > 0 ? loadedTerm.End.AddDays(1) : loadedTerm.Start.AddDays(-1);
            else
                anchor = anchor.AddDays(step * 13 * 7);
        }
        else
        {
            anchor = new DateOnly(anchor.Year, anchor.Month, 1).AddMonths(step);
        }
        SyncUrl();
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        anchor = Today;
        SyncUrl();
        await LoadAsync();
    }

    private string ViewNoun => view switch { TermView => "term", _ => "month" };

    private string RangeLabel => view switch
    {
        TermView => loadedTerm?.Name ?? $"13 weeks from {QDateFormat.D(CalendarDisplay.MondayOf(anchor))}",
        _ => QDateFormat.MYLong(anchor.ToDateTime(TimeOnly.MinValue))
    };

    private PerformancePeriodDto? CurrentTerm =>
        range?.Terms.FirstOrDefault(t => t.Start <= anchor && t.End >= anchor)
        ?? (view == TermView ? loadedTerm : null)
        ?? range?.Terms.FirstOrDefault();

    private (int Week, int Of)? TermWeek(PerformancePeriodDto term)
    {
        var today = Today;
        if (today < term.Start || today > term.End) return null;
        var monday = CalendarDisplay.MondayOf(term.Start);
        var week = (CalendarDisplay.MondayOf(today).DayNumber - monday.DayNumber) / 7 + 1;
        var of = (CalendarDisplay.MondayOf(term.End).DayNumber - monday.DayNumber) / 7 + 1;
        return (week, of);
    }

    private string WeekHeading(DateOnly monday)
    {
        if (view == TermView && loadedTerm != null)
        {
            var n = (monday.DayNumber - CalendarDisplay.MondayOf(loadedTerm.Start).DayNumber) / 7 + 1;
            return $"Week {n} · {QDateFormat.C(monday)} – {QDateFormat.C(monday.AddDays(6))}";
        }
        return $"Week of {QDateFormat.C(monday)}";
    }

    private IEnumerable<DateOnly> GridDays()
    {
        var (from, to) = GridSpan();
        for (var d = from; d <= to; d = d.AddDays(1)) yield return d;
    }

    /// <summary>The days a list shows: the whole loaded span, or — past events hidden — from today on (E1).</summary>
    private IEnumerable<DateOnly> ListDays()
    {
        var (from, to) = LoadedSpan();
        if (!showPast && Today > from) from = Today;
        for (var d = from; d <= to; d = d.AddDays(1)) yield return d;
    }

    /// <summary>Events in the loaded span that ended before today — what "Earlier this term" counts.</summary>
    private int EarlierCount
    {
        get
        {
            var (from, _) = LoadedSpan();
            return FilteredEvents().Count(e => e.EndsOn < Today && e.EndsOn >= from);
        }
    }

    private string ListEmptyTitle => !showPast && EarlierCount > 0
        ? (view == TermView ? "Nothing more this term" : "Nothing more this month")
        : (view == TermView ? "No events this term" : "No events this month");

    // ---- What is on a day -----------------------------------------------------------------------

    private IEnumerable<SchoolEventDto> FilteredEvents()
    {
        if (range == null) return Enumerable.Empty<SchoolEventDto>();
        IEnumerable<SchoolEventDto> events = range.Events;
        if (category != AllCategories)
            events = events.Where(e => string.Equals(e.Category, category, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(search))
        {
            var q = search.Trim();
            bool Has(string? s) => (s ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase);
            events = events.Where(e => Has(e.Title) || Has(e.Location) || Has(e.ResponsibleText) || Has(e.Description) || Has(e.StaffAudienceText));
        }
        return events;
    }

    /// <summary>A duty instant on the SCHOOL's clock (B9), not the server's.</summary>
    private DateTime Local(DateTime value) => BranchClock.ToLocal(value, zone);

    /// <summary>
    /// Everything on a day. B1: a meeting that is ALSO an event is shown once — as the event, carrying the duty's badge —
    /// never as an event and a duty side by side. B11: my duties follow the switch whatever category is chosen (a duty
    /// has no category, and hiding it behind "Sports &amp; clubs" read as the duty having moved); a search narrows them by title.
    /// </summary>
    private List<DayItem> ItemsOn(DateOnly day)
    {
        var events = FilteredEvents().Where(e => CalendarDisplay.IsOn(e, day)).ToList();
        var duties = range?.MyDuties.Where(d => d.IsActive).ToList() ?? new();
        var byId = duties.ToDictionary(d => d.Id);
        var items = events.Select(e => new DayItem(e, null, null, null, e.DutyId is { } id && byId.TryGetValue(id, out var linked) ? linked : null)).ToList();
        if (showDuties && range != null)
        {
            var linkedIds = range.Events.Where(e => e.DutyId.HasValue).Select(e => e.DutyId!.Value).ToHashSet();
            var q = search.Trim();
            foreach (var d in duties.Where(d => !linkedIds.Contains(d.Id)))
            {
                if (q.Length > 0 && !d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) continue;
                var start = Local(d.StartsAt);
                var end = Local(d.EndsAt);
                if (DateOnly.FromDateTime(start) <= day && DateOnly.FromDateTime(end) >= day)
                    items.Add(new DayItem(null, d, start, end));
            }
        }
        return items.OrderBy(i => !i.AllDay).ThenBy(i => i.SortTime, StringComparer.Ordinal)
            .ThenBy(i => i.Event?.Title ?? i.Duty?.Title, StringComparer.OrdinalIgnoreCase).ToList();
    }

    /// <summary>
    /// B15: in the Term and Agenda LISTS an event over several days is shown once — on its first day, or on the first day
    /// the list shows when it began earlier — with "until …". The Month grid still shows it on every day it touches.
    /// </summary>
    private List<DayItem> ListItemsOn(DateOnly day)
    {
        var firstShown = ListDays().FirstOrDefault();
        return ItemsOn(day).Where(i => i.Event is not { } e || e.StartsOn == day || (e.StartsOn < firstShown && day == firstShown)).ToList();
    }

    private IEnumerable<NationalCalendarEntryDto> NationalOn(DateOnly day)
        => range?.NationalDates.Where(n => n.StartsOn <= day && n.EndsOn >= day) ?? Enumerable.Empty<NationalCalendarEntryDto>();

    private string EmptyText => scope == CalendarScopes.Mine
        ? "Nothing here is for you. Switch to Whole school to see the school's programme."
        : range?.CanManage == true
            ? "Add one with New event, or bring a whole term's programme in on the Import tab."
            : "Nothing has been put on the calendar for this period.";

    /// <summary>
    /// B11: the counts are of what the view SHOWS — its own days (never the grid's out-of-month ones), past days only when
    /// past events are shown, and the search applied — so the number on a chip is the number of rows it leaves.
    /// </summary>
    private List<QBulkBar.Filter> CategoryChips
    {
        get
        {
            var shown = ShownDays();
            IEnumerable<SchoolEventDto> events = range?.Events ?? new List<SchoolEventDto>();
            if (!string.IsNullOrWhiteSpace(search))
            {
                var q = search.Trim();
                events = events.Where(e => (e.Title + " " + e.Location + " " + e.ResponsibleText + " " + e.Description + " " + e.StaffAudienceText).Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            var inView = events.Where(e => shown.Any(d => CalendarDisplay.IsOn(e, d))).ToList();
            var chips = new List<QBulkBar.Filter> { new(AllCategories, "All", inView.Count) };
            foreach (var c in Categories)
            {
                var n = inView.Count(e => string.Equals(e.Category, c, StringComparison.OrdinalIgnoreCase));
                if (n > 0 || string.Equals(category, c, StringComparison.OrdinalIgnoreCase)) chips.Add(new(c, c, n));
            }
            return chips;
        }
    }

    private List<DateOnly> ShownDays() => view == MonthView
        ? GridDays().Where(d => d.Month == anchor.Month).ToList()
        : ListDays().ToList();

