    private static DateTime? ParseTime(DateOnly day, string? hhmm)
        => TimeOnly.TryParseExact(hhmm, "HH:mm", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var t)
            ? day.ToDateTime(t) : null;

    private static string HHmm(DateTime value) => value.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private string? Error(string field) => errors.TryGetValue(field, out var m) ? m : null;

