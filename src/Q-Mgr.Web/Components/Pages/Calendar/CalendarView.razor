    private static string ClashWords(EventClashDto c)
    {
        var parts = new List<string>();
        if (c.Teaching > 0) parts.Add($"{c.Teaching} {(c.Teaching == 1 ? "is" : "are")} teaching");
        if (c.OnDuty > 0) parts.Add($"{c.OnDuty} {(c.OnDuty == 1 ? "is" : "are")} on another duty");
        return string.Join(" and ", parts);
    }

    /// <summary>
    /// The refusals the server makes, made first — a form that accepts anything and refuses afterwards is how people learn
    /// to stop trying. The server checks every one again; this only saves the round trip.
    /// </summary>
    private bool Validate()
    {
        errors.Clear();
        if (string.IsNullOrWhiteSpace(form.Title)) errors["title"] = "Give the event a title.";
        if (formStart == null) errors["startsOn"] = "Choose the first day.";
        if (formEnd == null) errors["endsOn"] = "Choose the last day.";
        if (formStart is { } s && formEnd is { } e)
        {
            if (e.Date < s.Date) errors["endsOn"] = "The last day cannot be before the first.";
            else if ((e.Date - s.Date).TotalDays > 92) errors["endsOn"] = "An event can run for at most 92 days.";
        }
        if (!formAllDay)
        {
            if (formStartTime == null) errors["startTime"] = "Give a start time, or tick All day.";
            else if (formEndTime is { } et && TimeOnly.FromDateTime(et) <= TimeOnly.FromDateTime(formStartTime.Value))
                errors["endTime"] = "The end time must be after the start time.";
        }
        if (form.Audience == EventAudience.None) errors["audience"] = "Choose who the event is for.";
        if (Has(EventAudience.Staff) && form.StaffAudience.IsEmpty) errors["staffAudience"] = "Choose which staff it is for: everyone, or at least one group, role, department or person.";
        if (!editingId.HasValue && repeatFrequency != NoRepeat)
        {
            if (repeatUntil == null) errors["repeatUntil"] = "Choose the last date it repeats until.";
            else if (formStart is { } rs && repeatUntil.Value.Date <= rs.Date) errors["repeatUntil"] = "Repeat until a day after the first one.";
        }
        return errors.Count == 0;
    }

    private void Stamp()
    {
        form.Title = form.Title.Trim();
        // B19: only a NEW event takes this branch; an edit keeps what it had, all-branch included.
        if (!editingId.HasValue) form.BranchId ??= branchId;
        form.StartsOn = DateOnly.FromDateTime(formStart!.Value);
        form.EndsOn = DateOnly.FromDateTime(formEnd!.Value);
        form.StartTime = formAllDay ? null : HHmm(formStartTime!.Value);
        form.EndTime = formAllDay || formEndTime == null ? null : HHmm(formEndTime.Value);
        form.Location = string.IsNullOrWhiteSpace(form.Location) ? null : form.Location.Trim();
        form.ResponsibleText = string.IsNullOrWhiteSpace(form.ResponsibleText) ? null : form.ResponsibleText.Trim();
        form.EditScope = editingSeries ? editScope : EventEditScopes.This;
        form.Repeat = !editingId.HasValue && repeatFrequency != NoRepeat && repeatUntil is { } until
            ? new RepeatRuleDto { Frequency = repeatFrequency, Until = DateOnly.FromDateTime(until), TermTimeOnly = repeatTermTimeOnly }
            : null;
        if (!NotifyApplies) form.NotifyAudience = false;
    }

    /// <summary>
    /// Who in the audience is already teaching or on duty then. Asked once per set of values: a clash WARNS, and a second
    /// press of Save with nothing changed saves anyway (D6 of the calendar plan — never a refusal).
    /// </summary>
    private async Task<bool> ClashesAcknowledgedAsync()
    {
        var key = string.Join("|", form.StartsOn, form.EndsOn, form.StartTime, form.EndTime, form.StaffAudience.AllStaff,
            string.Join(",", form.StaffAudience.StaffGroups), string.Join(",", form.StaffAudience.RoleCodes),
            string.Join(",", form.StaffAudience.DepartmentIds), string.Join(",", form.StaffAudience.UserIds), string.Join(",", form.ResponsibleUserIds));
        if (clashCheckedFor == key) return true;
        clashCheckedFor = key;
        clash = null;
        if (!Has(EventAudience.Staff) || form.EndsOn < Today) return true;
        try
        {
            clash = await CalendarApi.CheckClashesAsync(branchId, new EventClashRequest
            {
                StaffAudience = form.StaffAudience, ResponsibleUserIds = form.ResponsibleUserIds,
                StartsOn = form.StartsOn, EndsOn = form.EndsOn, StartTime = form.StartTime, EndTime = form.EndTime
            });
        }
        catch { return true; } // a check that could not run is not a reason to stop somebody saving
        return clash.Teaching + clash.OnDuty == 0;
    }

    private async Task SaveAsync()
    {
        formProblem = null;
        if (!Validate()) return;
        Stamp();

        saving = true;
        try
        {
            if (!await ClashesAcknowledgedAsync()) return;

            SchoolEventDto saved;
            if (editingId.HasValue)
            {
                saved = await CalendarApi.UpdateEventAsync(branchId, editingId.Value, form);
                Toast.Notify(ToastSeverity.Success, "Event updated", form.Title);
            }
            else
            {
                saved = await CalendarApi.CreateEventAsync(branchId, form);
                Toast.Notify(ToastSeverity.Success, form.Repeat != null ? "Events added" : "Event added", form.Repeat != null ? $"{form.Title} — {RepeatOptions.First(o => o.Key == repeatFrequency).Label.ToLowerInvariant()}" : form.Title);
            }
            showEditor = false;
            // Show where it landed: the month of its first day.
            if (view != TermView) anchor = saved.StartsOn;
            await LoadAsync();
        }
        catch (ApiFieldException ex) when (ex.Code == "EVENT_CHANGED" && editingId is { } id)
        {
            // B5: somebody saved it first. Their version is put in front of the reader, not silently overwritten.
            formProblem = ex.Message;
            try { FillForm(await CalendarApi.GetEventAsync(branchId, id)); formProblem = ex.Message; }
            catch { /* the message stands */ }
        }
        catch (ApiFieldException ex)
        {
            foreach (var (field, message) in ex.Errors) errors[field] = message;
            formProblem = ex.Errors.Count > 0 ? "Complete the fields marked in red." : ex.Message;
        }
        catch (Exception ex)
        {
            formProblem = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

