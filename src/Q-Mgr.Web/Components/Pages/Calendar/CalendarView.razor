            detail = await CalendarApi.GiveRegisterAsync(branchId, detail.Id, new EventRegisterRequest
            {
                Expected = registerExpected,
                RecorderUserIds = registerRecorders,
                StartTime = allDay && registerStart is { } rs ? HHmm(rs) : null,
                EndTime = allDay && registerEnd is { } re ? HHmm(re) : null,
                NotifyPeople = registerNotify
            });
            Toast.Notify(ToastSeverity.Success, "Register added", $"{detail.Title} now has a register.");
            showRegister = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            registerProblem = ex.Message;
        }
        finally { saving = false; }
    }

    // ---- Delete ---------------------------------------------------------------------------------

    private void AskDelete() => showDelete = true;

    private async Task DeleteConfirmedAsync(bool confirmed)
    {
        if (!confirmed || detail == null) return;
        try
        {
            await CalendarApi.DeleteEventAsync(branchId, detail.Id);
            Toast.Notify(ToastSeverity.Success, "Event deleted", detail.Title);
            showDetail = false;
            detail = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not delete the event", ex.Message);
        }
    }
}
