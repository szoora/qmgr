    .cal-cancelled-note { display: flex; align-items: center; gap: 6px; margin: 0 0 10px; color: var(--qm-danger); font-weight: 500; }
    .cal-audience { border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 8px 12px; margin: 0 0 var(--qm-field-gap, 12px); display: flex; flex-direction: column; gap: 8px; }
    .cal-audience legend { display: inline-flex; align-items: center; gap: 4px; padding: 0 4px; width: auto; float: none; margin: 0; font-size: var(--qm-text-base); font-weight: 500; color: var(--qm-text-secondary); }
    .cal-audience__row { display: flex; flex-wrap: wrap; gap: 4px 16px; }
    .cal-edit-scope { margin-bottom: var(--qm-field-gap, 12px); }
