    /* A phone: the grid becomes the list of days that have something on them. */
    @@media (max-width: 640px) {
        .cal-month__head { display: none; }
        .cal-month__body { grid-template-columns: minmax(0, 1fr); }
        .cal-day { min-height: 0; border-right: 0; }
        .cal-day--out, .cal-day--empty { display: none; }
        .cal-day__num { display: none; }
        .cal-day__long { display: inline; }
