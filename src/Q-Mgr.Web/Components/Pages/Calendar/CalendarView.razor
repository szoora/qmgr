@* No @page: a SECTION of the Calendar hub at /calendar. The hub owns ?tab=; this section reads and writes its own
   ?view=, ?date=, ?scope= and ?event=, so a link opens the same view — and a notification opens the event. *@
@using Microsoft.AspNetCore.WebUtilities
@using QMgr.Application
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@inherits BranchAwareComponentBase
@inject ICalendarApiService CalendarApi
@inject IStudentApiService StudentApi
@inject IUiPreferencesService UiPreferences
@inject IPermissionService PermissionService
@inject IAuthService AuthService
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Navigation

@*
    The school calendar (plan TERM_PROGRAMME_CALENDAR_AND_GATES §9; CALENDAR_AUDIENCES_AND_IMPORT_ROUTING, 2026-09-26).
    Three views of one range:
      * Term   — the term's programme, week by week, the shape a school prints and pins up;
      * Month  — a Monday-first 7-column grid; under 640px it stacks into a day list;
      * Agenda — the month as a list of the days that have something on them.

    TWO SCOPES (E4): "My events" — the events I am in the audience of or run, and my duties — and "Whole school". My
    events is the default, the way Arbor's "My Calendar" is: the whole school is one press away, never the first thing.

    PAST EVENTS (E1): a LIST's job is what is coming, so Term and Agenda start at today and say how many earlier events
    they are not showing; "Show past events" brings them back, dimmed. The Month grid is a map of the month, so past days
    stay in it, dimmed. The choices follow the person (IUiPreferencesService), not the browser.

    Every "today" on this page is the SCHOOL's today (CalendarRangeDto.Today, B9) — never DateTime.Today, which on
    Blazor Server is the host's clock — and every duty instant is drawn on the branch's zone.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Calendar</h1>
    </Title>
    <Actions>
        <QButton Text="Print programme" Icon="printer" Variant="secondary" OnClick="@OpenPrint" Disabled="@(branchId == Guid.Empty)" />
        @if (range?.CanManage == true)
        {
            <QButton Text="New event" Icon="plus-lg" Variant="primary" OnClick="@(() => OpenCreate(null))" id="cal-new-event" />
        }
    </Actions>
</QPageActions>

<div class="cal-page">
    <QFilterBar Wrap="true" Class="cal-toolbar">
        <QTabs Tabs="@ViewTabs" ActiveKey="@view" ActiveKeyChanged="@ChangeViewAsync" IdPrefix="calv" AriaLabel="Calendar view" Class="cal-views" />
        <div class="cal-nav" role="group" aria-label="Move through the calendar">
            <QButton Icon="chevron-left" Variant="ghost" Size="sm" OnClick="@(() => MoveAsync(-1))" aria-label="@($"Previous {ViewNoun}")" id="cal-prev" />
            <QButton Text="Today" Variant="secondary" Size="sm" OnClick="@TodayAsync" id="cal-today" />
            <QButton Icon="chevron-right" Variant="ghost" Size="sm" OnClick="@(() => MoveAsync(1))" aria-label="@($"Next {ViewNoun}")" id="cal-next" />
            <strong class="cal-nav__label" id="cal-range-label">@RangeLabel</strong>
        </div>
        <QTabs Tabs="@ScopeTabs" ActiveKey="@scope" ActiveKeyChanged="@ChangeScopeAsync" IdPrefix="cals" AriaLabel="Whose events" Class="cal-scope" />
        @if (view != MonthView)
        {
            <QSwitch Value="@showPast" ValueChanged="@SetShowPastAsync" Label="Show past events" aria-label="Show past events" id="cal-show-past" />
        }
        <QSwitch Value="@showDuties" ValueChanged="@SetShowDutiesAsync" Label="My duties" aria-label="Show my duties" id="cal-show-duties" />
    </QFilterBar>

    @if (branchId == Guid.Empty)
    {
        <QEmptyState Icon="building" Title="Choose a branch" Text="The calendar belongs to a branch. Pick one in the switcher above." />
    }
    else if (isLoading && range == null)
    {
        <div class="cal-loading"><QSpinner Size="lg" /><span>Loading the calendar...</span></div>
    }
    else if (range != null)
    {
        @if (CurrentTerm is { } term)
        {
            <div class="cal-term" id="cal-term">
                <QIcon Name="bookmark-star" />
                <div class="cal-term__text">
                    <strong>@term.Name</strong>
                    <span>@QDateFormat.Range(term.Start, term.End)@(TermWeek(term) is { } w ? $" · week {w.Week} of {w.Of}" : "")</span>
                    @if (!string.IsNullOrWhiteSpace(term.Theme))
                    {
                        <em class="cal-term__theme">“@term.Theme”</em>
                    }
                </div>
            </div>
        }

        <QBulkBar Filters="@CategoryChips" ActiveFilter="@category" ActiveFilterChanged="@(k => category = k)"
                  Search="@search" SearchChanged="@(s => search = s ?? string.Empty)" SearchPlaceholder="Search events" Class="cal-filter" />

        @if (view == MonthView)
        {
            <div class="cal-month" role="grid" aria-label="@RangeLabel" id="cal-month">
                <div class="cal-month__head" role="row">
                    @foreach (var d in WeekdayNames) { <div class="cal-month__dow" role="columnheader">@d</div> }
                </div>
                <div class="cal-month__body">
                    @foreach (var day in GridDays())
                    {
                        var items = ItemsOn(day);
                        var inMonth = day.Month == anchor.Month;
                        var national = NationalOn(day).ToList();
                        <div class="cal-day @(inMonth ? "" : "cal-day--out") @(day == Today ? "cal-day--today" : "") @(day < Today ? "cal-day--past" : "") @(items.Count == 0 && national.Count == 0 ? "cal-day--empty" : "")"
                             role="gridcell" data-date="@CalendarDisplay.Iso(day)">
                            <div class="cal-day__head">
                                <span class="cal-day__num">@day.Day</span>
                                <span class="cal-day__long">@QDateFormat.Dy(day) @QDateFormat.C(day)</span>
                                @if (range.CanManage && inMonth)
                                {
                                    <button type="button" class="cal-day__add" title="New event on this day" aria-label="@($"New event on {QDateFormat.D(day)}")" @onclick="@(() => OpenCreate(day))"><QIcon Name="plus" Size="sm" /></button>
                                }
                            </div>
                            @foreach (var n in national)
                            {
                                <span class="cal-national" title="@($"{n.Title}{(string.IsNullOrWhiteSpace(n.Source) ? "" : $" — {n.Source}")}")">@n.Title</span>
                            }
                            @foreach (var item in items.Take(MaxPerCell))
                            {
                                @ItemPill(item)
                            }
                            @if (items.Count > MaxPerCell)
                            {
                                <button type="button" class="cal-more" @onclick="@(() => OpenDayAsync(day))">+@(items.Count - MaxPerCell) more</button>
                            }
                        </div>
                    }
                </div>
            </div>
            @* B20: "nothing this month" is about EVENTS; a month with only my duties in it is not empty of events, and the
               grid shows those duties anyway. *@
            @if (!GridDays().Where(d => d.Month == anchor.Month).Any(d => ItemsOn(d).Any(i => i.Event != null)))
            {
                <QEmptyState Icon="calendar-x" Title="No events this month" Text="@EmptyText" Class="cal-empty" />
            }
        }
        else
        {
            var days = ListDays().ToList();
            var withItems = days.Where(d => ListItemsOn(d).Count > 0 || NationalOn(d).Any()).ToList();
            var anchorDay = withItems.FirstOrDefault(d => d >= Today);
            @if (!showPast && EarlierCount > 0)
            {
                <p class="cal-earlier" id="cal-earlier">
                    <QIcon Name="clock-history" Size="sm" />
                    <span>Earlier @(view == TermView ? "this term" : "this month"): @EarlierCount @(EarlierCount == 1 ? "event" : "events").</span>
                    <QButton Text="Show" Variant="ghost" Size="sm" OnClick="@(() => SetShowPastAsync(true))" id="cal-earlier-show" />
                </p>
            }
            @if (withItems.Count == 0)
            {
                <QEmptyState Icon="calendar-x" Title="@(ListEmptyTitle)" Text="@EmptyText" Class="cal-empty" />
            }
            else
            {
                <div class="cal-agenda" id="cal-agenda">
                    @foreach (var week in withItems.GroupBy(CalendarDisplay.MondayOf))
                    {
                        @if (view == TermView)
                        {
                            <h2 class="cal-week @(week.Key.AddDays(6) < Today ? "cal-week--past" : "")">@WeekHeading(week.Key)</h2>
                        }
                        @foreach (var day in week)
                        {
                            var items = ListItemsOn(day);
                            <section class="cal-agenda__day @(day == Today ? "cal-agenda__day--today" : "") @(day < Today ? "cal-agenda__day--past" : "")"
                                     data-date="@CalendarDisplay.Iso(day)" id="@(day == anchorDay ? TodayAnchor : null)">
                                <div class="cal-agenda__date">
                                    <strong>@QDateFormat.Dy(day)</strong>
                                    <span>@QDateFormat.C(day)</span>
                                </div>
                                <div class="cal-agenda__items">
                                    @foreach (var n in NationalOn(day))
                                    {
                                        <span class="cal-national">@n.Title@(string.IsNullOrWhiteSpace(n.Kind) ? "" : $" · {n.Kind}")</span>
                                    }
                                    @foreach (var item in items)
                                    {
                                        @ItemRow(item, day)
                                    }
                                </div>
                            </section>
                        }
                    }
                </div>
            }
        }
    }
</div>

@* ---- One event ------------------------------------------------------------------------------ *@
<QModal @bind-Visible="showDetail" Title="@(detail?.Title ?? "Event")" Icon="calendar-event" Size="md">
    <ChildContent>
        @if (detail != null)
        {
            @if (detail.Status == SchoolEventStatus.Cancelled)
            {
                <p class="cal-cancelled-note" role="status"><QIcon Name="x-octagon" Size="sm" /> <span>Cancelled@(string.IsNullOrWhiteSpace(detail.CancelReason) ? "." : $": {detail.CancelReason}")</span></p>
            }
            <dl class="cal-detail" id="cal-detail">
                <dt>When</dt><dd>@CalendarDisplay.DatesAndTime(detail)@(detail.EndsOn > detail.StartsOn && detail.StartTime != null ? ", each day" : "")</dd>
                @if (!string.IsNullOrWhiteSpace(detail.Recurrence)) { <dt>Repeats</dt><dd>@detail.Recurrence</dd> }
                @if (!string.IsNullOrWhiteSpace(detail.Location)) { <dt>Venue</dt><dd>@detail.Location</dd> }
                @if (!string.IsNullOrWhiteSpace(detail.Category)) { <dt>Category</dt><dd>@detail.Category</dd> }
                <dt>For</dt><dd>@CalendarDisplay.Audience(detail.Audience)@(CalendarDisplay.Classes(detail) is { } cls ? $" · {cls}" : " · the whole school")</dd>
                @if (!string.IsNullOrWhiteSpace(detail.StaffAudienceText)) { <dt>Staff</dt><dd>@detail.StaffAudienceText@(detail.AudienceOnly ? " · only they can see it" : "")</dd> }
                @if (detail.AttendanceRequired) { <dt>Attendance</dt><dd>Required</dd> }
                @if (CalendarDisplay.Responsible(detail) is { } who) { <dt>Responsible</dt><dd>@who</dd> }
                @if (DepartmentNames(detail) is { } depts) { <dt>Departments</dt><dd>@depts</dd> }
                @if (!string.IsNullOrWhiteSpace(detail.SeriesName)) { <dt>Programme</dt><dd>@detail.SeriesName</dd> }
                @if (detail.LibraryDocumentId is { } docId)
                {
                    <dt>Document</dt>
                    <dd><a href="@($"/content/library?tab=documents&document={docId}")">@(detail.LibraryDocumentTitle ?? "Open the document")</a></dd>
                }
                @if (!string.IsNullOrWhiteSpace(detail.Description)) { <dt>Notes</dt><dd class="cal-detail__notes">@detail.Description</dd> }
            </dl>
            @if (detail.DutyId.HasValue)
            {
                <p class="cal-hint"><QIcon Name="clipboard-check" Size="sm" /> <span>This event is also a staff meeting with a register.</span></p>
            }
            else if (CanGiveRegister(detail))
            {
                <p class="cal-hint"><QIcon Name="clipboard-plus" Size="sm" /> <span>No register is taken at this event. If it is a staff meeting, give it one.</span></p>
            }
        }
    </ChildContent>
    <FooterContent>
        @if (detail != null)
        {
            <QButton Text="Add to my calendar" Icon="calendar-plus" Variant="ghost" OnClick="@DownloadIcsAsync" id="cal-detail-ics" />
            @if (detail.CanOpenRegister && detail.DutyId is { } dutyId)
            {
                <QButton Text="Open the register" Icon="clipboard-check" Variant="secondary" OnClick="@(() => Navigation.NavigateTo($"/admin/staff/duties/{dutyId}/register"))" id="cal-detail-register" />
            }
            @if (CanGiveRegister(detail))
            {
                <QButton Text="Give it a register" Icon="clipboard-plus" Variant="secondary" OnClick="@OpenGiveRegister" id="cal-detail-give-register" />
            }
            @if (detail.CanEdit)
            {
                <QButton Text="Delete" Icon="trash" Variant="outline-danger" OnClick="@AskDelete" id="cal-detail-delete" />
                @if (detail.Status == SchoolEventStatus.Cancelled)
                {
                    <QButton Text="Put it back on" Icon="arrow-counterclockwise" Variant="secondary" OnClick="@(() => OpenStatus(false))" id="cal-detail-reinstate" />
                }
                else
                {
                    <QButton Text="Cancel event" Icon="x-octagon" Variant="secondary" OnClick="@(() => OpenStatus(true))" id="cal-detail-cancel" />
                }
                <QButton Text="Edit" Icon="pencil" Variant="secondary" OnClick="@(() => OpenEdit(detail!))" id="cal-detail-edit" />
            }
        }
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showDetail = false)" />
    </FooterContent>
</QModal>

@* ---- A day's full list, when a month cell overflows ------------------------------------------ *@
<QModal @bind-Visible="showDay" Title="@(dayOpen.HasValue ? QDateFormat.LongDay(dayOpen.Value) : "Day")" Icon="calendar-day" Size="md">
    <ChildContent>
        @if (dayOpen is { } open)
        {
            <div class="cal-agenda__items">
                @foreach (var item in ItemsOn(open)) { @ItemRow(item, open) }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showDay = false)" />
    </FooterContent>
</QModal>

@* ---- New / edit ------------------------------------------------------------------------------ *@
<QModal @bind-Visible="showEditor" Title="@(editingId.HasValue ? "Edit event" : "New event")" Icon="calendar-plus" Size="lg">
    <ChildContent>
        <p class="form-required-note">* Required</p>
        @if (editingSeries)
        {
            <QRadioGroup TValue="string" Options="@EditScopeOptions" Value="@editScope" ValueChanged="@(v => editScope = v)" Legend="This event repeats. Change" Inline="true" Class="cal-edit-scope" />
        }
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@form.Title" Label="Title" Required="true" MaxLength="200" id="cal-ev-title"
                    Placeholder="Grand Mass, Visiting Day, S.4 mock examinations"
                    HasError="@(Error("title") != null)" ErrorMessage="@Error("title")" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <QDatePicker @bind-Value="@formStart" Label="First day" Required="true"
                             HasError="@(Error("startsOn") != null)" ErrorMessage="@Error("startsOn")" />
            </div>
            <div class="form-group">
                <QDatePicker @bind-Value="@formEnd" Label="Last day" Required="true" Min="@formStart"
                             HasError="@(Error("endsOn") != null)" ErrorMessage="@Error("endsOn")" />
            </div>
        </div>
        <div class="form-group">
            <QCheckbox Value="@formAllDay" ValueChanged="@(v => formAllDay = v)" Label="All day" id="cal-ev-allday" />
        </div>
        @if (!formAllDay)
        {
            <div class="form-row">
                <div class="form-group">
                    <QDatePicker @bind-Value="@formStartTime" ShowTime="true" Label="Starts" Required="true"
                                 HasError="@(Error("startTime") != null)" ErrorMessage="@Error("startTime")" />
                </div>
                <div class="form-group">
                    <QDatePicker @bind-Value="@formEndTime" ShowTime="true" Label="Ends" Clearable="true" Placeholder="Onwards"
                                 HasError="@(Error("endTime") != null)" ErrorMessage="@Error("endTime")" />
                </div>
            </div>
            @if (formStart is { } fs && formEnd is { } fe && fe.Date > fs.Date)
            {
                <p class="cal-hint">These times apply to each day of the event.</p>
            }
        }
        @if (!editingId.HasValue)
        {
            <div class="form-row">
                <div class="form-group">
                    <QSelect TValue="string" TItem="RepeatOption" @bind-Value="@repeatFrequency" Items="@RepeatOptions"
                             TextSelector="@(o => o.Label)" ValueSelector="@(o => o.Key)" Label="Repeats" />
                </div>
                @if (repeatFrequency != NoRepeat)
                {
                    <div class="form-group">
                        <QDatePicker @bind-Value="@repeatUntil" Label="Until" Required="true" Min="@formStart"
                                     HasError="@(Error("repeatUntil") != null)" ErrorMessage="@Error("repeatUntil")" />
                    </div>
                    <div class="form-group cal-repeat-term">
                        <QCheckbox @bind-Value="@repeatTermTimeOnly" Label="Term time only" Hint="Weeks outside the term, and national holidays, are left out." />
                    </div>
                }
            </div>
        }
        <div class="form-row">
            <div class="form-group">
                <QSelect TValue="string" TItem="string" @bind-Value="@form.Category" Items="@Categories" AllowClear="true"
                         TextSelector="@(c => c)" ValueSelector="@(c => c)" Label="Category" Placeholder="Choose a category"
                         Hint="The school's own list, kept on the Settings tab." />
            </div>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@form.Location" Label="Venue" MaxLength="200" List="cal-rooms"
                        Placeholder="A room, the chapel, the main field" Hint="Pick a room or type any place." />
                <datalist id="cal-rooms">
                    @foreach (var r in rooms) { <option value="@r"></option> }
                </datalist>
            </div>
        </div>

        <fieldset class="cal-audience">
            <legend>Who it is for <QInfo Text="Staff see it on their calendar, My School Day and their phone's calendar. Public puts it on the signage screens' Coming up list. Students and Guardians are kept with the event for the day they have a way in." Label="the audience" /></legend>
            <div class="cal-audience__row">
                <QCheckbox Value="@Has(EventAudience.Staff)" ValueChanged="@(v => SetAudience(EventAudience.Staff, v))" Label="Staff" id="cal-ev-for-staff" />
                <QCheckbox Value="@Has(EventAudience.Students)" ValueChanged="@(v => SetAudience(EventAudience.Students, v))" Label="Students" />
                <QCheckbox Value="@Has(EventAudience.Guardians)" ValueChanged="@(v => SetAudience(EventAudience.Guardians, v))" Label="Guardians" />
                <QCheckbox Value="@Has(EventAudience.Public)" ValueChanged="@(v => SetAudience(EventAudience.Public, v))" Label="Public (signage)" />
            </div>
            @if (!Has(EventAudience.Staff))
            {
                @* B21: an event for students or guardians only reaches no member of staff's own calendar. Said here,
                   rather than discovered when nobody turns up. *@
                <p class="cal-hint" id="cal-ev-no-staff">Students and guardians cannot see the calendar yet, so without Staff this event appears only on the whole-school view@(Has(EventAudience.Public) ? " and the signage screens" : "").</p>
            }
            @if (Error("audience") is { } audienceError) { <p class="form-error" role="alert">@audienceError</p> }
            @if (Has(EventAudience.Staff))
            {
                <QAudiencePicker Value="@form.StaffAudience" ValueChanged="@(a => form.StaffAudience = a)" Options="@options"
                                 AlsoIncluded="@form.ResponsibleUserIds" Label="Which staff" ErrorMessage="@Error("staffAudience")"
                                 Hint="They are told about it, reminded of it, and see it under My events. The people responsible are always included." />
                <div class="cal-audience__row">
                    <QCheckbox @bind-Value="@form.AudienceOnly" Label="Only they can see it" id="cal-ev-audience-only"
                               Hint="For an interview or a disciplinary panel: it is left off the whole-school view for everybody else." />
                    <QCheckbox @bind-Value="@form.AttendanceRequired" Label="Attendance is required" id="cal-ev-required" />
                </div>
            }
        </fieldset>

        <div class="form-row">
            <div class="form-group">
                <QMultiSelect TValue="string" TItem="string" SelectedValues="@form.ClassNames" SelectedValuesChanged="@(v => form.ClassNames = v.ToList())"
                              Items="@classes" TextSelector="@(c => c)" ValueSelector="@(c => c)" Label="Classes"
                              Placeholder="The whole school" Hint="Leave empty for the whole school." />
            </div>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@form.ResponsibleText" Label="Responsible, as written" MaxLength="300"
                        Placeholder="Senior Ladies &amp; Matrons" Hint="Words for the programme. Name people below to put it on their own calendar." />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <QMultiSelect TValue="Guid" TItem="AudienceMemberDto" SelectedValues="@form.ResponsibleUserIds" SelectedValuesChanged="@(v => form.ResponsibleUserIds = v.ToList())"
                              Items="@options.People" ValueSelector="@(s => s.UserId)" TextSelector="@(s => s.FullName)"
                              Label="Responsible people" Placeholder="Nobody named" />
            </div>
            @if (options.Departments.Any())
            {
                <div class="form-group">
                    <QMultiSelect TValue="Guid" TItem="AudienceDepartmentDto" SelectedValues="@form.ResponsibleDepartmentIds" SelectedValuesChanged="@(v => form.ResponsibleDepartmentIds = v.ToList())"
                                  Items="@options.Departments" ValueSelector="@(d => d.Id)" TextSelector="@(d => d.Name)" Sorted="true"
                                  Label="Responsible departments" Placeholder="No department" />
                </div>
            }
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@form.Description" Type="textarea" Rows="3" MaxLength="2000" Label="Notes" />
        </div>
        @if (canViewLibrary && organizationId != Guid.Empty)
        {
            <div class="form-group cal-attachment">
                <span class="cal-attachment__label">Document</span>
                @if (form.LibraryDocumentId.HasValue)
                {
                    <span class="cal-attachment__name"><QIcon Name="file-earmark-pdf" Size="sm" /> @(attachmentName ?? "A Library document")</span>
                    <QButton Text="Remove" Size="sm" Variant="ghost" OnClick="@(() => { form.LibraryDocumentId = null; attachmentName = null; })" />
                }
                else
                {
                    <QButton Text="Attach from the Library" Icon="paperclip" Size="sm" Variant="ghost" OnClick="@(() => showLibrary = true)" id="cal-ev-attach" />
                }
            </div>
        }
        <div class="cal-audience__row">
            <QCheckbox @bind-Value="@form.RemindersOn" Label="Remind them" Hint="The day before, and an hour before an event with a start time." />
            @if (NotifyApplies)
            {
                <QCheckbox @bind-Value="@form.NotifyAudience" Label="@NotifyLabel" id="cal-ev-notify" />
            }
        </div>
        @if (clash is { } c && (c.Teaching + c.OnDuty) > 0)
        {
            <div class="cal-clash" role="alert" id="cal-ev-clash">
                <QIcon Name="exclamation-triangle" Size="sm" />
                <span>
                    Of the @c.AudienceCount people, @ClashWords(c) then@(c.Examples.Count > 0 ? $" ({string.Join(", ", c.Examples)}{(c.Teaching + c.OnDuty > c.Examples.Count ? ", …" : "")})" : "").
                    @(c.LessonsKnown ? "" : "Lessons are only known two weeks ahead.") Save again to keep it anyway.
                </span>
            </div>
        }
        @if (formProblem != null)
        {
            <p class="form-error" role="alert">@formProblem</p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showEditor = false)" />
        <QButton Text="@(editingId.HasValue ? "Save changes" : "Add event")" Icon="check-lg" Variant="primary" Loading="@saving" OnClick="@SaveAsync" id="cal-ev-save" />
    </FooterContent>
</QModal>

<QLibraryPicker @bind-Visible="showLibrary" OrganizationId="@organizationId" OnlyType="null" Title="Attach a document" ConfirmText="Attach"
                OnPicked="@OnAttachmentPicked" />

@* ---- Cancel / put back on --------------------------------------------------------------------- *@
<QModal @bind-Visible="showStatus" Title="@(cancelling ? "Cancel this event?" : "Put this event back on?")" Icon="@(cancelling ? "x-octagon" : "arrow-counterclockwise")" Size="md">
    <ChildContent>
        <p>@(cancelling
               ? "It stays on the calendar, struck through, so nobody wonders whether they missed it. Its reminders stop."
               : "It goes back on the calendar and its reminders start again.")</p>
        @if (detail?.Recurrence != null)
        {
            <QRadioGroup TValue="string" Options="@EditScopeOptions" Value="@statusScope" ValueChanged="@(v => statusScope = v)" Legend="This event repeats. Apply to" Inline="true" />
        }
        @if (cancelling)
        {
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@cancelReason" Label="Reason" MaxLength="300" Placeholder="Postponed to next week because of the exams" id="cal-cancel-reason" />
            </div>
        }
        <QCheckbox @bind-Value="@statusNotify" Label="Tell the people it is for" id="cal-cancel-notify" />
    </ChildContent>
    <FooterContent>
        <QButton Text="Keep it as it is" Variant="ghost" OnClick="@(() => showStatus = false)" />
        <QButton Text="@(cancelling ? "Cancel event" : "Put it back on")" Icon="check-lg" Variant="@(cancelling ? "danger" : "primary")" Loading="@saving" OnClick="@ChangeStatusAsync" id="cal-cancel-confirm" />
    </FooterContent>
</QModal>

@* ---- Give it a register (E10) ----------------------------------------------------------------- *@
<QModal @bind-Visible="showRegister" Title="Give this event a register" Icon="clipboard-plus" Size="lg">
    <ChildContent>
        <p>It becomes a staff meeting whose attendance is taken, on the Duties page and on the day of everybody expected.</p>
        <QAudiencePicker Value="@registerExpected" ValueChanged="@(a => registerExpected = a)" Options="@options" Label="Who is expected" />
        <div class="form-group">
            <QMultiSelect TValue="Guid" TItem="AudienceMemberDto" SelectedValues="@registerRecorders" SelectedValuesChanged="@(v => registerRecorders = v.ToList())"
                          Items="@options.People" ValueSelector="@(s => s.UserId)" TextSelector="@(s => s.FullName)" Required="true"
                          Label="Who takes the register" Placeholder="Choose at least one person"
                          HasError="@(registerProblem != null && registerRecorders.Count == 0)" ErrorMessage="@(registerRecorders.Count == 0 ? registerProblem : null)" />
        </div>
        @if (string.IsNullOrWhiteSpace(detail?.StartTime))
        {
            <div class="form-row">
                <div class="form-group">
                    <QDatePicker @bind-Value="@registerStart" ShowTime="true" Label="Starts" Required="true" />
                </div>
                <div class="form-group">
                    <QDatePicker @bind-Value="@registerEnd" ShowTime="true" Label="Ends" Clearable="true" Placeholder="An hour later" />
                </div>
            </div>
        }
        <QCheckbox @bind-Value="@registerNotify" Label="Tell the people expected" />
        @if (registerProblem != null && registerRecorders.Count > 0) { <p class="form-error" role="alert">@registerProblem</p> }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showRegister = false)" />
        <QButton Text="Give it a register" Icon="check-lg" Variant="primary" Loading="@saving" OnClick="@GiveRegisterAsync" id="cal-register-confirm" />
    </FooterContent>
</QModal>

