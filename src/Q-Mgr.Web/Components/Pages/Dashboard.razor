@page "/"
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@implements IDisposable
@inject IQueueApiService QueueApi
@inject ISignalRService SignalR
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject IModuleStateService ModuleState
@inject IModuleApiService ModuleApi
@inject NavigationManager Navigation
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions JsonOptions

<PageTitle>Dashboard - Q-Mgr</PageTitle>

<!-- Page Header -->
<div class="page-header">
    <div class="header-left">
        <h1>Dashboard</h1>
        <div class="breadcrumb">
            <span>@dashboardSubtitle</span>
        </div>
    </div>
    <div class="header-right">
        @if (lastUpdated != default)
        {
            <span class="last-updated">Last updated: @lastUpdated.ToString("HH:mm:ss")</span>
        }
        <QButton Icon="arrow-clockwise" Text="Refresh" Variant="secondary" OnClick="@RefreshData" Disabled="@isLoading" />
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner">
        <QIcon Name="exclamation-triangle-fill" />
        <span>@errorMessage</span>
        <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@RefreshData" />
    </div>
}

@if (isLoading)
{
    <!-- Loading State -->
    <div class="loading-overlay" style="position: relative; min-height: 400px; background: transparent;">
        <div class="webster-spinner"></div>
        <span class="loading-text">Loading dashboard data...</span>
    </div>
}
else if (!BranchState.HasBranches)
{
    <!-- No Branches Exist - Getting Started -->
    <div class="welcome-container">
        <div class="welcome-content">
            <div class="welcome-icon">
                <QIcon Name="rocket-takeoff-fill" />
            </div>
            <h2>Welcome to Q-Mgr!</h2>
            <p class="welcome-message">
                Your queue management system is ready. To get started, you'll need to set up your first branch location.
            </p>
            <div class="welcome-steps">
                <div class="step-item">
                    <span class="step-number">1</span>
                    <div class="step-content">
                        <strong>Create a Branch</strong>
                        <span>Set up your first service location</span>
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">2</span>
                    <div class="step-content">
                        <strong>Add Service Types</strong>
                        <span>Define the services you offer</span>
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">3</span>
                    <div class="step-content">
                        <strong>Configure Counters</strong>
                        <span>Set up service counters</span>
                    </div>
                </div>
            </div>
            <div class="welcome-action">
                <QButton Text="Create First Branch" Icon="plus-lg" OnClick="@NavigateToBranches" />
            </div>
        </div>
    </div>
}
else if (noBranchSelected)
{
    <!-- Branches Exist but None Selected -->
    <div class="welcome-container">
        <div class="welcome-content">
            <div class="welcome-icon select-branch">
                <QIcon Name="building-fill" />
            </div>
            <h2>Select a Branch</h2>
            <p class="welcome-message">
                Please select a branch to view the dashboard. Use the branch selector at the bottom of the sidebar to choose your active location.
            </p>
            <div class="welcome-hint">
                <QIcon Name="arrow-down-left" />
                <span>Click on the branch selector in the sidebar footer</span>
            </div>
        </div>
    </div>
}
else if (!hasCoreQueue && !hasStudentWelfare && !hasVisitorManagement && !hasEngagement)
{
    @* Only when the organization holds nothing this dashboard can report on. It used to be shown
       to anyone without Core Queue Management, so a school that had bought Student Welfare opened
       on an advert for a module they had deliberately not bought. *@
    <div class="module-empty">
        <div class="module-empty-icon"><QIcon Name="grid-3x3-gap-fill" /></div>
        <h2>Nothing to show here yet</h2>
        <p>
            Your dashboard fills in as you add modules — waiting lists and counters from Core Queue
            Management, welfare actions from Student Welfare, and so on.
        </p>
        <div class="module-empty-actions">
            <QButton Text="Browse modules" Icon="grid-3x3-gap-fill" Variant="primary" OnClick="@(() => Navigation.NavigateTo("/billing/modules"))" />
        </div>
        @if (activeModuleNames.Any())
        {
            <p class="module-empty-note">
                Your active modules: @string.Join(", ", activeModuleNames). Use the sidebar to open them.
            </p>
        }
    </div>
}
else if (hasCoreQueue && queueStatus != null)
{
    <!-- Statistics Cards -->
    <div class="stats-row">
        <a class="stats-card primary" href="@QueueLiveHref">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalWaiting</span>
                    <span class="stats-label">Waiting in Queue</span>
                    <span class="stats-change neutral">
                        <QIcon Name="grid-fill" /> Across @queueStatus.ServiceTypes.Count(st => st.WaitingCount > 0) service type@(queueStatus.ServiceTypes.Count(st => st.WaitingCount > 0) == 1 ? "" : "s")
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="hourglass-split" />
                </div>
            </div>
        </a>

        <a class="stats-card success" href="@QueueLiveHref">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalServing</span>
                    <span class="stats-label">Being Served Now</span>
                    <span class="stats-change positive">
                        <QIcon Name="person-fill" /> Active customers
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="headset" />
                </div>
            </div>
        </a>

        <a class="stats-card warning" href="@QueueAnalyticsHref">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.AverageWaitMinutes.ToString("F0")<small>min</small></span>
                    <span class="stats-label">Average Wait Time</span>
                    <span class="stats-change neutral">
                        <QIcon Name="clock-fill" /> Avg service: @queueStatus.Summary.AverageServiceMinutes.ToString("F0") min
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="stopwatch-fill" />
                </div>
            </div>
        </a>

        <a class="stats-card danger" href="@QueueAnalyticsHref">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalCompletedToday</span>
                    <span class="stats-label">Completed Today</span>
                    @{
                        var totalToday = queueStatus.Summary.TotalCompletedToday + queueStatus.Summary.TotalWaiting + queueStatus.Summary.TotalServing;
                        var clearedPct = totalToday > 0 ? (int)Math.Round(100.0 * queueStatus.Summary.TotalCompletedToday / totalToday) : 0;
                    }
                    <span class="stats-change @(totalToday == 0 ? "neutral" : "positive")">
                        <QIcon Name="check-circle-fill" /> @(totalToday == 0 ? "No activity yet today" : $"{clearedPct}% of today's queue cleared")
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="check2-all" />
                </div>
            </div>
        </a>
    </div>

    <!-- Main Content Grid -->
    <div class="dashboard-grid">
        <!-- Now Serving Panel -->
        <QCard Class="now-serving-card" Title="Now Serving" Icon="bell-fill">
            <HeaderActions>
                <span class="live-badge">
                    <span class="live-dot"></span> LIVE
                </span>
            </HeaderActions>
            <ChildContent>
                @if (queueStatus.Counters.Any(c => c.Status == "Active" && !string.IsNullOrEmpty(c.CurrentTokenDisplay)))
                {
                    <div class="now-serving-list">
                        @foreach (var counter in queueStatus.Counters.Where(c => c.Status == "Active" && !string.IsNullOrEmpty(c.CurrentTokenDisplay)))
                        {
                            <div class="now-serving-item">
                                <div class="token-display serving">@counter.CurrentTokenDisplay</div>
                                <div class="counter-info">
                                    <span class="counter-name">Counter @counter.CounterNumber</span>
                                    <span class="counter-agent">@(counter.ServingCustomerName ?? "Customer")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-serving">
                        <QIcon Name="cup-hot-fill" Size="xl" />
                        <span>No customers being served</span>
                    </div>
                }
            </ChildContent>
        </QCard>

        <!-- Queue by Service Type -->
        <QCard Class="service-types-card" Title="Service Types" Icon="grid-fill">
            <HeaderActions>
                <QButton Text="View All" Icon="list-ul" Variant="ghost" Size="sm" />
            </HeaderActions>
            <ChildContent>
                <RadzenDataGrid Data="@queueStatus.ServiceTypes" TItem="ServiceTypeQueueDto"
                                AllowSorting="true" class="service-types-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="Name" Title="Service" Width="180px">
                            <Template Context="item">
                                <div class="service-cell">
                                    <span class="service-code" style="background: @GetServiceColor(item.Code)">@item.Code</span>
                                    <span class="service-name">@item.Name</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="WaitingCount" Title="Queue" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="queue-badge">@item.WaitingCount</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="EstimatedWaitMinutes" Title="Wait" Width="90px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="wait-time">@item.EstimatedWaitMinutes min</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="CountersActive" Title="Counters" Width="120px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="counter-count">@item.CountersActive active</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </QCard>

        <!-- Counter Status -->
        <QCard Class="counters-card" Title="Counter Status" Icon="shop">
            <HeaderActions>
                <QButton Text="Manage" Icon="gear-fill" Variant="ghost" Size="sm" />
            </HeaderActions>
            <ChildContent>
                <div class="counters-grid">
                    @foreach (var counter in queueStatus.Counters)
                    {
                        <div class="counter-card @GetCounterStatusClass(counter.Status)">
                            <div class="counter-header">
                                <span class="counter-number">Counter @counter.CounterNumber</span>
                                <QBadge Variant="@GetCounterStatusVariant(counter.Status)" Text="@counter.Status" Size="sm" Class="counter-status-badge-solid" />
                            </div>
                            <div class="counter-body">
                                @if (!string.IsNullOrEmpty(counter.CurrentTokenDisplay))
                                {
                                    <span class="current-token">@counter.CurrentTokenDisplay</span>
                                }
                                else
                                {
                                    <span class="no-token">--</span>
                                }
                            </div>
                            <div class="counter-footer">
                                <span class="served-count">@counter.TokensServedToday served today</span>
                            </div>
                        </div>
                    }
                </div>
            </ChildContent>
        </QCard>

        <!-- Quick Actions -->
        <QCard Class="quick-actions-card" Title="Quick Actions" Icon="lightning-fill">
            <div class="quick-actions-grid">
                <button class="quick-action-btn" @onclick="OpenKiosk">
                    <QIcon Name="hand-index-fill" />
                    <span>Open Kiosk</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenCounterTerminal">
                    <QIcon Name="shop" />
                    <span>Counter Terminal</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenCustomerDisplay">
                    <QIcon Name="tv-fill" />
                    <span>Customer Display</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenReports">
                    <QIcon Name="bar-chart-fill" />
                    <span>View Reports</span>
                </button>
            </div>
        </QCard>
    </div>
}

@* Module sections. The dashboard is a composition now, not the queue dashboard with an apology
   for everyone else: each module an organization holds contributes its own panel, so a school
   holding only Student Welfare opens on overdue actions rather than on an advert. Sections sit
   outside the branch/queue chain above so they render whichever of those branches ran. *@
@if (branchReady && hasStudentWelfare)
{
    <div class="module-section">
        <div class="module-section-head">
            <h2><QIcon Name="mortarboard-fill" /> Student Welfare</h2>
            <QButton Text="Open ledger" Icon="arrow-right" Variant="ghost" Size="sm"
                     OnClick="@(() => Navigation.NavigateTo("/admin/welfare-my-actions"))" />
        </div>

        @if (welfareSummary == null)
        {
            <div class="module-section-loading"><QSpinner Size="sm" /></div>
        }
        else
        {
            <div class="stats-row">
                <a class="stats-card primary" href="@WelfareOpenHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@welfareSummary.OpenActionsCount</span>
                            <span class="stats-label">Open actions</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="clipboard-check" /></div>
                    </div>
                </a>
                <a class="stats-card @(welfareSummary.OverdueActionsCount > 0 ? "danger" : "secondary")" href="@WelfareOverdueHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@welfareSummary.OverdueActionsCount</span>
                            <span class="stats-label">Overdue</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="exclamation-triangle-fill" /></div>
                    </div>
                </a>
                <a class="stats-card secondary" href="@WelfareRecordsHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@welfareSummary.TotalRecords</span>
                            <span class="stats-label">Records</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="journal-text" /></div>
                    </div>
                </a>
                <a class="stats-card secondary" href="@RosterHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@studentCount</span>
                            <span class="stats-label">Students</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="people-fill" /></div>
                    </div>
                </a>
            </div>

            @if (welfareSummary.ByCategory.Any())
            {
                <QCard Title="By category" Icon="tags-fill">
                    <div class="welfare-category-list">
                        @foreach (var c in welfareSummary.ByCategory.OrderByDescending(c => c.Count).Take(6))
                        {
                            <div class="welfare-category-row">
                                <span class="welfare-category-name">@c.CategoryName</span>
                                <span class="welfare-category-count">@c.Count</span>
                            </div>
                        }
                    </div>
                </QCard>
            }
            else
            {
                <QCard>
                    <p class="module-section-empty">
                        No welfare records yet. Add students to the roster, then log achievements,
                        behaviour or safeguarding concerns against them.
                    </p>
                </QCard>
            }
        }
    </div>
}

@if (branchReady && hasVisitorManagement)
{
    <div class="module-section">
        <div class="module-section-head">
            <h2><QIcon Name="person-badge-fill" /> Visitor Management</h2>
            <QButton Text="Open desk" Icon="arrow-right" Variant="ghost" Size="sm"
                     OnClick="@(() => Navigation.NavigateTo("/admin/visitors"))" />
        </div>

        @if (visitorSummary == null)
        {
            <div class="module-section-loading"><QSpinner Size="sm" /></div>
        }
        else
        {
            <div class="stats-row">
                <a class="stats-card primary" href="@VisitorDeskHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@visitorSummary.CurrentlyOnSite</span>
                            <span class="stats-label">On site now</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="person-check-fill" /></div>
                    </div>
                </a>
                <a class="stats-card secondary" href="@VisitorExpectedHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@visitorSummary.ExpectedToday</span>
                            <span class="stats-label">Still expected</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="calendar-check-fill" /></div>
                    </div>
                </a>
                <a class="stats-card secondary" href="@VisitorReportHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@visitorSummary.TotalToday</span>
                            <span class="stats-label">Today</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="door-open-fill" /></div>
                    </div>
                </a>
                @* A watchlisted person on site is the one number here that asks somebody to act,
                   so it takes the danger stripe rather than looking like the others. *@
                <a class="stats-card @(visitorSummary.WatchlistedOnSite > 0 ? "danger" : "secondary")" href="@VisitorDeskHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@visitorSummary.WatchlistedOnSite</span>
                            <span class="stats-label">Watchlisted on site</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="shield-exclamation" /></div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@if (branchReady && hasEngagement)
{
    <div class="module-section">
        <div class="module-section-head">
            <h2><QIcon Name="broadcast" /> Engagement &amp; Communications</h2>
            <QButton Text="Open campaigns" Icon="arrow-right" Variant="ghost" Size="sm"
                     OnClick="@(() => Navigation.NavigateTo("/content/campaigns"))" />
        </div>

        @if (feedbackSummary == null)
        {
            <div class="module-section-loading"><QSpinner Size="sm" /></div>
        }
        else
        {
            <div class="stats-row">
                <a class="stats-card primary" href="@CampaignsHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@activeCampaignCount</span>
                            <span class="stats-label">Live campaigns</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="megaphone-fill" /></div>
                    </div>
                </a>
                <a class="stats-card success" href="@FeedbackReportHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@(feedbackSummary.TotalFeedbacks == 0 ? "—" : feedbackSummary.AverageRating.ToString("0.0"))</span>
                            <span class="stats-label">Average rating</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="star-fill" /></div>
                    </div>
                </a>
                <a class="stats-card secondary" href="@FeedbackReportHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@feedbackSummary.TotalFeedbacks</span>
                            <span class="stats-label">Responses</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="chat-square-text-fill" /></div>
                    </div>
                </a>
                <a class="stats-card @(feedbackSummary.PendingResponseCount > 0 ? "warning" : "secondary")" href="@FeedbackInboxHref">
                    <div class="stats-content">
                        <div class="stats-info">
                            <span class="stats-number">@feedbackSummary.PendingResponseCount</span>
                            <span class="stats-label">Awaiting reply</span>
                        </div>
                        <div class="stats-icon"><QIcon Name="reply-fill" /></div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .module-section { margin-top: 28px; }

    .module-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
    }

    .module-section-head h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-family: var(--qm-font-display);
        font-size: 20px;
        font-weight: 700;
        color: var(--qm-text-primary);
    }

    .module-section-loading { padding: 24px; text-align: center; }

    .module-section-empty {
        margin: 0;
        color: var(--qm-text-secondary);
        font-size: 14px;
    }


    .welfare-category-list { display: flex; flex-direction: column; }

    .welfare-category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--qm-border);
        font-size: 14px;
    }

    .welfare-category-row:last-child { border-bottom: none; }
    .welfare-category-name { color: var(--qm-text-primary); }
    .welfare-category-count { font-weight: 600; color: var(--qm-text-primary); font-variant-numeric: tabular-nums; }
</style>

<style>
    .module-empty {
        max-width: 620px;
        margin: 48px auto;
        padding: 40px 32px;
        text-align: center;
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
    }

    .module-empty-icon {
        font-size: 40px;
        line-height: 1;
        color: var(--qm-primary);
        margin-bottom: 16px;
    }

    .module-empty h2 {
        font-family: var(--qm-font-display);
        font-size: 22px;
        color: var(--qm-text-primary);
        margin: 0 0 12px 0;
    }

    .module-empty p {
        color: var(--qm-text-secondary);
        line-height: 1.6;
        margin: 0 0 20px 0;
    }

    .module-empty-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .module-empty-note {
        margin-top: 20px !important;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .last-updated {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: color-mix(in srgb, var(--qm-danger) 15%, transparent);
        border: 1px solid var(--qm-danger);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 24px;
        color: var(--qm-danger);
    }

    .error-banner .rzi {
        font-size: 24px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        margin-bottom: 24px;
    }

    /* Every stat tile is an anchor. One without a destination — because this account can't open
       the page behind it — has no href, which makes it inert and unfocusable by the browser's own
       rules, exactly the old behaviour. The shared .stats-card already lifts on hover, so that
       lift is cancelled here for the inert ones rather than promising a click that does nothing. */
    a.stats-card {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    a.stats-card:not([href]) {
        cursor: default;
    }

    a.stats-card:not([href]):hover {
        box-shadow: var(--qm-shadow-sm);
        border-color: var(--qm-border);
        transform: none;
    }

    a.stats-card:not([href]):hover::after { opacity: 0; }

    a.stats-card:focus-visible {
        outline: 3px solid var(--qm-primary);
        outline-offset: 3px;
    }

    .stats-card .stats-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stats-card .stats-info {
        display: flex;
        flex-direction: column;
    }

    .stats-card .stats-number small {
        font-size: 16px;
        font-weight: 500;
        margin-left: 4px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .dashboard-card {
        background: var(--qm-bg-card);
