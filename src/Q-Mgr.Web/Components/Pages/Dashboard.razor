@page "/"
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@implements IDisposable
@inject IQueueApiService QueueApi
@inject ISignalRService SignalR
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject IModuleStateService ModuleState
@inject IModuleApiService ModuleApi
@inject NavigationManager Navigation
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions JsonOptions

<PageTitle>Dashboard - Q-Mgr</PageTitle>

<!-- Page Header -->
<div class="page-header">
    <div class="header-left">
        <h1>Dashboard</h1>
        <div class="breadcrumb">
            <span>@dashboardSubtitle</span>
        </div>
    </div>
    <div class="header-right">
        @if (lastUpdated != default)
        {
            <span class="last-updated">Last updated: @lastUpdated.ToString("HH:mm:ss")</span>
        }
        <QButton Icon="arrow-clockwise" Text="Refresh" Variant="secondary" OnClick="@RefreshData" Disabled="@isLoading" />
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner">
        <QIcon Name="exclamation-triangle-fill" />
        <span>@errorMessage</span>
        <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@RefreshData" />
    </div>
}

@if (isLoading)
{
    <!-- Loading State -->
    <div class="loading-overlay" style="position: relative; min-height: 400px; background: transparent;">
        <div class="webster-spinner"></div>
        <span class="loading-text">Loading dashboard data...</span>
    </div>
}
else if (!BranchState.HasBranches)
{
    <!-- No Branches Exist - Getting Started -->
    <div class="welcome-container">
        <div class="welcome-content">
            <div class="welcome-icon">
                <QIcon Name="rocket-takeoff-fill" />
            </div>
            <h2>Welcome to Q-Mgr!</h2>
            <p class="welcome-message">
                Your queue management system is ready. To get started, you'll need to set up your first branch location.
            </p>
            <div class="welcome-steps">
                <div class="step-item">
                    <span class="step-number">1</span>
                    <div class="step-content">
                        <strong>Create a Branch</strong>
                        <span>Set up your first service location</span>
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">2</span>
                    <div class="step-content">
                        <strong>Add Service Types</strong>
                        <span>Define the services you offer</span>
                    </div>
                </div>
                <div class="step-item">
                    <span class="step-number">3</span>
                    <div class="step-content">
                        <strong>Configure Counters</strong>
                        <span>Set up service counters</span>
                    </div>
                </div>
            </div>
            <div class="welcome-action">
                <QButton Text="Create First Branch" Icon="plus-lg" OnClick="@NavigateToBranches" />
            </div>
        </div>
    </div>
}
else if (noBranchSelected)
{
    <!-- Branches Exist but None Selected -->
    <div class="welcome-container">
        <div class="welcome-content">
            <div class="welcome-icon select-branch">
                <QIcon Name="building-fill" />
            </div>
            <h2>Select a Branch</h2>
            <p class="welcome-message">
                Please select a branch to view the dashboard. Use the branch selector at the bottom of the sidebar to choose your active location.
            </p>
            <div class="welcome-hint">
                <QIcon Name="arrow-down-left" />
                <span>Click on the branch selector in the sidebar footer</span>
            </div>
        </div>
    </div>
}
else if (!hasCoreQueue && !hasStudentWelfare)
{
    @* Only when the organization holds nothing this dashboard can report on. It used to be shown
       to anyone without Core Queue Management, so a school that had bought Student Welfare opened
       on an advert for a module they had deliberately not bought. *@
    <div class="module-empty">
        <div class="module-empty-icon"><QIcon Name="grid-3x3-gap-fill" /></div>
        <h2>Nothing to show here yet</h2>
        <p>
            Your dashboard fills in as you add modules — waiting lists and counters from Core Queue
            Management, welfare actions from Student Welfare, and so on.
        </p>
        <div class="module-empty-actions">
            <QButton Text="Browse modules" Icon="grid-3x3-gap-fill" Variant="primary" OnClick="@(() => Navigation.NavigateTo("/billing/modules"))" />
        </div>
        @if (activeModuleNames.Any())
        {
            <p class="module-empty-note">
                Your active modules: @string.Join(", ", activeModuleNames). Use the sidebar to open them.
            </p>
        }
    </div>
}
else if (hasCoreQueue && queueStatus != null)
{
    <!-- Statistics Cards -->
    <div class="stats-row">
        <div class="stats-card primary">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalWaiting</span>
                    <span class="stats-label">Waiting in Queue</span>
                    <span class="stats-change neutral">
                        <QIcon Name="grid-fill" /> Across @queueStatus.ServiceTypes.Count(st => st.WaitingCount > 0) service type@(queueStatus.ServiceTypes.Count(st => st.WaitingCount > 0) == 1 ? "" : "s")
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="hourglass-split" />
                </div>
            </div>
        </div>

        <div class="stats-card success">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalServing</span>
                    <span class="stats-label">Being Served Now</span>
                    <span class="stats-change positive">
                        <QIcon Name="person-fill" /> Active customers
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="headset" />
                </div>
            </div>
        </div>

        <div class="stats-card warning">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.AverageWaitMinutes.ToString("F0")<small>min</small></span>
                    <span class="stats-label">Average Wait Time</span>
                    <span class="stats-change neutral">
                        <QIcon Name="clock-fill" /> Avg service: @queueStatus.Summary.AverageServiceMinutes.ToString("F0") min
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="stopwatch-fill" />
                </div>
            </div>
        </div>

        <div class="stats-card danger">
            <div class="stats-content">
                <div class="stats-info">
                    <span class="stats-number">@queueStatus.Summary.TotalCompletedToday</span>
                    <span class="stats-label">Completed Today</span>
                    @{
                        var totalToday = queueStatus.Summary.TotalCompletedToday + queueStatus.Summary.TotalWaiting + queueStatus.Summary.TotalServing;
                        var clearedPct = totalToday > 0 ? (int)Math.Round(100.0 * queueStatus.Summary.TotalCompletedToday / totalToday) : 0;
                    }
                    <span class="stats-change @(totalToday == 0 ? "neutral" : "positive")">
                        <QIcon Name="check-circle-fill" /> @(totalToday == 0 ? "No activity yet today" : $"{clearedPct}% of today's queue cleared")
                    </span>
                </div>
                <div class="stats-icon">
                    <QIcon Name="check2-all" />
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="dashboard-grid">
        <!-- Now Serving Panel -->
        <QCard Class="now-serving-card" Title="Now Serving" Icon="bell-fill">
            <HeaderActions>
                <span class="live-badge">
                    <span class="live-dot"></span> LIVE
                </span>
            </HeaderActions>
            <ChildContent>
                @if (queueStatus.Counters.Any(c => c.Status == "Active" && !string.IsNullOrEmpty(c.CurrentTokenDisplay)))
                {
                    <div class="now-serving-list">
                        @foreach (var counter in queueStatus.Counters.Where(c => c.Status == "Active" && !string.IsNullOrEmpty(c.CurrentTokenDisplay)))
                        {
                            <div class="now-serving-item">
                                <div class="token-display serving">@counter.CurrentTokenDisplay</div>
                                <div class="counter-info">
                                    <span class="counter-name">Counter @counter.CounterNumber</span>
                                    <span class="counter-agent">@(counter.ServingCustomerName ?? "Customer")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-serving">
                        <QIcon Name="cup-hot-fill" Size="xl" />
                        <span>No customers being served</span>
                    </div>
                }
            </ChildContent>
        </QCard>

        <!-- Queue by Service Type -->
        <QCard Class="service-types-card" Title="Service Types" Icon="grid-fill">
            <HeaderActions>
                <QButton Text="View All" Icon="list-ul" Variant="ghost" Size="sm" />
            </HeaderActions>
            <ChildContent>
                <RadzenDataGrid Data="@queueStatus.ServiceTypes" TItem="ServiceTypeQueueDto"
                                AllowSorting="true" class="service-types-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="Name" Title="Service" Width="auto">
                            <Template Context="item">
                                <div class="service-cell">
                                    <span class="service-code" style="background: @GetServiceColor(item.Code)">@item.Code</span>
                                    <span class="service-name">@item.Name</span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="WaitingCount" Title="Queue" Width="80px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="queue-badge">@item.WaitingCount</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="EstimatedWaitMinutes" Title="Wait" Width="80px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="wait-time">@item.EstimatedWaitMinutes min</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeQueueDto" Property="CountersActive" Title="Counters" Width="100px" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="counter-count">@item.CountersActive active</span>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </ChildContent>
        </QCard>

        <!-- Counter Status -->
        <QCard Class="counters-card" Title="Counter Status" Icon="shop">
            <HeaderActions>
                <QButton Text="Manage" Icon="gear-fill" Variant="ghost" Size="sm" />
            </HeaderActions>
            <ChildContent>
                <div class="counters-grid">
                    @foreach (var counter in queueStatus.Counters)
                    {
                        <div class="counter-card @GetCounterStatusClass(counter.Status)">
                            <div class="counter-header">
                                <span class="counter-number">Counter @counter.CounterNumber</span>
                                <QBadge Variant="@GetCounterStatusVariant(counter.Status)" Text="@counter.Status" Size="sm" Class="counter-status-badge-solid" />
                            </div>
                            <div class="counter-body">
                                @if (!string.IsNullOrEmpty(counter.CurrentTokenDisplay))
                                {
                                    <span class="current-token">@counter.CurrentTokenDisplay</span>
                                }
                                else
                                {
                                    <span class="no-token">--</span>
                                }
                            </div>
                            <div class="counter-footer">
                                <span class="served-count">@counter.TokensServedToday served today</span>
                            </div>
                        </div>
                    }
                </div>
            </ChildContent>
        </QCard>

        <!-- Quick Actions -->
        <QCard Class="quick-actions-card" Title="Quick Actions" Icon="lightning-fill">
            <div class="quick-actions-grid">
                <button class="quick-action-btn" @onclick="OpenKiosk">
                    <QIcon Name="hand-index-fill" />
                    <span>Open Kiosk</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenCounterTerminal">
                    <QIcon Name="shop" />
                    <span>Counter Terminal</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenCustomerDisplay">
                    <QIcon Name="tv-fill" />
                    <span>Customer Display</span>
                </button>
                <button class="quick-action-btn" @onclick="OpenReports">
                    <QIcon Name="bar-chart-fill" />
                    <span>View Reports</span>
                </button>
            </div>
        </QCard>
    </div>
}

@* Module sections. The dashboard is a composition now, not the queue dashboard with an apology
   for everyone else: each module an organization holds contributes its own panel, so a school
   holding only Student Welfare opens on overdue actions rather than on an advert. Sections sit
   outside the branch/queue chain above so they render whichever of those branches ran. *@
@if (branchReady && hasStudentWelfare)
{
    <div class="module-section">
        <div class="module-section-head">
            <h2><QIcon Name="mortarboard-fill" /> Student Welfare</h2>
            <QButton Text="Open ledger" Icon="arrow-right" Variant="ghost" Size="sm"
                     OnClick="@(() => Navigation.NavigateTo("/admin/welfare-open-actions"))" />
        </div>

        @if (welfareSummary == null)
        {
            <div class="module-section-loading"><QSpinner Size="sm" /></div>
        }
        else
        {
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon welfare-open"><QIcon Name="clipboard-check" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@welfareSummary.OpenActionsCount</div>
                        <div class="stat-label">Open actions</div>
                    </div>
                </div>
                <div class="stat-card @(welfareSummary.OverdueActionsCount > 0 ? "needs-attention" : "")">
                    <div class="stat-icon welfare-overdue"><QIcon Name="exclamation-triangle-fill" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@welfareSummary.OverdueActionsCount</div>
                        <div class="stat-label">Overdue</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon welfare-records"><QIcon Name="journal-text" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@welfareSummary.TotalRecords</div>
                        <div class="stat-label">Records</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon welfare-students"><QIcon Name="people-fill" /></div>
                    <div class="stat-content">
                        <div class="stat-value">@studentCount</div>
                        <div class="stat-label">Students</div>
                    </div>
                </div>
            </div>

            @if (welfareSummary.ByCategory.Any())
            {
                <QCard Title="By category" Icon="tags-fill">
                    <div class="welfare-category-list">
                        @foreach (var c in welfareSummary.ByCategory.OrderByDescending(c => c.Count).Take(6))
                        {
                            <div class="welfare-category-row">
                                <span class="welfare-category-name">@c.CategoryName</span>
                                <span class="welfare-category-count">@c.Count</span>
                            </div>
                        }
                    </div>
                </QCard>
            }
            else
            {
                <QCard>
                    <p class="module-section-empty">
                        No welfare records yet. Add students to the roster, then log achievements,
                        behaviour or safeguarding concerns against them.
                    </p>
                </QCard>
            }
        }
    </div>
}

<style>
    .module-section { margin-top: 28px; }

    .module-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
    }

    .module-section-head h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-family: var(--qm-font-display);
        font-size: 20px;
        font-weight: 700;
        color: var(--qm-text-primary);
    }

    .module-section-loading { padding: 24px; text-align: center; }

    .module-section-empty {
        margin: 0;
        color: var(--qm-text-secondary);
        font-size: 14px;
    }

    .stat-card.needs-attention { border-color: var(--qm-danger); }

    .stat-icon.welfare-open { background: var(--qm-primary-light); color: var(--qm-primary); }
    .stat-icon.welfare-overdue { background: var(--qm-danger-light, #f8e6e1); color: var(--qm-danger); }
    .stat-icon.welfare-records { background: var(--qm-bg-elevated); color: var(--qm-text-secondary); }
    .stat-icon.welfare-students { background: var(--qm-bg-elevated); color: var(--qm-text-secondary); }

    .welfare-category-list { display: flex; flex-direction: column; }

    .welfare-category-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--qm-border);
        font-size: 14px;
    }

    .welfare-category-row:last-child { border-bottom: none; }
    .welfare-category-name { color: var(--qm-text-primary); }
    .welfare-category-count { font-weight: 600; color: var(--qm-text-primary); font-variant-numeric: tabular-nums; }
</style>

<style>
    .module-empty {
        max-width: 620px;
        margin: 48px auto;
        padding: 40px 32px;
        text-align: center;
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
    }

    .module-empty-icon {
        font-size: 40px;
        line-height: 1;
        color: var(--qm-primary);
        margin-bottom: 16px;
    }

    .module-empty h2 {
        font-family: var(--qm-font-display);
        font-size: 22px;
        color: var(--qm-text-primary);
        margin: 0 0 12px 0;
    }

    .module-empty p {
        color: var(--qm-text-secondary);
        line-height: 1.6;
        margin: 0 0 20px 0;
    }

    .module-empty-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .module-empty-note {
        margin-top: 20px !important;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .last-updated {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: color-mix(in srgb, var(--qm-danger) 15%, transparent);
        border: 1px solid var(--qm-danger);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 24px;
        color: var(--qm-danger);
    }

    .error-banner .rzi {
        font-size: 24px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        margin-bottom: 24px;
    }

    .stats-card .stats-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stats-card .stats-info {
        display: flex;
        flex-direction: column;
    }

    .stats-card .stats-number small {
        font-size: 16px;
        font-weight: 500;
        margin-left: 4px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .dashboard-card {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
        box-shadow: var(--qm-shadow-sm);
        overflow: hidden;
    }

    .dashboard-card .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--qm-border);
    }

    .dashboard-card .card-header h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        color: var(--qm-text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dashboard-card .card-header h3 .rz-icon {
        color: var(--qm-primary);
    }

    .dashboard-card .card-body {
        padding: 20px;
    }

    /* Now Serving Card */
    .now-serving-card {
        grid-column: span 1;
    }

    .live-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        background: var(--qm-danger);
        color: var(--qm-text-on-primary);
        border-radius: var(--qm-radius-full);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .live-dot {
        width: 8px;
        height: 8px;
        background: var(--qm-text-on-primary);
        border-radius: 50%;
        animation: pulse 1s infinite;
    }

    .now-serving-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .now-serving-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px;
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
    }

    .counter-info {
        display: flex;
        flex-direction: column;
    }

    .counter-name {
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .counter-agent {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .no-serving {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        color: var(--qm-text-muted);
    }

    .no-serving .rz-icon {
        font-size: 48px;
        margin-bottom: 12px;
        color: var(--qm-border);
    }

    /* Service Types */
    .service-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .service-code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: var(--qm-radius-lg);
        font-size: 12px;
        font-weight: 600;
        color: var(--qm-text-on-primary);
    }

    .service-name {
        font-weight: 500;
        color: var(--qm-text-primary);
    }

    .queue-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 28px;
        background: var(--qm-primary);
        color: var(--qm-text-on-primary);
        border-radius: var(--qm-radius-full);
        font-weight: 600;
        font-size: 13px;
    }

    .wait-time {
        color: var(--qm-text-muted);
        font-size: 13px;
    }

    .counter-count {
        color: var(--qm-success);
        font-size: 13px;
        font-weight: 500;
    }

    /* Counter Status Grid */
    .counters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 16px;
    }

    .counter-card {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        padding: 16px;
        text-align: center;
        border-left: 4px solid var(--qm-border);
        transition: all 0.3s ease;
    }

    .counter-card:hover {
        box-shadow: var(--qm-shadow-md);
    }

    .counter-card.active {
        border-left-color: var(--qm-success);
        background: linear-gradient(135deg, color-mix(in srgb, var(--qm-success) 5%, transparent) 0%, var(--qm-bg-elevated) 100%);
    }

    .counter-card.onbreak {
        border-left-color: var(--qm-warning);
        background: linear-gradient(135deg, color-mix(in srgb, var(--qm-warning) 5%, transparent) 0%, var(--qm-bg-elevated) 100%);
    }

    .counter-card.inactive, .counter-card.closed {
        border-left-color: var(--qm-text-muted);
        opacity: 0.7;
    }

    .counter-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .counter-number {
        font-size: 13px;
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    /* Solid-fill override on top of QBadge's own (translucent-tint) variant colors —
       this dashboard widget deliberately uses solid backgrounds, not QBadge's default. */
    .counter-status-badge-solid.q-badge--success {
        background: var(--qm-success);
        color: var(--qm-text-on-primary);
    }

    .counter-status-badge-solid.q-badge--warning {
        background: var(--qm-warning);
        color: var(--qm-text-dark);
    }

    .counter-status-badge-solid.q-badge--secondary {
        background: var(--qm-text-muted);
        color: var(--qm-text-on-primary);
    }

    .counter-body {
        margin: 16px 0;
    }

    .current-token {
        font-size: 28px;
        font-weight: 700;
        color: var(--qm-primary);
    }

    .no-token {
        font-size: 28px;
        font-weight: 300;
        color: var(--qm-text-muted);
    }

    .counter-footer {
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    /* Quick Actions */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .quick-action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 20px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .quick-action-btn:hover {
        border-color: var(--qm-primary);
        background: linear-gradient(135deg, color-mix(in srgb, var(--qm-primary) 10%, transparent) 0%, var(--qm-bg-elevated) 100%);
        transform: translateY(-2px);
    }

    .quick-action-btn .rz-icon {
        font-size: 28px;
        color: var(--qm-primary);
    }

    .quick-action-btn span {
        font-size: 13px;
        font-weight: 500;
        color: var(--qm-text-primary);
    }

    /* Service Types DataGrid - Dark Mode Fix */
    .service-types-grid {
        background: transparent;
    }

    .service-types-grid .rz-datatable-thead th,
    .service-types-grid .rz-datatable-thead .rz-column-title {
        background: var(--qm-bg-elevated) !important;
        color: var(--qm-text-muted) !important;
        border-bottom: 1px solid var(--qm-border) !important;
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .service-types-grid .rz-datatable-tbody tr {
        background: transparent;
        border-bottom: 1px solid var(--qm-border);
    }

    .service-types-grid .rz-datatable-tbody tr:hover {
        background: var(--qm-bg-elevated);
    }

    .service-types-grid .rz-datatable-tbody td {
        color: var(--qm-text-primary);
        border: none;
    }

    .service-types-grid .rz-sortable-column .rz-column-title-content,
    .service-types-grid .rz-cell-data {
        color: inherit;
    }

    @@media (max-width: 992px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .counters-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Welcome / Getting Started State */
    .welcome-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 300px);
        padding: 2rem;
    }

    .welcome-content {
        text-align: center;
        max-width: 520px;
        padding: 3rem;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
        box-shadow: var(--qm-shadow-lg);
    }

    .welcome-icon {
        font-size: 4rem;
        color: var(--qm-primary);
        margin-bottom: 1.5rem;
    }

    .welcome-icon.select-branch {
        color: var(--qm-warning);
    }

    .welcome-content h2 {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--qm-text-primary);
        margin-bottom: 1rem;
    }

    .welcome-message {
        font-size: 1rem;
        color: var(--qm-text-secondary);
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .welcome-steps {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
        text-align: left;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
        border: 1px solid var(--qm-border);
    }

    .step-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: var(--qm-primary);
        color: var(--qm-text-on-primary);
        border-radius: 50%;
        font-weight: 600;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    .step-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .step-content strong {
        color: var(--qm-text-primary);
        font-weight: 600;
    }

    .step-content span {
        font-size: 0.875rem;
        color: var(--qm-text-muted);
    }

    .welcome-action {
        margin-top: 1.5rem;
    }

    .welcome-hint {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem;
        background: color-mix(in srgb, var(--qm-warning) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--qm-warning) 30%, transparent);
        border-radius: var(--qm-radius-lg);
        font-size: 0.875rem;
        color: var(--qm-text-secondary);
    }

    .welcome-hint .rz-icon {
        color: var(--qm-warning);
        flex-shrink: 0;
        animation: bounce 1.5s ease-in-out infinite;
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(5px); }
    }
</style>

@code {
    private QueueStatusDto? queueStatus;
    private string? errorMessage;
    private bool isLoading = true;
    private DateTime lastUpdated;
    private bool noBranchSelected = false;
    private bool branchStateInitialized = false;

    private Guid BranchId => BranchState.CurrentBranchId;

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.DashboardView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        // Subscribe to branch changes
        BranchState.OnBranchChanged += HandleBranchChanged;

        // LoadAsync is idempotent, so this is a no-op when MainLayout already populated it; it
        // matters when the dashboard is the first page rendered on a fresh circuit.
        await ModuleState.LoadAsync(ModuleApi);
        await ResolveModulesAsync();

        // Note: We'll load data in OnAfterRenderAsync when BranchState is properly initialized
    }

    private bool hasCoreQueue = true;

    /// <summary>Whether to render the Student Welfare section of the dashboard.</summary>
    private bool hasStudentWelfare;

    /// <summary>True once a real branch is resolved — module sections are branch-scoped, so they
    /// wait for the same thing the queue panels do rather than querying with an empty id.</summary>
    private bool branchReady => BranchState.HasBranches && BranchId != Guid.Empty;

    private WelfareSummaryDto? welfareSummary;
    private int studentCount;

    /// <summary>The header promised "your queue overview" to every organization, including those
    /// holding no queue module at all.</summary>
    private string dashboardSubtitle => hasCoreQueue
        ? "Welcome back! Here's your queue overview for today."
        : "Welcome back!";
    private List<string> activeModuleNames = new();

    /// <summary>
    /// SuperAdmin administers every tenant and is never scoped to one tenant's purchases, matching
    /// the bypass used by the sidebar, the navigation guard and the API's own module gate.
    /// </summary>
    private async Task ResolveModulesAsync()
    {
        if (await PermissionService.IsSuperAdminAsync())
        {
            hasCoreQueue = true;
            hasStudentWelfare = true;
            return;
        }

        try
        {
            var catalog = await ModuleApi.GetMineAsync();
            hasCoreQueue = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.CoreQueue);
            hasStudentWelfare = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.StudentWelfare);
            activeModuleNames = catalog
                .Where(m => m.Purchased && m.ModuleCode != ModuleCodes.CoreQueue)
                .Select(m => m.ModuleName)
                .ToList();
        }
        catch
        {
            // Fail open: if we can't tell, show the normal dashboard rather than telling a paying
            // customer they don't own Core Queue Management. Its data calls are gated server-side.
            hasCoreQueue = true;
            hasStudentWelfare = false;
            activeModuleNames = new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wait for BranchState to be initialized (requires localStorage)
            await BranchState.InitializeAsync();
            branchStateInitialized = true;

            // Check if branches exist and one is selected
            if (!BranchState.HasBranches)
            {
                // SuperAdmin's own "Platform Administration" org is an internal account, not a
                // real tenant — it will never have branches, so the "create your first branch"
                // onboarding checklist doesn't apply to it and previously showed regardless,
                // which read as broken/meaningless for the one account that will always land
                // here with zero branches. Send SuperAdmin to the platform-wide dashboard
                // instead, which is what they actually want to see. A regular tenant admin with
                // genuinely zero branches yet still gets the real onboarding checklist below.
                if (await PermissionService.IsSuperAdminAsync())
                {
                    Navigation.NavigateTo("/platform/dashboard", forceLoad: false);
                    return;
                }

                // No branches exist - show getting started
                isLoading = false;
                StateHasChanged();
                return;
            }

            if (BranchId == Guid.Empty)
            {
                // Branches exist but none selected
                noBranchSelected = true;
                isLoading = false;
                StateHasChanged();
                return;
            }

            await LoadQueueStatus();
            await LoadWelfareSummaryAsync();

            // The queue hub pushes token and counter events, which mean nothing without Core
            // Queue Management — joining it just opens a connection to receive silence.
            try
            {
                if (hasCoreQueue)
                {
                    await SignalR.ConnectAsync(BranchId);
                    SignalR.OnQueueUpdated += HandleQueueUpdated;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"SignalR connection failed: {ex.Message}");
            }

            StateHasChanged();
        }
    }

    private async void HandleBranchChanged()
    {
        await InvokeAsync(async () =>
        {
            // Check if branches exist and one is selected
            if (!BranchState.HasBranches)
            {
                isLoading = false;
                StateHasChanged();
                return;
            }

            if (BranchId == Guid.Empty)
            {
                noBranchSelected = true;
                isLoading = false;
                StateHasChanged();
                return;
            }

            noBranchSelected = false;
            await LoadQueueStatus();
            await LoadWelfareSummaryAsync();
            try
            {
                if (hasCoreQueue) await SignalR.ConnectAsync(BranchId);
            }
            catch { }
        });
    }


    /// <summary>
    /// Loads the Student Welfare panel. Separate from the queue load so a school holding only this
    /// module still gets a populated dashboard, and so neither module's failure blanks the other.
    /// </summary>
    private async Task LoadWelfareSummaryAsync()
    {
        if (!hasStudentWelfare || !branchReady) return;

        try
        {
            welfareSummary = await Http.GetFromJsonAsync<WelfareSummaryDto>(
                $"api/v1/branches/{BranchId}/welfare/summary", JsonOptions) ?? new WelfareSummaryDto();

            var students = await Http.GetFromJsonAsync<List<StudentDto>>(
                $"api/v1/branches/{BranchId}/students", JsonOptions);
            studentCount = students?.Count ?? 0;
        }
        catch
        {
            // An empty panel is better than a red banner over a working dashboard — the same
            // judgement the queue panels make.
            welfareSummary ??= new WelfareSummaryDto();
        }
    }

    private async Task LoadQueueStatus()
    {

        // Don't load if no branches exist or none selected
        if (!BranchState.HasBranches || BranchId == Guid.Empty)
        {
            noBranchSelected = BranchId == Guid.Empty;
            isLoading = false;
            return;
        }

        noBranchSelected = false;

        // Core Queue Management owns everything this call returns; without it the API refuses the
        // request with a 403 and the null result surfaced as "Unable to load queue data. Please
        // ensure the API is running and the selected branch is valid." — an alarming, misleading
        // banner sitting directly above the empty state that already explains the real situation.
        // A welfare-only tenant saw it every time they opened their dashboard.
        if (!hasCoreQueue)
        {
            isLoading = false;
            return;
        }
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            queueStatus = await QueueApi.GetQueueStatusAsync(BranchId);
            if (queueStatus == null)
            {
                errorMessage = "Unable to load queue data. Please ensure the API is running and the selected branch is valid.";
            }
            else
            {
                lastUpdated = DateTime.Now;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Unable to connect to the API server. Please check if the API is running.";
            Console.WriteLine($"Dashboard connection error: {ex}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Dashboard load error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadQueueStatus();
            await LoadWelfareSummaryAsync();
    }

    private void HandleQueueUpdated(QueueStatusDto status)
    {
        queueStatus = status;
        lastUpdated = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private string GetServiceColor(string code)
    {
        var firstChar = string.IsNullOrEmpty(code) ? '_' : char.ToUpperInvariant(code[0]);
        return firstChar switch
        {
            'A' => "var(--qm-primary)",
            'B' => "var(--qm-success)",
            'C' => "var(--qm-accent-orange)",
            'D' => "var(--qm-danger)",
            'E' => "var(--qm-accent-pink)",
            'F' => "var(--qm-secondary)",
            _ => "var(--qm-primary)"
        };
    }

    private string GetCounterStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "active" => "active",
            "onbreak" => "onbreak",
            "inactive" => "inactive",
            "closed" => "closed",
            _ => ""
        };
    }

    private static string GetCounterStatusVariant(string status) => status.ToLowerInvariant() switch
    {
        "active" => "success",
        "onbreak" => "warning",
        "inactive" or "closed" => "secondary",
        _ => "secondary"
    };

    private void OpenKiosk() => NavigationManager.NavigateTo("/queue/kiosk");
    private void OpenCounterTerminal() => NavigationManager.NavigateTo("/queue/counter");
    private void OpenCustomerDisplay() => NavigationManager.NavigateTo($"/queue/display/{BranchId}");
    private void OpenReports() => NavigationManager.NavigateTo("/reports");
    private void NavigateToBranches() => NavigationManager.NavigateTo("/admin/branches");

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    public void Dispose()
    {
        BranchState.OnBranchChanged -= HandleBranchChanged;
        SignalR.OnQueueUpdated -= HandleQueueUpdated;
    }
}
