@code {
    private QueueStatusDto? queueStatus;
    private string? errorMessage;
    private bool isLoading = true;
    private DateTime lastUpdated;
    private bool noBranchSelected = false;
    private bool branchStateInitialized = false;

    private Guid BranchId => BranchState.CurrentBranchId;

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.DashboardView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        // Subscribe to branch changes
        BranchState.OnBranchChanged += HandleBranchChanged;

        // LoadAsync is idempotent, so this is a no-op when MainLayout already populated it; it
        // matters when the dashboard is the first page rendered on a fresh circuit.
        await ModuleState.LoadAsync(ModuleApi);

        // Held as a task, not just awaited: Blazor renders the component as soon as this method
        // yields at an await and then fires OnAfterRenderAsync, so the data loaders there could
        // start while the catalog call was still in flight and read `hasCoreQueue` at its `= true`
        // default. A welfare-only tenant then made a queue request the API refused, and the
        // resulting "Unable to load queue data" banner stayed on screen even once the flag
        // resolved to false. The loaders await this first.
        moduleResolution = ResolveModulesAsync();
        await moduleResolution;

        // What the stat cards are allowed to link to. A card whose destination the caller can't
        // open stays a plain tile rather than a link that bounces them off /unauthorized — see
        // StatHref below.
        canViewReports = await PermissionService.HasPermissionAsync(Permissions.ReportsView);
        canViewQueue = await PermissionService.HasPermissionAsync(Permissions.QueueView);
        canViewStudents = await PermissionService.HasPermissionAsync(Permissions.StudentsView);
        canViewWelfareReports = await PermissionService.HasPermissionAsync(Permissions.WelfareReportsView);
        canViewVisitors = await PermissionService.HasPermissionAsync(Permissions.VisitorsView);
        canViewFeedback = await PermissionService.HasPermissionAsync(Permissions.FeedbackView);
        canRespondFeedback = await PermissionService.HasPermissionAsync(Permissions.FeedbackRespond);
        canViewContent = await PermissionService.HasPermissionAsync(Permissions.ContentView);

        // Note: We'll load data in OnAfterRenderAsync when BranchState is properly initialized
    }

    private bool hasCoreQueue = true;

    // ---- Stat-card destinations -------------------------------------------------------------
    //
    // Every tile on this page counts something that has a page behind it, and until now none of
    // them said so — the numbers were a dead end and the only way onward was the section's own
    // "Open …" button. Each card is now a real <a href>, so it middle-clicks, opens in a tab and
    // reads as a link to a screen reader, which an @onclick div does not.
    //
    // Two rules the destinations follow:
    //   * the page must actually show the number on the card. This is why the welfare action
    //     cards go to the branch-wide ledger with a filter rather than to /admin/welfare-my-actions
    //     — that page lists only what is assigned to the signed-in user, so a card reading "12"
    //     would open a list of two. Without welfare.reports.view there is no branch-wide view, and
    //     "mine" is then the honest destination, so that is where it goes.
    //   * a card the caller cannot open is not a link. StatHref returns null and the card renders
    //     as the plain tile it always was, rather than a link that bounces off /unauthorized.

    private bool canViewReports, canViewQueue, canViewStudents, canViewWelfareReports;
    private bool canViewVisitors, canViewFeedback, canRespondFeedback, canViewContent;

    // Queue: the live board shows what is waiting and being served right now; the wait and
    // throughput figures are analytics, and that is a different page.
    private string? QueueLiveHref => canViewQueue ? "/queue/board" : null;
    private string? QueueAnalyticsHref => canViewReports ? "/reports/queue" : null;

    // Welfare: the ledger, filtered to the tile's own definition. `view=open` is "not resolved"
    // and `view=overdue` adds "past its due date" — the same two predicates GetSummary counts.
    private string? WelfareOpenHref =>
        canViewWelfareReports ? "/admin/welfare-reports?tab=search&view=open" : "/admin/welfare-my-actions";
    private string? WelfareOverdueHref =>
        canViewWelfareReports ? "/admin/welfare-reports?tab=search&view=overdue" : "/admin/welfare-my-actions";
    private string? WelfareRecordsHref => canViewWelfareReports ? "/admin/welfare-reports" : null;
    private string? RosterHref => canViewStudents ? "/admin/students/roster" : null;

    // Visitors: the desk is where on-site people are, and where you act on a watchlist hit.
    private string? VisitorDeskHref => canViewVisitors ? "/admin/visitors" : null;
    private string? VisitorExpectedHref => canViewVisitors ? "/admin/visitors/expected" : null;
    private string? VisitorReportHref => canViewReports ? "/reports/visitors" : null;

    // Engagement: ratings and volume are a report; an unanswered comment is a job, and that
    // lives in the feedback inbox rather than the report.
    private string? CampaignsHref => canViewContent ? "/content/campaigns" : null;
    private string? FeedbackReportHref => canViewReports && canViewFeedback ? "/reports/feedback" : null;
    private string? FeedbackInboxHref => canRespondFeedback ? "/admin/feedback" : null;

    /// <summary>
    /// The in-flight module resolution. Anything that reads the `has*` flags awaits this first,
    /// so it sees the tenant's real holdings rather than the optimistic defaults.
    /// </summary>
    private Task? moduleResolution;

    private async Task EnsureModulesResolvedAsync()
    {
        if (moduleResolution != null) await moduleResolution;
    }

    /// <summary>Which module sections to render. Each is resolved once, from the same catalog call.</summary>
    private bool hasStudentWelfare;
    private bool hasVisitorManagement;
    private bool hasEngagement;

    /// <summary>True once a real branch is resolved — module sections are branch-scoped, so they
    /// wait for the same thing the queue panels do rather than querying with an empty id.</summary>
    private bool branchReady => BranchState.HasBranches && BranchId != Guid.Empty;

    private WelfareSummaryDto? welfareSummary;
    private int studentCount;
    private VisitorSummaryDto? visitorSummary;
    private FeedbackSummaryDto? feedbackSummary;
    private int activeCampaignCount;

    /// <summary>The header promised "your queue overview" to every organization, including those
    /// holding no queue module at all.</summary>
    private string dashboardSubtitle => hasCoreQueue
        ? "Welcome back! Here's your queue overview for today."
        : "Welcome back!";
    private List<string> activeModuleNames = new();

    /// <summary>
    /// SuperAdmin administers every tenant and is never scoped to one tenant's purchases, matching
    /// the bypass used by the sidebar, the navigation guard and the API's own module gate.
    /// </summary>
    private async Task ResolveModulesAsync()
    {
        if (await PermissionService.IsSuperAdminAsync())
        {
            hasCoreQueue = true;
            hasStudentWelfare = true;
            hasVisitorManagement = true;
            hasEngagement = true;
            return;
        }

        try
        {
            var catalog = await ModuleApi.GetMineAsync();
            hasCoreQueue = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.CoreQueue);
            hasStudentWelfare = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.StudentWelfare);
            hasVisitorManagement = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.VisitorManagement);
            hasEngagement = catalog.Any(m => m.Purchased && m.ModuleCode == ModuleCodes.EngagementCommunications);
            activeModuleNames = catalog
                .Where(m => m.Purchased && m.ModuleCode != ModuleCodes.CoreQueue)
                .Select(m => m.ModuleName)
                .ToList();
        }
        catch
        {
            // Fail open: if we can't tell, show the normal dashboard rather than telling a paying
            // customer they don't own Core Queue Management. Its data calls are gated server-side.
            hasCoreQueue = true;
            hasStudentWelfare = false;
            hasVisitorManagement = false;
            hasEngagement = false;
            activeModuleNames = new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Wait for BranchState to be initialized (requires localStorage)
            await BranchState.InitializeAsync();
            branchStateInitialized = true;

            // Check if branches exist and one is selected
            if (!BranchState.HasBranches)
            {
                // SuperAdmin's own "Platform Administration" org is an internal account, not a
                // real tenant — it will never have branches, so the "create your first branch"
                // onboarding checklist doesn't apply to it and previously showed regardless,
                // which read as broken/meaningless for the one account that will always land
                // here with zero branches. Send SuperAdmin to the platform-wide dashboard
                // instead, which is what they actually want to see. A regular tenant admin with
                // genuinely zero branches yet still gets the real onboarding checklist below.
                if (await PermissionService.IsSuperAdminAsync())
                {
                    Navigation.NavigateTo("/platform/dashboard", forceLoad: false);
                    return;
                }

                // No branches exist - show getting started
                isLoading = false;
                StateHasChanged();
                return;
            }

            if (BranchId == Guid.Empty)
            {
                // Branches exist but none selected
                noBranchSelected = true;
                isLoading = false;
                StateHasChanged();
                return;
            }

            await LoadQueueStatus();
            await LoadWelfareSummaryAsync();
            await LoadVisitorSummaryAsync();
            await LoadEngagementSummaryAsync();

            // The queue hub pushes token and counter events, which mean nothing without Core
            // Queue Management — joining it just opens a connection to receive silence.
            try
            {
                if (hasCoreQueue)
                {
                    await SignalR.ConnectAsync(BranchId);
                    SignalR.OnQueueUpdated += HandleQueueUpdated;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"SignalR connection failed: {ex.Message}");
            }

            StateHasChanged();
        }
    }

    private async void HandleBranchChanged()
    {
        await InvokeAsync(async () =>
        {
            // Check if branches exist and one is selected
            if (!BranchState.HasBranches)
            {
                isLoading = false;
                StateHasChanged();
                return;
            }

            if (BranchId == Guid.Empty)
            {
                noBranchSelected = true;
                isLoading = false;
                StateHasChanged();
                return;
            }

            noBranchSelected = false;
            await LoadQueueStatus();
            await LoadWelfareSummaryAsync();
            await LoadVisitorSummaryAsync();
            await LoadEngagementSummaryAsync();
            try
            {
                if (hasCoreQueue) await SignalR.ConnectAsync(BranchId);
            }
            catch { }
        });
    }


    /// <summary>
    /// Loads the Student Welfare panel. Separate from the queue load so a school holding only this
    /// module still gets a populated dashboard, and so neither module's failure blanks the other.
    /// </summary>
    private async Task LoadWelfareSummaryAsync()
    {
        await EnsureModulesResolvedAsync();
        if (!hasStudentWelfare || !branchReady) return;

        try
        {
            welfareSummary = await Http.GetFromJsonAsync<WelfareSummaryDto>(
                $"api/v1/branches/{BranchId}/welfare/summary", JsonOptions) ?? new WelfareSummaryDto();

            var students = await Http.GetFromJsonAsync<List<StudentDto>>(
                $"api/v1/branches/{BranchId}/students", JsonOptions);
            studentCount = students?.Count ?? 0;
        }
        catch
        {
            // An empty panel is better than a red banner over a working dashboard — the same
            // judgement the queue panels make.
            welfareSummary ??= new WelfareSummaryDto();
        }
    }


    /// <summary>
    /// Loads the Visitor Management panel. Its own method for the same reason as welfare: a module
    /// whose data fails should leave the other sections standing.
    /// </summary>
    private async Task LoadVisitorSummaryAsync()
    {
        await EnsureModulesResolvedAsync();
        if (!hasVisitorManagement || !branchReady) return;

        try
        {
            visitorSummary = await Http.GetFromJsonAsync<VisitorSummaryDto>(
                $"api/v1/branches/{BranchId}/visitors/summary", JsonOptions) ?? new VisitorSummaryDto();
        }
        catch
        {
            visitorSummary ??= new VisitorSummaryDto();
        }
    }

    /// <summary>
    /// Loads the Engagement panel: how many campaigns are running, and what customers are saying.
    /// </summary>
    private async Task LoadEngagementSummaryAsync()
    {
        await EnsureModulesResolvedAsync();
        if (!hasEngagement || !branchReady) return;

        try
        {
            feedbackSummary = await Http.GetFromJsonAsync<FeedbackSummaryDto>(
                $"api/v1/branches/{BranchId}/feedbacks/summary", JsonOptions) ?? new FeedbackSummaryDto();

            var campaigns = await Http.GetFromJsonAsync<List<CampaignDto>>(
                $"api/v1/branches/{BranchId}/campaigns", JsonOptions);

            // "Live" means running today, not merely enabled — a campaign whose window has closed
            // is not something the dashboard should still be counting.
            var today = DateTime.UtcNow;
            activeCampaignCount = campaigns?.Count(c => c.IsActive && c.StartDate <= today && c.EndDate >= today) ?? 0;
        }
        catch
        {
            feedbackSummary ??= new FeedbackSummaryDto();
        }
    }

    private async Task LoadQueueStatus()
    {

        // Don't load if no branches exist or none selected
        if (!BranchState.HasBranches || BranchId == Guid.Empty)
        {
            noBranchSelected = BranchId == Guid.Empty;
            isLoading = false;
            return;
        }

        noBranchSelected = false;

        // Core Queue Management owns everything this call returns; without it the API refuses the
        // request with a 403 and the null result surfaced as "Unable to load queue data. Please
        // ensure the API is running and the selected branch is valid." — an alarming, misleading
        // banner sitting directly above the empty state that already explains the real situation.
        // A welfare-only tenant saw it every time they opened their dashboard.
        await EnsureModulesResolvedAsync();

        if (!hasCoreQueue)
        {
            // Cleared as well as skipped: a previous pass may have set it before the flag resolved.
            errorMessage = null;
            isLoading = false;
            return;
        }
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            queueStatus = await QueueApi.GetQueueStatusAsync(BranchId);
            if (queueStatus == null)
            {
                errorMessage = "Unable to load queue data. Please ensure the API is running and the selected branch is valid.";
            }
            else
            {
                lastUpdated = DateTime.Now;
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = "Unable to connect to the API server. Please check if the API is running.";
            Console.WriteLine($"Dashboard connection error: {ex}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            Console.WriteLine($"Dashboard load error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadQueueStatus();
        await LoadWelfareSummaryAsync();
        await LoadVisitorSummaryAsync();
        await LoadEngagementSummaryAsync();
    }

    private void HandleQueueUpdated(QueueStatusDto status)
    {
        queueStatus = status;
        lastUpdated = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }

    private string GetServiceColor(string code)
    {
        var firstChar = string.IsNullOrEmpty(code) ? '_' : char.ToUpperInvariant(code[0]);
        return firstChar switch
        {
            'A' => "var(--qm-primary)",
            'B' => "var(--qm-success)",
            'C' => "var(--qm-accent-orange)",
            'D' => "var(--qm-danger)",
            'E' => "var(--qm-accent-pink)",
            'F' => "var(--qm-secondary)",
            _ => "var(--qm-primary)"
        };
    }

    private string GetCounterStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "active" => "active",
            "onbreak" => "onbreak",
            "inactive" => "inactive",
            "closed" => "closed",
            _ => ""
        };
    }

    private static string GetCounterStatusVariant(string status) => status.ToLowerInvariant() switch
    {
        "active" => "success",
        "onbreak" => "warning",
        "inactive" or "closed" => "secondary",
        _ => "secondary"
    };

