@page "/ticket/{BranchId:guid}"
@page "/ticket/{BranchId:guid}/{DisplayNumber}"
@layout KioskLayout
@using Microsoft.AspNetCore.Authorization
@using QMgr.Application.DTOs
@attribute [AllowAnonymous]
@implements IDisposable
@inject IQueueApiService QueueApi
@inject IOrganizationApiService OrganizationApi
@inject ISignalRService SignalR
@inject NavigationManager Navigation

@*
    "Where am I in the queue?" on the customer's own phone.

    The URL is guessable by design (a display number is short and sequential), so the endpoint
    behind this page — GET api/v1/branches/{id}/queue/tokens/{displayNumber} — returns only what
    the lobby display board already shows in public: the number, the service, the status, the
    place in line and the counter. No name, no phone, no email. Do not add any here either.
*@

<PageTitle>Ticket Status@(branchInfo != null ? $" - {branchInfo.Name}" : "")</PageTitle>

<div class="ts-page">
    <header class="ts-header">
        <div class="ts-brand">
            <QIcon Name="ticket-perforated-fill" aria-hidden="true" />
            <div class="ts-brand-text">
                <span class="ts-org">@(branchInfo?.OrganizationName ?? "Q-Mgr")</span>
                @if (!string.IsNullOrWhiteSpace(branchInfo?.Name))
                {
                    <span class="ts-branch">@branchInfo!.Name</span>
                }
            </div>
        </div>
    </header>

    <main class="ts-main">
        @if (branchInvalid)
        {
            <div class="ts-state" role="alert">
                <QIcon Name="exclamation-triangle" aria-hidden="true" />
                <h1>This link is not valid</h1>
                <p>The branch may have been removed or closed. Please ask a member of staff for a current link.</p>
            </div>
        }
        else if (status == null)
        {
            <h1 class="ts-title">Track your ticket</h1>
            <p class="ts-subtitle">Enter the number printed on your ticket to see your place in the queue.</p>

            <div class="ts-lookup">
                <QInput TValue="string"
                        @bind-Value="codeInput"
                        Label="Ticket number"
                        Placeholder="e.g. A007"
                        MaxLength="24"
                        autocomplete="off"
                        autocapitalize="characters" />

                @if (!string.IsNullOrEmpty(lookupError))
                {
                    <div class="ts-error" role="alert">
                        <QIcon Name="exclamation-triangle-fill" aria-hidden="true" />
                        <span>@lookupError</span>
                    </div>
                }

                <QButton Variant="primary"
                         Size="lg"
                         Block="true"
                         Class="ts-submit"
                         Loading="@isLooking"
                         Disabled="@string.IsNullOrWhiteSpace(codeInput)"
                         OnClick="LookUpTicket"
                         aria-label="Look up the ticket number entered above">
                    <span>@(isLooking ? "Checking..." : "Check my ticket")</span>
                </QButton>
            </div>

            <p class="ts-footnote">
                Don't have a ticket yet? <a href="/join/@BranchId">Join the queue</a>.
            </p>
        }
        else
        {
            <h1 class="visually-hidden">Status of ticket @SpellOut(status.DisplayNumber)</h1>

            <div class="ts-card">
                <span class="ts-label">Your ticket</span>
                <span class="ts-number">@status.DisplayNumber</span>
                <span class="ts-service">@status.ServiceTypeName</span>
            </div>

            @* polite, not assertive: this region re-renders on every poll and every queue
               broadcast, and an assertive live region here would interrupt the reader
               constantly. The one moment that genuinely is urgent — "go to the counter now" —
               gets its own assertive region below. *@
            <div class="ts-status" role="status" aria-live="polite">
                @if (IsWaiting)
                {
                    <div class="ts-metrics">
                        <div class="ts-metric">
                            <span class="ts-metric-value">@status.Position</span>
                            <span class="ts-metric-label">Your position</span>
                        </div>
                        <div class="ts-metric">
                            <span class="ts-metric-value">@status.PeopleAhead</span>
                            <span class="ts-metric-label">Ahead of you</span>
                        </div>
                        <div class="ts-metric">
                            <span class="ts-metric-value">@status.EstimatedWaitMinutes</span>
                            <span class="ts-metric-label">Minutes (est.)</span>
                        </div>
                    </div>
                    <p class="ts-note">
                        @(status.PeopleAhead == 0
                            ? "You're next. Please stay close to the counters."
                            : $"{status.PeopleAhead} {(status.PeopleAhead == 1 ? "person is" : "people are")} ahead of you.")
                    </p>
                }
                else
                {
                    <div class="ts-outcome ts-outcome--@status.Status.ToLowerInvariant()">
                        <QIcon Name="@OutcomeIcon()" aria-hidden="true" />
                        <span class="ts-outcome-title">@OutcomeTitle()</span>
                        <span class="ts-outcome-detail">@OutcomeDetail()</span>
                    </div>
                }
            </div>

            @* assertive, and only here: being called to a counter is the one thing on this page
               that must interrupt whatever the customer is doing. *@
            @if (IsCalled)
            {
                <div class="ts-called" role="alert" aria-live="assertive">
                    <QIcon Name="megaphone-fill" aria-hidden="true" />
                    <span>
                        Ticket @SpellOut(status.DisplayNumber) is being served@(string.IsNullOrWhiteSpace(status.CounterNumber) ? "" : $" at counter {status.CounterNumber}").
                        Please go to the counter now.
                    </span>
                </div>
            }

            <div class="ts-actions">
                <button type="button" class="ts-refresh" aria-label="Refresh the status of this ticket now" @onclick="RefreshAsync">
                    <QIcon Name="arrow-clockwise" aria-hidden="true" />
                    <span>Refresh</span>
                </button>
                <button type="button" class="ts-refresh" aria-label="Look up a different ticket number" @onclick="ClearTicket">
                    <QIcon Name="search" aria-hidden="true" />
                    <span>Another ticket</span>
                </button>
            </div>

            <p class="ts-footnote" aria-live="off">
                Updates automatically. Last checked @lastChecked.ToLocalTime().ToString("HH:mm:ss").
            </p>
        }
    </main>
</div>

<style>
    /* Mobile-first, --qm-* tokens only, so this page follows the light/dark choice
       KioskLayout applies to its wrapper. */
    .ts-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--qm-bg-dark);
        color: var(--qm-text-primary);
        font-family: var(--qm-font-primary);
    }

    .ts-header {
        padding: 16px 20px;
        background: var(--qm-bg-card);
        border-bottom: 1px solid var(--qm-border);
    }

    .ts-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ts-brand .q-icon {
        font-size: 26px;
        color: var(--qm-primary);
    }

    .ts-brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
        min-width: 0;
    }

    .ts-org {
        font-family: var(--qm-font-display);
        font-size: 17px;
        font-weight: 700;
    }

    .ts-branch {
        font-size: 14px;
        color: var(--qm-text-secondary);
    }

    .ts-main {
        flex: 1;
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        padding: 20px 20px 40px;
    }

    .ts-title {
        margin: 8px 0 6px;
        font-family: var(--qm-font-display);
        font-size: 28px;
        font-weight: 700;
    }

    .ts-subtitle {
        margin: 0 0 24px;
        font-size: 16px;
        line-height: 1.5;
        color: var(--qm-text-secondary);
    }

    .ts-lookup {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .ts-submit {
        min-height: 56px;
        font-size: 17px;
    }

    .ts-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 28px 20px;
        background: var(--qm-bg-card);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
    }

    .ts-label {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--qm-text-muted);
    }

    .ts-number {
        font-family: var(--qm-font-mono, 'JetBrains Mono', monospace);
        font-size: 64px;
        font-weight: 800;
        line-height: 1.05;
        color: var(--qm-primary);
    }

    .ts-service {
        font-size: 16px;
        color: var(--qm-text-secondary);
    }

    .ts-status {
        margin-top: 20px;
    }

    .ts-metrics {
        display: flex;
        gap: 10px;
    }

    .ts-metric {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 18px 8px;
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        text-align: center;
    }

    .ts-metric-value {
        font-family: var(--qm-font-mono, 'JetBrains Mono', monospace);
        font-size: 30px;
        font-weight: 800;
        line-height: 1;
    }

    .ts-metric-label {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .ts-note {
        margin: 16px 0 0;
        font-size: 16px;
        line-height: 1.5;
        color: var(--qm-text-secondary);
        text-align: center;
    }

    .ts-outcome {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 26px 20px;
        border-radius: var(--qm-radius-xl);
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        text-align: center;
    }

    .ts-outcome .q-icon {
        font-size: 40px;
        color: var(--qm-text-muted);
    }

    .ts-outcome--serving .q-icon,
    .ts-outcome--called .q-icon {
        color: var(--qm-success);
    }

    .ts-outcome--completed .q-icon {
        color: var(--qm-success);
    }

    .ts-outcome--cancelled .q-icon,
