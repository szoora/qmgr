    .ts-called {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 18px;
        padding: 18px 20px;
        border-radius: var(--qm-radius-lg);
        background: color-mix(in srgb, var(--qm-success) 15%, transparent);
        border: 2px solid color-mix(in srgb, var(--qm-success) 45%, transparent);
        font-size: 17px;
        font-weight: 600;
        line-height: 1.45;
    }

    .ts-called .q-icon {
        font-size: 26px;
        color: var(--qm-success);
        flex-shrink: 0;
    }

    .ts-error {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        border-radius: var(--qm-radius-lg);
        background: color-mix(in srgb, var(--qm-warning) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--qm-warning) 35%, transparent);
        font-size: 15px;
        line-height: 1.45;
    }

    .ts-error .q-icon {
        color: var(--qm-warning);
        font-size: 20px;
        flex-shrink: 0;
    }

    .ts-actions {
        display: flex;
        gap: 10px;
        margin-top: 22px;
    }

    .ts-refresh {
        appearance: none;
        -webkit-appearance: none;
        font: inherit;
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 48px;
        padding: 12px 16px;
        background: transparent;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        color: var(--qm-text-secondary);
        font-size: 15px;
        cursor: pointer;
    }

    .ts-refresh:hover {
        border-color: var(--qm-primary);
        color: var(--qm-text-primary);
    }

    .ts-footnote {
        margin: 18px 0 0;
        font-size: 14px;
        color: var(--qm-text-muted);
        text-align: center;
    }

    .ts-footnote a {
        color: var(--qm-primary);
        font-weight: 600;
    }

    .ts-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 56px 20px;
        text-align: center;
    }

    .ts-state .q-icon {
        font-size: 52px;
        color: var(--qm-text-muted);
    }

    .ts-state h1 {
        margin: 0;
        font-family: var(--qm-font-display);
        font-size: 24px;
    }

    .ts-state p {
        margin: 0;
        max-width: 420px;
        font-size: 16px;
        line-height: 1.55;
        color: var(--qm-text-secondary);
    }

    .ts-page :focus-visible {
        outline: 3px solid var(--qm-text-primary);
        outline-offset: 3px;
        border-radius: var(--qm-radius-sm);
    }

    @@media (prefers-reduced-motion: reduce) {
        .ts-page *,
        .ts-page *::before,
        .ts-page *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }

    @@media (min-width: 640px) {
        .ts-main {
            padding: 32px 24px 48px;
        }

        .ts-number {
            font-size: 80px;
        }
    }
</style>

@code {
    [Parameter] public Guid BranchId { get; set; }
    [Parameter] public string? DisplayNumber { get; set; }

    private BranchPublicDto? branchInfo;
    private bool branchInvalid;
    private PublicTicketStatusDto? status;
    private string? codeInput;
    private string? lookupError;
    private bool isLooking;
    private DateTime lastChecked = DateTime.UtcNow;

    private System.Threading.Timer? pollTimer;
    private bool signalRConnected;
    private Guid connectedBranchId;

    private bool IsWaiting => status?.Status == "Waiting";
    private bool IsCalled => status?.Status is "Called" or "Serving";

    protected override async Task OnInitializedAsync()
    {
        branchInfo = await OrganizationApi.GetBranchPublicAsync(BranchId);
        if (branchInfo == null || !branchInfo.IsActive)
        {
            branchInvalid = true;
            return;
        }

        if (!string.IsNullOrWhiteSpace(DisplayNumber))
        {
            codeInput = DisplayNumber;
            await LoadStatusAsync(DisplayNumber!);
        }

        await ConnectLiveUpdatesAsync();
        StartPolling();
    }

    /// <summary>
    /// The queue hub is anonymous by design (see QueueHub), so a customer's phone can subscribe
    /// to the same branch broadcasts the lobby display uses. It is best-effort: the poll timer
    /// below is what actually guarantees the page stays current if the socket never connects.
    /// </summary>
    private async Task ConnectLiveUpdatesAsync()
    {
        if (signalRConnected && connectedBranchId == BranchId) return;

        try
        {
            await SignalR.ConnectAsync(BranchId);
            SignalR.OnTokenCalled += HandleQueueMoved;
            SignalR.OnTokenCompleted += HandleTokenCompleted;
            SignalR.OnQueueUpdated += HandleQueueUpdated;
            signalRConnected = true;
            connectedBranchId = BranchId;
        }
        catch
        {
            // Polling still covers this page; a failed socket must not break it.
            signalRConnected = false;
        }
    }

    private void StartPolling()
    {
        pollTimer?.Dispose();
        // 20s: often enough that the number on screen is trustworthy, rare enough to sit well
        // inside the anonymous lookup rate limit (120 requests per 5 minutes per device).
        pollTimer = new System.Threading.Timer(async _ =>
        {
            if (status == null) return;
            await LoadStatusAsync(status.DisplayNumber);
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(20), TimeSpan.FromSeconds(20));
    }

    private void HandleQueueMoved(TokenDto token) => RefreshFromEvent();

    private void HandleTokenCompleted(Guid tokenId) => RefreshFromEvent();

    private void HandleQueueUpdated(QueueStatusDto queueStatus) => RefreshFromEvent();

    private void RefreshFromEvent()
    {
        if (status == null) return;

        // Fire-and-forget onto the renderer's context, then re-render — the standing rule for
        // any async load kicked off outside a lifecycle method.
        _ = InvokeAsync(async () =>
        {
            await LoadStatusAsync(status.DisplayNumber);
            StateHasChanged();
        });
    }

    private async Task LoadStatusAsync(string displayNumber)
    {
        var fresh = await QueueApi.GetPublicTicketStatusAsync(BranchId, displayNumber);
        lastChecked = DateTime.UtcNow;

        // A null here on a refresh means the lookup failed or the ticket aged out of today's
        // queue — keep showing the last known state rather than blanking the page under the
        // customer, and only treat it as "not found" when they were asking for a new number.
        if (fresh != null)
        {
            status = fresh;
        }
    }

    private async Task LookUpTicket()
    {
        if (string.IsNullOrWhiteSpace(codeInput) || isLooking) return;

        isLooking = true;
        lookupError = null;
        StateHasChanged();

        try
        {
            var result = await QueueApi.GetPublicTicketStatusAsync(BranchId, codeInput!.Trim());
            if (result == null)
            {
                lookupError = "We could not find that ticket number at this branch today. Check the number on your ticket and try again.";
            }
            else
            {
                status = result;
                lastChecked = DateTime.UtcNow;
                // Keep the address bar honest so the page can be bookmarked or reshared.
                Navigation.NavigateTo($"/ticket/{BranchId}/{Uri.EscapeDataString(result.DisplayNumber)}", forceLoad: false);
            }
        }
        finally
        {
            isLooking = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        if (status == null) return;
        await LoadStatusAsync(status.DisplayNumber);
        await InvokeAsync(StateHasChanged);
    }

    private void ClearTicket()
    {
        status = null;
        codeInput = null;
        lookupError = null;
        Navigation.NavigateTo($"/ticket/{BranchId}", forceLoad: false);
    }

    private string OutcomeIcon() => status?.Status switch
    {
        "Called" or "Serving" => "megaphone-fill",
        "Completed" => "check-circle-fill",
        "Cancelled" => "x-circle-fill",
        "NoShow" => "clock-history",
        "Transferred" => "arrow-left-right",
        _ => "info-circle-fill"
    };

    private string OutcomeTitle() => status?.Status switch
    {
        "Called" => "You're being called",
        "Serving" => "You're being served",
        "Completed" => "All done",
        "Cancelled" => "Ticket cancelled",
        "NoShow" => "Ticket missed",
        "Transferred" => "Ticket transferred",
        _ => "Ticket status"
    };

    private string OutcomeDetail() => status?.Status switch
    {
        "Called" or "Serving" => string.IsNullOrWhiteSpace(status?.CounterNumber)
            ? "Please make your way to the counters."
            : $"Please go to counter {status!.CounterNumber}.",
        "Completed" => "Thank you for visiting. This ticket is now closed.",
        "Cancelled" => "This ticket is no longer in the queue. Please ask a member of staff if you still need to be seen.",
        "NoShow" => "This ticket was called but not answered. Please ask a member of staff for a new one.",
        "Transferred" => "This ticket was moved to another counter's queue.",
        _ => "Please ask a member of staff if you need help."
    };

    /// <summary>
    /// "A007" read aloud as "A 0 0 7". A ticket number is a sequence of characters, not a
    /// quantity, and screen readers otherwise run the digits together into one number.
    /// </summary>
    private static string SpellOut(string? value) =>
        string.IsNullOrWhiteSpace(value) ? string.Empty : string.Join(" ", value.ToCharArray());

    public void Dispose()
    {
        pollTimer?.Dispose();
        pollTimer = null;

        if (signalRConnected)
        {
            SignalR.OnTokenCalled -= HandleQueueMoved;
            SignalR.OnTokenCompleted -= HandleTokenCompleted;
            SignalR.OnQueueUpdated -= HandleQueueUpdated;
        }
    }
}
