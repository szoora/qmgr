@page "/set-password"
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using QMgr.Web.Components.Shared
@using System.Net.Http.Json
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject IAppInitializationService AppInit
@inject IStaffOnboardingApiService Onboarding
@inject NavigationManager Navigation
@inject IPasswordRulesService PasswordRules
@inject HttpClient Http

@*
    Set your password (duty rota plan §12.3). Reached only by a session signed in with a temporary password,
    whose token the API honours for this one change and for signing out. The new password passes the policy
    and the blocklist on the server — the school's name, the username and the temporary password itself are
    refused there, not merely discouraged here. After the change this page signs the person in properly with
    the password they just chose, so the first real session starts at once.
*@

<QPageTitle Text="Set your password" />

<div class="login-container" style="@Host.BrandingStyle">
    <AmbientBackground />
    <div class="login-card @(saving ? "loading" : "")">
        @if (!ready)
        {
            <div class="login-header">
                <h1>One moment…</h1>
            </div>
        }
        else if (expired)
        {
            <div class="login-header">
                <QBrandMark Heading="Sign in again" FallbackIcon="clock-history"
                            Tagline="This sign-in can no longer set a password — it lasts fifteen minutes. Sign in again with your temporary password. If that has expired too, ask your administrator for a new one." />
            </div>
            <a href="/login" class="btn-login"><QIcon Name="box-arrow-in-right" Size="18" /><span>Sign in</span></a>
        }
        else
        {
            <div class="login-header">
                <QBrandMark Heading="Set your password" FallbackIcon="key-fill"
                            Tagline="@($"Welcome, {displayName}. You signed in with a temporary password — choose your own to continue.")" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert auth-alert-danger auth-animate-in" role="alert">
                    <div class="auth-alert-icon"><QIcon Name="exclamation-circle-fill" /></div>
                    <div class="auth-alert-content"><p>@errorMessage</p></div>
                </div>
            }

            <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
                <div class="form-group">
                    <label for="newPassword"><QIcon Name="lock-fill" Size="16" /><span>New password</span></label>
                    <div class="input-wrapper">
                        <input id="newPassword" type="@(showPassword ? "text" : "password")" class="form-control" autocomplete="new-password"
                               @bind="newPassword" @bind:event="oninput" disabled="@saving" placeholder="@PasswordRules.Placeholder" />
                        <button type="button" class="input-toggle" aria-label="@(showPassword ? "Hide password" : "Show password")" aria-pressed="@(showPassword ? "true" : "false")" @onclick="@(() => showPassword = !showPassword)" tabindex="-1">
                            <QIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    @* The rules the SERVER actually enforces, read from it rather than retyped here.
                       This page used to promise "At least 12 characters" whatever an administrator
                       had configured, and then the API refused in different words. *@
                    <p class="sp-hint">@PasswordRules.Summary</p>
                </div>
                <div class="form-group">
                    <label for="confirmPassword"><QIcon Name="lock-fill" Size="16" /><span>Confirm password</span></label>
                    <input id="confirmPassword" type="password" class="form-control" autocomplete="new-password"
                           @bind="confirmPassword" @bind:event="oninput" disabled="@saving" />
                    @if (!string.IsNullOrEmpty(confirmPassword) && newPassword != confirmPassword)
                    {
                        <span class="validation-message">The passwords do not match</span>
                    }
                </div>
                <button type="submit" class="btn-login" disabled="@(saving || string.IsNullOrEmpty(newPassword) || newPassword != confirmPassword)">
                    @if (saving) { <span class="auth-spinner"></span><span>Saving…</span> }
                    else { <QIcon Name="check-lg" Size="18" /><span>Set password</span> }
                </button>
            </form>
        }

        <div class="login-footer">
            <p><a href="/login" class="link-register" @onclick="SignOutAsync" @onclick:preventDefault="true">Sign out</a></p>
            @* The copyright, not the attribution line — see Login.razor. QCopyright reads the host itself. *@
            <QCopyright Class="login-copyright" />
        </div>
    </div>
</div>

<style>
    .sp-hint { font-size: var(--qm-text-sm); color: var(--qm-text-muted); margin: 6px 0 0; }
</style>

@code {
    /// <summary>
    /// Which host the browser arrived on, cascaded by App.razor. On a public page the branding comes
    /// from the HOST and never from a session — there is nobody signed in to ask.
    /// </summary>
    [CascadingParameter] public QMgr.Web.Services.TenantHostContext Host { get; set; }
        = QMgr.Web.Services.TenantHostContext.Platform;

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private bool ready, expired, saving, showPassword;
    private string newPassword = string.Empty, confirmPassword = string.Empty;
    private string? errorMessage, displayName, identifier;
    // The rules come from IPasswordRulesService — the ONE home. This page kept its own copy of
    // the fetch, the swallowed failure and a default record reading "At least 12 characters", which
    // is the sentence the whole feature exists to stop it printing.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AppInit.InitializeAsync();

        // The rules the server will judge this password by. The service never throws and never
        // invents a number, so nothing here has to guard it.
        await PasswordRules.LoadAsync();

        var user = await AuthService.GetCurrentUserAsync();
        if (user == null)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }
        if (!user.MustChangePassword)
        {
            // Already their own password: nothing to do here.
            Navigation.NavigateTo(SafeReturnUrl(), forceLoad: true);
            return;
        }

        displayName = string.IsNullOrWhiteSpace(user.FullName) ? user.Username : user.FullName;
        identifier = string.IsNullOrWhiteSpace(user.Email) ? user.Username : user.Email;
        ready = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrEmpty(newPassword) || newPassword != confirmPassword) return;
        errorMessage = null;
        saving = true;
        try
        {
            await Onboarding.ChangePasswordAsync(string.Empty, newPassword, confirmPassword);
        }
        catch (InvalidOperationException ex)
        {
            saving = false;
            if (ex.Message.Contains("Sign in again", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("no longer", StringComparison.OrdinalIgnoreCase) || ex.Message.Contains("401"))
                expired = true;
            else
                errorMessage = ex.Message;
            return;
        }
        catch (HttpRequestException)
        {
            saving = false;
            errorMessage = "Unable to reach the server. Please try again.";
            return;
        }

        // The temporary session is spent; sign in properly with the password just chosen.
        var outcome = await AuthService.LoginAsync(identifier!, newPassword);
        if (!outcome.Success)
        {
            saving = false;
            errorMessage = "Your password was set. Please sign in with it.";
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }
        Navigation.NavigateTo(SafeReturnUrl(), forceLoad: true);
    }

    private async Task SignOutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private string SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/') || ReturnUrl.StartsWith("//")
            || ReturnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase) || ReturnUrl.StartsWith("/set-password", StringComparison.OrdinalIgnoreCase))
            return "/";
        return ReturnUrl;
    }
}
