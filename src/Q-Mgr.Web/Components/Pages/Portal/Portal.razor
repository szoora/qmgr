    private string FirstName
    {
        get
        {
            var name = portal?.Me.FullName ?? me?.FullName ?? "";
            var first = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            return string.IsNullOrEmpty(first) ? "there" : first;
        }
    }

    private static string Greeting => DateTime.Now.Hour switch
