    private IReadOnlyList<QBarItem> BreakdownBars => portal == null
        ? Array.Empty<QBarItem>()
        : portal.Score.Breakdown
            .OrderByDescending(b => b.Weight)
            .Select(b => new QBarItem(
                b.Name,
                b.Score ?? 0,
                // "75 / 100 · 4 records · weight 3" — or, with nothing logged, say so in words.
                Count: b.Score.HasValue
                    ? $"{b.Score.Value:0.#} / 100 · {b.EvidenceCount} {(b.EvidenceCount == 1 ? "record" : "records")} · weight {b.Weight:0.#}"
                    : $"No evidence yet · weight {b.Weight:0.#}",
                Color: b.Color ?? StaffDisplay.KindColor(b.Kind)))
            .ToList();

