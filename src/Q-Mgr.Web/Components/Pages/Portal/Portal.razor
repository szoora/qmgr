    // ---- Recognition -------------------------------------------------------------------------

    private async Task OpenGiveDialog()
    {
        giveModel = new GiveRecognitionRequest();
        giveSubjectId = null;
        giveParameterId = null;
        giveErrors.Clear();
        showGive = true;
        if (!colleagues.Any())
        {
            try
            {
                colleagues = await StaffApi.GetColleaguesAsync();
            }
            catch (Exception ex)
            {
                Toast.Notify(ToastSeverity.Error, "Could not load your colleagues", ex.Message);
            }
        }
    }

    private async Task GiveRecognitionAsync()
    {
        if (portal == null) return;
        giveErrors.Clear();
        if (giveSubjectId is null || giveSubjectId == Guid.Empty) giveErrors.Add("subject");
        if (giveParameterId is null || giveParameterId == Guid.Empty) giveErrors.Add("parameter");
        giveModel.SubjectUserId = giveSubjectId ?? Guid.Empty;
        giveModel.ParameterId = giveParameterId ?? Guid.Empty;
        if ((giveModel.Message?.Trim().Length ?? 0) < 10) giveErrors.Add("message");
        if (giveErrors.Any()) return;

        giving = true;
        try
        {
            await StaffApi.GiveRecognitionAsync(portal.BranchId, giveModel);
            showGive = false;
            Toast.Notify(ToastSeverity.Success, "Recognition sent", "Your colleague has been told.");
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not send recognition", ex.Message);
        }
        finally
        {
            giving = false;
        }
    }

    // ---- Records -----------------------------------------------------------------------------

    private void OpenRespond(StaffPerformanceRecordDto record)
    {
        respondTarget = record;
        respondBody = string.Empty;
        respondError = false;
        showRespond = true;
    }

    private async Task RespondAsync()
    {
        if (portal == null || respondTarget == null) return;
        respondError = (respondBody?.Trim().Length ?? 0) < 2;
        if (respondError) return;

        responding = true;
        try
        {
            await StaffApi.RespondAsync(portal.BranchId, respondTarget.Id, new AddStaffNoteRequest { Body = respondBody.Trim() });
            showRespond = false;
            Toast.Notify(ToastSeverity.Success, "Response added", "It is now part of the record's chronology.");
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not add your response", ex.Message);
        }
        finally
        {
            responding = false;
        }
    }

    private async Task AcknowledgeRecordAsync(Guid id)
    {
        if (portal == null) return;
        busyRecordId = id;
        try
        {
            await StaffApi.AcknowledgeAsync(portal.BranchId, id);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not mark the record as seen", ex.Message);
        }
        finally
        {
            busyRecordId = null;
        }
    }

    // ---- Export ------------------------------------------------------------------------------

    /// <summary>
    /// The subject-access export. IDataExportService is column-shaped (one row per item) and this
    /// file is a nested document, so it goes to the browser through the same qmgrExport.saveText
    /// the export service itself uses — one save path, no second mechanism.
    /// </summary>
    private async Task ExportMyFileAsync()
    {
        exporting = true;
        try
        {
            var file = await StaffApi.ExportMyFileAsync();
            var json = JsonSerializer.Serialize(file, new JsonSerializerOptions(JsonOptions) { WriteIndented = true });
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("qmgrExport.saveText", json, "application/json", $"my-staff-file-{stamp}.json");
            Toast.Notify(ToastSeverity.Success, "Your file is downloading",
                $"{file.Records.Count} record(s), {file.Appraisals.Count} appraisal(s), {file.Activity.Count} activity event(s)."
                + (string.IsNullOrEmpty(file.DataProtectionOfficerContact) ? "" : $" Data protection contact: {file.DataProtectionOfficerContact}."));
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not export your file", ex.Message);
        }
        finally
        {
            exporting = false;
        }
    }

