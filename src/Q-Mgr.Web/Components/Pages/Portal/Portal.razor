    private IEnumerable<StaffNoticeDto> OrderedNotices => portal == null
        ? Enumerable.Empty<StaffNoticeDto>()
        : portal.Notices
            .OrderByDescending(n => n.RequiresAcknowledgement && n.AcknowledgedByMeAt == null)
            .ThenByDescending(n => n.IsPinned)
            .ThenByDescending(n => n.PublishAt);

