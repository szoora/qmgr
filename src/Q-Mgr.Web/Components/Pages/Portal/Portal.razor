@page "/portal"
@implements IDisposable
@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Admin.Staff
@inject IStaffPerformanceApiService StaffApi
@inject IToastService Toast
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject INotificationClientService NotificationHub
@inject IAuthService AuthService
@inject IJSRuntime JS
@inject JsonSerializerOptions JsonOptions

<PageTitle>My Workspace - Q-Mgr</PageTitle>

@*
    The staff member's own landing page (plan §10). Mobile-first: one column under 760px, two
    above. Everything here is the caller's own file — the API's portal hub answers for the signed-in
    user only, so there is no permission gate beyond the module, and nothing on this page ever shows
    another person's rank or score.
*@

<div class="admin-page portal-page">
    @if (isLoading)
    {
        <div class="loading-container"><QSpinner Size="lg" /><span>Loading your portal...</span></div>
    }
    else if (portal == null)
    {
        <QEmptyState Icon="person-badge" Title="Workspace unavailable"
                     Text="@(loadError ?? "The staff performance service did not answer. Try again in a moment.")">
            <Action><QButton Text="Try again" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadAsync" /></Action>
        </QEmptyState>
    }
    else
    {
        var score = portal.Score;

        <div class="page-header portal-header">
            <div class="header-content portal-greeting">
                <QAvatar Name="@portal.Me.FullName" Size="lg" />
                <div>
                    <h1>@Greeting, @FirstName</h1>
                    <p class="subtitle">
                        @score.Period.Name · @QDateFormat.Range(score.Period.Start, score.Period.End)
                        @if (!string.IsNullOrEmpty(portal.Me.JobTitle)) { <span> · @portal.Me.JobTitle</span> }
                        @if (portal.Me.DepartmentNames.Any()) { <span> · @string.Join(", ", portal.Me.DepartmentNames)</span> }
                    </p>
                    <div class="portal-band-row">
                        @if (score.Band.HasValue)
                        {
                            <QChip Text="@(score.BandName ?? $"Band {score.Band}")" Icon="award" Variant="@StaffDisplay.BandVariant(score.Band)" />
                        }
                        else
                        {
                            <QChip Text="No band yet" Icon="hourglass" Variant="muted" Title="No evidence yet" />
                        }
                        @if (score.RankInBranch.HasValue && score.RankedOutOf.HasValue)
                        {
                            <span class="portal-rank">Your position: @score.RankInBranch of @score.RankedOutOf</span>
                        }
                    </div>
                </div>
            </div>
            <div class="header-actions portal-ring-wrap" aria-label="Composite score">
                @{
                    var pct = score.Composite.HasValue ? Math.Clamp((int)Math.Round(score.Composite.Value), 0, 100) : 0;
                }
                <div class="portal-ring @(score.Composite.HasValue ? "" : "portal-ring--empty")" style="--pct: @pct;">
                    <div class="portal-ring__hole">
                        <span class="portal-ring__value">@StaffDisplay.Composite(score.Composite)</span>
                        <span class="portal-ring__label">composite</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!portal.Onboarding.IsComplete)
        {
            <OnboardingChecklistCard Checklist="@portal.Onboarding" OnChanged="@LoadAsync" />
        }

        <QStatRow Class="portal-stats">
            <QStatTile Value="@score.Points.ToString("N0")" Label="Points this period" Icon="lightning-charge" Variant="primary" />
            <QStatTile Value="@($"{score.DutiesAttended} / {score.DutiesExpected}")" Label="Duties attended" Icon="calendar-check"
                       Variant="@(score.DutiesExpected > 0 && score.DutiesAttended < score.DutiesExpected ? "warning" : "success")" />
            <QStatTile Value="@score.RecognitionReceived.ToString("N0")" Label="Recognition received" Icon="award" Variant="success" />
            <QStatTile Value="@portal.OpenItems.Count.ToString("N0")" Label="Open items" Icon="list-check"
                       Variant="@(portal.OpenItems.Any(i => i.IsOverdue) ? "danger" : "default")" />
        </QStatRow>

        @* ---- THE TABS -------------------------------------------------------------------
             My Workspace was one scroll of sixteen cards behind a single GetPortalAsync() that
             returned nine collections. On Blazor Server every one of those cards is diffed and
             shipped down a SignalR circuit on each render, so the cost is paid on the school's
             connection whether or not anybody scrolls that far.

             A hub IS the lazy loading: a section renders only when its tab is open, which is the
             rule the Staff and Administration hubs already follow. HubTabs owns ?tab=, so every
             tab deep-links and a notification can point at the part of the page it is about. *@
        <QTabs Tabs="@PortalTabs" ActiveKey="@hubTab" ActiveKeyChanged="@OnTabChanged" AriaLabel="My Workspace" />

        @* ---- TODAY ---------------------------------------------------------------------- *@
        @if (hubTab == "today")
        {
        @* ---- Coming up ---------------------------------------------------------------------- *@
        @* ---- My Day (duty rota plan §7.2, §10): today's lessons at a glance; the full day is /my-day ---- *@
        @if (myDay != null && (myDay.Lessons.Any() || myDay.Unrecorded.Any() || myDay.RecoveryOwed.Any()))
        {
            var toRecord = myDay.Lessons.Count(l => l.Status == LessonStatus.Unrecorded) + myDay.Unrecorded.Count;
            <QCard id="my-day" Title="My School Day" Subtitle="@MyDaySubtitle" Icon="sunrise" Class="portal-card">
                @if (myDay.NextLessonStartsAt is { } next && myDay.Lessons.FirstOrDefault(l => l.StartsAt == next) is { } nextLesson)
                {
                    <p class="portal-myday-next"><QIcon Name="hourglass-split" Size="sm" /> Next: <strong>@nextLesson.ClassName · @nextLesson.SubjectName</strong> at @QDateFormat.LocalT(next)@(string.IsNullOrEmpty(nextLesson.Room) ? "" : $", {nextLesson.Room}")</p>
                }
                @if (toRecord > 0)
                {
                    <p class="portal-myday-owed"><QIcon Name="question-circle" Size="sm" /> @(toRecord == 1 ? "1 lesson" : $"{toRecord} lessons") to mark taught or not taught</p>
                }
                @if (myDay.RecoveryOwed.Any())
                {
                    <p class="portal-myday-owed"><QIcon Name="arrow-repeat" Size="sm" /> @(myDay.RecoveryOwed.Count == 1 ? "1 missed lesson" : $"{myDay.RecoveryOwed.Count} missed lessons") to recover</p>
                }
                <div class="portal-duty__actions">
                    <QButton Text="Open my school day" Icon="box-arrow-in-right" Size="sm" Variant="primary" OnClick="@(() => Navigation.NavigateTo("/my-day"))" />
                </div>
            </QCard>
        }

        <QCard Title="Coming up" Subtitle="Duties you are expected at" Icon="calendar-event" Class="portal-card">
            @if (!portal.ComingUp.Any())
            {
                <QEmptyState Icon="calendar-check" Title="Nothing scheduled" Text="No duties are coming up for you in the next while." Class="q-empty--compact" />
            }
            else
            {
                <ul class="portal-list">
                    @foreach (var duty in portal.ComingUp.OrderBy(d => d.StartsAt))
                    {
                        <li class="portal-duty">
                            <div class="portal-duty__main">
                                <strong>@duty.Title</strong>
                                <span class="portal-duty__when">
                                    <QIcon Name="clock" Size="sm" /> @QDateFormat.LocalDT(duty.StartsAt)
                                    @if (!string.IsNullOrEmpty(duty.Location)) { <span> · <QIcon Name="geo-alt" Size="sm" /> @duty.Location</span> }
                                </span>
                                <span class="portal-duty__param">
                                    <QChip Text="@duty.ParameterName" Size="sm" Color="@StaffDisplay.KindColor(duty.ParameterKind)" />
                                    @if (duty.MyOutcome.HasValue && duty.MyOutcome != DutyOutcome.NotApplicable)
                                    {
                                        <QChip Text="@StaffDisplay.OutcomeLabel(duty.MyOutcome.Value)" Size="sm" Variant="@StaffDisplay.OutcomeVariant(duty.MyOutcome.Value)" />
                                    }
                                </span>
                            </div>
                            @if (duty.CanIRecord)
                            {
                                <div class="portal-duty__actions">
                                    <QButton Text="Take register" Icon="clipboard-check" Size="sm" Variant="primary"
                                             OnClick="@(() => Navigation.NavigateTo($"/admin/staff/duties/{duty.Id}/register"))" />
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
        </QCard>

        @* ---- On duty (duty rota plan §4.2, §10): rota slots I am on or supervise ------------------- *@
        @if (portal.OnDuty.Any())
        {
            <QCard id="on-duty" Title="On duty" Subtitle="Your rota slots, now and in the next two weeks" Icon="shield-check" Class="portal-card">
                <ul class="portal-list">
                    @foreach (var slot in portal.OnDuty.OrderBy(d => d.StartsAt))
                    {
                        var underWay = slot.StartsAt <= DateTime.UtcNow;
                        <li class="portal-duty">
                            <div class="portal-duty__main">
                                <strong>@slot.Title</strong>
                                <span class="portal-duty__when">
                                    <QIcon Name="calendar-week" Size="sm" />
                                    @QDateFormat.LocalDT(slot.StartsAt) – @QDateFormat.LocalDT(slot.EndsAt)
                                    @if (!string.IsNullOrEmpty(slot.Location)) { <span> · <QIcon Name="geo-alt" Size="sm" /> @slot.Location</span> }
                                </span>
                                <span class="portal-duty__param">
                                    @if (slot.IsSupervisedByMe)
                                    {
                                        <QChip Text="@($"You supervise: {string.Join(", ", slot.ExpectedNames)}")" Size="sm" Variant="info" Icon="person-badge" />
                                    }
                                    else
                                    {
                                        @if (slot.MyAcknowledgedAt.HasValue)
                                        {
                                            <QChip Text="Acknowledged" Size="sm" Variant="success" Icon="check2" />
                                        }
                                        else
                                        {
                                            <QChip Text="Not yet acknowledged" Size="sm" Variant="warning" />
                                        }
                                        @if (slot.SupervisorNames.Any()) { <QChip Text="@($"Supervised by {string.Join(", ", slot.SupervisorNames)}")" Size="sm" Variant="muted" /> }
                                    }
                                    @if (underWay) { <QChip Text="Under way" Size="sm" Variant="primary" /> }
                                </span>
                            </div>
                            <div class="portal-duty__actions">
                                @if (!slot.IsSupervisedByMe && !slot.MyAcknowledgedAt.HasValue)
                                {
                                    <QButton Text="Seen — I'm on duty" Icon="check2-circle" Size="sm" Variant="primary" Loading="@(busyDutyId == slot.Id)" OnClick="@(() => AcknowledgeDutyAsync(slot))" />
                                }
                                @if (slot.CanIRecord && underWay)
                                {
                                    <QButton Text="Close out" Icon="clipboard-check" Size="sm" Variant="secondary" OnClick="@(() => Navigation.NavigateTo($"/admin/staff/duties/{slot.Id}/register"))" />
                                }
                            </div>
                        </li>
                    }
                </ul>
            </QCard>
        }

        @* ---- Reports to write (duty rota plan §4.3, §10) ------------------------------------------ *@
        @if (portal.ReportsToWrite.Any())
        {
            <QCard id="duty-reports" Title="Reports to write" Subtitle="Duty reports for periods that have started" Icon="journal-text" Class="portal-card">
                <ul class="portal-list">
                    @foreach (var rep in portal.ReportsToWrite.OrderBy(r => r.DueAt))
                    {
                        <li class="portal-duty">
                            <div class="portal-duty__main">
                                <strong>@rep.DutyTitle</strong>
                                <span class="portal-duty__when"><QIcon Name="calendar3" Size="sm" /> @DutyReportPage.PeriodText(rep) · due @QDateFormat.LocalDT(rep.DueAt)</span>
                                <span class="portal-duty__param">
                                    <QChip Text="@DutyReportPage.StatusLabel(rep.Status)" Size="sm" Variant="@DutyReportPage.StatusVariant(rep.Status)" />
                                    @if (rep.IsOverdue) { <QChip Text="Overdue" Size="sm" Variant="danger" /> }
                                    @if (rep.AuthorRole == DutyReportAuthorRole.Supervisor) { <QChip Text="As administrator on duty" Size="sm" Variant="muted" /> }
                                </span>
                            </div>
                            <div class="portal-duty__actions">
                                <QButton Text="@(rep.Status == DutyReportStatus.Returned ? "Correct" : "Write")" Icon="pencil" Size="sm" Variant="primary"
                                         OnClick="@(() => Navigation.NavigateTo($"/admin/staff/duty-reports/{rep.Id}"))" />
                            </div>
                        </li>
                    }
                </ul>
            </QCard>
        }

        <div class="portal-grid">
            @* ---- Reminders & to-do ---------------------------------------------------------- *@
            <QCard Title="Reminders & to-do" Subtitle="What you still owe, soonest first" Icon="list-check" Class="portal-card">
                @if (!portal.OpenItems.Any())
                {
                    <QEmptyState Icon="check2-circle" Title="Nothing open" Text="Anything waiting on you — a register, a response, a notice to acknowledge — will appear here." />
                }
                else
                {
                    <ul class="portal-list">
                        @foreach (var item in portal.OpenItems.OrderBy(i => i.DueAt ?? DateTime.MaxValue))
                        {
                            <li class="portal-item @(item.IsOverdue ? "portal-item--overdue" : "")">
                                <QIcon Name="@ItemIcon(item.Kind)" Class="portal-item__icon" />
                                <div class="portal-item__main">
                                    <a href="@item.Url">@item.Title</a>
                                    @if (!string.IsNullOrEmpty(item.Detail)) { <span class="portal-item__detail">@item.Detail</span> }
                                </div>
                                <div class="portal-item__due">
                                    @if (item.IsOverdue)
                                    {
                                        <QChip Text="Overdue" Size="sm" Variant="danger" Icon="exclamation-circle" />
                                    }
                                    @if (item.DueAt.HasValue)
                                    {
                                        @* A record waiting to be seen is not due anything: it was LOGGED on that date. A signed appraisal was SIGNED. *@
                                        <span class="portal-item__date">@ItemDateLabel(item.Kind) @QDateFormat.D(Local(item.DueAt.Value))</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </QCard>

            @* ---- Notices --------------------------------------------------------------------- *@
            <QCard Title="Notices" Subtitle="Awaiting you first, then pinned" Icon="megaphone" Class="portal-card">
                @if (!portal.Notices.Any())
                {
                    <QEmptyState Icon="megaphone" Title="No notices" Text="Notices published to your branch, department or role will appear here." />
                }
                else
                {
                    <div class="portal-notices">
                        @foreach (var notice in OrderedNotices.Take(showAllNotices ? int.MaxValue : NoticesShown))
                        {
                            var needsAck = notice.RequiresAcknowledgement && notice.AcknowledgedByMeAt == null;
                            <article class="portal-notice @(notice.IsPinned ? "portal-notice--pinned" : "") @(needsAck ? "portal-notice--ack" : "")">
                                <header class="portal-notice__head">
                                    <h4><a href="/portal/notices/@notice.Id">@notice.Title</a></h4>
                                    <span class="portal-notice__chips">
                                        @if (notice.IsPinned) { <QChip Text="Pinned" Icon="pin-angle" Size="sm" Variant="primary" /> }
                                        @if (notice.RequiresAcknowledgement)
                                        {
                                            if (notice.AcknowledgedByMeAt.HasValue)
                                            {
                                                <QChip Text="@($"Acknowledged {QDateFormat.D(Local(notice.AcknowledgedByMeAt.Value))}")" Icon="check2" Size="sm" Variant="success" />
                                            }
                                            else
                                            {
                                                <QChip Text="Acknowledgement required" Icon="hand-index" Size="sm" Variant="warning" />
                                            }
                                        }
                                    </span>
                                </header>
                                <div class="portal-notice__body">@((MarkupString)notice.BodyHtml)</div>
                                @if (notice.Attachments.Any())
                                {
                                    <div class="portal-notice__attachments">
                                        @foreach (var a in notice.Attachments)
                                        {
                                            <QChip Text="@a.Name" Icon="paperclip" Size="sm" Variant="muted" Href="@a.FileUrl" />
                                        }
                                    </div>
                                }
                                <footer class="portal-notice__meta">
                                    <span>@notice.PublishedByName · @QDateFormat.D(Local(notice.PublishAt))</span>
                                    @if (needsAck)
                                    {
                                        <QButton Text="Acknowledge" Icon="check2-circle" Size="sm" Variant="primary"
                                                 Loading="@(busyNoticeId == notice.Id)" OnClick="@(() => AcknowledgeNoticeAsync(notice.Id))" />
                                    }
                                </footer>
                            </article>
                        }
                    </div>
                    @if (portal.Notices.Count > NoticesShown)
                    {
                        <div class="portal-more">
                            <QButton Text="@(showAllNotices ? "Show fewer" : $"Show {portal.Notices.Count - NoticesShown} more")"
                                     Icon="@(showAllNotices ? "chevron-up" : "chevron-down")" Size="sm" Variant="ghost"
                                     OnClick="@(() => showAllNotices = !showAllNotices)" />
                        </div>
                    }
                }
            </QCard>

        </div>
        }

        @* ---- MY TEACHING --------------------------------------------------------------
             What this person teaches, when they teach it, and — where the school allows it —
             what they may change about that themselves. The self-service section loads only
             when this tab is opened, which is the whole reason the page has tabs at all. *@
        @if (hubTab == "teaching")
        {
        @* ---- My teaching (duty rota plan §10): hidden for somebody who teaches nothing ------------- *@
        <TeachingSummaryCard BranchId="@portal.BranchId" HideWhenEmpty="true" Class="portal-card" />
        <MyTimetableCard BranchId="@portal.BranchId" UserId="@portal.Me.UserId" Class="portal-card" />

            <SelfServiceSection BranchId="@portal.BranchId" />
        }

        @* ---- MY PERFORMANCE ------------------------------------------------------------ *@
        @if (hubTab == "performance")
        {
        <div class="portal-grid">
            @* ---- My breakdown ---------------------------------------------------------------- *@
            <QCard Title="My breakdown" Subtitle="Score per parameter, out of 100, with its weight" Icon="bar-chart-line" Class="portal-card">
                @if (!score.Breakdown.Any())
                {
                    <QEmptyState Icon="bar-chart-line" Title="No evidence yet" Text="Your breakdown fills in as records, registers and recognition are logged this period." />
                }
                else
                {
                    <QBarList Items="@BreakdownBars" Max="100" Stacked="true" />
                }
            </QCard>

            @* ---- Recognition ----------------------------------------------------------------- *@
            <QCard Title="Recognition" Subtitle="@RecognitionSubtitle" Icon="award" Class="portal-card">
                <HeaderActions>
                    @if (portal.RecognitionBudget.Parameters.Any())
                    {
                        <QButton Text="Give recognition" Icon="gift" Size="sm" Variant="primary" OnClick="@OpenGiveDialog"
                                 Disabled="@(portal.RecognitionBudget.Remaining == 0)" />
                    }
                </HeaderActions>
                <ChildContent>
                    <div class="portal-recognition">
                        <section>
                            <h5>Received</h5>
                            @if (!portal.RecognitionReceived.Any())
                            {
                                <p class="portal-muted">Nobody has recognised you yet this period.</p>
                            }
                            else
                            {
                                <ul class="portal-list portal-list--tight">
                                    @foreach (var r in portal.RecognitionReceived.OrderByDescending(r => r.OccurredAt))
                                    {
                                        <li class="portal-recog">
                                            <QAvatar Name="@r.LoggedByName" Size="sm" />
                                            <div>
                                                <strong>@r.LoggedByName</strong> <span class="portal-muted">@QDateFormat.D(Local(r.OccurredAt))</span>
                                                <p>@r.Description</p>
                                            </div>
                                            @if (r.Points.HasValue) { <QChip Text="@StaffDisplay.Points(r.Points)" Size="sm" Variant="success" /> }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                        <section>
                            <h5>Given</h5>
                            @if (!portal.RecognitionGiven.Any())
                            {
                                <p class="portal-muted">You have not recognised a colleague yet this month.</p>
                            }
                            else
                            {
                                <ul class="portal-list portal-list--tight">
                                    @foreach (var r in portal.RecognitionGiven.OrderByDescending(r => r.OccurredAt))
                                    {
                                        <li class="portal-recog">
                                            <QAvatar Name="@r.SubjectName" Size="sm" />
                                            <div>
                                                <strong>@r.SubjectName</strong> <span class="portal-muted">@QDateFormat.D(Local(r.OccurredAt))</span>
                                                <p>@r.Description</p>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>
                </ChildContent>
            </QCard>
        </div>

        @* ---- How the school is doing (the tenant's leaderboard mode; plan §1.5, decision 2) ------- *@
        @if (portal.LeaderboardMode != LeaderboardMode.Private && (portal.DepartmentBoard.Any() || portal.Leaderboard.Any()))
        {
            <QCard Title="@(portal.LeaderboardMode == LeaderboardMode.Public ? "Leaderboard" : "Departments this term")"
                   Subtitle="@($"{score.Period.Name} · average composite by department")" Icon="trophy" Class="portal-card">
                <div class="portal-boards">
                    @if (portal.DepartmentBoard.Any())
                    {
                        <section>
                            @if (portal.LeaderboardMode == LeaderboardMode.Public)
                            {
                                <h5>Departments</h5>
                            }
                            <QBarList Items="@DepartmentBars" Max="100" Stacked="true" />
                            <p class="portal-muted portal-boards__foot">Teams of three or more only, so an average is never one person's score.</p>
                        </section>
                    }
                    @if (portal.LeaderboardMode == LeaderboardMode.Public && portal.Leaderboard.Any())
                    {
                        <section>
                            <h5>Top @portal.Leaderboard.Count</h5>
                            <ol class="portal-leaders">
                                @foreach (var row in portal.Leaderboard.OrderBy(r => r.Rank))
                                {
                                    <li class="portal-leader @(row.UserId == portal.Me.UserId ? "portal-leader--me" : "")">
                                        <span class="portal-leader__rank">@row.Rank</span>
                                        <div class="portal-leader__main">
                                            <strong>@row.Name</strong>
                                            @if (!string.IsNullOrEmpty(row.DepartmentName)) { <span class="portal-muted">@row.DepartmentName</span> }
                                        </div>
                                        <QChip Text="@($"{row.BandName} · {StaffDisplay.Composite(row.Composite)}")" Size="sm" Variant="@StaffDisplay.BandVariant(row.Band)" />
                                    </li>
                                }
                            </ol>
                        </section>
                    }
                </div>
            </QCard>
        }

        }

        @* ---- MY FILE ------------------------------------------------------------------ *@
        @if (hubTab == "file")
        {
        @* ---- My details ---------------------------------------------------------------------
             The staff record the school holds, and the contact half I maintain myself. Until
             2026-09-19 nothing in the product could show a person their own file. *@
        <MyDetailsCard />

        @* ---- My timeline -------------------------------------------------------------------- *@
        <QCard id="my-timeline" Title="My timeline" Subtitle="Records about you, newest first" Icon="journal-text" Class="portal-card">
            <HeaderActions>
                @if (portal.UnacknowledgedRecords > 0)
                {
                    <QChip Text="@($"{portal.UnacknowledgedRecords} not yet seen")" Icon="eye" Size="sm" Variant="warning" />
                    @if (portal.UnacknowledgedRecords > 1)
                    {
                        <QButton Text="Mark all as seen" Icon="check2-all" Size="sm" Variant="secondary" OnClick="@MarkAllSeen" Loading="@markingAll" />
                    }
                }
            </HeaderActions>
            <ChildContent>
                @* Paged — see QTimelinePaging. *@
                <QTimeline GroupByDay="true" EmptyText="No records yet this period."
                           HasMore="@paging.HasMore(portal.RecentRecords.Count)" OnLoadOlder="@paging.ShowMore"
                           LoadOlderText="@($"Show older ({portal.RecentRecords.Count - paging.Shown} left)")">
                    @foreach (var record in portal.RecentRecords.OrderByDescending(r => r.OccurredAt).Take(paging.Shown))
                    {
                        <QTimelineItem MarkerColor="@(record.ParameterColor ?? StaffDisplay.KindColor(record.ParameterKind))"
                                       MarkerIcon="@StaffDisplay.KindIcon(record.ParameterKind)"
                                       Date="@Local(record.OccurredAt)"
                                       Modifier="@(record.Status == StaffRecordStatus.Annulled ? "annulled" : record.Status == StaffRecordStatus.Draft ? "draft" : null)">
                            <TitleContent>
                                <a class="portal-record-link" href="/portal/records/@record.Id"><strong>@record.ParameterName</strong></a>
                                @if (record.Outcome != DutyOutcome.NotApplicable)
                                {
                                    <QChip Text="@StaffDisplay.OutcomeLabel(record.Outcome)" Size="sm" Variant="@StaffDisplay.OutcomeVariant(record.Outcome)" />
                                }
                                @if (record.Points.HasValue && record.Points != 0)
                                {
                                    <QChip Text="@StaffDisplay.Points(record.Points)" Size="sm" Variant="@(record.Points > 0 ? "success" : "danger")" />
                                }
                                @if (record.Rating.HasValue)
                                {
                                    <QChip Text="@($"{record.Rating} / {record.RatingScale ?? 5}")" Icon="star-fill" Size="sm" Variant="info" />
                                }
                                @if (record.Visibility != WelfareVisibility.Standard)
                                {
                                    <QChip Text="@StaffDisplay.VisibilityLabel(record.Visibility)" Icon="lock-fill" Size="sm" Variant="@StaffDisplay.VisibilityVariant(record.Visibility)" />
                                }
                                @if (record.Source == RecordSource.System)
                                {
                                    <QChip Text="@StaffDisplay.SourceLabel(record.Source)" Icon="cpu" Size="sm" Variant="muted" Title="Credited automatically by the system, not by a colleague" />
                                }
                                @if (record.Status == StaffRecordStatus.Annulled)
                                {
                                    <QChip Text="Annulled" Size="sm" Variant="muted" />
                                }
                            </TitleContent>
                            <ChildContent>
                                <p class="portal-record__desc">@record.Description</p>
                                @if (!string.IsNullOrWhiteSpace(record.ParameterPurpose))
                                {
                                    <p class="portal-purpose"><QIcon Name="info-circle" Size="sm" /> Why this is kept: @record.ParameterPurpose</p>
                                }
                                @if (!string.IsNullOrEmpty(record.DutyTitle))
                                {
                                    <p class="portal-muted"><QIcon Name="calendar-event" Size="sm" /> @record.DutyTitle</p>
                                }
                                @if (record.Notes.Any())
                                {
                                    <div class="portal-notes">
                                        @foreach (var note in record.Notes.OrderBy(n => n.CreatedAt))
                                        {
                                            <div class="portal-note portal-note--@note.Kind.ToString().ToLowerInvariant()">
                                                <span class="portal-note__who">@note.AuthorName <em>· @NoteKindLabel(note.Kind) · @QDateFormat.LocalDT(note.CreatedAt)</em></span>
                                                <p>@note.Body</p>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (record.Attachments.Any())
                                {
                                    <div class="portal-attachments">
                                        @foreach (var a in record.Attachments)
                                        {
                                            <QChip Text="@a.FileName" Icon="paperclip" Size="sm" Variant="muted" Href="@a.FileUrl" />
                                        }
                                    </div>
                                }
                            </ChildContent>
                            <MetaContent>
                                <span>@StaffDisplay.SourceLabel(record.Source) by @record.LoggedByName · @QDateFormat.LocalDT(record.CreatedAt)</span>
                                @if (record.IsLateEntry) { <span class="portal-late"> · Late entry</span> }
                                @if (record.AcknowledgedAt.HasValue) { <span> · Seen @QDateFormat.D(Local(record.AcknowledgedAt.Value))</span> }
                            </MetaContent>
                            <Actions>
                                @if (record.Status != StaffRecordStatus.Annulled)
                                {
                                    <QButton Text="Respond" Icon="reply" Size="sm" Variant="ghost" OnClick="@(() => OpenRespond(record))" />
                                    @if (record.AcknowledgedAt == null)
                                    {
                                        <QButton Text="Mark as seen" Icon="eye" Size="sm" Variant="secondary"
                                                 Loading="@(busyRecordId == record.Id)" OnClick="@(() => AcknowledgeRecordAsync(record.Id))" />
                                    }
                                }
                            </Actions>
                        </QTimelineItem>
                    }
                </QTimeline>
            </ChildContent>
        </QCard>

        @* ---- Appraisal ---------------------------------------------------------------------- *@
        <QCard Title="Appraisal" Subtitle="@score.Period.Name" Icon="clipboard2-check" Class="portal-card">
            @if (portal.Appraisal == null)
            {
                <QEmptyState Icon="clipboard2-check" Title="No appraisal open" Text="When your appraiser opens one, its stage and what it needs from you will show here." />
            }
            else
            {
                var ap = portal.Appraisal;
                <div class="portal-appraisal">
                    <div class="portal-appraisal__main">
                        <QChip Text="@StaffDisplay.StageLabel(ap.Stage)" Variant="@StaffDisplay.StageVariant(ap.Stage)" />
                        <span class="portal-muted">Appraiser: @ap.AppraiserName · @QDateFormat.Range(ap.PeriodStart, ap.PeriodEnd)</span>
                        <p class="portal-appraisal__owe">@AppraisalOwe(ap)</p>
                    </div>
                    <div class="portal-appraisal__actions">
                        <QButton Text="Open" Icon="box-arrow-up-right" Variant="primary" Size="sm"
                                 OnClick="@(() => Navigation.NavigateTo($"/portal/appraisals/{ap.Id}"))" />
                    </div>
                </div>
            }
        </QCard>

        @* ---- Activity on my file: the subject-access trail (who viewed, exported, changed it) ---- *@
        <QCard Title="Activity on my file" Subtitle="Who has viewed, exported or changed your records" Icon="eye" Class="portal-card">
            <QActivityLog Rows="@MyActivityRows" Loading="@(activityLoading && myActivity == null)" TableTitle="Recent actions"
                          RetentionNote="@MyActivityRetention" EmptyText="Nobody has done anything to your file yet." />
            @if (myActivity != null && myActivity.TotalCount > ActivityPageSize)
            {
                <QPager Count="@myActivity.TotalCount" PageSize="@ActivityPageSize" PageIndex="@activityPageIndex" PageIndexChanged="@OnActivityPageChanged" ItemLabel="actions" />
            }
        </QCard>

        }

        <footer class="portal-footer">
            <a href="/notifications"><QIcon Name="bell" Size="sm" /> Notification centre</a>
            <a href="/profile/notifications"><QIcon Name="sliders" Size="sm" /> Preferences</a>
            <QButton Text="Export my file" Icon="download" Variant="ghost" Size="sm" Loading="@exporting" OnClick="@ExportMyFileAsync" />
        </footer>
    }
</div>

@* ---- Give recognition ---------------------------------------------------------------------- *@
<QModal @bind-Visible="showGive" Title="Give recognition" Icon="gift" Size="md">
    <ChildContent>
        @if (portal != null)
        {
            <p class="form-hint">@portal.RecognitionBudget.Remaining of @portal.RecognitionBudget.MonthlyBudget left this month. The colleague is told at once and it shows on both your feeds.</p>
        }
        <div class="form-group">
            <QSelect TValue="Guid?" TItem="StaffColleagueDto" @bind-Value="@giveSubjectId" Items="@colleagues"
                     TextSelector="@(c => string.IsNullOrEmpty(c.JobTitle) ? c.FullName : $"{c.FullName} — {c.JobTitle}")"
                     ValueSelector="@(c => (Guid?)c.UserId)" Label="Colleague" Required="true" Placeholder="Who are you recognising?"
                     HasError="@giveErrors.Contains("subject")" ErrorMessage="Choose a colleague" />
        </div>
        <div class="form-group">
            <QSelect TValue="Guid?" TItem="PerformanceParameterDto" @bind-Value="@giveParameterId"
                     Items="@(portal?.RecognitionBudget.Parameters ?? new())"
                     TextSelector="@(p => p.Name)" ValueSelector="@(p => (Guid?)p.Id)" Label="For" Required="true" Placeholder="What did they do?"
                     HasError="@giveErrors.Contains("parameter")" ErrorMessage="Choose what you are recognising them for" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@giveModel.Message" Type="textarea" Rows="4" Label="Why" Required="true" MaxLength="1000"
                    Placeholder="Say what they did and why it mattered (at least 10 characters)"
                    HasError="@giveErrors.Contains("message")" ErrorMessage="Write at least 10 characters" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showGive = false)" />
        <QButton Text="Send recognition" Icon="send" Variant="primary" Loading="@giving" OnClick="@GiveRecognitionAsync" />
    </FooterContent>
</QModal>

@* ---- Respond to a record ------------------------------------------------------------------- *@
<QModal @bind-Visible="showRespond" Title="Respond to this record" Icon="reply" Size="md">
    <ChildContent>
        @if (respondTarget != null)
        {
            <p class="form-hint"><strong>@respondTarget.ParameterName</strong> · @QDateFormat.LocalDT(respondTarget.OccurredAt) · logged by @respondTarget.LoggedByName</p>
            <p class="portal-record__desc">@respondTarget.Description</p>
        }
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@respondBody" Type="textarea" Rows="5" Label="Your response" Required="true" MaxLength="4000"
                    Placeholder="Your response is added to the record's chronology and cannot be edited afterwards."
                    HasError="@respondError" ErrorMessage="Write at least 2 characters" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showRespond = false)" />
        <QButton Text="Send response" Icon="send" Variant="primary" Loading="@responding" OnClick="@RespondAsync" />
    </FooterContent>
</QModal>

<style>
    /* No width cap here: this page is a TABLE of data, and a data-driven page uses the width it
       has. Reported 2026-09-18 with Duties & Registers sitting in an 1100px column on a 1900px
       screen. A page that shows ONE document keeps a reading width — see CLAUDE.md. */
    .portal-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .portal-greeting { display: flex; align-items: center; gap: 16px; min-width: 0; }
    .portal-greeting h1 { margin: 0 0 4px; color: var(--qm-text-primary); }
    .portal-band-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .portal-rank { font-size: var(--qm-text-base); color: var(--qm-text-secondary); }

    /* Composite ring: a conic-gradient on the outer disc with a plain background declared first as
       the fallback for a browser without it; the inner hole carries the card colour. */
    .portal-ring { --pct: 0; width: 96px; height: 96px; border-radius: 50%; padding: 8px; flex: 0 0 auto;
                   background: var(--qm-bg-secondary);
                   background: conic-gradient(var(--qm-primary) calc(var(--pct) * 1%), var(--qm-bg-secondary) 0); }
    .portal-ring--empty { background: var(--qm-bg-secondary); }
    .portal-ring__hole { width: 100%; height: 100%; border-radius: 50%; background: var(--qm-bg-card); display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .portal-ring__value { font-family: var(--qm-font-display); font-weight: 700; font-size: var(--qm-text-stat); line-height: 1; color: var(--qm-text-primary); }
    .portal-ring__label { font-size: var(--qm-text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--qm-text-muted); margin-top: 2px; }

    .portal-stats { margin-bottom: 16px; }
    .portal-card { margin-bottom: 16px; }
    .portal-grid { display: grid; grid-template-columns: 1fr; gap: 0 16px; }
    @@media (min-width: 760px) { .portal-grid { grid-template-columns: 1fr 1fr; } }
    .portal-grid > * { min-width: 0; }

    .portal-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .portal-list--tight { gap: 8px; }
    .portal-muted { color: var(--qm-text-muted); font-size: var(--qm-text-base); margin: 0; }

    .portal-duty { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 12px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); }
    .portal-duty__main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .portal-duty__when { font-size: var(--qm-text-base); color: var(--qm-text-secondary); }
    .portal-duty__param { display: flex; gap: 6px; flex-wrap: wrap; }
    .portal-duty__actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .portal-myday-next, .portal-myday-owed { display: flex; align-items: center; gap: 6px; margin: 0 0 8px; font-size: var(--qm-text-base); }
    .portal-myday-owed { color: var(--qm-text-secondary); }

    .portal-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--qm-border); }
    .portal-item:last-child { border-bottom: 0; }
    .portal-item__icon { color: var(--qm-primary); margin-top: 2px; }
    .portal-item--overdue .portal-item__icon { color: var(--qm-danger); }
    .portal-item__main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .portal-item__main a { color: var(--qm-text-primary); font-weight: 600; text-decoration: none; }
    .portal-item__main a:hover { color: var(--qm-primary); }
    .portal-item__detail { font-size: var(--qm-text-base); color: var(--qm-text-muted); }
    .portal-item__due { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: var(--qm-text-sm); color: var(--qm-text-muted); }

    .portal-notices { display: flex; flex-direction: column; gap: 12px; }
    .portal-notice { border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 12px 14px; background: var(--qm-bg-card); }
    .portal-notice--pinned { border-left: 3px solid var(--qm-primary); }
    .portal-notice--ack { border-color: var(--qm-warning); }
    .portal-notice__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .portal-notice__head h4 { margin: 0; font-size: var(--qm-text-md); }
    .portal-notice__head h4 a { color: var(--qm-text-primary); text-decoration: none; }
    .portal-notice__chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .portal-notice__body { margin: 8px 0; font-size: var(--qm-text-base); color: var(--qm-text-secondary); overflow-wrap: anywhere; }
    .portal-notice__body img { max-width: 100%; }
    .portal-notice__attachments, .portal-attachments { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
    .portal-notice__meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; font-size: var(--qm-text-sm); color: var(--qm-text-muted); margin-top: 8px; }

    /* Received above given, never side by side: the card is already half the page wide, and two
       columns inside it wrapped every name three times (seen in Chrome, 2026-09-16). */
    .portal-recognition { display: grid; grid-template-columns: 1fr; gap: 16px; }
    .portal-more { display: flex; justify-content: center; margin-top: 10px; }
    .portal-recog .portal-muted { display: block; font-size: var(--qm-text-sm); }
    .portal-recognition h5 { margin: 0 0 8px; font-size: var(--qm-text-sm); text-transform: uppercase; letter-spacing: 0.06em; color: var(--qm-text-muted); }
    .portal-recog { display: flex; align-items: flex-start; gap: 10px; }
    .portal-recog > div { flex: 1; min-width: 0; font-size: var(--qm-text-base); }
    .portal-recog p { margin: 2px 0 0; color: var(--qm-text-secondary); }

    .portal-purpose { margin: 0 0 6px; font-size: var(--qm-text-sm); color: var(--qm-text-muted); display: flex; gap: 6px; align-items: flex-start; }
    .portal-boards { display: grid; grid-template-columns: 1fr; gap: 16px; }
    @@media (min-width: 760px) { .portal-boards { grid-template-columns: 1fr 1fr; } }
    .portal-boards > section { min-width: 0; }
    .portal-boards h5 { margin: 0 0 8px; font-size: var(--qm-text-sm); text-transform: uppercase; letter-spacing: 0.06em; color: var(--qm-text-muted); }
    .portal-boards__foot { margin-top: 8px; font-size: var(--qm-text-sm); }
    .portal-leaders { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .portal-leader { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 6px 0; border-bottom: 1px solid var(--qm-border); }
    .portal-leader:last-child { border-bottom: 0; }
    .portal-leader--me strong { color: var(--qm-primary); }
    .portal-leader__rank { flex: 0 0 28px; font-family: var(--qm-font-display); font-weight: 700; color: var(--qm-text-secondary); text-align: center; }
    .portal-leader__main { flex: 1 1 140px; min-width: 0; display: flex; flex-direction: column; font-size: var(--qm-text-base); }
    .portal-record-link { color: inherit; text-decoration: none; }
    .portal-record-link:hover strong { color: var(--qm-primary); }
    .portal-record__desc { margin: 0 0 6px; color: var(--qm-text-primary); white-space: pre-wrap; overflow-wrap: anywhere; }
    .portal-late { color: var(--qm-warning); }
    .portal-notes { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; }
    .portal-note { padding: 8px 10px; border-left: 2px solid var(--qm-border); background: var(--qm-bg-secondary); border-radius: 0 var(--qm-radius-sm) var(--qm-radius-sm) 0; font-size: var(--qm-text-base); }
    .portal-note--response { border-left-color: var(--qm-primary); }
    .portal-note--annulment { border-left-color: var(--qm-danger); }
    .portal-note__who { font-weight: 600; color: var(--qm-text-primary); }
    .portal-note__who em { font-weight: 400; font-style: normal; color: var(--qm-text-muted); }
    .portal-note p { margin: 4px 0 0; color: var(--qm-text-secondary); white-space: pre-wrap; }

    .portal-appraisal { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .portal-appraisal__main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .portal-appraisal__owe { margin: 0; color: var(--qm-text-primary); }
    .portal-appraisal__actions { display: flex; gap: 8px; flex-wrap: wrap; }

    .portal-footer { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 12px 0 24px; border-top: 1px solid var(--qm-border); font-size: var(--qm-text-base); }
    .portal-footer a { color: var(--qm-text-secondary); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .portal-footer a:hover { color: var(--qm-primary); }

    .loading-container { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--qm-text-muted); background: var(--qm-bg-card); border-radius: var(--qm-radius-xl); border: 1px solid var(--qm-border); }
    .form-hint { font-size: var(--qm-text-base); color: var(--qm-text-muted); margin: 0 0 12px; }
</style>

@code {
    // ---- The hub -----------------------------------------------------------------------------
    //
    // FOUR TABS, and a section renders only when its own tab is open. That is the lazy loading: on
    // Blazor Server every card's render tree is diffed and shipped down a SignalR circuit, so a
    // sixteen-card scroll pays for all sixteen on every render whether or not anybody reads that far.
    //
    // No permission gates on these tabs, unlike the Staff and Administration hubs: every one of them
    // is the caller's OWN file, and self is always visible and is not scope.
    private const string TodayTab = "today";
    private const string TeachingTab = "teaching";
    private const string PerformanceTab = "performance";
    private const string FileTab = "file";

    private static readonly IReadOnlyList<QTab> PortalTabs = new[]
    {
        new QTab(TodayTab, "Today", "sunrise"),
        new QTab(TeachingTab, "My teaching", "easel"),
        new QTab(PerformanceTab, "My performance", "graph-up"),
        new QTab(FileTab, "My file", "folder2-open"),
    };

    private string hubTab = TodayTab;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    /// <summary>The last ?tab= this hub ACTED ON — never the active tab, or clicking a tab snaps
    /// the reader back to whatever the URL still said. See HubTabs.FollowQuery.</summary>
    private string? appliedTab;

    protected override void OnParametersSet()
    {
        HubTabs.FollowQuery(PortalTabs, TabParam, ref appliedTab, ref hubTab);
    }

    /// <summary>
    /// A tab click writes the URL as well as the state, so the address bar always says which part of
    /// the page is open — which is what makes a notification able to point at one.
    /// </summary>
    private void OnTabChanged(string key)
    {
        hubTab = key;
        appliedTab = key;
        Navigation.NavigateTo(key == TodayTab ? "/portal" : $"/portal?tab={key}", replace: true);
    }

    private bool isLoading = true;
    private string? loadError;
    private StaffPortalDto? portal;

    /// <summary>How much of my timeline is rendered — see QTimelinePaging.</summary>
    private readonly QTimelinePaging paging = new();
    private UserInfo? me;

    private bool showGive;
    private bool giving;
    private GiveRecognitionRequest giveModel = new();
    private Guid? giveSubjectId;
    private Guid? giveParameterId;
    private readonly HashSet<string> giveErrors = new();
    private List<StaffColleagueDto> colleagues = new();

    private bool showRespond;
    private bool responding;
    private bool respondError;
    private string respondBody = string.Empty;
    private StaffPerformanceRecordDto? respondTarget;

    private const int ActivityPageSize = 10;
    private ActivityLogPageDto? myActivity;
    private bool activityLoading;
    private int activityPageIndex;

    private Guid? busyRecordId;
    private Guid? busyDutyId;

    /// <summary>"Seen — I'm on duty": stops the pre-duty reminders for this person (plan §4.2).</summary>
    private async Task AcknowledgeDutyAsync(StaffDutyDto slot)
    {
        if (portal == null) return;
        busyDutyId = slot.Id;
        try
        {
            await StaffApi.AcknowledgeDutyAsync(portal.BranchId, slot.Id);
            Toast.Notify(ToastSeverity.Success, "Acknowledged", "The reminders for this duty have stopped.");
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not acknowledge", ex.Message);
        }
        finally
        {
            busyDutyId = null;
        }
    }
    private Guid? busyNoticeId;
    private bool exporting;

    protected override async Task OnInitializedAsync()
    {
        NotificationHub.OnStaffScoreUpdated -= HandleScoreUpdated;
        NotificationHub.OnStaffScoreUpdated += HandleScoreUpdated;

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
        {
            Navigation.NavigateTo(BillingLinks.Modules);
            return;
        }

        me = await AuthService.GetCurrentUserAsync();
        await LoadAsync();
        if (portal != null) await LoadMyActivityAsync();
    }

    /// <summary>
    /// The trail on the caller's own file. GetMyActivityAsync existed from the first build and nothing
    /// called it, so the portal — the subject-access view — never showed who had looked at the file.
    /// A failure here is quiet: the rest of the portal is still right.
    /// </summary>
    private async Task LoadMyActivityAsync()
    {
        activityLoading = true;
        try
        {
            myActivity = await StaffApi.GetMyActivityAsync(activityPageIndex + 1, ActivityPageSize);
        }
        catch
        {
            myActivity ??= new ActivityLogPageDto();
        }
        finally
        {
            activityLoading = false;
        }
    }

    private async Task OnActivityPageChanged(int index)
    {
        activityPageIndex = index;
        await LoadMyActivityAsync();
    }

    private IReadOnlyList<QActivityRow> MyActivityRows => myActivity?.Items
        .Select(a => new QActivityRow(Local(a.OccurredAt), a.ActorName ?? "System", a.Summary, null,
            string.Join(" · ", new[] { a.IpAddress, a.UserAgent }.Where(x => !string.IsNullOrWhiteSpace(x)))))
        .ToList() ?? new List<QActivityRow>();

    private string? MyActivityRetention => myActivity == null || myActivity.AttributionRetentionDays <= 0
        ? null
        : $"The address and browser on each action are removed after {myActivity.AttributionRetentionDays} days; the action itself stays.";

    private IReadOnlyList<QBarItem> DepartmentBars => portal == null
        ? Array.Empty<QBarItem>()
        : portal.DepartmentBoard
            .Where(d => d.AverageComposite.HasValue)
            .OrderByDescending(d => d.AverageComposite)
            .Select(d => new QBarItem(
                d.Name,
                d.AverageComposite!.Value,
                Count: $"{d.AverageComposite.Value:0.#} · {d.StaffCount} staff"))
            .ToList();

    private MyDayDto? myDay;

    private string MyDaySubtitle => myDay == null ? "" : myDay.Lessons.Count(l => l.Status != LessonStatus.Cancelled) switch
    {
        0 => "No lessons today",
        1 => "1 lesson today",
        var n => $"{n} lessons today"
    };

    /// <summary>My Day is a nicety on the portal: if it cannot load, the portal still does.</summary>
    private async Task LoadMyDayAsync()
    {
        if (portal == null) return;
        try { myDay = await StaffApi.GetMyDayAsync(portal.BranchId); }
        catch { myDay = null; }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            portal = await StaffApi.GetPortalAsync();
            paging.Reset();
            await LoadMyDayAsync();
        }
        catch (Exception ex)
        {
            portal = null;
            loadError = ex.Message;
            Toast.Notify(ToastSeverity.Error, "Could not load your portal", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    /// <summary>A quiet refresh after an action: keeps the page in place rather than showing the spinner again.</summary>
    private async Task RefreshAsync()
    {
        try
        {
            portal = await StaffApi.GetPortalAsync();
            paging.Reset();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not refresh your portal", ex.Message);
        }
    }

    private async Task HandleScoreUpdated(StaffScoreUpdatedEvent e)
    {
        if (portal == null || e.UserId != portal.Me.UserId) return;
        await InvokeAsync(async () =>
        {
            // The event carries the figures the tile shows; the band NAME and the breakdown need
            // the full hub, so the tile updates at once and the rest follows on a quiet refresh.
            var bandName = e.Band == portal.Score.Band ? portal.Score.BandName : (e.Band.HasValue ? $"Band {e.Band}" : null);
            portal = portal with
            {
                Score = portal.Score with { Composite = e.Composite, Points = e.Points, Band = e.Band, BandName = bandName }
            };
            StateHasChanged();
            await RefreshAsync();
            StateHasChanged();
        });
    }

