@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@inject IStaffPerformanceApiService StaffApi
@inject IAccountApiService Account
@inject IToastService Toast

@*
    My own contact detail, and what the school holds about me (2026-09-19, split 2026-09-25).

    THE ONE HOME FOR A PERSON'S OWN CONTACT DETAIL. It is on My file, and — for a tenant without
    Welfare & Performance, which has no My Workspace — on the account page with ShowEmployment off.
    One component and one endpoint (api/v1/profile/contact, no module), so a phone number is edited
    in exactly one place. The account page used to edit the phone through a second writer with a
    different rule, which is how a changed number kept its old confirmation.

      I may edit      phone, second phone, office, emergency contact name and number.
      I may READ      employment dates and terms, qualification, registration number, employee
                      number, job title, department, line manager (the portal's read; the module
                      is on wherever this half shows).
      nobody here     role, permissions, branch. RoleAssignmentGuard owns those.

    UpdateStaffContactRequest has nowhere to put an employment field, so the endpoint cannot be
    persuaded to write one. This card is the explanation of that rule, not the thing enforcing it.
*@

<QCard id="my-details" Title="@(ShowEmployment ? "My details" : "Contact details")"
       Subtitle="@(ShowEmployment ? "What the school has on file for you" : "How people at work reach you")"
       Icon="person-vcard" Class="portal-card">
    <HeaderActions>
        @if (!editing && contact is not null)
        {
            <QButton Text="Edit" Icon="pencil" Size="sm" Variant="secondary" OnClick="StartEdit" />
        }
    </HeaderActions>
    <ChildContent>
        @if (isLoading)
        {
            <div class="md-loading"><QSpinner Size="sm" /><span>Loading your details…</span></div>
        }
        else if (contact is null)
        {
            <QEmptyState Icon="person-x" Title="Details unavailable" Text="Reload the page, or tell an administrator if it keeps happening." />
        }
        else if (editing)
        {
            <div class="form-row">
                <div class="form-group">
                    <QInput TValue="string" Label="Phone" @bind-Value="form.Phone" Placeholder="0770 000 000"
                            Hint="A new number has to be confirmed again with a code: password resets by text go to it." />
                </div>
                <div class="form-group">
                    <QInput TValue="string" Label="Second phone" @bind-Value="form.AlternatePhone" Placeholder="Staff room or out of hours" />
                </div>
                <div class="form-group">
                    <QInput TValue="string" Label="Where to find you" @bind-Value="form.OfficeLocation" Placeholder="Staff room B" />
                </div>
                <div class="form-group">
                    <QInput TValue="string" Label="Emergency contact" @bind-Value="form.EmergencyContactName" Placeholder="Who to call about you" />
                </div>
                <div class="form-group">
                    <QInput TValue="string" Label="Emergency number" @bind-Value="form.EmergencyContactPhone" />
                </div>
            </div>
            <div class="form-actions md-actions">
                <QButton Text="Cancel" Variant="ghost" OnClick="CancelEdit" />
                <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="Save" Loading="@isSaving" />
            </div>
        }
        else
        {
            <dl class="md-list">
                <div class="md-phone">
                    <dt>Phone</dt>
                    <dd>
                        <span>@Show(contact.Phone)</span>
                        @if (!string.IsNullOrWhiteSpace(contact.Phone))
                        {
                            @if (contact.PhoneVerifiedAt.HasValue)
                            {
                                <QChip Text="Confirmed" Icon="check2" Variant="success" Size="sm" />
                            }
                            else
                            {
                                <QChip Text="Not confirmed" Variant="warning" Size="sm" />
                                <PhoneConfirm SendText="Confirm" OnConfirmed="LoadAsync" />
                            }
                        }
                    </dd>
                </div>
                <div><dt>Second phone</dt><dd>@Show(contact.AlternatePhone)</dd></div>
                <div><dt>Where to find you</dt><dd>@Show(contact.OfficeLocation)</dd></div>
                <div><dt>Emergency contact</dt><dd>@Show(contact.EmergencyContactName)</dd></div>
                <div><dt>Emergency number</dt><dd>@Show(contact.EmergencyContactPhone)</dd></div>
            </dl>

            @if (ShowEmployment && profile is not null)
            {
                <div class="md-sep">
                    <span>
                        Held by the school
                        <QInfo Label="Held by the school" Align="right"
                               Text="Your employment record is part of the school's own file and its MoES staff return, so an administrator maintains it rather than you. If something here is wrong, tell them — it is theirs to correct, and every change is recorded." />
                    </span>
                </div>

                <dl class="md-list md-list--locked">
                    <div><dt>Name</dt><dd>@Show(profile.FullName)</dd></div>
                    <div><dt>Job title</dt><dd>@Show(profile.JobTitle)</dd></div>
                    <div><dt>Role</dt><dd>@Show(profile.RoleName)</dd></div>
                    <div><dt>Department</dt><dd>@(profile.DepartmentNames.Count == 0 ? "—" : string.Join(", ", profile.DepartmentNames))</dd></div>
                    <div><dt>Line manager</dt><dd>@Show(profile.LineManagerName)</dd></div>
                    <div><dt>Staff number</dt><dd>@Show(profile.EmployeeNumber)</dd></div>
                    <div><dt>Terms</dt><dd>@(profile.EmploymentType ?? "—")</dd></div>
                    <div><dt>Appointed</dt><dd>@(profile.EmploymentStartDate.HasValue ? QDateFormat.D(profile.EmploymentStartDate.Value) : "—")</dd></div>
                    @if (profile.EmploymentEndDate.HasValue)
                    {
                        <div><dt>Leaving</dt><dd>@QDateFormat.D(profile.EmploymentEndDate.Value)</dd></div>
                    }
                    <div><dt>Qualification</dt><dd>@Show(profile.Qualification)</dd></div>
                    <div><dt>Registration number</dt><dd>@Show(profile.TeachingRegistrationNumber)</dd></div>
                </dl>
            }
        }
    </ChildContent>
</QCard>

<style>
    .md-loading { display: flex; align-items: center; gap: 8px; color: var(--qm-text-muted); font-size: var(--qm-text-base); }
    .md-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px 20px; margin: 0; }
    .md-list div { display: flex; flex-direction: column; min-width: 0; }
    .md-list dt { margin: 0; font-size: var(--qm-text-xs); color: var(--qm-text-muted); }
    .md-list dd { margin: 0; font-size: var(--qm-text-base); overflow-wrap: anywhere; }
    .md-list .md-phone dd { display: flex; align-items: center; gap: var(--q-row-gap); flex-wrap: wrap; }
    .md-list--locked dd { color: var(--qm-text-secondary); }
    .md-sep { display: flex; align-items: center; gap: 8px; margin: 14px 0 8px; font-size: var(--qm-text-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--qm-text-muted); }
    .md-sep span { display: inline-flex; align-items: center; gap: 4px; }
    .md-sep::after { content: ""; flex: 1; height: 1px; background: var(--qm-border); }
    .md-actions { margin-top: 12px; justify-content: flex-end; }
</style>

@code {
    /// <summary>
    /// Whether to show the school's employment record under the contact detail. On for My file; off
    /// on the account page, which shows this card only for a tenant without My Workspace — and
    /// there the portal's read (which needs the module) is never called.
    /// </summary>
    [Parameter] public bool ShowEmployment { get; set; } = true;

    private StaffContactDto? contact;
    private StaffProfileDto? profile;
    private UpdateStaffContactRequest form = new();
    private bool isLoading = true, isSaving, editing;

    private static string Show(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            contact = await Account.GetContactAsync();
            if (ShowEmployment)
            {
                try { profile = await StaffApi.GetMyProfileAsync(); }
                catch (Exception) { profile = null; /* the contact half still works without it */ }
            }
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not load your details", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartEdit()
    {
        if (contact is null) return;
        form = new UpdateStaffContactRequest
        {
            Phone = contact.Phone,
            AlternatePhone = contact.AlternatePhone,
            OfficeLocation = contact.OfficeLocation,
            EmergencyContactName = contact.EmergencyContactName,
            EmergencyContactPhone = contact.EmergencyContactPhone
        };
        editing = true;
    }

    private void CancelEdit() => editing = false;

    private async Task Save()
    {
        isSaving = true;
        try
        {
            contact = await Account.UpdateContactAsync(form);
            editing = false;
            Toast.Notify(ToastSeverity.Success, "Your details are updated", "Thank you — this is how people reach you.");
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not save your details", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }
}
