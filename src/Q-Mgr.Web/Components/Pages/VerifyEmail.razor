@page "/verify"
@layout PublicLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<VerifyEmail> Logger

<QPageTitle Text="Verify Email" />

@*
    THE SAME SHELL AS EVERY OTHER IDENTITY PAGE (2026-09-22). This page had a card of its own —
    .verify-container / .verify-card / its own .logo-circle — and was wrong twice for it, the same
    two ways GetApp was before it was reused onto this shell:

      * UNBRANDED. It never applied Host.BrandingStyle, which is the inline style that points
        --qm-primary at the TENANT's colour. So a school arriving from its own verification email
        met the vendor's wine disc one click from its own crest, and the Host it had cascaded all
        along was read by nothing on the page.
      * A SECOND SET OF CARD STYLES, which is what drifts. login-container / login-card /
        QBrandMark cannot.

    QBrandMark shows the school's logo where there is one and falls back to this page's own state
    icon where there is not — the pattern ResetPassword and JoinStaff already use for their success
    and failure states. On a tenant host the crest wins over the tick, deliberately: the HEADING
    says which state this is, and the mark says whose site it is.
*@
<div class="login-container" style="@Host.BrandingStyle">
    <AmbientBackground />
    <div class="login-card">
        @if (state == VerifyState.Verifying)
        {
            <div class="login-header">
                <QBrandMark Heading="Verifying your email…" FallbackIcon="envelope-fill"
                            Tagline="This will just take a moment." />
            </div>
        }
        else if (state == VerifyState.Success)
        {
            <div class="login-header">
                <QBrandMark Heading="Email verified" FallbackIcon="check-circle-fill" Tagline="@message" />
            </div>
            <QButton Text="Continue to Login" Variant="primary" Block="true" OnClick="@GoToLogin" />
        }
        else if (state == VerifyState.MissingLink)
        {
            <div class="login-header">
                <QBrandMark Heading="Invalid link" FallbackIcon="exclamation-circle-fill"
                            Tagline="This link is missing the information needed to verify your account. If you copied it from an email, make sure the whole link came through." />
            </div>
            <QButton Text="Go to Login" Variant="primary" Block="true" OnClick="@GoToLogin" />
        }
        else
        {
            <div class="login-header">
                <QBrandMark Heading="Verification failed" FallbackIcon="exclamation-circle-fill"
                            Tagline="@message" />
            </div>

            @if (!resendComplete)
            {
                <div class="resend-section">
                    <label for="resend-email">Get a new verification link</label>
                    <div class="resend-row">
                        <input id="resend-email"
                               type="email"
                               class="form-control"
                               placeholder="you@company.com"
                               @bind="resendEmail"
                               disabled="@isResending" />
                        <QButton Text="@(isResending ? "Sending..." : "Resend")" Variant="secondary"
                                 OnClick="@ResendVerification"
                                 Disabled="@(isResending || string.IsNullOrWhiteSpace(resendEmail))" />
                    </div>
                </div>
            }
            else
            {
                <p class="resend-confirm">
                    If an account exists with that email, a new verification link is on its way.
                </p>
            }

            <QButton Text="Back to Login" Variant="link" Class="back-link" OnClick="@GoToLogin" />
        }

        @* The footer every sibling carries. No auth-doors row: the button above it already IS the
           way back to sign-in in all three states, and a second copy one line down would be the
           duplication the two-doors fix was about. *@
        <div class="login-footer">
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <span>•</span>
                <a href="/terms">Terms of Service</a>
                <span>•</span>
                <a href="/support">Support</a>
            </div>
            @* The copyright, not the attribution line — see Login.razor. QCopyright reads the host itself. *@
            <QCopyright Class="login-copyright" />
        </div>
    </div>
</div>

<style>
    /* Everything here is scoped under .login-container, like the rest of auth-pages.css and for the
       same reason GetApp states: these names are generic enough to collide with the dashboard's own.
       The card, the header, the heading and the form control are all gone from this file — they are
       auth-pages.css's now, which is the whole point of moving onto the shared shell. Dropping the
       local .form-control mattered most: unscoped, it would have fought the sign-in pages' own. */
    .login-container .back-link {
        margin-top: 16px;
    }

    .login-container .resend-section {
        text-align: left;
        margin-bottom: 8px;
    }

    .login-container .resend-section label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--qm-text-primary);
        margin-bottom: 8px;
    }

    .login-container .resend-row {
        display: flex;
        gap: 8px;
    }

    .login-container .resend-row .form-control {
        flex: 1;
    }

    .login-container .resend-confirm {
        margin: 0;
        color: var(--qm-text-muted);
        font-size: var(--qm-text-base);
        line-height: 1.5;
    }
</style>

@code {
    /// <summary>
    /// Which host the browser arrived on, cascaded by App.razor. On a public page the branding comes
    /// from the HOST and never from a session — there is nobody signed in to ask.
    /// </summary>
    [CascadingParameter] public QMgr.Web.Services.TenantHostContext Host { get; set; }
        = QMgr.Web.Services.TenantHostContext.Platform;

    private enum VerifyState { Verifying, Success, Failed, MissingLink }

    private VerifyState state = VerifyState.Verifying;
    private string? message;
    private string? resendEmail;
    private bool isResending;
    private bool resendComplete;

    [SupplyParameterFromQuery(Name = "org")]
    private Guid? OrganizationId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private HttpClient Http => HttpClientFactory.CreateClient("QMgrAuthApi");
    private bool verifyStarted;

    // Deliberately NOT in OnInitializedAsync: this app's Routes render with
    // RenderMode.InteractiveServer (App.razor), which prerenders every page as static HTML
    // before the interactive circuit connects — OnInitializedAsync runs once for each, i.e.
    // twice per page load. A verification token is single-use, so the first (prerender) call
    // silently verified the account while the second (interactive) call then hit an
    // already-verified org and reported failure — the user saw "Verification failed" for a
    // verification that had, in fact, already succeeded. Found live: the DB showed
    // VerifiedAt set immediately after loading a real link that displayed as failed.
    // OnAfterRenderAsync(firstRender) only fires once per real circuit — never during
    // prerendering — which is the standard fix for this exact class of bug.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || verifyStarted) return;
        verifyStarted = true;

        if (OrganizationId is null || OrganizationId == Guid.Empty || string.IsNullOrWhiteSpace(Token))
        {
            state = VerifyState.MissingLink;
            StateHasChanged();
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/register/verify", new
            {
                organizationId = OrganizationId.Value,
                token = Token
            });

            var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();

            if (response.IsSuccessStatusCode && result?.Success == true)
            {
                state = VerifyState.Success;
                message = result.Message ?? "Your email has been verified successfully!";
            }
            else
            {
                state = VerifyState.Failed;
                message = result?.Message ?? "The verification link is invalid or has expired.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Email verification error");
            state = VerifyState.Failed;
            message = "Unable to connect to the server. Please try again in a moment.";
        }

        StateHasChanged();
    }

    private async Task ResendVerification()
    {
        if (string.IsNullOrWhiteSpace(resendEmail)) return;

        isResending = true;
        try
        {
            await Http.PostAsJsonAsync("api/v1/register/resend-verification", new { email = resendEmail });
            resendComplete = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resend verification error");
        }
        finally
        {
            isResending = false;
        }
    }

    private void GoToLogin()
    {
        var url = state == VerifyState.Success ? "/login?verified=true" : "/login";
        Navigation.NavigateTo(url, forceLoad: true);
    }

    private record VerifyResponse
    {
        public bool Success { get; init; }
        public string? Slug { get; init; }
        public string? Message { get; init; }
        public string? RedirectUrl { get; init; }
    }
}
