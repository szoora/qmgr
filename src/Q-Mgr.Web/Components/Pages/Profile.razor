    .action-item i:first-child {
        font-size: 18px;
        color: var(--qm-text-muted);
    }

    .action-item span {
        flex: 1;
    }

    .action-item i:last-child {
        font-size: 14px;
        color: var(--qm-text-muted);
    }

    .action-item.logout:hover {
        background: color-mix(in srgb, var(--qm-danger) 10%, transparent);
        border-color: color-mix(in srgb, var(--qm-danger) 30%, transparent);
    }

    .action-item.logout i:first-child {
        color: var(--qm-danger);
    }

    /* Not Found State */
    .not-found {
        text-align: center;
        padding: 60px 20px;
    }

    .not-found i {
        font-size: 64px;
        color: var(--qm-text-muted);
        margin-bottom: 16px;
    }

    .not-found p {
        color: var(--qm-text-muted);
        margin-bottom: 24px;
    }

    /* Modal Styling */
    .modal-content {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        color: var(--qm-text-primary);
    }

    .modal-header {
        border-bottom-color: var(--qm-border);
    }

    .modal-footer {
        border-top-color: var(--qm-border);
    }

    .form-label {
        color: var(--qm-text-primary);
        font-weight: 500;
    }

    .form-control {
        background: var(--qm-bg-elevated);
        border-color: var(--qm-border);
        color: var(--qm-text-primary);
    }

    .form-control:focus {
        background: var(--qm-bg-elevated);
        border-color: var(--qm-primary);
        color: var(--qm-text-primary);
        box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--qm-primary) 25%, transparent);
    }

    .form-control::placeholder {
        color: var(--qm-text-muted);
    }

    .btn-close {
        filter: invert(1);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .profile-container {
            grid-template-columns: 1fr;
        }

        .profile-header {
            flex-direction: column;
            text-align: center;
        }

        .btn-edit {
            position: static;
            margin-top: 16px;
        }

        .actions-card {
            position: static;
        }
    }
</style>

@code {
    private ProfileDto? profile;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isChangingPassword = false;

    // Edit Profile
    private bool showEditModal = false;
    private EditProfileModel editModel = new();

    // Change Password
    private bool showPasswordModal = false;
    private ChangePasswordModel passwordModel = new();
    private string passwordError = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user != null)
            {
                // Load full profile from API
                var response = await Http.GetAsync($"api/v1/profile?userId={user.Id}");
                if (response.IsSuccessStatusCode)
                {
                    profile = await response.Content.ReadFromJsonAsync<ProfileDto>(JsonOptions);
                }
                else
                {
                    // Fallback to basic user info
                    profile = new ProfileDto
                    {
                        Id = user.Id,
                        Username = user.Username,
                        Email = user.Email,
                        FullName = user.FullName ?? "",
                        Role = user.RoleName
                    };
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetRoleClass(string role)
    {
        return role?.ToLower() switch
        {
            "admin" => "admin",
            "superadmin" => "superadmin",
            "manager" => "manager",
            "staff" => "staff",
            _ => "viewer"
        };
    }

    // Edit Profile
    private void OpenEditModal()
    {
        if (profile == null) return;

        editModel = new EditProfileModel
        {
            FirstName = profile.FirstName,
            LastName = profile.LastName,
            Email = profile.Email,
            Phone = profile.Phone
        };
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private async Task SaveProfile()
    {
        if (profile == null) return;

        isSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/profile?userId={profile.Id}", new
            {
                FirstName = editModel.FirstName,
                LastName = editModel.LastName,
                Email = editModel.Email,
                Phone = editModel.Phone
            }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                profile = await response.Content.ReadFromJsonAsync<ProfileDto>(JsonOptions);
                showEditModal = false;
                NotificationService.Notify(ToastSeverity.Success, "Success", "Profile updated successfully");

                // Update local storage with new info
                await UpdateLocalUserInfo();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to update profile");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task UpdateLocalUserInfo()
    {
        if (profile == null) return;

        // Re-fetch current user and update local storage
        // The AuthService stores user info in local storage
        // For now, we'll just reload the profile
        await LoadProfile();
    }

    // Change Password
    private void OpenPasswordModal()
    {
        passwordModel = new ChangePasswordModel();
        passwordError = "";
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        passwordError = "";
    }

    private async Task ChangePassword()
    {
        if (profile == null) return;

        passwordError = "";

        // Client-side validation
        if (string.IsNullOrWhiteSpace(passwordModel.CurrentPassword))
        {
            passwordError = "Current password is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(passwordModel.NewPassword))
        {
            passwordError = "New password is required";
            return;
        }

        if (passwordModel.NewPassword.Length < 6)
        {
            passwordError = "New password must be at least 6 characters";
            return;
        }

        if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
        {
            passwordError = "Passwords do not match";
            return;
        }

        isChangingPassword = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/profile/password?userId={profile.Id}", new
            {
                CurrentPassword = passwordModel.CurrentPassword,
                NewPassword = passwordModel.NewPassword,
                ConfirmPassword = passwordModel.ConfirmPassword
            }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                showPasswordModal = false;
                NotificationService.Notify(ToastSeverity.Success, "Success", "Password changed successfully");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                try
                {
                    var problemDetails = JsonSerializer.Deserialize<ProblemDetails>(errorContent, JsonOptions);
                    passwordError = problemDetails?.Detail ?? "Failed to change password";
                }
                catch
                {
                    passwordError = "Failed to change password";
                }
            }
        }
        catch (Exception ex)
        {
            passwordError = $"Error: {ex.Message}";
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    // Models
    private class EditProfileModel
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
    }

    private class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    private record ProfileDto
    {
        public Guid Id { get; init; }
        public string Username { get; init; } = "";
        public string Email { get; init; } = "";
        public string? FirstName { get; init; }
        public string? LastName { get; init; }
        public string FullName { get; init; } = "";
        public string? Phone { get; init; }
        public string? EmployeeNumber { get; init; }
        public string Role { get; init; } = "";
        public Guid? AssignedBranchId { get; init; }
        public string? AssignedBranchName { get; init; }
        public DateTime? LastLogin { get; init; }
        public DateTime CreatedAt { get; init; }
    }

    private record ProblemDetails
    {
        public string? Title { get; init; }
        public string? Detail { get; init; }
        public int? Status { get; init; }
    }
}
