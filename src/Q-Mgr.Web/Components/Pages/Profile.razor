@page "/profile"
@inject IAuthService AuthService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IToastService NotificationService
@inject JsonSerializerOptions JsonOptions
@using System.Text.Json

<PageTitle>My Profile - Q-Mgr</PageTitle>

<div class="profile-page">
    <div class="page-header">
        <div class="header-content">
            <h1>My Profile</h1>
            <p class="subtitle">View and manage your account information</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
        </div>
    }
    else if (profile == null)
    {
        <div class="not-found">
            <i class="bi bi-person-x"></i>
            <p>Unable to load user information</p>
            <QButton Text="Go to Dashboard" Icon="speedometer2" OnClick="@(() => NavigationManager.NavigateTo("/"))" />
        </div>
    }
    else
    {
        <div class="profile-container">
            <!-- Profile Card -->
            <div class="profile-card">
                <div class="profile-header">
                    <div class="avatar-large">
                        <span>@GetInitials(profile.FullName ?? profile.Username)</span>
                    </div>
                    <div class="profile-info">
                        <h2>@(profile.FullName ?? profile.Username)</h2>
                        <span class="role-badge @GetRoleClass(profile.Role)">@profile.Role</span>
                    </div>
                    <button class="btn-edit" @onclick="OpenEditModal" title="Edit Profile">
                        <i class="bi bi-pencil"></i>
                    </button>
                </div>

                <div class="profile-details">
                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="detail-content">
                            <label>Username</label>
                            <span>@profile.Username</span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div class="detail-content">
                            <label>Email</label>
                            <span>@(string.IsNullOrEmpty(profile.Email) ? "Not set" : profile.Email)</span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div class="detail-content">
                            <label>Phone</label>
                            <span>@(string.IsNullOrEmpty(profile.Phone) ? "Not set" : profile.Phone)</span>
                        </div>
                    </div>

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div class="detail-content">
                            <label>Role</label>
                            <span>@profile.Role</span>
                        </div>
                    </div>

                    @if (profile.AssignedBranchName != null)
                    {
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="detail-content">
                                <label>Assigned Branch</label>
                                <span>@profile.AssignedBranchName</span>
                            </div>
                        </div>
                    }

                    @if (profile.EmployeeNumber != null)
                    {
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div class="detail-content">
                                <label>Employee Number</label>
                                <span>@profile.EmployeeNumber</span>
                            </div>
                        </div>
                    }

                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <div class="detail-content">
                            <label>Member Since</label>
                            <span>@profile.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    @if (profile.LastLogin.HasValue)
                    {
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="detail-content">
                                <label>Last Login</label>
                                <span>@profile.LastLogin.Value.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions Card -->
            <div class="actions-card">
                <h3>Account Actions</h3>
                <div class="actions-list">
                    <button class="action-item" @onclick="OpenEditModal">
                        <i class="bi bi-pencil-square"></i>
                        <span>Edit Profile</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="action-item" @onclick="OpenPasswordModal">
                        <i class="bi bi-key"></i>
                        <span>Change Password</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <hr />
                    <a href="/admin/settings" class="action-item">
                        <i class="bi bi-gear"></i>
                        <span>System Settings</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <button class="action-item logout" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Edit Profile Modal -->
<QModal @bind-Visible="showEditModal" Title="Edit Profile" Size="md">
    <ChildContent>
        <div class="form-group mb-3">
            <label class="form-label">First Name</label>
            <input type="text" class="form-control" @bind="editModel.FirstName" placeholder="Enter first name" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" class="form-control" @bind="editModel.LastName" placeholder="Enter last name" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" @bind="editModel.Email" placeholder="Enter email" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Phone</label>
            <input type="tel" class="form-control" @bind="editModel.Phone" placeholder="Enter phone number" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@CloseEditModal" />
        <QButton Text="Save Changes" Icon="check-lg" Variant="primary" OnClick="@SaveProfile" Disabled="@isSaving" Loading="@isSaving" />
    </FooterContent>
</QModal>

<!-- Change Password Modal -->
<QModal @bind-Visible="showPasswordModal" Title="Change Password" Size="md">
    <ChildContent>
        <div class="form-group mb-3">
            <label class="form-label">Current Password</label>
            <input type="password" class="form-control" @bind="passwordModel.CurrentPassword" placeholder="Enter current password" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">New Password</label>
            <input type="password" class="form-control" @bind="passwordModel.NewPassword" placeholder="Enter new password" />
            <small class="text-muted">Minimum 6 characters</small>
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Confirm New Password</label>
            <input type="password" class="form-control" @bind="passwordModel.ConfirmPassword" placeholder="Confirm new password" />
        </div>
        @if (!string.IsNullOrEmpty(passwordError))
        {
            <div class="alert alert-danger py-2">
                <i class="bi bi-exclamation-circle me-2"></i>@passwordError
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@ClosePasswordModal" />
        <QButton Text="Change Password" Icon="key-fill" Variant="primary" OnClick="@ChangePassword" Disabled="@isChangingPassword" Loading="@isChangingPassword" />
    </FooterContent>
</QModal>

<style>
    .profile-page {
        padding: 0;
    }

    .profile-container {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 24px;
        max-width: 1000px;
    }

    .profile-card,
    .actions-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 24px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--qm-border);
        margin-bottom: 24px;
        position: relative;
    }

    .avatar-large {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--qm-gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        color: var(--qm-text-on-primary);
        flex-shrink: 0;
    }

    .profile-info {
        flex: 1;
    }

    .profile-info h2 {
        margin: 0 0 8px;
        font-size: 24px;
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .btn-edit {
        position: absolute;
        top: 0;
        right: 0;
        width: 40px;
        height: 40px;
        border-radius: var(--qm-radius-lg);
        border: 1px solid var(--qm-border);
        background: var(--qm-bg-elevated);
        color: var(--qm-text-muted);
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-edit:hover {
        background: var(--qm-primary-light);
        border-color: var(--qm-primary);
        color: var(--qm-primary);
    }

    .role-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: var(--qm-radius-full);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .role-badge.admin,
    .role-badge.superadmin {
        background: var(--qm-primary-light);
        color: var(--qm-primary);
    }

    .role-badge.manager {
        background: color-mix(in srgb, var(--qm-info) 15%, transparent);
        color: var(--qm-info);
    }

    .role-badge.staff {
        background: color-mix(in srgb, var(--qm-success) 15%, transparent);
        color: var(--qm-success);
    }

    .role-badge.viewer {
        background: color-mix(in srgb, var(--qm-text-secondary) 15%, transparent);
        color: var(--qm-text-secondary);
    }

    .profile-details {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        background: var(--qm-primary-light);
        border-radius: var(--qm-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .detail-icon i {
        font-size: 18px;
        color: var(--qm-primary);
    }

    .detail-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .detail-content label {
        font-size: 12px;
        color: var(--qm-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-content span {
        font-size: 15px;
        color: var(--qm-text-primary);
    }

    /* Actions Card */
    .actions-card {
        height: fit-content;
        position: sticky;
        top: 24px;
    }

    .actions-card h3 {
        margin: 0 0 16px;
        font-size: 16px;
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .actions-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .actions-list hr {
        border: none;
        border-top: 1px solid var(--qm-border);
        margin: 8px 0;
    }

    .action-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: var(--qm-bg-elevated);
        border: 1px solid transparent;
        border-radius: var(--qm-radius-lg);
        color: var(--qm-text-primary);
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
        text-align: left;
        font-size: 14px;
    }

    .action-item:hover {
        background: var(--qm-primary-light);
        border-color: color-mix(in srgb, var(--qm-primary) 30%, transparent);
