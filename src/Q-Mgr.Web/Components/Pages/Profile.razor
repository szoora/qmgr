@page "/profile"
@using Microsoft.AspNetCore.Components.Forms
@using QMgr.Application.DTOs
@inject IAuthService AuthService
@inject IAccountApiService Account
@inject IStaffOnboardingApiService Onboarding
@inject IPasswordRulesService PasswordRules
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject NavigationManager NavigationManager
@inject IToastService Toast

@*
    MY ACCOUNT (rebuilt 2026-09-25). How you get IN, and what the app sends you — nothing else.

    The test for every field: does it control how you sign in, or does it describe you to the school?
      here        photo, username, email (sign-in and recovery), password, the devices holding a
                  session, notification preferences, the private calendar feed, member since, last
                  sign-in
      My file     phone and contact detail (one writer: api/v1/profile/contact), and the school's
                  employment record. A tenant without My Workspace has no My file, so for them the
                  SAME card (MyDetailsCard) renders here, contact half only.
      school      the name (decision D3): registers, MoES returns and printed slips carry it, so it
                  changes through the staff directory. The API ignores a name sent here.

    Removed from the old page: "System Settings" (not an account action, and ungated — every teacher
    was offered the school's settings from here) and "Logout" (it is in the user menu). The nine
    95px tiles became one-line rows; the whole page fits one 1080p screen.

    The route did not move: /profile is carried by links and emails.
*@

<QPageTitle Text="My account" />

<div class="admin-page acct-page">
    <QPageActions>
        <Title>
            <h1>My account</h1>
            <p class="subtitle">How you sign in, and what the app sends you</p>
        </Title>
        <Actions>
            @if (profile is not null)
            {
                <QButton Text="Change password" Icon="key" Variant="secondary" OnClick="OpenPasswordModal" />
            }
        </Actions>
    </QPageActions>

    @if (isLoading)
    {
        <div class="acct-loading"><QSpinner Size="md" /></div>
    }
    else if (profile is null)
    {
        <QEmptyState Icon="person-x" Title="Account unavailable" Text="@(loadError ?? "Reload the page, or sign in again.")" />
    }
    else
    {
        <div class="acct-grid">
            <QCard Title="You" Icon="person-circle" Class="acct-card">
                <div class="acct-id">
                    <label class="acct-photo" title="@(string.IsNullOrEmpty(profile.PhotoUrl) ? "Add a photo" : "Change your photo")">
                        <QAvatar Name="@DisplayName" PhotoUrl="@profile.PhotoUrl" Size="lg" />
                        <span class="acct-photo__badge" aria-hidden="true"><QIcon Name="camera-fill" Size="12" /></span>
                        @* The native picker is hidden by a plain rule. It was hidden by a :deep()
                           selector in a non-scoped <style>, which is invalid there and dropped the
                           whole rule — "Choose File / No file chosen" sat over the avatar. *@
                        <InputFile OnChange="@UploadPhotoAsync" accept="image/png,image/jpeg,image/webp" disabled="@photoBusy" aria-label="Choose a photo" />
                    </label>
                    <div class="acct-id__text">
                        <div class="acct-name">
                            @DisplayName
                            <QInfo Label="Your name" Text="Your name is part of the school's record — registers, returns and printed slips carry it — so an administrator changes it. Tell them if it is wrong." />
                        </div>
                        <div class="acct-role">@profile.Role</div>
                    </div>
                </div>

                <dl class="acct-list">
                    <div><dt>Username</dt><dd>@profile.Username</dd></div>
                    <div>
                        <dt>Email</dt>
                        <dd class="acct-row">
                            <span>@(string.IsNullOrEmpty(profile.Email) ? "No email address" : profile.Email)</span>
                            <QButton Text="Change" Variant="ghost" Size="sm" OnClick="OpenEmailModal" />
                        </dd>
                    </div>
                    <div><dt>Member since</dt><dd>@QDateFormat.D(profile.CreatedAt)</dd></div>
                    @if (hasWorkspace)
                    {
                        <div>
                            <dt>Phone and contact</dt>
                            <dd><a href="/portal?tab=file#my-details">On My file</a></dd>
                        </div>
                    }
                </dl>
            </QCard>

            <QCard Title="Sign-in and security" Icon="shield-lock" Class="acct-card">
                <dl class="acct-list">
                    <div>
                        <dt>Password</dt>
                        <dd class="acct-row"><span>••••••••</span><QButton Text="Change" Variant="ghost" Size="sm" OnClick="OpenPasswordModal" /></dd>
                    </div>
                    <div><dt>Last sign-in</dt><dd>@(profile.LastLogin.HasValue ? QDateFormat.DT(profile.LastLogin.Value) : "—")</dd></div>
                </dl>

                <div class="acct-devices">
                    <div class="acct-devices__head">
                        <span>Phones signed in</span>
                        <QInfo Label="Phones signed in" Text="@($"The {ProductBrand.Name} app on a phone keeps its own session. If a phone is lost, sign out everywhere: every phone and this browser are signed out at once, and you sign in again here.")" />
                    </div>
                    @if (devices is null)
                    {
                        <p class="acct-muted">Could not read your devices.</p>
                    }
                    else if (devices.Count == 0)
                    {
                        <p class="acct-muted">No phone is signed in to the app.</p>
                    }
                    else
                    {
                        <ul class="acct-device-list">
                            @foreach (var d in devices)
                            {
                                <li>
                                    <QIcon Name="phone" Size="14" />
                                    <span class="acct-device-name">@d.DeviceName</span>
                                    <span class="acct-muted">last used @QDateFormat.DT(d.LastUsedUtc.ToLocalTime())</span>
                                </li>
                            }
                        </ul>
                    }
                    <QButton Text="Sign out everywhere" Icon="box-arrow-right" Variant="danger" Size="sm" OnClick="@(() => showSignOutAll = true)" />
                </div>
            </QCard>

            <QCard Title="Notifications" Icon="bell" Class="acct-card">
                <p class="acct-muted">Choose what reaches you in the app, by email and by text.</p>
                <QButton Text="Notification preferences" Icon="sliders" Variant="secondary" Size="sm" OnClick="@(() => NavigationManager.NavigateTo("/profile/notifications"))" />
            </QCard>

            <QMgr.Web.Components.Pages.Calendar.CalendarFeedCard />

            @if (!hasWorkspace)
            {
                @* No My Workspace on this tenant, so no My file: the one contact card lives here. *@
                <div class="acct-wide"><QMgr.Web.Components.Pages.Portal.MyDetailsCard ShowEmployment="false" /></div>
            }
        </div>
    }
</div>

<QModal @bind-Visible="showEmailModal" Title="Change email" Size="sm">
    <ChildContent>
        <QInput TValue="string" Label="Email" Type="email" @bind-Value="emailInput" Placeholder="name@example.com"
                Hint="Your sign-in and recovery address. Password reset links go here." />
        @if (!string.IsNullOrEmpty(emailError))
        {
            <p class="form-error">@emailError</p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showEmailModal = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="SaveEmailAsync" Loading="@isSaving" Disabled="@isSaving" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showPasswordModal" Title="Change password" Size="sm">
    <ChildContent>
        <div class="acct-form">
            <QInput TValue="string" Label="Current password" Type="password" @bind-Value="currentPassword" />
            <QInput TValue="string" Label="New password" Type="password" @bind-Value="newPassword" Placeholder="@PasswordRules.Placeholder" Hint="@PasswordRules.Summary" />
            <QInput TValue="string" Label="Confirm new password" Type="password" @bind-Value="confirmPassword" />
        </div>
        @if (!string.IsNullOrEmpty(passwordError))
        {
            <p class="form-error">@passwordError</p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showPasswordModal = false)" />
        <QButton Text="Change password" Icon="key-fill" Variant="primary" OnClick="ChangePasswordAsync" Loading="@isSaving" Disabled="@isSaving" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showSignOutAll" Title="Sign out everywhere?" Size="sm">
    <ChildContent>
        <p>Every phone signed in to the app, and this browser, will be signed out now. You will sign in again here.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showSignOutAll = false)" />
        <QButton Text="Sign out everywhere" Icon="box-arrow-right" Variant="danger" OnClick="SignOutEverywhereAsync" Loading="@isSaving" Disabled="@isSaving" />
    </FooterContent>
</QModal>

<style>
    .acct-loading { display: flex; justify-content: center; padding: 40px 0; }
    .acct-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: var(--qm-block-gap); align-items: start; }
    .acct-wide { grid-column: 1 / -1; }
    .acct-id { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
    .acct-photo { position: relative; display: inline-flex; cursor: pointer; border-radius: 50%; flex: 0 0 auto; }
    .acct-photo input[type="file"] { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; font-size: 0; }
    .acct-photo:focus-within { outline: 2px solid var(--qm-primary); outline-offset: 2px; }
    .acct-photo__badge {
        position: absolute; right: -2px; bottom: -2px; width: 22px; height: 22px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        background: var(--qm-bg-card); border: 1px solid var(--qm-border); color: var(--qm-text-secondary); pointer-events: none;
    }
    .acct-id__text { min-width: 0; }
    .acct-name { display: flex; align-items: center; gap: 6px; font-family: var(--qm-font-display); font-weight: 700; font-size: var(--qm-text-md); }
    .acct-role { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .acct-list { margin: 0; display: flex; flex-direction: column; }
    .acct-list > div { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: center; padding: 6px 0; border-top: 1px solid var(--qm-border); min-height: var(--q-control-h); }
    .acct-list dt { margin: 0; font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .acct-list dd { margin: 0; font-size: var(--qm-text-base); min-width: 0; overflow-wrap: anywhere; }
    .acct-row { display: flex; align-items: center; justify-content: space-between; gap: var(--q-row-gap); }
    .acct-muted { margin: 0; color: var(--qm-text-muted); font-size: var(--qm-text-sm); }
    .acct-card p.acct-muted + .q-btn, .acct-card p.acct-muted { margin-bottom: 8px; }
    .acct-devices { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
    .acct-devices__head { display: flex; align-items: center; gap: 6px; font-size: var(--qm-text-sm); font-weight: 600; }
    .acct-device-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; width: 100%; }
    .acct-device-list li { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: var(--qm-text-base); }
    .acct-device-name { font-weight: 500; }
    .acct-form { display: flex; flex-direction: column; gap: var(--qm-field-gap); }
    @@media (max-width: 640px) {
        .acct-grid { grid-template-columns: 1fr; }
        .acct-list > div { grid-template-columns: 1fr; gap: 2px; }
    }
</style>

@code {
    private ProfileDto? profile;
    private List<DeviceSessionDto>? devices = new();
    private bool isLoading = true, isSaving, photoBusy, hasWorkspace;
    private string? loadError;

    private bool showEmailModal, showPasswordModal, showSignOutAll;
    private string? emailInput, emailError;
    private string? currentPassword, newPassword, confirmPassword, passwordError;

    private string DisplayName => string.IsNullOrWhiteSpace(profile?.FullName) ? profile?.Username ?? "" : profile!.FullName;

    protected override async Task OnInitializedAsync()
    {
        await PasswordRules.LoadAsync();
        await ModuleState.LoadAsync(ModuleApi);
        // My Workspace exists with Welfare & Performance. A failed module load is read as "has it",
        // the fail-open every module check here uses; the link then explains itself.
        hasWorkspace = !ModuleState.LoadSucceeded || ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare);

        try
        {
            profile = await Account.GetProfileAsync();
        }
        catch (InvalidOperationException ex)
        {
            loadError = ex.Message;
        }

        try { devices = await Account.GetDevicesAsync(); }
        catch (InvalidOperationException) { devices = null; }

        isLoading = false;
    }

    private void OpenEmailModal()
    {
        emailInput = profile?.Email;
        emailError = null;
        showEmailModal = true;
    }

    private async Task SaveEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(emailInput)) { emailError = "Enter an email address."; return; }
        isSaving = true;
        emailError = null;
        try
        {
            profile = await Account.UpdateEmailAsync(emailInput.Trim());
            showEmailModal = false;
            Toast.Notify(ToastSeverity.Success, "Email changed");
            await AuthService.RefreshCurrentUserAsync();
        }
        catch (InvalidOperationException ex) { emailError = ex.Message; }
        finally { isSaving = false; }
    }

    private void OpenPasswordModal()
    {
        currentPassword = newPassword = confirmPassword = passwordError = null;
        showPasswordModal = true;
    }

    private async Task ChangePasswordAsync()
    {
        passwordError = null;
        if (string.IsNullOrWhiteSpace(currentPassword)) { passwordError = "Enter your current password."; return; }
        if (string.IsNullOrWhiteSpace(newPassword)) { passwordError = "Enter a new password."; return; }
        if (PasswordRules.LengthProblem(newPassword) is { } problem) { passwordError = $"New password must be {problem.ToLowerInvariant()}."; return; }
        if (newPassword != confirmPassword) { passwordError = "The two new passwords do not match."; return; }

        isSaving = true;
        try
        {
            await Account.ChangePasswordAsync(currentPassword, newPassword, confirmPassword!);
            showPasswordModal = false;
            Toast.Notify(ToastSeverity.Success, "Password changed", "Other devices have been signed out.");
        }
        catch (InvalidOperationException ex) { passwordError = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task SignOutEverywhereAsync()
    {
        isSaving = true;
        try
        {
            await Account.SignOutEverywhereAsync();
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not sign out everywhere", ex.Message);
            isSaving = false;
        }
    }

    /// <summary>
    /// The same endpoint the onboarding checklist posts to, and for the same reason it refreshes the
    /// stored user afterwards: the header avatar reads that copy, and a photo's link is signed per
    /// fetch, so nothing else would carry it until the next sign-in.
    /// </summary>
    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > 5 * 1024 * 1024)
        {
            Toast.Notify(ToastSeverity.Warning, "That photo is too large", "Choose one under 5 MB.");
            return;
        }

        photoBusy = true;
        try
        {
            await using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            buffer.Position = 0;
            var url = await Onboarding.UploadPhotoAsync(buffer, e.File.Name, e.File.ContentType);
            if (profile != null) profile = profile with { PhotoUrl = url };
            Toast.Notify(ToastSeverity.Success, "Photo updated");
            await AuthService.RefreshCurrentUserAsync();
        }
        catch (InvalidOperationException ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not add the photo", ex.Message);
        }
        finally { photoBusy = false; }
    }
}
