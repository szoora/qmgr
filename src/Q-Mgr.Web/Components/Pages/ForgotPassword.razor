@page "/forgot-password"
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using QMgr.Web.Components.Shared
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<ForgotPassword> Logger

<PageTitle>Forgot Password - Q-Mgr</PageTitle>

<div class="login-container">
    <AmbientBackground />
    <div class="login-card @(isLoading ? "loading" : "")">
        <div class="login-header">
            <div class="logo-wrapper">
                <div class="logo-circle">
                    <QIcon Name="key-fill" Size="32" />
                </div>
            </div>
            <h1>Forgot password?</h1>
            <p>Enter the email on your account and we'll send you a link to reset it.</p>
        </div>

        @if (submitted)
        {
            <div class="auth-alert auth-alert-success auth-animate-in">
                <div class="auth-alert-icon">
                    <QIcon Name="envelope-check-fill" />
                </div>
                <div class="auth-alert-content">
                    <p>@resultMessage</p>
                </div>
            </div>
            <a href="/login" class="btn-login">
                <QIcon Name="arrow-left" Size="18" />
                <span>Back to Sign In</span>
            </a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert auth-alert-danger auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="exclamation-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <p>@errorMessage</p>
                    </div>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">
                        <QIcon Name="envelope-fill" Size="16" />
                        <span>Email Address</span>
                    </label>
                    <InputText id="email" class="form-control" type="email" @bind-Value="model.Email"
                               placeholder="you@company.com" disabled="@isLoading" />
                    <ValidationMessage For="@(() => model.Email)" class="validation-message" />
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="auth-spinner"></span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                        <QIcon Name="arrow-right" Size="18" />
                    }
                </button>
            </EditForm>
        }

        <div class="login-footer">
            <p>
                Remembered it after all?
                <a href="/login" class="link-register">Sign in</a>
            </p>
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <span>•</span>
                <a href="/terms">Terms of Service</a>
                <span>•</span>
                <a href="/support">Support</a>
            </div>
            <p class="powered-by">Powered by SACC Software</p>
        </div>
    </div>
</div>

@code {
    private ForgotPasswordModel model = new();
    private bool isLoading = false;
    private bool submitted = false;
    private string? errorMessage;
    private string resultMessage = "";

    private HttpClient Http => HttpClientFactory.CreateClient("QMgrAuthApi");

    private async Task HandleSubmit()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/forgot-password", new { email = model.Email.Trim() });
            var result = await response.Content.ReadFromJsonAsync<ForgotPasswordResponse>();

            // The endpoint always reports the same generic message whether or not the email
            // matches an account - deliberate, to avoid confirming which addresses are
            // registered. Only a genuine connectivity failure gets a different message.
            resultMessage = result?.Message ?? "If an account exists for that email address, we've sent a link to reset the password.";
            submitted = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Forgot-password request error");
            errorMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        public string Email { get; set; } = string.Empty;
    }

    private record ForgotPasswordResponse(string Message);
}
