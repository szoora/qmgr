<PageTitle>Terms of Service - Q-Mgr</PageTitle>

<div class="doc-page">
    <AmbientBackground />

    <div class="doc-shell">
        <div class="doc-topbar">
            <a href="/" class="doc-brand">
                <span class="doc-brand-mark"><QIcon Name="people-fill" /></span>
                <span>Q-Mgr</span>
            </a>
