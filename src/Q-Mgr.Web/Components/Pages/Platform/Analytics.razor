@page "/platform/analytics"
@using System.Text.Json
@using QMgr.Web.Services
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>Platform Analytics - Q-Mgr</PageTitle>

<div class="page-header">
    <div class="header-content">
        <h1><QIcon Name="graph-up-arrow" Size="32" /> Platform Analytics</h1>
        <p class="page-subtitle">Platform-wide analytics including growth, revenue, and usage trends</p>
    </div>
</div>

<div class="admin-content">
    @if (isLoading)
    {
        <div class="loading-state">
            <QSpinner Size="lg" />
            <span>Loading analytics...</span>
        </div>
    }
    else if (hasError)
    {
        <QCard>
            <div class="error-state">
                <QIcon Name="exclamation-triangle-fill" Size="48" />
                <h4>Failed to Load Analytics</h4>
                <p>@errorMessage</p>
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="primary" OnClick="@LoadData" />
            </div>
        </QCard>
    }
    else
    {
        <!-- Platform Metrics Overview -->
        <div class="metrics-row">
            <QCard Class="metric-card">
                <div class="metric-content">
                    <div class="metric-header">
                        <QIcon Name="building-fill-check" Size="24" />
                        <span>Total Organizations</span>
                    </div>
                    <div class="metric-value">@metrics.TotalOrganizations</div>
                    <div class="metric-footer">
                        <span class="active-count">@metrics.ActiveOrganizations active</span>
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-content">
                    <div class="metric-header">
                        <QIcon Name="currency-dollar" Size="24" />
                        <span>MRR</span>
                    </div>
                    <div class="metric-value">$@metrics.MonthlyRecurringRevenue.ToString("N0")</div>
                    <div class="metric-footer">
                        <span class="arr-info">ARR: $@metrics.AnnualRecurringRevenue.ToString("N0")</span>
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-content">
                    <div class="metric-header">
                        <QIcon Name="ticket-perforated-fill" Size="24" />
                        <span>Tokens Served</span>
                    </div>
                    <div class="metric-value">@metrics.TotalTokensServed.ToString("N0")</div>
                    <div class="metric-footer">
                        <span class="period-info">@metrics.From.ToString("MMM d") - @metrics.To.ToString("MMM d")</span>
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-content">
                    <div class="metric-header">
                        <QIcon Name="arrow-left-right" Size="24" />
                        <span>API Calls</span>
                    </div>
                    <div class="metric-value">@metrics.TotalApiCalls.ToString("N0")</div>
                    <div class="metric-footer">
                        <span class="period-info">@metrics.From.ToString("MMM d") - @metrics.To.ToString("MMM d")</span>
                    </div>
                </div>
            </QCard>
        </div>

        <!-- Growth Trends -->
        <QCard Class="mb-4" Title="Growth Trends" Icon="graph-up">
            @if (growthTrends.Any())
            {
                <div class="chart-container">
                    <div class="growth-chart">
                        @{
                            var maxCumulative = growthTrends.Max(g => g.CumulativeTenants);
                            var maxNew = growthTrends.Max(g => g.NewTenants);
                        }
                        @foreach (var trend in growthTrends)
                        {
                            var cumulativeHeight = maxCumulative > 0 ? (double)trend.CumulativeTenants / maxCumulative * 100 : 0;
                            var newHeight = maxNew > 0 ? (double)trend.NewTenants / maxNew * 60 : 0;
                            <div class="chart-bar">
                                <div class="bar-group">
                                    <div class="bar cumulative" style="height: @cumulativeHeight%"
                                         title="Cumulative: @trend.CumulativeTenants">
                                    </div>
                                    <div class="bar new" style="height: @newHeight%"
                                         title="New: @trend.NewTenants">
                                    </div>
                                </div>
                                <div class="bar-label">@trend.Date.ToString("MMM")</div>
                                <div class="bar-values">
                                    <span class="new-value">+@trend.NewTenants</span>
                                    <span class="cumulative-value">@trend.CumulativeTenants</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="chart-legend">
                        <div class="legend-item">
                            <span class="legend-color cumulative"></span>
                            <span>Cumulative Tenants</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color new"></span>
                            <span>New Tenants</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="empty-chart">
                    <QIcon Name="bar-chart-fill" Size="48" />
                    <p>No growth data available</p>
                </div>
            }
        </QCard>

        <!-- Revenue Metrics -->
        <QCard Class="mb-4" Title="Revenue Metrics" Icon="cash-stack">
            @if (revenueMetrics.Any())
            {
                <div class="revenue-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>MRR</th>
                                <th>ARR</th>
                                <th>Total Revenue</th>
                                <th>New Subscriptions</th>
                                <th>Trial Conversions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var metric in revenueMetrics.OrderByDescending(r => r.Period).Take(12))
                            {
                                <tr>
                                    <td class="period-cell">@metric.Period.ToString("MMM yyyy")</td>
                                    <td class="revenue-cell">$@metric.MRR.ToString("N0")</td>
                                    <td class="revenue-cell">$@metric.ARR.ToString("N0")</td>
                                    <td class="revenue-cell">$@metric.TotalRevenue.ToString("N0")</td>
                                    <td class="count-cell">@metric.NewSubscriptions</td>
                                    <td class="count-cell">@metric.TrialConversions</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <QIcon Name="cash" Size="48" />
                    <p>No revenue data available</p>
                </div>
            }
        </QCard>

        <!-- Usage Trends -->
        <QCard Title="Usage Trends" Icon="activity">
            @if (usageTrends.Any())
            {
                <div class="usage-grid">
                    @foreach (var usage in usageTrends.OrderByDescending(u => u.Date).Take(6))
                    {
                        <div class="usage-card">
                            <div class="usage-period">@usage.Date.ToString("MMMM yyyy")</div>
                            <div class="usage-stats">
                                <div class="usage-stat">
                                    <div class="stat-icon">
                                        <QIcon Name="ticket-perforated-fill" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">Tokens</div>
                                        <div class="stat-value">@usage.TotalTokens.ToString("N0")</div>
                                    </div>
                                </div>
                                <div class="usage-stat">
                                    <div class="stat-icon">
                                        <QIcon Name="arrow-left-right" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">API Calls</div>
                                        <div class="stat-value">@usage.TotalApiCalls.ToString("N0")</div>
                                    </div>
                                </div>
                                <div class="usage-stat">
                                    <div class="stat-icon">
                                        <QIcon Name="people-fill" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">Active Users</div>
                                        <div class="stat-value">@usage.ActiveUsers.ToString("N0")</div>
                                    </div>
                                </div>
                                <div class="usage-stat">
                                    <div class="stat-icon">
                                        <QIcon Name="hdd-fill" />
                                    </div>
                                    <div class="stat-info">
                                        <div class="stat-label">Storage</div>
                                        <div class="stat-value">@usage.StorageUsedMb.ToString("N0") MB</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <QIcon Name="activity" Size="48" />
                    <p>No usage data available</p>
                </div>
            }
        </QCard>
    }
</div>

<style>
    .page-header {
        margin-bottom: 32px;
    }

    .page-header h1 {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 8px;
        font-size: 32px;
        color: var(--qm-text-primary);
    }

    .page-subtitle {
        color: var(--qm-text-muted);
        margin: 0;
        font-size: 16px;
    }

    .loading-state, .error-state, .empty-state, .empty-chart {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
        color: var(--qm-text-muted);
    }

    .metrics-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .metric-card .q-card__body {
        padding: 0;
    }

    .metric-content {
        padding: 20px;
    }

    .metric-header {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--qm-text-muted);
        margin-bottom: 12px;
        font-size: 14px;
    }

    .metric-value {
        font-size: 32px;
        font-weight: 700;
        color: var(--qm-text-primary);
        margin-bottom: 8px;
    }

    .metric-footer {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--qm-border);
    }

    .card-header h3 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 18px;
        color: var(--qm-text-primary);
    }

    .chart-container {
        padding: 20px 0;
    }

    .growth-chart {
        display: flex;
        align-items: flex-end;
        gap: 8px;
        height: 300px;
        margin-bottom: 20px;
        padding: 0 20px;
    }

    .chart-bar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }

    .bar-group {
        flex: 1;
        display: flex;
        gap: 4px;
        align-items: flex-end;
        width: 100%;
        justify-content: center;
    }

    .bar {
        width: 16px;
        min-height: 4px;
        border-radius: var(--qm-radius-sm) var(--qm-radius-sm) 0 0;
        transition: all 0.3s ease;
    }

    .bar.cumulative {
        background: var(--qm-gradient-primary);
    }

    .bar.new {
        background: var(--qm-secondary);
    }

    .bar:hover {
        opacity: 0.8;
        transform: scaleY(1.05);
    }

    .bar-label {
        font-size: 11px;
        color: var(--qm-text-muted);
        margin-top: 8px;
        font-weight: 600;
    }

    .bar-values {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        margin-top: 4px;
        font-size: 10px;
    }

    .new-value {
        color: var(--qm-secondary-dark);
        font-weight: 600;
    }

    .cumulative-value {
        color: var(--qm-primary);
        font-weight: 600;
    }

    .chart-legend {
        display: flex;
        justify-content: center;
        gap: 24px;
        padding: 16px 20px;
        border-top: 1px solid var(--qm-border);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--qm-text-secondary);
    }

    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: var(--qm-radius-sm);
    }

    .legend-color.cumulative {
        background: var(--qm-gradient-primary);
    }

    .legend-color.new {
        background: var(--qm-secondary);
    }

    .revenue-table {
        overflow-x: auto;
    }

    .revenue-table table {
        width: 100%;
        border-collapse: collapse;
    }

    .revenue-table th {
        text-align: left;
        padding: 12px;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-muted);
        font-weight: 600;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid var(--qm-border);
    }

    .revenue-table td {
        padding: 16px 12px;
        border-bottom: 1px solid var(--qm-border);
    }

    .revenue-table tr:hover {
        background: var(--qm-bg-elevated);
    }

    .period-cell {
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .revenue-cell {
        color: var(--qm-success);
        font-weight: 600;
    }

    .count-cell {
        color: var(--qm-text-secondary);
        text-align: center;
    }

    .usage-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
    }

    .usage-card {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
    }

    .usage-period {
        font-weight: 600;
        color: var(--qm-text-primary);
        margin-bottom: 16px;
        font-size: 16px;
    }

    .usage-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .usage-stat {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        background: var(--qm-gradient-primary);
        border-radius: var(--qm-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--qm-text-on-primary);
        flex-shrink: 0;
    }

    .stat-info {
        flex: 1;
    }

    .stat-label {
        font-size: 12px;
        color: var(--qm-text-muted);
        margin-bottom: 4px;
    }

    .stat-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--qm-text-primary);
    }
</style>

@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";

    private PlatformAnalyticsDto metrics = new();
    private List<GrowthTrendDto> growthTrends = new();
    private List<RevenueMetricsDto> revenueMetrics = new();
    private List<UsageTrendDto> usageTrends = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.PlatformAdmin))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;

        try
        {
            var metricsTask = Http.GetFromJsonAsync<PlatformAnalyticsDto>("api/v1/analytics/platform/metrics", JsonOptions);
            var growthTask = Http.GetFromJsonAsync<List<GrowthTrendDto>>("api/v1/analytics/platform/growth", JsonOptions);
            var revenueTask = Http.GetFromJsonAsync<List<RevenueMetricsDto>>("api/v1/analytics/platform/revenue", JsonOptions);
            var usageTask = Http.GetFromJsonAsync<List<UsageTrendDto>>("api/v1/analytics/platform/usage", JsonOptions);

            await Task.WhenAll(metricsTask, growthTask, revenueTask, usageTask);

            metrics = await metricsTask ?? new();
            growthTrends = await growthTask ?? new();
            revenueMetrics = await revenueTask ?? new();
            usageTrends = await usageTask ?? new();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private record PlatformAnalyticsDto
    {
        public int TotalOrganizations { get; init; }
        public int ActiveOrganizations { get; init; }
        public decimal MonthlyRecurringRevenue { get; init; }
        public decimal AnnualRecurringRevenue { get; init; }
        public int TotalTokensServed { get; init; }
        public int TotalApiCalls { get; init; }
        public DateTime From { get; init; }
        public DateTime To { get; init; }
    }

    private record GrowthTrendDto
    {
        public DateTime Date { get; init; }
        public int NewTenants { get; init; }
        public int CumulativeTenants { get; init; }
        public decimal ChurnRate { get; init; }
    }

    private record RevenueMetricsDto
    {
        public DateTime Period { get; init; }
        public decimal MRR { get; init; }
        public decimal ARR { get; init; }
        public decimal TotalRevenue { get; init; }
        public int NewSubscriptions { get; init; }
        public int TrialConversions { get; init; }
    }

    private record UsageTrendDto
    {
        public DateTime Date { get; init; }
        public int TotalTokens { get; init; }
        public int TotalApiCalls { get; init; }
        public int ActiveUsers { get; init; }
        public int ActiveBranches { get; init; }
        public long StorageUsedMb { get; init; }
    }
}
