@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";
    private bool isSubmitting = false;

    private string searchQuery = "";
    private string statusFilter = "";
    private int currentPage = 1;
    // SERVER-paged: "All" is not offered, since every tenant in one response is a query nobody should be able to ask for by accident.
    private int pageSize = QPagerDefaults.Size;

    private PagedResult<TenantSummary> pagedResult = new();
    private TenantSummary? selectedTenant;
    private TenantDetails? tenantDetails;
    private int? storageQuotaInput;
    private bool isSavingStorageQuota = false;

    private TenantResidueDto? residue;
    private bool isCountingResidue, isSavingLifecycle, isPurging, purgeFailed;
    private string? lifecycleError, purgeMessage;
    private string purgeConfirmName = string.Empty;

    private async Task SetLifecycle(Guid tenantId, string status)
    {
        isSavingLifecycle = true;
        lifecycleError = null;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/admin/tenants/{tenantId}/lifecycle", new { status, reason = "set by a platform administrator" });
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<JsonElement>(JsonOptions);
                lifecycleError = body.TryGetProperty("title", out var t) ? t.GetString() : $"That did not work ({(int)response.StatusCode}).";
            }
            await ViewTenant(tenantId);
        }
        catch (Exception ex) { lifecycleError = ex.Message; }
        finally { isSavingLifecycle = false; }
    }

    private async Task LoadResidue(Guid tenantId)
    {
        isCountingResidue = true;
        try { residue = await Http.GetFromJsonAsync<TenantResidueDto>($"api/v1/admin/tenants/{tenantId}/residue", JsonOptions); }
        catch (Exception ex) { NotificationService.Notify(ToastSeverity.Error, "Error", ex.Message); }
        finally { isCountingResidue = false; }
    }

    /// <summary>
    /// The name has to be typed back. A purge is irreversible and there is no copy to go back to,
    /// so a misclick must not be able to reach it — the API refuses a mismatch too, which is what
    /// actually enforces it.
    /// </summary>
    private async Task PurgeTenant(Guid tenantId, string tenantName)
    {
        isPurging = true;
        purgeMessage = null;
        purgeFailed = false;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/admin/tenants/{tenantId}/purge",
                new { confirmName = purgeConfirmName, reason = "removed by a platform administrator" });
            var result = await response.Content.ReadFromJsonAsync<JsonElement>(JsonOptions);

            if (response.IsSuccessStatusCode && result.TryGetProperty("verificationPassed", out var ok) && ok.GetBoolean())
            {
                var rows = result.TryGetProperty("totalRowsDeleted", out var r) ? r.GetInt32() : 0;
                var files = result.TryGetProperty("filesDeleted", out var f) ? f.GetInt32() : 0;
                NotificationService.Notify(ToastSeverity.Success, "Purged",
                    $"{tenantName} is gone: {rows} row(s) and {files} file(s) removed, and the check found nothing left.");
                showDetailsModal = false;
                residue = null;
                purgeConfirmName = string.Empty;
                await LoadTenants();
                return;
            }

            purgeFailed = true;
            purgeMessage = result.TryGetProperty("error", out var e) ? e.GetString()
                : result.TryGetProperty("message", out var m) ? m.GetString()
                : $"The purge did not complete ({(int)response.StatusCode}).";
        }
        catch (Exception ex) { purgeFailed = true; purgeMessage = ex.Message; }
        finally { isPurging = false; }
    }

    private string domainInput = string.Empty;
    private bool isSavingDomain;
    private string? domainError;
    private bool isSavingOverride;

    private sealed record OverridableFeature(string Code, string Label, string Note);

    /// <summary>
    /// Deliberately a short list, not every constant on FeatureCodes — and it must match the
    /// API's own allow-list, which is what actually enforces it. An override is for a negotiated
    /// deal; anything that is simply part of a module should be sold as that module.
    /// </summary>
    private static readonly OverridableFeature[] OverridableFeatures =
    [
        new("white_label", "White-label branding", "The tenant's own name, logo and colours across the whole app, its kiosk and display screens, and its outbound email."),
        new("remove_attribution", "Remove SACC attribution", "Puts their organisation's name on the copyright line of their sign-in pages, the app footer and their emails, in place of ours. Needs white-label branding switched on as well, or it removes our name from a product that still carries it everywhere.")
    ];

    private static string DomainStateLabel(CustomDomainState state) => state switch
    {
        CustomDomainState.Pending => "Waiting for DNS",
        CustomDomainState.Verified => "Verified, not yet served",
        CustomDomainState.Live => "Live",
        _ => "None"
    };

    private static string DomainStateVariant(CustomDomainState state) => state switch
    {
        CustomDomainState.Live => "success",
        CustomDomainState.Verified => "info",
        CustomDomainState.Pending => "warning",
        _ => "secondary"
    };

    private async Task CopyAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); }
        catch { /* A browser that refuses the clipboard still leaves the text selectable (user-select: all). */ }
    }

    private async Task RequestDomain(Guid tenantId)
    {
        if (string.IsNullOrWhiteSpace(domainInput)) { domainError = "Enter the domain first."; return; }
        await RunDomainStepAsync(tenantId, () => Http.PutAsJsonAsync(
            $"api/v1/admin/tenants/{tenantId}/custom-domain", new RequestCustomDomainRequest { Domain = domainInput.Trim() }));
    }

    private Task VerifyDomain(Guid tenantId)
        => RunDomainStepAsync(tenantId, () => Http.PostAsync($"api/v1/admin/tenants/{tenantId}/custom-domain/verify", null));

    private Task ReleaseDomain(Guid tenantId)
        => RunDomainStepAsync(tenantId, () => Http.DeleteAsync($"api/v1/admin/tenants/{tenantId}/custom-domain"));

    /// <summary>
    /// A refusal here is NOT a dead end — it names the step that failed and the tenant is re-read
    /// either way, so the panel shows where the claim now stands and the same button is pressed
    /// again once the DNS record appears.
    /// </summary>
    private async Task RunDomainStepAsync(Guid tenantId, Func<Task<HttpResponseMessage>> call)
    {
        isSavingDomain = true;
        domainError = null;
        try
        {
            var response = await call();
            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<JsonElement>(JsonOptions);
                domainError = problem.TryGetProperty("title", out var title) ? title.GetString()
                    : problem.TryGetProperty("message", out var message) ? message.GetString()
                    : $"The request failed ({(int)response.StatusCode}).";
            }
            else
            {
                domainInput = string.Empty;
            }
            await ViewTenant(tenantId);
        }
        catch (Exception ex)
        {
            domainError = ex.Message;
        }
        finally
        {
            isSavingDomain = false;
        }
    }

    private string? brandNameEdit;
    private bool isSavingBrandName;

    private async Task SaveBrandName(Guid tenantId)
    {
        isSavingBrandName = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/v1/admin/tenants/{tenantId}/brand-name", new { brandName = brandNameEdit });
            if (response.IsSuccessStatusCode)
                NotificationService.Notify(ToastSeverity.Success, "Saved", string.IsNullOrWhiteSpace(brandNameEdit) ? $"The app is called {ProductBrand.Name} again." : $"The app is now called {brandNameEdit!.Trim()} once white-labelling is on.");
            else
                NotificationService.Notify(ToastSeverity.Error, "Not saved", await ApiErrorService.GetErrorMessageAsync(response));
            await ViewTenant(tenantId);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isSavingBrandName = false;
        }
    }

    private async Task SetOverride(Guid tenantId, string code, bool enabled)
    {
        isSavingOverride = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/v1/admin/tenants/{tenantId}/feature-overrides/{code}", new { enabled });
            if (!response.IsSuccessStatusCode)
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Could not change that override ({(int)response.StatusCode}).");
            await ViewTenant(tenantId);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isSavingOverride = false;
        }
    }

    private bool showDetailsModal = false;
    private bool showSuspendModal = false;
    private bool showModulesModal = false;
    private bool loadingModules = false;
    private List<TenantModuleStatus> tenantModules = new();

    /// <summary>Why the module list could not be loaded, shown in the dialog rather than only as a
    /// toast the person may have already dismissed or missed.</summary>
    private string? modulesError;
    private bool showExtendTrialModal = false;

    private string suspendReason = "";
    private int extendTrialDays = 14;
    private Guid extendTrialTenantId;

    private List<string> statusOptions = new() { "", "Pending", "Trialing", "Active", "Suspended", "Cancelled" };

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.PlatformAdmin))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        isLoading = true;
        hasError = false;

        try
        {
            var queryParams = new List<string>
            {
                $"page={currentPage}",
                $"pageSize={pageSize}"
            };

            if (!string.IsNullOrWhiteSpace(searchQuery))
                queryParams.Add($"search={Uri.EscapeDataString(searchQuery)}");
            if (!string.IsNullOrWhiteSpace(statusFilter))
                queryParams.Add($"status={statusFilter}");

            var url = $"api/v1/admin/tenants?{string.Join("&", queryParams)}";
            pagedResult = await Http.GetFromJsonAsync<PagedResult<TenantSummary>>(url, JsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewTenant(Guid id)
    {
        try
        {
            tenantDetails = await Http.GetFromJsonAsync<TenantDetails>($"api/v1/admin/tenants/{id}", JsonOptions);
            brandNameEdit = tenantDetails?.BrandName;
            storageQuotaInput = tenantDetails?.Usage?.StorageQuotaOverrideMb;
            showDetailsModal = true;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load tenant details: {ex.Message}");
        }
    }

    private async Task SaveStorageQuota(Guid tenantId)
    {
        isSavingStorageQuota = true;
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/v1/admin/tenants/{tenantId}/storage-quota",
                new { maxStorageMb = storageQuotaInput }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Saved", "Storage quota updated successfully");
                await ViewTenant(tenantId);
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update storage quota ({(int)response.StatusCode})");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update storage quota: {ex.Message}");
        }
        finally
        {
            isSavingStorageQuota = false;
        }
    }

    private Task ClearStorageQuota(Guid tenantId)
    {
        storageQuotaInput = null;
        return SaveStorageQuota(tenantId);
    }

    private void ShowSuspendDialog(TenantSummary tenant)
    {
        selectedTenant = tenant;
        suspendReason = "";
        showSuspendModal = true;
    }

    private async Task ConfirmSuspend()
    {
        if (selectedTenant == null || string.IsNullOrWhiteSpace(suspendReason))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Reason is required");
            return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/v1/admin/tenants/{selectedTenant.Id}/suspend",
                new { Reason = suspendReason }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Tenant suspended");
                showSuspendModal = false;
                await LoadTenants();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
