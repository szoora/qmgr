    private async Task ShowModulesDialog(TenantSummary tenant)
    {
        selectedTenant = tenant;
        showModulesModal = true;
        loadingModules = true;
        modulesError = null;
        tenantModules = new();
        StateHasChanged();

        try
        {
            tenantModules = await Http.GetFromJsonAsync<List<TenantModuleStatus>>(
                $"api/v1/admin/tenants/{tenant.Id}/modules", JsonOptions) ?? new();
        }
        catch (Exception ex)
        {
            modulesError = ex.Message;
            NotificationService.Notify(ToastSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            loadingModules = false;
            StateHasChanged();
        }
    }

    private async Task ToggleTenantModule(string moduleCode, bool grant)
    {
        if (selectedTenant == null) return;

        try
        {
            var response = grant
                ? await Http.PutAsJsonAsync($"api/v1/admin/tenants/{selectedTenant.Id}/modules/{moduleCode}", new { }, JsonOptions)
                : await Http.DeleteAsync($"api/v1/admin/tenants/{selectedTenant.Id}/modules/{moduleCode}");

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Updated", grant ? "Module granted" : "Module revoked");
                await ShowModulesDialog(selectedTenant);
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", ex.Message);
        }
    }

