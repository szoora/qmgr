@using QMgr.Application.DTOs
@page "/platform/tenants"
@using System.Text.Json
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<QPageTitle Text="Tenant Management" />

<div class="page-header">
    <div class="header-content">
        <h1><QIcon Name="building-fill" Size="32" /> Tenant Management</h1>
        <p class="page-subtitle">Manage all organizations on the platform</p>
    </div>
</div>

<div class="admin-content">
    <!-- Filters -->
    <QCard Class="mb-4">
        <div class="filters">
            <QInput TValue="string" @bind-Value="searchQuery" Placeholder="Search tenants..." Icon="search"
                    @bind-Value:after="@(() => LoadTenants())" />
            <QSelect TValue="string" TItem="string" @bind-Value="statusFilter" Items="@statusOptions"
                     Placeholder="All Statuses" @bind-Value:after="@(() => LoadTenants())" />
        </div>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-state">
            <QSpinner Size="lg" />
            <span>Loading tenants...</span>
        </div>
    }
    else if (hasError)
    {
        <QCard>
            <div class="error-state">
                <QIcon Name="exclamation-triangle-fill" Size="48" />
                <h4>Failed to Load Tenants</h4>
                <p>@errorMessage</p>
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="primary" OnClick="@LoadTenants" />
            </div>
        </QCard>
    }
    else
    {
        <!-- Tenants Table -->
        <QCard Title="@($"Tenants ({pagedResult.TotalCount})")" Icon="list-ul">
            @if (pagedResult.Items.Any())
            {
                <div class="table-responsive">
                    <table class="tenants-table">
                        <thead>
                            <tr>
                                <th>Organization</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Trial Ends</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tenant in pagedResult.Items)
                            {
                                <tr class="@(selectedTenant?.Id == tenant.Id ? "selected" : "")">
                                    <td>
                                        <div class="tenant-info">
                                            <div class="tenant-name">@tenant.Name</div>
                                            <div class="tenant-slug">@tenant.Slug</div>
                                            @if (!string.IsNullOrEmpty(tenant.ContactEmail))
                                            {
                                                <div class="tenant-email">@tenant.ContactEmail</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <QBadge Text="@tenant.Status.ToString()" Variant="@GetStatusVariant(tenant.Status)" />
                                    </td>
                                    <td>
                                        <div class="date-cell">@QDateFormat.D(tenant.CreatedAt)</div>
                                    </td>
                                    <td>
                                        @if (tenant.TrialEndsAt.HasValue)
                                        {
                                            var isExpired = tenant.TrialEndsAt.Value < DateTime.UtcNow;
                                            <div class="date-cell @(isExpired ? "expired" : "")">
                                                @QDateFormat.D(tenant.TrialEndsAt.Value)
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="qm-text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <QButton Icon="eye-fill" Variant="ghost" Size="sm"
                                                     OnClick="@(() => ViewTenant(tenant.Id))" Title="View Details" />
                                            <QButton Icon="grid-3x3-gap-fill" Variant="ghost" Size="sm"
                                                     OnClick="@(() => ShowModulesDialog(tenant))" Title="Manage Modules" />
                                            @if (tenant.Status == TenantStatus.Pending)
                                            {
                                                <QButton Icon="envelope-fill" Variant="ghost" Size="sm"
                                                         OnClick="@(() => ResendVerification(tenant))" Title="Resend Verification Email"
                                                         Loading="@(resendingId == tenant.Id)" />
                                                <QButton Icon="patch-check-fill" Variant="ghost" Size="sm"
                                                         OnClick="@(() => VerifyTenantNow(tenant))" Title="Verify Now (skip email)"
                                                         Class="tone-success" Loading="@(verifyingId == tenant.Id)" />
                                            }
                                            @if (tenant.Status == TenantStatus.Active || tenant.Status == TenantStatus.Trialing)
                                            {
                                                <QButton Icon="pause-circle-fill" Variant="ghost" Size="sm"
                                                         OnClick="@(() => ShowSuspendDialog(tenant))" Title="Suspend"
                                                         Class="tone-warning" />
                                            }
                                            else if (tenant.Status == TenantStatus.Suspended)
                                            {
                                                <QButton Icon="play-circle-fill" Variant="ghost" Size="sm"
                                                         OnClick="@(() => ReactivateTenant(tenant))" Title="Reactivate"
                                                         Class="tone-success" />
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <QPager Count="@pagedResult.TotalCount" PageSize="@pageSize"
                        PageIndex="@(currentPage - 1)" PageIndexChanged="@OnPageChanged"
                        PageSizeOptions="@QPagerDefaults.Sizes" StorageKey="platform-tenants"
                        PageSizeChanged="@(n => pageSize = n)" ItemLabel="tenants" Class="tenants-pager" />
            }
            else
            {
                <div class="empty-state">
                    <QIcon Name="building-fill" Size="64" />
                    <h4>No Tenants Found</h4>
                    <p>No tenants match your filters.</p>
                </div>
            }
        </QCard>
    }
</div>

<!-- Tenant Details Modal -->
@* xl (1140px) rather than lg (800px): this dialog carries eight sections in two columns, and at
   800px every one of them wrapped. The prose that used to sit in them has moved into QInfo — the
   standing rule is that permanent explanation belongs in a popover beside the thing it explains,
   and that only a sentence which changes what somebody DOES stays on the page. *@
<QModal @bind-Visible="showDetailsModal" Title="Tenant Details" Size="xl">
    <ChildContent>
        @if (tenantDetails != null)
        {
            <div class="details-grid">
                <div class="detail-section">
                    <h4>Organization Info</h4>
                    <div class="tenant-row">
                        <label>Name:</label>
                        <span>@tenantDetails.Name</span>
                    </div>
                    <div class="tenant-row">
                        <label>Slug:</label>
                        <span>@tenantDetails.Slug</span>
                    </div>
                    @* The school's app name (rebrand 2026-09-24): set here for a school that asks support,
                       otherwise on its own Appearance page. Same rule, same sentence as there. *@
                    <div class="tenant-row">
                        <label for="tenant-brand-name">App name:</label>
                        <div class="tenant-brand-edit">
                            <QInput id="tenant-brand-name" @bind-Value="brandNameEdit" Placeholder="@ProductBrand.Name"
                                    MaxLength="@ProductBrand.MaxBrandNameLength"
                                    HasError="@(ProductBrand.ValidateBrandName(brandNameEdit) != null)"
                                    ErrorMessage="@ProductBrand.ValidateBrandName(brandNameEdit)" />
                            <QButton Text="Save" Size="sm" Variant="secondary" Loading="@isSavingBrandName"
                                     Disabled="@(ProductBrand.ValidateBrandName(brandNameEdit) != null || (brandNameEdit ?? "").Trim() == (tenantDetails.BrandName ?? ""))"
                                     OnClick="@(() => SaveBrandName(tenantDetails.Id))" />
                        </div>
                    </div>
                    <div class="tenant-row">
                        <label>Status:</label>
                        <QBadge Text="@tenantDetails.Status.ToString()" Variant="@GetStatusVariant(tenantDetails.Status)" />
                    </div>
                    <div class="tenant-row">
                    </div>
                </div>

                <div class="detail-section">
                    <h4>Contact Info</h4>
                    <div class="tenant-row">
                        <label>Email:</label>
                        <span>@(tenantDetails.ContactEmail ?? "N/A")</span>
                    </div>
                    <div class="tenant-row">
                        <label>Phone:</label>
                        <span>@(tenantDetails.ContactPhone ?? "N/A")</span>
                    </div>
                    <div class="tenant-row">
                        <label>Billing Email:</label>
                        <span>@(tenantDetails.BillingEmail ?? "N/A")</span>
                    </div>
                </div>

                <div class="detail-section">
                    <h4>Usage Statistics</h4>
                    <div class="tenant-row">
                        <label>Branches:</label>
                        <span>@tenantDetails.BranchCount / @tenantDetails.Usage?.MaxBranches</span>
                    </div>
                    <div class="tenant-row">
                        <label>Users:</label>
                        <span>@tenantDetails.UserCount</span>
                    </div>
                    <div class="tenant-row">
                        <label>Tokens (this month):</label>
                        <span>@tenantDetails.Usage?.TokensCreated.ToString("N0") / @tenantDetails.Usage?.MaxTokens.ToString("N0")</span>
                    </div>
                    <div class="tenant-row">
                        <label>API Calls (this month):</label>
                        <span>@tenantDetails.Usage?.ApiCalls.ToString("N0") / @tenantDetails.Usage?.MaxApiCalls.ToString("N0")</span>
                    </div>
                    <div class="tenant-row">
                        <label>Storage:</label>
                        <span>@tenantDetails.Usage?.StorageUsedMb.ToString("N0") MB / @tenantDetails.Usage?.MaxStorageMb.ToString("N0") MB</span>
                    </div>
                </div>

                <div class="detail-section">
                    <h4>
                        Storage Quota Override
                        <QInfo Label="the storage override"
                               Text="@($"Content should mostly live on external platforms — YouTube, Vimeo, Google Drive, TikTok — that this app links to rather than hosts. Direct uploads are capped per plan, {tenantDetails.Usage?.MaxStorageMb.ToString("N0")} MB by default. Set an override only for a tenant that genuinely needs more local room.")" />
                    </h4>
                    <div class="tenant-row">
                        <label>Override (MB):</label>
                        <div class="storage-quota-editor">
                            <input type="number" min="0" class="form-control" style="max-width:140px;"
                                   @bind="storageQuotaInput" placeholder="Plan default" />
                            <QButton Text="Save" Icon="check-lg" Variant="primary" Size="sm"
                                     Disabled="@isSavingStorageQuota" OnClick="@(() => SaveStorageQuota(tenantDetails.Id))" />
                            @if (tenantDetails.Usage?.StorageQuotaOverrideMb != null)
                            {
                                <QButton Text="Clear" Icon="x-lg" Variant="ghost" Size="sm"
                                         Disabled="@isSavingStorageQuota" OnClick="@(() => ClearStorageQuota(tenantDetails.Id))" />
                            }
                        </div>
                    </div>
                </div>

                @* ---- Lifecycle and deletion --------------------------------------------
                   An unpaid account does not sit here for ever. It moves Suspended -> Closed ->
                   Scheduled -> deleted on published clocks (Terms §8a), and the tenant is emailed
                   before each step. A purge is the END of that, never a shortcut through it. *@
                <div class="detail-section">
                    <h4>Lifecycle</h4>
                    @{ var life = tenantDetails.Lifecycle; }
                    <div class="tenant-row">
                        <label>Stage:</label>
                        <span>@(life?.Status ?? tenantDetails.Status.ToString())</span>
                    </div>
                    @if (life?.NextStatus != null && life.DaysUntilNextTransition != null)
                    {
                        <div class="tenant-row">
                            <label>Next:</label>
                            <span>
                                becomes <strong>@life.NextStatus</strong> in @life.DaysUntilNextTransition day(s)@(life.NextTransitionDueAt is { } d ? $" — {QDateFormat.D(d)}" : "")
                            </span>
                        </div>
                    }
                    @if (life?.HasFinancialRecords == true)
                    {
                        @* State, not explanation: it changes what a purge of THIS tenant will leave behind,
                           so the fact stays on the page and only the reasoning moves into the popover. *@
                        <div class="tenant-row">
                            <label>Has paid:</label>
                            <span>
                                invoices kept 5 years
                                <QInfo Label="statutory retention"
                                       Text="Uganda's Tax Procedures Code requires tax records for five years. A purge keeps this tenant's invoices and payments — amounts, dates and references — and blanks the contact details on them. Everything else still goes. A tenant that never paid has no such record and purges whole." />
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(lifecycleError))
                    {
                        <div class="validation-error">@lifecycleError</div>
                    }

                    <div class="action-buttons-vertical" style="margin-top:8px;">
                        @if (tenantDetails.Status != TenantStatus.Cancelled && tenantDetails.Status != TenantStatus.PendingDeletion)
                        {
                            <QButton Text="Close account" Icon="door-closed" Variant="outline-danger" Size="sm"
                                     Disabled="@isSavingLifecycle" OnClick="@(() => SetLifecycle(tenantDetails.Id, "Cancelled"))" />
                        }
                        @if (tenantDetails.Status == TenantStatus.Cancelled)
                        {
                            <QButton Text="Schedule deletion" Icon="calendar-x" Variant="danger" Size="sm"
                                     Disabled="@isSavingLifecycle" OnClick="@(() => SetLifecycle(tenantDetails.Id, "PendingDeletion"))" />
                        }
                        @if (tenantDetails.Status == TenantStatus.PendingDeletion)
                        {
                            <QButton Text="Cancel the deletion" Icon="arrow-counterclockwise" Variant="secondary" Size="sm"
                                     Disabled="@isSavingLifecycle" OnClick="@(() => SetLifecycle(tenantDetails.Id, "Cancelled"))" />
                        }
                    </div>

                    @if (life?.History is { Count: > 0 })
                    {
                        <p class="section-hint" style="margin-top:10px;">
                            @foreach (var e in life.History.Take(5))
                            {
                                <span class="lifecycle-line">@QDateFormat.D(e.OccurredAt) — @(e.FromStatus ?? "new") → @e.ToStatus, by @e.Actor@(string.IsNullOrWhiteSpace(e.Reason) ? "" : $" ({e.Reason})")</span>
                            }
                        </p>
                    }
                </div>

                @* ---- What this tenant IS, and removing it -------------------------------- *@
                <div class="detail-section">
                    <h4>
                        Data &amp; deletion
                        <QInfo Label="a purge"
                               Text="A purge removes every record this organisation owns, every uploaded file and every queued background job, then re-reads the database to verify nothing is left. If anything is, the whole thing is rolled back and nothing is deleted." />
                    </h4>
                    @* A warning is not a hint and stays on the page. *@
                    <p class="domain-last-error">This cannot be undone.</p>

                    <div class="tenant-row">
                        <label>Holdings:</label>
                        <div class="storage-quota-editor">
                            <QButton Text="@(residue == null ? "Count it" : "Recount")" Icon="search" Variant="secondary" Size="sm"
                                     Disabled="@isCountingResidue" OnClick="@(() => LoadResidue(tenantDetails.Id))" />
                            @if (residue != null)
                            {
                                <span class="override-note">
                                    @residue.TotalRows row(s) in @residue.RowsByTable.Count table(s) ·
                                    @residue.Files.Count file(s) · @residue.BackgroundJobs job(s)@(residue.RetainedByTable.Count > 0 ? $" · {residue.RetainedByTable.Values.Sum()} retained under statute" : "")
                                </span>
                            }
                        </div>
                    </div>

                    @if (residue?.ExternalReferences is { Count: > 0 })
                    {
                        <p class="section-hint">Outside this system: @string.Join("; ", residue.ExternalReferences)</p>
                    }

                    @if (tenantDetails.Status == TenantStatus.PendingDeletion)
                    {
                        <div class="tenant-row">
                            <label>Type the name:</label>
                            <div class="storage-quota-editor">
                                <input type="text" class="form-control" style="max-width:260px;"
                                       placeholder="@tenantDetails.Name" @bind="purgeConfirmName" />
                                <QButton Text="Purge permanently" Icon="trash3-fill" Variant="danger" Size="sm"
                                         Disabled="@isPurging" OnClick="@(() => PurgeTenant(tenantDetails.Id, tenantDetails.Name))" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="section-hint">
                            Schedule the deletion first.
                            <QInfo Label="why the purge is not offered"
                                   Text="A purge is the end of the lifecycle, not a way round it. Close the account, then schedule its deletion; only then can it be purged, and the organisation's name has to be typed back to confirm." />
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(purgeMessage))
                    {
                        <p class="@(purgeFailed ? "domain-last-error" : "section-hint")">@purgeMessage</p>
                    }
                </div>

                @* ---- Custom domain ------------------------------------------------------
                   Platform-only by decision: bringing a domain live touches the web server, so a
                   tenant does not self-serve this.

                   THE CERTIFICATE IS A HYBRID. A subdomain of the platform's own host is covered
                   by the certificate this server already carries and goes live with nothing
                   issued; a tenant's OWN domain — which that certificate can never cover — is
                   issued one of its own over http-01. Neither branch may take a tenant live
                   behind a name mismatch, so the helper refuses instead.

                   Every failure below names the STEP. "We could not find the TXT record" sends
                   somebody to their registrar; "it does not point at this server yet" sends them
                   to a different record at the same registrar; "the certificate could not be
                   issued" sends them to us. A single "failed" would send them to the wrong one. *@
                <div class="detail-section">
                    <h4>Custom Domain</h4>
                    @{ var domain = tenantDetails.CustomDomainStatus ?? new CustomDomainStatusDto(); }

                    @if (!string.IsNullOrEmpty(domainError))
                    {
                        <div class="validation-error">@domainError</div>
                    }

                    @if (domain.State == CustomDomainState.None)
                    {
                        <p class="section-hint">
                            A subdomain, e.g. <strong>dashboard.theirschool.com</strong>.
                            <QInfo Label="tenant domains"
                                   Text="It has to be a subdomain: DNS forbids a CNAME at a domain's root, so an apex can only be pointed here with a provider-specific ALIAS record that many registrars do not offer. The tenant creates a TXT record to prove ownership, then we issue the certificate; nothing is routed until both are done." />
                        </p>
                        <div class="tenant-row">
                            <label>Domain:</label>
                            <div class="storage-quota-editor">
                                <input type="text" class="form-control" style="max-width:260px;" placeholder="dashboard.theirschool.com" @bind="domainInput" />
                                <QButton Text="Request domain" Icon="globe2" Variant="primary" Size="sm"
                                         Disabled="@isSavingDomain" OnClick="@(() => RequestDomain(tenantDetails.Id))" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="tenant-row">
                            <label>Status:</label>
                            <QBadge Text="@DomainStateLabel(domain.State)" Variant="@DomainStateVariant(domain.State)" />
                        </div>
                        <div class="tenant-row">
                            <label>Domain:</label>
                            <span>@(domain.Domain ?? domain.PendingDomain)</span>
                        </div>

                        @if (domain.State is CustomDomainState.Pending or CustomDomainState.Verified)
                        {
                            @* The exact record, name and value, ready to be copied. A DNS record
                               retyped from a screenshot is the single most common way this step
                               fails, so it is selectable text and a copy button, never an image. *@
                            <p class="section-hint">
                                Ask the tenant to add <strong>both</strong> records, then Check now.
                                <QInfo Label="the TXT record"
                                       Text="It goes at their DNS provider, exactly as shown — name and value. DNS changes can take up to an hour to appear, so a first check often finds nothing; that is normal. Once it matches we issue the certificate and only then does anything route to the domain." />
                            </p>
                            @* TWO RECORDS, NOT ONE. The CNAME makes the name point here; the TXT
                               proves they own it. Until 2026-09-21 this panel asked only for the
                               TXT, so a domain could reach "Verified" while still resolving to the
                               tenant's old web host — and the first anybody heard of it was a
                               certificate that could not be issued for a domain nobody could
                               reach. Both are selectable text with a copy button, never an image:
                               a DNS record retyped off a screenshot is the commonest way this step
                               fails. *@
                            @if (!string.IsNullOrEmpty(domain.RoutingRecordValue))
                            {
                                <div class="tenant-row">
                                    <label>1. CNAME name:</label>
                                    <div class="storage-quota-editor">
                                        <code class="dns-value">@domain.RoutingRecordName</code>
                                        <QButton Icon="clipboard" Variant="ghost" Size="sm" OnClick="@(() => CopyAsync(domain.RoutingRecordName))" />
                                    </div>
                                </div>
                                <div class="tenant-row">
                                    <label>1. CNAME value:</label>
                                    <div class="storage-quota-editor">
                                        <code class="dns-value">@domain.RoutingRecordValue</code>
                                        <QButton Icon="clipboard" Variant="ghost" Size="sm" OnClick="@(() => CopyAsync(domain.RoutingRecordValue))" />
                                    </div>
                                </div>
                            }
                            <div class="tenant-row">
                                <label>2. TXT name:</label>
                                <div class="storage-quota-editor">
                                    <code class="dns-value">@domain.VerificationRecordName</code>
                                    <QButton Icon="clipboard" Variant="ghost" Size="sm" OnClick="@(() => CopyAsync(domain.VerificationRecordName))" />
                                </div>
                            </div>
                            <div class="tenant-row">
                                <label>2. TXT value:</label>
                                <div class="storage-quota-editor">
                                    <code class="dns-value">@domain.VerificationRecordValue</code>
                                    <QButton Icon="clipboard" Variant="ghost" Size="sm" OnClick="@(() => CopyAsync(domain.VerificationRecordValue))" />
                                </div>
                            </div>
                            @if (domain.State == CustomDomainState.Verified)
                            {
                                <p class="section-hint">Ownership is proved. The domain is not being served yet — press Check now to bring it live.</p>
                            }
                        }

                        @if (domain.VerifiedAt.HasValue)
                        {
                            <div class="tenant-row"><label>Verified:</label><span>@QDateFormat.D(domain.VerifiedAt.Value)</span></div>
                        }
                        @if (domain.ServingSince.HasValue)
                        {
                            @* No renewal date, in either branch. The shared certificate is
                               maintained outside Q-Mgr entirely, and a certificate issued for a
                               tenant domain is renewed by the box's own timer, not by this
                               application — so a date here would be a guess and an implied promise
                               to watch it. The server log carries the real expiry. *@
                            <div class="tenant-row"><label>Served since:</label><span>@QDateFormat.D(domain.ServingSince.Value)</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(domain.LastError))
                        {
                            <p class="domain-last-error">@domain.LastError</p>
                        }
                        @if (domain.GaveUp)
                        {
                            @* The daily sweep has stopped. Said out loud, because otherwise a
                               domain simply goes quiet and nobody knows it needs a hand. *@
                            <p class="domain-last-error">Automatic checking has stopped after @domain.Attempts attempts. Press Check now once the DNS record is in place.</p>
                        }

                        <div class="action-buttons-vertical" style="margin-top:8px;">
                            @if (domain.State != CustomDomainState.Live)
                            {
                                <QButton Text="Check now" Icon="arrow-clockwise" Variant="primary" Size="sm"
                                         Disabled="@isSavingDomain" OnClick="@(() => VerifyDomain(tenantDetails.Id))" />
                            }
                            <QButton Text="Release domain" Icon="x-circle" Variant="outline-danger" Size="sm"
                                     Disabled="@isSavingDomain" OnClick="@(() => ReleaseDomain(tenantDetails.Id))" />
                        </div>
                    }
                </div>

                @* ---- Negotiated entitlements --------------------------------------------
                   What a customer actually gets is recorded on their own row, never inferred from
                   a catalogue row — the same reasoning as the agreed price. These can only turn a
                   flag ON: taking away something a module grants is a refund question. *@
                <div class="detail-section">
                    <h4>
                        Feature Overrides
                        <QInfo Label="feature overrides"
                               Text="Granted by hand, outside any module this tenant holds — for a negotiated deal. Switching one off only removes the override: a tenant keeps whatever their modules give them, because taking that away is a refund question rather than a switch." />
                    </h4>
                    @foreach (var feature in OverridableFeatures)
                    {
                        var on = tenantDetails.FeatureOverrides.TryGetValue(feature.Code, out var v) && v;
                        <div class="tenant-row">
                            <label>@feature.Label:</label>
                            <div class="storage-quota-editor">
                                <QSwitch Value="@on" Disabled="@isSavingOverride" aria-label="@feature.Label"
                                         ValueChanged="@(v => SetOverride(tenantDetails.Id, feature.Code, v))" />
                                <QInfo Label="@feature.Label" Text="@feature.Note" />
                            </div>
                        </div>
                    }
                </div>

                @if (tenantDetails.Subscription != null)
                {
                    <div class="detail-section">
                        <h4>Subscription</h4>
                        <div class="tenant-row">
                            <label>Plan:</label>
                            <span>@tenantDetails.Subscription.PlanName</span>
                        </div>
                        <div class="tenant-row">
                            <label>Status:</label>
                            <QBadge Text="@tenantDetails.Subscription.Status.ToString()" Variant="primary" />
                        </div>
                        <div class="tenant-row">
                            <label>Billing Cycle:</label>
                            <span>@tenantDetails.Subscription.BillingCycle</span>
                        </div>
                        <div class="tenant-row">
                            <label>Current Period Ends:</label>
                            <span>@QDateFormat.D(tenantDetails.Subscription.CurrentPeriodEnd)</span>
                        </div>
                    </div>
                }

                <div class="detail-section">
                    <h4>Actions</h4>
                    <div class="action-buttons-vertical">
                        <QButton Text="Manage Modules" Icon="grid-3x3-gap-fill" Variant="secondary" Size="sm"
                                 OnClick="@(async () => { showDetailsModal = false; await ShowModulesDialog(MapToSummary(tenantDetails)); })" />
                        @if (tenantDetails.TrialEndsAt.HasValue)
                        {
                            <QButton Text="Extend Trial" Icon="calendar-plus-fill" Variant="secondary" Size="sm"
                                     OnClick="@(() => ShowExtendTrialDialog(tenantDetails.Id))" />
                        }
                        @if (tenantDetails.Status == TenantStatus.Active || tenantDetails.Status == TenantStatus.Trialing)
                        {
                            <QButton Text="Suspend Tenant" Icon="pause-circle-fill" Variant="outline-danger" Size="sm"
                                     OnClick="@(() => { showDetailsModal = false; ShowSuspendDialog(MapToSummary(tenantDetails)); })" />
                        }
                        else if (tenantDetails.Status == TenantStatus.Suspended)
                        {
                            <QButton Text="Reactivate Tenant" Icon="play-circle-fill" Variant="success" Size="sm"
                                     OnClick="@(async () => { showDetailsModal = false; await ReactivateTenant(MapToSummary(tenantDetails)); })" />
                        }
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showDetailsModal = false)" />
    </FooterContent>
</QModal>

<!-- Suspend Modal -->
<QModal @bind-Visible="showSuspendModal" Title="Suspend Tenant" Size="md">
    <ChildContent>
        @if (selectedTenant != null)
        {
            <p>Are you sure you want to suspend <strong>@selectedTenant.Name</strong>?</p>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="suspendReason" Label="Reason for suspension *"
                        Type="textarea" Rows="3" Placeholder="Enter the reason..." />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showSuspendModal = false)" />
        <QButton Text="Suspend" Icon="pause-circle-fill" Variant="danger" OnClick="@ConfirmSuspend" Loading="@isSubmitting" />
    </FooterContent>
</QModal>

<!-- Manage Modules Modal — direct grant/revoke, no payment collected. The literal
     "platform admin can add/remove modules per customer request" lever. -->
<QModal @bind-Visible="showModulesModal" Title="Manage Modules" Size="md">
    <ChildContent>
        @if (selectedTenant != null)
        {
            <p>Modules active for <strong>@selectedTenant.Name</strong></p>
            @if (loadingModules)
            {
                <p class="qm-text-muted">Loading...</p>
            }
            else if (modulesError != null)
            {
                @* The failure used to be a toast only, so the dialog just sat there looking like it
                   was still working. Say it where the person is looking. *@
                <p class="modules-empty">
                    <QIcon Name="exclamation-triangle-fill" />
                    Could not load this tenant's modules. @modulesError
                </p>
            }
            else if (!tenantModules.Any())
            {
                <p class="modules-empty">
                    <QIcon Name="grid-3x3-gap-fill" />
                    The module catalog is empty, so there is nothing to grant yet.
                </p>
            }
            else
            {
                @if (!tenantModules.Any(m => m.Purchased))
                {
                    <p class="modules-empty">
                        <QIcon Name="info-circle-fill" />
                        This tenant holds no modules. Switch one on below to grant it.
                    </p>
                }
                <div class="modules-toggle-list">
                    @foreach (var module in tenantModules)
                    {
                        <div class="modules-toggle-row">
                            <div>
                                <strong>@module.ModuleName</strong>
                                @if (module.GrantedByPlatformAdmin && module.Purchased)
                                {
                                    <span class="qm-text-muted"> &middot; granted</span>
                                }
                                else if (module.Purchased)
                                {
                                    <span class="qm-text-muted"> &middot; @module.Status</span>
                                }
                            </div>
                            <QSwitch Value="@module.Purchased" aria-label="@module.ModuleName"
                                     ValueChanged="@(v => ToggleTenantModule(module.ModuleCode, v))" />
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showModulesModal = false)" />
    </FooterContent>
</QModal>

<!-- Extend Trial Modal -->
<QModal @bind-Visible="showExtendTrialModal" Title="Extend Trial Period" Size="md">
    <ChildContent>
        <p>Extend trial period for the selected tenant</p>
        <div class="form-group">
            <QInput TValue="int" @bind-Value="extendTrialDays" Label="Extend by (days) *"
                    Type="number" Placeholder="14" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showExtendTrialModal = false)" />
        <QButton Text="Extend Trial" Icon="calendar-plus-fill" Variant="primary" OnClick="@ConfirmExtendTrial" Loading="@isSubmitting" />
    </FooterContent>
</QModal>

