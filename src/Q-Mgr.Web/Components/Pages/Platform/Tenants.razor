    private string GetStatusVariant(TenantStatus status) => status switch
    {
        TenantStatus.Pending => "secondary",
        TenantStatus.Active => "success",
        TenantStatus.Trialing => "info",
        TenantStatus.Suspended => "warning",
        TenantStatus.Cancelled => "danger",
        TenantStatus.Deleted => "danger",
        _ => "secondary"
    };

    private TenantSummary MapToSummary(TenantDetails details) => new()
    {
        Id = details.Id,
        Name = details.Name,
        Slug = details.Slug,
        Status = details.Status,
        ContactEmail = details.ContactEmail,
        CreatedAt = details.CreatedAt,
        TrialEndsAt = details.TrialEndsAt,
        OnboardingCompleted = details.OnboardingCompleted
    };

    // BUG FIX: this used to be missing Pending and Deleted entirely, and misspelled Cancelled as
    // "Canceled" (single L) — since QMgr.Domain.Enums.TenantStatus (Q-Mgr.API/Domain/Enums/
    // BillingEnums.cs) serializes as a JSON string (JsonStringEnumConverter is global), any org
    // actually in one of the missing/misspelled states failed System.Text.Json deserialization
    // for the *entire* tenant list — not just that one row. A brand-new, not-yet-verified
    // registration sits in exactly this state (Pending) until the admin actions below act on it,
    // so this was a live bug, not a theoretical one. Values now match the real enum exactly
    // (name and int) — see that file for the authoritative definition; this is still a local
    // duplicate copy, not a Q-Mgr.Shared type, since Web doesn't reference the API project.
    // Values match the real enum exactly (name and int). PendingDeletion (6) is the last,
    // reversible window before a purge; Deleted (5) is legacy and nothing writes it — a purged
    // tenant has no row here at all.
    private enum TenantStatus { Pending = 0, Trialing = 1, Active = 2, Suspended = 3, Cancelled = 4, Deleted = 5, PendingDeletion = 6 }
    private enum SubscriptionStatus { Active, Canceled, PastDue, Trialing, Incomplete }
    private enum BillingCycle { Monthly, Annual }

