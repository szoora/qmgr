    .metric-card {
        padding: 24px;
    }

    .metric-card .q-card__body {
        display: flex;
        gap: 16px;
        padding: 0;
    }

    .metric-icon {
        width: 64px;
        height: 64px;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .metric-icon.primary {
        background: var(--qm-gradient-primary);
        color: var(--qm-text-on-primary);
    }

    .metric-icon.success {
        background: var(--qm-success);
        color: var(--qm-text-on-primary);
    }

    .metric-icon.money {
        background: var(--qm-warning);
        color: var(--qm-text-on-primary);
    }

    .metric-icon.info {
        background: var(--qm-gradient-primary);
        color: var(--qm-text-on-primary);
    }

    .metric-content {
        flex: 1;
    }

    .metric-value {
        font-size: 36px;
        font-weight: 700;
        color: var(--qm-text-primary);
        line-height: 1;
        margin-bottom: 8px;
    }

    .metric-label {
        font-size: 14px;
        color: var(--qm-text-muted);
        margin-bottom: 4px;
    }

    .metric-sublabel {
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .metric-change {
        margin-top: 8px;
        font-size: 13px;
    }

    .change-positive {
        color: var(--qm-success);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .dashboard-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
