        gap: 8px;
        margin: 0;
        font-size: 18px;
        color: var(--qm-text-primary);
    }

    .usage-stats {
        display: flex;
        gap: 32px;
        flex-wrap: wrap;
    }

    .usage-stat {
        display: flex;
        gap: 16px;
