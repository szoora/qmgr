    }

    .usage-icon {
        width: 56px;
        height: 56px;
        background: var(--qm-gradient-primary);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--qm-text-on-primary);
    }

    .usage-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--qm-text-primary);
