        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 8px;
        font-size: 32px;
        color: var(--qm-text-primary);
    }

    .page-subtitle {
        color: var(--qm-text-muted);
        margin: 0;
        font-size: 16px;
    }

    .loading-state, .error-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        text-align: center;
        color: var(--qm-text-muted);
    }

