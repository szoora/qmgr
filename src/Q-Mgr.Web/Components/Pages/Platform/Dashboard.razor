@page "/platform/dashboard"
@using System.Text.Json
@using QMgr.Web.Services
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>Platform Dashboard - Q-Mgr</PageTitle>

<div class="page-header">
    <div class="header-content">
        <h1><QIcon Name="speedometer2" Size="32" /> Platform Dashboard</h1>
        <p class="page-subtitle">Platform-wide metrics, activity, and tenant overview</p>
    </div>
</div>

<div class="admin-content">
    @if (isLoading)
    {
        <div class="loading-state">
            <QSpinner Size="lg" />
            <span>Loading dashboard...</span>
        </div>
    }
    else if (hasError)
    {
        <QCard>
            <div class="error-state">
                <QIcon Name="exclamation-triangle-fill" Size="48" />
                <h4>Failed to Load Dashboard</h4>
                <p>@errorMessage</p>
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="primary" OnClick="@LoadData" />
            </div>
        </QCard>
    }
    else
    {
        <!-- Key Metrics Cards -->
        <div class="metrics-grid">
            <QCard Class="metric-card">
                <div class="metric-icon primary">
                    <QIcon Name="building-fill" Size="32" />
                </div>
                <div class="metric-content">
                    <div class="metric-value">@stats.TotalOrganizations</div>
                    <div class="metric-label">Total Organizations</div>
                    <div class="metric-change">
                        @if (stats.NewOrganizationsThisMonth > 0)
                        {
                            <span class="change-positive">
                                <QIcon Name="arrow-up" /> +@stats.NewOrganizationsThisMonth this month
                            </span>
                        }
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-icon success">
                    <QIcon Name="check-circle-fill" Size="32" />
                </div>
                <div class="metric-content">
                    <div class="metric-value">@stats.ActiveOrganizations</div>
                    <div class="metric-label">Active Organizations</div>
                    <div class="metric-sublabel">
                        @stats.TrialingOrganizations trialing, @stats.SuspendedOrganizations suspended
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-icon money">
                    <QIcon Name="currency-dollar" Size="32" />
                </div>
                <div class="metric-content">
                    <div class="metric-value">$@stats.MonthlyRecurringRevenue.ToString("N0")</div>
                    <div class="metric-label">Monthly Recurring Revenue</div>
                    <div class="metric-sublabel">
                        ARR: $@((stats.MonthlyRecurringRevenue * 12).ToString("N0"))
                    </div>
                </div>
            </QCard>

            <QCard Class="metric-card">
                <div class="metric-icon info">
                    <QIcon Name="people-fill" Size="32" />
                </div>
                <div class="metric-content">
                    <div class="metric-value">@stats.TotalUsers</div>
                    <div class="metric-label">Total Users</div>
                    <div class="metric-sublabel">
                        @stats.TotalBranches total branches
                    </div>
                </div>
            </QCard>
        </div>

        <!-- Usage Metrics -->
        <div class="dashboard-row">
            <QCard Class="usage-card" Title="This Month's Usage" Icon="activity">
                <div class="usage-stats">
                    <div class="usage-stat">
                        <div class="usage-icon">
                            <QIcon Name="ticket-perforated-fill" Size="24" />
                        </div>
                        <div class="usage-info">
                            <div class="usage-value">@stats.TotalTokensThisMonth.ToString("N0")</div>
                            <div class="usage-label">Tokens Created</div>
                        </div>
                    </div>
                    <div class="usage-stat">
                        <div class="usage-icon">
                            <QIcon Name="arrow-left-right" Size="24" />
                        </div>
                        <div class="usage-info">
                            <div class="usage-value">@stats.TotalApiCallsThisMonth.ToString("N0")</div>
                            <div class="usage-label">API Calls</div>
                        </div>
                    </div>
                </div>
            </QCard>

            <!-- Tier Distribution -->
            <QCard Class="tier-card" Title="Tier Distribution" Icon="diagram-3-fill">
                <div class="tier-list">
                    @foreach (var tierCount in stats.OrganizationsByTier.OrderByDescending(t => t.Count))
                    {
                        var percentage = stats.TotalOrganizations > 0
                            ? (double)tierCount.Count / stats.TotalOrganizations * 100
                            : 0;
                        <div class="tier-item">
                            <div class="tier-info">
                                <span class="tier-name">@tierCount.Tier</span>
                                <span class="tier-count">@tierCount.Count orgs</span>
                            </div>
                            <div class="tier-bar">
                                <div class="tier-fill" style="width: @percentage%"></div>
                            </div>
                            <div class="tier-percentage">@percentage.ToString("N1")%</div>
                        </div>
                    }
                </div>
            </QCard>
        </div>

        <!-- Subscription Plans Overview -->
        <QCard Title="Subscription Plans" Icon="credit-card-fill">
            <div class="plans-grid">
                @foreach (var plan in plans)
                {
                    <div class="plan-card">
                        <div class="plan-header">
                            <h4>@plan.Name</h4>
                            <QBadge Text="@plan.Code" Variant="primary" />
                        </div>
                        <div class="plan-pricing">
                            <div class="price">
                                <span class="price-value">$@plan.MonthlyPriceUsd</span>
                                <span class="price-period">/month</span>
                            </div>
                            @if (plan.AnnualPriceUsd > 0)
                            {
                                <div class="price-annual">
                                    $@plan.AnnualPriceUsd/year
                                </div>
                            }
                        </div>
                        <div class="plan-stats">
                            <div class="plan-stat">
                                <QIcon Name="people-fill" />
                                <span>@plan.ActiveSubscriptions active</span>
                            </div>
                        </div>
                        <div class="plan-limits">
                            <div class="limit-item">
                                <QIcon Name="building-fill" Size="14" />
                                <span>@plan.MaxBranches branches</span>
                            </div>
                            <div class="limit-item">
                                <QIcon Name="person-fill" Size="14" />
                                <span>@plan.MaxUsersPerBranch users/branch</span>
                            </div>
                            <div class="limit-item">
                                <QIcon Name="ticket-fill" Size="14" />
                                <span>@plan.MaxTokensPerMonth.ToString("N0") tokens/mo</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </QCard>

        <!-- Recent Activity -->
        <QCard Title="Recent Activity" Icon="clock-history">
            <HeaderActions>
                <span class="activity-count">@activity.Count recent events</span>
            </HeaderActions>
            <ChildContent>
                @if (activity.Any())
                {
                    <div class="activity-list">
                        @foreach (var item in activity.Take(20))
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <QIcon Name="@GetActivityIcon(item.Type)" />
                                </div>
                                <div class="activity-content">
                                    <div class="activity-description">@item.Description</div>
                                    <div class="activity-time">@FormatTime(item.Timestamp)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-activity">
                        <QIcon Name="inbox-fill" Size="48" />
                        <p>No recent activity</p>
                    </div>
                }
            </ChildContent>
        </QCard>
    }
</div>

<style>
    .page-header {
        margin-bottom: 32px;
    }

