    }

    .empty-activity {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px;
        color: var(--qm-text-muted);
    }

    .empty-activity .rzi {
        opacity: 0.3;
        margin-bottom: 12px;
    }
</style>

@code {
    private bool isLoading = true;
    private bool hasError = false;
    private string errorMessage = "";

    private PlatformStats stats = new();
    private List<ActivityItem> activity = new();
    private List<PlanDetails> plans = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.PlatformAdmin))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        hasError = false;

        try
        {
            var statsTask = Http.GetFromJsonAsync<PlatformStats>("api/v1/admin/stats", JsonOptions);
            var activityTask = Http.GetFromJsonAsync<List<ActivityItem>>("api/v1/admin/activity", JsonOptions);
            var plansTask = Http.GetFromJsonAsync<List<PlanDetails>>("api/v1/admin/plans", JsonOptions);

            await Task.WhenAll(statsTask, activityTask, plansTask);

            stats = await statsTask ?? new();
            activity = await activityTask ?? new();
            plans = await plansTask ?? new();
        }
        catch (Exception ex)
        {
            hasError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetActivityIcon(string type) => type switch
    {
        "organization_created" => "building-add",
        "subscription_created" => "credit-card",
        _ => "circle-fill"
    };

    private string FormatTime(DateTime timestamp)
    {
        var timeSpan = DateTime.UtcNow - timestamp;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays}d ago";

        return timestamp.ToString("MMM d, yyyy");
    }

    private record PlatformStats
    {
        public int TotalOrganizations { get; init; }
        public int ActiveOrganizations { get; init; }
        public int TrialingOrganizations { get; init; }
        public int SuspendedOrganizations { get; init; }
        public int TotalUsers { get; init; }
        public int TotalBranches { get; init; }
        public List<TierCount> OrganizationsByTier { get; init; } = new();
        public int NewOrganizationsThisMonth { get; init; }
        public int NewOrganizationsLastMonth { get; init; }
        public int TotalTokensThisMonth { get; init; }
        public int TotalApiCallsThisMonth { get; init; }
        public decimal MonthlyRecurringRevenue { get; init; }
    }

    private record TierCount
    {
        public string Tier { get; init; } = "";
        public int Count { get; init; }
    }

    private record ActivityItem
    {
        public string Type { get; init; } = "";
        public string Description { get; init; } = "";
        public Guid EntityId { get; init; }
        public string EntityName { get; init; } = "";
        public DateTime Timestamp { get; init; }
    }

    private record PlanDetails
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
        public string Code { get; init; } = "";
        public string? Description { get; init; }
        public decimal MonthlyPriceUsd { get; init; }
        public decimal AnnualPriceUsd { get; init; }
        public decimal MonthlyPriceUgx { get; init; }
        public decimal AnnualPriceUgx { get; init; }
        public int MaxBranches { get; init; }
        public int MaxUsersPerBranch { get; init; }
        public int MaxTokensPerMonth { get; init; }
        public int MaxApiCallsPerMonth { get; init; }
        public bool ShowAds { get; init; }
        public bool IsPublic { get; init; }
        public int ActiveSubscriptions { get; init; }
    }
}
