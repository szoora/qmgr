</style>

@code {
    private RegisterFormData formData = new();
    private int currentStep = 1;
    private bool isSubmitting = false;
    private bool isCheckingSlug = false;
    private bool? slugAvailable;
    private string? errorMessage;
    private bool showPassword = false;
    private int passwordStrength = 0;
    private string passwordStrengthClass = "";
    private string passwordStrengthText = "";
    private bool registrationSuccess = false;
    private bool requiresVerification = false;
    private bool emailSent = false;
    private bool isResending = false;
    private bool resendComplete = false;
    private System.Timers.Timer? slugCheckTimer;
    private int trialDays = 14; // Overwritten by the real platform setting below; this is only the fallback if that fetch fails.

    // Overwritten by the real platform setting below. Deliberately blank rather than any specific
    // domain as the fallback — the base domain belongs entirely to Platform Settings, and showing
    // a guessed value if that fetch fails would be worse than showing nothing.
    private string baseDomain = "";

    private HttpClient Http => HttpClientFactory.CreateClient("QMgrAuthApi");

    protected override async Task OnInitializedAsync()
    {
        slugCheckTimer = new System.Timers.Timer(500);
        slugCheckTimer.Elapsed += async (sender, e) => await CheckSlugAvailability();
        slugCheckTimer.AutoReset = false;

        try
        {
            var response = await Http.GetFromJsonAsync<TrialInfoResponse>("api/v1/register/trial-info");
            if (response != null)
            {
                trialDays = response.TrialDays;
                if (!string.IsNullOrWhiteSpace(response.BaseDomain)) baseDomain = response.BaseDomain;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to fetch live trial length/base domain, showing fallback values instead");
        }
    }

    private record TrialInfoResponse(int TrialDays, string? BaseDomain);

    // BUG FIX: the previous "should I keep auto-generating?" check compared the OLD slug
    // (from the prior keystroke) against a slug freshly generated from the NEW full name —
    // those only ever match on the very first character typed, since the old slug was always
    // generated from a shorter name prefix. In practice the subdomain field froze after one
    // keystroke (e.g. typing "Acme Test Clinic" left the subdomain at just "a") — caught live
    // while walking through registration in the browser. Track manual edits explicitly instead
    // of trying to infer them from a comparison that could never stay true.
    private bool slugManuallyEdited = false;

    private void OnOrganizationNameChanged(ChangeEventArgs e)
    {
        formData.OrganizationName = e.Value?.ToString() ?? "";

        if (!slugManuallyEdited)
        {
            formData.Slug = GenerateSlug(formData.OrganizationName);
            ResetSlugCheck();
        }
    }

    private void OnSlugChanged(ChangeEventArgs e)
    {
        formData.Slug = e.Value?.ToString() ?? "";
        slugManuallyEdited = true;
        ResetSlugCheck();
    }

    private void ResetSlugCheck()
    {
        slugAvailable = null;
        slugCheckTimer?.Stop();

        if (!string.IsNullOrEmpty(formData.Slug) && formData.Slug.Length >= 3)
        {
            isCheckingSlug = true;
            slugCheckTimer?.Start();
        }
    }

    private async Task CheckSlugAvailability()
    {
        if (string.IsNullOrEmpty(formData.Slug) || formData.Slug.Length < 3)
        {
            isCheckingSlug = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/v1/register/check-slug/{formData.Slug}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<SlugCheckResponse>();
                slugAvailable = result?.IsAvailable ?? false;
            }
            else
            {
                slugAvailable = false;
            }
        }
        catch
        {
            slugAvailable = null;
        }
        finally
        {
            isCheckingSlug = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GenerateSlug(string name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        var slug = name.ToLowerInvariant();
        slug = Regex.Replace(slug, @"[^a-z0-9\s-]", "");
        slug = Regex.Replace(slug, @"\s+", "-");
        slug = Regex.Replace(slug, @"-+", "-");
        slug = slug.Trim('-');

        return slug.Length > 30 ? slug.Substring(0, 30) : slug;
    }

    private void OnPasswordChanged(ChangeEventArgs e)
    {
        formData.Password = e.Value?.ToString() ?? "";
        CalculatePasswordStrength();
    }

    private void CalculatePasswordStrength()
    {
        var password = formData.Password ?? "";
        var score = 0;

        if (password.Length >= 8) score += 25;
        if (password.Length >= 12) score += 15;
        if (Regex.IsMatch(password, @"[a-z]")) score += 15;
        if (Regex.IsMatch(password, @"[A-Z]")) score += 15;
        if (Regex.IsMatch(password, @"[0-9]")) score += 15;
        if (Regex.IsMatch(password, @"[^a-zA-Z0-9]")) score += 15;

        passwordStrength = Math.Min(score, 100);

        if (passwordStrength < 30)
        {
            passwordStrengthClass = "weak";
            passwordStrengthText = "Weak";
        }
        else if (passwordStrength < 50)
        {
            passwordStrengthClass = "fair";
            passwordStrengthText = "Fair";
        }
        else if (passwordStrength < 75)
        {
            passwordStrengthClass = "good";
            passwordStrengthText = "Good";
        }
        else
        {
            passwordStrengthClass = "strong";
            passwordStrengthText = "Strong";
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private bool CanProceedStep1()
    {
        return !string.IsNullOrWhiteSpace(formData.OrganizationName) &&
               !string.IsNullOrWhiteSpace(formData.Slug) &&
               formData.Slug.Length >= 3 &&
               (slugAvailable == true || slugAvailable == null);
    }

    private bool CanProceedStep2()
    {
        return !string.IsNullOrWhiteSpace(formData.FirstName) &&
               !string.IsNullOrWhiteSpace(formData.LastName) &&
               !string.IsNullOrWhiteSpace(formData.Email) &&
               !string.IsNullOrWhiteSpace(formData.Password) &&
               formData.Password.Length >= 8 &&
               formData.Password == formData.ConfirmPassword;
    }

    private void NextStep()
    {
        if (currentStep < 3)
        {
            currentStep++;
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private async Task HandleSubmit()
    {
        if (!formData.AcceptTerms)
        {
            errorMessage = "Please accept the terms and conditions.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new
            {
                organizationName = formData.OrganizationName,
                slug = formData.Slug,
                email = formData.Email,
                password = formData.Password,
                confirmPassword = formData.ConfirmPassword,
                firstName = formData.FirstName,
                lastName = formData.LastName,
                phone = formData.Phone,
                contactPhone = formData.ContactPhone,
                industryType = formData.IndustryType,
                acceptTerms = formData.AcceptTerms
            };

            var response = await Http.PostAsJsonAsync("api/v1/register", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterResponse>();
                registrationSuccess = true;
                requiresVerification = result?.RequiresEmailVerification ?? false;
                emailSent = result?.EmailSent ?? false;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Message ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration error");
            errorMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task ResendVerificationEmail()
    {
        isResending = true;
        try
        {
            await Http.PostAsJsonAsync("api/v1/register/resend-verification", new { email = formData.Email });
            // The endpoint always reports success regardless of whether a matching account
            // exists (deliberate — avoids leaking which emails are registered), so this can't
            // reflect whether SMTP is actually configured; it can only confirm the request was
            // sent, which is still useful feedback after a first attempt silently failed.
            resendComplete = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resend verification error");
        }
        finally
        {
            isResending = false;
        }
    }

    public void Dispose()
    {
        slugCheckTimer?.Dispose();
    }

    // Form model
    private class RegisterFormData
    {
        public string OrganizationName { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? Phone { get; set; }
        public string? ContactPhone { get; set; }
        public string? IndustryType { get; set; }
        public bool AcceptTerms { get; set; }
    }

    // API response models
    private record SlugCheckResponse
    {
        public bool IsAvailable { get; init; }
        public string? Message { get; init; }
    }

    private record RegisterResponse
    {
        public bool Success { get; init; }
        public Guid OrganizationId { get; init; }
        public Guid UserId { get; init; }
        public string? Slug { get; init; }
        public string? Message { get; init; }
        public bool RequiresEmailVerification { get; init; }
        public bool EmailSent { get; init; }
    }

    private record ErrorResponse
    {
        public string? Error { get; init; }
        public string? Message { get; init; }
    }
}
