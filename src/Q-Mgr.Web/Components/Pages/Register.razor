@page "/register"
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using QMgr.Application.DTOs
@using QMgr.Web.Components.Shared
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<Register> Logger

<PageTitle>Register Your Organization - Q-Mgr</PageTitle>

<div class="login-container">
    <AmbientBackground />
    <div class="login-card wide @(isSubmitting ? "loading" : "")">
        <div class="login-header">
            <div class="logo-wrapper">
                <div class="logo-circle">
                    <QIcon Name="people-fill" Size="32" />
                </div>
            </div>
            <h1>Create Your Account</h1>
            <p>Start your @trialDays-day free trial &mdash; no card required</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-alert auth-alert-danger auth-animate-in">
                <div class="auth-alert-icon">
                    <QIcon Name="exclamation-circle-fill" />
                </div>
                <div class="auth-alert-content">
                    <strong>Registration failed</strong>
                    <p>@errorMessage</p>
                </div>
                <button type="button" class="auth-alert-close" @onclick="@(() => errorMessage = null)">
                    <QIcon Name="x" />
                </button>
            </div>
        }

        @if (registrationSuccess)
        {
            <div class="success-panel">
                <div class="logo-circle success-icon">
                    <QIcon Name="check-lg" Size="32" />
                </div>
                <h2>Registration successful!</h2>
                <p>Your organization <strong>@formData.OrganizationName</strong> has been created.</p>
                @if (requiresVerification && emailSent)
                {
                    <div class="auth-alert auth-alert-success auth-animate-in">
                        <div class="auth-alert-icon"><QIcon Name="envelope-check-fill" /></div>
                        <div class="auth-alert-content">
                            <p>A verification email has been sent to <strong>@formData.Email</strong>. Check your inbox to activate your account.</p>
                        </div>
                    </div>
                }
                else if (requiresVerification && !emailSent)
                {
                    <div class="auth-alert auth-alert-danger auth-animate-in">
                        <div class="auth-alert-icon"><QIcon Name="exclamation-circle-fill" /></div>
                        <div class="auth-alert-content">
                            <p>Your account was created, but we couldn't send a verification email to <strong>@formData.Email</strong> right now.</p>
                        </div>
                    </div>
                    @if (resendComplete)
                    {
                        <p class="verify-hint">A new verification email is on its way &mdash; check your inbox in a few minutes.</p>
                    }
                    else
                    {
                        <button type="button" class="btn-login" @onclick="ResendVerificationEmail" disabled="@isResending">
                            @if (isResending)
                            {
                                <span class="auth-spinner"></span>
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Resend Verification Email</span>
                            }
                        </button>
                    }
                }
                <button type="button" class="btn-login" @onclick="GoToLogin">
                    <QIcon Name="box-arrow-in-right" Size="18" />
                    <span>Go to Login</span>
                </button>
            </div>
        }
        else
        {
            <div class="step-indicator">
                <div class="step @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "completed" : "")">
                    <span class="step-number">1</span>
                    <span class="step-label">Organization</span>
                </div>
                <div class="step-line @(currentStep > 1 ? "completed" : "")"></div>
                <div class="step @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")">
                    <span class="step-number">2</span>
                    <span class="step-label">Modules</span>
                </div>
                <div class="step-line @(currentStep > 2 ? "completed" : "")"></div>
                <div class="step @(currentStep >= 3 ? "active" : "") @(currentStep > 3 ? "completed" : "")">
                    <span class="step-number">3</span>
                    <span class="step-label">Admin Account</span>
                </div>
                <div class="step-line @(currentStep > 3 ? "completed" : "")"></div>
                <div class="step @(currentStep >= 4 ? "active" : "")">
                    <span class="step-number">4</span>
                    <span class="step-label">Confirm</span>
                </div>
            </div>

            <EditForm Model="formData" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                @if (currentStep == 1)
                {
                    <div class="form-step">
                        <div class="form-group">
                            <label for="orgName"><QIcon Name="building" Size="16" /><span>Organization Name *</span></label>
                            <div class="input-wrapper">
                                <input type="text" id="orgName" @bind="formData.OrganizationName"
                                       placeholder="e.g., SACC Software Limited" class="form-control" />
                            </div>
                            <ValidationMessage For="@(() => formData.OrganizationName)" class="validation-message" />
                        </div>

                        <div class="form-group">
                            <label for="industry"><QIcon Name="tags" Size="16" /><span>Industry Type</span></label>
                            @* Option values must match real QMgr.Domain.Enums.IndustryType member names —
                               RegisterOrganizationCommandHandler does Enum.TryParse<IndustryType>(...) and a
                               failed parse silently falls back to IndustryType.Service, seeding the wrong
                               default service types for a brand-new org. Consolidated 2026-09-02 from 9 narrow
                               verticals down to 5 broader categories — see IndustryType.cs's own doc comment
                               for the reasoning and the data migration that remapped existing orgs. *@
                            <select id="industry" @bind="formData.IndustryType" class="form-control">
                                <option value="">Select your industry</option>
                                <option value="Service">Retail, Hospitality &amp; General Service</option>
                                <option value="Business">Business (Banking, Government &amp; Offices)</option>
                                <option value="Health">Health</option>
                                <option value="Education">Education</option>
                                <option value="Communications">Communications</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="contactPhone"><QIcon Name="telephone" Size="16" /><span>Organization Phone</span></label>
                            <input type="tel" id="contactPhone" @bind="formData.ContactPhone"
                                   placeholder="0753404044" class="form-control" />
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-login" @onclick="NextStep"
                                    disabled="@(!CanProceedStep1())">
                                <span>Next Step</span>
                                <QIcon Name="arrow-right" Size="18" />
                            </button>
                        </div>
                    </div>
                }

                @if (currentStep == 2)
                {
                    <div class="form-step">
                        <div class="form-group">
                            <label><QIcon Name="grid-3x3-gap-fill" Size="16" /><span>Choose your module *</span></label>
                            <small class="form-hint">Pick the one module to start your free trial with &mdash; you can add more once this one is fully paid.</small>
                        </div>

                        @if (loadingModules)
                        {
                            <p class="form-hint">Loading modules&hellip;</p>
                        }
                        else
                        {
                            <div class="module-picker">
                                @foreach (var module in catalogModules)
                                {
                                    <label class="module-card @(selectedModuleCode == module.Code ? "selected" : "")">
                                        <input type="radio" name="module" checked="@(selectedModuleCode == module.Code)"
                                               @onchange="@(() => SelectModule(module.Code))" />
                                        <div class="module-card-body">
                                            <div class="module-card-head">
                                                <span class="module-name">@module.Name</span>
                                                <span class="module-price">@FormatPrice(module)</span>
                                            </div>
                                            <p class="module-desc">@module.Description</p>
                                            <span class="module-trial">@module.TrialDays-day free trial, no card required</span>
                                        </div>
                                    </label>
                                }
                            </div>
                        }

                        <div class="form-actions">
                            <button type="button" class="btn-secondary" @onclick="PreviousStep">
                                <QIcon Name="arrow-left" Size="18" />
                                <span>Back</span>
                            </button>
                            <button type="button" class="btn-login" @onclick="NextStep"
                                    disabled="@(selectedModuleCode == null)">
                                <span>Next Step</span>
                                <QIcon Name="arrow-right" Size="18" />
                            </button>
                        </div>
                    </div>
                }

                @if (currentStep == 3)
                {
                    <div class="form-step">
                        <div class="form-row">
                            <div class="form-group half">
                                <label for="firstName"><QIcon Name="person-fill" Size="16" /><span>First Name *</span></label>
                                <input type="text" id="firstName" @bind="formData.FirstName"
                                       placeholder="John" class="form-control" />
                                <ValidationMessage For="@(() => formData.FirstName)" class="validation-message" />
                            </div>
                            <div class="form-group half">
                                <label for="lastName"><span>Last Name *</span></label>
                                <input type="text" id="lastName" @bind="formData.LastName"
                                       placeholder="Doe" class="form-control" />
                                <ValidationMessage For="@(() => formData.LastName)" class="validation-message" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="email"><QIcon Name="envelope-fill" Size="16" /><span>Email Address *</span></label>
                            <input type="email" id="email" @bind="formData.Email"
                                   placeholder="support@getsacc.com" class="form-control" />
                            <ValidationMessage For="@(() => formData.Email)" class="validation-message" />
                            <small class="form-hint">This will be your admin login email</small>
                        </div>

                        <div class="form-group">
                            <label for="phone"><QIcon Name="telephone" Size="16" /><span>Phone Number</span></label>
                            <input type="tel" id="phone" @bind="formData.Phone"
                                   placeholder="0753404044" class="form-control" />
                        </div>

                        <div class="form-group">
                            <label for="password"><QIcon Name="lock-fill" Size="16" /><span>Password *</span></label>
                            <div class="input-wrapper">
                                <input type="@(showPassword ? "text" : "password")" id="password"
                                       @bind="formData.Password" @oninput="OnPasswordChanged"
                                       placeholder="Create a strong password" class="form-control" />
                                <button type="button" class="input-toggle" @onclick="TogglePasswordVisibility" tabindex="-1">
                                    <QIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                                </button>
                            </div>
                            <div class="password-strength">
                                <div class="strength-bar">
                                    <div class="strength-fill @passwordStrengthClass" style="width: @(passwordStrength)%"></div>
                                </div>
                                <span class="strength-text">@passwordStrengthText</span>
                            </div>
                            <ValidationMessage For="@(() => formData.Password)" class="validation-message" />
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword"><QIcon Name="lock-fill" Size="16" /><span>Confirm Password *</span></label>
                            <input type="password" id="confirmPassword" @bind="formData.ConfirmPassword"
                                   placeholder="Confirm your password" class="form-control" />
                            <ValidationMessage For="@(() => formData.ConfirmPassword)" class="validation-message" />
                            @if (!string.IsNullOrEmpty(formData.Password) && !string.IsNullOrEmpty(formData.ConfirmPassword)
                                 && formData.Password != formData.ConfirmPassword)
                            {
                                <span class="validation-message">Passwords do not match</span>
                            }
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-secondary" @onclick="PreviousStep">
                                <QIcon Name="arrow-left" Size="18" />
                                <span>Back</span>
                            </button>
                            <button type="button" class="btn-login" @onclick="NextStep"
                                    disabled="@(!CanProceedStep3())">
                                <span>Next Step</span>
                                <QIcon Name="arrow-right" Size="18" />
                            </button>
                        </div>
                    </div>
                }

                @if (currentStep == 4)
                {
                    <div class="form-step">
                        <div class="summary-section">
                            <h4>Organization Details</h4>
                            <div class="summary-row">
                                <span class="summary-label">Organization:</span>
                                <span class="summary-value">@formData.OrganizationName</span>
                            </div>
                            @if (!string.IsNullOrEmpty(formData.IndustryType))
                            {
                                <div class="summary-row">
                                    <span class="summary-label">Industry:</span>
                                    <span class="summary-value">@IndustryLabel(formData.IndustryType)</span>
                                </div>
                            }
                        </div>

                        <div class="summary-section">
                            <h4>Module</h4>
                            <div class="summary-row">
                                <span class="summary-label">Trial:</span>
                                <span class="summary-value">@(catalogModules.FirstOrDefault(m => m.Code == selectedModuleCode)?.Name)</span>
                            </div>
                        </div>

                        <div class="summary-section">
                            <h4>Admin Account</h4>
                            <div class="summary-row">
                                <span class="summary-label">Name:</span>
                                <span class="summary-value">@formData.FirstName @formData.LastName</span>
                            </div>
                            <div class="summary-row">
                                <span class="summary-label">Email:</span>
                                <span class="summary-value">@formData.Email</span>
                            </div>
                        </div>

                        <div class="form-group terms-group">
                            <label class="checkbox-wrapper">
                                <input type="checkbox" @bind="formData.AcceptTerms" />
                                <span class="checkbox-label">I agree to the <a href="/terms" target="_blank">Terms of Service</a>
                                      and <a href="/privacy" target="_blank">Privacy Policy</a></span>
                            </label>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn-secondary" @onclick="PreviousStep">
                                <QIcon Name="arrow-left" Size="18" />
                                <span>Back</span>
                            </button>
                            <button type="submit" class="btn-login"
                                    disabled="@(isSubmitting || !formData.AcceptTerms)">
                                @if (isSubmitting)
                                {
                                    <span class="auth-spinner"></span>
                                    <span>Creating Account...</span>
                                }
                                else
                                {
                                    <QIcon Name="check-lg" Size="18" />
                                    <span>Create Account</span>
                                }
                            </button>
                        </div>
                    </div>
                }
            </EditForm>
        }

        <div class="login-footer">
            <p>
                Already have an account?
                <a href="/login" class="link-register">Sign in</a>
            </p>
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <span>•</span>
                <a href="/terms">Terms of Service</a>
                <span>•</span>
                <a href="/support">Support</a>
            </div>
            <p class="powered-by">Powered by SACC Software</p>
        </div>
    </div>
</div>

<style>
    /* Register-only additions on top of the shared auth-pages.css card/form styles - the step
       indicator, slug availability, password-strength meter, and summary rows have no Login
       equivalent, so they stay here rather than bloating the shared file with page-specific CSS. */

    .success-panel {
        text-align: center;
    }

    .success-panel .success-icon {
        background: var(--qm-success);
    }

    .success-panel h2 {
        font-size: 22px;
        font-weight: 700;
        color: var(--qm-text-primary);
        margin: 16px 0 8px;
    }

    .success-panel p {
        color: var(--qm-text-secondary);
        margin: 0 0 16px;
    }

    .success-panel .btn-login {
        margin-top: 12px;
    }

    .verify-hint {
        color: var(--qm-text-secondary);
        font-size: 14px;
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
    }

    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
    }

    .step-number {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s ease;
    }

    .step.active .step-number {
        background: var(--qm-primary);
        color: white;
    }

    .step.completed .step-number {
        background: var(--qm-success);
        color: white;
    }

    .step-label {
        font-size: 11px;
        color: var(--qm-text-muted);
        transition: color 0.3s ease;
    }

    .step.active .step-label,
    .step.completed .step-label {
        color: var(--qm-text-primary);
    }

    .step-line {
        width: 50px;
        height: 2px;
        background: var(--qm-bg-elevated);
        margin: 0 0.5rem;
        margin-bottom: 1.2rem;
        transition: background 0.3s ease;
    }

    .step-line.completed {
        background: var(--qm-success);
    }

    .form-step {
        animation: registerStepFadeIn 0.3s ease;
    }

    @@keyframes registerStepFadeIn {
        from { opacity: 0; transform: translateX(10px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .form-group label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .form-row {
        display: flex;
        gap: 1rem;
        margin-bottom: 0;
    }

    .form-group.half {
        flex: 1;
    }

    /* Password-strength meter styles now live in the shared auth-pages.css (ResetPassword.razor
       reuses the exact same meter). */

    .terms-group {
        margin-top: 8px;
    }

    .terms-group .checkbox-label {
        align-items: flex-start;
    }

    .terms-group .checkbox-wrapper {
        align-items: flex-start;
    }

    .terms-group a {
        color: var(--qm-primary);
    }

    .module-picker {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 8px;
    }

    @@media (max-width: 600px) {
        .module-picker {
            grid-template-columns: 1fr;
        }
    }

    .module-card {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border: 1.5px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        padding: 14px;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
    }

    .module-card:hover {
        border-color: var(--qm-primary);
    }

    .module-card.selected {
        border-color: var(--qm-primary);
        background: var(--qm-primary-light, rgba(122, 40, 71, 0.06));
    }

    .module-card input[type="checkbox"] {
        margin-top: 3px;
        accent-color: var(--qm-primary);
        flex-shrink: 0;
    }

    .module-card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .module-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px;
    }

    .module-name {
        font-weight: 700;
        font-size: 14px;
        color: var(--qm-text-primary);
    }

    .module-price {
        font-size: 12px;
        color: var(--qm-primary);
        font-weight: 600;
        white-space: nowrap;
    }

    .module-desc {
        font-size: 12.5px;
        color: var(--qm-text-secondary);
        margin: 0;
        line-height: 1.4;
    }

    .module-trial {
        font-size: 11px;
        color: var(--qm-text-tertiary, var(--qm-text-secondary));
    }

    .summary-section {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        padding: 16px;
        margin-bottom: 16px;
    }

    .summary-section h4 {
        font-size: 12px;
        font-weight: 700;
        color: var(--qm-primary);
        margin: 0 0 12px 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--qm-border);
        font-size: 14px;
    }

    .summary-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .summary-label {
        color: var(--qm-text-secondary);
    }

    .summary-value {
        color: var(--qm-text-primary);
        font-weight: 500;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .form-actions .btn-login {
        flex: 1;
    }

    .btn-secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 14px 20px;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        border: none;
        border-radius: var(--qm-radius-lg);
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-secondary:hover {
        background: var(--qm-border);
    }

    @@media (max-width: 600px) {
        .form-row {
            flex-direction: column;
            gap: 0;
        }

        .step-label {
            display: none;
        }

        .step-line {
            width: 32px;
        }
    }
</style>

@code {
    private RegisterFormData formData = new();
    private int currentStep = 1;
    private bool isSubmitting = false;
    private string? errorMessage;
    private bool showPassword = false;
    private int passwordStrength = 0;
    private string passwordStrengthClass = "";
    private string passwordStrengthText = "";
    private bool registrationSuccess = false;
    private bool requiresVerification = false;
    private bool emailSent = false;
    private bool isResending = false;
    private bool resendComplete = false;
    private int trialDays = 14; // Overwritten by the real platform setting below; this is only the fallback if that fetch fails.
    private List<ModuleCatalogItem> catalogModules = new();
    private string? selectedModuleCode;
    private bool loadingModules = true;

    private HttpClient Http => HttpClientFactory.CreateClient("QMgrAuthApi");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<TrialInfoResponse>("api/v1/register/trial-info");
            if (response != null)
            {
                trialDays = response.TrialDays;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to fetch live trial length, showing fallback value instead");
        }

        try
        {
            catalogModules = await Http.GetFromJsonAsync<List<ModuleCatalogItem>>("api/v1/modules") ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to fetch the module catalog for registration");
        }
        finally
        {
            loadingModules = false;
        }
    }

    private record TrialInfoResponse(int TrialDays, string? BaseDomain);

    private void SelectModule(string code) => selectedModuleCode = code;

    private static string FormatPrice(ModuleCatalogItem module) =>
        $"UGX {module.MonthlyPriceUgx:N0}/mo";

    private void OnPasswordChanged(ChangeEventArgs e)
    {
        formData.Password = e.Value?.ToString() ?? "";
        var strength = PasswordStrengthHelper.Calculate(formData.Password);
        passwordStrength = strength.Score;
        passwordStrengthClass = strength.CssClass;
        passwordStrengthText = strength.Label;
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private bool CanProceedStep1()
    {
        return !string.IsNullOrWhiteSpace(formData.OrganizationName);
    }

    private bool CanProceedStep3()
    {
        return !string.IsNullOrWhiteSpace(formData.FirstName) &&
               !string.IsNullOrWhiteSpace(formData.LastName) &&
               !string.IsNullOrWhiteSpace(formData.Email) &&
               !string.IsNullOrWhiteSpace(formData.Password) &&
               formData.Password.Length >= 8 &&
               formData.Password == formData.ConfirmPassword;
    }

    private void NextStep()
    {
        if (currentStep < 4)
        {
            currentStep++;
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private async Task HandleSubmit()
    {
        if (!formData.AcceptTerms)
        {
            errorMessage = "Please accept the terms and conditions.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new
            {
                organizationName = formData.OrganizationName,
                // No user-facing subdomain picker - Slug is omitted so the API auto-generates a
                // guaranteed-unique one from organizationName (RegisterOrganizationCommandHandler
                // already supported this; the picker just never used that path).
                email = formData.Email,
                password = formData.Password,
                confirmPassword = formData.ConfirmPassword,
                firstName = formData.FirstName,
                lastName = formData.LastName,
                phone = formData.Phone,
                contactPhone = formData.ContactPhone,
                industryType = formData.IndustryType,
                acceptTerms = formData.AcceptTerms,
                selectedModuleCodes = selectedModuleCode != null ? new List<string> { selectedModuleCode } : new List<string>()
            };

            var response = await Http.PostAsJsonAsync("api/v1/register", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterResponse>();
                registrationSuccess = true;
                requiresVerification = result?.RequiresEmailVerification ?? false;
                emailSent = result?.EmailSent ?? false;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Message ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration error");
            errorMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private async Task ResendVerificationEmail()
    {
        isResending = true;
        try
        {
            await Http.PostAsJsonAsync("api/v1/register/resend-verification", new { email = formData.Email });
            // The endpoint always reports success regardless of whether a matching account
            // exists (deliberate — avoids leaking which emails are registered), so this can't
            // reflect whether SMTP is actually configured; it can only confirm the request was
            // sent, which is still useful feedback after a first attempt silently failed.
            resendComplete = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Resend verification error");
        }
        finally
        {
            isResending = false;
        }
    }

    // Mirrors the <option> label text in the Industry Type <select> above — the option values are
    // real QMgr.Domain.Enums.IndustryType member names, not all human-readable as-is (e.g.
    // "Service" for "Retail, Hospitality & General Service"), so the step-4 confirmation summary
    // needs this to show the friendly label instead of the raw enum value the user never saw on screen.
    private static readonly Dictionary<string, string> IndustryLabels = new()
    {
        ["Service"] = "Retail, Hospitality & General Service",
        ["Business"] = "Business (Banking, Government & Offices)",
        ["Health"] = "Health",
        ["Education"] = "Education",
        ["Communications"] = "Communications",
    };

    private string IndustryLabel(string? value) =>
        value != null && IndustryLabels.TryGetValue(value, out var label) ? label : value ?? "";

    // Form model
    private class RegisterFormData
    {
        public string OrganizationName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? Phone { get; set; }
        public string? ContactPhone { get; set; }
        public string? IndustryType { get; set; }
        public bool AcceptTerms { get; set; }
    }

    // API response models
    private record RegisterResponse
    {
        public bool Success { get; init; }
        public Guid OrganizationId { get; init; }
        public Guid UserId { get; init; }
        public string? Slug { get; init; }
        public string? Message { get; init; }
        public bool RequiresEmailVerification { get; init; }
        public bool EmailSent { get; init; }
    }

    private record ErrorResponse
    {
        public string? Error { get; init; }
        public string? Message { get; init; }
    }
}
