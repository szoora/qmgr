@page "/reset-password"
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using QMgr.Web.Components.Shared
@attribute [AllowAnonymous]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<ResetPassword> Logger

<PageTitle>Reset Password - Q-Mgr</PageTitle>

<div class="login-container">
    <AmbientBackground />
    <div class="login-card @(isLoading ? "loading" : "")">
        @if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            <div class="login-header">
                <div class="logo-wrapper">
                    <div class="logo-circle">
                        <QIcon Name="exclamation-circle-fill" Size="32" />
                    </div>
                </div>
                <h1>Invalid link</h1>
                <p>
                    This password reset link is missing information it needs. If you copied it from an
                    email, make sure the whole link came through, or request a new one.
                </p>
            </div>
            <a href="/forgot-password" class="btn-login">
                <span>Request a New Link</span>
                <QIcon Name="arrow-right" Size="18" />
            </a>
        }
        else if (succeeded)
        {
            <div class="login-header">
                <div class="logo-wrapper">
                    <div class="logo-circle">
                        <QIcon Name="check-circle-fill" Size="32" />
                    </div>
                </div>
                <h1>Password reset</h1>
                <p>@resultMessage</p>
            </div>
            <a href="/login" class="btn-login">
                <QIcon Name="box-arrow-in-right" Size="18" />
                <span>Sign In</span>
            </a>
        }
        else
        {
            <div class="login-header">
                <div class="logo-wrapper">
                    <div class="logo-circle">
                        <QIcon Name="key-fill" Size="32" />
                    </div>
                </div>
                <h1>Choose a new password</h1>
                <p>Resetting the password for <strong>@Email</strong></p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert auth-alert-danger auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="exclamation-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <p>@errorMessage</p>
                    </div>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="password">
                        <QIcon Name="lock-fill" Size="16" />
                        <span>New Password</span>
                    </label>
                    <div class="input-wrapper">
                        <InputText id="password" type="@(showPassword ? "text" : "password")" class="form-control"
                                   @bind-Value="model.NewPassword" @bind-Value:after="OnPasswordChanged"
                                   placeholder="Create a strong password" disabled="@isLoading" />
                        <button type="button" class="input-toggle" @onclick="@(() => showPassword = !showPassword)" tabindex="-1">
                            <QIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill @passwordStrengthClass" style="width: @(passwordStrength)%"></div>
                        </div>
                        <span class="strength-text">@passwordStrengthText</span>
                    </div>
                    <ValidationMessage For="@(() => model.NewPassword)" class="validation-message" />
                </div>

                <div class="form-group">
                    <label for="confirmPassword">
                        <QIcon Name="lock-fill" Size="16" />
                        <span>Confirm Password</span>
                    </label>
                    <InputText id="confirmPassword" type="password" class="form-control"
                               @bind-Value="model.ConfirmPassword" placeholder="Confirm your password" disabled="@isLoading" />
                    <ValidationMessage For="@(() => model.ConfirmPassword)" class="validation-message" />
                    @if (!string.IsNullOrEmpty(model.NewPassword) && !string.IsNullOrEmpty(model.ConfirmPassword)
                         && model.NewPassword != model.ConfirmPassword)
                    {
                        <span class="validation-message">Passwords do not match</span>
                    }
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="auth-spinner"></span>
                        <span>Resetting...</span>
                    }
                    else
                    {
                        <QIcon Name="check-lg" Size="18" />
                        <span>Reset Password</span>
                    }
                </button>
            </EditForm>
        }

        <div class="login-footer">
            <p>
                Remembered your password?
                <a href="/login" class="link-register">Sign in</a>
            </p>
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <span>•</span>
                <a href="/terms">Terms of Service</a>
                <span>•</span>
                <a href="/support">Support</a>
            </div>
            <p class="powered-by">Powered by SACC Software</p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private ResetPasswordModel model = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private bool succeeded = false;
    private string? errorMessage;
    private string resultMessage = "";
    private int passwordStrength = 0;
    private string passwordStrengthClass = "";
    private string passwordStrengthText = "";

    private HttpClient Http => HttpClientFactory.CreateClient("QMgrAuthApi");

    // BUG: an InputText's own two-way binding already wires the native "oninput" DOM event
    // internally; adding a separate explicit @oninput handler on the same InputText collides
    // with it, so model.NewPassword silently stopped following what the user actually typed
    // (validation kept firing against a stale/empty value even though the field visibly showed
    // the right text - caught live testing this page). @bind-Value:after runs after the
    // framework's own binding has already updated the value, so this reads the real thing.
    private void OnPasswordChanged()
    {
        var strength = PasswordStrengthHelper.Calculate(model.NewPassword);
        passwordStrength = strength.Score;
        passwordStrengthClass = strength.CssClass;
        passwordStrengthText = strength.Label;
    }

    private async Task HandleSubmit()
    {
        if (model.NewPassword != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/reset-password", new
            {
                email = Email,
                token = Token,
                newPassword = model.NewPassword,
                confirmPassword = model.ConfirmPassword
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResetPasswordResponse>();
                resultMessage = result?.Message ?? "Your password has been reset. You can now sign in with your new password.";
                succeeded = true;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                errorMessage = error?.Detail ?? "This reset link is invalid or has expired. Please request a new one.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reset-password request error");
            errorMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required")]
        [MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private record ResetPasswordResponse(string Message);
    private record ErrorResponse(string? Title, string? Detail);
}
