@page "/login"
@layout PublicLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared
@using System.ComponentModel.DataAnnotations
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject IAuthService AuthService
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Sign In - Q-Mgr</PageTitle>

<div class="login-container">
    <AmbientBackground />
    <div class="login-card @(isLoading ? "loading" : "")">
        @if (currentStep == LoginStep.Email)
        {
            <!-- Step 1: Email Input -->
            <div class="login-header">
                <div class="logo-wrapper">
                    <div class="logo-circle">
                        <QIcon Name="people-fill" Size="32" />
                    </div>
                </div>
                <h1>Welcome</h1>
                <p>Sign in to your Q-Mgr account</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert auth-alert-danger auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="exclamation-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <strong>Error</strong>
                        <p>@errorMessage</p>
                    </div>
                    <button type="button" class="auth-alert-close" @onclick="@(() => errorMessage = null)">
                        <QIcon Name="x" />
                    </button>
                </div>
            }

            @if (Verified == true)
            {
                <div class="auth-alert auth-alert-success auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="check-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <p>Email verified! You can now sign in.</p>
                    </div>
                </div>
            }

            <EditForm Model="@emailModel" OnValidSubmit="@HandleEmailSubmit" FormName="EmailLoginForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="email">
                        <QIcon Name="person-fill" Size="16" />
                        <span>Email or Username</span>
                    </label>
                    <div class="input-wrapper">
                        <InputText id="email"
                                   class="form-control"
                                   type="text"
                                   @bind-Value="emailModel.Email"
                                   placeholder="you@company.com or username"
                                   autocomplete="username"
                                   disabled="@isLoading" />
                        @if (!string.IsNullOrEmpty(emailModel.Email))
                        {
                            <button type="button" class="input-clear" @onclick="@(() => emailModel.Email = string.Empty)" tabindex="-1">
                                <QIcon Name="x-circle-fill" />
                            </button>
                        }
                    </div>
                    <ValidationMessage For="@(() => emailModel.Email)" class="validation-message" />
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="auth-spinner"></span>
                        <span>Checking...</span>
                    }
                    else
                    {
                        <span>Continue</span>
                        <QIcon Name="arrow-right" Size="18" />
                    }
                </button>
            </EditForm>
        }
        else
        {
            <!-- Step 2: Password Input -->
            <div class="login-header">
                <button type="button" class="btn-back" @onclick="@GoBackToEmail">
                    <QIcon Name="arrow-left" Size="20" />
                </button>
                <div class="user-avatar">
                    @GetInitials(identifyResponse?.Email ?? "")
                </div>
                <h2 class="user-email">@identifyResponse?.Email</h2>
                <div class="org-badge">
                    <QIcon Name="building-fill" Size="14" />
                    <span>@identifyResponse?.OrganizationName</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-alert auth-alert-danger auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="exclamation-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <strong>Authentication Failed</strong>
                        <p>@errorMessage</p>
                    </div>
                    <button type="button" class="auth-alert-close" @onclick="@(() => errorMessage = null)">
                        <QIcon Name="x" />
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="auth-alert auth-alert-success auth-animate-in">
                    <div class="auth-alert-icon">
                        <QIcon Name="check-circle-fill" />
                    </div>
                    <div class="auth-alert-content">
                        <p>@successMessage</p>
                    </div>
                </div>
            }

            <EditForm Model="@passwordModel" OnValidSubmit="@HandlePasswordSubmit" FormName="PasswordLoginForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="password">
                        <QIcon Name="lock-fill" Size="16" />
                        <span>Password</span>
                    </label>
                    <div class="input-wrapper">
                        <InputText id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind-Value="passwordModel.Password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   disabled="@isLoading" />
                        <button type="button" class="input-toggle" @onclick="@(() => showPassword = !showPassword)" tabindex="-1">
                            <QIcon Name="@(showPassword ? "eye-slash" : "eye")" />
                        </button>
                    </div>
                    <ValidationMessage For="@(() => passwordModel.Password)" class="validation-message" />
                </div>

                <div class="form-row">
                    <label class="checkbox-wrapper">
                        <InputCheckbox @bind-Value="passwordModel.RememberMe" disabled="@isLoading" />
                        <span class="checkbox-label">Remember me for 30 days</span>
                    </label>
                    <a href="/forgot-password" class="link-forgot">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="auth-spinner"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <QIcon Name="box-arrow-in-right" Size="18" />
                        <span>Sign In</span>
                    }
                </button>
            </EditForm>
        }

        <div class="login-footer">
            <p>
                Don't have an account?
                <a href="/register" class="link-register">Create one</a>
            </p>
            <div class="footer-links">
                <a href="/privacy">Privacy Policy</a>
                <span>•</span>
                <a href="/terms">Terms of Service</a>
                <span>•</span>
                <a href="/support">Support</a>
            </div>
            <p class="powered-by">Powered by SACC Software</p>
        </div>
    </div>

</div>


@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool? Verified { get; set; }

    private enum LoginStep
    {
        Email,
        Password
    }

    private LoginStep currentStep = LoginStep.Email;
    private EmailModel emailModel = new();
    private PasswordModel passwordModel = new();
    private IdentifyUserResponse? identifyResponse;
    private bool isLoading = false;
    private bool showPassword = false;
    private string? errorMessage;
    private string? successMessage;
    private int loginAttempts = 0;
    private const int MaxLoginAttempts = 5;

    protected override async Task OnInitializedAsync()
    {
        // Check if already authenticated, redirect to dashboard or return URL
        if (await AuthService.IsAuthenticatedAsync())
        {
            var redirectUrl = GetSafeReturnUrl();
            Navigation.NavigateTo(redirectUrl, forceLoad: true);
            return;
        }

        // Load "remember me" preference
        try
        {
            var remembered = await LocalStorage.GetItemAsync<bool>("remember_me");
            passwordModel.RememberMe = remembered;
        }
        catch { }
    }

    private string GetSafeReturnUrl()
    {
        // Validate the return URL to prevent open redirect attacks
        if (string.IsNullOrWhiteSpace(ReturnUrl))
            return "/";

        // Only allow relative URLs that start with /
        if (!ReturnUrl.StartsWith("/") || ReturnUrl.StartsWith("//"))
            return "/";

        // Don't redirect back to login or unauthorized pages
        if (ReturnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase) ||
            ReturnUrl.StartsWith("/unauthorized", StringComparison.OrdinalIgnoreCase))
            return "/";

        return ReturnUrl;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Auto-focus email field
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('email')?.focus()");
            }
            catch { }
        }
    }

    private async Task HandleEmailSubmit()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var result = await AuthService.IdentifyUserAsync(emailModel.Email.Trim());

            if (result == null)
            {
                errorMessage = "No account found with this email address. Please check and try again.";
            }
            else
            {
                identifyResponse = result;
                currentStep = LoginStep.Password;

                // Auto-focus password field after render
                await Task.Delay(100);
                try
                {
                    await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('password')?.focus()");
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to connect to the server. Please check your internet connection.";
            Console.WriteLine($"Identify error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandlePasswordSubmit()
    {
        if (loginAttempts >= MaxLoginAttempts)
        {
            errorMessage = $"Too many login attempts. Please try again in a few minutes.";
            return;
        }

        errorMessage = null;
        successMessage = null;
        isLoading = true;

        try
        {
            var success = await AuthService.LoginAsync(
                emailModel.Email.Trim(),
                passwordModel.Password,
                identifyResponse?.OrganizationId);

            if (success)
            {
                // Save "remember me" preference
                await LocalStorage.SetItemAsync("remember_me", passwordModel.RememberMe);

                // Notify authentication state changed
                if (AuthStateProvider is CustomAuthenticationStateProvider provider)
                {
                    provider.NotifyAuthenticationStateChanged();
                }

                successMessage = "Login successful! Redirecting...";
                await Task.Delay(500); // Brief delay to show success message

                // Redirect to return URL or dashboard
                var redirectUrl = GetSafeReturnUrl();
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
            }
            else
            {
                loginAttempts++;
                var attemptsLeft = MaxLoginAttempts - loginAttempts;

                if (attemptsLeft > 0)
                {
                    errorMessage = $"Invalid password. {attemptsLeft} attempt{(attemptsLeft != 1 ? "s" : "")} remaining.";
                }
                else
                {
                    errorMessage = "Account temporarily locked due to too many failed attempts.";
                }
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the server. Please check your internet connection.";
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBackToEmail()
    {
        currentStep = LoginStep.Email;
        passwordModel.Password = string.Empty;
        errorMessage = null;
        successMessage = null;
        loginAttempts = 0;
    }

    private string GetInitials(string email)
    {
        if (string.IsNullOrEmpty(email)) return "?";
        var parts = email.Split('@');
        if (parts.Length == 0) return "?";
        var name = parts[0];
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private class EmailModel
    {
        // Accepts either an email address or a username — the server looks up both
        // (AuthController.IdentifyUser/Login), so this is intentionally not [EmailAddress].
        [Required(ErrorMessage = "Email or username is required")]
        public string Email { get; set; } = string.Empty;
    }

    private class PasswordModel
    {
        // This is the login form — verifying an existing credential, not creating one — so it
        // deliberately does not enforce a minimum length here. Password strength rules apply
        // when a password is set/changed (PasswordValidationService), not when it's checked.
        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = false;
    }
}
