@page "/feedback"
@layout KioskLayout
@using QMgr.Application.DTOs
@inject NavigationManager Navigation
@inject IOrganizationApiService OrganizationApi

<QPageTitle Text="Give Feedback" />

<div class="feedback-entry-page">
    <div class="entry-card">
        <div class="logo">
            <QIcon Name="chat-square-text-fill" />
        </div>
        @if (branchInfo != null)
        {
            <span class="branch-context">@branchInfo.OrganizationName &middot; @branchInfo.Name</span>
        }
        else if (branchLinkInvalid)
        {
            <span class="branch-context invalid">This branch link is not valid &mdash; you can still enter a feedback code below</span>
        }
        <h1>Share Your Feedback</h1>
        <p>Enter your feedback code to share your experience</p>

        @* ACCESSIBILITY: this page is public, so the single input carries a real associated
           <label> (for/id), announces its own hint via aria-describedby, and asks for the
           uppercase alphanumeric keyboard on mobile. *@
        <div class="code-input-section">
            <label for="feedback-code-input">Feedback Code</label>
            <input type="text"
                   id="feedback-code-input"
                   @bind="feedbackCode"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp"
                   placeholder="e.g., ABC12345"
                   maxlength="10"
                   autocomplete="off"
                   autocapitalize="characters"
                   spellcheck="false"
                   aria-describedby="feedback-code-hint"
                   class="code-input" />
            <small id="feedback-code-hint">You can find this code on your printed ticket</small>
        </div>

        <button type="button" class="submit-btn" @onclick="GoToFeedback" disabled="@(string.IsNullOrWhiteSpace(feedbackCode))">
            <QIcon Name="arrow-right" />
            <span>Continue</span>
        </button>

        <div class="help-section">
            <p>Don't have a feedback code?</p>
            <p class="help-hint">
                The feedback code is provided on your service ticket after completing your visit.
                If you didn't receive a code, please contact our staff.
            </p>
        </div>
    </div>
</div>

<style>
    /* Accent, scoped. This page shares KioskLayout and the same always-dark gradient with
       KioskMode, which worked out its accent by contrast rather than by brand: --qm-primary
       (#8c2f52) measures about 2.4:1 against the dark #0f0f1a it was being paired with here as
       button text, well under the 4.5:1 AA needs, and KioskMode records the same finding at
       2.96:1 for its own hover state. This page had been left on the raw token that fix
       replaced, so it was the one public kiosk surface still failing. Same values as
       KioskMode's .industry-general so the two pages of one flow finally match. */
    .feedback-entry-page {
        --fe-accent: #d1567f;
        --fe-accent-hover: #e0759e;
        --fe-on-accent: #0f0f1a;

        min-height: 100vh;
        background: linear-gradient(135deg, #0f0f1a 0%, #1a1a2e 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .entry-card {
        background: rgba(255, 255, 255, 0.03);
        border: 2px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 480px;
        width: 100%;
        text-align: center;
        color: white;
        backdrop-filter: blur(20px);
    }

    .logo {
        width: 80px;
        height: 80px;
        background: var(--fe-accent);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
    }

    .logo .q-icon {
        font-size: 40px;
        color: var(--fe-on-accent);
    }

    .entry-card h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
    }

    /* Which branch this feedback page was opened for (from ?branch= on the shared link).
       Token-only so it follows the layout's [data-theme] automatically. */
    .branch-context {
        display: block;
        margin-bottom: 12px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--qm-text-muted);
    }

    .branch-context.invalid {
        text-transform: none;
        letter-spacing: 0;
        color: var(--qm-warning);
    }

    .entry-card > p {
        margin: 0 0 32px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 16px;
    }

    .code-input-section {
        text-align: left;
        margin-bottom: 24px;
    }

    .code-input-section label {
        display: block;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 8px;
        color: rgba(255, 255, 255, 0.8);
    }

    .code-input {
        width: 100%;
        padding: 18px 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--qm-radius-xl);
        font-size: 24px;
        font-weight: 600;
        letter-spacing: 4px;
        text-align: center;
        text-transform: uppercase;
        color: white;
        transition: all 0.3s ease;
    }

    .code-input::placeholder {
        color: rgba(255, 255, 255, 0.3);
        font-size: 18px;
        letter-spacing: 2px;
    }

    .code-input:focus {
        outline: none;
        border-color: var(--fe-accent);
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 0 4px rgba(209, 86, 127, 0.15);
    }

    .code-input-section small {
        display: block;
        margin-top: 8px;
        color: rgba(255, 255, 255, 0.4);
        font-size: 12px;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 18px 48px;
        background: var(--fe-accent);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--fe-on-accent);
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
    }

    .submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .submit-btn:focus-visible,
    .code-input:focus-visible {
        outline: 3px solid var(--fe-accent);
        outline-offset: 3px;
    }

    /* Was a 40px neon glow in the old blue-era wine — the treatment Phase 41 removed app-wide
       and this page kept. Flat, like everything else. */
    .submit-btn:hover:not(:disabled) {
        background: var(--fe-accent-hover);
    }

    .help-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .help-section p {
        margin: 0;
        color: rgba(255, 255, 255, 0.5);
        font-size: 14px;
    }

    .help-hint {
        margin-top: 8px !important;
        font-size: 13px !important;
        line-height: 1.5;
    }

    @@media (max-width: 640px) {
        .entry-card {
            padding: 32px 24px;
            border-radius: var(--qm-radius-xl);
        }

        .entry-card h1 {
            font-size: 26px;
        }

        .code-input {
            font-size: 20px;
            letter-spacing: 3px;
        }
    }

    /* ================================
       Light Theme Override
       Admin-selectable per-organization (see BrandingSettings.razor "Display
       Theme"); applied via [data-theme] on the KioskLayout wrapper. Most
       colors above are hardcoded dark-mode literals (not --qm-* tokens), so
       each needs an explicit light counterpart here rather than inheriting
       automatically from qm-theme.css's own [data-theme="light"] block. The
       accent is now the exception: it is one scoped variable, so light mode
       redefines it once below instead of restating every rule that uses it.
       ================================ */
    [data-theme="light"] .feedback-entry-page {
        background: linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);

        /* The dark accent above is a light wine picked to survive a near-black ground; on this
           near-white one it is the opposite problem, so light mode takes the ordinary wine with
           white on it (9.4:1). Both are literals rather than --qm-primary for the reason
           KioskMode gives: a white-label organization can set that token to any hex it likes,
           and a public accessibility floor is not something to hand to a customer's colour
           picker. It does mean white-label branding does not reach this page — the same
           trade-off KioskMode already makes, stated here so it reads as a decision. */
        --fe-accent: #7a2847;
        --fe-accent-hover: #611e38;
        --fe-on-accent: #ffffff;
    }

    [data-theme="light"] .entry-card {
        background: rgba(255, 255, 255, 0.7);
        border: 2px solid rgba(0, 0, 0, 0.08);
        color: #1e293b;
    }

    [data-theme="light"] .entry-card > p {
        color: rgba(0, 0, 0, 0.6);
    }

    [data-theme="light"] .code-input-section label {
        color: rgba(0, 0, 0, 0.75);
    }

    [data-theme="light"] .code-input {
        background: rgba(0, 0, 0, 0.03);
        border: 2px solid rgba(0, 0, 0, 0.12);
        color: #1e293b;
    }

    [data-theme="light"] .code-input::placeholder {
        color: rgba(0, 0, 0, 0.35);
    }

    [data-theme="light"] .code-input:focus {
        background: rgba(0, 0, 0, 0.05);
    }

    [data-theme="light"] .code-input-section small {
        color: rgba(0, 0, 0, 0.45);
    }

    [data-theme="light"] .help-section {
        border-top: 1px solid rgba(0, 0, 0, 0.1);
    }

    [data-theme="light"] .help-section p {
        color: rgba(0, 0, 0, 0.5);
    }
</style>

@code {
    private string feedbackCode = string.Empty;
    private BranchPublicDto? branchInfo;
    private bool branchLinkInvalid;

    // Customer Links shares this page as "/feedback?branch={id}". Feedback itself is keyed
    // by a per-ticket code (FeedbackPage.razor at /feedback/{code} derives the branch from
    // the code server-side), so there is no branch-level feedback form to jump to — the
    // branch is only used here to confirm which location the customer is rating.
    [SupplyParameterFromQuery(Name = "branch")]
    public Guid? BranchQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (BranchQuery is { } branchId && branchId != Guid.Empty)
        {
            branchInfo = await OrganizationApi.GetBranchPublicAsync(branchId);
            branchLinkInvalid = branchInfo == null;
        }
    }

    private void GoToFeedback()
    {
        if (!string.IsNullOrWhiteSpace(feedbackCode))
        {
            Navigation.NavigateTo($"/feedback/{feedbackCode.Trim().ToUpperInvariant()}");
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(feedbackCode))
        {
            GoToFeedback();
        }
    }
}
