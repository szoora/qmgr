@page "/feedback/{FeedbackCode}"
@layout KioskLayout
@using System.Text.Json
@using QMgr.Domain.Enums
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject NavigationManager Navigation

<PageTitle>Give Feedback - Q-Mgr</PageTitle>

<div class="feedback-page">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner">
                <QSpinner Size="lg" />
            </div>
            <p>Loading feedback form...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="error-state">
            <div class="error-icon">
                <QIcon Name="exclamation-circle-fill" Size="xl" />
            </div>
            <h2>@error</h2>
            <p>@errorDetail</p>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Return Home</span>
            </button>
        </div>
    }
    else if (alreadySubmitted)
    {
        <div class="already-submitted-state">
            <div class="submitted-icon">
                <QIcon Name="check-circle-fill" Size="xl" />
            </div>
            <h2>Feedback Already Received</h2>
            <p>Thank you! You've already submitted feedback for this service.</p>
            <div class="previous-rating">
                <span>Your rating:</span>
                <div class="stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <QIcon Name="@(existingRating >= i ? "star-fill" : "star")" Class="@(existingRating >= i ? "filled" : "")" />
                    }
                </div>
            </div>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Return Home</span>
            </button>
        </div>
    }
    else if (submitted)
    {
        <div class="success-state">
            <div class="success-animation">
                <div class="success-checkmark">
                    <QIcon Name="check-circle-fill" Size="xl" />
                </div>
            </div>
            <h2>Thank You!</h2>
            <p>Your feedback has been submitted successfully.</p>
            <p class="thank-you-detail">We truly appreciate you taking the time to share your experience. Your feedback helps us serve you better.</p>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Done</span>
            </button>
        </div>
    }
    else
    {
        <div class="feedback-form">
            <div class="feedback-header">
                <div class="logo">
                    <QIcon Name="chat-heart-fill" />
                </div>
                <h1>Share Your Feedback</h1>
                <p>We'd love to hear about your experience</p>
            </div>

            @if (!string.IsNullOrEmpty(tokenDisplayNumber))
            {
                <div class="service-info">
                    <div class="info-item">
                        <QIcon Name="ticket-perforated-fill" />
                        <div>
                            <span class="label">Ticket</span>
                            <span class="value">@tokenDisplayNumber</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(serviceTypeName))
                    {
                        <div class="info-item">
                            <QIcon Name="grid-fill" />
                            <div>
                                <span class="label">Service</span>
                                <span class="value">@serviceTypeName</span>
                            </div>
                        </div>
                    }
                    @if (serviceDate.HasValue)
                    {
                        <div class="info-item">
                            <QIcon Name="calendar3-fill" />
                            <div>
                                <span class="label">Date</span>
                                <span class="value">@serviceDate.Value.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="rating-section">
                <h3>How would you rate your experience?</h3>
                <div class="star-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var rating = i;
                        <button class="star-btn @(feedbackRating >= rating ? "active" : "") @(hoverRating >= rating ? "hover" : "")"
                                @onclick="@(() => feedbackRating = rating)"
                                @onmouseenter="@(() => hoverRating = rating)"
                                @onmouseleave="@(() => hoverRating = 0)">
                            <QIcon Name="@(feedbackRating >= rating || hoverRating >= rating ? "star-fill" : "star")" />
                        </button>
                    }
                </div>
                <div class="rating-label">
                    @GetRatingLabel()
                </div>
            </div>

            <div class="category-section">
                <h3>What area would you like to comment on?</h3>
                <div class="category-chips">
                    @foreach (var cat in feedbackCategories)
                    {
                        <button class="category-chip @(selectedCategory == cat.Value ? "selected" : "")"
                                @onclick="@(() => selectedCategory = cat.Value)">
                            <QIcon Name="@cat.Icon" />
                            <span>@cat.Label</span>
                        </button>
                    }
                </div>
            </div>

            <div class="comment-section">
                <h3>Tell us more (optional)</h3>
                <textarea @bind="feedbackComment"
                          placeholder="Share any additional thoughts or suggestions..."
                          rows="4"></textarea>
            </div>

            <div class="contact-section">
                <h3>Contact Information (optional)</h3>
                <p class="contact-hint">Leave your details if you'd like us to follow up</p>
                <div class="form-row">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" @bind="customerName" placeholder="Your name" />
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" @bind="customerEmail" placeholder="your@email.com" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Phone</label>
                    <input type="tel" @bind="customerPhone" placeholder="+1234567890" />
                </div>
            </div>

            <div class="submit-section">
                <button class="submit-btn" @onclick="SubmitFeedback" disabled="@(feedbackRating == 0 || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <QSpinner Size="sm" />
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <QIcon Name="send-fill" />
                        <span>Submit Feedback</span>
                    }
                </button>
            </div>

            <div class="privacy-note">
                <QIcon Name="lock-fill" />
                <span>Your feedback is confidential and helps us improve our services.</span>
            </div>
        </div>
    }
</div>

<style>
    .feedback-page {
        min-height: 100vh;
        background: var(--qm-bg-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .loading-state, .error-state, .already-submitted-state, .success-state {
        text-align: center;
        color: var(--qm-text-primary);
        max-width: 400px;
    }

    .loading-spinner {
        margin-bottom: 24px;
    }

    .loading-state p {
        color: var(--qm-text-secondary);
    }

    .error-icon, .submitted-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
    }

    .error-icon {
        background: rgba(var(--qm-danger-rgb), 0.15);
        border: 2px solid rgba(var(--qm-danger-rgb), 0.3);
    }

    .error-icon .rzi {
        font-size: 56px;
        color: var(--qm-danger);
    }

    .submitted-icon {
        background: rgba(var(--qm-success-rgb), 0.15);
        border: 2px solid rgba(var(--qm-success-rgb), 0.3);
    }

    .submitted-icon .rzi {
        font-size: 56px;
        color: var(--qm-success);
    }

    .error-state h2, .already-submitted-state h2, .success-state h2 {
        margin: 0 0 12px;
        font-size: 28px;
    }

    .error-state p, .already-submitted-state p, .success-state p {
        margin: 0 0 24px;
        color: var(--qm-text-secondary);
    }

    .previous-rating {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
        margin-bottom: 24px;
    }

    .previous-rating span {
        display: block;
        margin-bottom: 12px;
        color: var(--qm-text-secondary);
    }

    .stars-display {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .stars-display .rzi {
        font-size: 32px;
        color: var(--qm-text-muted);
    }

    .stars-display .rzi.filled {
        color: var(--qm-warning);
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        background: var(--qm-primary);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-on-primary);
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .action-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 0 30px rgba(var(--qm-primary-rgb), 0.3);
    }

    /* Success State */
    .success-animation {
        margin-bottom: 24px;
    }

    .success-checkmark {
        width: 100px;
        height: 100px;
        background: var(--qm-success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: success-pop 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .success-checkmark .rzi {
        font-size: 56px;
        color: var(--qm-text-on-primary);
    }

    @@keyframes success-pop {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }

    .thank-you-detail {
        font-size: 14px !important;
        max-width: 320px;
        margin: 0 auto 24px !important;
    }

    /* Feedback Form */
    .feedback-form {
        background: var(--qm-bg-card);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 600px;
        width: 100%;
        color: var(--qm-text-primary);
        backdrop-filter: blur(20px);
    }

    .feedback-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .feedback-header .logo {
        width: 80px;
        height: 80px;
        background: var(--qm-primary);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .feedback-header .logo .rzi {
        font-size: 40px;
        color: var(--qm-text-on-primary);
    }

    .feedback-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
    }

    .feedback-header p {
        margin: 0;
        color: var(--qm-text-secondary);
        font-size: 16px;
    }

    /* Service Info */
    .service-info {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        padding: 20px;
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        margin-bottom: 32px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .info-item .rzi {
        font-size: 24px;
        color: var(--qm-primary);
    }

    .info-item .label {
        display: block;
        font-size: 12px;
        color: var(--qm-text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-item .value {
        display: block;
        font-size: 16px;
        font-weight: 600;
    }

    /* Sections */
    .rating-section, .category-section, .comment-section, .contact-section {
        margin-bottom: 32px;
    }

    .rating-section h3, .category-section h3, .comment-section h3, .contact-section h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 16px;
        text-align: center;
    }

    /* Star Rating */
    .star-rating {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .star-btn {
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .star-btn .rzi {
        font-size: 36px;
        color: var(--qm-text-muted);
        transition: all 0.3s ease;
    }

    .star-btn:hover, .star-btn.hover {
        background: rgba(var(--qm-warning-rgb), 0.1);
        border-color: rgba(var(--qm-warning-rgb), 0.3);
        transform: scale(1.1);
    }

    .star-btn:hover .rzi, .star-btn.hover .rzi {
        color: var(--qm-warning);
    }

    .star-btn.active {
        background: rgba(var(--qm-warning-rgb), 0.15);
        border-color: var(--qm-warning);
    }

    .star-btn.active .rzi {
        color: var(--qm-warning);
        text-shadow: 0 0 20px rgba(var(--qm-warning-rgb), 0.5);
    }

    .rating-label {
        text-align: center;
        font-size: 16px;
        font-weight: 600;
        color: var(--qm-primary);
        min-height: 24px;
    }

    /* Categories */
    .category-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .category-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-secondary);
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-chip .rzi {
        font-size: 18px;
    }

    .category-chip:hover {
        background: var(--qm-bg-card-hover);
        border-color: var(--qm-text-muted);
    }

    .category-chip.selected {
        background: rgba(var(--qm-primary-rgb), 0.15);
        border-color: var(--qm-primary);
        color: var(--qm-primary);
    }

    /* Comment */
    .comment-section textarea {
        width: 100%;
        padding: 16px 18px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: var(--qm-text-primary);
        resize: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .comment-section textarea::placeholder {
        color: var(--qm-text-muted);
    }

    .comment-section textarea:focus {
        outline: none;
        border-color: var(--qm-primary);
        background: var(--qm-bg-card-hover);
    }

    /* Contact Section */
    .contact-hint {
        text-align: center;
        margin: -8px 0 16px;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--qm-text-secondary);
    }

    .form-group input {
        width: 100%;
        padding: 14px 16px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: var(--qm-text-primary);
        transition: all 0.3s ease;
    }

    .form-group input::placeholder {
        color: var(--qm-text-muted);
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--qm-primary);
        background: var(--qm-bg-card-hover);
    }

    /* Submit */
    .submit-section {
        text-align: center;
        margin-bottom: 20px;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px 48px;
        background: var(--qm-primary);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-on-primary);
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 250px;
    }

    .submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .submit-btn:hover:not(:disabled) {
        transform: scale(1.02);
        box-shadow: 0 0 40px rgba(var(--qm-primary-rgb), 0.4);
    }

    .spinning {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Privacy Note */
    .privacy-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--qm-text-muted);
        font-size: 12px;
    }

    .privacy-note .rzi {
        font-size: 14px;
    }

    /* Responsive */
    @@media (max-width: 640px) {
        .feedback-form {
            padding: 32px 24px;
            border-radius: var(--qm-radius-xl);
        }

        .feedback-header h1 {
            font-size: 26px;
        }

        .star-btn {
            width: 52px;
            height: 52px;
        }

        .star-btn .rzi {
            font-size: 28px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .submit-btn {
            width: 100%;
            padding: 18px 24px;
        }
    }

</style>

@code {
    [Parameter] public string FeedbackCode { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool submitted = false;
    private bool alreadySubmitted = false;
    private string? error;
    private string? errorDetail;

    private string? tokenDisplayNumber;
    private string? serviceTypeName;
    private string? branchName;
    private DateTime? serviceDate;
    private int existingRating = 0;

    private int feedbackRating = 0;
    private int hoverRating = 0;
    private FeedbackCategory selectedCategory = FeedbackCategory.General;
    private string? feedbackComment;
    private string? customerName;
    private string? customerEmail;
    private string? customerPhone;

    private readonly List<(FeedbackCategory Value, string Label, string Icon)> feedbackCategories = new()
    {
        (FeedbackCategory.General, "General", "chat"),
        (FeedbackCategory.ServiceQuality, "Service Quality", "star"),
        (FeedbackCategory.WaitTime, "Wait Time", "clock"),
        (FeedbackCategory.StaffBehavior, "Staff", "person"),
        (FeedbackCategory.Facility, "Facility", "building"),
        (FeedbackCategory.Other, "Other", "three-dots")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedbackInfo();
    }

    private async Task LoadFeedbackInfo()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/feedback/{FeedbackCode}");

            if (response.IsSuccessStatusCode)
            {
                var info = await response.Content.ReadFromJsonAsync<FeedbackInfoResponse>(JsonOptions);
                if (info != null)
                {
                    tokenDisplayNumber = info.TokenDisplayNumber;
                    serviceTypeName = info.ServiceTypeName;
                    branchName = info.BranchName;
                    serviceDate = info.ServiceDate;
                    alreadySubmitted = info.AlreadySubmitted;
                    existingRating = info.ExistingRating ?? 0;
                }
            }
            else
            {
                error = "Invalid or Expired Link";
                errorDetail = "This feedback link is no longer valid. It may have expired or already been used.";
            }
        }
        catch (Exception ex)
        {
            error = "Connection Error";
            errorDetail = "Unable to connect to the server. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetRatingLabel()
    {
        return feedbackRating switch
        {
            1 => "Very Poor",
            2 => "Poor",
            3 => "Average",
            4 => "Good",
            5 => "Excellent!",
            _ => "Tap a star to rate"
        };
    }

    private async Task SubmitFeedback()
    {
        if (feedbackRating == 0) return;

        isSubmitting = true;
        StateHasChanged();

        try
        {
            var request = new
            {
                FeedbackCode = FeedbackCode,
                Rating = feedbackRating,
                Comment = feedbackComment,
                Category = selectedCategory,
                CustomerName = customerName,
                CustomerPhone = customerPhone,
                CustomerEmail = customerEmail
            };

            var response = await Http.PostAsJsonAsync("api/v1/feedback/submit", request, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                submitted = true;
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to submit feedback. Please try again.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"An error occurred: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private record FeedbackInfoResponse
    {
        public string FeedbackCode { get; init; } = string.Empty;
        public string? TokenDisplayNumber { get; init; }
        public string? ServiceTypeName { get; init; }
        public string? BranchName { get; init; }
        public DateTime? ServiceDate { get; init; }
        public bool AlreadySubmitted { get; init; }
        public int? ExistingRating { get; init; }
    }
}
