@page "/feedback/{FeedbackCode}"
@layout KioskLayout
@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject NavigationManager Navigation

<PageTitle>Give Feedback - Q-Mgr</PageTitle>

<div class="feedback-page">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="loading-spinner">
                <QSpinner Size="lg" />
            </div>
            <p>Loading feedback form...</p>
        </div>
    }
    else if (error != null)
    {
        <div class="error-state">
            <div class="error-icon">
                <QIcon Name="exclamation-circle-fill" Size="xl" />
            </div>
            <h2>@error</h2>
            <p>@errorDetail</p>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Return Home</span>
            </button>
        </div>
    }
    else if (alreadySubmitted)
    {
        <div class="already-submitted-state">
            <div class="submitted-icon">
                <QIcon Name="check-circle-fill" Size="xl" />
            </div>
            <h2>Feedback Already Received</h2>
            <p>Thank you! You've already submitted feedback for this service.</p>
            <div class="previous-rating">
                <span>Your rating:</span>
                <div class="stars-display">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <QIcon Name="@(existingRating >= i ? "star-fill" : "star")" Class="@(existingRating >= i ? "filled" : "")" />
                    }
                </div>
            </div>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Return Home</span>
            </button>
        </div>
    }
    else if (submitted)
    {
        <div class="success-state">
            <div class="success-animation">
                <div class="success-checkmark">
                    <QIcon Name="check-circle-fill" Size="xl" />
                </div>
            </div>
            <h2>Thank You!</h2>
            <p>Your feedback has been submitted successfully.</p>
            <p class="thank-you-detail">We truly appreciate you taking the time to share your experience. Your feedback helps us serve you better.</p>
            <button class="action-btn" @onclick="GoHome">
                <QIcon Name="house-fill" />
                <span>Done</span>
            </button>
        </div>
    }
    else
    {
        <div class="feedback-form">
            <div class="feedback-header">
                <div class="logo">
                    <QIcon Name="chat-heart-fill" />
                </div>
                <h1>Share Your Feedback</h1>
                <p>We'd love to hear about your experience</p>
            </div>

            @if (!string.IsNullOrEmpty(tokenDisplayNumber))
            {
                <div class="service-info">
                    <div class="info-item">
                        <QIcon Name="ticket-perforated-fill" />
                        <div>
                            <span class="label">Ticket</span>
                            <span class="value">@tokenDisplayNumber</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(serviceTypeName))
                    {
                        <div class="info-item">
                            <QIcon Name="grid-fill" />
                            <div>
                                <span class="label">Service</span>
                                <span class="value">@serviceTypeName</span>
                            </div>
                        </div>
                    }
                    @if (serviceDate.HasValue)
                    {
                        <div class="info-item">
                            <QIcon Name="calendar3-fill" />
                            <div>
                                <span class="label">Date</span>
                                <span class="value">@serviceDate.Value.ToString("MMMM dd, yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @* ACCESSIBILITY: every rating scale on this page is a fieldset element with a real
               <legend> (so a screen reader announces the question before the options), and each
               option is a native <button> — natively focusable and activated by Enter/Space —
               carrying role="radio", aria-checked and a full-sentence aria-label. The visible
               star glyphs are decorative, so the label is the only thing that has to read well. *@
            <fieldset class="rating-section">
                <legend>How would you rate your experience?</legend>
                <div class="star-rating" role="radiogroup" aria-label="Overall service rating, 1 to 5 stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var rating = i;
                        <button type="button"
                                role="radio"
                                aria-checked="@(feedbackRating == rating ? "true" : "false")"
                                aria-label="@($"{rating} out of 5 stars - {RatingWord(rating)}")"
                                class="star-btn @(feedbackRating >= rating ? "active" : "") @(hoverRating >= rating ? "hover" : "")"
                                @onclick="@(() => feedbackRating = rating)"
                                @onmouseenter="@(() => hoverRating = rating)"
                                @onmouseleave="@(() => hoverRating = 0)">
                            <QIcon Name="@(feedbackRating >= rating || hoverRating >= rating ? "star-fill" : "star")" />
                        </button>
                    }
                </div>
                <div class="rating-label" aria-live="polite">
                    @GetRatingLabel()
                </div>
            </fieldset>

            <fieldset class="category-section">
                <legend>What area would you like to comment on?</legend>
                <div class="category-chips" role="radiogroup" aria-label="Feedback area">
                    @foreach (var cat in feedbackCategories)
                    {
                        var category = cat;
                        <button type="button"
                                role="radio"
                                aria-checked="@(selectedCategory == category.Value ? "true" : "false")"
                                aria-label="@category.Label"
                                class="category-chip @(selectedCategory == category.Value ? "selected" : "")"
                                @onclick="@(() => selectedCategory = category.Value)">
                            <QIcon Name="@category.Icon" />
                            <span>@category.Label</span>
                        </button>
                    }
                </div>
            </fieldset>

            @* Branch-configured survey questions, rendered in DisplayOrder after the core rating. *@
            @foreach (var question in questions)
            {
                var q = question;
                var answer = answers.GetValueOrDefault(q.Id, string.Empty);

                if (q.QuestionType == FeedbackQuestionType.FreeText)
                {
                    <div class="survey-section">
                        <label class="survey-legend" for="@($"q-{q.Id}")">
                            @q.QuestionText
                            @if (q.IsRequired)
                            {
                                <span class="required-mark" aria-hidden="true">*</span>
                                <span class="visually-hidden">(required)</span>
                            }
                        </label>
                        <textarea id="@($"q-{q.Id}")"
                                  class="survey-textarea"
                                  rows="3"
                                  maxlength="1000"
                                  required="@q.IsRequired"
                                  aria-required="@(q.IsRequired ? "true" : "false")"
                                  value="@answer"
                                  @oninput="@(e => SetAnswer(q.Id, e.Value?.ToString()))"></textarea>
                    </div>
                }
                else
                {
                    <fieldset class="survey-section">
                        <legend>
                            @q.QuestionText
                            @if (q.IsRequired)
                            {
                                <span class="required-mark" aria-hidden="true">*</span>
                                <span class="visually-hidden">(required)</span>
                            }
                        </legend>

                        @if (q.QuestionType == FeedbackQuestionType.Rating)
                        {
                            <div class="star-rating star-rating--sm" role="radiogroup" aria-label="@q.QuestionText">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var star = i;
                                    var selected = int.TryParse(answer, out var current) ? current : 0;
                                    <button type="button"
                                            role="radio"
                                            aria-checked="@(selected == star ? "true" : "false")"
                                            aria-label="@($"{star} out of 5 stars - {RatingWord(star)}")"
                                            class="star-btn star-btn--sm @(selected >= star ? "active" : "")"
                                            @onclick="@(() => SetAnswer(q.Id, star.ToString()))">
                                        <QIcon Name="@(selected >= star ? "star-fill" : "star")" />
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="category-chips" role="radiogroup" aria-label="@q.QuestionText">
                                @foreach (var option in OptionsFor(q))
                                {
                                    var value = option;
                                    <button type="button"
                                            role="radio"
                                            aria-checked="@(string.Equals(answer, value, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                                            aria-label="@value"
                                            class="category-chip @(string.Equals(answer, value, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                            @onclick="@(() => SetAnswer(q.Id, value))">
                                        <span>@value</span>
                                    </button>
                                }
                            </div>
                        }
                    </fieldset>
                }
            }

            @* Net Promoter Score — deliberately its own step, visually separated from the 1-5
               service rating above so the two scales don't get confused with each other. Always
               optional; a skipped NPS is stored as null, never as a 0. *@
            <fieldset class="nps-section">
                <legend>How likely are you to recommend us to a friend or colleague?</legend>
                <div class="nps-scale" role="radiogroup" aria-label="Likelihood to recommend, 0 to 10">
                    @for (int i = 0; i <= 10; i++)
                    {
                        var score = i;
                        <button type="button"
                                role="radio"
                                aria-checked="@(npsScore == score ? "true" : "false")"
                                aria-label="@($"{score} out of 10 - {NpsWord(score)}")"
                                class="nps-btn @(npsScore == score ? "selected" : "") @NpsBandClass(score)"
                                @onclick="@(() => npsScore = npsScore == score ? null : score)">
                            @score
                        </button>
                    }
                </div>
                <div class="nps-anchors" aria-hidden="true">
                    <span>Not at all likely</span>
                    <span>Extremely likely</span>
                </div>
                <p class="nps-hint">Optional &mdash; tap a number again to clear it.</p>
            </fieldset>

            <div class="comment-section">
                <label class="survey-legend" for="feedback-comment">Tell us more (optional)</label>
                <textarea id="feedback-comment"
                          @bind="feedbackComment"
                          placeholder="Share any additional thoughts or suggestions..."
                          rows="4"></textarea>
            </div>

            <details class="contact-section">
                <summary>Add your contact details (optional)</summary>
                <p class="contact-hint">Leave your details if you'd like us to follow up</p>
                <div class="form-row">
                    <div class="form-group">
                        <label for="feedback-name">Name</label>
                        <input id="feedback-name" type="text" autocomplete="name" @bind="customerName" placeholder="Your name" />
                    </div>
                    <div class="form-group">
                        <label for="feedback-email">Email</label>
                        <input id="feedback-email" type="email" autocomplete="email" @bind="customerEmail" placeholder="your@email.com" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="feedback-phone">Phone</label>
                    <input id="feedback-phone" type="tel" autocomplete="tel" @bind="customerPhone" placeholder="+1234567890" />
                </div>
            </details>

            @if (!string.IsNullOrEmpty(validationError))
            {
                <p class="validation-error" role="alert">@validationError</p>
            }

            <div class="submit-section">
                <button type="button" class="submit-btn" @onclick="SubmitFeedback" disabled="@(feedbackRating == 0 || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <QSpinner Size="sm" />
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <QIcon Name="send-fill" />
                        <span>Submit Feedback</span>
                    }
                </button>
            </div>

            <div class="privacy-note">
                <QIcon Name="lock-fill" />
                <span>Your feedback is confidential and helps us improve our services.</span>
            </div>
        </div>
    }
</div>

<style>
    .feedback-page {
        min-height: 100vh;
        background: var(--qm-bg-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .loading-state, .error-state, .already-submitted-state, .success-state {
        text-align: center;
        color: var(--qm-text-primary);
        max-width: 400px;
    }

    .loading-spinner {
        margin-bottom: 24px;
    }

    .loading-state p {
        color: var(--qm-text-secondary);
    }

    .error-icon, .submitted-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 24px;
    }

    .error-icon {
        background: rgba(var(--qm-danger-rgb), 0.15);
        border: 2px solid rgba(var(--qm-danger-rgb), 0.3);
    }

    .error-icon .rzi {
        font-size: 56px;
        color: var(--qm-danger);
    }

    .submitted-icon {
        background: rgba(var(--qm-success-rgb), 0.15);
        border: 2px solid rgba(var(--qm-success-rgb), 0.3);
    }

    .submitted-icon .rzi {
        font-size: 56px;
        color: var(--qm-success);
    }

    .error-state h2, .already-submitted-state h2, .success-state h2 {
        margin: 0 0 12px;
        font-size: 28px;
    }

    .error-state p, .already-submitted-state p, .success-state p {
        margin: 0 0 24px;
        color: var(--qm-text-secondary);
    }

    .previous-rating {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
        margin-bottom: 24px;
    }

    .previous-rating span {
        display: block;
        margin-bottom: 12px;
        color: var(--qm-text-secondary);
    }

    .stars-display {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .stars-display .rzi {
        font-size: 32px;
        color: var(--qm-text-muted);
    }

    .stars-display .rzi.filled {
        color: var(--qm-warning);
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        background: var(--qm-primary);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-on-primary);
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .action-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 0 30px rgba(var(--qm-primary-rgb), 0.3);
    }

    /* Success State */
    .success-animation {
        margin-bottom: 24px;
    }

    .success-checkmark {
        width: 100px;
        height: 100px;
        background: var(--qm-success);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        animation: success-pop 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .success-checkmark .rzi {
        font-size: 56px;
        color: var(--qm-text-on-primary);
    }

    @@keyframes success-pop {
        0% { transform: scale(0); opacity: 0; }
        50% { transform: scale(1.2); }
        100% { transform: scale(1); opacity: 1; }
    }

    .thank-you-detail {
        font-size: 14px !important;
        max-width: 320px;
        margin: 0 auto 24px !important;
    }

    /* Feedback Form */
    .feedback-form {
        background: var(--qm-bg-card);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 48px;
        max-width: 600px;
        width: 100%;
        color: var(--qm-text-primary);
        backdrop-filter: blur(20px);
    }

    .feedback-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .feedback-header .logo {
        width: 80px;
        height: 80px;
        background: var(--qm-primary);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .feedback-header .logo .rzi {
        font-size: 40px;
        color: var(--qm-text-on-primary);
    }

    .feedback-header h1 {
        margin: 0 0 8px;
        font-size: 32px;
        font-weight: 700;
    }

    .feedback-header p {
        margin: 0;
        color: var(--qm-text-secondary);
        font-size: 16px;
    }

    /* Service Info */
    .service-info {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        padding: 20px;
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        margin-bottom: 32px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 16px;
    }

    .info-item .rzi {
        font-size: 24px;
        color: var(--qm-primary);
    }

    .info-item .label {
        display: block;
        font-size: 12px;
        color: var(--qm-text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-item .value {
        display: block;
        font-size: 16px;
        font-weight: 600;
    }

    /* Sections.
       The rating, category, survey and NPS groups are real fieldset elements now (each option is a
       role="radio" button inside them), so the browser's default fieldset chrome has to be
       reset before the existing spacing rules apply. */
    .rating-section, .category-section, .comment-section, .contact-section,
    .survey-section, .nps-section {
        margin: 0 0 32px;
        padding: 0;
        border: 0;
        min-width: 0; /* fieldsets default to min-content, which breaks flex wrapping */
    }

    .rating-section legend, .category-section legend,
    .survey-section legend, .nps-section legend,
    .survey-legend {
        display: block;
        width: 100%;
        padding: 0;
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 16px;
        text-align: center;
        color: var(--qm-text-primary);
    }

    .survey-section legend, .survey-legend {
        font-size: 16px;
    }

    .required-mark {
        color: var(--qm-danger);
        margin-left: 4px;
    }

    /* Screen-reader-only text: this form is public, so the "(required)" cue has to reach
       assistive tech even though the visual cue is just an asterisk. */
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Every interactive control here is keyboard-reachable; make that visible. */
    .star-btn:focus-visible,
    .category-chip:focus-visible,
    .nps-btn:focus-visible,
    .submit-btn:focus-visible,
    .action-btn:focus-visible,
    .contact-section summary:focus-visible {
        outline: 3px solid var(--qm-primary);
        outline-offset: 2px;
    }

    /* Survey questions */
    .survey-textarea {
        width: 100%;
        padding: 14px 16px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: var(--qm-text-primary);
        resize: vertical;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .survey-textarea:focus {
        outline: none;
        border-color: var(--qm-primary);
        background: var(--qm-bg-card-hover);
    }

    .star-rating--sm {
        gap: 8px;
    }

    .star-btn--sm {
        width: 48px;
        height: 48px;
    }

    .star-btn--sm .rzi {
        font-size: 24px;
    }

    /* Net Promoter Score */
    .nps-section {
        padding: 24px 20px;
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
    }

    .nps-scale {
        display: grid;
        grid-template-columns: repeat(11, minmax(0, 1fr));
        gap: 6px;
    }

    .nps-btn {
        aspect-ratio: 1;
        min-height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--qm-bg-card);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-md);
        color: var(--qm-text-secondary);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .nps-btn:hover {
        border-color: var(--qm-text-muted);
    }

    .nps-btn.selected.detractor {
        background: color-mix(in srgb, var(--qm-danger) 18%, transparent);
        border-color: var(--qm-danger);
        color: var(--qm-danger);
    }

    .nps-btn.selected.passive {
        background: color-mix(in srgb, var(--qm-warning) 18%, transparent);
        border-color: var(--qm-warning);
        color: var(--qm-warning);
    }

    .nps-btn.selected.promoter {
        background: color-mix(in srgb, var(--qm-success) 18%, transparent);
        border-color: var(--qm-success);
        color: var(--qm-success);
    }

    .nps-anchors {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .nps-hint {
        margin: 8px 0 0;
        text-align: center;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    /* Contact details are collapsed by default — the whole point is a form a customer will
       finish, and three optional inputs on screen make it look twice as long as it is. */
    .contact-section summary {
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        color: var(--qm-text-secondary);
        padding: 12px 0;
        text-align: center;
        list-style: none;
    }

    .contact-section summary::-webkit-details-marker {
        display: none;
    }

    .contact-section summary::after {
        content: " +";
        color: var(--qm-primary);
    }

    .contact-section[open] summary::after {
        content: " -";
    }

    .validation-error {
        margin: 0 0 16px;
        padding: 12px 16px;
        text-align: center;
        font-size: 14px;
        color: var(--qm-danger);
        background: color-mix(in srgb, var(--qm-danger) 12%, transparent);
        border: 1px solid var(--qm-danger);
        border-radius: var(--qm-radius-md);
    }

    /* Star Rating */
    .star-rating {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .star-btn {
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .star-btn .rzi {
        font-size: 36px;
        color: var(--qm-text-muted);
        transition: all 0.3s ease;
    }

    .star-btn:hover, .star-btn.hover {
        background: rgba(var(--qm-warning-rgb), 0.1);
        border-color: rgba(var(--qm-warning-rgb), 0.3);
        transform: scale(1.1);
    }

    .star-btn:hover .rzi, .star-btn.hover .rzi {
        color: var(--qm-warning);
    }

    .star-btn.active {
        background: rgba(var(--qm-warning-rgb), 0.15);
        border-color: var(--qm-warning);
    }

    .star-btn.active .rzi {
        color: var(--qm-warning);
        text-shadow: 0 0 20px rgba(var(--qm-warning-rgb), 0.5);
    }

    .rating-label {
        text-align: center;
        font-size: 16px;
        font-weight: 600;
        color: var(--qm-primary);
        min-height: 24px;
    }

    /* Categories */
    .category-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

    .category-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-secondary);
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .category-chip .rzi {
        font-size: 18px;
    }

    .category-chip:hover {
        background: var(--qm-bg-card-hover);
        border-color: var(--qm-text-muted);
    }

    .category-chip.selected {
        background: rgba(var(--qm-primary-rgb), 0.15);
        border-color: var(--qm-primary);
        color: var(--qm-primary);
    }

    /* Comment */
    .comment-section textarea {
        width: 100%;
        padding: 16px 18px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: var(--qm-text-primary);
        resize: none;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .comment-section textarea::placeholder {
        color: var(--qm-text-muted);
    }

    .comment-section textarea:focus {
        outline: none;
        border-color: var(--qm-primary);
        background: var(--qm-bg-card-hover);
    }

    /* Contact Section */
    .contact-hint {
        text-align: center;
        margin: -8px 0 16px;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 8px;
        color: var(--qm-text-secondary);
    }

    .form-group input {
        width: 100%;
        padding: 14px 16px;
        background: var(--qm-bg-elevated);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        font-size: 15px;
        color: var(--qm-text-primary);
        transition: all 0.3s ease;
    }

    .form-group input::placeholder {
        color: var(--qm-text-muted);
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--qm-primary);
        background: var(--qm-bg-card-hover);
    }

    /* Submit */
    .submit-section {
        text-align: center;
        margin-bottom: 20px;
    }

    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px 48px;
        background: var(--qm-primary);
        border: none;
        border-radius: var(--qm-radius-xl);
        color: var(--qm-text-on-primary);
        font-size: 18px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 250px;
    }

    .submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .submit-btn:hover:not(:disabled) {
        transform: scale(1.02);
        box-shadow: 0 0 40px rgba(var(--qm-primary-rgb), 0.4);
    }

    .spinning {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Privacy Note */
    .privacy-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--qm-text-muted);
        font-size: 12px;
    }

    .privacy-note .rzi {
        font-size: 14px;
    }

    /* Responsive */
    @@media (max-width: 640px) {
        .feedback-form {
            padding: 32px 24px;
            border-radius: var(--qm-radius-xl);
        }

        .feedback-header h1 {
            font-size: 26px;
        }

        .star-btn {
            width: 52px;
            height: 52px;
        }

        .star-btn .rzi {
            font-size: 28px;
        }

        .star-btn--sm {
            width: 42px;
            height: 42px;
        }

        .star-btn--sm .rzi {
            font-size: 20px;
        }

        /* 11 columns won't fit a phone: wrap to two rows of six/five instead of shrinking the
           tap targets below the 38px minimum. */
        .nps-scale {
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 8px;
        }

        .nps-section {
            padding: 20px 16px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .submit-btn {
            width: 100%;
            padding: 18px 24px;
        }
    }

</style>

@code {
    [Parameter] public string FeedbackCode { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool submitted = false;
    private bool alreadySubmitted = false;
    private string? error;
    private string? errorDetail;

    private string? tokenDisplayNumber;
    private string? serviceTypeName;
    private string? branchName;
    private DateTime? serviceDate;
    private int existingRating = 0;

    private int feedbackRating = 0;
    private int hoverRating = 0;
    private int? npsScore;
    private FeedbackCategory selectedCategory = FeedbackCategory.General;
    private string? feedbackComment;
    private string? customerName;
    private string? customerEmail;
    private string? customerPhone;
    private string? validationError;

    /// <summary>Branch-configured survey questions, already ordered by the API.</summary>
    private List<FeedbackQuestionDto> questions = new();

    /// <summary>QuestionId -> the customer's current answer, as text.</summary>
    private readonly Dictionary<Guid, string> answers = new();

    private readonly List<(FeedbackCategory Value, string Label, string Icon)> feedbackCategories = new()
    {
        (FeedbackCategory.General, "General", "chat"),
        (FeedbackCategory.ServiceQuality, "Service Quality", "star"),
        (FeedbackCategory.WaitTime, "Wait Time", "clock"),
        (FeedbackCategory.StaffBehavior, "Staff", "person"),
        (FeedbackCategory.Facility, "Facility", "building"),
        (FeedbackCategory.Other, "Other", "three-dots")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFeedbackInfo();
    }

    private async Task LoadFeedbackInfo()
    {
        try
        {
            var response = await Http.GetAsync($"api/v1/feedback/{FeedbackCode}");

            if (response.IsSuccessStatusCode)
            {
                var info = await response.Content.ReadFromJsonAsync<FeedbackCodeInfoDto>(JsonOptions);
                if (info != null)
                {
                    tokenDisplayNumber = info.TokenDisplayNumber;
                    serviceTypeName = info.ServiceTypeName;
                    branchName = info.BranchName;
                    serviceDate = info.ServiceDate;
                    alreadySubmitted = info.AlreadySubmitted;
                    existingRating = info.ExistingRating ?? 0;

                    // Survey questions come back with the code lookup — one round trip for the
                    // whole form, so nothing pops in after the customer has started answering.
                    questions = info.Questions ?? new List<FeedbackQuestionDto>();
                }
            }
            else
            {
                error = "Invalid or Expired Link";
                errorDetail = "This feedback link is no longer valid. It may have expired or already been used.";
            }
        }
        catch (Exception ex)
        {
            error = "Connection Error";
            errorDetail = "Unable to connect to the server. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetAnswer(Guid questionId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            answers.Remove(questionId);
        else
            answers[questionId] = value;

        validationError = null;
    }

    private static List<string> OptionsFor(FeedbackQuestionDto question)
        => question.QuestionType == FeedbackQuestionType.YesNo
            ? new List<string> { "Yes", "No" }
            : question.Options ?? new List<string>();

    private string GetRatingLabel() => feedbackRating == 0 ? "Tap a star to rate" : RatingWord(feedbackRating);

    private static string RatingWord(int rating) => rating switch
    {
        1 => "Very Poor",
        2 => "Poor",
        3 => "Average",
        4 => "Good",
        5 => "Excellent",
        _ => "Not rated"
    };

    /// <summary>
    /// Plain-language reading of an NPS point, used for the button's aria-label so a screen
    /// reader user isn't just hearing bare numbers. These are the standard NPS bands:
    /// 0-6 detractor, 7-8 passive, 9-10 promoter.
    /// </summary>
    private static string NpsWord(int score) => score switch
    {
        <= 6 => "not likely",
        <= 8 => "neutral",
        _ => "very likely"
    };

    private static string NpsBandClass(int score) => score switch
    {
        <= 6 => "detractor",
        <= 8 => "passive",
        _ => "promoter"
    };

    private async Task SubmitFeedback()
    {
        if (feedbackRating == 0) return;

        // Client-side required check purely so the customer gets a pointed message instead of a
        // generic 400 — the API validates required answers again, and it is the authority.
        var missing = questions.FirstOrDefault(q => q.IsRequired && !answers.ContainsKey(q.Id));
        if (missing != null)
        {
            validationError = $"Please answer: {missing.QuestionText}";
            await InvokeAsync(StateHasChanged);
            return;
        }

        validationError = null;
        isSubmitting = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var request = new SubmitFeedbackByCodeRequest
            {
                FeedbackCode = FeedbackCode,
                Rating = feedbackRating,
                NpsScore = npsScore,
                Comment = feedbackComment,
                Category = selectedCategory,
                CustomerName = customerName,
                CustomerPhone = customerPhone,
                CustomerEmail = customerEmail,
                Answers = answers
                    .Select(kvp => new SubmitFeedbackAnswer { QuestionId = kvp.Key, Answer = kvp.Value })
                    .ToList()
            };

            var response = await Http.PostAsJsonAsync("api/v1/feedback/submit", request, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                submitted = true;
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"An error occurred: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
