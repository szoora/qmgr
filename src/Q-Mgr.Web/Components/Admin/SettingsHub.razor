@page "/admin/settings"
@using QMgr.Domain.Constants
@using QMgr.Web.Services
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState

@*
    The Settings hub (2026-09-19). System Settings, Notifications, Industry Settings and
    Integrations were four sidebar entries and four routes for one subject: how the account itself
    is configured. The sections have no @page — see CLAUDE.md, "A hub owns the route; its sections
    own nothing".

    THIS HUB CROSSES TWO MODULE BOUNDARIES. System Settings and Notifications are base product;
    Industry is Core Queue and Integrations is Integrations & API Access, and each of those two
    carried its own ModuleRouteMap entry. The requirement moved onto the section.

    /admin/notification-settings is retired with the rest. NotificationDispatchJob's "delivery is
    failing" alert pointed at /admin/notifications — a route NO page has ever declared — so the one
    notification whose job is to report that email or SMS is broken could not be opened. It now
    points at /admin/settings?tab=notifications, which is where the delivery log actually lives.
*@

<QPageTitle Text="System Settings" />

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Settings<QInfo Text="How this account is configured: general settings, how messages are delivered, the industry the kiosk speaks for, and what Q-Mgr is connected to." Label="Settings" /></h1>
            <p class="subtitle">How this account is configured: general settings, how messages are delivered, the industry the kiosk speaks for, and what Q-Mgr is connected to.</p>
        </div>
        <div class="header-actions">
            @* The open section's own buttons land here — see QPageActions. *@
            <SectionOutlet SectionId="QPageActions.Id" />
        </div>
    </div>

    <QTabs Tabs="@tabs" @bind-ActiveKey="@hubTab" IdPrefix="st" AriaLabel="Settings sections" />

    @if (hubTab == NotificationsTab) { <NotificationSettings Embedded="true" /> }
    else if (hubTab == IndustryTab) { <IndustrySettings Embedded="true" /> }
    else if (hubTab == IntegrationsTab) { <IntegrationsSetup Embedded="true" /> }
    else if (hubTab == GeneralTab) { <SystemSettings Embedded="true" /> }
</div>

@code {
    private const string GeneralTab = "general";
    private const string NotificationsTab = "notifications";
    private const string IndustryTab = "industry";
    private const string IntegrationsTab = "integrations";

    private static readonly HubTabs.Section[] Sections =
    {
        new(new QTab(GeneralTab, "General", "sliders"), Permissions.SettingsView),
        new(new QTab(NotificationsTab, "Notifications", "bell-fill"), Permissions.NotificationsView),
        new HubTabs.Section(new QTab(IndustryTab, "Industry", "buildings"), Permissions.SettingsView)
            .RequiringModule(ModuleCodes.CoreQueue),
        new HubTabs.Section(new QTab(IntegrationsTab, "Integrations", "plug"), Permissions.SettingsView)
            .RequiringModule(ModuleCodes.IntegrationsApi),
    };

    private IReadOnlyList<QTab> tabs = Array.Empty<QTab>();
    private string hubTab = GeneralTab;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    /// <summary>The last ?tab= this hub acted on — see HubTabs.FollowQuery.</summary>
    private string? appliedTab;

    protected override async Task OnInitializedAsync()
    {
        await ModuleState.LoadAsync(ModuleApi);

        tabs = await HubTabs.VisibleAsync(PermissionService, ModuleState, Sections);
        if (tabs.Count == 0)
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        hubTab = HubTabs.Resolve(tabs, TabParam);
        appliedTab = TabParam;
    }

    /// <summary>
    /// Follow a ?tab= that changed without the route changing — a link from one tab of this
    /// hub to another. OnInitializedAsync does not re-run for that, so without this the URL
    /// would change and the screen would not. The rule itself lives in HubTabs.
    /// </summary>
    protected override void OnParametersSet()
    {
        HubTabs.FollowQuery(tabs, TabParam, ref appliedTab, ref hubTab);
    }
}
