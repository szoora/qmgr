@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@using QMgr.Application.DTOs
@using QMgr.Web.Services

@if (!Embedded)
{
    <PageTitle>Service Types - Q-Mgr</PageTitle>
}

<div class="admin-page">
    <QPageActions Embedded="@Embedded">
        <Title>
            <h1>Service Types</h1>
            <p class="subtitle">Configure service types for queue management</p>
        </Title>
        <Actions>

            @if (canCreate)
            {
                <QButton Text="Add service type" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" />
            }
        </Actions>
    </QPageActions>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading service types...</span>
        </div>
    }
    else if (!serviceTypes.Any())
    {
        <QEmptyState Icon="grid" Title="No service types yet" Text="A service type is what a customer takes a ticket for.">
            <Action>
                @if (canCreate) { <QButton Text="Add service type" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" /> }
            </Action>
        </QEmptyState>
    }
    else
    {
        <QCard NoPadding="true">
            <div class="table-wrap">
                <table class="data-table q-stack">
                    <thead><tr><th>Code</th><th>Service</th><th>Ticket prefix</th><th class="num">Average service</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var service in serviceTypes)
                        {
                            <tr>
                                <td><QChip Text="@service.Code" Color="@service.Color" Size="sm" /></td>
                                <td>
                                    <strong>@service.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(service.Description)) { <span class="cell-sub">@service.Description</span> }
                                </td>
                                <td>@service.Prefix</td>
                                <td class="num">~@service.AverageServiceTimeMinutes min</td>
                                <td class="row-actions">
                                    @if (canEdit)
                                    {
                                        <QButton Icon="pencil" Variant="ghost" Size="sm" OnClick="@(() => ShowEditDialog(service))" Title="Edit" />
                                    }
                                    @if (canDelete)
                                    {
                                        <QButton Icon="trash" Variant="ghost" Size="sm" OnClick="@(() => DeleteService(service))" Title="Delete" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </QCard>
    }
</div>

<QModal @bind-Visible="showDialog" Title="@(editingService == null ? "Add Service Type" : "Edit Service Type")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Code" Label="Code *" Placeholder="e.g., A, B, VIP" MaxLength="5" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Name" Label="Name *" Placeholder="Service name" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Description" Type="textarea" Label="Description" Placeholder="Brief description" Rows="2" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@formData.Prefix" Label="Prefix *" Placeholder="e.g., A, B" MaxLength="3" />
            </div>
            <div class="form-group">
                <QInput TValue="int" @bind-Value="@formData.EstimatedServiceTime" Type="number" Label="Est. Service Time (min)" Min="1" Max="120" />
            </div>
        </div>
        <div class="form-group">
            <label>Color</label>
            <div class="color-picker">
                @foreach (var color in availableColors)
                {
                    <div class="color-option @(formData.Color == color ? "selected" : "")"
                         style="background-color: @(color ?? "var(--qm-primary)")"
                         title="@(color is null ? "Your organisation's own brand colour" : color)"
                         @onclick="@(() => formData.Color = color)"></div>
                }
            </div>
        </div>
        <div class="form-group">
            <QCheckbox @bind-Value="@formData.IsActive" Label="Service is active" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showDialog = false)" />
        <QButton Text="@(editingService == null ? "Create" : "Save")" Icon="@(editingService == null ? "plus-lg" : "check-lg")" Variant="primary" OnClick="@SaveService" />
    </FooterContent>
</QModal>

<style>.header-content h1 {
        margin: 0 0 4px;
        color: var(--qm-text-primary);
    }
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        color: var(--qm-text-muted);
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
    }

    /* Dialog */
    .dialog-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .dialog-content {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
        width: 90%;
        max-width: 480px;
        max-height: 90vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .dialog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--qm-border);
    }

    .dialog-header h3 {
        margin: 0;
        font-size: var(--qm-text-lg);
        color: var(--qm-text-primary);
    }

    .dialog-body {
        padding: 24px;
        overflow-y: auto;
    }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid var(--qm-border);
        background: var(--qm-bg-elevated);
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: var(--qm-text-base);
        font-weight: 500;
        color: var(--qm-text-secondary);
    }
    .color-picker {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .color-option {
        width: 32px;
        height: 32px;
        border-radius: var(--qm-radius-lg);
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.2s ease;
    }

    .color-option:hover {
        transform: scale(1.1);
    }

    .color-option.selected {
        border-color: var(--qm-text-primary);
        box-shadow: 0 0 0 2px var(--qm-bg-card), 0 0 0 4px var(--qm-primary);
    }
</style>

@code {
    /// <summary>True when the Branches hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private List<ServiceTypeDto> serviceTypes = new();
    private bool isLoading = true;
    private bool showDialog = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private ServiceTypeDto? editingService;
    private ServiceFormData formData = new();

    // The first swatch is the organization's OWN brand colour, stored as null — QChip and the
    // booking page both already read it as `Color ?? var(--qm-primary)`, so it follows a rebrand.
    // The four it replaces were Q-Mgr's shipped wine, and the first was the pre-selected default,
    // so a white-labelled tenant created every service type in the old product's colours. Same
    // fault, same day, as the welfare category picker — see the note there.
    private readonly string?[] availableColors = new string?[]
    {
        null,
        "#2f6f8c", "#5b4a9e", "#47535f",
        "#16a34a", "#10b981", "#f59e0b", "#d97706",
        "#dc2626", "#ef4444", "#2f5a54", "#5a9c92"
    };

    protected override async Task OnInitializedAsync()
    {
        // Permission check and data loading moved to OnAfterRenderAsync
        // to ensure tokens are loaded from localStorage first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionService.HasPermissionAsync(Permissions.ServiceTypesView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canCreate = await PermissionService.HasPermissionAsync(Permissions.ServiceTypesCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permissions.ServiceTypesEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permissions.ServiceTypesDelete);

            await BranchState.InitializeAsync();
            TrackBranch();


            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await BranchState.InitializeAsync();
            var branchId = BranchState.CurrentBranchId;

            if (branchId == Guid.Empty)
            {
                NotificationService.Notify(ToastSeverity.Warning, "No Branch Selected", "Please select a branch from the header first.");
                isLoading = false;
                return;
            }

            var response = await Http.GetAsync($"api/v1/branches/{branchId}/service-types?includeInactive=true");
            if (response.IsSuccessStatusCode)
            {
                serviceTypes = await response.Content.ReadFromJsonAsync<List<ServiceTypeDto>>(JsonOptions) ?? new();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load service types: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddDialog()
    {
        editingService = null;
        formData = new ServiceFormData
        {
            Code = "",
            Name = "",
            Prefix = "",
            Color = null,
            EstimatedServiceTime = 10,
            IsActive = true
        };
        showDialog = true;
    }

    private void ShowEditDialog(ServiceTypeDto service)
    {
        editingService = service;
        formData = new ServiceFormData
        {
            Code = service.Code,
            Name = service.Name,
            Description = service.Description,
            Prefix = service.Prefix,
            Color = service.Color,
            EstimatedServiceTime = service.AverageServiceTimeMinutes,
            IsActive = true
        };
        showDialog = true;
    }

    private async Task SaveService()
    {
        if (string.IsNullOrWhiteSpace(formData.Code) || string.IsNullOrWhiteSpace(formData.Name))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Code and Name are required");
            return;
        }

        try
        {
            var branchId = BranchState.CurrentBranchId;
            var request = new
            {
                Code = formData.Code,
                Name = formData.Name,
                Description = formData.Description,
                Prefix = formData.Prefix,
                Color = formData.Color,
                EstimatedServiceTime = formData.EstimatedServiceTime,
                IsActive = formData.IsActive
            };

            HttpResponseMessage response;
            if (editingService == null)
            {
                response = await Http.PostAsJsonAsync($"api/v1/branches/{branchId}/service-types", request, JsonOptions);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/v1/branches/{branchId}/service-types/{editingService.Id}", request, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingService == null ? "Service type created" : "Service type updated");
                showDialog = false;
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save service type: {ex.Message}");
        }
    }

    private async Task DeleteService(ServiceTypeDto service)
    {
        try
        {
            var branchId = BranchState.CurrentBranchId;
            var response = await Http.DeleteAsync($"api/v1/branches/{branchId}/service-types/{service.Id}");

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Service type deleted");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete service type: {ex.Message}");
        }
    }

    private class ServiceFormData
    {
        public string Code { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string Prefix { get; set; } = "";
        public string? Color { get; set; }
        public int EstimatedServiceTime { get; set; } = 10;
        public bool IsActive { get; set; } = true;
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        await LoadData();
    }
}
