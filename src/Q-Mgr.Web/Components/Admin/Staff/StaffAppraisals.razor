@page "/admin/staff/appraisals"
@implements IDisposable
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@using QMgr.Web.Components.Admin.Staff
@inject IStaffPerformanceApiService StaffApi
@inject IToastService Toast
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState

<PageTitle>Appraisals - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Appraisals</h1>
            <p class="subtitle">The termly appraisal board: who is at which stage, and what the evidence says so far.</p>
        </div>
        <div class="header-actions">
            <QSelect TValue="string" TItem="StaffPeriods.Option" Value="@period" ValueChanged="@OnPeriodChanged" Items="@periodOptions"
                     TextSelector="@(p => p.Label)" ValueSelector="@(p => p.Key)" Placeholder="Period" Class="sa-period" />
            @if (canApprove && board != null && board.ScopedToDepartments.Count == 0)
            {
                @if (!IsClosed)
                {
                    <QButton Text="Open appraisals for this period" Icon="folder-plus" Variant="primary" OnClick="@OpenDialog" />
                    <QButton Text="Close period" Icon="lock" Variant="secondary" OnClick="@OpenCloseDialog" />
                }
                else
                {
                    <QButton Text="Reopen period" Icon="unlock" Variant="secondary" OnClick="@OpenReopenDialog" />
                }
            }
        </div>
    </div>

    <StaffScopeNote Departments="@(board?.ScopedToDepartments)" Noun="appraisals" />

    @if (board?.PeriodStatus is { IsClosed: true, Closure: { } closure })
    {
        <div class="sa-closed">
            <QChip Text="Closed" Icon="lock-fill" Variant="muted" Size="sm" />
            <span>
                @board.Period.Name was closed @QDateFormat.LocalDT(DateTime.SpecifyKind(closure.ClosedAt, DateTimeKind.Utc)) by @(closure.ClosedByName ?? "an approver").
                No new scored records, registers, recognition or appraisals land in it until it is reopened.
                @if (!string.IsNullOrWhiteSpace(closure.OverrideReason))
                {
                    <br /><text>Closed with @closure.UnsignedAppraisalsAtClose appraisal(s) unsigned. Reason: <em>@closure.OverrideReason</em></text>
                }
            </span>
        </div>
    }

    @if (isLoading && board == null)
    {
        <div class="loading-container"><QSpinner Size="lg" /><span>Loading the board...</span></div>
    }
    else if (board == null)
    {
        <QEmptyState Icon="clipboard-x" Title="The board could not be loaded" Text="Try another period, or reload the page." />
    }
    else
    {
        <QStatRow>
            @foreach (var stage in Enum.GetValues<AppraisalStage>())
            {
                var count = board.ByStage.TryGetValue(stage.ToString(), out var c) ? c : 0;
                <QStatTile Value="@count.ToString()" Label="@StaffDisplay.StageLabel(stage)" Variant="@(count > 0 ? StaffDisplay.StageVariant(stage) : "default")" />
            }
        </QStatRow>

        @if (board.Items.Count == 0)
        {
            <QEmptyState Icon="clipboard-check" Title="@($"No appraisals open for {board.Period.Name}")"
                         Text="@(canApprove ? "Open appraisals for this period to start the cycle: targets first, then self-assessment, appraiser review, moderation and sign-off." : "An approver opens the period's appraisals. Nothing has been opened yet.")">
                <Action>
                    @if (canApprove && board.ScopedToDepartments.Count == 0 && !IsClosed)
                    {
                        <QButton Text="Open appraisals" Icon="folder-plus" Variant="primary" OnClick="@OpenDialog" />
                    }
                </Action>
            </QEmptyState>
        }
        else
        {
            <QCard NoPadding="true">
                <div class="table-wrap">
                    <table class="data-table q-stack sa-table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Departments</th>
                                <th>Appraiser</th>
                                <th>Stage</th>
                                <th>Live composite</th>
                                <th>Final rating</th>
                                <th>Last movement</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in board.Items.OrderBy(a => (int)a.Stage).ThenBy(a => a.SubjectName))
                            {
                                <tr class="sa-row" @onclick="@(() => Navigation.NavigateTo($"/admin/staff/appraisals/{a.Id}"))" title="Open this appraisal">
                                    <td><div class="sa-person"><QAvatar Name="@a.SubjectName" Size="sm" /><span>@a.SubjectName</span></div></td>
                                    <td>@(a.SubjectDepartmentNames ?? "—")</td>
                                    <td>@a.AppraiserName</td>
                                    <td><QChip Text="@StaffDisplay.StageLabel(a.Stage)" Variant="@StaffDisplay.StageVariant(a.Stage)" Size="sm" /></td>
                                    <td>
                                        @{ var live = a.Stage == AppraisalStage.Signed ? a.ComputedScore : a.LiveScore?.Composite; }
                                        @StaffDisplay.Composite(live)
                                        @if (a.LiveScore?.BandName != null && a.Stage != AppraisalStage.Signed) { <span class="sa-muted"> · @a.LiveScore.BandName</span> }
                                    </td>
                                    <td>
                                        @if (a.FinalRating.HasValue)
                                        {
                                            <QChip Text="@($"{a.FinalRating} · {a.FinalRatingName}")" Variant="@StaffDisplay.BandVariant(a.FinalRating)" Size="sm" />
                                        }
                                        else { <span class="sa-muted">—</span> }
                                    </td>
                                    <td class="sa-muted">@QDateFormat.D((a.SignedAt ?? a.ModeratedAt ?? a.AppraiserSubmittedAt ?? a.SelfSubmittedAt ?? a.CreatedAt).ToLocalTime())</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </QCard>
        }
    }
</div>

<QModal @bind-Visible="showOpenDialog" Title="@($"Open appraisals — {board?.Period.Name ?? period}")" Icon="folder-plus" Size="md">
    <ChildContent>
        <p class="form-hint">One appraisal per person for the period, appraised by their line manager (falling back to their department head). Anyone who already has one for this period is skipped.</p>
        <div class="form-group">
            <QCheckbox @bind-Value="@openForEveryone" Label="Every active member of staff on this branch" />
        </div>
        @if (!openForEveryone)
        {
            <div class="form-group">
                <QMultiSelect TValue="Guid" TItem="StaffMemberDto" SelectedValues="@selectedSubjects" SelectedValuesChanged="@(v => selectedSubjects = v.ToList())"
                              Items="@directory" TextSelector="@(m => m.FullName)" ValueSelector="@(m => m.UserId)" Label="Staff" Placeholder="Choose people" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showOpenDialog = false)" />
        <QButton Text="Open appraisals" Icon="check-lg" Variant="primary" OnClick="@OpenAppraisals" Loading="@isOpening" Disabled="@(!openForEveryone && selectedSubjects.Count == 0)" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showCloseDialog" Title="@($"Close {board?.Period.Name ?? period}")" Icon="lock" Size="md">
    <ChildContent>
        <p class="form-hint">A closed period takes no new scored records, registers, recognition, automatic credit or appraisal openings, and its records cannot be annulled or corrected. Visibility changes stay open. An approver can reopen it.</p>
        @if (UnsignedCount > 0)
        {
            <div class="sa-warn">
                <QIcon Name="exclamation-triangle" />
                <span><strong>@UnsignedCount appraisal(s)</strong> for this period are not yet signed. You can still close it, with a reason; the reason is kept on the closure and shown on this board.</span>
            </div>
            <QInput TValue="string" @bind-Value="@closeReason" Type="textarea" Rows="3" MaxLength="1000" Label="Why close with appraisals unsigned? *"
                    Placeholder="At least ten characters." HasError="@closeReasonError" ErrorMessage="Give a reason of at least ten characters." />
        }
        else
        {
            <p>Every appraisal for this period is signed.</p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showCloseDialog = false)" />
        <QButton Text="Close period" Icon="lock" Variant="primary" OnClick="@ClosePeriod" Loading="@isClosing" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showReopenDialog" Title="@($"Reopen {board?.Period.Name ?? period}")" Icon="unlock" Size="md">
    <ChildContent>
        <p class="form-hint">Reopening lets records, registers and corrections land in this period again, which can move figures that were signed off. Signed appraisals keep their frozen scores.</p>
        <QInput TValue="string" @bind-Value="@reopenReason" Type="textarea" Rows="3" MaxLength="1000" Label="Reason *"
                Placeholder="Why the period is being reopened." HasError="@reopenReasonError" ErrorMessage="Give a reason of at least five characters." />
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showReopenDialog = false)" />
        <QButton Text="Reopen period" Icon="unlock" Variant="primary" OnClick="@ReopenPeriod" Loading="@isClosing" />
    </FooterContent>
</QModal>

<style>
    .sa-closed { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; padding: 10px 14px; margin-bottom: 14px; border: 1px solid var(--qm-border); border-left: 3px solid var(--qm-text-muted); border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); font-size: 13.5px; color: var(--qm-text-secondary); }
    .sa-closed > span { flex: 1 1 260px; min-width: 0; }
    .sa-warn { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; margin-bottom: 12px; border: 1px solid var(--qm-border); border-left: 3px solid var(--qm-warning); background: var(--qm-bg-secondary); border-radius: var(--qm-radius-sm); font-size: 13.5px; }
    .sa-warn i { color: var(--qm-warning); }
    .loading-container { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 60px 20px; color: var(--qm-text-muted); }
    .sa-period { min-width: 220px; }
    .table-wrap { overflow-x: auto; }
    .sa-row { cursor: pointer; }
    .sa-row:hover td { background: var(--qm-bg-hover, var(--qm-bg-secondary)); }
    .sa-person { display: flex; align-items: center; gap: 8px; }
    .sa-muted { color: var(--qm-text-muted); font-size: 12.5px; }
    .form-group { margin-bottom: 14px; }
</style>

@code {
    private Guid branchId;
    private bool isLoading = true;
    private bool canApprove;
    private AppraisalBoardDto? board;
    private string period = StaffPeriods.CurrentKey();
    private IReadOnlyList<StaffPeriods.Option> periodOptions = StaffPeriods.Options();
    private List<StaffMemberDto> directory = new();

    private bool showOpenDialog, isOpening, openForEveryone = true;
    private List<Guid> selectedSubjects = new();

    private bool showCloseDialog, showReopenDialog, isClosing, closeReasonError, reopenReasonError;
    private string? closeReason, reopenReason;
    private PeriodStatusDto? periodStatus;

    private bool IsClosed => board?.PeriodStatus?.IsClosed == true;

    /// <summary>Organization-wide unsigned count from the policy endpoint (the board's own count is this branch only).</summary>
    private int UnsignedCount => periodStatus?.UnsignedAppraisals ?? board?.PeriodStatus?.UnsignedAppraisals ?? 0;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasAnyPermissionAsync(Permissions.StaffAppraisalsConduct, Permissions.StaffAppraisalsApprove))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
        {
            Navigation.NavigateTo("/billing/modules");
            return;
        }

        canApprove = await PermissionService.HasPermissionAsync(Permissions.StaffAppraisalsApprove);

        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        BranchState.OnBranchChanged += HandleBranchChanged;

        try
        {
            var policy = await StaffApi.GetPolicyAsync();
            periodOptions = StaffPeriods.Options(policy.Periods);
            if (periodOptions.All(o => o.Key != period)) period = periodOptions.First().Key;
        }
        catch (Exception)
        {
            // The derived terms are a fine default; the policy read is a refinement.
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            board = await StaffApi.GetAppraisalBoardAsync(branchId, period);
        }
        catch (Exception ex)
        {
            board = null;
            Toast.Notify(ToastSeverity.Error, "Could not load the board", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPeriodChanged(string value)
    {
        period = value;
        await LoadAsync();
    }

    private void HandleBranchChanged()
    {
        branchId = BranchState.CurrentBranchId;
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private async Task OpenDialog()
    {
        openForEveryone = true;
        selectedSubjects = new();
        if (directory.Count == 0)
        {
            try { directory = (await StaffApi.GetDirectoryAsync(branchId, period)).Items.OrderBy(m => m.FullName).ToList(); }
            catch (Exception ex) { Toast.Notify(ToastSeverity.Error, "Could not load the directory", ex.Message); }
        }
        showOpenDialog = true;
    }

    private async Task OpenAppraisals()
    {
        isOpening = true;
        try
        {
            var opened = await StaffApi.OpenAppraisalsAsync(branchId, new OpenAppraisalsRequest
            {
                PeriodKey = period,
                SubjectUserIds = openForEveryone ? null : selectedSubjects
            });
            showOpenDialog = false;
            Toast.Notify(ToastSeverity.Success, $"{opened.Count} appraisal{(opened.Count == 1 ? "" : "s")} opened",
                opened.Count == 0 ? "Everyone chosen already has an appraisal for this period." : "Each subject has been asked to agree targets.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not open appraisals", ex.Message);
        }
        finally
        {
            isOpening = false;
        }
    }

    private async Task OpenCloseDialog()
    {
        closeReason = null;
        closeReasonError = false;
        periodStatus = null;
        try { periodStatus = await StaffApi.GetPeriodStatusAsync(board!.Period.Key); }
        catch (Exception) { /* the board's branch count is the fallback; the API re-checks on close */ }
        showCloseDialog = true;
    }

    private void OpenReopenDialog()
    {
        reopenReason = null;
        reopenReasonError = false;
        showReopenDialog = true;
    }

    private async Task ClosePeriod()
    {
        closeReasonError = UnsignedCount > 0 && (closeReason?.Trim().Length ?? 0) < 10;
        if (closeReasonError) return;

        isClosing = true;
        try
        {
            await StaffApi.ClosePeriodAsync(board!.Period.Key, new ClosePeriodRequest { OverrideReason = UnsignedCount > 0 ? closeReason?.Trim() : null });
            showCloseDialog = false;
            Toast.Notify(ToastSeverity.Success, $"{board.Period.Name} closed");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // A 409 here names the unsigned count the API found, which may have changed since the dialog opened.
            Toast.Notify(ToastSeverity.Error, "Could not close the period", ex.Message);
        }
        finally
        {
            isClosing = false;
        }
    }

    private async Task ReopenPeriod()
    {
        reopenReasonError = (reopenReason?.Trim().Length ?? 0) < 5;
        if (reopenReasonError) return;

        isClosing = true;
        try
        {
            await StaffApi.ReopenPeriodAsync(board!.Period.Key, new ReopenPeriodRequest { Reason = reopenReason!.Trim() });
            showReopenDialog = false;
            Toast.Notify(ToastSeverity.Success, $"{board.Period.Name} reopened");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not reopen the period", ex.Message);
        }
        finally
        {
            isClosing = false;
        }
    }

    public void Dispose() => BranchState.OnBranchChanged -= HandleBranchChanged;
}
