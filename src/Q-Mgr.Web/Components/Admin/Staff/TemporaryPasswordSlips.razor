@namespace QMgr.Web.Components.Admin.Staff

@*
    Printable temporary-password slips (duty rota plan §12.2): one cut-out slip per person — name, username,
    temporary password, sign-in address, expiry — on an A4 sheet laid over the page. The passwords exist only
    in this component's memory: they are never stored readably on the server and cannot be fetched again, so
    closing this discards them (re-issue from the Onboarding page instead). Printing hides everything but the
    sheet, so the app shell never comes out of the printer.
*@

<div class="tps-overlay" role="dialog" aria-modal="true" aria-label="Temporary password slips">
    <QPrintSheet SheetId="tps-sheet" Title="Temporary password slips" OnBack="@Close" BackText="Close">
        <ToolbarStart>
            <span class="tps-warning"><QIcon Name="exclamation-triangle-fill" /> These passwords cannot be shown again. Print them now.</span>
        </ToolbarStart>
        <ChildContent>
            <div class="tps-head">
                <strong>@OrganizationName</strong> — temporary sign-in slips, printed @QDateFormat.DT(DateTime.Now). Cut along the lines and hand each person their own slip.
            </div>
            <div class="tps-grid">
                @foreach (var s in Slips.OrderBy(s => s.SortName ?? s.FullName))
                {
                    <div class="tps-slip">
                        <div class="tps-name">@s.FullName</div>
                        <dl>
                            <dt>Sign in at</dt><dd>@SignInAddress</dd>
                            <dt>Username</dt><dd class="tps-mono">@(string.IsNullOrWhiteSpace(s.Username) ? s.Email : s.Username)</dd>
                            <dt>Temporary password</dt><dd class="tps-mono tps-password">@s.TemporaryPassword</dd>
                            <dt>Expires</dt><dd>@QDateFormat.DT(s.ExpiresAt.ToLocalTime())</dd>
                        </dl>
                        <div class="tps-note">You will choose your own password when you first sign in. Do not share this slip.</div>
                    </div>
                }
            </div>
        </ChildContent>
    </QPrintSheet>
</div>

<style>
    .tps-overlay { position: fixed; inset: 0; z-index: 1200; overflow: auto; background: #f3f3f3; /* fixed paper backdrop: this overlay previews a print sheet */ }
    .tps-warning { display: inline-flex; align-items: center; gap: 6px; color: var(--qm-danger); font-size: var(--qm-text-base); font-weight: 600; }
    .tps-head { font-size: 10pt; margin-bottom: 10px; }
    .tps-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
    .tps-slip { border: 1px dashed #777; padding: 10px 12px; break-inside: avoid; page-break-inside: avoid; }
    .tps-name { font-weight: 700; font-size: 11pt; margin-bottom: 4px; }
    .tps-slip dl { display: grid; grid-template-columns: auto 1fr; gap: 1px 10px; margin: 0; font-size: 9.5pt; }
    .tps-slip dt { color: #555; }
    .tps-slip dd { margin: 0; overflow-wrap: anywhere; }
    .tps-mono { font-family: "Courier New", monospace; }
    .tps-password { font-size: 12pt; font-weight: 700; letter-spacing: 1px; }
    .tps-note { font-size: 8.5pt; color: #555; margin-top: 4px; }

    @@media screen and (max-width: 640px) {
        .tps-grid { grid-template-columns: 1fr; }
    }

    @@media print {
        body * { visibility: hidden !important; }
        .tps-overlay, .tps-overlay * { visibility: visible !important; }
        .tps-overlay { position: absolute; inset: 0; overflow: visible; background: #fff; }
        .tps-overlay .no-print { display: none !important; }
    }
</style>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<QMgr.Application.DTOs.TemporaryPasswordSlipDto> Slips { get; set; } = Array.Empty<QMgr.Application.DTOs.TemporaryPasswordSlipDto>();
    [Parameter] public string OrganizationName { get; set; } = string.Empty;
    [Parameter] public string SignInAddress { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
