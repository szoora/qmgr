        <span class="ss-preview-sub">@row.Email · @row.RoleCode@(row.DepartmentCodes.Count > 0 ? " · " + string.Join("/", row.DepartmentCodes) : "")</span>
    };

    /// <summary>Emails the organization already has, keyed lower-case, filled by the precheck.</summary>
    private Dictionary<string, string> existingEmails = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The slips are offered only once the job has landed — before that the usernames are not settled.</summary>
    private bool importFinished;

    private async Task<Guid> StartStaffImport(List<StaffImportRow> rows)
    {
        // Ask the server who already exists BEFORE sending, so the summary afterwards cannot be the
        // first time anybody learns that a third of the file was already on file. The answer is
        // advisory — the import re-checks under its own transaction — so a failure here never blocks.
        try
        {
            var precheck = await StaffApi.PrecheckStaffImportAsync(branchId,
                new StaffImportPrecheckRequest { Emails = rows.Select(r => r.Email).ToList() });
            existingEmails = precheck.Existing.ToDictionary(
                e => e.NormalizedEmail,
                e => string.IsNullOrWhiteSpace(e.FullName) ? "Somebody" : e.FullName,
                StringComparer.OrdinalIgnoreCase);
        }
        catch { existingEmails = new(StringComparer.OrdinalIgnoreCase); }

        var started = await StaffApi.StartStaffImportAsync(branchId, new StartStaffImportRequest
        {
            Rows = rows,
            DeliveryMode = deliveryMode,
            SendInvites = deliveryMode == StaffImportDeliveryMode.Invitation,
            BatchTemporaryPassword = useBatchPassword && !string.IsNullOrWhiteSpace(batchPassword) ? batchPassword : null
        });

        importFinished = false;
        jobEntries = new();
        pendingSlips = started.TemporaryPasswords ?? new();
        return started.Job.Id;
    }

    private async Task<RosterImportJobDto?> LoadStaffJob(Guid jobId)
    {
        try { return await StaffApi.GetStaffImportJobAsync(branchId, jobId); }
        catch { return null; }
    }

    private async Task<List<RosterImportJobEntryDto>> LoadStaffEntries(Guid jobId)
        => await StaffApi.GetStaffImportJobEntriesAsync(branchId, jobId, 500);

    /// <summary>The job landed: refresh the history and the staff list behind it.</summary>
    private async Task OnImportCompleted()
    {
        try
        {
            recentJobs = await StaffApi.GetStaffImportJobsAsync(branchId, 10);
            // The slips need the per-row outcomes: a slip is only printable for a row that actually
            // became an account, and the job may have settled on a different username than asked.
            if (recentJobs.Count > 0) jobEntries = await StaffApi.GetStaffImportJobEntriesAsync(branchId, recentJobs[0].Id, 500);
            importFinished = true;
            await LoadAllAsync();
        }
        catch { /* the panel already shows the outcome; this is only the surrounding page */ }
        StateHasChanged();
    }

    private async Task ShowJob(Guid jobId)
    {
        try
        {
            currentJob = await StaffApi.GetStaffImportJobAsync(branchId, jobId);
            jobEntries = await StaffApi.GetStaffImportJobEntriesAsync(branchId, jobId);
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not load the import", ex.Message);
        }
    }

    /// <summary>The slips for rows that actually became accounts, with the username the job settled on (it may have added a number).</summary>
    private List<TemporaryPasswordSlipDto> PrintableSlips => pendingSlips
        .Select(s => (Slip: s, Entry: jobEntries.FirstOrDefault(e => e.RowNumber == s.RowNumber && e.Outcome == RosterImportRowOutcome.Created)))
        .Where(x => x.Entry != null)
        .Select(x => x.Slip with { Username = UsernameFromMessage(x.Entry!.Message) ?? x.Slip.Username })
        .ToList();

    private static string? UsernameFromMessage(string? message)
    {
        var m = System.Text.RegularExpressions.Regex.Match(message ?? string.Empty, @"^Created as .+? \(([^)]+)\)\.");
        return m.Success ? m.Groups[1].Value : null;
    }

    private static StaffImportDeliveryMode? ParseDelivery(string? value) => (value ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "" => null,
        "slip" or "slips" or "temporary" or "password" => StaffImportDeliveryMode.Slips,
        "invitation" or "invite" or "email" => StaffImportDeliveryMode.Invitation,
        "sms" or "text" => StaffImportDeliveryMode.Sms,
        _ => null
    };

    private static string DeliveryLabel(StaffImportDeliveryMode mode) => mode switch
    {
        StaffImportDeliveryMode.Slips => "Slip",
        StaffImportDeliveryMode.Invitation => "Invitation",
        StaffImportDeliveryMode.Sms => "SMS",
        _ => mode.ToString()
    };

    private static string TeachingSummary(StaffImportRow row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(row.ClassTeacherOf)) parts.Add($"Class teacher: {row.ClassTeacherOf}");
        if (!string.IsNullOrWhiteSpace(row.Teaches)) parts.Add($"Teaches: {row.Teaches}");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

