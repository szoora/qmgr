    /// <summary>
    /// One row, validated hard enough that a person can fix the file rather than guess. A blocking
    /// ERROR keeps the row out of the import; a WARNING lets it through and says what will happen.
    /// The distinction matters: a mistyped employment type is not worth losing a person over, but a
    /// missing email is, because the email is the identity.
    /// </summary>
    private (StaffImportRow? Row, string? Error, List<string> Warnings) BuildStaffRow(
        IReadOnlyList<string> cells, Dictionary<string, int> map, int rowNumber)
    {
        var warnings = new List<string>();
        string C(string name) => ImportParsing.Cell(cells, map, name);

        var first = C("FirstName");
        var last = C("LastName");
        var email = C("Email");

        if (string.IsNullOrWhiteSpace(first) && string.IsNullOrWhiteSpace(last) && string.IsNullOrWhiteSpace(email))
            return (null, "The row is empty.", warnings);
        if (string.IsNullOrWhiteSpace(first)) return (null, "First name is missing.", warnings);
        if (string.IsNullOrWhiteSpace(last)) return (null, "Last name is missing.", warnings);
        if (string.IsNullOrWhiteSpace(email)) return (null, "Email is missing — it is how this person signs in.", warnings);
        if (!ImportParsing.LooksLikeEmail(email)) return (null, $"\"{email}\" is not an email address.", warnings);

        var row = new StaffImportRow
        {
            FirstName = first,
            LastName = last,
            Email = email.Trim(),
            Username = C("Username") is { Length: > 0 } u ? u : null,
            EmployeeNumber = C("EmployeeNumber") is { Length: > 0 } en ? en : null,
            JobTitle = C("JobTitle") is { Length: > 0 } jt ? jt : null,
            RoleCode = C("RoleCode") is { Length: > 0 } rc ? rc.Trim().ToLowerInvariant() : "teacher",
            LineManagerEmail = C("LineManagerEmail") is { Length: > 0 } lm ? lm : null,
            ClassTeacherOf = C("ClassTeacherOf") is { Length: > 0 } ct ? ct : null,
            Teaches = C("Teaches") is { Length: > 0 } t ? t : null,
            StartDate = C("StartDate") is { Length: > 0 } sd ? sd : null,
            EndDate = C("EndDate") is { Length: > 0 } ed ? ed : null,
            EmploymentType = C("EmploymentType") is { Length: > 0 } et ? et : null,
            Qualification = C("Qualification") is { Length: > 0 } q ? q : null,
            TeachingRegistrationNumber = C("TeachingRegistrationNumber") is { Length: > 0 } tr ? tr : null,
            DateOfBirth = C("DateOfBirth") is { Length: > 0 } dob ? dob : null,
            Sex = C("Sex") is { Length: > 0 } sx ? sx : null,
            NationalId = C("NationalId") is { Length: > 0 } nid ? nid : null,
            EmergencyContactName = C("EmergencyContactName") is { Length: > 0 } ecn ? ecn : null,
            EmergencyContactPhone = C("EmergencyContactPhone") is { Length: > 0 } ecp ? ecp : null
        };

        var departments = C("DepartmentCodes");
        if (!string.IsNullOrWhiteSpace(departments))
            row.DepartmentCodes = departments.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(d => d.Trim()).Where(d => d.Length > 0).ToList();

        // Phone: normalised rather than refused, because a school writes the same number six ways.
        var phone = C("Phone");
        if (!string.IsNullOrWhiteSpace(phone))
        {
            var normalized = ImportParsing.NormalizePhone(phone);
            if (normalized == null) warnings.Add($"\"{phone}\" is not a usable phone number — it will be left blank.");
            else row.Phone = normalized;
        }
        else if (deliveryMode == StaffImportDeliveryMode.Sms)
        {
            warnings.Add("No phone number, so this person gets a printed slip instead of an SMS.");
        }

        // The staff record: every one of these is a warning, never a refusal.
        if (StaffFieldParsing.Unreadable(row.StartDate)) warnings.Add($"Start date \"{row.StartDate}\" could not be read (day-first, e.g. 03/04/2026).");
        if (StaffFieldParsing.Unreadable(row.EndDate)) warnings.Add($"End date \"{row.EndDate}\" could not be read.");
        if (StaffFieldParsing.Unreadable(row.DateOfBirth)) warnings.Add($"Date of birth \"{row.DateOfBirth}\" could not be read.");

        var start = StaffFieldParsing.Date(row.StartDate);
        var end = StaffFieldParsing.Date(row.EndDate);
        if (StaffFieldParsing.DateRangeProblem(start, end) is { } rangeProblem) warnings.Add(rangeProblem);
        if (StaffFieldParsing.DateOfBirthProblem(StaffFieldParsing.Date(row.DateOfBirth)) is { } dobProblem) warnings.Add(dobProblem);

        if (end is { } e2 && e2 < DateOnly.FromDateTime(DateTime.UtcNow))
            warnings.Add("This person has already left — they will be imported, but kept out of registers and rotas.");

        if (!string.IsNullOrWhiteSpace(row.EmploymentType) && StaffFieldParsing.EmploymentType(row.EmploymentType) == null)
            warnings.Add($"\"{row.EmploymentType}\" is not an employment type — it will be left blank.");
        if (!string.IsNullOrWhiteSpace(row.Sex) && StaffFieldParsing.Sex(row.Sex) == null)
            warnings.Add($"\"{row.Sex}\" is not F, M or Other — it will be left blank.");

        // Already on file? The panel asks the server once per file and fills this in.
        if (existingEmails.TryGetValue(row.Email.Trim().ToLowerInvariant(), out var who))
            warnings.Add($"{who} already uses this email — this row will be skipped, not overwritten.");

        return (row, null, warnings);
    }

    /// <summary>What the preview shows for a row, rather than the first four raw cells.</summary>
    private RenderFragment<StaffImportRow> StaffRowSummary => row => __builder =>
