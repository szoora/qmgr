    /// <summary>
    /// One row, validated hard enough that a person can fix the file rather than guess. A blocking
    /// ERROR keeps the row out of the import; a WARNING lets it through and says what will happen.
    /// The distinction matters: a mistyped employment type is not worth losing a person over, but a
    /// missing email is, because the email is the identity.
    /// </summary>
    private (StaffImportRow? Row, string? Error, List<string> Warnings) BuildStaffRow(
        IReadOnlyList<string> cells, Dictionary<string, int> map, int rowNumber)
    {
        var warnings = new List<string>();
        string C(string name) => ImportParsing.Cell(cells, map, name);

        var first = C("FirstName");
        var last = C("LastName");
        var full = C("FullName");
        var email = C("Email");

        // ONE COLUMN OR TWO. A file carrying a single name column fills the pair here, by the shared
        // rule in PersonName, in the order the person chose above — the browser and the server split
        // identically because they call the same function, so the preview is the import.
        if (full.Length > 0 && (string.IsNullOrWhiteSpace(first) || string.IsNullOrWhiteSpace(last)))
        {
            firstFullName ??= full;
            var parts = PersonName.Split(full, nameOrder);
            if (string.IsNullOrWhiteSpace(first)) first = parts.GivenName;
            if (string.IsNullOrWhiteSpace(last)) last = parts.FamilyName;

            // A one-word name is a real name, not a broken row: W3C's guidance is not to require a
            // family name, and both name columns on the user are nullable. Say what was read and
            // import it.
            if (parts.SingleWord)
                warnings.Add($"\"{full}\" is one word, so it was read as a first name with no surname.");
        }

        if (string.IsNullOrWhiteSpace(first) && string.IsNullOrWhiteSpace(last) && string.IsNullOrWhiteSpace(email))
            return (null, "The row is empty.", warnings);
        if (string.IsNullOrWhiteSpace(first) && string.IsNullOrWhiteSpace(last))
            return (null, "The name is missing.", warnings);
        if (string.IsNullOrWhiteSpace(first)) return (null, "First name is missing.", warnings);
        if (string.IsNullOrWhiteSpace(last) && full.Length == 0) return (null, "Last name is missing.", warnings);

        // NO EMAIL ADDRESS IS NORMAL HERE, and the client refuses exactly what the server refuses:
        // an invitation has nowhere to go without one. On a slip or by SMS the row imports and the
        // warning says what will happen, naming the username they will actually type.
        if (string.IsNullOrWhiteSpace(email))
        {
            if (deliveryMode == StaffImportDeliveryMode.Invitation)
                return (null, "No email address, so an invitation cannot be sent. Choose password slips or SMS, or add an address.", warnings);

            var suggested = PersonName.SuggestUsername(first, last, null, C("EmployeeNumber"));
            warnings.Add($"No email address — they will sign in as \"{suggested}\" with a temporary password.");
        }
        else if (!ImportParsing.LooksLikeEmail(email))
        {
            return (null, $"\"{email}\" is not an email address. Leave the cell empty if they have none.", warnings);
        }

        var row = new StaffImportRow
        {
            FirstName = first,
            LastName = last,
            // What the sheet actually said, kept so the import log can show it and so a row posted
            // straight at the API without a split is still legal.
            FullName = full.Length > 0 ? full : null,
            Email = email.Trim(),
            Username = C("Username") is { Length: > 0 } u ? u : null,
            EmployeeNumber = C("EmployeeNumber") is { Length: > 0 } en ? en : null,
            JobTitle = C("JobTitle") is { Length: > 0 } jt ? jt : null,
            RoleCode = C("RoleCode") is { Length: > 0 } rc ? rc.Trim().ToLowerInvariant() : "teacher",
            LineManagerEmail = C("LineManagerEmail") is { Length: > 0 } lm ? lm : null,
            ClassTeacherOf = C("ClassTeacherOf") is { Length: > 0 } ct ? ct : null,
            Teaches = C("Teaches") is { Length: > 0 } t ? t : null,
            StartDate = C("StartDate") is { Length: > 0 } sd ? sd : null,
            EndDate = C("EndDate") is { Length: > 0 } ed ? ed : null,
            EmploymentType = C("EmploymentType") is { Length: > 0 } et ? et : null,
            Qualification = C("Qualification") is { Length: > 0 } q ? q : null,
            TeachingRegistrationNumber = C("TeachingRegistrationNumber") is { Length: > 0 } tr ? tr : null,
            DateOfBirth = C("DateOfBirth") is { Length: > 0 } dob ? dob : null,
            Sex = C("Sex") is { Length: > 0 } sx ? sx : null,
            NationalId = C("NationalId") is { Length: > 0 } nid ? nid : null,
            EmergencyContactName = C("EmergencyContactName") is { Length: > 0 } ecn ? ecn : null,
            EmergencyContactPhone = C("EmergencyContactPhone") is { Length: > 0 } ecp ? ecp : null
        };

        var departments = C("DepartmentCodes");
        if (!string.IsNullOrWhiteSpace(departments))
            row.DepartmentCodes = departments.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(d => d.Trim()).Where(d => d.Length > 0).ToList();

        // Phone: normalised rather than refused, because a school writes the same number six ways.
        var phone = C("Phone");
        if (!string.IsNullOrWhiteSpace(phone))
        {
            var normalized = ImportParsing.NormalizePhone(phone);
            if (normalized == null) warnings.Add($"\"{phone}\" is not a usable phone number — it will be left blank.");
            else row.Phone = normalized;
        }
        else if (deliveryMode == StaffImportDeliveryMode.Sms)
        {
            warnings.Add("No phone number, so this person gets a printed slip instead of an SMS.");
        }

        // The staff record: every one of these is a warning, never a refusal.
        if (StaffFieldParsing.Unreadable(row.StartDate)) warnings.Add($"Start date \"{row.StartDate}\" could not be read (day-first, e.g. 03/04/2026).");
        if (StaffFieldParsing.Unreadable(row.EndDate)) warnings.Add($"End date \"{row.EndDate}\" could not be read.");
        if (StaffFieldParsing.Unreadable(row.DateOfBirth)) warnings.Add($"Date of birth \"{row.DateOfBirth}\" could not be read.");

        var start = StaffFieldParsing.Date(row.StartDate);
        var end = StaffFieldParsing.Date(row.EndDate);
        if (StaffFieldParsing.DateRangeProblem(start, end) is { } rangeProblem) warnings.Add(rangeProblem);
        if (StaffFieldParsing.DateOfBirthProblem(StaffFieldParsing.Date(row.DateOfBirth)) is { } dobProblem) warnings.Add(dobProblem);

        if (end is { } e2 && e2 < DateOnly.FromDateTime(DateTime.UtcNow))
            warnings.Add("This person has already left — they will be imported, but kept out of registers and rotas.");

        if (!string.IsNullOrWhiteSpace(row.EmploymentType) && StaffFieldParsing.EmploymentTypeName(row.EmploymentType, employmentTypes) == null)
            warnings.Add($"\"{row.EmploymentType}\" is not one of this school's employment types — it will be left blank.");
        if (!string.IsNullOrWhiteSpace(row.Sex) && StaffFieldParsing.Sex(row.Sex) == null)
            warnings.Add($"\"{row.Sex}\" is not F, M or Other — it will be left blank.");

        // Already on file? The panel asks the server once per file and fills this in.
        if (existingEmails.TryGetValue(row.Email.Trim().ToLowerInvariant(), out var who))
            warnings.Add($"{who} already uses this email — this row will be skipped, not overwritten.");

        return (row, null, warnings);
    }

    /// <summary>What the preview shows for a row, rather than the first four raw cells.</summary>
    private RenderFragment<StaffImportRow> StaffRowSummary => row => __builder =>
    {
        <span class="ss-preview-name">@PersonName.Join(row.FirstName, row.LastName, displayOrder)</span>
        <span class="ss-preview-sub">@(string.IsNullOrWhiteSpace(row.Email) ? "no email" : row.Email) · @row.RoleCode@(row.DepartmentCodes.Count > 0 ? " · " + string.Join("/", row.DepartmentCodes) : "")</span>
    };

    /// <summary>Emails the organization already has, keyed lower-case, filled by the precheck.</summary>
    private Dictionary<string, string> existingEmails = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The slips are offered only once the job has landed — before that the usernames are not settled.</summary>
    private bool importFinished;

    /// <summary>
    /// What must not repeat within one file. The address where there is one — but most staff have
    /// none, so it falls through to the school's own staff number and then to the name. Returning
    /// null for a row with nothing to key on is deliberate: an unidentifiable row is never reported
    /// as a duplicate of another unidentifiable row.
    /// </summary>
    private static string? StaffDuplicateKey(StaffImportRow r)
    {
        if (!string.IsNullOrWhiteSpace(r.Email)) return "e:" + r.Email.Trim().ToLowerInvariant();
        if (!string.IsNullOrWhiteSpace(r.EmployeeNumber)) return "n:" + r.EmployeeNumber.Trim().ToLowerInvariant();
        var name = PersonName.Join(r.FirstName, r.LastName).Trim().ToLowerInvariant();
        return name.Length == 0 ? null : "p:" + name;
    }

    // ---- one name column or two ---------------------------------------------------------------
    private QImportPanel<StaffImportRow>? importPanel;

    /// <summary>
    /// Which way round a combined name column is written. Surname first is the default because that
    /// is how a Ugandan school roll is written and how both files this was built against are written
    /// — but it is shown on screen with the file's own first name in it, so a school whose export
    /// disagrees can see that at a glance rather than discovering it afterwards.
    /// </summary>
    private NameOrder nameOrder = NameOrder.FamilyFirst;

    /// <summary>
    /// Only worth asking when the file actually carried one combined name column — and asked at the
    /// MAPPING step, before any row is built, which is why the value comes from the panel's view of
    /// the file rather than from a row this page has already made.
    /// </summary>
    private bool NameOrderMatters => FirstFullName is { Length: > 0 };

    private string? FirstFullName => importPanel?.FirstValueOf("FullName") ?? firstFullName;

    private string? firstFullName;

    private IReadOnlyList<QRadioOption<NameOrder>> NameOrderOptions => new[]
    {
        new QRadioOption<NameOrder>(NameOrder.FamilyFirst, "Surname first", NameExample(NameOrder.FamilyFirst)),
        new QRadioOption<NameOrder>(NameOrder.GivenFirst, "First name first", NameExample(NameOrder.GivenFirst)),
    };

    private static readonly IReadOnlyList<QRadioOption<StaffImportDeliveryMode>> DeliveryOptions = new[]
    {
        new QRadioOption<StaffImportDeliveryMode>(StaffImportDeliveryMode.Slips, "Temporary password slips (recommended for schools)",
            "each person gets their own temporary password, printed once on a slip you hand out. It expires in 72 hours and they choose their own at first sign-in."),
        new QRadioOption<StaffImportDeliveryMode>(StaffImportDeliveryMode.Invitation, "Invitation email",
            "a link valid for 7 days to set their own password. For staff with working email."),
        new QRadioOption<StaffImportDeliveryMode>(StaffImportDeliveryMode.Sms, "Temporary password by SMS",
            "the same temporary password, sent to each person's own phone. Needs SMS switched on for your organization; anyone without a phone number gets a slip."),
    };

    private void SetNameOrder(NameOrder order)
    {
        nameOrder = order;
        importPanel?.RebuildPreview();
    }

    /// <summary>The first row of THEIR file, split both ways, so the choice is concrete.</summary>
    private string NameExample(NameOrder order)
    {
        var sample = FirstFullName;
        if (string.IsNullOrWhiteSpace(sample)) return order == NameOrder.FamilyFirst ? "Nakato Grace" : "Grace Nakato";
        var parts = PersonName.Split(sample, order);
        return string.IsNullOrWhiteSpace(parts.FamilyName)
            ? $"\"{sample}\" → {parts.GivenName}"
            : $"\"{sample}\" → first name {parts.GivenName}, surname {parts.FamilyName}";
    }

    /// <summary>
    /// Who in this file is already on the staff list. Asked BEFORE anything is sent — the panel turns
    /// it into the question "update them, or add only the missing ones?", which is a decision rather
    /// than a result to be reported afterwards. The answer is advisory: the import re-checks under its
    /// own transaction, so a failure here never blocks the import.
    /// </summary>
    private async Task<ImportExisting> CheckStaffExisting(List<StaffImportRow> rows)
    {
        StaffImportPrecheckDto precheck;
        try
        {
            // The ROWS, not just the keys: with them the answer can say what this file would change
            // about each person and which names look like one person entered twice. The name order is
            // sent too, because a combined name read the wrong way round lands a row on the wrong person.
            precheck = await StaffApi.PrecheckStaffImportAsync(branchId, new StaffImportPrecheckRequest
            {
                Rows = rows,
                NameOrder = nameOrder,
                Emails = rows.Select(r => r.Email).Where(e => !string.IsNullOrWhiteSpace(e)).ToList(),
                // The other half of the question, for everybody in the file with no address.
                EmployeeNumbers = rows.Select(r => r.EmployeeNumber ?? string.Empty)
                    .Where(n => !string.IsNullOrWhiteSpace(n)).ToList(),
            });
            existingEmails = precheck.Existing
                .GroupBy(e => string.IsNullOrWhiteSpace(e.NormalizedEmail) ? (e.EmployeeNumber ?? string.Empty) : e.NormalizedEmail,
                         StringComparer.OrdinalIgnoreCase)
                .Where(g => !string.IsNullOrWhiteSpace(g.Key))
                .ToDictionary(
                    g => g.Key,
                    g => string.IsNullOrWhiteSpace(g.First().FullName) ? "Somebody" : g.First().FullName,
                    StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            existingEmails = new(StringComparer.OrdinalIgnoreCase);
            return ImportExisting.None;
        }

        var changed = precheck.Existing.Where(e => e.Changes.Count > 0).ToList();
        return new ImportExisting(
            existingEmails.Count,
            existingEmails.Values.Take(3).ToList(),
            changed.Count,
            changed.Take(5).Select(e => new ImportChange(
                string.IsNullOrWhiteSpace(e.FullName) ? "Somebody" : e.FullName, e.Changes)).ToList(),
            precheck.PossibleDuplicates);
    }

    private async Task<Guid> StartStaffImport(List<StaffImportRow> rows, ImportOptions options)
    {
        var started = await StaffApi.StartStaffImportAsync(branchId, new StartStaffImportRequest
        {
            UpdateExisting = options.UpdateExisting,
            Rows = rows,
            NameOrder = nameOrder,
            DeliveryMode = deliveryMode,
            SendInvites = deliveryMode == StaffImportDeliveryMode.Invitation,
            BatchTemporaryPassword = useBatchPassword && !string.IsNullOrWhiteSpace(batchPassword) ? batchPassword : null
        });

        importFinished = false;
        jobEntries = new();
        pendingSlips = started.TemporaryPasswords ?? new();
        return started.Job.Id;
    }

    private async Task<RosterImportJobDto?> LoadStaffJob(Guid jobId)
    {
        try { return await StaffApi.GetStaffImportJobAsync(branchId, jobId); }
        catch { return null; }
    }

    private async Task<List<RosterImportJobEntryDto>> LoadStaffEntries(Guid jobId)
        => await StaffApi.GetStaffImportJobEntriesAsync(branchId, jobId, 500);

    /// <summary>The job landed: refresh the history and the staff list behind it.</summary>
    private async Task OnImportCompleted()
    {
        try
        {
            recentJobs = await StaffApi.GetStaffImportJobsAsync(branchId, 10);
            // The slips need the per-row outcomes: a slip is only printable for a row that actually
            // became an account, and the job may have settled on a different username than asked.
            if (recentJobs.Count > 0) jobEntries = await StaffApi.GetStaffImportJobEntriesAsync(branchId, recentJobs[0].Id, 500);
            importFinished = true;
            await LoadAllAsync();
        }
        catch { /* the panel already shows the outcome; this is only the surrounding page */ }
        StateHasChanged();
    }

    private async Task ShowJob(Guid jobId)
    {
        try
        {
            currentJob = await StaffApi.GetStaffImportJobAsync(branchId, jobId);
            jobEntries = await StaffApi.GetStaffImportJobEntriesAsync(branchId, jobId);
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not load the import", ex.Message);
        }
    }

    /// <summary>The slips for rows that actually became accounts, with the username the job settled on (it may have added a number).</summary>
    private List<TemporaryPasswordSlipDto> PrintableSlips => pendingSlips
        .Select(s => (Slip: s, Entry: jobEntries.FirstOrDefault(e => e.RowNumber == s.RowNumber && e.Outcome == RosterImportRowOutcome.Created)))
        .Where(x => x.Entry != null)
        .Select(x => x.Slip with { Username = UsernameFromMessage(x.Entry!.Message) ?? x.Slip.Username })
        .ToList();

    private static string? UsernameFromMessage(string? message)
    {
        var m = System.Text.RegularExpressions.Regex.Match(message ?? string.Empty, @"^Created as .+? \(([^)]+)\)\.");
        return m.Success ? m.Groups[1].Value : null;
    }

    private static StaffImportDeliveryMode? ParseDelivery(string? value) => (value ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "" => null,
        "slip" or "slips" or "temporary" or "password" => StaffImportDeliveryMode.Slips,
        "invitation" or "invite" or "email" => StaffImportDeliveryMode.Invitation,
        "sms" or "text" => StaffImportDeliveryMode.Sms,
        _ => null
    };

    private static string DeliveryLabel(StaffImportDeliveryMode mode) => mode switch
    {
        StaffImportDeliveryMode.Slips => "Slip",
        StaffImportDeliveryMode.Invitation => "Invitation",
        StaffImportDeliveryMode.Sms => "SMS",
        _ => mode.ToString()
    };

    private static string TeachingSummary(StaffImportRow row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(row.ClassTeacherOf)) parts.Add($"Class teacher: {row.ClassTeacherOf}");
        if (!string.IsNullOrWhiteSpace(row.Teaches)) parts.Add($"Teaches: {row.Teaches}");
        return parts.Count == 0 ? "—" : string.Join(" · ", parts);
    }

    private static readonly IReadOnlyList<ExportColumn<StaffImportRow>> TemplateColumns = new List<ExportColumn<StaffImportRow>>
    {
        new("FirstName", r => r.FirstName), new("LastName", r => r.LastName),
        new("FullName", r => r.FullName ?? string.Empty), new("Email", r => r.Email),
        new("Username", r => r.Username), new("Phone", r => r.Phone), new("EmployeeNumber", r => r.EmployeeNumber),
        new("JobTitle", r => r.JobTitle), new("RoleCode", r => r.RoleCode), new("DepartmentCodes", r => string.Join(";", r.DepartmentCodes)),
        new("LineManagerEmail", r => r.LineManagerEmail), new("DeliveryMode", r => r.DeliveryMode?.ToString().ToLowerInvariant()),
        new("ClassTeacherOf", r => r.ClassTeacherOf), new("Teaches", r => r.Teaches)
    };

    /// <summary>The template: the headers, with one example row a school overwrites.</summary>
    private Task<ExportRows<StaffImportRow>> ProvideTemplateRowsAsync() => Task.FromResult(new ExportRows<StaffImportRow>(new List<StaffImportRow>
    {
        new() { FirstName = "Sarah", LastName = "Auma", Email = "sarah.auma@example.ac.ug", Phone = "0701234567", EmployeeNumber = "T-014", JobTitle = "Teacher",
                RoleCode = "teacher", DepartmentCodes = new() { "MATH" }, ClassTeacherOf = "S2A", Teaches = "MATH:S2A,S2B" }
    }, false));

    private static bool IsFinished(RosterImportStatus s) =>
        s is RosterImportStatus.Completed or RosterImportStatus.CompletedWithErrors or RosterImportStatus.Failed;

    private static string ImportStatusText(RosterImportJobDto j) => j.Status switch
    {
        RosterImportStatus.Pending => "Queued — waiting for the background worker.",
        RosterImportStatus.Processing => "Creating accounts…",
        RosterImportStatus.Completed => $"Finished {(j.CompletedAt.HasValue ? QDateFormat.DT(j.CompletedAt.Value.ToLocalTime()) : "")}.",
        RosterImportStatus.CompletedWithErrors => "Finished, with some rows that could not be imported. The reasons are listed below.",
        RosterImportStatus.Failed => $"The import failed: {j.FailureReason}",
        _ => j.Status.ToString()
    };

    private static string OutcomeVariant(RosterImportRowOutcome o) => o switch
    {
        RosterImportRowOutcome.Created => "success",
        RosterImportRowOutcome.AlreadyExists or RosterImportRowOutcome.DuplicateInFile or RosterImportRowOutcome.Skipped => "muted",
        RosterImportRowOutcome.Failed => "danger",
        _ => "info"
    };

    /// <summary>The branch changed under the page: reload against the new one.</summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        await LoadAllAsync();
    }
}
