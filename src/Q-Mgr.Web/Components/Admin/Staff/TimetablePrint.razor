@page "/admin/timetable/{Id:guid}/print"
@layout QMgr.Web.Components.Layout.MinimalLayout
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared.UI
@inject IStaffPerformanceApiService StaffApi
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject IOrganizationApiService OrganizationApi
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDocumentShareApiService DocShareApi
@inject IToastService Toast
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState

@*
    A timetable on A4 landscape (plan §6.2 "class / teacher / room / master views and prints"): one page per class,
    teacher or room, periods down, cycle days across, breaks as bands. Only a version the caller may read is printed —
    a draft only for a timetable master, as the API decides. The print is logged like every other export (§13.13).

    ?by= picks the axis and ?key= narrows it to one sheet or a chosen few (comma-separated), so an individual
    extract — one teacher's week — is a deep link rather than 40 pages the reader has to sift. The keys are the
    SAME ones the editor's views use (teacher = user id, class and room = TimetableCycle.Normalize of the name),
    so the editor's Print button and the portal's "Print my timetable" can both hand a key straight over. The
    picker writes the key back into the URL, which is what makes a narrowed sheet shareable and publishable.
*@

<QPageTitle Text="Timetable Print" />

<QPrintSheet SheetId="ttp-sheet" Title="@DocTitle" Class="ttp-sheet" Landscape="true"
             Ready="@(!isLoading && loadError == null)" BackText="Back to the timetable" OnBack="@(() => Navigation.NavigateTo($"/admin/timetable?t={Id}"))"
             CanPublish="@canPublish" Publishing="@isPublishing" OnPublish="@PublishToLibrary" OnPrint="@Print" Disabled="@(isLoading || loadError != null)">
    <ToolbarStart>
        <QTabs Tabs="@ByTabs" ActiveKey="@by" ActiveKeyChanged="@ByChanged" AriaLabel="Print one page per" />
        @if (detail != null && by == "teacher")
        {
            @* A sheet that shows lessons and hides the Friday duty is one somebody will still
               double-book themselves against. Off is a real choice — a timetable master printing
               forty sheets for a noticeboard wants the grid alone — so it is a toggle, not a rule.
               Deliberately NOT in the URL: ?key= is the SELECTION, which has to be linkable; this
               is a preference about the same selection. *@
            <QCheckbox Value="@includeDuties" ValueChanged="@(v => includeDuties = v)" Label="Duties" Class="ttp-duties-toggle" />
        }
        @if (detail != null)
        {
            <QMultiSelect TValue="string" TItem="SheetOption" Class="ttp-pick"
                          SelectedValues="@chosen.ToList()" SelectedValuesChanged="@ChosenChanged"
                          Items="@SheetOptions()" ValueSelector="@(o => o.Key)" TextSelector="@(o => o.Label)"
                          Placeholder="@($"Every {ByLabel.ToLowerInvariant()}")" MaxChipsVisible="2" />
        }
    </ToolbarStart>
    <ChildContent>
        @if (detail != null)
        {
            var pages = Pages().ToList();
            @if (!pages.Any())
            {
                <p class="ttp-muted">@(chosen.Count > 0 ? $"Nothing to print for the chosen {ByLabel.ToLowerInvariant()}." : "Nothing to print for this view.")</p>
            }
            @foreach (var sheet in pages)
            {
                <section class="ttp-page">
                    <header class="ttp-head">
                        <div class="ttp-head__brand">
                            @if (!string.IsNullOrWhiteSpace(branding?.LogoUrl)) { <img class="ttp-logo" src="@branding!.LogoUrl" alt="" /> }
                            <div>
                                <div class="ttp-org">@OrganizationName</div>
                                <div class="ttp-doc">@detail.Timetable.Name@(detail.Timetable.Status == TimetableStatus.Draft ? " — DRAFT" : "")</div>
                            </div>
                        </div>
                        <div class="ttp-head__who">
                            <span>@ByLabel</span>
                            <strong>@sheet.Label</strong>
                            <span>@QDateFormat.Range(detail.Timetable.EffectiveFrom, detail.Timetable.EffectiveTo)</span>
                        </div>
                    </header>
                    <table class="ttp-grid">
                        <thead>
                            <tr>
                                <th class="ttp-corner">Period</th>
                                @foreach (var d in Days) { <th>@TimetableCycle.CycleDayLabel(detail.Settings, detail.Timetable.CycleDays, d)</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in TimetableCycle.Rows(detail.Settings))
                            {
                                @if (row.Kind != BellPeriodKind.Lesson)
                                {
                                    <tr class="ttp-break"><th>@row.Label<small>@row.Start–@row.End</small></th><td colspan="@Days.Count">@row.Label</td></tr>
                                    continue;
                                }
                                <tr>
                                    <th>@row.Label<small>@row.Start–@row.End</small></th>
                                    @foreach (var d in Days)
                                    {
                                        var inCell = sheet.Lessons.Where(l => l.CycleDay == d && string.Equals(l.PeriodKey, row.Key, StringComparison.OrdinalIgnoreCase)).GroupBy(l => l.GroupId ?? l.Id).ToList();
                                        var teaching = TimetableCycle.LessonPeriodOn(detail.Settings, detail.Timetable.CycleDays, d, row.Key) != null;
                                        <td class="@(teaching ? "" : "ttp-none")">
                                            @foreach (var g in inCell)
                                            {
                                                var rows = g.ToList();
                                                <div class="ttp-lesson">
                                                    <strong>@rows[0].SubjectCode</strong>
                                                    <span>@CellLine(rows)</span>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (by == "teacher" && includeDuties)
                    {
                        var mine = DutiesFor(sheet.Key).ToList();
                        <section class="ttp-duties">
                            <h2>Duties @QDateFormat.Range(detail.Timetable.EffectiveFrom, detail.Timetable.EffectiveTo)</h2>
                            @if (dutiesError != null)
                            {
                                <p class="ttp-duties__none">Duties could not be read (@dutiesError). The lessons above are unaffected.</p>
                            }
                            else if (!mine.Any())
                            {
                                <p class="ttp-duties__none">No duties in this period.</p>
                            }
                            else
                            {
                                <table class="ttp-duties__table">
                                    <thead>
                                        <tr><th>Date</th><th>Time</th><th>Duty</th><th>Where</th><th>Role</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in mine.Take(DutyRowCap))
                                        {
                                            <tr>
                                                <td>@QDateFormat.DD(LocalTime(d.StartsAt))</td>
                                                <td>@QDateFormat.T(LocalTime(d.StartsAt))–@QDateFormat.T(LocalTime(d.EndsAt))</td>
                                                <td>@d.Title<small>@d.ParameterName</small></td>
                                                <td>@(string.IsNullOrWhiteSpace(d.Location) ? "—" : d.Location)</td>
                                                <td>@RoleOn(d, sheet.Key)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (mine.Count > DutyRowCap)
                                {
                                    <p class="ttp-duties__none">and @(mine.Count - DutyRowCap) more — see Duties &amp; Registers in @(branding?.ProductName ?? ProductBrand.Name).</p>
                                }
                            }
                        </section>
                    }
                    <footer class="ttp-foot">Printed @QDateFormat.DT(DateTime.Now)@(string.IsNullOrWhiteSpace(generatedBy) ? "" : $" by {generatedBy}"). Timetables change: the one in @(branding?.ProductName ?? ProductBrand.Name) is the current version.</footer>
                </section>
            }
        }
    </ChildContent>
</QPrintSheet>

@if (isLoading)
{
    <div class="ttp-state no-print"><QSpinner Size="lg" /><span>Building the timetable...</span></div>
}
else if (loadError != null)
{
    <div class="ttp-state no-print"><QIcon Name="exclamation-triangle" /><span>@loadError</span></div>
}

<style>
    .ttp-pick { min-width: 220px; max-width: 340px; }
    .ttp-duties-toggle { margin-bottom: 0; }
    .ttp-duties { margin-top: 7mm; break-inside: avoid; }
    .ttp-duties h2 { font-family: var(--qm-font-display, inherit); font-size: 10pt; font-weight: 700; margin: 0 0 3px; padding-bottom: 2px; border-bottom: 1px solid #14110f; }
    .ttp-duties__none { font-size: 8pt; color: #5b524d; margin: 0; }
    .ttp-duties__table { width: 100%; border-collapse: collapse; font-size: 8pt; }
    .ttp-duties__table th, .ttp-duties__table td { border: 1px solid #8a817c; padding: 2px 4px; text-align: left; vertical-align: top; }
    .ttp-duties__table thead th { font-weight: 700; border-bottom: 2px solid #14110f; }
    .ttp-duties__table td small { display: block; color: #5b524d; font-size: 7pt; }
    .ttp-duties__table tr { break-inside: avoid; }
    .ttp-state { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 80px 20px; color: var(--qm-text-muted); }
    .ttp-muted { color: #5b524d; }
    .ttp-page { break-after: page; margin-bottom: 18mm; }
    .ttp-page:last-child { break-after: auto; margin-bottom: 0; }
    .ttp-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px; border-bottom: 2px solid #14110f; padding-bottom: 6px; margin-bottom: 8px; }
    .ttp-head__brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .ttp-logo { height: 34px; width: auto; max-width: 120px; object-fit: contain; }
    .ttp-org { font-family: var(--qm-font-display, inherit); font-size: 13pt; font-weight: 700; line-height: 1.15; }
    .ttp-doc { font-size: 9pt; letter-spacing: .06em; text-transform: uppercase; color: #5b524d; }
    .ttp-head__who { display: flex; flex-direction: column; align-items: flex-end; font-size: 9pt; }
    .ttp-head__who strong { font-size: 14pt; font-family: var(--qm-font-display, inherit); }
    .ttp-grid { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 8.5pt; }
    .ttp-grid th, .ttp-grid td { border: 1px solid #8a817c; padding: 3px 4px; vertical-align: top; }
    .ttp-grid thead th { background: none; font-weight: 700; text-align: left; border-bottom: 2px solid #14110f; }
    .ttp-grid tbody th { width: 64px; text-align: left; font-weight: 700; }
    .ttp-corner { width: 64px; }
    .ttp-grid th small { display: block; font-weight: 400; color: #5b524d; font-size: 7.5pt; }
    .ttp-break th, .ttp-break td { font-style: italic; color: #5b524d; padding: 1px 4px; }
    .ttp-break td { text-align: center; letter-spacing: .08em; text-transform: uppercase; font-size: 7.5pt; }
    .ttp-none { background: repeating-linear-gradient(135deg, transparent 0 5px, #d8d2ce 5px 6px); }
    .ttp-lesson { display: flex; flex-direction: column; line-height: 1.2; }
    .ttp-lesson + .ttp-lesson { border-top: 1px dashed #8a817c; margin-top: 2px; padding-top: 2px; }
    .ttp-lesson span { color: #3a3431; overflow-wrap: anywhere; }
    .ttp-foot { margin-top: 6px; font-size: 7.5pt; color: #5b524d; }
    @@media screen and (max-width: 640px) {
        .ttp-sheet .ttp-grid { display: table; min-width: 640px; }
        .ttp-sheet .ttp-page { overflow-x: auto; }
    }
    @@media print { .ttp-grid tr { break-inside: avoid; } }
</style>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "by")] public string? ByQuery { get; set; }

    /// <summary>The sheets to print, comma-separated. Empty means every sheet on this axis — the old behaviour.</summary>
    [SupplyParameterFromQuery(Name = "key")] public string? KeyQuery { get; set; }

    private Guid branchId, organizationId;
    private bool isLoading = true, isPublishing, canPublish;

    /// <summary>The teacher sheet's duties, and the toggle that puts them on it. Loaded once with the timetable.</summary>
    private List<StaffDutyDto> duties = new();
    private bool includeDuties = true;
    private string? dutiesError;

    /// <summary>A term of a daily rota plus meetings runs long; past this the sheet stops being a sheet.</summary>
    private const int DutyRowCap = 40;
    private string? loadError, generatedBy;
    private TimetableDetailDto? detail;
    private OrganizationBrandingDto? branding;
    private string by = "class";

    /// <summary>The chosen sheet keys. EMPTY MEANS ALL, never none — a print route that defaults to nothing prints nothing.</summary>
    private readonly HashSet<string> chosen = new(StringComparer.OrdinalIgnoreCase);

    // The last query values ACTED ON, so writing the picker's choice back into the URL does not read
    // itself back in and fight the picker. Same rule as HubTabs.FollowQuery.
    private string? lastByActed, lastKeyActed;

    private sealed record PrintPage(string Key, string Label, List<TimetableLessonDto> Lessons);
    private sealed record SheetOption(string Key, string Label);

    private static readonly IReadOnlyList<QTab> ByTabs = new List<QTab> { new("class", "Classes"), new("teacher", "Teachers"), new("room", "Rooms") };

    private List<int> Days => detail == null ? new() : Enumerable.Range(1, detail.Timetable.CycleDays).ToList();
    private string ByLabel => by switch { "teacher" => "Teacher", "room" => "Room", _ => "Class" };
    private string ByPlural => by switch { "teacher" => "teachers", "room" => "rooms", _ => "classes" };

    /// <summary>Names what is actually on the paper, so a one-teacher extract is not filed as "by teacher".</summary>
    private string DocTitle
    {
        get
        {
            if (detail == null) return "Timetable";
            if (chosen.Count == 0) return $"{detail.Timetable.Name} — by {ByLabel.ToLowerInvariant()}";
            var pages = Pages().ToList();
            return pages.Count == 1
                ? $"{detail.Timetable.Name} — {pages[0].Label}"
                : $"{detail.Timetable.Name} — {pages.Count} {ByPlural}";
        }
    }

    private string SelectionSummary
    {
        get
        {
            if (chosen.Count == 0) return $"one page per {ByLabel.ToLowerInvariant()}";
            var pages = Pages().ToList();
            return pages.Count == 1 ? $"{ByLabel.ToLowerInvariant()} {pages[0].Label}" : $"{pages.Count} {ByPlural}";
        }
    }

    /// <summary>timetable-teacher-savior-muzoora-2026-09-01.pdf rather than forty of timetable-teacher-… .</summary>
    private string FileSlug
    {
        get
        {
            var pages = Pages().ToList();
            if (chosen.Count == 0 || pages.Count != 1) return by;
            var slug = new string(pages[0].Label.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
            while (slug.Contains("--")) slug = slug.Replace("--", "-");
            slug = slug.Trim('-');
            return slug.Length == 0 ? by : $"{by}-{slug}";
        }
    }
    private string OrganizationName => !string.IsNullOrWhiteSpace(branding?.OrganizationName) ? branding!.OrganizationName! : BranchState.CurrentBranchName ?? "Timetable";

    protected override async Task OnInitializedAsync()
    {
        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            generatedBy = user?.FullName;
            organizationId = user?.OrganizationId ?? Guid.Empty;
            canPublish = await ReportPublishing.CanPublishAsync(PermissionService, ModuleState, ModuleApi);
            if (organizationId != Guid.Empty)
            {
                try { branding = await OrganizationApi.GetOrganizationBrandingAsync(organizationId); } catch { branding = null; }
            }
            detail = await StaffApi.GetTimetableAsync(branchId, Id);
            await LoadDutiesAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Couldn't build the timetable: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        var wantedBy = ByQuery is "class" or "teacher" or "room" ? ByQuery : "class";
        if (!string.Equals(wantedBy, lastByActed, StringComparison.Ordinal))
        {
            lastByActed = wantedBy;
            if (!string.Equals(by, wantedBy, StringComparison.Ordinal))
            {
                // The keys belong to the axis, so a class key means nothing once the axis is teachers.
                by = wantedBy;
                chosen.Clear();
            }
        }

        var wantedKey = string.IsNullOrWhiteSpace(KeyQuery) ? null : KeyQuery;
        if (!string.Equals(wantedKey, lastKeyActed, StringComparison.Ordinal))
        {
            lastKeyActed = wantedKey;
            chosen.Clear();
            foreach (var k in (wantedKey ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                chosen.Add(k);
        }
    }

    private void ByChanged(string k)
    {
        if (string.Equals(k, by, StringComparison.Ordinal)) return;
        by = k;
        chosen.Clear();
        SyncUrl();
    }

    private void ChosenChanged(IEnumerable<string> values)
    {
        chosen.Clear();
        foreach (var v in values ?? Enumerable.Empty<string>())
            if (!string.IsNullOrWhiteSpace(v)) chosen.Add(v);
        SyncUrl();
    }

    /// <summary>The URL IS the state: a narrowed sheet has to be linkable, or it cannot be sent to the person it is about.</summary>
    private void SyncUrl()
    {
        var keyPart = chosen.Count == 0 ? null : string.Join(",", chosen);
        lastByActed = by;
        lastKeyActed = keyPart;
        Navigation.NavigateTo(
            $"/admin/timetable/{Id}/print?by={by}" + (keyPart == null ? string.Empty : $"&key={Uri.EscapeDataString(keyPart)}"),
            replace: true);
    }

    private List<SheetOption> SheetOptions() => AllPages().Select(p => new SheetOption(p.Key, p.Label)).ToList();

    private static DateTime LocalTime(DateTime value) => value.Kind == DateTimeKind.Utc ? value.ToLocalTime() : value;

    /// <summary>
    /// The duties covering the timetable's own period. A failure here NEVER fails the print: the
    /// timetable is the document and a missing duty list is a degraded sheet, not a broken one —
    /// the same call as VisitorsController.TryIssueVisitToken.
    /// </summary>
    private async Task LoadDutiesAsync()
    {
        duties = new();
        dutiesError = null;
        if (detail == null) return;
        try
        {
            var from = detail.Timetable.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
            var to = detail.Timetable.EffectiveTo.ToDateTime(TimeOnly.MaxValue);
            duties = await StaffApi.GetDutiesAsync(branchId, from, to);
        }
        catch (Exception ex)
        {
            dutiesError = ex.Message;
        }
    }

    /// <summary>
    /// Whose sheet a duty belongs on. Lessons are excluded — they ARE the grid above, and listing
    /// them again doubles the page. A null ExpectedUserIds means every member of the branch, which
    /// is how "all-staff briefing" is stored; a recorder or a supervisor has to be there too, so
    /// they count even when they are not on the expected list.
    /// </summary>
    private IEnumerable<StaffDutyDto> DutiesFor(string key)
    {
        if (!Guid.TryParse(key, out var userId)) return Enumerable.Empty<StaffDutyDto>();
        return duties
            .Where(d => d.IsActive && d.Kind != DutyKind.Lesson
                        && (d.ExpectedUserIds == null
                            || d.ExpectedUserIds.Contains(userId)
                            || d.RecorderUserIds.Contains(userId)
                            || d.SupervisorUserIds.Contains(userId)))
            .OrderBy(d => d.StartsAt);
    }

    /// <summary>What the person is there to do — the difference between turning up and taking the register.</summary>
    private static string RoleOn(StaffDutyDto d, string key)
    {
        if (!Guid.TryParse(key, out var userId)) return "Expected";
        var parts = new List<string>();
        if (d.RecorderUserIds.Contains(userId)) parts.Add("Takes the register");
        if (d.SupervisorUserIds.Contains(userId)) parts.Add("Supervises");
        if (parts.Count == 0) parts.Add(d.Kind == DutyKind.Rota ? "On duty" : "Expected");
        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Every sheet on the current axis. The keys match the editor's own view keys exactly
    /// (Timetable.razor InView), so a key handed over from there resolves here.
    /// </summary>
    private IEnumerable<PrintPage> AllPages()
    {
        if (detail == null) return Enumerable.Empty<PrintPage>();
        var lessons = detail.Lessons;
        return by switch
        {
            "teacher" => lessons.GroupBy(l => l.TeacherUserId).OrderBy(g => g.First().TeacherName, StringComparer.OrdinalIgnoreCase)
                // A joint lesson prints on the teacher's page with all its classes.
                .Select(g => new PrintPage(g.Key.ToString(), g.First().TeacherName, lessons.Where(l => g.Any(x => x.Id == l.Id) || (l.GroupId != null && g.Any(x => x.GroupId == l.GroupId && x.TeacherUserId == g.Key))).ToList())),
            "room" => lessons.Where(l => !string.IsNullOrEmpty(l.Room)).GroupBy(l => TimetableCycle.Normalize(l.Room)).OrderBy(g => g.First().Room, StringComparer.OrdinalIgnoreCase)
                .Select(g => new PrintPage(g.Key, g.First().Room!, g.ToList())),
            _ => lessons.GroupBy(l => TimetableCycle.Normalize(l.ClassName)).OrderBy(g => g.First().ClassName, StringComparer.OrdinalIgnoreCase)
                .Select(g => new PrintPage(g.Key, g.First().ClassName, g.ToList()))
        };
    }

    private IEnumerable<PrintPage> Pages()
        => chosen.Count == 0 ? AllPages() : AllPages().Where(p => chosen.Contains(p.Key));

    private string CellLine(List<TimetableLessonDto> rows) => by switch
    {
        "teacher" => $"{string.Join(" + ", rows.Select(r => r.ClassName).Distinct())}{Room(rows)}",
        "room" => $"{string.Join(" + ", rows.Select(r => r.ClassName).Distinct())} · {string.Join(", ", rows.Select(r => r.TeacherName).Distinct())}",
        _ => $"{string.Join(", ", rows.Select(r => r.TeacherName).Distinct())}{Room(rows)}"
    };

    private static string Room(List<TimetableLessonDto> rows) => string.IsNullOrEmpty(rows[0].Room) ? "" : $" · {rows[0].Room}";

    private async Task Print()
    {
        if (detail != null)
            await StaffApi.RecordExportAsync(branchId, new RecordStaffExportRequest { Kind = StaffExportKinds.Timetable, DocumentName = DocTitle, Format = "Print", RowCount = Pages().Count() });
        try { await JS.InvokeVoidAsync("window.print"); } catch { }
    }

    private async Task PublishToLibrary()
    {
        if (isPublishing || organizationId == Guid.Empty || detail == null) return;
        isPublishing = true;
        try
        {
            var name = $"{DocTitle} — {BranchState.CurrentBranchName}";
            await ReportPublishing.PublishAsync(new ReportPublishRequest
            {
                SheetElementId = "ttp-sheet",
                OrganizationId = organizationId,
                FileName = $"timetable-{FileSlug}-{detail.Timetable.EffectiveFrom:yyyy-MM-dd}.pdf",
                DocumentName = name,
                Summary = $"{detail.Timetable.Name}, {QDateFormat.Range(detail.Timetable.EffectiveFrom, detail.Timetable.EffectiveTo)}, {SelectionSummary}. Generated {QDateFormat.D(DateTime.UtcNow)} by {generatedBy ?? (branding?.ProductName ?? ProductBrand.Name)}.",
                PublishedFrom = $"Timetable — {BranchState.CurrentBranchName}",
                SubjectNoun = "timetable",
                Audit = doc => StaffApi.RecordExportAsync(branchId, new RecordStaffExportRequest { Kind = StaffExportKinds.Timetable, Published = true, MediaContentId = doc.Id, DocumentName = name, Format = "PDF" })
            }, JS, DocShareApi, Toast, Navigation);
        }
        finally
        {
            isPublishing = false;
        }
    }
}
