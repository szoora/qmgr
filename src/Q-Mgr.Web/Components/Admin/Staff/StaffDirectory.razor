@page "/admin/staff"
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@using QMgr.Web.Components.Admin.Staff
@inject IStaffPerformanceApiService StaffApi
@inject IToastService Toast
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState

<QPageTitle Text="Staff Directory" />

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Staff@if (TabHelp != null) { <QInfo Text="@TabHelp" Label="@TabHelpLabel" /> }</h1>
            <p class="subtitle">Everyone on this branch's staff, with their department, line manager and this period's band.</p>
        </div>
        <div class="header-actions">
            @* The open section's own buttons land here — see QPageActions. *@
            <SectionOutlet SectionId="QPageActions.Id" />
            @* These four act on the PEOPLE list (Export exports its filters; Import a list only opens the Import
               tab), so they show on People only. On the other tabs they sat beside that section's own buttons —
               six in one row on Class teachers, 84px tall (action-location, uniform-check, 2026-09-22). *@
            @if (hubTab == "people")
            {
                @if (canCreate)
                {
                    <QButton Text="Log record" Icon="journal-plus" Variant="primary" OnClick="@(() => showRecordDialog = true)" Disabled="@(directory == null)" />
                }
                @* The page somebody opens to look for staff is the page that should let them add some.
                   Before this, adding one lived under Administration > Users & Roles and importing a
                   list lived on Departments & Structure — neither reachable from here, which is exactly
                   the report: "I see Staff Directory but no way to add or import staff." *@
                @if (canAddStaff)
                {
                    <QButton Text="Add staff" Icon="person-plus" Variant="secondary"
                             OnClick="@(() => showAddDialog = true)" />
                }
                @if (canImportStaff)
                {
                    <QButton Text="Import a list" Icon="upload" Variant="secondary"
                             OnClick="@(() => hubTab = "import")" />
                }
                <QDataExport TItem="StaffMemberDto" Title="Staff directory" FileStem="staff-directory" Subtitle="@ExportSubtitle"
                             Columns="@ExportColumns" RowProvider="@ProvideExportRowsAsync" OnExported="@OnExported"
                             Disabled="@(!Visible.Any())" DisabledReason="Nothing matches the current filters." />
            }
        </div>
    </div>

    <StaffScopeNote Departments="@(directory?.ScopedToDepartments)" Noun="people" />

    @* The Staff hub (2026-09-18). Departments & Structure used to be its own sidebar entry with its
       own list of people — the same Name/Role/Departments/Line manager this page already shows,
       minus Band and Last record. One page, four tabs, one sidebar entry. *@
    <QTabs Tabs="@hubTabs" @bind-ActiveKey="@hubTab" IdPrefix="sd" />

    @* Class and subject assignments are their own sections; everything else that is not People is
       still the structure section. *@
    @if (hubTab is "class-teachers" or "subject-teachers")
    {
        <ClassTeachers Embedded="true" EmbeddedTab="@hubTab" />
    }
    else if (hubTab != "people")
    {
        <StaffStructure Embedded="true" EmbeddedTab="@hubTab" EditMemberId="@structureEditId"
                        EditMemberHandled="@(() => structureEditId = null)" />
    }
    else
    {
    <QFilterBar Wrap="true">
        <QInput TValue="string" @bind-Value="@search" Placeholder="Search name, email or job title" @bind-Value:after="PruneSelection" IconLeft="search" Clearable="true" Class="sd-search" />
        <QSelect TValue="string" TItem="string" @bind-Value="@departmentFilter" @bind-Value:after="PruneSelection" Items="@DepartmentOptions" Sorted="true" TextSelector="@(d => d)" ValueSelector="@(d => d)"
                 Placeholder="All departments" AllowClear="true" Class="sd-filter" />
        <QSelect TValue="string" TItem="(string Code, string Name)" @bind-Value="@roleFilter" @bind-Value:after="PruneSelection" Items="@RoleOptions" TextSelector="@(r => r.Name)" ValueSelector="@(r => r.Code)"
                 Placeholder="All roles" AllowClear="true" Class="sd-filter" />
        <QSelect TValue="int?" TItem="(int? Band, string Label)" @bind-Value="@bandFilter" @bind-Value:after="PruneSelection" Items="@BandOptions" TextSelector="@(b => b.Label)" ValueSelector="@(b => b.Band)"
                 Placeholder="All bands" AllowClear="true" Class="sd-filter" />
        <QSelect TValue="string" TItem="StaffPeriods.Option" Value="@period" ValueChanged="@OnPeriodChanged" Items="@PeriodOptions" TextSelector="@(p => p.Label)" ValueSelector="@(p => p.Key)"
                 Placeholder="Period" Class="sd-filter" />
        @* Carried over from the Departments & Structure Staff tab, which this page replaced. *@
        <QCheckbox @bind-Value="@onlyGaps" @bind-Value:after="PruneSelection" Label="Only people missing a department or line manager" />
    </QFilterBar>

    @* BULK, for the two things a school does to a whole group at once — a hundred and eighty people
       arrive from an import with no department and nobody supervising them, and setting that one at
       a time is not a task anybody finishes. Both actions run the ORDINARY per-person endpoint once
       each, so every rule it already enforces still applies (nobody is their own line manager; the
       person is told who supervises them), and whatever it refuses is named rather than swallowed.
       A selection may only ever cover rows the reader can SEE: PruneSelection runs on every filter. *@
    @if (CanSelect && directory != null && directory.Items.Count > 0)
    {
        <QBulkBar ShowSearch="false" ShowSelection="true"
                  VisibleCount="@Visible.Count" SelectedCount="@selected.Count"
                  AllSelected="@AllVisibleSelected" AllSelectedChanged="@ToggleSelectAllVisible"
                  ClearSelection="@(() => selected.Clear())"
                  IdleHint="@BulkIdleHint">
            <Actions>
                @if (canEditStructure)
                {
                    <QButton Text="Move to a department" Icon="diagram-3" Size="sm" Variant="secondary"
                             OnClick="@(() => OpenBulk(BulkAction.Department))" />
                    <QButton Text="Assign a line manager" Icon="person-up" Size="sm" Variant="secondary"
                             OnClick="@(() => OpenBulk(BulkAction.LineManager))" />
                }
                @if (canCreate)
                {
                    @* One record for everyone ticked — a contribution or a conduct matter they share. The dialog
                       leaves the reader out and says so; the server re-checks every person against the scope. *@
                    <QButton Text="Log a record" Icon="journal-plus" Size="sm" Variant="secondary"
                             OnClick="@OpenBulkLog" />
                }
            </Actions>
        </QBulkBar>
    }

    @if (isLoading)
    {
        <div class="loading-container"><QSpinner Size="lg" /><span>Loading the directory...</span></div>
    }
    else if (directory == null || directory.Items.Count == 0)
    {
        <QEmptyState Icon="people" Title="No staff yet"
                     Text="Staff appear here once they have a user account on this branch. Add them under Users, or import a list under Staff Performance → Structure → Import." />
    }
    else if (!Visible.Any())
    {
        <QEmptyState Icon="funnel" Title="No matches" Text="Clear a filter or two to see the rest of the directory." />
    }
    else
    {
        <QCard NoPadding="true">
            <div class="table-wrap">
                <table class="data-table q-stack sd-table">
                    <thead>
                        <tr>
                            @if (CanSelect) { <th class="sd-tick"></th> }
                            <th>Name</th>
                            <th>Role</th>
                            <th>Departments</th>
                            <th>Line manager</th>
                            <th>Band</th>
                            <th>Last record</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @* All above QPaging.VirtualizeAbove rows renders through <Virtualize>, so choosing All on a large list
                           never ships every row down the circuit at once (plan STUDENT_ROSTER_AND_LIST_STANDARD §1, L3). *@
                        @if (pageSize == QPager.All && Visible.Count > QPaging.VirtualizeAbove)
                        {
                            <Virtualize Items="@Visible" Context="m" ItemSize="52" SpacerElement="tr">@DirectoryRow(m)</Virtualize>
                        }
                        else
                        {
                            @foreach (var m in Paged)
                            {
                                @DirectoryRow(m)
                            }
                        }
                    </tbody>
                </table>
            </div>
        </QCard>
        <QPager Count="@Visible.Count" PageSize="@pageSize" PageIndex="@pageIndex" PageIndexChanged="@(i => pageIndex = i)" PageSizeOptions="@QPagerDefaults.Sizes" AllowAll="true" StorageKey="staff-directory"
                    PageSizeChanged="@(n => { pageSize = n; pageIndex = 0; })" SelectedCount="@selected.Count" ItemLabel="people" />
    }
    }
</div>

@if (directory != null)
{
    <StaffRecordDialog BranchId="@branchId" SubjectUserId="@recordSubjectId" Subjects="@directory.Items"
                       Visible="@showRecordDialog" VisibleChanged="@OnRecordDialogVisibleChanged" OnCreated="@OnRecordCreated" />

    <StaffProfileDialog BranchId="@branchId" UserId="@profileUserId" CanEdit="@canEditStructure"
                        @bind-Visible="showProfileDialog" OnSaved="@LoadAsync" />

    <AddStaffDialog BranchId="@branchId" Directory="@directory.Items"
                    @bind-Visible="showAddDialog" OnCreated="@LoadAsync" />

    <BulkStaffRecordDialog BranchId="@branchId" People="@bulkLogPeople"
                           @bind-Visible="showBulkLog" OnLogged="@OnBulkLogged" />
}

@* The one dialog both bulk actions use: pick the target, read what it will do, apply. It names the
   number of people and says what is NOT changed, because "move to a department" could reasonably be
   read as adding one, and here it replaces. *@
<QModal @bind-Visible="@showBulk" Title="@BulkTitle" Icon="@(bulkAction == BulkAction.Department ? "diagram-3" : "person-up")" Size="sm">
    <p class="sd-bulk-lede">@BulkLede</p>

    @if (bulkAction == BulkAction.Department)
    {
        <div class="form-group">
            <label>Department <span class="required">*</span></label>
            <QSelect TValue="Guid?" TItem="DepartmentDto" @bind-Value="@bulkDepartment" Items="@bulkDepartments"
                     TextSelector="@(d => d.Name)" ValueSelector="@(d => (Guid?)d.Id)" Placeholder="Choose a department" />
        </div>
    }
    else
    {
        <div class="form-group">
            <label>Line manager <span class="required">*</span></label>
            <QSelect TValue="Guid?" TItem="StaffMemberDto" @bind-Value="@bulkLineManager" Items="@ManagerOptions"
                     TextSelector="@(m => m.FullName)" ValueSelector="@(m => (Guid?)m.UserId)" Placeholder="Choose a line manager" />
            <p class="form-hint">Anybody already chosen who IS this line manager is skipped — nobody supervises themselves.</p>
        </div>
    }

    @if (bulkFailures.Count > 0)
    {
        <div class="sd-bulk-failed">
            <strong>Not changed:</strong>
            <ul>@foreach (var f in bulkFailures) { <li>@f</li> }</ul>
        </div>
    }

    <div class="modal-actions">
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showBulk = false)" Disabled="@bulkRunning" />
        <QButton Text="@BulkConfirm" Icon="check-lg" Variant="primary" OnClick="@ApplyBulkAsync"
                 Loading="@bulkRunning" Disabled="@(bulkRunning || !BulkReady)" />
    </div>
</QModal>

<style>
    .loading-container { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 60px 20px; color: var(--qm-text-muted); }
    .sd-tick { width: 34px; }
    .sd-row--picked td { background: rgba(var(--qm-primary-rgb), .06); }
    .sd-bulk-lede { color: var(--qm-text-secondary); font-size: var(--qm-text-base); margin: 0 0 12px; }
    .sd-bulk-failed { margin-top: 12px; font-size: var(--qm-text-sm); color: var(--qm-danger); }
    .sd-bulk-failed ul { margin: 4px 0 0; padding-left: 18px; }
    .sd-search { flex: 1 1 240px; min-width: 0; }
    .sd-filter { flex: 0 1 200px; min-width: 150px; }
    .table-wrap { overflow-x: auto; }
    .sd-table th { white-space: nowrap; }
    .sd-person { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .sd-person__text { display: flex; flex-direction: column; min-width: 0; }
    .sd-person__name { font-weight: 600; color: var(--qm-text-primary); text-decoration: none; }
    .sd-person__name:hover { color: var(--qm-primary); }
    .sd-person__sub { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    .sd-muted { color: var(--qm-text-muted); font-size: var(--qm-text-sm); }
    .sd-actions { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
</style>

@code {
    // The hub owns the title row, so it also owns the explanation of whichever tab is open. An embedded section's
    // own title is hidden, and its QInfo went with it when Class teachers folded in (density-and-staff, 2026-09-22).
    private string? TabHelp => hubTab switch
    {
        "class-teachers" => ClassTeachers.PastoralHelp,
        "subject-teachers" => ClassTeachers.SubjectHelp,
        // People (and the structure tabs) already say what they are in the subtitle; a popover repeating it is noise.
        _ => null
    };
    private string TabHelpLabel => hubTab switch { "class-teachers" => "Class teachers", "subject-teachers" => "Subject teachers", _ => "Staff" };

    // ---- Bulk: a department, or a line manager, for everybody ticked ----------------------------
    // The two jobs a school actually does to a group. Neither gets its own API: each runs the
    // ordinary per-person endpoint once per row, which keeps every rule that endpoint enforces and
    // means a refusal is about ONE person and can be named. A bulk action that swallows failures is
    // worse than one that does not exist (CLAUDE.md, the list-page sweep).

    private enum BulkAction { Department, LineManager }

    private readonly HashSet<Guid> selected = new();
    private BulkAction bulkAction = BulkAction.Department;
    private bool showBulk, bulkRunning;
    private Guid? bulkDepartment, bulkLineManager;
    private List<DepartmentDto> bulkDepartments = new();
    private readonly List<string> bulkFailures = new();

    private bool AllVisibleSelected => Visible.Count > 0 && Visible.All(m => selected.Contains(m.UserId));

    private void Pick(Guid userId, bool on)
    {
        if (on) selected.Add(userId); else selected.Remove(userId);
    }

    private void ToggleSelectAllVisible(bool all)
    {
        if (all) foreach (var m in Visible) selected.Add(m.UserId);
        else foreach (var m in Visible) selected.Remove(m.UserId);
    }

    /// <summary>
    /// A SELECTION MAY ONLY EVER COVER ROWS THE READER CAN SEE. Without this, "apply to 20 selected"
    /// silently reaches people the filter is hiding — the rule QBulkBar cannot enforce itself,
    /// because only this page knows what a row is.
    /// </summary>
    private void PruneSelection()
    {
        var visible = Visible.Select(m => m.UserId).ToHashSet();
        selected.RemoveWhere(id => !visible.Contains(id));
    }

    private IEnumerable<StaffMemberDto> ManagerOptions =>
        directory?.Items.OrderBy(m => m.SortName ?? m.FullName, StringComparer.OrdinalIgnoreCase) ?? Enumerable.Empty<StaffMemberDto>();

    private List<StaffMemberDto> SelectedPeople =>
        Visible.Where(m => selected.Contains(m.UserId)).ToList();

    private string BulkTitle => bulkAction == BulkAction.Department
        ? $"Move {selected.Count} {(selected.Count == 1 ? "person" : "people")} to a department"
        : $"Give {selected.Count} {(selected.Count == 1 ? "person" : "people")} a line manager";

    private string BulkLede => bulkAction == BulkAction.Department
        ? "Their departments are REPLACED with the one you choose. Roles, line managers and records are untouched."
        : "Everybody ticked gets this line manager. Their departments, roles and records are untouched, and each person is told who now supervises them.";

    private string BulkConfirm => bulkAction == BulkAction.Department ? "Move them" : "Assign";

    private bool BulkReady => selected.Count > 0 &&
        (bulkAction == BulkAction.Department ? bulkDepartment.HasValue : bulkLineManager.HasValue);

    private async Task OpenBulk(BulkAction action)
    {
        if (selected.Count == 0)
        {
            Toast.Notify(ToastSeverity.Info, "Nobody is ticked", "Tick the people this should apply to first.");
            return;
        }

        bulkAction = action;
        bulkDepartment = null;
        bulkLineManager = null;
        bulkFailures.Clear();

        if (action == BulkAction.Department && bulkDepartments.Count == 0)
        {
            try { bulkDepartments = (await StaffApi.GetDepartmentsAsync(branchId)).Where(d => d.IsActive).ToList(); }
            catch (Exception ex) { Toast.Notify(ToastSeverity.Error, "Could not read the departments", ex.Message); return; }

            if (bulkDepartments.Count == 0)
            {
                Toast.Notify(ToastSeverity.Warning, "There are no departments yet",
                    "Create one on the Departments tab, then move people into it.");
                return;
            }
        }

        showBulk = true;
    }

    /// <summary>
    /// One call per person, and the OTHER field is sent back unchanged — the endpoint replaces both,
    /// so assigning a line manager without this would quietly clear everybody's departments.
    /// </summary>
    private async Task ApplyBulkAsync()
    {
        if (!BulkReady || bulkRunning) return;

        bulkRunning = true;
        bulkFailures.Clear();
        var done = 0;

        try
        {
            foreach (var m in SelectedPeople)
            {
                // Nobody is their own line manager. The server refuses it too; refusing here means
                // one obvious case is not reported to the reader as a failure they must think about.
                if (bulkAction == BulkAction.LineManager && m.UserId == bulkLineManager) continue;

                try
                {
                    await StaffApi.UpdateMemberStructureAsync(branchId, m.UserId, new UpdateStaffStructureRequest
                    {
                        DepartmentIds = bulkAction == BulkAction.Department
                            ? new List<Guid> { bulkDepartment!.Value }
                            : m.DepartmentIds.ToList(),
                        LineManagerUserId = bulkAction == BulkAction.LineManager ? bulkLineManager : m.LineManagerUserId
                    });
                    done++;
                }
                catch (Exception ex)
                {
                    bulkFailures.Add($"{m.FullName} — {ex.Message}");
                }
            }
        }
        finally
        {
            bulkRunning = false;
        }

        if (bulkFailures.Count == 0)
        {
            showBulk = false;
            selected.Clear();
            Toast.Notify(ToastSeverity.Success,
                bulkAction == BulkAction.Department ? $"{done} moved" : $"{done} given a line manager",
                "The directory below is up to date.");
        }
        else
        {
            Toast.Notify(ToastSeverity.Warning, $"{done} changed, {bulkFailures.Count} not",
                "The ones that did not change are listed in the dialog.");
        }

        await LoadAsync();
        PruneSelection();
    }

    /// <summary>The activity log carries every export (plan §11); the file itself was built in the browser.</summary>
    private Task OnExported(ExportResult export) => export.Success
        ? StaffApi.RecordExportAsync(branchId, new RecordStaffExportRequest { Kind = StaffExportKinds.Directory, Format = export.Format?.ToString(), RowCount = export.RowCount })
        : Task.CompletedTask;

    private int pageSize = QPagerDefaults.Size;

    private Guid branchId;
    private bool isLoading = true;
    private bool canCreate;
    /// <summary>
    /// The Staff hub's tabs. People is this page's own directory; the other three are rendered by
    /// StaffStructure, embedded. Before 2026-09-18 those lived on a separate sidebar entry whose
    /// Staff tab listed the same people this page already lists, with fewer columns.
    /// </summary>
    // Departments & Structure was its own page and its own permission before the merge, so the hub
    // opens for either and shows only the sections the caller holds. See HubTabs.
    private static readonly HubTabs.Section[] Sections =
    {
        new(new QTab("people", "People", "people"), Permissions.StaffRecordsView),
        // Class and subject assignments live here since 2026-09-22: the ASSIGNMENT is what grants
        // the pastoral permissions and the class scope, so this is an access-granting screen and
        // belongs beside the other ones. Gated on its own permission, which is neither a subset nor
        // a superset of StaffRecordsView — a staff reader who cannot assign classes must not see the
        // tabs, and a classes.teachers.manage holder without staff.records.view must still reach them.
        new(new QTab("class-teachers", "Class teachers", "person-video3"), Permissions.ClassTeachersManage),
        new(new QTab("subject-teachers", "Subject teachers", "book"), Permissions.ClassTeachersManage),
        new(new QTab("departments", "Departments", "diagram-3"), Permissions.StaffStructureManage),
        new(new QTab("coverage", "Coverage", "shield-check"), Permissions.StaffRecordsView, Permissions.StaffStructureManage),
        new(new QTab("import", "Import", "upload"), Permissions.StaffStructureManage),
    };

    private IReadOnlyList<QTab> hubTabs = Array.Empty<QTab>();
    private string hubTab = "people";

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    /// <summary>The last ?tab= this hub acted on — see HubTabs.FollowQuery.</summary>
    private string? appliedTab;

    /// <summary>Set when People asks the Departments section to open one person's editor.</summary>
    private Guid? structureEditId;

    /// <summary>Whose staff record the profile dialog is showing.</summary>
    private Guid? profileUserId;
    private bool showProfileDialog;

    /// <summary>
    /// Adding staff used to be NavigateTo("/admin/users") — out of the module, into Administration,
    /// with no way back to the directory. It is a dialog on this page now; the endpoint behind it
    /// is the same user-creation path, RoleAssignmentGuard included.
    /// </summary>
    private bool showAddDialog;

    /// <summary>The gaps view the removed Staff tab offered: who has no department or no line manager.</summary>
    private bool onlyGaps;

    private bool canEditStructure;

    private bool canAddStaff;
    private bool canImportStaff;
    private StaffDirectoryDto? directory;
    private string period = StaffPeriods.CurrentKey();
    private IReadOnlyList<StaffPeriods.Option> PeriodOptions = StaffPeriods.Options();

    private string search = string.Empty;
    private string? departmentFilter;
    private string? roleFilter;
    private int? bandFilter;
    private int pageIndex;

    private bool showRecordDialog;
    private Guid? recordSubjectId;

    private static readonly IReadOnlyList<(int? Band, string Label)> BandOptions = new (int?, string)[]
    {
        (5, "Band 5"), (4, "Band 4"), (3, "Band 3"), (2, "Band 2"), (1, "Band 1"), (0, "No evidence yet")
    };

    private IReadOnlyList<string> DepartmentOptions =>
        directory?.Items.SelectMany(m => m.DepartmentNames).Distinct().OrderBy(d => d).ToList() ?? new List<string>();

    private IReadOnlyList<(string Code, string Name)> RoleOptions =>
        directory?.Items.Select(m => (m.RoleCode, m.RoleName)).Distinct().OrderBy(r => r.RoleName).ToList() ?? new List<(string, string)>();

    private List<StaffMemberDto> Visible
    {
        get
        {
            if (directory == null) return new();
            var q = (search ?? string.Empty).Trim();
            return directory.Items
                .Where(m => string.IsNullOrEmpty(q)
                    || m.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || m.Email.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (m.JobTitle ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase))
                .Where(m => departmentFilter == null || m.DepartmentNames.Contains(departmentFilter))
                .Where(m => roleFilter == null || m.RoleCode == roleFilter)
                .Where(m => bandFilter == null || (bandFilter == 0 ? m.CurrentBand == null : m.CurrentBand == bandFilter))
                .Where(m => !onlyGaps || !m.DepartmentNames.Any() || m.LineManagerUserId == null)
                .OrderBy(m => m.SortName ?? m.FullName)
                .ToList();
        }
    }

    private IEnumerable<StaffMemberDto> Paged => QPaging.Page(Visible, SafePageIndex, pageSize);
    private int SafePageIndex => QPaging.SafeIndex(pageIndex, Visible.Count, pageSize);

    private string ExportSubtitle => $"{BranchState.CurrentBranchName} · {period} · {Visible.Count} of {directory?.Items.Count ?? 0} people";

    private static readonly List<ExportColumn<StaffMemberDto>> ExportColumns = new()
    {
        new("Name", m => m.FullName, ExportType.Text, 26),
        new("Email", m => m.Email, ExportType.Text, 28),
        new("Job title", m => m.JobTitle, ExportType.Text, 22),
        new("Employee number", m => m.EmployeeNumber, ExportType.Text, 14),
        new("Role", m => m.RoleName, ExportType.Text, 18),
        new("Departments", m => string.Join("; ", m.DepartmentNames), ExportType.Text, 26),
        new("Line manager", m => m.LineManagerName, ExportType.Text, 22),
        new("Band", m => m.CurrentBandName, ExportType.Text, 12),
        new("Composite", m => m.CurrentComposite, ExportType.Number, 10),
        new("Last record", m => m.LastRecordAt?.ToLocalTime(), ExportType.Date, 18)
    };

    private Task<ExportRows<StaffMemberDto>> ProvideExportRowsAsync() =>
        Task.FromResult(new ExportRows<StaffMemberDto>(Visible, false));

    protected override async Task OnInitializedAsync()
    {
        hubTabs = await HubTabs.VisibleAsync(PermissionService, Sections);
        if (hubTabs.Count == 0)
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }
        hubTab = hubTabs[0].Key;

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
        {
            Navigation.NavigateTo(BillingLinks.Modules);
            return;
        }

        canCreate = await PermissionService.HasPermissionAsync(Permissions.StaffRecordsCreate);
        // Adding one account needs users.create; importing a list needs that AND the structure
        // permission, which is the same pair StaffImportController enforces — so a button that
        // appears is a button that works.
        canAddStaff = await PermissionService.HasPermissionAsync(Permissions.UsersCreate);

        // The hub owns the URL: /admin/staff?tab=departments is the one link to that section, and
        // the sections themselves no longer carry routes. Anything unrecognised falls back to People
        // rather than showing an empty shell.
        hubTab = HubTabs.Resolve(hubTabs, TabParam);
        appliedTab = TabParam;
        canImportStaff = canAddStaff && await PermissionService.HasPermissionAsync(Permissions.StaffStructureManage);
        canEditStructure = await PermissionService.HasPermissionAsync(Permissions.StaffStructureManage);

        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        TrackBranch();

        // A structure-only caller never sees People, so do not fetch a list they may not read.
        if (hubTabs.Any(x => x.Key == "people")) await LoadAsync();
        else isLoading = false;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            directory = await StaffApi.GetDirectoryAsync(branchId, period);
            pageIndex = 0;
        }
        catch (Exception ex)
        {
            directory = null;
            Toast.Notify(ToastSeverity.Error, "Could not load the directory", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPeriodChanged(string value)
    {
        period = value;
        await LoadAsync();
        PruneSelection();
    }

    /// <summary>The branch changed under the page: reload against the new one.</summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        await LoadAsync();
    }

    /// <summary>Opens one person's staff record — the employment and contact file.</summary>
    private void OpenProfile(StaffMemberDto m)
    {
        profileUserId = m.UserId;
        showProfileDialog = true;
    }

    // ---- The group log ("Log a record" on the bulk bar, 2026-09-23) ----

    /// <summary>A tick box is offered to anyone with something to apply to a selection: a structure action or the group log.</summary>
    private bool CanSelect => canEditStructure || canCreate;

    private string BulkIdleHint => canEditStructure && canCreate
        ? "Tick people to log one record for all of them, put several in a department, or give them the same line manager, or"
        : canCreate
            ? "Tick people to log one record for all of them, or"
            : "Tick people to put several in a department, or give them the same line manager, or";

    private bool showBulkLog;

    /// <summary>Captured when the dialog opens, so a filter change behind it cannot change who it writes for.</summary>
    private IReadOnlyList<StaffMemberDto> bulkLogPeople = Array.Empty<StaffMemberDto>();

    private void OpenBulkLog()
    {
        if (selected.Count == 0)
        {
            Toast.Notify(ToastSeverity.Info, "Nobody is ticked", "Tick the people this record is about first.");
            return;
        }
        bulkLogPeople = SelectedPeople;
        showBulkLog = true;
    }

    private async Task OnBulkLogged(BulkStaffRecordResultDto result)
    {
        var who = $"{result.Created} {(result.Created == 1 ? "person" : "people")}";
        Toast.Notify(ToastSeverity.Success, $"Logged for {who}" + (result.SkippedSelf.Count > 0 ? " — you were left out" : ""),
            "Each person can read it on their own file.");
        selected.Clear();
        bulkLogPeople = Array.Empty<StaffMemberDto>();
        await LoadAsync();
        PruneSelection();
    }

    private void OpenRecordFor(StaffMemberDto m)
    {
        recordSubjectId = m.UserId;
        showRecordDialog = true;
    }

    private void OnRecordDialogVisibleChanged(bool visible)
    {
        showRecordDialog = visible;
        if (!visible) recordSubjectId = null;
    }

    private Task OnRecordCreated(StaffPerformanceRecordDto _) => LoadAsync();


    /// <summary>
    /// Follow a ?tab= that changed without the route changing — a link from one tab of this
    /// hub to another. OnInitializedAsync does not re-run for that, so without this the URL
    /// would change and the screen would not. The rule itself lives in HubTabs.
    /// </summary>
    protected override void OnParametersSet()
    {
        HubTabs.FollowQuery(hubTabs, TabParam, ref appliedTab, ref hubTab);
    }

    /// <summary>One row, shared by the paged loop and the virtualised All so the two cannot drift.</summary>
    private RenderFragment DirectoryRow(StaffMemberDto m) => __builder =>
    {
                            <tr class="@(selected.Contains(m.UserId) ? "sd-row--picked" : "")">
                                @if (CanSelect)
                                {
                                    <td class="sd-tick">
                                        @* No label: the name is in the next cell, and repeating it
                                           would read out twice. The title carries it for a screen reader. *@
                                        <span title="@($"Select {m.FullName}")">
                                            <QCheckbox Value="@selected.Contains(m.UserId)"
                                                       ValueChanged="@(v => Pick(m.UserId, v))" />
                                        </span>
                                    </td>
                                }
                                <td>
                                    <div class="sd-person">
                                        <QAvatar Name="@m.FullName" PhotoUrl="@m.PhotoUrl" Size="sm" />
                                        <div class="sd-person__text">
                                            <a href="/admin/staff/@m.UserId/timeline" class="sd-person__name">@m.FullName</a>
                                            <span class="sd-person__sub">@(string.IsNullOrWhiteSpace(m.JobTitle) ? m.Email : m.JobTitle)</span>
                                        </div>
                                    </div>
                                </td>
                                <td><QChip Text="@m.RoleName" Color="@m.RoleColor" Size="sm" /></td>
                                <td>@(m.DepartmentNames.Any() ? string.Join(", ", m.DepartmentNames) : "—")</td>
                                <td>@(m.LineManagerName ?? "—")</td>
                                <td>
                                    @if (m.CurrentBand.HasValue)
                                    {
                                        <QChip Text="@($"{m.CurrentBandName} · {StaffDisplay.Composite(m.CurrentComposite)}")" Variant="@StaffDisplay.BandVariant(m.CurrentBand)" Size="sm" />
                                    }
                                    else
                                    {
                                        <span class="sd-muted">No evidence yet</span>
                                    }
                                </td>
                                <td>@(m.LastRecordAt.HasValue ? QDateFormat.D(m.LastRecordAt.Value.ToLocalTime()) : "—")</td>
                                <td>
                                    <div class="sd-actions">
                                        <QButton Text="Timeline" Icon="clock-history" Variant="ghost" Size="sm" OnClick="@(() => Navigation.NavigateTo($"/admin/staff/{m.UserId}/timeline"))" />
                                        @* The staff record — employment terms, qualification,
                                           registration number, contact. It could only ever be
                                           WRITTEN by the bulk import until 2026-09-19, and never
                                           read back per person. *@
                                        <QButton Text="Record" Icon="person-vcard" Variant="ghost" Size="sm"
                                                 OnClick="@(() => OpenProfile(m))" />
                                        @if (canEditStructure)
                                        {
                                            @* The department / line-manager editor moved here with the
                                               duplicate Staff tab's removal; the dialog itself still lives
                                               in the Departments section, so this opens that section on
                                               this person rather than duplicating the form. *@
                                            <QButton Text="Structure" Icon="diagram-3" Variant="ghost" Size="sm"
                                                     OnClick="@(() => { structureEditId = m.UserId; hubTab = "departments"; })" />
                                        }
                                        @if (canCreate)
                                        {
                                            <QButton Text="Log record" Icon="journal-plus" Variant="ghost" Size="sm" OnClick="@(() => OpenRecordFor(m))" />
                                        }
                                    </div>
                                </td>
                            </tr>
    };
}
