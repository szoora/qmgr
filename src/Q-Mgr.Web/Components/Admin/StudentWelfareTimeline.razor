@page "/admin/students/{StudentId:guid}/welfare"
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject IStudentApiService StudentApi
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IJSRuntime JS
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared.UI
@using QMgr.Web.Services
@implements IDisposable

<PageTitle>Welfare Timeline - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>@SubjectName — Welfare Timeline</h1>
            <p class="subtitle">
                @if (context != null)
                {
                    @($"{context.StudentCode ?? "No code"} · {context.ClassName ?? "No class"}")
                }
                else
                {
                    @:Achievements, behavior and welfare records, oldest to newest, in one place
                }
            </p>
            @* The ledger reads fine on welfare.view alone. Two things on this page are roster
               capabilities and are simply absent without students.view — better named once here
               than left as buttons that mysteriously never appear. *@
            @if (!isLoading && !canViewRoster)
            {
                <p class="roster-notice">
                    <QIcon Name="info-circle" />
                    <span>Guardian details and the branch roster aren't available to this account, so notifying a guardian, logging one incident against several students, and the subject-access export are all unavailable here. The ledger itself is complete.</span>
                </p>
            }
            @if (!isLoading && FinalizedRecords.Any(r => r.Points.HasValue && r.Points.Value != 0))
            {
                <div class="points-summary">
                    <span class="points-summary__item points-summary__item--positive"><QIcon Name="arrow-up-circle-fill" /> +@AchievementPoints achievement</span>
                    <span class="points-summary__item points-summary__item--negative"><QIcon Name="arrow-down-circle-fill" /> @BehaviorPoints behavior</span>
                    <span class="points-summary__item points-summary__item--net">Net @(NetPoints > 0 ? "+" : "")@NetPoints</span>
                    @* A total that quietly changed meaning when somebody moved the filter would be
                       worse than no total, so the scope is stated on the chips themselves. *@
                    <span class="points-summary__scope">@(range.IsAllTime ? "all time" : $"in {range.Caption}")</span>
                </div>
            }
        </div>
        <div class="header-actions">
            @if (canCreate)
            {
                <QButton Text="Log Record" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
            }
            @if (canViewRoster)
            {
                <QButton Text="Export data (SAR)" Icon="file-earmark-arrow-down" Variant="secondary" OnClick="@ExportStudentData" Loading="@isExporting"
                         Title="Download everything held about this student as one JSON file — for a subject-access request" />
            }
            <QButton Text="Back to Roster" Icon="arrow-left" Variant="ghost" OnClick="@(() => Navigation.NavigateTo("/admin/students/roster"))" />
        </div>
    </div>

    @* Defaults to All time: opening a child's welfare record and being shown only the last week
       by default would hide exactly the history somebody came here to read. The filter exists for
       students whose timeline runs to years, not to shorten everyone's by default. *@
    <QCard Class="timeline-filter-card">
        <div class="timeline-filter">
            <QDateRangePicker Range="@range"
                              RangeChanged="@OnRangeChanged"
                              Presets="@DateRangePresets.WithAllTime"
                              CaptionPrefix="Showing"
                              Disabled="@isLoading" />
            <div class="timeline-filter__actions">
                <QButton Text="Printable report" Icon="printer" Variant="secondary" OnClick="@OpenPrintableReport"
                         Title="Open the A4 welfare report for this period, ready to print or save as PDF" />
            </div>
        </div>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading timeline...</span>
        </div>
    }
    else if (!records.Any())
    {
        @RenderRestrictedNotes()

        <div class="empty-state">
            <QIcon Name="journal-richtext" Size="xl" />
            <h3>No Records Yet</h3>
            <p>Nothing has been logged for @(context?.FullName ?? "this student") yet.</p>
            @if (canCreate)
            {
                <QButton Text="Log First Record" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
            }
        </div>
    }
    else
    {
        @RenderRestrictedNotes()

        <div class="timeline">
            @foreach (var record in records)
            {
                <div class="timeline-item timeline-item--@record.CaseType.ToString().ToLowerInvariant()">
                    <div class="timeline-marker" style="background-color: @(record.CategoryColor ?? DefaultCaseColor(record.CaseType))">
                        <QIcon Name="@CaseTypeIcon(record.CaseType)" />
                    </div>
                    <div class="timeline-card @(record.Status == WelfareStatus.Draft ? "timeline-card--draft" : "")">
                        <div class="timeline-card-header">
                            <div class="timeline-card-title">
                                <strong>@record.CategoryName</strong>
                                <span class="tier-badge tier-badge--@record.Tier.ToString().ToLowerInvariant()">@record.Tier</span>
                                @if (record.Points.HasValue && record.Points.Value != 0)
                                {
                                    <span class="points-badge @(record.Points.Value > 0 ? "points-badge--positive" : "points-badge--negative")">
                                        @(record.Points.Value > 0 ? "+" : "")@record.Points
                                    </span>
                                }
                                @if (record.Visibility == WelfareVisibility.Confidential)
                                {
                                    <span class="confidential-badge"><QIcon Name="lock-fill" /> Confidential</span>
                                }
                                else if (record.Visibility == WelfareVisibility.Restricted)
                                {
                                    <span class="restricted-badge"><QIcon Name="shield-lock-fill" /> Restricted</span>
                                }
                                @* Only rendered for a holder of welfare.restricted.view. The control
                                   is cosmetic either way — the API re-checks the permission and
                                   refuses a move to a level the caller could not then read. *@
                                @if (canSetRestricted && record.Status != WelfareStatus.Draft)
                                {
                                    <QSelect TValue="WelfareVisibility" TItem="VisibilityOption"
                                             Value="@record.Visibility" Items="@visibilityOptions"
                                             TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Class="status-select"
                                             ValueChanged="@(v => ChangeVisibility(record, v))" />
                                }
                                @if (record.Status == WelfareStatus.Draft)
                                {
                                    <span class="status-badge status-badge--draft"><QIcon Name="pencil-fill" /> Draft</span>
                                }
                                else if (canEdit)
                                {
                                    <QSelect TValue="WelfareStatus" TItem="StatusOption" Value="@record.Status" Items="@workflowStatusOptions"
                                             TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Class="status-select"
                                             ValueChanged="@(s => ChangeStatus(record, s))" />
                                }
                                else
                                {
                                    <span class="status-badge status-badge--@record.Status.ToString().ToLowerInvariant()">@record.Status</span>
                                }
                            </div>
                            <span class="timeline-date">@QDateFormat.DT(record.OccurredAt.ToLocalTime())</span>
                        </div>
                        <p class="timeline-description">@record.Description</p>
                        @if (!string.IsNullOrWhiteSpace(record.Location))
                        {
                            <p class="timeline-meta"><QIcon Name="geo-alt-fill" /> @record.Location</p>
                        }
                        <p class="timeline-meta">Reported by @record.ReportedByName</p>
                        @if (record.AdditionalStudentNames.Any())
                        {
                            <p class="timeline-meta"><QIcon Name="people-fill" /> Also logged for: @string.Join(", ", record.AdditionalStudentNames)</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(record.ActionTaken) || record.AssignedToUserId.HasValue || record.ActionDueDate.HasValue)
                        {
                            <div class="action-box">
                                <QIcon Name="clipboard2-check-fill" />
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(record.ActionTaken))
                                    {
                                        <span class="action-box-title">@record.ActionTaken</span>
                                    }
                                    <span class="action-box-meta">
                                        @if (record.AssignedToUserId.HasValue)
                                        {
                                            @($"Assigned to {record.AssignedToName}")
                                        }
                                        @if (record.ActionDueDate.HasValue)
                                        {
                                            @($"{(record.AssignedToUserId.HasValue ? " · " : "")}Due {QDateFormat.D(record.ActionDueDate.Value)}")
                                            @if (record.ActionDueDate.Value < DateTime.UtcNow && record.Status != WelfareStatus.Resolved)
                                            {
                                                <span class="overdue-tag">Overdue</span>
                                            }
                                        }
                                    </span>
                                </div>
                            </div>
                        }

                        @if (record.Attachments.Any())
                        {
                            <div class="attachment-list">
                                @foreach (var att in record.Attachments)
                                {
                                    <a class="attachment-chip" href="@att.FileUrl" target="_blank" rel="noopener">
                                        <QIcon Name="@(att.ContentType.StartsWith("image/") ? "image-fill" : "file-earmark-pdf-fill")" />
                                        @att.FileName
                                    </a>
                                }
                            </div>
                        }

                        @if (record.Notes.Any())
                        {
                            <div class="note-list">
                                @foreach (var note in record.Notes)
                                {
                                    <div class="note-item @(note.Kind == WelfareNoteKind.Statement ? "note-item--statement" : "")">
                                        @if (note.Kind == WelfareNoteKind.Statement)
                                        {
                                            <span class="statement-tag">Statement@(note.IsFinal ? " · Final" : " · Draft")</span>
                                        }
                                        <span class="note-author">@(note.Kind == WelfareNoteKind.Statement && !string.IsNullOrWhiteSpace(note.AttributedToName) ? note.AttributedToName : note.AuthorName)</span>
                                        @if (note.Kind == WelfareNoteKind.Statement && !string.IsNullOrWhiteSpace(note.AttributedToName))
                                        {
                                            <span class="note-recorded-by">recorded by @note.AuthorName</span>
                                        }
                                        <span class="note-date">@QDateFormat.CDT(note.CreatedAt.ToLocalTime())</span>
                                        <p>@note.Body</p>
                                    </div>
                                }
                            </div>
                        }

                        @if (record.Notifications.Any())
                        {
                            <div class="notification-list">
                                @foreach (var n in record.Notifications)
                                {
                                    <div class="notification-item @(n.Success ? "notification-item--success" : "notification-item--failed")">
                                        <QIcon Name="@(n.Success ? "check-circle-fill" : "x-circle-fill")" />
                                        <span>@n.Channel to @n.GuardianName by @n.SentByName · @QDateFormat.CDT(n.CreatedAt.ToLocalTime())</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="timeline-card-actions">
                            @if (record.Status == WelfareStatus.Draft && canCreate)
                            {
                                <QButton Text="Finalize" Icon="check2-circle" Size="sm" Variant="primary" OnClick="@(() => FinalizeRecord(record))" />
                            }
                            @if (canEdit)
                            {
                                @* Grading is available on drafts too — a draft is the author's own
                                   unfinished note, and "what did we do about it" is usually known
                                   later than the incident itself. Labelled by state so a record
                                   that has never been graded advertises the gap rather than
                                   hiding it behind a generic verb. *@
                                @* An achievement has no response stage, so it never advertises a
                                   gap — its dialog is the antecedent/function pair only. *@
                                <QButton Text="@(record.CaseType != WelfareCaseType.Achievement && record.ResponseStage == null ? "Set response" : "Interpretation")"
                                         Icon="list-ol" Size="sm"
                                         Variant="@(record.CaseType != WelfareCaseType.Achievement && record.ResponseStage == null ? "secondary" : "ghost")"
                                         OnClick="@(() => ShowResponseDialog(record))" />
                            }
                            @if (record.Status != WelfareStatus.Draft && canEdit)
                            {
                                <QButton Text="Add Note" Icon="chat-left-text" Size="sm" Variant="ghost" OnClick="@(() => ShowNoteDialog(record))" />
                                <QButton Text="Assign Action" Icon="clipboard2-check" Size="sm" Variant="ghost" OnClick="@(() => ShowActionDialog(record))" />
                            }
                            @if (record.Status != WelfareStatus.Draft && canNotify && student?.Guardians.Any() == true)
                            {
                                <QButton Text="Notify Guardian" Icon="bell-fill" Size="sm" Variant="ghost" OnClick="@(() => ShowNotifyDialog(record))" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ---------------- Create Record ---------------- *@
<QModal @bind-Visible="showCreateDialog" Title="Log Welfare Record" Size="md">
    <ChildContent>
        <div class="form-group">
            <QSelect TValue="WelfareCaseType" TItem="CaseTypeOption" Value="@createModel.CaseType" Items="@caseTypeOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Label="Case Type" Required="true"
                     ValueChanged="@OnCaseTypeChanged" />
        </div>
        <div class="form-group">
            <QSelect TValue="Guid" TItem="WelfareCategoryDto" Value="@createModel.CategoryId" ValueChanged="@OnCategorySelected"
                     Items="@FilteredCategories" TextSelector="@(x => x.Name)" ValueSelector="@(x => x.Id)"
                     Label="Category" Required="true" HasError="@categoryError" ErrorMessage="Select a category" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <QSelect TValue="WelfareTier" TItem="TierOption" @bind-Value="@createModel.Tier" Items="@tierOptions"
                         TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Label="Tier" Required="true" />
            </div>
            <div class="form-group">
                <QInput TValue="int?" @bind-Value="@createModel.Points" Type="number" Label="Points" Placeholder="Optional"
                        HasError="@pointsError" ErrorMessage="@pointsErrorText" />
            </div>
        </div>
        <div class="form-group">
            <div class="form-row">
                <QDatePicker @bind-Value="@occurredDateValue" Label="Date" Required="true" />
                <QDatePicker @bind-Value="@occurredTimeValue" Label="Time" Required="true" ShowTime="true" />
            </div>
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@createModel.Description" Type="textarea" Label="Description" Rows="4"
                    Placeholder="Describe what happened (minimum 10 characters)" MaxLength="2000"
                    HasError="@descriptionError" ErrorMessage="@descriptionErrorText" Required="true" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@createModel.Location" Label="Location" Placeholder="Optional, e.g., Classroom P.6, Playground" />
        </div>

        @* ---- The graduated response. Hidden for an achievement, which is not a response to
               anything, and where a stage would only pollute the reports it exists to enable. ---- *@
        @if (createModel.CaseType != WelfareCaseType.Achievement)
        {
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@createModel.Antecedent" Label="What happened just before"
                        Placeholder="Sent out of maths"
                        MaxLength="500"
                        HelperText="Helps spot patterns later." />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <QSelect TValue="WelfarePerceivedFunction?" TItem="FunctionOption" @bind-Value="@createModel.PerceivedFunction"
                             Items="@functionOptions" TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                             Label="What did it get them" Placeholder="Unclear" AllowClear="true"
                             HelperText="Your read, not a diagnosis." />
                </div>
                @* Not offered on an achievement: the API rejects a stage on one, so showing the
                   field would present a choice the save then refuses. *@
                @if (createModel.CaseType != WelfareCaseType.Achievement)
                {
                    <div class="form-group">
                        <QSelect TValue="WelfareResponseStage?" TItem="StageOption" Value="@createModel.ResponseStage"
                                 ValueChanged="@OnResponseStageChanged"
                                 Items="@stageOptions" TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                                 Label="Response" Placeholder="Not decided yet" AllowClear="true" />
                    </div>
                }
            </div>

            @* The escalation prompt. Guidance, never a barrier — it explains and asks, and the
               save proceeds either way once acknowledged. A member of staff dealing with a real
               emergency must not be argued with by a form. *@
            @if (escalationCheck?.WouldPrompt == true && createModel.ResponseStage == WelfareResponseStage.Punitive)
            {
                <div class="escalation-prompt" role="alert" id="wf-warn-escalation">
                    <div class="ep-head"><strong>Nothing softer tried yet</strong></div>
                    <p>@escalationCheck.Message</p>
                    <QCheckbox @bind-Value="@createModel.EscalationAcknowledged"
                               Label="A sanction is still the right response" />
                </div>
            }
        }

        @if (createModel.CaseType == WelfareCaseType.SupportPlan)
        {
            <div class="plan-note">
                <span>Needs an owner and a review date. Reviews go on as notes.</span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <QSelect TValue="Guid?" TItem="StaffOption" @bind-Value="@createModel.AssignedToUserId"
                             Items="@staffOptions" TextSelector="@(x => x.Name)" ValueSelector="@(x => (Guid?)x.Id)"
                             Label="Owner" Required="true" Placeholder="Who is responsible"
                             HasError="@planOwnerError" ErrorMessage="A support plan needs an owner" />
                </div>
                <div class="form-group">
                    <QDatePicker @bind-Value="@createModel.ActionDueDate" Label="Review on" Required="true"
                                 HasError="@planDateError" ErrorMessage="A support plan needs a review date" />
                </div>
            </div>
        }
        @* Logging one incident against several children means listing the branch's students, which
           is a roster capability, not a welfare one — the same reasoning the API applies when it
           gates branch-wide welfare search above plain welfare.view. Without roster access the
           picker is absent, and says so rather than just not being there. *@
        @if (!canViewRoster)
        {
            <p class="form-hint">Logging this against more than one student needs roster access, which this account doesn't have. The record will be logged for @SubjectName only.</p>
        }
        else if (otherStudents.Any())
        {
            <div class="form-group">
                <label>Also applies to</label>
                <p class="form-hint" style="margin: 0 0 8px;">Check any other students this same incident also involves — it'll appear on their timeline too.</p>
                <div class="linked-student-list">
                    @foreach (var s in otherStudents)
                    {
                        <QCheckbox Value="@createModel.AdditionalStudentIds.Contains(s.Id)" Label="@s.FullName"
                                   ValueChanged="@(v => ToggleLinkedStudent(s.Id, v))" />
                    }
                </div>
            </div>
        }
        @* Each of these carries an id so SaveRecord can scroll it into view when it is what
           blocked the save. A confirmation the user cannot see is a Save button that looks
           broken — see ScrollToBlockerAsync. *@
        @if (lateEntryWarning)
        {
            <div class="warning-banner" id="wf-warn-late">
                <QIcon Name="exclamation-triangle-fill" />
                <span>This date is more than 14 days ago. Confirm this is correct before saving.</span>
                <QCheckbox @bind-Value="@acknowledgeLateEntry" Label="Yes, this is a late entry" />
            </div>
        }
        @if (ungradedWarning)
        {
            <div class="warning-banner" id="wf-warn-ungraded">
                <QIcon Name="exclamation-triangle-fill" />
                <span>
                    No response set, so this record won't count towards
                    &ldquo;What has been tried&rdquo;. You can set it now above, or later from the
                    record's <strong>Set response</strong> action.
                </span>
                <QCheckbox @bind-Value="@acknowledgeUngraded" Label="Save without a response for now" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showCreateDialog = false)" />
        <QButton Text="Save as Draft" Icon="pencil-fill" Variant="ghost" OnClick="@(() => SaveRecord(asDraft: true))" />
        <QButton Text="Save Record" Icon="check-lg" Variant="primary" OnClick="@(() => SaveRecord(asDraft: false))" />
    </FooterContent>
</QModal>

@* ---------------- Attach Evidence (shown right after a record is created) ---------------- *@
<QModal @bind-Visible="showAttachDialog" Title="Attach Evidence (optional)" Size="md">
    <ChildContent>
        <p class="form-hint">Attach a photo, PDF, short video, or audio clip as supporting evidence — an apology letter, an incident photo, a recorded statement, or similar. You can skip this and add it later.</p>
        @if (createdRecordId.HasValue)
        {
            <QFileUpload UploadUrl="@($"api/v1/branches/{branchId}/welfare-records/{createdRecordId}/attachments")"
                         Accept="image/*,application/pdf,video/*,audio/*" Multiple="true" MaxSizeBytes="26214400" HintText="Images, PDF, video, or audio — up to 25MB"
                         OnUploaded="@OnAttachmentUploaded" OnError="@OnAttachmentError" />
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Done" Icon="check-lg" Variant="primary" OnClick="@CloseAttachDialog" />
    </FooterContent>
</QModal>

@* ---------------- Add Note ---------------- *@
<QModal @bind-Visible="showNoteDialog" Title="@(noteKind == WelfareNoteKind.Statement ? "Add Statement" : "Add Note")" Size="md">
    <ChildContent>
        <div class="form-group">
            <label>Type</label>
            <div class="note-kind-tabs">
                <button type="button" class="note-kind-tab @(noteKind == WelfareNoteKind.Note ? "active" : "")" @onclick="@(() => noteKind = WelfareNoteKind.Note)">Follow-up Note</button>
                <button type="button" class="note-kind-tab @(noteKind == WelfareNoteKind.Statement ? "active" : "")" @onclick="@(() => noteKind = WelfareNoteKind.Statement)">Formal Statement</button>
            </div>
        </div>
        @if (noteKind == WelfareNoteKind.Statement)
        {
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@noteAttributedTo" Label="Statement from" Placeholder="e.g., Jane Student, or a witness's name" />
            </div>
        }
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@noteBody" Type="textarea" Label="@(noteKind == WelfareNoteKind.Statement ? "Statement" : "Note")" Rows="4"
                    Placeholder="Minimum 10 characters" MaxLength="2000" Required="true"
                    HasError="@noteError" ErrorMessage="Must be between 10 and 2000 characters" />
        </div>
        @if (noteKind == WelfareNoteKind.Statement)
        {
            <div class="form-group">
                <QCheckbox @bind-Value="@noteIsFinal" Label="Mark as final (no longer a draft account)" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showNoteDialog = false)" />
        <QButton Text="@(noteKind == WelfareNoteKind.Statement ? "Add Statement" : "Add Note")" Icon="check-lg" Variant="primary" OnClick="@SaveNote" />
    </FooterContent>
</QModal>

@* ---------------- Assign Action ---------------- *@
<QModal @bind-Visible="showActionDialog" Title="Assign Follow-up Action" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@actionModel.ActionTaken" Label="Action / Intervention"
                    List="vocab-actions-taken"
                    Placeholder="e.g., Detention, Parental meeting, Restorative conversation" />
            <p class="form-hint">Suggested from the branch's own list — anything else is still accepted.</p>
        </div>
        <div class="form-row">
            <div class="form-group">
                <QSelect TValue="Guid?" TItem="StaffOption" Value="@actionModel.AssignedToUserId" Items="@staffOptions"
                         TextSelector="@(x => x.Name)" ValueSelector="@(x => (Guid?)x.Id)" Label="Assign to" AllowClear="true"
                         ValueChanged="@(v => actionModel.AssignedToUserId = v)" />
            </div>
            <div class="form-group">
                <QDatePicker @bind-Value="@actionDueDateValue" Label="Due date" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showActionDialog = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SaveAction" />
    </FooterContent>
</QModal>

@* ---------------- Grade the response ----------------
   Records logged before 2026-09-06 could never be graded: ResponseStage was settable only on the
   create form, and optional there. Anything saved without one sat outside "What has been tried"
   permanently, which is the one question that panel exists to answer. *@
<QModal @bind-Visible="showResponseDialog" Title="How this record is read" Size="md">
    <ChildContent>
        @if (responseTargetRecord != null)
        {
            <p class="response-dialog-subject">
                <strong>@responseTargetRecord.CategoryName</strong>
                · @QDateFormat.D(responseTargetRecord.OccurredAt.ToLocalTime())
            </p>
        }
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@interpretationAntecedent" Label="What happened just before"
                    Placeholder="e.g., Told to put the phone away" />
            <p class="form-hint">Feeds the &ldquo;share the same trigger&rdquo; pattern insight.</p>
        </div>
        <div class="form-group">
            <QSelect TValue="WelfarePerceivedFunction?" TItem="FunctionOption" @bind-Value="@interpretationFunction"
                     Items="@functionOptions" TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="What did it get them" Placeholder="Unclear" AllowClear="true" />
            <p class="form-hint">Your read, not a diagnosis.</p>
        </div>
        @* Withheld on an achievement, matching the create form and the API's own refusal. An
           existing value is left untouched rather than silently cleared — responseStageValue was
           loaded from the record and is posted back as it stands. *@
        @if (responseTargetRecord?.CaseType != WelfareCaseType.Achievement)
        {
            <div class="form-group">
                <QSelect TValue="WelfareResponseStage?" TItem="StageOption" Value="@responseStageValue"
                         ValueChanged="@(v => responseStageValue = v)"
                         Items="@stageOptions" TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                         Label="Response" Placeholder="Not decided yet" AllowClear="true" />
                <p class="form-hint">
                    This is what feeds the student's &ldquo;What has been tried&rdquo; ladder. Clearing it
                    removes this record from that view.
                </p>
            </div>
        }
        else
        {
            <p class="form-hint">
                An achievement isn't a response to anything, so it carries no response stage and
                doesn't appear in &ldquo;What has been tried&rdquo;.
            </p>
        }
        <p class="form-hint">
            Only how this record is <em>read</em> can be changed. What happened — the account, date,
            category and tier — is part of the ledger and stays as first written.
        </p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showResponseDialog = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SaveResponseStage" />
    </FooterContent>
</QModal>

@* ---------------- Notify Guardian ---------------- *@
<QModal @bind-Visible="showNotifyDialog" Title="Notify Guardian" Size="md">
    <ChildContent>
        <div class="form-group">
            <QSelect TValue="Guid" TItem="StudentGuardianDto" Value="@notifyGuardianId" Items="@(student?.Guardians ?? new())"
                     TextSelector="@(x => $"{x.FullName} ({x.Relationship})")" ValueSelector="@(x => x.Id)"
                     Label="Guardian" Required="true" ValueChanged="@OnNotifyGuardianChanged" />
        </div>
        <div class="form-group">
            <QSelect TValue="string" TItem="string" Value="@notifyChannel" Items="@notifyChannels"
                     Label="Channel" Required="true" ValueChanged="@OnNotifyChannelChanged" />
        </div>
        @if (isLoadingDraft)
        {
            <div class="loading-container"><QSpinner Size="sm" /><span>Preparing message...</span></div>
        }
        else if (notifyDraft != null)
        {
            @if (!notifyDraft.HasContactInfo)
            {
                <div class="warning-banner">
                    <QIcon Name="exclamation-triangle-fill" />
                    <span>@notifyDraft.GuardianName has no @(notifyChannel == "Sms" ? "phone number" : "email address") on file.</span>
                </div>
            }
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@notifyMessage" Type="textarea" Label="Message" Rows="4" MaxLength="500" Required="true" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showNotifyDialog = false)" />
        <QButton Text="Send" Icon="send-fill" Variant="primary" OnClick="@SendNotification"
                 Disabled="@(notifyDraft == null || !notifyDraft.HasContactInfo || string.IsNullOrWhiteSpace(notifyMessage))" />
    </FooterContent>
</QModal>

@* Suggestions for the action field. Rendered here rather than inside the dialog so it survives
   the dialog's open/close, matching how the roster form does it. *@
<datalist id="vocab-actions-taken">
    @foreach (var v in (context?.ActionsTaken ?? new()))
    {
        <option value="@v"></option>
    }
</datalist>

<style>
    /* ---------------- The graduated response ---------------- */

    /* Deliberately not styled as an error. It is a question, and dressing a question as a failure
       teaches staff to click past it. Amber, a signpost icon, and a checkbox that reads like a
       sentence somebody would actually say. */
    .escalation-prompt {
        margin: 4px 0 16px;
        padding: 13px 15px;
        border-radius: var(--qm-radius-md);
        background: rgba(var(--qm-warning-rgb), .1);
        border: 1px solid rgba(var(--qm-warning-rgb), .32);
        animation: epIn .28s ease backwards;
    }

    .escalation-prompt .ep-head {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--qm-accent-orange);
        margin-bottom: 6px;
        font-size: 14px;
    }

    .escalation-prompt p {
        margin: 0 0 10px;
        font-size: 13px;
        line-height: 1.55;
        color: var(--qm-text-secondary);
    }

    /* Slides down as it fades in: it appears in response to choosing "Punitive", and a thing that
       arrives because of what you just did should look like it arrived. */
    /* No max-height in the keyframes: with a `both`/`forwards` fill the final value would stay
       applied and silently clip a longer message. Opacity and a short rise say the same thing and
       leave the box free to size to its content. The fill is `backwards` for the same reason the
       student form's panels use it — a persisted transform, even translateY(0), turns the element
       into a containing block for fixed-position descendants and breaks any dropdown inside it. */
    @@keyframes epIn {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .plan-note {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 4px 0 14px;
        padding: 9px 12px;
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        font-size: 12.5px;
        animation: epIn .24s ease backwards;
    }

    @@media (prefers-reduced-motion: reduce) {
        .escalation-prompt, .plan-note { animation: none !important; }
    }

    .admin-page { padding: 0; }
    .timeline-filter-card { margin-bottom: 16px; }
    .timeline-filter { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; }
    .timeline-filter__actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .points-summary__scope { font-size: 12px; color: var(--qm-text-muted); }

    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px; }
    .header-content { min-width: 0; flex: 1 1 260px; }
    .header-content h1 { overflow-wrap: break-word; }
    .header-content h1 { margin: 0 0 4px; font-size: 26px; color: var(--qm-text-primary); }
    .subtitle { margin: 0; color: var(--qm-text-muted); font-size: 14px; }
    .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    .points-summary { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .points-summary__item { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 999px; }
    .points-summary__item--positive { background: rgba(22, 163, 74, 0.12); color: var(--qm-accent-green, #16a34a); }
    .points-summary__item--negative { background: rgba(220, 38, 38, 0.12); color: var(--qm-danger, #dc2626); }
    .points-summary__item--net { background: var(--qm-bg-secondary); color: var(--qm-text-primary); }

    .loading-container, .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: var(--qm-text-muted); background: var(--qm-bg-card); border-radius: var(--qm-radius-xl); border: 1px solid var(--qm-border); }
    .empty-state .rzi { font-size: 64px; margin-bottom: 16px; color: var(--qm-primary); }
    .empty-state h3 { margin: 0 0 8px; color: var(--qm-text-primary); }
    .empty-state p { margin: 0 0 20px; }

    .timeline { display: flex; flex-direction: column; gap: 4px; }
    .timeline-item { display: flex; gap: 16px; position: relative; padding-bottom: 24px; }
    .timeline-item::before { content: ''; position: absolute; left: 19px; top: 40px; bottom: 0; width: 2px; background: var(--qm-border); }
    .timeline-item:last-child::before { display: none; }

    .timeline-marker { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; z-index: 1; }
    .timeline-marker .rzi { font-size: 18px; }

    .timeline-card { flex: 1; background: var(--qm-bg-card); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-lg); padding: 16px; min-width: 0; }
    .timeline-card-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
    .timeline-card-title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; color: var(--qm-text-primary); }
    .timeline-date { font-size: 12px; color: var(--qm-text-muted); white-space: nowrap; }

    .tier-badge { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; padding: 2px 8px; border-radius: 999px; background: var(--qm-bg-secondary); color: var(--qm-text-muted); }
    .tier-badge--high { background: rgba(220, 38, 38, 0.12); color: var(--qm-danger, #dc2626); }
    .tier-badge--medium { background: rgba(217, 119, 6, 0.12); color: var(--qm-accent-orange, #d97706); }
    .tier-badge--low { background: rgba(22, 163, 74, 0.12); color: var(--qm-accent-green, #16a34a); }

    .points-badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
    .points-badge--positive { background: rgba(22, 163, 74, 0.12); color: var(--qm-accent-green, #16a34a); }
    .points-badge--negative { background: rgba(220, 38, 38, 0.12); color: var(--qm-danger, #dc2626); }

    .confidential-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: rgba(var(--qm-primary-rgb), 0.12); color: var(--qm-primary); }

    /* Restricted has to read as a step ABOVE confidential at a glance, so it takes a solid fill
       rather than the tint. rgba(var(--qm-primary-rgb), …) above is themed already — see the
       CLAUDE.md note on tokenizing a tint so it follows the theme with no override. */
    .restricted-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--qm-primary); color: var(--qm-text-on-primary); }

    .restricted-panel {
        border: 1px solid var(--qm-border);
        border-left: 3px solid var(--qm-primary);
        border-radius: var(--qm-radius-md);
        background: var(--qm-bg-card);
        padding: 14px 16px;
        margin-bottom: 18px;
    }
    .restricted-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
    .restricted-panel-head h3 { margin: 0; font-family: var(--qm-font-display); font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 7px; color: var(--qm-primary); }
    .restricted-panel-meta { font-size: 11.5px; color: var(--qm-text-muted); }
    .restricted-panel textarea { width: 100%; min-height: 84px; resize: vertical; padding: 9px 11px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-sm); background: var(--qm-bg-input); color: var(--qm-text-primary); font-family: var(--qm-font-primary); font-size: 13px; line-height: 1.55; }
    .restricted-panel-body { font-size: 13px; color: var(--qm-text-secondary); line-height: 1.6; white-space: pre-wrap; margin: 0; }
    .restricted-panel-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; }

    /* Shown to the pastoral tier when a note EXISTS but they may not read it. Somebody handling
       the child needs to know an administrator holds something, or they cannot know to ask. */
    .restricted-hint { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--qm-text-muted); padding: 10px 14px; border: 1px dashed var(--qm-border); border-radius: var(--qm-radius-md); margin-bottom: 18px; }

    .timeline-description { margin: 8px 0; color: var(--qm-text-primary); font-size: 14px; line-height: 1.5; }
    .timeline-meta { display: flex; align-items: center; gap: 6px; margin: 4px 0; font-size: 12px; color: var(--qm-text-muted); }

    .attachment-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .attachment-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; padding: 4px 10px; border-radius: var(--qm-radius-md); background: var(--qm-bg-elevated); border: 1px solid var(--qm-border); color: var(--qm-text-secondary); text-decoration: none; }
    .attachment-chip:hover { border-color: var(--qm-primary); color: var(--qm-primary); }

    .note-list { margin-top: 12px; display: flex; flex-direction: column; gap: 8px; }
    .note-item { background: var(--qm-bg-elevated); border-radius: var(--qm-radius-md); padding: 8px 12px; font-size: 13px; }
    .note-author { font-weight: 600; color: var(--qm-text-primary); }
    .note-date { color: var(--qm-text-muted); font-size: 11px; margin-left: 8px; }
    .note-item p { margin: 4px 0 0; color: var(--qm-text-secondary); }

    .notification-list { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
    .notification-item { display: flex; align-items: center; gap: 6px; font-size: 12px; }
    .notification-item--success { color: var(--qm-accent-green, #16a34a); }
    .notification-item--failed { color: var(--qm-danger, #dc2626); }

    /* flex-wrap is the fix for the reported mobile bug: four buttons (Set response, Add Note,
       Assign Action, Notify Guardian) were wider than a phone, and because a flex child will not
       shrink below its content by default, the overflow widened the whole PAGE rather than this
       row — which is why the heading and the chips appeared clipped too. */
    .timeline-card-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--qm-border); }

    .form-group { margin-bottom: 16px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-hint { font-size: 12px; color: var(--qm-text-muted); margin: 0 0 12px; }
    .response-dialog-subject { font-size: 13px; color: var(--qm-text-secondary); margin: 0 0 16px; }
    /* Informational, not a warning — nothing is wrong, this account simply holds welfare access
       without roster access. Muted so it reads as a note rather than an error. */
    .roster-notice { display: flex; align-items: flex-start; gap: 8px; margin: 4px 0 0; font-size: 13px; color: var(--qm-text-muted); max-width: 70ch; }

    .warning-banner { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: rgba(217, 119, 6, 0.1); border: 1px solid rgba(217, 119, 6, 0.3); border-radius: var(--qm-radius-md); padding: 10px 12px; font-size: 13px; color: var(--qm-accent-orange, #d97706); margin-bottom: 16px; }

    .timeline-card--draft { border-style: dashed; opacity: 0.85; }

    .status-badge { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; padding: 2px 8px; border-radius: 999px; background: var(--qm-bg-secondary); color: var(--qm-text-muted); }
    .status-badge--draft { background: rgba(var(--qm-primary-rgb), 0.12); color: var(--qm-primary); }
    .status-badge--open { background: rgba(47, 90, 84, 0.12); color: var(--qm-welfare-concern, #2f5a54); }
    .status-badge--underreview { background: rgba(217, 119, 6, 0.12); color: var(--qm-accent-orange, #d97706); }
    .status-badge--actiontaken { background: rgba(var(--qm-primary-rgb), 0.12); color: var(--qm-primary); }
    .status-badge--resolved { background: rgba(22, 163, 74, 0.12); color: var(--qm-accent-green, #16a34a); }
    .status-select { display: inline-block; width: auto; min-width: 140px; }

    .action-box { display: flex; align-items: flex-start; gap: 10px; margin-top: 10px; padding: 10px 12px; border-radius: var(--qm-radius-md); background: var(--qm-bg-elevated); border: 1px solid var(--qm-border); font-size: 13px; }
    .action-box-title { display: block; font-weight: 600; color: var(--qm-text-primary); }
    .action-box-meta { display: block; color: var(--qm-text-muted); font-size: 12px; margin-top: 2px; }
    .overdue-tag { display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 999px; background: rgba(220, 38, 38, 0.12); color: var(--qm-danger, #dc2626); font-weight: 700; font-size: 10px; text-transform: uppercase; }

    .linked-student-list { display: flex; flex-direction: column; gap: 6px; max-height: 160px; overflow-y: auto; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 10px 12px; background: var(--qm-bg-elevated); }

    .note-kind-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .note-kind-tab { padding: 10px 8px; border-radius: var(--qm-radius-md); border: 1px solid var(--qm-border); background: var(--qm-bg-elevated); color: var(--qm-text-secondary); font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.15s ease; }
    .note-kind-tab.active { background: var(--qm-primary); border-color: var(--qm-primary); color: #fff; }

    .note-item--statement { border-left: 3px solid var(--qm-primary); }
    .statement-tag { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--qm-primary); margin-bottom: 4px; }
    .note-recorded-by { color: var(--qm-text-muted); font-size: 11px; margin-left: 6px; font-style: italic; }

    @@media (max-width: 700px) {
        .form-row { grid-template-columns: 1fr; }
        .timeline-item { gap: 10px; }
        .timeline-marker { width: 32px; height: 32px; }
    }
</style>

@code {
    [Parameter] public Guid StudentId { get; set; }

    private Guid branchId;
    private StudentDto? student;
    private bool isLoading = true;
    private bool canCreate, canEdit, canNotify, canViewRoster, isExporting;

    /// <summary>welfare.restricted.view — gates the visibility control and the restricted-notes panel. Cosmetic only; the API re-checks both.</summary>
    private bool canSetRestricted;
    private List<WelfareRecordDto> records = new();

    /// <summary>
    /// The period the timeline covers. All time by default — see the filter card above.
    /// </summary>
    private DateRange range = DateRange.AllTime();
    private List<WelfareCategoryDto> categories = new();
    private List<StudentDto> otherStudents = new();
    private List<StaffOption> staffOptions = new();

    /// <summary>Welfare-tier facts about the subject. Present on welfare.view alone; `student`
    /// above is the roster-tier record and is null without students.view.</summary>
    private WelfareTimelineContextDto? context;

    /// <summary>Name to show in the header. The welfare-tier context first, because it is the one
    /// that survives without roster access.</summary>
    private string SubjectName => context?.FullName ?? student?.FullName ?? "Student";

    private IEnumerable<WelfareCategoryDto> FilteredCategories => categories.Where(c => c.CaseType == createModel.CaseType);

    // Drafts are excluded — an unfinished quick-log shouldn't count toward a total until its
    // author finalizes it (same reasoning FinalizeRecord already applies to validation).
    private IEnumerable<WelfareRecordDto> FinalizedRecords => records.Where(r => r.Status != WelfareStatus.Draft);
    private int AchievementPoints => FinalizedRecords.Where(r => r.Points > 0).Sum(r => r.Points ?? 0);
    private int BehaviorPoints => FinalizedRecords.Where(r => r.Points < 0).Sum(r => r.Points ?? 0);
    private int NetPoints => AchievementPoints + BehaviorPoints;

    private readonly List<StageOption> stageOptions = new()
    {
        new(WelfareResponseStage.Preventive, "Preventive — acted before it happened"),
        new(WelfareResponseStage.Restorative, "Restorative — a conversation, an apology"),
        new(WelfareResponseStage.Corrective, "Corrective — a plan with an owner"),
        new(WelfareResponseStage.Punitive, "Punitive — a sanction"),
        new(WelfareResponseStage.Referral, "Referral — passed outside the school")
    };

    private readonly List<FunctionOption> functionOptions = new()
    {
        new(WelfarePerceivedFunction.Escape, "Getting out of something"),
        new(WelfarePerceivedFunction.Attention, "Attention"),
        new(WelfarePerceivedFunction.Tangible, "Access to a thing"),
        new(WelfarePerceivedFunction.Sensory, "Sensory — noise, hunger, exhaustion"),
        new(WelfarePerceivedFunction.Unclear, "Unclear")
    };

    private EscalationCheckDto? escalationCheck;
    private bool planOwnerError;
    private bool planDateError;

    /// <summary>
    /// Loads "what was tried before this?" the moment somebody selects a punitive response, so the
    /// prompt is there before they finish rather than after they press Save. Failure is silent on
    /// purpose: the check is guidance, and a page that refuses to save a record because an advisory
    /// lookup failed would be worse than no prompt at all.
    /// </summary>
    private async Task OnResponseStageChanged(WelfareResponseStage? stage)
    {
        createModel.ResponseStage = stage;
        createModel.EscalationAcknowledged = false;

        if (stage != WelfareResponseStage.Punitive)
        {
            escalationCheck = null;
            return;
        }

        try
        {
            escalationCheck = await Http.GetFromJsonAsync<EscalationCheckDto>(
                $"api/v1/branches/{branchId}/students/{StudentId}/escalation-check", JsonOptions);
        }
        catch
        {
            escalationCheck = null;
        }
    }

    private readonly List<CaseTypeOption> caseTypeOptions = new()
    {
        new(WelfareCaseType.Achievement, "Achievement"),
        new(WelfareCaseType.Behavior, "Behavior"),
        new(WelfareCaseType.Welfare, "Welfare / Safeguarding"),
        new(WelfareCaseType.SupportPlan, "Support plan")
    };

    private readonly List<TierOption> tierOptions = new()
    {
        new(WelfareTier.Low, "Low"),
        new(WelfareTier.Medium, "Medium"),
        new(WelfareTier.High, "High")
    };

    private readonly List<StatusOption> workflowStatusOptions = new()
    {
        new(WelfareStatus.Open, "Open"),
        new(WelfareStatus.UnderReview, "Under Review"),
        new(WelfareStatus.ActionTaken, "Action Taken"),
        new(WelfareStatus.Resolved, "Resolved")
    };

    /// <summary>
    /// The visibility ladder, offered only to a holder of welfare.restricted.view. A Welfare
    /// (safeguarding) record cannot be lowered to Standard at all — the API refuses it, and the
    /// error is shown rather than the option being hidden, because "why is this greyed out" is a
    /// worse experience than being told the rule.
    /// </summary>
    private readonly List<VisibilityOption> visibilityOptions = new()
    {
        new(WelfareVisibility.Standard, "Standard"),
        new(WelfareVisibility.Confidential, "Confidential"),
        new(WelfareVisibility.Restricted, "Restricted - admin only")
    };

    private readonly string[] notifyChannels = { "Sms", "Email" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Scroll to whatever blocked the last save, now that the banner it refers to has actually
        // been rendered. This CANNOT be done inline in SaveRecord: StateHasChanged() only marks
        // the component for re-render, it does not await one, so a JS call made straight after it
        // runs against a DOM that does not contain the banner yet — getElementById returns null
        // and the scroll silently does nothing. That was the original bug's second layer, found
        // by watching scrollTop stay at 0 with the element demonstrably present a moment later.
        if (_pendingScrollTo is { } pendingId)
        {
            _pendingScrollTo = null;
            await ScrollToBlockerAsync(pendingId);
        }

        if (firstRender)
        {
            if (!await PermissionService.HasPermissionAsync(Permissions.WelfareView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            await ModuleState.LoadAsync(ModuleApi);
            if (!ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
            {
                Navigation.NavigateTo("/billing/modules", forceLoad: false);
                return;
            }

            canCreate = await PermissionService.HasPermissionAsync(Permissions.WelfareCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permissions.WelfareEdit);
            canNotify = await PermissionService.HasPermissionAsync(Permissions.WelfareNotify);
            canSetRestricted = await PermissionService.HasPermissionAsync(Permissions.WelfareRestrictedView);
            // Roster access, which this page can now do without. It gates the three things that
            // genuinely need the roster: the guardian list (to notify one), the branch's other
            // students (to log one incident against several), and the SAR export — whose endpoint
            // requires students.view AND welfare.view, welfare.view already being established by
            // the gate above.
            canViewRoster = await PermissionService.HasPermissionAsync(Permissions.StudentsView);

            await BranchState.InitializeAsync();
            branchId = BranchState.CurrentBranchId;

            // A SuperAdmin arrives here with no organization chosen, so CurrentBranchId is empty and
            // every branch-scoped request on this page 404s -- most visibly the Category list, which
            // left the create form with an empty dropdown and no explanation. Picking an
            // organization and a branch raises OnBranchChanged; without this subscription nothing
            // re-read it and only a full page reload fixed the form.
            BranchState.OnBranchChanged += HandleBranchChanged;

            await LoadData();
            StateHasChanged();
        }
    }

    private async void HandleBranchChanged()
    {
        await InvokeAsync(async () =>
        {
            var next = BranchState.CurrentBranchId;
            if (next == branchId) return;

            branchId = next;
            if (branchId == Guid.Empty) return;

            // staffOptions is loaded once and guarded by `!staffOptions.Any()`, so it would keep the
            // previous branch's staff on the assignment picker. Cleared here so LoadData refetches.
            staffOptions.Clear();
            await LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        BranchState.OnBranchChanged -= HandleBranchChanged;
    }

    private async Task OnRangeChanged(DateRange next)
    {
        range = next;
        await LoadData();
    }

    /// <summary>
    /// Opens the A4 report on its own route, carrying the period in the query string so the link
    /// is shareable and the printed sheet states the same period the screen was showing.
    /// </summary>
    private void OpenPrintableReport()
    {
        var query = range.IsAllTime
            ? ""
            : $"?from={QDateFormat.Iso8601(range.From)}&to={QDateFormat.Iso8601(range.To)}";
        Navigation.NavigateTo($"/admin/students/{StudentId}/welfare/report{query}");
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Who the page is about, and the intervention suggestions — from the welfare-scoped
            // endpoint, so this much works on welfare.view alone. It used to come from the roster,
            // which meant a caller without students.view got a timeline with no name on it while
            // the records below it carried that same name on every row.
            var contextResponse = await Http.GetAsync($"api/v1/branches/{branchId}/students/{StudentId}/welfare-context");
            if (contextResponse.IsSuccessStatusCode)
                context = await contextResponse.Content.ReadFromJsonAsync<WelfareTimelineContextDto>(JsonOptions);

            // The roster tier: guardians (to notify one) and the branch's other students (to log
            // one incident against several). Both are students.view, both are genuinely roster
            // capabilities, and neither is required to read a timeline — so a caller without it
            // loses those two actions and keeps the page. canViewRoster is what the UI checks
            // before explaining the absence, rather than silently hiding a feature.
            if (canViewRoster)
            {
                var allStudents = await StudentApi.GetStudentsAsync(branchId, includeInactive: true);
                student = allStudents.FirstOrDefault(s => s.Id == StudentId);
                otherStudents = allStudents.Where(s => s.Id != StudentId && s.IsActive).ToList();
            }

            // Its own gated request, not read off the student payload above — see the comment on
            // LoadRestrictedNotesAsync.
            await LoadRestrictedNotesAsync();

            var categoriesResponse = await Http.GetAsync($"api/v1/branches/{branchId}/welfare/categories");
            if (categoriesResponse.IsSuccessStatusCode)
                categories = await categoriesResponse.Content.ReadFromJsonAsync<List<WelfareCategoryDto>>(JsonOptions) ?? new();

            if (canEdit && !staffOptions.Any())
            {
                var usersResponse = await Http.GetAsync($"api/v1/users?branchId={branchId}");
                if (usersResponse.IsSuccessStatusCode)
                {
                    var users = await usersResponse.Content.ReadFromJsonAsync<List<StaffApiUser>>(JsonOptions) ?? new();
                    staffOptions = users.Where(u => u.IsActive).Select(u => new StaffOption(u.Id, u.FullName)).ToList();
                }
            }

            // All time sends no bounds at all rather than a year-2000 lower bound, so the common
            // case stays the exact query it was before this filter existed.
            var rangeQuery = range.IsAllTime
                ? ""
                : $"?from={QDateFormat.Iso8601(range.From)}&to={QDateFormat.Iso8601(range.To)}";
            var recordsResponse = await Http.GetAsync($"api/v1/branches/{branchId}/students/{StudentId}/welfare-records{rangeQuery}");
            if (recordsResponse.IsSuccessStatusCode)
            {
                records = await recordsResponse.Content.ReadFromJsonAsync<List<WelfareRecordDto>>(JsonOptions) ?? new();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(recordsResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load timeline: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // ---------------- Create Record ----------------

    private bool showCreateDialog;
    private CreateWelfareRecordRequest createModel = new();
    // Split into separate date/time fields rather than one QDatePicker with ShowTime=true - that
    // parameter *replaces* the date input with a time-only one (see the component's own doc
    // comment), so a single field can never let staff pick both a past date and a specific time,
    // which a welfare record genuinely needs (e.g. logging something noticed a few days late).
    private DateTime? occurredDateValue = DateTime.Today;
    private DateTime? occurredTimeValue = DateTime.Now;
    private bool categoryError, pointsError, descriptionError, lateEntryWarning, acknowledgeLateEntry;
    private bool ungradedWarning, acknowledgeUngraded;
    private string pointsErrorText = "", descriptionErrorText = "";

    private bool showAttachDialog;
    private Guid? createdRecordId;

    private void ShowCreateDialog()
    {
        createModel = new CreateWelfareRecordRequest { StudentId = StudentId, CaseType = WelfareCaseType.Achievement, Tier = WelfareTier.Low };
        occurredDateValue = DateTime.Today;
        occurredTimeValue = DateTime.Now;
        categoryError = pointsError = descriptionError = lateEntryWarning = acknowledgeLateEntry = false;
        ungradedWarning = acknowledgeUngraded = false;
        showCreateDialog = true;
    }

    private void OnCaseTypeChanged(WelfareCaseType caseType)
    {
        createModel.CaseType = caseType;
        createModel.CategoryId = Guid.Empty;

        // Switching to Achievement after picking a response would post a combination the API
        // refuses, and the field it came from is no longer on screen to correct it.
        if (caseType == WelfareCaseType.Achievement)
        {
            createModel.ResponseStage = null;
            createModel.EscalationAcknowledged = false;
        }
    }

    private void OnCategorySelected(Guid categoryId)
    {
        createModel.CategoryId = categoryId;
        var category = categories.FirstOrDefault(c => c.Id == categoryId);
        if (category != null)
        {
            createModel.Tier = category.DefaultTier;
            createModel.Points = category.DefaultPoints;
        }
    }

    private void ToggleLinkedStudent(Guid studentId, bool linked)
    {
        if (linked && !createModel.AdditionalStudentIds.Contains(studentId))
            createModel.AdditionalStudentIds.Add(studentId);
        else
            createModel.AdditionalStudentIds.Remove(studentId);
    }

    /// <summary>
    /// The id of a banner to scroll to on the next render, or null. Set by SaveRecord when it
    /// refuses, consumed by OnAfterRenderAsync — see the comment there for why the scroll cannot
    /// simply follow StateHasChanged().
    /// </summary>
    private string? _pendingScrollTo;

    /// <summary>
    /// Brings the thing that blocked the save into view.
    ///
    /// The welfare log form refuses to save until a confirmation checkbox is ticked, and those
    /// confirmations sit at the BOTTOM of a scrollable dialog. Before this, pressing Save with an
    /// unticked box fired a toast saying "tick the box" while the box was off-screen — so the
    /// button read as simply not working, which is exactly what the live e2e reported.
    ///
    /// Never throws: a form must not fail to save because a cosmetic scroll failed. If the JS
    /// helper is missing (an old cached layout.js) the toast still explains what to do.
    /// </summary>
    private async Task ScrollToBlockerAsync(string elementId)
    {
        try
        {
            await JS.InvokeVoidAsync("qmgrLayout.scrollIntoView", elementId);
        }
        catch
        {
            // Swallowed deliberately and with no logger dependency: the scroll is a courtesy, the
            // toast is the actual message, and neither is worth failing a save over.
        }
    }

    private async Task SaveRecord(bool asDraft)
    {
        categoryError = createModel.CategoryId == Guid.Empty;
        var description = (createModel.Description ?? "").Trim();
        // A draft is allowed to be short/unfinished — the server mirrors this same exemption
        // (see CreateRecord's SaveAsDraft handling) so client and server never disagree about
        // what's valid to save as a draft vs. a finished record.
        descriptionError = !asDraft && (description.Length < 10 || description.Length > 2000);
        descriptionErrorText = description.Length < 10 ? "Description must be at least 10 characters" : "Description must be under 2000 characters";

        pointsError = false;
        pointsErrorText = "";
        if (createModel.Points.HasValue)
        {
            var points = createModel.Points.Value;
            if (createModel.CaseType == WelfareCaseType.Achievement && points < 0) { pointsError = true; pointsErrorText = "Achievement points cannot be negative"; }
            else if (createModel.CaseType == WelfareCaseType.Behavior && points > 0) { pointsError = true; pointsErrorText = "Behavior points cannot be positive"; }
            else if (createModel.CaseType == WelfareCaseType.Welfare && points != 0) { pointsError = true; pointsErrorText = "Welfare records cannot carry points"; }
            else if (Math.Abs(points) > 100) { pointsError = true; pointsErrorText = "Points cannot exceed 100 in magnitude"; }
        }

        var occurredAt = (occurredDateValue ?? DateTime.Today).Date.Add((occurredTimeValue ?? DateTime.Now).TimeOfDay);
        lateEntryWarning = !asDraft && occurredAt < DateTime.Now.AddDays(-14) && !acknowledgeLateEntry;

        // A support plan is the corrective rung, and a plan with no owner and no review date is a
        // sentence in a text box nobody comes back to. Mirrors the server's own two checks.
        planOwnerError = !asDraft && createModel.CaseType == WelfareCaseType.SupportPlan
                         && (createModel.AssignedToUserId is null || createModel.AssignedToUserId == Guid.Empty);
        planDateError = !asDraft && createModel.CaseType == WelfareCaseType.SupportPlan
                        && createModel.ActionDueDate is null;

        // The late-entry banner is a CONFIRMATION, not a field error, and it is rendered at the
        // bottom of the dialog — so it needs the same scroll-to treatment as the ungraded one
        // below rather than being lumped in with "fix the highlighted fields", which points at
        // nothing the user can see.
        if (lateEntryWarning)
        {
            _pendingScrollTo = "wf-warn-late";
            NotificationService.Notify(ToastSeverity.Warning, "This looks like a late entry",
                "Confirm the date is right — there's a checkbox at the bottom of the form.");
            return;
        }

        if (categoryError || descriptionError || pointsError || planOwnerError || planDateError)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please fix the highlighted fields");
            return;
        }

        // The escalation prompt asks, it never blocks — so this is the one check that stops at a
        // reminder rather than a refusal, and a second press with the box ticked always goes
        // through. Staff dealing with a real emergency must not be argued with by a form.
        if (!asDraft && createModel.ResponseStage == WelfareResponseStage.Punitive
            && escalationCheck?.WouldPrompt == true && !createModel.EscalationAcknowledged)
        {
            _pendingScrollTo = "wf-warn-escalation";
            NotificationService.Notify(ToastSeverity.Warning, "Nothing softer has been tried",
                "Tick the box to confirm a punishment is still the right response.");
            return;
        }

        // Same shape as the escalation prompt above: asks once, never refuses. Saving without a
        // response used to be completely silent, and the record then sat outside the student's
        // "What has been tried" ladder for good — there was no way to grade it afterwards, and
        // nothing on the form said so. Now there is a way (the Set response action on each card),
        // so this is a nudge rather than a last chance; "Not decided yet" stays a legitimate
        // answer for staff logging an incident before anyone has decided what to do about it.
        // NOT on an achievement. The API refuses a response stage on one outright ("An achievement
        // has no response stage" — WelfareController), so nagging for one here asked the user to
        // set a field they are forbidden to set, and the only way past it was the confirmation box.
        ungradedWarning = !asDraft
            && createModel.CaseType != WelfareCaseType.Achievement
            && createModel.ResponseStage == null
            && !acknowledgeUngraded;
        if (ungradedWarning)
        {
            // Setting ungradedWarning above is what RENDERS the banner, so the scroll has to wait
            // for that render — hence the deferred flag rather than an inline JS call.
            _pendingScrollTo = "wf-warn-ungraded";

            NotificationService.Notify(ToastSeverity.Warning, "No response recorded",
                "This record won't appear in \"What has been tried\". Set one above, or tick the confirmation now shown at the bottom of the form.");
            return;
        }

        try
        {
            createModel.Description = description;
            createModel.OccurredAt = occurredAt;
            createModel.SaveAsDraft = asDraft;

            var url = $"api/v1/branches/{branchId}/welfare-records";
            if (acknowledgeLateEntry) url += "?acknowledgeLateEntry=true";

            var response = await Http.PostAsJsonAsync(url, createModel, JsonOptions);
            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<WelfareRecordDto>(JsonOptions);
                NotificationService.Notify(ToastSeverity.Success, "Success", asDraft ? "Draft saved — finalize it from the timeline when ready" : "Record logged");
                showCreateDialog = false;
                await LoadData();

                if (created != null)
                {
                    createdRecordId = created.Id;
                    showAttachDialog = true;
                }
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save record: {ex.Message}");
        }
    }

    private Task OnAttachmentUploaded(QFileUpload.UploadedFileResult result)
