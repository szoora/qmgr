        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save: {ex.Message}");
        }
    }

    // ---------------- Grade the response ----------------

    private bool showResponseDialog;
    private WelfareRecordDto? responseTargetRecord;
    private WelfareResponseStage? responseStageValue;
    private string? interpretationAntecedent;
    private WelfarePerceivedFunction? interpretationFunction;

    private void ShowResponseDialog(WelfareRecordDto record)
    {
        responseTargetRecord = record;
        // Pre-filled from the record because the PATCH is a full replace of all three: posting a
        // blank field back must mean "clear it", which is only safe if the user was shown what is
        // there now.
        responseStageValue = record.ResponseStage;
        interpretationAntecedent = record.Antecedent;
        interpretationFunction = record.PerceivedFunction;
        showResponseDialog = true;
    }

    private async Task SaveResponseStage()
    {
        if (responseTargetRecord == null) return;

        // Nothing to send. Closing quietly beats a success toast for a save that did not happen.
        var antecedent = string.IsNullOrWhiteSpace(interpretationAntecedent) ? null : interpretationAntecedent.Trim();
        if (responseStageValue == responseTargetRecord.ResponseStage
            && interpretationFunction == responseTargetRecord.PerceivedFunction
            && antecedent == responseTargetRecord.Antecedent)
        {
            showResponseDialog = false;
            return;
        }

        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/v1/branches/{branchId}/welfare-records/{responseTargetRecord.Id}/interpretation",
                new UpdateWelfareInterpretationRequest
                {
                    ResponseStage = responseStageValue,
                    Antecedent = antecedent,
                    PerceivedFunction = interpretationFunction
                }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                showResponseDialog = false;
                NotificationService.Notify(ToastSeverity.Success, "Saved",
                    responseStageValue == null
                        ? "Interpretation updated."
                        : $"Response recorded as {responseStageValue}.");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save the interpretation: {ex.Message}");
        }
    }

    // ---------------- Status, Finalize, Action Assignment ----------------

    // ── Restricted student note ─────────────────────────────────────────────────────────────
    // Administrator only (welfare.restricted.view). Fetched from its own endpoint rather than
    // read off the student payload, so an access to genuinely restricted content is a distinct
    // request in the logs rather than a side effect of opening the page.

    private string? restrictedNotes;
    private string restrictedDraft = string.Empty;
    private string? restrictedUpdatedBy;
    private DateTime? restrictedUpdatedAt;
    private bool restrictedEditing;
    private bool restrictedSaving;

    /// <summary>True when a note exists but this caller may not read it — shown to the pastoral tier.</summary>
    private bool HasRestrictedButCannotRead => !canSetRestricted && (student?.HasRestrictedNotes ?? false);

    private RenderFragment RenderRestrictedNotes() => @<text>
        @if (canSetRestricted)
        {
            <div class="restricted-panel">
                <div class="restricted-panel-head">
                    <h3><QIcon Name="shield-lock-fill" /> Restricted notes — administrators only</h3>
                    @if (!restrictedEditing)
                    {
                        <QButton Text="@(string.IsNullOrWhiteSpace(restrictedNotes) ? "Add" : "Edit")" Icon="pencil" Variant="ghost" Size="sm"
                                 OnClick="@(() => { restrictedDraft = restrictedNotes ?? string.Empty; restrictedEditing = true; })" />
                    }
                </div>

                @if (restrictedEditing)
                {
                    <textarea @bind="restrictedDraft" maxlength="4000"
                              placeholder="Something staff must not see. Leave empty to clear the note."></textarea>
                    <div class="restricted-panel-actions">
                        <QButton Text="Cancel" Variant="ghost" Size="sm" OnClick="@(() => restrictedEditing = false)" />
                        <QButton Text="Save" Icon="check-lg" Variant="primary" Size="sm" OnClick="@SaveRestrictedNotes" Disabled="@restrictedSaving" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(restrictedNotes))
                {
                    <p class="restricted-panel-body">@restrictedNotes</p>
                    <div class="restricted-panel-meta">
                        Last updated @QDateFormat.DT(restrictedUpdatedAt?.ToLocalTime())
                        @(string.IsNullOrWhiteSpace(restrictedUpdatedBy) ? "" : $" by {restrictedUpdatedBy}")
                    </div>
                }
                else
                {
                    <p class="restricted-panel-body"><em>No restricted notes for this student.</em></p>
                }
            </div>
        }
        else if (HasRestrictedButCannotRead)
        {
            <div class="restricted-hint">
                <QIcon Name="shield-lock" />
                <span>An administrator holds restricted information about this student. Ask them if you need it.</span>
            </div>
        }
    </text>;

    private async Task LoadRestrictedNotesAsync()
    {
        if (!canSetRestricted) return;
        try
        {
            var dto = await Http.GetFromJsonAsync<StudentDto>(
                $"api/v1/branches/{branchId}/students/{StudentId}/restricted-notes", JsonOptions);
            restrictedNotes = dto?.RestrictedNotes;
            restrictedUpdatedAt = dto?.RestrictedNotesUpdatedAt;
            restrictedUpdatedBy = dto?.RestrictedNotesUpdatedByName;
        }
        catch
        {
            // Not fatal to the page. The panel simply shows "no restricted notes" rather than the
            // whole timeline failing because one gated read did.
            restrictedNotes = null;
        }
    }

    private async Task SaveRestrictedNotes()
    {
        restrictedSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/v1/branches/{branchId}/students/{StudentId}/restricted-notes",
                new UpdateStudentRestrictedNotesRequest { Notes = restrictedDraft }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Saved",
                    string.IsNullOrWhiteSpace(restrictedDraft) ? "Restricted note cleared." : "Restricted note saved.");
                restrictedEditing = false;
                await LoadRestrictedNotesAsync();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save: {ex.Message}");
        }
        finally
        {
            restrictedSaving = false;
        }
    }

    /// <summary>
    /// Moves a record between visibility rungs. Lowering widens who can read it, so the API
    /// demands a reason — collected here rather than silently sending an empty one, which would
    /// just bounce back as a 400 the user could not act on.
    /// </summary>
    private async Task ChangeVisibility(WelfareRecordDto record, WelfareVisibility next)
    {
        if (next == record.Visibility) return;

        string? reason = null;
        if (next < record.Visibility)
        {
            reason = await JS.InvokeAsync<string?>("prompt",
                $"Lowering this record from {record.Visibility} to {next} lets more people read it.\n\nWhy?");
            // Cancelled, or an empty reason — do nothing rather than send a request that will fail.
            if (string.IsNullOrWhiteSpace(reason))
            {
                await LoadData(); // put the select back where it was
                return;
            }
        }

        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/v1/branches/{branchId}/welfare-records/{record.Id}/visibility",
                new UpdateWelfareVisibilityRequest { Visibility = next, Reason = reason }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Visibility changed",
                    next == WelfareVisibility.Restricted
                        ? "This record is now visible to administrators only."
                        : $"This record is now {next}.");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to change visibility: {ex.Message}");
        }
    }

    private async Task ChangeStatus(WelfareRecordDto record, WelfareStatus newStatus)
    {
        if (newStatus == record.Status) return;
        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/v1/branches/{branchId}/welfare-records/{record.Id}/status",
                new UpdateWelfareStatusRequest { Status = newStatus }, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", $"Status changed to {newStatus}");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to change status: {ex.Message}");
        }
    }

    private async Task FinalizeRecord(WelfareRecordDto record)
    {
        try
        {
            var response = await Http.PostAsync($"api/v1/branches/{branchId}/welfare-records/{record.Id}/finalize", null);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Draft finalized");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to finalize: {ex.Message}");
        }
    }

    private bool showActionDialog;
    private WelfareRecordDto? actionTargetRecord;
    private UpdateWelfareActionRequest actionModel = new();
    private DateTime? actionDueDateValue;

    private void ShowActionDialog(WelfareRecordDto record)
    {
        actionTargetRecord = record;
        actionModel = new UpdateWelfareActionRequest
        {
            ActionTaken = record.ActionTaken,
            AssignedToUserId = record.AssignedToUserId,
            ActionDueDate = record.ActionDueDate
        };
        actionDueDateValue = record.ActionDueDate?.ToLocalTime();
        showActionDialog = true;
    }

    private async Task SaveAction()
    {
        if (actionTargetRecord == null) return;
        try
        {
            actionModel.ActionDueDate = actionDueDateValue;
            var response = await Http.PatchAsJsonAsync(
                $"api/v1/branches/{branchId}/welfare-records/{actionTargetRecord.Id}/action",
                actionModel, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Action updated");
                showActionDialog = false;
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update action: {ex.Message}");
        }
    }

    // ---------------- Notify Guardian ----------------

    private bool showNotifyDialog, isLoadingDraft;
    private WelfareRecordDto? notifyTargetRecord;
    private Guid notifyGuardianId;
    private string notifyChannel = "Sms";
    private string notifyMessage = "";
    private WelfareNotificationDraftDto? notifyDraft;

    private void ShowNotifyDialog(WelfareRecordDto record)
    {
        notifyTargetRecord = record;
        notifyGuardianId = student?.Guardians.FirstOrDefault()?.Id ?? Guid.Empty;
        notifyChannel = "Sms";
        notifyDraft = null;
        notifyMessage = "";
        showNotifyDialog = true;
        _ = LoadNotifyDraft();
    }

    private void OnNotifyGuardianChanged(Guid guardianId)
    {
        notifyGuardianId = guardianId;
        _ = LoadNotifyDraft();
    }

    private void OnNotifyChannelChanged(string channel)
    {
        notifyChannel = channel;
        _ = LoadNotifyDraft();
    }

    private async Task LoadNotifyDraft()
    {
        if (notifyTargetRecord == null || notifyGuardianId == Guid.Empty) return;

        isLoadingDraft = true;
        notifyDraft = null;
        try
        {
            var response = await Http.GetAsync(
                $"api/v1/branches/{branchId}/welfare-records/{notifyTargetRecord.Id}/notify-draft?guardianLinkId={notifyGuardianId}&channel={notifyChannel}");
            if (response.IsSuccessStatusCode)
            {
                notifyDraft = await response.Content.ReadFromJsonAsync<WelfareNotificationDraftDto>(JsonOptions);
                notifyMessage = notifyDraft?.SuggestedMessage ?? "";
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        finally
        {
            isLoadingDraft = false;
            // Called fire-and-forget (`_ = LoadNotifyDraft()`) from ShowNotifyDialog/the guardian
            // and channel change handlers, so there's no awaited call chain back to an event handler
            // for Blazor to auto-render after - without this, the dialog was found live to freeze on
            // "Preparing message..." forever even though the API call had already succeeded (200 in
            // the server log) and notifyDraft/isLoadingDraft were both updated correctly in memory.
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendNotification()
    {
        if (notifyTargetRecord == null) return;

        try
        {
            var response = await Http.PostAsJsonAsync(
                $"api/v1/branches/{branchId}/welfare-records/{notifyTargetRecord.Id}/notify",
                new SendWelfareNotificationRequest { GuardianLinkId = notifyGuardianId, Channel = notifyChannel, Message = notifyMessage },
                JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Sent", "Guardian notification sent");
                showNotifyDialog = false;
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to send notification: {ex.Message}");
        }
    }

    // ---------------- Subject-access-request export ----------------

    /// <summary>
    /// Downloads the API's SAR document (GET .../students/{id}/data-export) via the same
    /// downloadDataUrl helper the CSV exports use — the bytes come back through the
    /// authenticated HttpClient, so a plain &lt;a href&gt; to the API (no auth header) wouldn't work.
    /// </summary>
    private async Task ExportStudentData()
    {
        isExporting = true;
        try
        {
            var file = await StudentApi.ExportStudentDataAsync(branchId, StudentId);
            if (file == null)
            {
                NotificationService.Notify(ToastSeverity.Error, "Export failed", "Couldn't build the data export — check you have both roster and welfare view access.");
                return;
            }
            var dataUrl = "data:application/json;base64," + Convert.ToBase64String(file.Content);
            await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, file.FileName);
            NotificationService.Notify(ToastSeverity.Success, "Export ready", $"{file.FileName} downloaded");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Export failed", ex.Message);
        }
        finally
        {
            isExporting = false;
        }
    }

