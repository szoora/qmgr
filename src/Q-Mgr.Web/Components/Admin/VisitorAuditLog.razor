@page "/admin/visitors/audit"
@inject IVisitorApiService VisitorApi
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@using QMgr.Application.DTOs
@using QMgr.Web.Components.Shared.UI

<QPageTitle Text="Visitor Deletion Audit" />

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Visitor Deletion Audit</h1>
            <p class="subtitle">Every deleted visit record for this branch — the records themselves were never actually removed, only hidden from the active log</p>
        </div>
        <div class="header-actions">
            <QButton Text="Back to Visitors" Icon="arrow-left" Variant="ghost" OnClick="@(() => Navigation.NavigateTo("/admin/visitors"))" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading audit log...</span>
        </div>
    }
    else if (!entries.Any())
    {
        <QEmptyState Icon="clock-history" Title="No deletions yet" Text="No visitor record has been deleted for this branch." />
    }
    else
    {
        @* Search and paging, no selection: an audit log is READ-ONLY by construction, so there is
           nothing a selection could be applied to. A bulk bar with a tick box and no action is
           worse than none. *@
        <QBulkBar Search="@search" SearchChanged="@SetSearch" ShowSelection="false"
                  SearchPlaceholder="Search by visitor, badge, reason or who deleted it" />

        @if (Visible.Count == 0)
        {
            <QEmptyState Icon="funnel" Title="Nothing matches" Text="Clear the search to see every deletion.">
                <Action><QButton Text="Show everything" Icon="arrow-counterclockwise" Variant="secondary" Size="sm" OnClick="@(() => SetSearch(string.Empty))" /></Action>
            </QEmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table q-stack">
                    <thead>
                        <tr>
                            <th>Visitor</th>
                            <th>Badge</th>
                            <th>Purpose</th>
                            <th>Status at deletion</th>
                            <th>Deleted by</th>
                            <th>Deleted at</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Paged)
                        {
                            <tr>
                                <td>@entry.FullName</td>
                                <td class="mono">@entry.BadgeCode</td>
                                <td>@entry.Purpose</td>
                                <td>@entry.StatusAtDeletion</td>
                                <td class="cell-sub">@(entry.DeletedByUserName ?? "—")</td>
                                <td>@QDateFormat.DT(entry.DeletedAt.ToLocalTime())</td>
                                <td class="reason">@entry.DeletionReason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <QPager Count="@Visible.Count" PageSize="@PageSize" PageIndex="@pageIndex" PageIndexChanged="@(i => pageIndex = i)" PageSizeOptions="@QPagerDefaults.Sizes" AllowAll="true" StorageKey="visitor-deletions"
                    PageSizeChanged="@(n => { PageSize = n; pageIndex = 0; })" ItemLabel="deletions" />
        }
    }
</div>

<style>.header-content h1 { margin: 0 0 4px; color: var(--qm-text-primary); }
    .loading-container { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 60px 20px; color: var(--qm-text-muted); }

    /* The table is the shared .data-table (app.css) at the shared sizes; only what is peculiar
       to this page stays here. A page that restyles a shared class name restyles it app-wide
       while it is open: a component style block is not scoped. */
    .table-wrap { overflow-x: auto; }
    .mono { font-family: monospace; }
    .reason { color: var(--qm-text-muted); max-width: 320px; }
</style>

@code {
    private int PageSize = QPagerDefaults.Size;

    private Guid branchId;
    private List<DeletedVisitorDto> entries = new();
    private bool isLoading = true;
    private string search = string.Empty;
    private int pageIndex;

    /// <summary>
    /// A deletion log only grows, so it is searched and paged rather than rendered whole: every row
    /// of it is diffed and shipped down the circuit on Blazor Server.
    /// </summary>
    private List<DeletedVisitorDto> Visible
    {
        get
        {
            if (string.IsNullOrWhiteSpace(search)) return entries;
            var q = search.Trim();
            bool Has(string? s) => (s ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase);
            return entries.Where(e => Has(e.FullName) || Has(e.BadgeCode) || Has(e.Purpose)
                                      || Has(e.DeletedByUserName) || Has(e.DeletionReason)).ToList();
        }
    }

    private int SafePageIndex => QPaging.SafeIndex(pageIndex, Visible.Count, PageSize);
    private IEnumerable<DeletedVisitorDto> Paged => QPaging.Page(Visible, SafePageIndex, PageSize);

    private void SetSearch(string value)
    {
        search = value ?? string.Empty;
        pageIndex = 0;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.VisitorsManage))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;

        entries = await VisitorApi.GetDeletedVisitorsAsync(branchId);
        isLoading = false;
    }

    /// <summary>
    /// Subscribe to branch changes. In OnAfterRenderAsync and not OnInitializedAsync on purpose:
    /// branch and auth state are read from localStorage over JS interop, which does not exist
    /// during prerendering and races an uninitialised store on a cold navigation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await BranchState.InitializeAsync();
        TrackBranch();
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        isLoading = true;
        // The search and the page belong to the branch that was showing, not to the new one.
        search = string.Empty;
        pageIndex = 0;
        entries = await VisitorApi.GetDeletedVisitorsAsync(branchId);
        isLoading = false;
    }
}
