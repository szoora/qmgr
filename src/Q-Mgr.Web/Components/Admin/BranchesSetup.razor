@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IAppointmentApiService AppointmentApi
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Shared.UI

@if (!Embedded)
{
    <PageTitle>Branches - Q-Mgr</PageTitle>
}

<QPageActions Embedded="@Embedded">
    <Title>
        <h1><QIcon Name="building-fill" /> Branches</h1>
        <p class="page-subtitle">Manage organization branches and locations</p>
    </Title>
    <Actions>
        @if (canCreate)
        {
            <QButton Text="Add branch" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" />
        }
    </Actions>
</QPageActions>

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading branches...</span></div>
}
else if (!branches.Any())
{
    <QEmptyState Icon="building" Title="No branches yet" Text="A branch is a place this organization serves from.">
        <Action>
            @if (canCreate) { <QButton Text="Add branch" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" /> }
        </Action>
    </QEmptyState>
}
else
{
    @* One row per branch. The queue figures (counters, services, today's tokens) are Core Queue's and
       read as zeros that mean nothing to a tenant without it, so they show only with the module. *@
    <QCard NoPadding="true">
        <div class="table-wrap">
            <table class="data-table q-stack">
                <thead>
                    <tr>
                        <th>Branch</th><th>Code</th><th>Time zone</th>
                        @if (hasCoreQueue) { <th class="num">Counters</th><th class="num">Services</th><th class="num">Today</th> }
                        <th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in branches)
                    {
                        var stats = branchStats.GetValueOrDefault(branch.Id);
                        <tr class="@(branch.IsActive ? "" : "row-muted")">
                            <td>
                                <strong>@branch.Name</strong>
                                @if (!string.IsNullOrEmpty(branch.Address)) { <span class="cell-sub">@branch.Address</span> }
                            </td>
                            <td><QChip Text="@branch.Code" Variant="muted" Size="sm" /></td>
                            <td>@branch.Timezone</td>
                            @if (hasCoreQueue)
                            {
                                <td class="num">@(stats?.CounterCount ?? 0)</td>
                                <td class="num">@(stats?.ServiceCount ?? 0)</td>
                                <td class="num">@(stats?.TodayTokens ?? 0)</td>
                            }
                            <td><QChip Text="@(branch.IsActive ? "Active" : "Disabled")" Variant="@(branch.IsActive ? "success" : "muted")" Size="sm" /></td>
                            <td class="row-actions">
                                @if (canEdit)
                                {
                                    <QButton Icon="pencil" Variant="ghost" Size="sm" OnClick="@(() => ShowEditDialog(branch))" Title="Edit" />
                                }
                                @* Opening hours and booking rules, and nothing else lives behind this
                                   button — so it is shown only to a tenant holding Core Queue. *@
                                @if (canEdit && hasCoreQueue)
                                {
                                    <QButton Icon="clock" Variant="ghost" Size="sm" OnClick="@(() => OpenSchedulingDialog(branch))" Title="Opening hours &amp; booking" />
                                }
                                @if (canEdit)
                                {
                                    <QButton Icon="@(branch.IsActive ? "toggle-on" : "toggle-off")" Variant="ghost" Size="sm"
                                             OnClick="@(() => ToggleBranch(branch))" Title="@(branch.IsActive ? "Disable" : "Enable")" />
                                }
                                @if (canDelete)
                                {
                                    <QButton Icon="trash" Variant="ghost" Size="sm" OnClick="@(() => DeleteBranch(branch))"
                                             Title="@(branches.Count <= 1 ? "The last branch cannot be deleted" : "Delete")" Disabled="@(branches.Count <= 1)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </QCard>
}

<!-- Add/Edit Dialog -->
<QModal @bind-Visible="showDialog" Title="@(editingBranch == null ? "Add Branch" : "Edit Branch")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Name" Label="Branch Name *" Placeholder="e.g., Main Branch, Downtown Office" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Code" Label="Branch Code *" Placeholder="e.g., MAIN, DT01" MaxLength="10" HelperText="Short code for this branch (max 10 characters)" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Address" Type="textarea" Label="Address" Placeholder="Full address..." Rows="2" />
        </div>
        <div class="form-group">
            <QSelect TValue="string" TItem="string" @bind-Value="@formData.Timezone" Items="@timezones" Label="Timezone" />
        </div>
        <div class="form-group">
            <QCheckbox @bind-Value="@formData.IsActive" Label="Branch is active" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@CloseDialog" />
        <QButton Text="@(editingBranch == null ? "Add Branch" : "Save Changes")" Icon="@(editingBranch == null ? "plus-lg" : "check-lg")" Variant="primary" OnClick="@SaveBranch" />
    </FooterContent>
</QModal>

@* ---------------- Opening hours & booking rules ---------------- *@
<QModal @bind-Visible="showSchedulingDialog" Title="@($"{schedulingBranchName} — Opening Hours & Booking")" Size="lg">
    <ChildContent>
        @if (isLoadingScheduling)
        {
            <div class="loading-container"><QSpinner Size="lg" /><span>Loading…</span></div>
        }
        else if (scheduling == null)
        {
            <p class="form-hint">Couldn't load this branch's settings. Close and try again.</p>
        }
        else
        {
            <div class="sched-section">
                <h4>Opening hours</h4>
                <p class="form-hint">
                    Local time in <strong>@scheduling.Timezone</strong> — the branch's own zone, changed on the branch itself.
                    These hours decide which appointment slots exist at all.
                </p>
                @if (scheduling.HoursAreDefaults)
                {
                    <p class="sched-note">
                        <QIcon Name="info-circle" />
                        <span>This branch has never had its hours set, so what's shown is the scheduler's built-in default. Saving makes it explicit.</span>
                    </p>
                }

                <div class="sched-days">
                    @foreach (var day in hoursForm)
                    {
                        <div class="sched-day @(day.IsOpen ? "" : "sched-day--closed")">
                            <span class="sched-day-name">@day.Day</span>
                            <QCheckbox Value="@day.IsOpen" Label="Open" ValueChanged="@(v => { day.IsOpen = v; })" />
                            @if (day.IsOpen)
                            {
                                <input type="time" class="sched-time" value="@day.Open" @onchange="@(e => day.Open = e.Value?.ToString() ?? day.Open)" aria-label="@($"{day.Day} opening time")" />
                                <span class="sched-dash">to</span>
                                <input type="time" class="sched-time" value="@day.Close" @onchange="@(e => day.Close = e.Value?.ToString() ?? day.Close)" aria-label="@($"{day.Day} closing time")" />
                            }
                            else
                            {
                                <span class="sched-closed-label">Closed all day</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="sched-section">
                <h4>Booking rules<QInfo Text="How that open window is cut into slots, and who may book into it." Label="Booking rules" /></h4>

                <div class="form-group">
                    <QCheckbox @bind-Value="@publicBookingEnabled" Label="Let the public book online" />
                    <p class="form-hint">
                        Controls the anonymous booking page at <code>/book/@scheduling.BranchId</code>. Turn it off and that
                        page stops taking bookings; staff can still book on someone's behalf.
                    </p>
                </div>

                <div class="sched-grid">
                    <QInput TValue="int?" @bind-Value="@slotIntervalMinutes" Label="Slot interval (minutes)" Placeholder="Service duration"
                            HelperText="Blank = back-to-back slots the length of each service." />
                    <QInput TValue="int" @bind-Value="@capacityPerSlot" Label="Capacity per slot"
                            HelperText="How many bookings share one slot — parallel counters or staff." />
                    <QInput TValue="int" @bind-Value="@minimumLeadTimeMinutes" Label="Minimum notice (minutes)"
                            HelperText="A slot closes to new bookings this long before it starts." />
                    <QInput TValue="int" @bind-Value="@maxAdvanceDays" Label="Book up to (days ahead)" />
                    <QInput TValue="int" @bind-Value="@reminderLeadMinutes" Label="Reminder (minutes before)"
                            HelperText="1440 is a day ahead." />
                    <QInput TValue="int" @bind-Value="@noShowGraceMinutes" Label="No-show grace (minutes)"
                            HelperText="How long after the start time before an unattended booking is marked a no-show." />
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showSchedulingDialog = false)" />
        <QButton Text="Save Settings" Icon="check-lg" Variant="primary" OnClick="@SaveScheduling"
                 Loading="@isSavingScheduling" Disabled="@(scheduling == null || isLoadingScheduling)" />
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Branch"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

