@code {
    /// <summary>True when the Branches hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private List<BranchDto> branches = new();
    private Dictionary<Guid, BranchStats> branchStats = new();
    private bool isLoading = true;
    private bool showDialog = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private BranchDto? editingBranch;
    private BranchFormData formData = new();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private BranchDto? branchToDelete;

    private List<string> timezones = new()
    {
        "UTC",
        "Africa/Johannesburg",
        "Africa/Lagos",
        "Africa/Nairobi",
        "America/New_York",
        "America/Chicago",
        "America/Los_Angeles",
        "Europe/London",
        "Europe/Paris",
        "Asia/Dubai",
        "Asia/Singapore",
        "Asia/Tokyo",
        "Australia/Sydney"
    };

    protected override async Task OnInitializedAsync()
    {
        // Permission check will be done in OnAfterRenderAsync when tokens are available
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionService.HasPermissionAsync(Permissions.BranchesView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canCreate = await PermissionService.HasPermissionAsync(Permissions.BranchesCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permissions.BranchesEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permissions.BranchesDelete);

            // Branches themselves are base product; the gear behind them is not. Same failing-open
            // rule the sidebar uses — an unresolved module list means "we don't know", not "you own
            // nothing", and the API refuses the call regardless.
            await ModuleState.LoadAsync(ModuleApi);
            hasCoreQueue = !ModuleState.LoadSucceeded || ModuleState.ActiveModuleCodes.Contains(ModuleCodes.CoreQueue);

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Include inactive branches for admin view
            branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/v1/branches?includeInactive=true", JsonOptions) ?? new();

            // Load stats for each branch
            foreach (var branch in branches)
            {
                try
                {
                    // Each figure is fetched on its own: a role that may see counters but not
                    // tickets should still see its counter and service counts.
                    var countersTask = TryGetAsync<List<CounterDto>>($"api/v1/branches/{branch.Id}/counters?includeInactive=true");
                    var servicesTask = TryGetAsync<List<ServiceTypeDto>>($"api/v1/branches/{branch.Id}/service-types?includeInactive=true");
                    var todayTask = TryGetAsync<TokensIssuedTodayDto>($"api/v1/branches/{branch.Id}/tokens/issued-today");
                    await Task.WhenAll(countersTask, servicesTask, todayTask);

                    branchStats[branch.Id] = new BranchStats
                    {
                        CounterCount = countersTask.Result?.Count ?? 0,
                        ServiceCount = servicesTask.Result?.Count ?? 0,
                        TodayTokens = todayTask.Result?.Count ?? 0
                    };
                }
                catch
                {
                    branchStats[branch.Id] = new BranchStats();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to load branches");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<T?> TryGetAsync<T>(string url) where T : class
    {
        try
        {
            return await Http.GetFromJsonAsync<T>(url, JsonOptions);
        }
        catch
        {
            return null;
        }
    }

    private void ShowAddDialog()
    {
        editingBranch = null;
        formData = new BranchFormData
        {
            Timezone = "UTC",
            IsActive = true
        };
        showDialog = true;
    }

    private void ShowEditDialog(BranchDto branch)
    {
        editingBranch = branch;
        formData = new BranchFormData
        {
            Name = branch.Name,
            Code = branch.Code,
            Address = branch.Address,
            Timezone = branch.Timezone,
            IsActive = branch.IsActive
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingBranch = null;
    }

    private async Task SaveBranch()
    {
        if (string.IsNullOrWhiteSpace(formData.Name) || string.IsNullOrWhiteSpace(formData.Code))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Name and Code are required");
            return;
        }

        try
        {
            var request = new
            {
                Name = formData.Name,
                Code = formData.Code.ToUpper(),
                Address = formData.Address,
                Timezone = formData.Timezone,
                IsActive = formData.IsActive
            };

            HttpResponseMessage response;
            if (editingBranch == null)
            {
                response = await Http.PostAsJsonAsync("api/v1/branches", request, JsonOptions);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/v1/branches/{editingBranch.Id}", request, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingBranch == null ? "Branch created" : "Branch updated");
                CloseDialog();
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save branch: {ex.Message}");
        }
    }

    private async Task ToggleBranch(BranchDto branch)
    {
        try
        {
            var response = await Http.PatchAsync($"api/v1/branches/{branch.Id}/toggle", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    branch.IsActive ? "Branch deactivated" : "Branch activated");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update branch: {ex.Message}");
        }
    }

    private void DeleteBranch(BranchDto branch)
    {
        branchToDelete = branch;
        deleteConfirmMessage = $"Are you sure you want to delete '{branch.Name}'? This action cannot be undone.";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && branchToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/v1/branches/{branchToDelete.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(ToastSeverity.Success, "Success", "Branch deleted");
                    await LoadData();
                }
                else
                {
                    var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                    NotificationService.Notify(ToastSeverity.Error, title, detail);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete branch: {ex.Message}");
            }
        }

        branchToDelete = null;
    }

    // ---- Opening hours & booking rules -------------------------------------------------------
    //
    // This replaces a gear button whose entire implementation was a toast saying the feature was
    // coming. What it now edits is not new configuration: Branch.OperatingHours was stamped on
    // every branch at provisioning and could then only be changed with SQL, and the appointment
    // settings had a reader in AppointmentsController and no writer, so all seven values were
    // pinned to their defaults while being consulted on every booking. PublicBookingEnabled
    // defaults to true, which meant no branch could close its own public booking page.

    private bool hasCoreQueue;
    private bool showSchedulingDialog;
    private bool isLoadingScheduling;
    private bool isSavingScheduling;
    private BranchSchedulingDto? scheduling;
    private string schedulingBranchName = "";
    private List<DayHoursForm> hoursForm = new();

    // The appointment settings are records with init-only properties, so the form binds to plain
    // fields and a new record is built on save rather than mutating one in place.
    private bool publicBookingEnabled = true;
    private int? slotIntervalMinutes;
    private int capacityPerSlot = 1;
    private int minimumLeadTimeMinutes = 30;
    private int maxAdvanceDays = 60;
    private int reminderLeadMinutes = 1440;
    private int noShowGraceMinutes = 30;

    /// <summary>Mutable mirror of BranchOpeningHoursDto, which is init-only.</summary>
    private class DayHoursForm
    {
        public DayOfWeek Day { get; set; }
        public bool IsOpen { get; set; }
        public string Open { get; set; } = "08:00";
        public string Close { get; set; } = "17:00";
    }

    private async Task OpenSchedulingDialog(BranchDto branch)
    {
        schedulingBranchName = branch.Name;
        scheduling = null;
        hoursForm = new();
        showSchedulingDialog = true;
        isLoadingScheduling = true;

        scheduling = await AppointmentApi.GetSchedulingAsync(branch.Id);
        if (scheduling != null)
        {
            hoursForm = scheduling.OperatingHours
                .Select(d => new DayHoursForm { Day = d.Day, IsOpen = d.IsOpen, Open = d.Open, Close = d.Close })
                .ToList();

            var a = scheduling.Appointments;
            publicBookingEnabled = a.PublicBookingEnabled;
            slotIntervalMinutes = a.SlotIntervalMinutes;
            capacityPerSlot = a.CapacityPerSlot;
            minimumLeadTimeMinutes = a.MinimumLeadTimeMinutes;
            maxAdvanceDays = a.MaxAdvanceDays;
            reminderLeadMinutes = a.ReminderLeadMinutes;
            noShowGraceMinutes = a.NoShowGraceMinutes;
        }

        isLoadingScheduling = false;
    }

    private async Task SaveScheduling()
    {
        if (scheduling == null) return;

        isSavingScheduling = true;
        try
        {
            var request = new UpdateBranchSchedulingRequest
            {
                OperatingHours = hoursForm
                    .Select(d => new BranchOpeningHoursDto { Day = d.Day, IsOpen = d.IsOpen, Open = d.Open, Close = d.Close })
                    .ToList(),
                Appointments = new AppointmentSettingsDto
                {
                    PublicBookingEnabled = publicBookingEnabled,
                    SlotIntervalMinutes = slotIntervalMinutes,
                    CapacityPerSlot = capacityPerSlot,
                    MinimumLeadTimeMinutes = minimumLeadTimeMinutes,
                    MaxAdvanceDays = maxAdvanceDays,
                    ReminderLeadMinutes = reminderLeadMinutes,
                    NoShowGraceMinutes = noShowGraceMinutes
                }
            };

            scheduling = await AppointmentApi.UpdateSchedulingAsync(scheduling.BranchId, request);
            var openDays = request.OperatingHours.Count(d => d.IsOpen);
            NotificationService.Notify(ToastSeverity.Success, "Saved",
                openDays == 0
                    ? "Saved — this branch is now marked closed every day, so no appointment slots will be offered."
                    : $"Opening hours and booking rules saved ({openDays} open day{(openDays == 1 ? "" : "s")}).");
            showSchedulingDialog = false;
        }
        catch (Exception ex)
        {
            // The API's own validation text, e.g. "Saturday: the closing time has to be after the
            // opening time" — worth far more than a generic failure on a form of this shape.
            NotificationService.Notify(ToastSeverity.Error, "Couldn't save", ex.Message);
        }
        finally
        {
            isSavingScheduling = false;
        }
    }

    private class BranchFormData
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string? Address { get; set; }
        public string Timezone { get; set; } = "UTC";
        public bool IsActive { get; set; } = true;
    }

    private class BranchStats
    {
        public int CounterCount { get; set; }
        public int ServiceCount { get; set; }
        public int TodayTokens { get; set; }
    }

    // Using the BranchDto from the API
    private record BranchDto
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
        public string Code { get; init; } = "";
        public string? Address { get; init; }
        public string Timezone { get; init; } = "UTC";
        public bool IsActive { get; init; }
    }
}
