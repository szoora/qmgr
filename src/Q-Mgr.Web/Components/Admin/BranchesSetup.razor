@page "/admin/branches"
@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>Branches - Q-Mgr</PageTitle>

<div class="page-header">
    <div class="header-content">
        <h1><QIcon Name="building-fill" /> Branches</h1>
        <p class="page-subtitle">Manage organization branches and locations</p>
    </div>
    <div class="header-actions">
        @if (canCreate)
        {
            <QButton Text="Add Branch" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" />
        }
    </div>
</div>

<div class="admin-content">
    <QCard Class="mb-4" Title="All Branches" Icon="list-ul">
        <HeaderActions>
            <span class="branch-count">@branches.Count branches</span>
        </HeaderActions>
        <ChildContent>
            @if (isLoading)
            {
                <div class="loading-state">
                    <QSpinner Size="lg" />
                    <span>Loading branches...</span>
                </div>
            }
            else if (!branches.Any())
            {
                <div class="empty-state">
                    <QIcon Name="building-fill" Size="xl" />
                    <h4>No Branches Configured</h4>
                    <p>Add your first branch to get started.</p>
                    @if (canCreate)
                    {
                        <QButton Text="Add Your First Branch" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" />
                    }
                </div>
            }
            else
            {
                <div class="branches-grid">
                    @foreach (var branch in branches)
                    {
                        <div class="branch-card @(branch.IsActive ? "" : "inactive")">
                            <div class="branch-header">
                                <div class="branch-icon">
                                    <QIcon Name="building-fill" />
                                </div>
                                <QBadge Text="@(branch.IsActive ? "Active" : "Inactive")" Variant="@(branch.IsActive ? "success" : "secondary")" />
                            </div>
                            <div class="branch-body">
                                <h4>@branch.Name</h4>
                                <p class="branch-code">Code: @branch.Code</p>
                                @if (!string.IsNullOrEmpty(branch.Address))
                                {
                                    <p class="branch-address">
                                        <QIcon Name="geo-alt-fill" />
                                        @branch.Address
                                    </p>
                                }
                                <p class="branch-timezone">
                                    <QIcon Name="clock-fill" />
                                    @branch.Timezone
                                </p>
                            </div>
                            <div class="branch-stats">
                                <div class="stat">
                                    <span class="stat-value">@(branchStats.GetValueOrDefault(branch.Id)?.CounterCount ?? 0)</span>
                                    <span class="stat-label">Counters</span>
                                </div>
                                <div class="stat">
                                    <span class="stat-value">@(branchStats.GetValueOrDefault(branch.Id)?.ServiceCount ?? 0)</span>
                                    <span class="stat-label">Services</span>
                                </div>
                                <div class="stat">
                                    <span class="stat-value">@(branchStats.GetValueOrDefault(branch.Id)?.TodayTokens ?? 0)</span>
                                    <span class="stat-label">Today</span>
                                </div>
                            </div>
                            <div class="branch-footer">
                                @if (canEdit)
                                {
                                    <QButton Icon="pencil-fill" Variant="ghost" Size="sm" OnClick="@(() => ShowEditDialog(branch))" Title="Edit" />
                                }
                                <QButton Icon="gear-fill" Variant="ghost" Size="sm" OnClick="@(() => ManageBranch(branch))" Title="Settings" />
                                @if (canEdit)
                                {
                                    <QButton Icon="@(branch.IsActive ? "toggle-on" : "toggle-off")" Variant="ghost" Size="sm"
                                              OnClick="@(() => ToggleBranch(branch))" Title="@(branch.IsActive ? "Disable" : "Enable")"
                                              Class="@(branch.IsActive ? "btn-toggle-on" : "btn-toggle-off")" />
                                }
                                @if (canDelete)
                                {
                                    <QButton Icon="trash-fill" Variant="ghost" Size="sm"
                                              OnClick="@(() => DeleteBranch(branch))" Title="Delete" Disabled="@(branches.Count <= 1)"
                                              Class="btn-delete" />
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </QCard>
</div>

<!-- Add/Edit Dialog -->
<QModal @bind-Visible="showDialog" Title="@(editingBranch == null ? "Add Branch" : "Edit Branch")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Name" Label="Branch Name *" Placeholder="e.g., Main Branch, Downtown Office" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Code" Label="Branch Code *" Placeholder="e.g., MAIN, DT01" MaxLength="10" HelperText="Short code for this branch (max 10 characters)" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Address" Type="textarea" Label="Address" Placeholder="Full address..." Rows="2" />
        </div>
        <div class="form-group">
            <QSelect TValue="string" TItem="string" @bind-Value="@formData.Timezone" Items="@timezones" Label="Timezone" />
        </div>
        <div class="form-group">
            <QCheckbox @bind-Value="@formData.IsActive" Label="Branch is active" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@CloseDialog" />
        <QButton Text="@(editingBranch == null ? "Add Branch" : "Save Changes")" Icon="@(editingBranch == null ? "plus-lg" : "check-lg")" Variant="primary" OnClick="@SaveBranch" />
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Branch"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

