@code {
    private List<BranchDto> branches = new();
    private Dictionary<Guid, BranchStats> branchStats = new();
    private bool isLoading = true;
    private bool showDialog = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private BranchDto? editingBranch;
    private BranchFormData formData = new();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private BranchDto? branchToDelete;

    private List<string> timezones = new()
    {
        "UTC",
        "Africa/Johannesburg",
        "Africa/Lagos",
        "Africa/Nairobi",
        "America/New_York",
        "America/Chicago",
        "America/Los_Angeles",
        "Europe/London",
        "Europe/Paris",
        "Asia/Dubai",
        "Asia/Singapore",
        "Asia/Tokyo",
        "Australia/Sydney"
    };

    protected override async Task OnInitializedAsync()
    {
        // Permission check will be done in OnAfterRenderAsync when tokens are available
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionService.HasPermissionAsync(Permissions.BranchesView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canCreate = await PermissionService.HasPermissionAsync(Permissions.BranchesCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permissions.BranchesEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permissions.BranchesDelete);

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Include inactive branches for admin view
            branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/v1/branches?includeInactive=true", JsonOptions) ?? new();

            // Load stats for each branch
            foreach (var branch in branches)
            {
                try
                {
                    var counters = await Http.GetFromJsonAsync<List<CounterDto>>($"api/v1/branches/{branch.Id}/counters?includeInactive=true", JsonOptions) ?? new();
                    var services = await Http.GetFromJsonAsync<List<ServiceTypeDto>>($"api/v1/branches/{branch.Id}/service-types?includeInactive=true", JsonOptions) ?? new();

                    branchStats[branch.Id] = new BranchStats
                    {
                        CounterCount = counters.Count,
                        ServiceCount = services.Count,
                        TodayTokens = 0 // TODO: Get from API
                    };
                }
                catch
                {
                    branchStats[branch.Id] = new BranchStats();
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to load branches");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddDialog()
    {
        editingBranch = null;
        formData = new BranchFormData
        {
            Timezone = "UTC",
            IsActive = true
        };
        showDialog = true;
    }

    private void ShowEditDialog(BranchDto branch)
    {
        editingBranch = branch;
        formData = new BranchFormData
        {
            Name = branch.Name,
            Code = branch.Code,
            Address = branch.Address,
            Timezone = branch.Timezone,
            IsActive = branch.IsActive
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingBranch = null;
    }

    private async Task SaveBranch()
    {
        if (string.IsNullOrWhiteSpace(formData.Name) || string.IsNullOrWhiteSpace(formData.Code))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Name and Code are required");
            return;
        }

        try
        {
            var request = new
            {
                Name = formData.Name,
                Code = formData.Code.ToUpper(),
                Address = formData.Address,
                Timezone = formData.Timezone,
                IsActive = formData.IsActive
            };

            HttpResponseMessage response;
            if (editingBranch == null)
            {
                response = await Http.PostAsJsonAsync("api/v1/branches", request, JsonOptions);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/v1/branches/{editingBranch.Id}", request, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingBranch == null ? "Branch created" : "Branch updated");
                CloseDialog();
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save branch: {ex.Message}");
        }
    }

    private async Task ToggleBranch(BranchDto branch)
    {
        try
        {
            var response = await Http.PatchAsync($"api/v1/branches/{branch.Id}/toggle", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    branch.IsActive ? "Branch deactivated" : "Branch activated");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update branch: {ex.Message}");
        }
    }

    private void DeleteBranch(BranchDto branch)
    {
        branchToDelete = branch;
        deleteConfirmMessage = $"Are you sure you want to delete '{branch.Name}'? This action cannot be undone.";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && branchToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/v1/branches/{branchToDelete.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(ToastSeverity.Success, "Success", "Branch deleted");
                    await LoadData();
                }
                else
                {
                    var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                    NotificationService.Notify(ToastSeverity.Error, title, detail);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete branch: {ex.Message}");
            }
        }

        branchToDelete = null;
    }

    private void ManageBranch(BranchDto branch)
    {
        // Navigate to branch-specific settings
        NotificationService.Notify(ToastSeverity.Info, "Info", "Branch settings coming soon");
    }

    private class BranchFormData
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
        public string? Address { get; set; }
        public string Timezone { get; set; } = "UTC";
        public bool IsActive { get; set; } = true;
    }

    private class BranchStats
    {
        public int CounterCount { get; set; }
        public int ServiceCount { get; set; }
        public int TodayTokens { get; set; }
    }

    // Using the BranchDto from the API
    private record BranchDto
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
        public string Code { get; init; } = "";
        public string? Address { get; init; }
        public string Timezone { get; init; } = "UTC";
        public bool IsActive { get; init; }
    }
}
