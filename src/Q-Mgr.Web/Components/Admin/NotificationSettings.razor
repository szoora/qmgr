@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Web.Services
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject NotificationService ToastService
@inject IAuthService AuthService
@inject IPermissionService PermissionService
@inject INotificationApiService NotificationApi
@inject NavigationManager Navigation

@if (!Embedded)
{
    <QPageTitle Text="Notification Settings" />
}

<div class="qm-admin-page">
    <QPageActions Embedded="@Embedded">
        <Title>
            <h1>Notification Settings</h1>
            <p class="subtitle">Configure SMS, Email, and In-App notification channels</p>
        </Title>
        <Actions>

            @if (canManage)
            {
                <QButton Text="Save Settings" Icon="check-lg" Variant="primary"
                              OnClick="@SaveSettings" Disabled="@(isSaving || loadFailed)" />
            }
        </Actions>
    </QPageActions>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <p>Loading settings...</p>
        </div>
    }
    else
    {
        <div class="qm-admin-settings-container">
            <div class="qm-admin-settings-nav">
                @* VisibleSections, not sections: this page opens read-only for anyone holding
                   notifications.view, but the delivery log is gated on notifications.manage
                   server-side. Offering the tab to a caller who will only get a 403 inside it is
                   the same mis-gating that put a fully-disabled Categories page in front of a
                   class teacher. *@
                @foreach (var section in VisibleSections)
                {
                    <div class="qm-admin-settings-nav-item @(activeSection == section.Key ? "active" : "")"
                         @onclick="@(() => SelectSection(section.Key))">
                        <i class="bi @(section.Icon)"></i>
                        <span>@(section.Name)</span>
                        @if (section.Key == "sms" && settings.SmsEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                        else if (section.Key == "email" && settings.EmailEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                        else if (section.Key == "telegram" && settings.TelegramEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                        else if (section.Key == "whatsapp" && settings.WhatsAppEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                        else if (section.Key == "inapp" && settings.InAppEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                        else if (section.Key == "queue" && settings.QueueNotificationsEnabled)
                        {
                            <QBadge Text="ON" Variant="success" Size="sm" />
                        }
                    </div>
                }
            </div>

            <div class="qm-admin-settings-content">
                @if (activeSection == "sms")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-chat-dots"></i> SMS Notifications</h3>
                            <QSwitch @bind-Value="settings.SmsEnabled" aria-label="SMS notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.SmsEnabled ? "disabled" : "")">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <p>SMS notifications are sent via the CRM API gateway. Configure the gateway URL and authentication below.</p>
                            </div>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group full-width">
                                    <QInput TValue="string" @bind-Value="@settings.SmsGatewayUrl" Label="SMS Gateway URL *" Placeholder="https://api.example.com"
                                            HelperText="Base URL for the CRM SMS API (e.g., https://api.crm.example.com)"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmsCustomerId" Label="Customer ID" Placeholder="customer-123"
                                            HelperText="Your CRM customer identifier"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmsSenderId" Label="Sender ID" Placeholder="Q-Mgr"
                                            HelperText="Name shown as SMS sender"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmsApiKey" Label="API Key" Type="password" Placeholder="••••••••"
                                            HelperText="API authentication key (if using API key auth)"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="int" @bind-Value="@settings.SmsLeadTokens" Label="SMS Lead Tokens" Type="number" Min="1" Max="10"
                                            HelperText="Notify when X positions ahead"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>Credentials (Optional)<QInfo Text="Use if the gateway requires username/password authentication" Label="Credentials (Optional)" /></h4>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmsUsername" Label="Username" Placeholder="api_user"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmsPassword" Label="Password" Type="password" Placeholder="••••••••"
                                            Disabled="@(!settings.SmsEnabled)" />
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>Test SMS Connection</h4>

                            <div class="qm-admin-form-inline">
                                <QInput TValue="string" @bind-Value="@testPhoneNumber" Placeholder="+256700123456"
                                        Disabled="@(!settings.SmsEnabled)" Style="width: 200px;" />
                                @if (canManage)
                                {
                                    <QButton Text="Send Test SMS" Icon="send-fill" Variant="secondary"
                                                  OnClick="@TestSms" Disabled="@(!settings.SmsEnabled || isTestingSms)" />
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(smsTestResult))
                            {
                                <div class="qm-admin-alert @(smsTestSuccess ? "success" : "error")">
                                    <i class="bi @(smsTestSuccess ? "bi-check-circle" : "bi-x-circle")"></i>
                                    <p>@smsTestResult</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (activeSection == "email")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-envelope"></i> Email Notifications</h3>
                            <QSwitch @bind-Value="settings.EmailEnabled" aria-label="Email notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.EmailEnabled ? "disabled" : "")">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <p>Configure your SMTP server settings to send email notifications.</p>
                            </div>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmtpHost" Label="SMTP Host *" Placeholder="smtp.gmail.com"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="int" @bind-Value="@settings.SmtpPort" Label="SMTP Port *" Type="number" Min="1" Max="65535"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmtpUsername" Label="Username" Placeholder="user@gmail.com"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.SmtpPassword" Label="Password" Type="password" Placeholder="••••••••"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.EmailFromAddress" Label="From Email *" Placeholder="noreply@example.com"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.EmailFromName" Label="From Name" Placeholder="Q-Mgr Queue System"
                                            Disabled="@(!settings.EmailEnabled)" />
                                </div>

                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Use SSL/TLS</label>
                                        <p class="qm-admin-form-hint">Enable secure connection</p>
                                    </div>
                                    <QSwitch @bind-Value="settings.SmtpUseSsl" Disabled="@(!settings.EmailEnabled)" aria-label="Use SSL/TLS" />
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>Test Email Connection</h4>

                            <div class="qm-admin-form-inline">
                                <QInput TValue="string" @bind-Value="@testEmailAddress" Placeholder="test@example.com"
                                        Disabled="@(!settings.EmailEnabled)" Style="width: 250px;" />
                                @if (canManage)
                                {
                                    <QButton Text="Send Test Email" Icon="send-fill" Variant="secondary"
                                                  OnClick="@TestEmail" Disabled="@(!settings.EmailEnabled || isTestingEmail)" />
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(emailTestResult))
                            {
                                <div class="qm-admin-alert @(emailTestSuccess ? "success" : "error")">
                                    <i class="bi @(emailTestSuccess ? "bi-check-circle" : "bi-x-circle")"></i>
                                    <p>@emailTestResult</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (activeSection == "telegram")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-telegram"></i> Telegram Notifications</h3>
                            <QSwitch @bind-Value="settings.TelegramEnabled" aria-label="Telegram notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.TelegramEnabled ? "disabled" : "")">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <p>Create a bot via <a href="https://t.me/BotFather" target="_blank" rel="noopener">@@BotFather</a> on Telegram and paste its token below. Contacts can only be messaged once they've started a chat with your bot (a Telegram platform requirement).</p>
                            </div>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.TelegramBotToken" Label="Bot Token *" Type="password" Placeholder="123456789:AAExampleTokenFromBotFather"
                                            Disabled="@(!settings.TelegramEnabled)" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeSection == "whatsapp")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-whatsapp"></i> WhatsApp Notifications</h3>
                            <QSwitch @bind-Value="settings.WhatsAppEnabled" aria-label="WhatsApp notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.WhatsAppEnabled ? "disabled" : "")">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <p>Requires a WhatsApp Business Platform app in <a href="https://developers.facebook.com/apps" target="_blank" rel="noopener">Meta for Developers</a> — a verified phone number ID and a permanent access token.</p>
                            </div>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.WhatsAppPhoneNumberId" Label="Phone Number ID *" Placeholder="123456789012345"
                                            Disabled="@(!settings.WhatsAppEnabled)" />
                                </div>
                                <div class="qm-admin-form-group">
                                    <QInput TValue="string" @bind-Value="@settings.WhatsAppAccessToken" Label="Access Token *" Type="password" Placeholder="EAAExampleAccessToken"
                                            Disabled="@(!settings.WhatsAppEnabled)" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeSection == "inapp")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-bell"></i> In-App Notifications</h3>
                            <QSwitch @bind-Value="settings.InAppEnabled" aria-label="In-app notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.InAppEnabled ? "disabled" : "")">
                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Play Sound</label>
                                        <p class="qm-admin-form-hint">Play notification sound when new alerts arrive</p>
                                    </div>
                                    <QSwitch @bind-Value="settings.InAppPlaySound" Disabled="@(!settings.InAppEnabled)" aria-label="Play Sound" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="int" @bind-Value="@settings.InAppRetentionDays" Label="Retention Days" Type="number" Min="1" Max="90"
                                            HelperText="Days to keep notifications (1-90)"
                                            Disabled="@(!settings.InAppEnabled)" />
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (activeSection == "queue")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-person-check"></i> Queue Notifications</h3>
                            <QSwitch @bind-Value="settings.QueueNotificationsEnabled" aria-label="Queue notifications" />
                        </div>

                        <div class="qm-admin-settings-group @(!settings.QueueNotificationsEnabled ? "disabled" : "")">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <div>
                                    <p>These are the messages the <strong>customer holding a ticket</strong> receives &mdash; so they don't have to stand and watch the display.</p>
                                    <p>A message is only ever sent when the customer supplied that contact detail on their ticket <em>and</em> the channel itself is switched on and configured above. A branch with no SMS gateway configured simply sends nothing.</p>
                                </div>
                            </div>

                            <h4>Channels</h4>
                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>SMS</label>
                                        <p class="qm-admin-form-hint">
                                            @if (settings.SmsEnabled)
                                            {
                                                <span>Send queue messages by SMS</span>
                                            }
                                            else
                                            {
                                                <span>SMS is switched off in the SMS section &mdash; nothing will be sent</span>
                                            }
                                        </p>
                                    </div>
                                    <QSwitch @bind-Value="settings.QueueNotifySms" Disabled="@(!settings.QueueNotificationsEnabled)" aria-label="Queue notifications by SMS" />
                                </div>

                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Email</label>
                                        <p class="qm-admin-form-hint">
                                            @if (settings.EmailEnabled)
                                            {
                                                <span>Send queue messages by email</span>
                                            }
                                            else
                                            {
                                                <span>Email is switched off in the Email section &mdash; nothing will be sent</span>
                                            }
                                        </p>
                                    </div>
                                    <QSwitch @bind-Value="settings.QueueNotifyEmail" Disabled="@(!settings.QueueNotificationsEnabled)" aria-label="Queue notifications by email" />
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>When to send<QInfo Text="Each moment costs a message per customer &mdash; switch off the ones you don't need." Label="When to send" /></h4>

                            <div class="qm-admin-form-grid">
                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Ticket issued</label>
                                        <p class="qm-admin-form-hint">Confirmation with the ticket number and position</p>
                                    </div>
                                    <QSwitch @bind-Value="settings.QueueNotifyOnIssued" Disabled="@(!settings.QueueNotificationsEnabled)" aria-label="Ticket issued" />
                                </div>

                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Nearly your turn</label>
                                        <p class="qm-admin-form-hint">Sent once, when they reach the position threshold below</p>
                                    </div>
                                    <QSwitch @bind-Value="settings.QueueNotifyOnApproaching" Disabled="@(!settings.QueueNotificationsEnabled)" aria-label="Nearly your turn" />
                                </div>

                                <div class="qm-admin-form-group toggle-item">
                                    <div>
                                        <label>Called to counter</label>
                                        <p class="qm-admin-form-hint">Sent the moment staff call them, naming the counter</p>
                                    </div>
                                    <QSwitch @bind-Value="settings.QueueNotifyOnCalled" Disabled="@(!settings.QueueNotificationsEnabled)" aria-label="Called to counter" />
                                </div>

                                <div class="qm-admin-form-group">
                                    <QInput TValue="int" @bind-Value="@settings.SmsLeadTokens" Label="'Nearly your turn' threshold" Type="number" Min="1" Max="10"
                                            Hint="Warn a customer once they are this many positions from the front (shared with SMS Lead Tokens)"
                                            Disabled="@(!settings.QueueNotificationsEnabled)" />
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>Messages</h4>

                            <div class="qm-admin-alert info">
                                <i class="bi bi-braces"></i>
                                <div>
                                    <p>Placeholders (case-insensitive) &mdash; anything unavailable for a given moment renders as empty:</p>
                                    <code>{TicketNumber}</code> <code>{CounterNumber}</code> <code>{Position}</code>
                                    <code>{BranchName}</code> <code>{OrganizationName}</code> <code>{EstimatedWaitMinutes}</code>
                                    <code>{ServiceType}</code> <code>{CustomerName}</code>
                                    <p class="qm-admin-form-hint">Older placeholders still work: <code>{TokenNumber}</code>, <code>{CounterName}</code>, <code>{PositionInQueue}</code>, <code>{WaitTime}</code>.</p>
                                    <p class="qm-admin-form-hint">Email bodies are content only &mdash; one paragraph per line. The branded header, signature and footer are added automatically.</p>
                                </div>
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4><i class="bi bi-ticket-perforated"></i> Ticket issued</h4>
                            <p class="qm-admin-form-hint">Sent as soon as the ticket is created.</p>

                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsTokenCreatedTemplate" Label="SMS" Type="textarea" Rows="2"
                                        HelperText="Keep it short - one SMS is 160 characters."
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCreatedSubject" Label="Email subject"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCreatedTemplate" Label="Email body (one paragraph per line)" Type="textarea" Rows="4"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div style="background: var(--qm-bg-elevated); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 0.85rem 1rem; margin-bottom: 1rem;">
                                <p class="qm-admin-form-hint" style="margin-bottom: 0.5rem;">Preview with sample values</p>
                                <p style="margin-bottom: 0.5rem;">
                                    <i class="bi bi-chat-dots"></i>
                                    <span style="color: var(--qm-text-secondary);">@RenderPreview(settings.SmsTokenCreatedTemplate)</span>
                                    <span class="qm-admin-form-hint">(@(RenderPreview(settings.SmsTokenCreatedTemplate).Length) characters)</span>
                                </p>
                                <p style="margin-bottom: 0.35rem;">
                                    <i class="bi bi-envelope"></i>
                                    <strong>@RenderPreview(settings.EmailTokenCreatedSubject)</strong>
                                </p>
                                @foreach (var line in RenderPreviewLines(settings.EmailTokenCreatedTemplate))
                                {
                                    <p style="color: var(--qm-text-secondary); margin-bottom: 0.25rem;">@line</p>
                                }
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4><i class="bi bi-hourglass-split"></i> Nearly your turn</h4>
                            <p class="qm-admin-form-hint">Sent once, when the customer reaches the threshold above. <code>{Position}</code> is their place in line.</p>

                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsReminderTemplate" Label="SMS" Type="textarea" Rows="2"
                                        HelperText="Keep it short - one SMS is 160 characters."
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailReminderSubject" Label="Email subject"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailReminderTemplate" Label="Email body (one paragraph per line)" Type="textarea" Rows="4"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div style="background: var(--qm-bg-elevated); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 0.85rem 1rem; margin-bottom: 1rem;">
                                <p class="qm-admin-form-hint" style="margin-bottom: 0.5rem;">Preview with sample values</p>
                                <p style="margin-bottom: 0.5rem;">
                                    <i class="bi bi-chat-dots"></i>
                                    <span style="color: var(--qm-text-secondary);">@RenderPreview(settings.SmsReminderTemplate)</span>
                                    <span class="qm-admin-form-hint">(@(RenderPreview(settings.SmsReminderTemplate).Length) characters)</span>
                                </p>
                                <p style="margin-bottom: 0.35rem;">
                                    <i class="bi bi-envelope"></i>
                                    <strong>@RenderPreview(settings.EmailReminderSubject)</strong>
                                </p>
                                @foreach (var line in RenderPreviewLines(settings.EmailReminderTemplate))
                                {
                                    <p style="color: var(--qm-text-secondary); margin-bottom: 0.25rem;">@line</p>
                                }
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4><i class="bi bi-megaphone"></i> Called to counter</h4>
                            <p class="qm-admin-form-hint">Sent the moment staff call this ticket. <code>{CounterNumber}</code> names the counter.</p>

                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsTokenCalledTemplate" Label="SMS" Type="textarea" Rows="2"
                                        HelperText="Keep it short - one SMS is 160 characters."
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCalledSubject" Label="Email subject"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCalledTemplate" Label="Email body (one paragraph per line)" Type="textarea" Rows="4"
                                        Disabled="@(!settings.QueueNotificationsEnabled)" />
                            </div>
                            <div style="background: var(--qm-bg-elevated); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); padding: 0.85rem 1rem; margin-bottom: 1rem;">
                                <p class="qm-admin-form-hint" style="margin-bottom: 0.5rem;">Preview with sample values</p>
                                <p style="margin-bottom: 0.5rem;">
                                    <i class="bi bi-chat-dots"></i>
                                    <span style="color: var(--qm-text-secondary);">@RenderPreview(settings.SmsTokenCalledTemplate)</span>
                                    <span class="qm-admin-form-hint">(@(RenderPreview(settings.SmsTokenCalledTemplate).Length) characters)</span>
                                </p>
                                <p style="margin-bottom: 0.35rem;">
                                    <i class="bi bi-envelope"></i>
                                    <strong>@RenderPreview(settings.EmailTokenCalledSubject)</strong>
                                </p>
                                @foreach (var line in RenderPreviewLines(settings.EmailTokenCalledTemplate))
                                {
                                    <p style="color: var(--qm-text-secondary); margin-bottom: 0.25rem;">@line</p>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (activeSection == "templates")
                {
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-file-text"></i> Message Templates</h3>
                        </div>

                        <div class="qm-admin-settings-group">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <div>
                                    <p>These are the same customer messages as the <strong>Queue Messages</strong> section, which also shows a live preview and the "nearly your turn" email.</p>
                                    <p>Available placeholders:</p>
                                    <code>{TicketNumber}</code> <code>{CounterNumber}</code> <code>{Position}</code>
                                    <code>{BranchName}</code> <code>{OrganizationName}</code> <code>{EstimatedWaitMinutes}</code>
                                    <code>{ServiceType}</code> <code>{CustomerName}</code>
                                    <p class="qm-admin-form-hint">Older names still work: <code>{TokenNumber}</code>, <code>{CounterName}</code>, <code>{PositionInQueue}</code>, <code>{WaitTime}</code>. <code>{TrackingUrl}</code> is no longer substituted and renders as empty.</p>
                                </div>
                            </div>

                            <h4>SMS Templates</h4>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsTokenCreatedTemplate" Label="Token Created" Type="textarea" Rows="2" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsTokenCalledTemplate" Label="Token Called" Type="textarea" Rows="2" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.SmsReminderTemplate" Label="Reminder" Type="textarea" Rows="2" />
                            </div>

                            <div class="qm-admin-divider"></div>
                            <h4>Email Templates</h4>

                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCreatedSubject" Label="Token Created - Subject" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCreatedTemplate" Label="Token Created - Body (HTML)" Type="textarea" Rows="6" />
                            </div>

                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCalledSubject" Label="Token Called - Subject" />
                            </div>
                            <div class="qm-admin-form-group">
                                <QInput TValue="string" @bind-Value="@settings.EmailTokenCalledTemplate" Label="Token Called - Body (HTML)" Type="textarea" Rows="6" />
                            </div>
                        </div>
                    </div>
                }
                else if (activeSection == "deliveries")
                {
                    @* ── Was it actually delivered? ──────────────────────────────────────────
                       NotificationLog had no reader at all until now: rows were written and only
                       curl could see them, so "did that email go out?" had no answer inside the
                       product. A SKIPPED send writes no row on purpose — logging "email is off
                       for this tenant" as a failure would put a red mark against every message a
                       tenant sends. *@
                    <div class="qm-admin-settings-section">
                        <div class="qm-admin-section-header">
                            <h3><i class="bi bi-journal-check"></i> Delivery Log</h3>
                            <div class="dl-head-actions">
                                <QCheckbox Value="@deliveryFailuresOnly"
                                           ValueChanged="@OnDeliveryFilterChanged"
                                           Label="Failures only" />
                                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" Size="sm"
                                         OnClick="@LoadDeliveries" Disabled="@isLoadingDeliveries" />
                            </div>
                        </div>

                        <div class="qm-admin-settings-group">
                            <div class="qm-admin-alert info">
                                <i class="bi bi-info-circle"></i>
                                <div>
                                    <p>
                                        One row per real send attempt for SMS and email. Recipient addresses are
                                        <strong>masked by the API</strong> — enough to see which address failed, not
                                        enough to lift a staff directory out of the log.
                                    </p>
                                    <p class="qm-admin-form-hint">
                                        A message that was never attempted because the channel is switched off for this
                                        organization writes no row, so an empty log with SMS disabled is correct, not broken.
                                    </p>
                                </div>
                            </div>

                            @if (isLoadingDeliveries)
                            {
                                <div class="loading-container"><QSpinner Size="md" /><span>Loading delivery attempts...</span></div>
                            }
                            else if (deliveryError != null)
                            {
                                <div class="qm-admin-alert error">
                                    <i class="bi bi-exclamation-circle"></i>
                                    <div><p>@deliveryError</p></div>
                                </div>
                            }
                            else if (!deliveries.Any())
                            {
                                <QEmptyState Icon="inbox"
                                             Title="@(deliveryFailuresOnly ? "No failed deliveries" : "No deliveries yet")"
                                             Text="@(deliveryFailuresOnly ? "Nothing has gone wrong." : "No delivery attempts recorded yet.")" />
                            }
                            else
                            {
                                <div class="dl-summary">
                                    <span><strong>@deliveries.Count</strong> attempt@(deliveries.Count == 1 ? "" : "s")</span>
                                    <span class="dl-ok"><strong>@deliveries.Count(d => d.Success)</strong> delivered</span>
                                    <span class="dl-bad"><strong>@deliveries.Count(d => !d.Success)</strong> failed</span>
                                </div>

                                @* Its own overflow-x wrapper: the PAGE must never scroll sideways,
                                   but a wide table may. *@
                                <div class="dl-table-wrap">
                                    <table class="dl-table">
                                        <thead>
                                            <tr>
                                                <th>When</th>
                                                <th>Channel</th>
                                                <th>Recipient</th>
                                                <th>Notification</th>
                                                <th>Outcome</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var d in deliveries)
                                            {
                                                <tr class="@(d.Success ? "" : "dl-row-failed")">
                                                    <td class="dl-when">@QDateFormat.LocalDT(d.CreatedAt)</td>
                                                    <td><QBadge Text="@d.Channel" Variant="@(d.Channel == "Sms" ? "warning" : "info")" Size="sm" /></td>
                                                    <td class="dl-recipient">@d.Recipient</td>
                                                    <td class="dl-title">@d.NotificationTitle</td>
                                                    <td>
                                                        @if (d.Success)
                                                        {
                                                            <span class="dl-ok"><i class="bi bi-check-circle-fill"></i> Delivered</span>
                                                            @if (d.RetryCount > 0)
                                                            {
                                                                <span class="dl-retries">after @d.RetryCount retr@(d.RetryCount == 1 ? "y" : "ies")</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="dl-bad"><i class="bi bi-x-circle-fill"></i> Failed</span>
                                                            @if (!string.IsNullOrWhiteSpace(d.ErrorMessage))
                                                            {
                                                                <span class="dl-reason">@d.ErrorMessage</span>
                                                            }
                                                            @if (d.RetryCount > 0)
                                                            {
                                                                <span class="dl-retries">@d.RetryCount retr@(d.RetryCount == 1 ? "y" : "ies"), last @QDateFormat.LocalDT(d.LastRetryAt)</span>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    /// <summary>True when the Settings hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private bool isLoading = true;
    private bool isSaving = false;
    /// <summary>Latched when a settings load fails. Blocks Save so defaults cannot silently overwrite real settings.</summary>
    private bool loadFailed = false;
    private bool canManage = false;
    private string activeSection = "sms";
    private NotificationSettingsModel settings = new();
    private Guid organizationId = Guid.Empty;

    // Test SMS
    private string testPhoneNumber = "";
    private bool isTestingSms = false;
    private string? smsTestResult;
    private bool smsTestSuccess = false;

    // Test Email
    private string testEmailAddress = "";
    private bool isTestingEmail = false;
    private string? emailTestResult;
    private bool emailTestSuccess = false;

    private List<SectionInfo> sections = new()
    {
        new() { Key = "sms", Name = "SMS", Icon = "bi-chat-dots" },
        new() { Key = "email", Name = "Email", Icon = "bi-envelope" },
        new() { Key = "telegram", Name = "Telegram", Icon = "bi-telegram" },
        new() { Key = "whatsapp", Name = "WhatsApp", Icon = "bi-whatsapp" },
        new() { Key = "inapp", Name = "In-App", Icon = "bi-bell" },
        new() { Key = "queue", Name = "Queue Messages", Icon = "bi-person-check" },
        new() { Key = "templates", Name = "Templates", Icon = "bi-file-text" },
        new() { Key = "deliveries", Name = "Delivery Log", Icon = "bi-journal-check" }
    };

    private IEnumerable<SectionInfo> VisibleSections =>
        sections.Where(s => s.Key != "deliveries" || canManage);

    // ---------------- Delivery log ----------------
    private bool isLoadingDeliveries;
    private bool deliveryFailuresOnly;
    private string? deliveryError;
    private List<NotificationDeliveryDto> deliveries = new();
    private bool deliveriesLoaded;

    private async Task SelectSection(string key)
    {
        activeSection = key;

        // Fetched on first open rather than with the settings: the log is up to 100 rows nobody
        // asked for when they came here to change an SMTP host.
        if (key == "deliveries" && !deliveriesLoaded && !isLoadingDeliveries)
            await LoadDeliveries();
    }

    private async Task OnDeliveryFilterChanged(bool failuresOnly)
    {
        deliveryFailuresOnly = failuresOnly;
        await LoadDeliveries();
    }

    private async Task LoadDeliveries()
    {
        isLoadingDeliveries = true;
        deliveryError = null;
        try
        {
            deliveries = await NotificationApi.GetDeliveriesAsync(deliveryFailuresOnly, 100);
            deliveriesLoaded = true;
        }
        catch (Exception ex)
        {
            // GetDeliveriesAsync throws with the server's own message (the four preference/log
            // methods do, unlike the bell methods next to them), so this shows the real reason —
            // including "you do not hold notifications.manage".
            deliveryError = ex.Message;
        }
        finally
        {
            isLoadingDeliveries = false;
        }
    }

    // Sample values used only for the live preview in the Queue Messages section — they mirror
    // the placeholders QueueCustomerNotifier substitutes for real, including the legacy aliases.
    private static readonly Dictionary<string, string> previewValues = new(StringComparer.OrdinalIgnoreCase)
    {
        ["TicketNumber"] = "A014",
        ["TokenNumber"] = "A014",
        ["CounterNumber"] = "3",
        ["CounterName"] = "Counter 3",
        ["Position"] = "2",
        ["PositionInQueue"] = "2",
        ["BranchName"] = "Main Branch",
        ["OrganizationName"] = "Acme Services",
        ["EstimatedWaitMinutes"] = "12",
        ["WaitTime"] = "12",
        ["ServiceType"] = "Account Opening",
        ["CustomerName"] = "Jane",
        ["TrackingUrl"] = ""
    };

    private static string RenderPreview(string? template)
    {
        if (string.IsNullOrWhiteSpace(template))
            return "";

        var result = template;
        foreach (var kv in previewValues)
        {
            result = result.Replace("{" + kv.Key + "}", kv.Value, StringComparison.OrdinalIgnoreCase);
        }

        // Tags are stripped rather than rendered: the stored template is admin-authored HTML,
        // and echoing it back as live markup into another admin's page is not worth the risk
        // for a preview.
        result = System.Text.RegularExpressions.Regex.Replace(result, "<[^>]+>", "");

        // Collapse the gaps an empty placeholder leaves behind, the same way the server does.
        var lines = result.Replace("\r\n", "\n").Split('\n')
            .Select(line => string.Join(' ', line.Split(' ', StringSplitOptions.RemoveEmptyEntries)).Trim());
        return string.Join('\n', lines).Trim();
    }

    private static List<string> RenderPreviewLines(string? template) =>
        RenderPreview(template)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => line.Length > 0)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.NotificationsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        canManage = await PermissionService.HasPermissionAsync(Permissions.NotificationsManage);

        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        isLoading = true;
        try
        {
            // Get current organization from auth context
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.OrganizationId != null && user.OrganizationId != Guid.Empty)
            {
                organizationId = user.OrganizationId;
            }
            else
            {
                // No fallback to a specific tenant's ID here — that would silently show one
                // tenant's notification settings to a user whose auth context failed to resolve.
                ToastService.Notify(NotificationSeverity.Error, "Error", "Unable to determine your organization. Please sign in again.");
                isLoading = false;
                return;
            }

            var response = await Http.GetAsync($"api/v1/notifications/settings/{organizationId}");
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<NotificationSettingsModel>(JsonOptions);
                if (result != null)
                {
                    settings = result;
                }
                loadFailed = false;
            }
            else
            {
                // Silent failure here is dangerous rather than untidy: the form stays on its
                // defaults — indistinguishable from "nothing configured yet" — and Save would
                // then overwrite the organisation's real notification settings with them,
                // including switching channels off. Announced and latched; Save stays disabled.
                loadFailed = true;
                ToastService.Notify(NotificationSeverity.Error, "Could not load notification settings",
                    await ApiErrorService.GetErrorMessageAsync(response, "The saved settings could not be read."));
            }
        }
        catch (Exception ex)
        {
            loadFailed = true;
            ToastService.Notify(NotificationSeverity.Error, "Error", $"Failed to load settings: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSettings()
    {
        isSaving = true;
        try
        {
            settings.OrganizationId = organizationId;
            var response = await Http.PutAsJsonAsync("api/v1/notifications/settings", settings, JsonOptions);
            if (response.IsSuccessStatusCode)
            {
                ToastService.Notify(NotificationSeverity.Success, "Saved", "Notification settings updated successfully");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.Notify(NotificationSeverity.Error, "Error", $"Failed to save settings: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(NotificationSeverity.Error, "Error", $"Failed to save settings: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TestSms()
    {
        if (string.IsNullOrWhiteSpace(testPhoneNumber))
        {
            smsTestResult = "Please enter a phone number";
            smsTestSuccess = false;
            return;
        }

        isTestingSms = true;
        smsTestResult = null;
        try
        {
            // First save current settings
            await SaveSettings();

            var response = await Http.PostAsJsonAsync(
                $"api/v1/notifications/settings/{organizationId}/test-sms",
                new { PhoneNumber = testPhoneNumber }, JsonOptions);

            var result = await response.Content.ReadFromJsonAsync<TestResult>(JsonOptions);
            smsTestSuccess = result?.Success ?? false;
            smsTestResult = result?.Message ?? "Unknown error";
        }
        catch (Exception ex)
        {
            smsTestSuccess = false;
            smsTestResult = $"Test failed: {ex.Message}";
        }
        finally
        {
            isTestingSms = false;
        }
    }

    private async Task TestEmail()
    {
        if (string.IsNullOrWhiteSpace(testEmailAddress))
        {
            emailTestResult = "Please enter an email address";
            emailTestSuccess = false;
            return;
        }

        isTestingEmail = true;
        emailTestResult = null;
        try
        {
            // First save current settings
            await SaveSettings();

            var response = await Http.PostAsJsonAsync(
                $"api/v1/notifications/settings/{organizationId}/test-email",
                new { EmailAddress = testEmailAddress }, JsonOptions);

            var result = await response.Content.ReadFromJsonAsync<TestResult>(JsonOptions);
            emailTestSuccess = result?.Success ?? false;
            emailTestResult = result?.Message ?? "Unknown error";
        }
        catch (Exception ex)
        {
            emailTestSuccess = false;
            emailTestResult = $"Test failed: {ex.Message}";
        }
        finally
        {
            isTestingEmail = false;
        }
    }

    private class SectionInfo
    {
        public string Key { get; set; } = "";
        public string Name { get; set; } = "";
        public string Icon { get; set; } = "";
    }

    private class NotificationSettingsModel
    {
        public Guid Id { get; set; }
        public Guid OrganizationId { get; set; }

        // SMS
        public bool SmsEnabled { get; set; }
        public string? SmsGatewayUrl { get; set; }
        public string? SmsApiKey { get; set; }
        public string? SmsUsername { get; set; }
        public string? SmsPassword { get; set; }
        public string? SmsSenderId { get; set; } = "Q-Mgr";
        public string? SmsCustomerId { get; set; }
        public int SmsLeadTokens { get; set; } = 3;

        // Email
        public bool EmailEnabled { get; set; }
        public string? SmtpHost { get; set; }
        public int SmtpPort { get; set; } = 587;
        public bool SmtpUseSsl { get; set; } = true;
        public string? SmtpUsername { get; set; }
        public string? SmtpPassword { get; set; }
        public string? EmailFromAddress { get; set; }
        public string? EmailFromName { get; set; } = "Q-Mgr";

        // Telegram
        public bool TelegramEnabled { get; set; }
        public string? TelegramBotToken { get; set; }

        // WhatsApp
        public bool WhatsAppEnabled { get; set; }
        public string? WhatsAppPhoneNumberId { get; set; }
        public string? WhatsAppAccessToken { get; set; }

        // In-App
        public bool InAppEnabled { get; set; } = true;
        public bool InAppPlaySound { get; set; } = true;
        public int InAppRetentionDays { get; set; } = 30;

        // Push
        public bool PushEnabled { get; set; }

        // Queue customer notifications — what the ticket holder receives.
        public bool QueueNotificationsEnabled { get; set; } = true;
        public bool QueueNotifySms { get; set; } = true;
        public bool QueueNotifyEmail { get; set; } = true;
        public bool QueueNotifyOnIssued { get; set; } = true;
        public bool QueueNotifyOnApproaching { get; set; } = true;
        public bool QueueNotifyOnCalled { get; set; } = true;

        // Templates. These defaults mirror NotificationSettings' server-side constants and only
        // ever show for an organization that has no settings row yet — a saved row always wins.
        public string? SmsTokenCreatedTemplate { get; set; } =
            "{OrganizationName}: ticket {TicketNumber} issued at {BranchName}. You are #{Position} in line (about {EstimatedWaitMinutes} min).";
        public string? SmsTokenCalledTemplate { get; set; } =
            "{OrganizationName}: it's your turn. Ticket {TicketNumber} - please proceed to counter {CounterNumber} at {BranchName}.";
        public string? SmsReminderTemplate { get; set; } =
            "{OrganizationName}: almost your turn. Ticket {TicketNumber} is #{Position} in line at {BranchName}. Please be ready.";
        public string? EmailTokenCreatedSubject { get; set; } = "Your ticket {TicketNumber} at {BranchName}";
        public string? EmailTokenCreatedTemplate { get; set; } =
            "Your ticket number is <strong>{TicketNumber}</strong>.\nYou are currently number {Position} in the queue at {BranchName}.\nThe estimated wait is about {EstimatedWaitMinutes} minutes.\nWe'll message you again when your turn is close.";
        public string? EmailReminderSubject { get; set; } = "Almost your turn - ticket {TicketNumber}";
        public string? EmailReminderTemplate { get; set; } =
            "Ticket <strong>{TicketNumber}</strong> is now number {Position} in the queue at {BranchName}.\nPlease make your way to the waiting area so you don't miss your turn.";
        public string? EmailTokenCalledSubject { get; set; } = "It's your turn - ticket {TicketNumber}";
        public string? EmailTokenCalledTemplate { get; set; } =
            "Ticket <strong>{TicketNumber}</strong> is being called now at counter <strong>{CounterNumber}</strong>, {BranchName}.\nPlease proceed to the counter.";
    }

    private class TestResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
    }
}

<style>
    /* ── Delivery log ─────────────────────────────────────────────────────────────────────
       Token-only, so no [data-theme="light"] block is needed. Severity is carried by colour
       AND an icon, never by colour alone. */
    .dl-head-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

    .dl-summary {
        display: flex; gap: 18px; flex-wrap: wrap;
        padding: 10px 0 14px;
        font-size: var(--qm-text-base);
        color: var(--qm-text-secondary);
    }
    .dl-summary strong { color: var(--qm-text-primary); font-variant-numeric: tabular-nums; }

    /* The table scrolls, the page does not — see CLAUDE.md's sideways-scrolling rule. */
    .dl-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-md);
    }

    .dl-table { width: 100%; border-collapse: collapse; font-size: var(--qm-text-base); }
    .dl-table th {
        text-align: left;
        padding: 10px 12px;
        background: var(--qm-bg-elevated);
        border-bottom: 1px solid var(--qm-border);
        font-size: var(--qm-text-xs);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--qm-text-muted);
        white-space: nowrap;
    }
    .dl-table td { padding: 10px 12px; border-bottom: 1px solid var(--qm-border); vertical-align: top; color: var(--qm-text-secondary); }
    .dl-table tr:last-child td { border-bottom: none; }

    /* Tinted from --qm-primary-rgb's status counterpart so it follows the theme with no override. */
    .dl-row-failed { background: rgba(var(--qm-danger-rgb), 0.06); }

    .dl-when { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .dl-recipient { font-family: var(--qm-font-mono, ui-monospace, monospace); white-space: nowrap; }
    .dl-title { color: var(--qm-text-primary); max-width: 280px; }

    .dl-ok { color: var(--qm-success); display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .dl-bad { color: var(--qm-danger); display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .dl-reason, .dl-retries { display: block; margin-top: 3px; font-size: var(--qm-text-sm); color: var(--qm-text-muted); }

    .dl-empty { text-align: center; padding: var(--qm-empty-pad); color: var(--qm-text-muted); }
    .dl-empty i { font-size: var(--qm-empty-icon); display: block; margin-bottom: 10px; }
    .dl-empty p { margin: 0; font-size: var(--qm-text-base); }

    @@media (max-width: 640px) {
        .qm-admin-section-header { flex-wrap: wrap; }
        .dl-head-actions { width: 100%; }
    }
</style>
