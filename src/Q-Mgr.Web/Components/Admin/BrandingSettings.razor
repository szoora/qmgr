@inject IBrandContext Brand
@inject IOrganizationApiService OrganizationApi
@inject IToastService NotificationService
@inject IAuthService AuthService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inherits BranchAwareComponentBase
@inject System.Text.Json.JsonSerializerOptions JsonOptions
@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Web.Services

@if (!Embedded)
{
    <QPageTitle Text="Branding Settings" />
}

<div class="admin-page">
    <QPageActions Embedded="@Embedded">
        <Title>
            <h1>Branding Settings</h1>
            <p class="subtitle">Customize the look of your public kiosk and display screens with your own logo and colors</p>
        </Title>
        <Actions>
            @if (canEdit)
            {
                <QButton Text="Save Settings" Icon="check-lg" Variant="primary" OnClick="@SaveSettings" Disabled="@(isSaving || isLoading || !settings.WhiteLabelEntitled)" />
            }
        </Actions>
    </QPageActions>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
        </div>
    }
    else
    {
        <QCard Icon="moon-fill" Title="Display Theme" Subtitle="Controls the look of your public customer-display and kiosk screens — available on every plan">
            <div class="theme-picker">
                <button type="button" class="theme-option @(displayTheme == "dark" ? "selected" : "")" @onclick='@(() => SetDisplayTheme("dark"))' disabled="@(!canEdit || isSavingTheme)">
                    <div class="theme-preview theme-preview-dark">
                        <span class="preview-bar"></span>
                        <span class="preview-bar short"></span>
                    </div>
                    <span>Dark</span>
                </button>
                <button type="button" class="theme-option @(displayTheme == "light" ? "selected" : "")" @onclick='@(() => SetDisplayTheme("light"))' disabled="@(!canEdit || isSavingTheme)">
                    <div class="theme-preview theme-preview-light">
                        <span class="preview-bar"></span>
                        <span class="preview-bar short"></span>
                    </div>
                    <span>Light</span>
                </button>
            </div>
        </QCard>

        @if (!settings.WhiteLabelEntitled)
        {
            <QCard Icon="lock-fill" Title="White-Label Branding" Subtitle="Not available on your current plan">
                <div class="upgrade-notice">
                    <p>@(featureUnavailableMessage ?? "Add the Communication module to customize your logo and colors.")</p>
                    <QButton Text="View Plans" Icon="arrow-up-circle-fill" Variant="primary" OnClick="@(() => Navigation.NavigateTo(BillingLinks.Modules))" />
                </div>
            </QCard>
        }
        <div class="settings-container">
            <QCard Icon="toggle-on" Title="Enable White-Label Branding" Subtitle="Turn your custom branding on or off without losing your saved settings">
                <div class="toggle-group">
                    <QSwitch @bind-Value="settings.WhitelabelEnabled" Disabled="@(!settings.WhiteLabelEntitled)" aria-label="White-labeling" />
                    <div class="toggle-info">
                        <span class="toggle-label">White-labeling @(settings.WhitelabelEnabled ? "on" : "off")</span>
                        <small>When off, every screen uses the standard Q-Mgr look whatever is set below.</small>
                    </div>
                </div>

                @* A WARNING, not a hint, so it stays on the page: it changes what the reader does.
                   Without it somebody picks a palette, is told "Saved", and sees nothing change —
                   anywhere, ever — because the switch above is off. The colours really were saved;
                   they are simply not worn. That was the report. *@
                @if (settings.WhiteLabelEntitled && !settings.WhitelabelEnabled)
                {
                    <div class="wl-off" role="alert">
                        <QIcon Name="exclamation-triangle-fill" />
                        <span>
                            Everything below is saved, but <strong>none of it is shown</strong> while this is off —
                            not your logo, not your colours, not your name. Switch it on to see them.
                        </span>
                    </div>
                }
            </QCard>

            <QCard Icon="image-fill" Title="Logo &amp; Favicon" Subtitle="Shown wherever your organisation is named — the app, your kiosk and display screens, and the emails you send">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Brand Name</label>
                        <QInput @bind-Value="@settings.BrandName" Placeholder="Your Company Name" Disabled="@(!settings.WhiteLabelEntitled)" />
                        <small>Overrides "Q-Mgr" wherever the product names itself</small>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(assetError))
                {
                    <div class="validation-error">@assetError</div>
                }

                <div class="asset-grid">
                    @* THE LIMITS ARE STATED BEFORE THE PICKER, not after a refusal: a school on a
                       phone should not spend 4 MB of their bundle to be told no. QFileUpload also
                       refuses an over-sized file in the browser — and the server refuses it again
                       regardless, because a client-side check is a courtesy, never a control. *@
                    <div class="asset-tile">
                        <div class="asset-head">
                            <strong>Logo</strong>
                            <span>PNG, JPEG or WebP. Up to 1 MB, up to 2048px a side.</span>
                        </div>
                        <div class="asset-preview">
                            @if (!string.IsNullOrWhiteSpace(settings.LogoUrl))
                            {
                                <img src="@settings.LogoUrl" alt="Your logo" />
                            }
                            else
                            {
                                <span class="asset-empty">No logo yet</span>
                            }
                        </div>
                        <div class="asset-actions">
                            <QFileUpload UploadUrl="@($"api/v1/organizations/{organizationId}/branding/logo")"
                                         Accept="image/png,image/jpeg,image/webp" Multiple="false"
                                         MaxSizeBytes="1048576" CompressImages="false"
                                         HintText="PNG, JPEG or WebP, up to 1 MB"
                                         OnUploaded="@(r => OnAssetUploaded(r, isFavicon: false))"
                                         OnError="@(m => { assetError = m; return Task.CompletedTask; })" />
                            @if (!string.IsNullOrWhiteSpace(settings.LogoUrl))
                            {
                                <QButton Text="Remove" Icon="trash" Variant="ghost" Size="sm" Disabled="@isSavingAsset" OnClick="@(() => RemoveAsset(false))" />
                            }
                        </div>
                    </div>

                    <div class="asset-tile">
                        <div class="asset-head">
                            <strong>Favicon</strong>
                            <span>Square PNG, JPEG or WebP. 64–1024px, up to 512 KB.</span>
                        </div>
                        <div class="asset-preview">
                            @if (!string.IsNullOrWhiteSpace(settings.FaviconUrl))
                            {
                                <img src="@settings.FaviconUrl" alt="Your favicon" />
                            }
                            else
                            {
                                <span class="asset-empty">No favicon yet</span>
                            }
                        </div>
                        @* A favicon is seen at 16px and at 32px and almost never at its real size.
                           This is where a detailed crest turns to mush, so it is shown at the sizes
                           it will actually be used at, beside the full one. *@
                        @if (!string.IsNullOrWhiteSpace(settings.FaviconUrl))
                        {
                            <div class="favicon-sizes">
                                <span><img src="@settings.FaviconUrl" alt="" style="width:16px;height:16px;" /> 16px</span>
                                <span><img src="@settings.FaviconUrl" alt="" style="width:32px;height:32px;" /> 32px</span>
                            </div>
                        }
                        <div class="asset-actions">
                            <QFileUpload UploadUrl="@($"api/v1/organizations/{organizationId}/branding/favicon")"
                                         Accept="image/png,image/jpeg,image/webp" Multiple="false"
                                         MaxSizeBytes="524288" CompressImages="false"
                                         HintText="Square image, up to 512 KB"
                                         OnUploaded="@(r => OnAssetUploaded(r, isFavicon: true))"
                                         OnError="@(m => { assetError = m; return Task.CompletedTask; })" />
                            @if (!string.IsNullOrWhiteSpace(settings.FaviconUrl))
                            {
                                <QButton Text="Remove" Icon="trash" Variant="ghost" Size="sm" Disabled="@isSavingAsset" OnClick="@(() => RemoveAsset(true))" />
                            }
                        </div>
                    </div>
                </div>

                <p class="asset-note">SVG is not accepted. An SVG can carry script, and a logo has to be served as an image to be a logo — a 512&times;512 PNG is what every browser wants for a favicon anyway.</p>

                @* KEPT, collapsed: tenants already on a typed link would lose their logo the day
                   this shipped if the field went away. New work should use the picker above. *@
                <details class="asset-links">
                    <summary>Use a link instead</summary>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Logo URL</label>
                            <QInput @bind-Value="@settings.LogoUrl" Placeholder="https://your-domain.com/logo.png" Disabled="@(!settings.WhiteLabelEntitled)" />
                        </div>
                        <div class="form-group">
                            <label>Favicon URL</label>
                            <QInput @bind-Value="@settings.FaviconUrl" Placeholder="https://your-domain.com/favicon.png" Disabled="@(!settings.WhiteLabelEntitled)" />
                        </div>
                    </div>
                    <p class="form-hint">Saved with the Save Settings button, like the rest of this page. An uploaded file replaces whatever is here.</p>
                </details>
            </QCard>

            @* Read-only on purpose: a tenant does not self-serve a domain, because issuing the
               certificate touches the web server itself. Shown so a school that HAS one can see it
               is live, and so one that wants one knows who to ask. *@
            <QCard Icon="globe2" Title="Your Own Web Address" Subtitle="Reach this system at your organisation's own domain">
                @if (!string.IsNullOrWhiteSpace(settings.CustomDomain))
                {
                    <div class="domain-live">
                        <QIcon Name="check-circle-fill" />
                        <span>Your staff can sign in at <strong>@settings.CustomDomain</strong>. The sign-in page there carries your name and logo, and does not offer to create a new organisation.</span>
                    </div>
                }
                else
                {
                    <p class="settings-hint">Your staff sign in at this platform's address today. To use something like <strong>dashboard.yourschool.com</strong> instead, ask SACC to set this up &mdash; it needs a DNS record on your side and a certificate on ours.</p>
                }
            </QCard>

            <QCard Icon="stars" Title="Color Palettes" Subtitle="Quick-start palettes for common business types — click one to apply instantly">
                <div class="palette-grid">
                    @foreach (var palette in Palettes)
                    {
                        var isSelected = settings.PrimaryColor == palette.Primary && settings.SecondaryColor == palette.Secondary && settings.AccentColor == palette.Accent;
                        <button type="button" class="palette-swatch @(isSelected ? "selected" : "")" disabled="@(!settings.WhiteLabelEntitled || isSaving)" @onclick="@(() => ApplyPalette(palette))">
                            <div class="palette-colors">
                                <span class="palette-chip" style="background:@palette.Primary;"></span>
                                <span class="palette-chip" style="background:@palette.Secondary;"></span>
                                <span class="palette-chip" style="background:@palette.Accent;"></span>
                            </div>
                            <span class="palette-name">@palette.Name</span>
                            <span class="palette-business-type">@palette.BusinessType</span>
                        </button>
                    }
                </div>
            </QCard>

            <QCard Icon="palette-fill" Title="Colors" Subtitle="Applied as CSS accent colors on kiosk and display screens">
                <div class="form-grid color-grid">
                    <div class="form-group">
                        <label>Primary Color</label>
                        <div class="color-input-row">
                            <input type="color" value="@(settings.PrimaryColor ?? "#8c2f52")" @onchange="@(e => settings.PrimaryColor = (string?)e.Value)" disabled="@(!settings.WhiteLabelEntitled)" />
                            <QInput @bind-Value="@settings.PrimaryColor" Placeholder="#8c2f52" Disabled="@(!settings.WhiteLabelEntitled)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Secondary Color</label>
                        <div class="color-input-row">
                            <input type="color" value="@(settings.SecondaryColor ?? "#47393f")" @onchange="@(e => settings.SecondaryColor = (string?)e.Value)" disabled="@(!settings.WhiteLabelEntitled)" />
                            <QInput @bind-Value="@settings.SecondaryColor" Placeholder="#47393f" Disabled="@(!settings.WhiteLabelEntitled)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Accent Color</label>
                        <div class="color-input-row">
                            <input type="color" value="@(settings.AccentColor ?? "#0d9488")" @onchange="@(e => settings.AccentColor = (string?)e.Value)" disabled="@(!settings.WhiteLabelEntitled)" />
                            <QInput @bind-Value="@settings.AccentColor" Placeholder="#0d9488" Disabled="@(!settings.WhiteLabelEntitled)" />
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(validationError))
                {
                    <div class="validation-error">@validationError</div>
                }
            </QCard>

            <QCard Icon="megaphone-fill" Title="Display Banner" Subtitle="A scrolling message banner shown on Customer Display and Full-Screen Signage — opt-in, off by default">
                <div class="toggle-group">
                    <QSwitch @bind-Value="banner.Enabled" aria-label="Banner" />
                    <div class="toggle-info">
                        <span class="toggle-label">Banner @(banner.Enabled ? "enabled" : "disabled")</span>
                        <small>Shown on both /queue/display and /display/signage for this branch</small>
                    </div>
                </div>

                <div class="form-grid" style="margin-top:20px;">
                    <div class="form-group">
                        <label>Position</label>
                        <div class="banner-radio-row">
                            <label class="banner-radio"><input type="radio" name="banner-position" checked="@(banner.Position == DisplayBannerPosition.Bottom)" @onchange="@(() => banner.Position = DisplayBannerPosition.Bottom)" /> Bottom</label>
                            <label class="banner-radio"><input type="radio" name="banner-position" checked="@(banner.Position == DisplayBannerPosition.Top)" @onchange="@(() => banner.Position = DisplayBannerPosition.Top)" /> Top</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Scroll Direction</label>
                        <div class="banner-radio-row">
                            <label class="banner-radio"><input type="radio" name="banner-direction" checked="@(banner.Direction == DisplayBannerDirection.RightToLeft)" @onchange="@(() => banner.Direction = DisplayBannerDirection.RightToLeft)" /> Right to left</label>
                            <label class="banner-radio"><input type="radio" name="banner-direction" checked="@(banner.Direction == DisplayBannerDirection.LeftToRight)" @onchange="@(() => banner.Direction = DisplayBannerDirection.LeftToRight)" /> Left to right</label>
                        </div>
                        <small>Use left-to-right for RTL-language message content</small>
                    </div>
                </div>

                <div class="form-grid" style="margin-top:20px;">
                    <div class="form-group">
                        <label>Speed (seconds per loop)</label>
                        <QInput TValue="int" @bind-Value="banner.SpeedSeconds" Type="number" Min="5" Max="120" />
                        <small>Lower is faster</small>
                    </div>
                </div>

                @* THE DEFAULT IS THE TENANT'S OWN BRAND, stored as null rather than a hex — so it
                   follows a rebrand, which a stored copy never would. These were hard-coded to
                   Q-Mgr's wine, so every school's ticker was wine whatever else they had branded.
                   Same shape as a welfare category's colour. *@
                <div class="form-grid color-grid" style="margin-top:20px;">
                    <div class="form-group">
                        <label>Background</label>
                        <div class="color-input-row">
                            <QCheckbox Value="@(string.IsNullOrWhiteSpace(banner.BackgroundColor))"
                                       ValueChanged="@(on => banner.BackgroundColor = on ? null : (settings.PrimaryColor ?? "#8c2f52"))"
                                       Label="Use our brand colour" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(banner.BackgroundColor))
                        {
                            <div class="color-input-row">
                                <input type="color" value="@banner.BackgroundColor" @onchange="@(e => banner.BackgroundColor = (string?)e.Value ?? banner.BackgroundColor)" />
                                <QInput @bind-Value="banner.BackgroundColor" Placeholder="#8c2f52" />
                            </div>
                        }
                    </div>
                    <div class="form-group">
                        <label>Text</label>
                        <div class="color-input-row">
                            <QCheckbox Value="@(string.IsNullOrWhiteSpace(banner.TextColor))"
                                       ValueChanged="@(on => banner.TextColor = on ? null : "#ffffff")"
                                       Label="Choose it for me"
                                       Hint="Worked out from the background so it stays readable — including on a pale brand colour, where white would not be." />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(banner.TextColor))
                        {
                            <div class="color-input-row">
                                <input type="color" value="@banner.TextColor" @onchange="@(e => banner.TextColor = (string?)e.Value ?? banner.TextColor)" />
                                <QInput @bind-Value="banner.TextColor" Placeholder="#ffffff" />
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group" style="margin-top:20px;">
                    <label>Messages</label>
                    @for (var i = 0; i < banner.Messages.Count; i++)
                    {
                        var index = i;
                        <div class="banner-message-row">
                            <QInput TValue="string" Value="@banner.Messages[index]" ValueChanged="@(v => banner.Messages[index] = v ?? "")" Placeholder="Message text" />
                            <QButton Icon="trash-fill" Variant="danger" Size="sm" OnClick="@(() => banner.Messages.RemoveAt(index))" />
                        </div>
                    }
                    <QButton Text="Add Message" Icon="plus-lg" Variant="secondary" Size="sm" OnClick="@(() => banner.Messages.Add(""))" />
                </div>

                <div class="edit-actions" style="margin-top:20px;">
                    <QButton Text="Save Banner Settings" Icon="check-lg" Variant="primary" OnClick="@SaveBanner" Disabled="@isSavingBanner" />
                </div>
            </QCard>
        </div>
    }
</div>

<style>.header-content h1 {
        margin: 0 0 8px;
        color: var(--qm-text-primary);
    }
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 80px;
    }

    .settings-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group label {
        font-size: var(--qm-text-base);
        font-weight: 500;
        color: var(--qm-text-primary);
    }

    .form-group small {
        font-size: var(--qm-text-sm);
        color: var(--qm-text-secondary);
    }

    .color-grid {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .color-input-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .color-input-row input[type="color"] {
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        cursor: pointer;
        flex-shrink: 0;
    }

    .edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .asset-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: var(--qm-block-gap);
    }

    .asset-tile {
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: var(--q-row-gap);
    }

    .asset-head { display: flex; flex-direction: column; gap: 2px; }
    .asset-head span { font-size: var(--qm-text-sm); color: var(--qm-text-secondary); }

    /* A checkerboard, so a transparent PNG reads as transparent rather than as white-on-white. */
    .asset-preview {
        min-height: 88px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--qm-radius-md);
        background-color: #ffffff;
        background-image:
            linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
            linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
            linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
        background-size: 16px 16px;
        background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    }

    .asset-preview img { max-height: 72px; max-width: 100%; object-fit: contain; }
    .asset-empty { font-size: var(--qm-text-sm); color: #6b6b6b; }

    .favicon-sizes { display: flex; gap: 14px; align-items: center; font-size: var(--qm-text-xs); color: var(--qm-text-secondary); }
    .favicon-sizes span { display: inline-flex; align-items: center; gap: 5px; }

    .asset-actions { display: flex; align-items: flex-start; gap: var(--q-row-gap); flex-wrap: wrap; }
    .asset-note { font-size: var(--qm-text-sm); color: var(--qm-text-secondary); margin: var(--qm-block-gap) 0 0; }
    .asset-links { margin-top: var(--qm-block-gap); }
    .asset-links summary { cursor: pointer; font-size: var(--qm-text-sm); color: var(--qm-text-secondary); }
    .asset-links .form-grid { margin-top: var(--qm-field-gap); }

    .domain-live { display: flex; align-items: center; gap: 8px; color: var(--qm-text-primary); }

    .palette-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: var(--q-row-gap);
    }

    .palette-swatch {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--q-row-gap);
        font-size: var(--q-control-font-sm);
        padding: 14px 10px;
        background: var(--qm-bg-card);
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        cursor: pointer;
        transition: var(--qm-transition-fast, all 0.15s ease);
    }

    .palette-swatch:hover:not(:disabled) {
        border-color: var(--qm-primary);
    }

    .palette-swatch.selected {
        border-color: var(--qm-primary);
        background: var(--qm-primary-light);
    }

    .palette-swatch:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .palette-colors {
        display: flex;
    }

    .palette-chip {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid var(--qm-bg-card);
        box-shadow: 0 0 0 1px var(--qm-border);
    }

    .palette-chip + .palette-chip {
        margin-left: -8px;
    }

    .palette-name {
        font-size: var(--qm-text-base);
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .palette-business-type {
        font-size: var(--qm-text-xs);
        color: var(--qm-text-secondary);
        text-align: center;
    }

    .banner-radio-row {
        display: flex;
        gap: 20px;
    }

    .banner-radio {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: var(--qm-text-base);
        color: var(--qm-text-primary);
        cursor: pointer;
    }

    .banner-message-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .banner-message-row .q-input-wrapper {
        flex: 1;
    }

    .theme-picker {
        display: flex;
        gap: var(--q-row-gap);
    }

    .theme-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--q-row-gap);
        padding: 12px;
        background: none;
        border: 2px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        cursor: pointer;
        transition: var(--qm-transition-fast, all 0.15s ease);
        font-size: var(--q-control-font-sm);
        font-weight: 500;
        color: var(--qm-text-primary);
    }

    .theme-option:hover:not(:disabled) {
        border-color: var(--qm-primary);
    }

    .theme-option.selected {
        border-color: var(--qm-primary);
        background: var(--qm-primary-light);
    }

    .theme-option:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .theme-preview {
        width: 96px;
        height: 60px;
        border-radius: var(--qm-radius-md);
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .theme-preview-dark {
        background: #141414;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .theme-preview-light {
        background: #f8fafc;
        border: 1px solid rgba(0, 0, 0, 0.1);
    }

    .theme-preview .preview-bar {
        display: block;
        height: 6px;
        border-radius: var(--qm-radius-sm);
        background: var(--qm-primary);
        width: 100%;
