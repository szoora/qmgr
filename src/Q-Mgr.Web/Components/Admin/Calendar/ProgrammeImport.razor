    // ---- History and undo ------------------------------------------------------------------------------------

    private async Task OpenHistoryAsync()
    {
        historyOpen = true;
        jobs = null;
        try { jobs = await ImportApi.GetJobsAsync(branchId); }
        catch (Exception ex)
        {
            jobs = new();
            Toast.Notify(ToastSeverity.Error, "Could not load the import history", ex.Message);
        }
    }

    private void AskUndo(Guid jobId) => undoJobId = jobId;

    private async Task UndoAsync()
    {
        if (undoJobId is not { } jobId) return;
        working = true;
        try
        {
            var result = await ImportApi.UndoAsync(branchId, jobId);
            var text = $"{Plural(result.EventsRemoved, "event", "events")} removed and {Plural(result.DutiesRemoved, "duty slot", "duty slots")} cancelled.";
            if (result.DutiesKept > 0) text += $" {Plural(result.DutiesKept, "was", "were")} kept because the register had been taken.";
            if (result.UpdatesRestored > 0) text += $" {Plural(result.UpdatesRestored, "updated row", "updated rows")} put back as they were.";
            Toast.Notify(ToastSeverity.Success, "Import undone", text);
            // Rows the import had UPDATED that somebody has changed since keep their change, and are named.
            if (result.UpdatesLeft.Count > 0)
                Toast.Notify(ToastSeverity.Warning, $"{Plural(result.UpdatesLeft.Count, "row", "rows")} left as they are",
                    string.Join("; ", result.UpdatesLeft.Take(6)) + (result.UpdatesLeft.Count > 6 ? $"; and {result.UpdatesLeft.Count - 6} more" : "") + ".");
            undoJobId = null;
            if (committed?.JobId == jobId) Reset();
            if (historyOpen) jobs = await ImportApi.GetJobsAsync(branchId);
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not undo the import", ex.Message);
        }
        finally { working = false; }
    }

    // ---- Small helpers -----------------------------------------------------------------------------------------

    private string StepClass(Stage s) => s == stage ? "pi-step--active" : s < stage ? "pi-step--done" : string.Empty;

    private static string FileIcon(ProgrammeFileReading f) => f.Refusal != null ? "file-earmark-x" : f.Format switch
    {
        "pdf" => "file-earmark-pdf",
        "sheet" => "file-earmark-spreadsheet",
        _ => "file-earmark-word"
    };

    private static string FileSubtitle(ProgrammeFileReading f)
    {
        if (f.Refusal != null) return "Could not be read";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(f.Title)) parts.Add(ProgrammeTableParser.TitleCase(f.Title));
        if (f.Theme != null) parts.Add($"Theme: {f.Theme}");
        return string.Join(" · ", parts);
    }

    private static string Trim(string? value, int max)
    {
        var t = (value ?? string.Empty).Trim();
        return t.Length <= max ? t : t[..max];
    }

    private static string? TrimOrNull(string? value, int max) => string.IsNullOrWhiteSpace(value) ? null : Trim(value, max);
}
