    private IEnumerable<ProgrammeCandidate> EventRows()
    {
        var meetings = MeetingRows().ToHashSet();
        return Live().Where(c => c.Kind == ProgrammeRowKind.Event || (c.Kind == ProgrammeRowKind.Meeting && !meetings.Contains(c)));
