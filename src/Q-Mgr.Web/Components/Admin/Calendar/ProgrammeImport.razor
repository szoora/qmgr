@* ---- Import health (E10): what an import left for somebody to finish ---------------------------------------- *@
<QModal Visible="@(health != null || healthLoading)" VisibleChanged="@(v => { if (!v) { health = null; healthLoading = false; } })" Title="What needs attention" Icon="clipboard-pulse" Size="lg">
    <ChildContent>
        @if (healthLoading)
        {
            <div class="pi-loading"><QSpinner Size="sm" /><span>Reading the import...</span></div>
        }
        else if (health != null)
        {
            <p class="pi-muted">@string.Join(", ", health.SourceFiles) · imported @QDateFormat.DT(health.CreatedAt.ToLocalTime())</p>
            @if (!health.MeetingsWithoutRegister.Any() && !health.RegistersWithoutRecorder.Any() && !health.Refused.Any())
            {
                <QEmptyState Icon="check-circle" Title="Nothing needs attention" Text="Every meeting has a register and somebody to take it, and no row was refused." />
            }
            @if (health.MeetingsWithoutRegister.Any())
            {
                <h3 class="pi-sub">Meetings with no register</h3>
                <p class="pi-muted">Open one and press <strong>Give it a register</strong> to add one — nothing needs importing again.</p>
                <table class="data-table q-stack" id="pi-health-meetings">
                    <thead><tr><th>Meeting</th><th>When</th><th>Why</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in health.MeetingsWithoutRegister)
                        {
                            <tr class="@(item.InPast ? "row-muted" : "")">
                                <td>@item.Title @if (!string.IsNullOrWhiteSpace(item.ResponsibleText)) { <div class="cell-sub">@item.ResponsibleText</div> }</td>
                                <td>@QDateFormat.D(item.Date)@(item.StartTime != null ? $", {item.StartTime}" : "")</td>
                                <td>@item.Reason</td>
                                <td class="row-actions">
                                    <QButton Text="Open" Size="sm" Variant="ghost" OnClick="@(() => Navigation.NavigateTo($"/calendar?tab=calendar&view=month&scope=all&date={item.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}&event={item.EventId}"))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (health.RegistersWithoutRecorder.Any())
            {
                <h3 class="pi-sub">Registers nobody is named to take</h3>
                <ul class="pi-issues pi-issues--plain" id="pi-health-recorders">
                    @foreach (var item in health.RegistersWithoutRecorder)
                    {
                        <li>@item.Title, @QDateFormat.D(item.Date) @item.StartTime — @item.Reason
                            <QButton Text="Open the register" Size="sm" Variant="ghost" OnClick="@(() => Navigation.NavigateTo($"/admin/staff/duties/{item.DutyId}/register"))" /></li>
                    }
                </ul>
            }
            @if (health.Refused.Any())
            {
                <h3 class="pi-sub">Refused</h3>
                <ul class="pi-issues pi-issues--plain" id="pi-health-refused">
                    @foreach (var item in health.Refused) { <li>@item.Title, @QDateFormat.D(item.Date): @item.Reason</li> }
                </ul>
            }
            else if (!health.RefusalsRecorded)
            {
                <p class="pi-muted">Imports made before 26 Sep 2026 did not keep the rows they refused.</p>
            }
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@(() => { health = null; healthLoading = false; })" />
    </FooterContent>
</QModal>

<QModal Visible="@(undoJobId != null)" VisibleChanged="@(v => { if (!v) undoJobId = null; })" Title="Undo this import?" Icon="arrow-counterclockwise">
    <ChildContent>
        <p>Its events are removed and its meetings and rota slots cancelled. A meeting or slot whose register has been taken is kept — a register is history. So is anything a later import found already here and relies on.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Keep it" Variant="ghost" OnClick="@(() => undoJobId = null)" />
        <QButton Text="Undo the import" Variant="danger" Loading="@working" OnClick="@UndoAsync" id="pi-undo-confirm" />
    </FooterContent>
</QModal>

