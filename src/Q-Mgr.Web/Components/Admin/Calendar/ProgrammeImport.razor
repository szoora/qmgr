@* No @page: the Import SECTION of the Calendar hub at /calendar?tab=import. *@
@using System.Globalization
@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Application.Import.Documents
@using QMgr.Application.Import.Programme
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@inherits BranchAwareComponentBase
@inject IProgrammeImportApiService ImportApi
@inject IJSRuntime JS
@inject IToastService Toast

@*
    The term programme import (plan TERM_PROGRAMME_CALENDAR_AND_GATES §4–§8). A school's own Word, PDF and Excel
    documents — the activities of the term, the beginning-of-term programme, the schedule of meetings, the staff
    duty rota and the administrators' weekly rota — become calendar events, staff meetings with registers and rota
    slots, in five steps: choose the files, see how each table was read, answer what must be decided, check with
    the server, and confirm once.

    Everything up to the last press happens here. The readers and parsers are the Shared ones (one home each);
    the SERVER re-checks every row it is sent and is the only thing that writes. The page refuses first what the
    server would refuse — a meeting with no time, a rota row with nobody matched, a row with no date — so the one
    confirmation never comes back as a wall of refusals.
*@

<QPageActions Embedded="@Embedded">
    <Title>
        <h1>Import the term programme</h1>
    </Title>
    <Actions>
        @if (stage != Stage.Choose && stage != Stage.Done)
        {
            <QButton Text="Start again" Icon="arrow-counterclockwise" Variant="ghost" OnClick="@Reset" id="pi-restart" />
        }
        <QButton Text="Import history" Icon="clock-history" Variant="secondary" OnClick="@OpenHistoryAsync" Disabled="@(branchId == Guid.Empty)" id="pi-history" />
    </Actions>
</QPageActions>

@if (branchId == Guid.Empty)
{
    <QEmptyState Icon="building" Title="No branch selected" Text="Choose a branch from the header first." />
}
else if (loadError != null)
{
    <QEmptyState Icon="exclamation-triangle" Title="Import not available" Text="@loadError" />
}
else if (ctx == null)
{
    <div class="pi-loading"><QSpinner Size="lg" /><span>Loading the staff list...</span></div>
}
else
{
    <ol class="pi-steps" aria-label="Import steps">
        <li class="@StepClass(Stage.Choose)"><span>1</span> Choose files</li>
        <li class="@StepClass(Stage.Understand)"><span>2</span> How they were read</li>
        <li class="@StepClass(Stage.Check)"><span>3</span> Check</li>
        <li class="@StepClass(Stage.Confirm)"><span>4</span> Confirm</li>
        <li class="@StepClass(Stage.Done)"><span>5</span> Done</li>
    </ol>

    @if (!ctx.CanImportDuties && ctx.DutiesRefusal != null)
    {
        <p class="pi-note" id="pi-duties-refusal"><QIcon Name="info-circle" /> <span>@ctx.DutiesRefusal</span></p>
    }

    @* ---------------- 1. Choose files ---------------- *@
    @if (stage == Stage.Choose)
    {
        <QCard Title="Choose the documents" Icon="file-earmark-arrow-up"
               Hint="Choose every document at once, so the checks can compare them: a date two documents disagree on, the same event in both, a person written two ways.">
            <label class="pi-drop" for="@InputId">
                <QIcon Name="files" />
                <span class="pi-drop-main">Choose the term's documents</span>
                <span class="pi-drop-sub">.docx, .doc, text .pdf, .xlsx, .xls or .csv — read here; nothing is saved until the last step</span>
            </label>
            <InputFile id="@InputId" OnChange="OnFilesChosen" multiple accept=".docx,.doc,.pdf,.xlsx,.xls,.csv" class="pi-file" />
            @if (reading)
            {
                <div class="pi-loading"><QSpinner Size="sm" /><span>Reading @readingName...</span></div>
            }
        </QCard>
    }

    @* ---------------- 2. How each table was read ---------------- *@
    @if (stage == Stage.Understand)
    {
        @foreach (var file in files)
        {
            <QCard Class="pi-file-card" Title="@file.FileName" Icon="@FileIcon(file)" Subtitle="@FileSubtitle(file)">
                @if (file.Refusal != null)
                {
                    <p class="pi-refusal" role="alert">@file.Refusal</p>
                }
                else if (file.Tables.Count == 0)
                {
                    <p class="pi-refusal">No table was found in this document.</p>
                }
                else
                {
                    @foreach (var table in file.Tables)
                    {
                        <div class="pi-table" data-file="@file.FileName" data-kind="@table.Kind">
                            <div class="pi-table-head">
                                <strong>Table @(table.TableIndex + 1)</strong>
                                <span class="pi-muted">@table.DataRows rows</span>
                                <div class="pi-kind">
                                    <QSelect TValue="ProgrammeTableKind" TItem="KindOption" Items="@KindOptions" Value="@table.Kind"
                                             ValueChanged="@(k => OnKindChangedAsync(file, table, k))" ValueSelector="@(o => o.Kind)" TextSelector="@(o => o.Label)" />
                                </div>
                                <QChip Text="@($"{Math.Round(table.Confidence * 100)}% sure")" Variant="@(table.Confidence >= 0.75 ? "success" : table.Confidence >= 0.5 ? "warning" : "danger")" Size="sm" />
                            </div>
                            <ul class="pi-reasons">
                                @foreach (var reason in table.Reasons) { <li>@reason</li> }
                            </ul>
                            @if (table.HeaderRow >= 0 && table.Kind is not (ProgrammeTableKind.Ignore or ProgrammeTableKind.Unknown))
                            {
                                <div class="pi-columns">
                                    @for (var c = 0; c < table.Headers.Count; c++)
                                    {
                                        var col = c;
                                        if (string.IsNullOrWhiteSpace(table.Headers[col])) { continue; }
                                        <div class="pi-column">
                                            <span class="pi-column-name">@table.Headers[col]</span>
                                            <QSelect TValue="ProgrammeColumnRole" TItem="RoleOption" Items="@RoleOptions" Value="@table.Roles[col]"
                                                     ValueChanged="@(r => OnRoleChangedAsync(file, table, col, r))" ValueSelector="@(o => o.Role)" TextSelector="@(o => o.Label)" />
                                        </div>
                                    }
                                </div>
                                <p class="pi-muted">@TableSummary(file, table)</p>
                            }
                        </div>
                    }
                    @if (file.Notes.Count > 0)
                    {
                        <ul class="pi-reasons">@foreach (var n in file.Notes) { <li>@n</li> }</ul>
                    }
                }
            </QCard>
        }
        <div class="form-actions">
            <QButton Text="Back" Variant="ghost" OnClick="@Reset" />
            <QButton Text="Continue" Icon="arrow-right" Variant="primary" OnClick="@GoToCheck" Disabled="@(!files.Any(f => f.Candidates.Count > 0))" id="pi-continue" />
        </div>
    }

    @* ---------------- 3. Check ---------------- *@
    @if (stage == Stage.Check && checks != null)
    {
        <QStatRow>
            <QStatTile Label="Events" Value="@EventRows().Count().ToString(CultureInfo.InvariantCulture)" Icon="calendar-event" />
            <QStatTile Label="Meetings" Value="@MeetingRows().Count().ToString(CultureInfo.InvariantCulture)" Icon="people" />
            <QStatTile Label="Rota slots" Value="@RotaRows().Count().ToString(CultureInfo.InvariantCulture)" Icon="shield-check" />
            <QStatTile Label="Must decide" Value="@OpenMustDecide.ToString(CultureInfo.InvariantCulture)" Icon="exclamation-diamond" Variant="@(OpenMustDecide > 0 ? "warning" : "default")" />
        </QStatRow>

        <QCard Title="Must decide" Icon="exclamation-diamond" Class="pi-section" id="pi-must-decide"
               Hint="Nothing is imported until each of these has an answer. Every answer is yours; the page never picks.">
            @if (OpenMustDecide == 0)
            {
                <p class="pi-muted">Nothing left to decide.</p>
            }
            <ul class="pi-issues">
                @foreach (var q in personQuestions.Where(q => !q.Answered))
                {
                    <li class="pi-issue" data-kind="NameQuestion" data-person="@q.Written">
                        <div class="pi-issue-text"><strong>Who is "@q.Written"?</strong> <span>@q.Match.Reason (@q.Slots @(q.Slots == 1 ? "slot" : "slots"))</span></div>
                        <div class="pi-issue-actions">
                            <QSelect TValue="Guid" TItem="StaffCandidate" Items="@PeopleFor(q)" Value="@q.Chosen" Placeholder="Choose the person" Sorted="false"
                                     ValueChanged="@(id => q.Chosen = id)" ValueSelector="@(p => p.UserId)" TextSelector="@(p => p.FullName)" />
                            <QButton Text="Confirm" Size="sm" Variant="primary" Disabled="@(q.Chosen == Guid.Empty)" OnClick="@(() => AnswerPerson(q))" />
                            <QButton Text="Leave out" Size="sm" Variant="ghost" OnClick="@(() => SkipPerson(q))" />
                        </div>
                    </li>
                }
                @foreach (var issue in checks.MustDecide.Where(i => !i.Resolved))
                {
                    <li class="pi-issue" data-kind="@issue.Kind" data-date="@(issue.Date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">
                        <div class="pi-issue-text">@issue.Message</div>
                        <div class="pi-issue-actions">
                            @switch (issue.Kind)
                            {
                                case ProgrammeIssueKind.Conflict:
                                case ProgrammeIssueKind.WeekdayMismatch:
                                    @foreach (var option in issue.Options)
                                    {
                                        var d = option;
                                        <QButton Text="@($"Use {QDateFormat.D(d)}")" Size="sm" Variant="secondary" OnClick="@(() => ChooseDate(issue, d))" />
                                    }
                                    break;
                                case ProgrammeIssueKind.RotaGap:
                                    @if (issue.SuggestTo is { } to && issue.SuggestCandidateId != null)
                                    {
                                        <QButton Text="@($"Use {to.ToString("dd/MM", CultureInfo.InvariantCulture)}")" Size="sm" Variant="primary" OnClick="@(() => ApplySuggestion(issue))" Class="pi-use-suggestion" />
                                    }
                                    <QSelect TValue="Guid" TItem="StaffCandidate" Items="@ctx.People" Value="@Guid.Empty" Placeholder="Put somebody on" Sorted="true"
                                             ValueChanged="@(id => FillGap(issue, id))" ValueSelector="@(p => p.UserId)" TextSelector="@(p => p.FullName)" />
                                    <QButton Text="Leave the gap" Size="sm" Variant="ghost" OnClick="@(() => Acknowledge(issue))" />
                                    break;
                                case ProgrammeIssueKind.Undated:
                                    <QDatePicker Value="@((DateTime?)null)" ValueChanged="@(v => DateUndated(issue, v))" Placeholder="Choose the date" />
                                    <QButton Text="Leave it out" Size="sm" Variant="ghost" OnClick="@(() => LeaveOut(issue))" />
                                    break;
                                case ProgrammeIssueKind.NoTime:
                                    <QButton Text="Import as an event" Size="sm" Variant="secondary" OnClick="@(() => MeetingAsEvent(issue))" />
                                    break;
                                default:
                                    <QButton Text="Understood" Size="sm" Variant="ghost" OnClick="@(() => Acknowledge(issue))" />
                                    break;
                            }
                        </div>
                    </li>
                }
            </ul>
        </QCard>

        @if (checks.Suggestions.Any(s => !s.Resolved))
        {
            <QCard Title="Suggestions" Icon="lightbulb" Class="pi-section" id="pi-suggestions" Hint="A one-edit change that fixes a problem and creates none. Offered, never applied without a press.">
                <ul class="pi-issues">
                    @foreach (var s in checks.Suggestions.Where(s => !s.Resolved))
                    {
                        <li class="pi-issue" data-kind="DateSuggestion">
                            <div class="pi-issue-text">@s.Message</div>
                            <div class="pi-issue-actions">
                                <QButton Text="@($"Use {s.SuggestTo?.ToString("dd/MM", CultureInfo.InvariantCulture)}")" Size="sm" Variant="primary" OnClick="@(() => ApplySuggestion(s))" />
                            </div>
                        </li>
                    }
                </ul>
            </QCard>
        }

        @if (MeetingRowsAll().Any())
        {
            <QCard Title="Who each meeting expects" Icon="people" Class="pi-section" id="pi-meetings"
                   Hint="A meeting with a register expects named people. One whose attendance cannot be read from its title is imported as a calendar event until you say who is expected.">
                <table class="data-table q-stack">
                    <thead><tr><th>Meeting</th><th>When</th><th>Expected</th></tr></thead>
                    <tbody>
                        @foreach (var m in MeetingRowsAll())
                        {
                            <tr>
                                <td>@m.Title</td>
                                <td>@When(m)</td>
                                <td>
                                    <div class="pi-attendance">
                                        <QSelect TValue="MeetingAttendance" TItem="AttendanceOption" Items="@AttendanceOptions(m)" Value="@m.Attendance"
                                                 ValueChanged="@(a => SetAttendance(m, a))" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Label)" Disabled="@(!ctx.CanImportDuties)" />
                                        @if (m.Attendance == MeetingAttendance.RoleHolders)
                                        {
                                            <QSelect TValue="string" TItem="string" Items="@roles" Value="@m.AttendanceRole"
                                                     ValueChanged="@(r => { m.AttendanceRole = r; })" ValueSelector="@(r => r)" TextSelector="@(r => r)" />
                                            <span class="pi-muted">@(ExpectedFor(m)?.Count ?? 0) people</span>
                                        }
                                    </div>
                                    @if (ExpectsNobody(m))
                                    {
                                        @* Refused at submit before 2026-09-23 while the page said every question was answered; it is a
                                           question, so it is asked here and counts against "Check with the server". *@
                                        <div class="pi-attendance-empty" role="alert">
                                            <span>Nobody on the staff list matches this. Choose who is expected, or:</span>
                                            <QButton Text="Import as an event only" Size="sm" Variant="secondary"
                                                     OnClick="@(() => SetAttendance(m, MeetingAttendance.EventOnly))" />
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </QCard>
        }

        @if (checks.Warnings.Any() || checks.Merged.Any())
        {
            <QCard Title="Warnings and merges" Icon="info-circle" Class="pi-section" id="pi-warnings">
                <ul class="pi-issues pi-issues--plain">
                    @foreach (var w in checks.Warnings) { <li data-kind="@w.Kind">@w.Message</li> }
                    @foreach (var m in checks.Merged) { <li data-kind="Merged"><QChip Text="Merged" Size="sm" Variant="info" /> @m.Message</li> }
                </ul>
            </QCard>
        }

        @if (termFromDocs != null)
        {
            <QCard Title="Term dates" Icon="calendar-range" Class="pi-section" Hint="The term the documents describe. Setting it here changes the school's term dates for everything that uses them — scoring periods included.">
                <QCheckbox @bind-Value="@setTerm" Label="@TermLabel()" />
            </QCard>
        }

        <div class="pi-previews">
            <QCard Title="The term, day by day" Icon="calendar3" Class="pi-section" id="pi-agenda">
                @if (!AgendaDays().Any())
                {
                    <p class="pi-muted">Nothing dated yet.</p>
                }
                @foreach (var day in AgendaDays().Take(agendaDays))
                {
                    <div class="pi-day">
                        <div class="pi-day-date">@QDateFormat.D(day.Key)</div>
                        <ul>
                            @foreach (var c in day.OrderBy(c => c.StartTime ?? ""))
                            {
                                <li><span class="pi-time">@(c.StartTime ?? "All day")</span> @c.Title <QChip Text="@KindLabel(c)" Size="sm" Variant="@(c.Kind == ProgrammeRowKind.Meeting && c.Attendance != MeetingAttendance.EventOnly ? "primary" : "muted")" /></li>
                            }
                        </ul>
                    </div>
                }
                @if (AgendaDays().Count() > agendaDays)
                {
                    <QButton Text="Show more days" Variant="ghost" Size="sm" OnClick="@(() => agendaDays += 30)" />
                }
            </QCard>

            <QCard Title="Each person's duties" Icon="person-lines-fill" Class="pi-section" id="pi-per-person">
                @if (!PerPerson().Any())
                {
                    <p class="pi-muted">No rota in these documents.</p>
                }
                <ul class="pi-people">
                    @foreach (var p in PerPerson())
                    {
                        <li data-person="@p.Name"><strong>@p.Name</strong> <span>@p.Text</span></li>
                    }
                </ul>
            </QCard>
        </div>

        <div class="form-actions">
            <QButton Text="Back" Variant="ghost" OnClick="@(() => stage = Stage.Understand)" />
            <QButton Text="Check with the server" Icon="arrow-right" Variant="primary" Loading="@working" Disabled="@(OpenMustDecide > 0 || working)" OnClick="@PreviewAsync" id="pi-preview" />
            @if (OpenMustDecide > 0)
            {
                <span class="pi-muted">Answer the @OpenMustDecide @(OpenMustDecide == 1 ? "item" : "items") above first.</span>
            }
        </div>
    }

    @* ---------------- 4. Confirm ---------------- *@
    @if (stage == Stage.Confirm && preview != null)
    {
        <QCard Title="Confirm" Icon="check2-square" Class="pi-section" id="pi-confirm">
            <p class="pi-sentence" id="pi-confirm-sentence">@ConfirmSentence(preview)</p>
            @if (preview.PeopleNotified > 0)
            {
                @* A school may load next term's programme weeks ahead and announce it later; the rota and the
                   reminders work either way — this only decides the one message each person gets now. *@
                <QSwitch @bind-Value="notifyPeople" Label="Tell each person their dates now" Class="pi-notify"
                         Hint="One message per person listing all their new duties. Off: nobody is told until you tell them; reminders still run." />
            }
            @if (preview.Rows.Any(r => r.Outcome == ProgrammeRowOutcome.Refused))
            {
                <h3 class="pi-sub">Refused by the server</h3>
                <ul class="pi-issues pi-issues--plain">
                    @foreach (var r in preview.Rows.Where(r => r.Outcome == ProgrammeRowOutcome.Refused)) { <li>@RowLabel(r): @r.Reason</li> }
                </ul>
            }
            @if (preview.Rows.Any(r => r.Outcome == ProgrammeRowOutcome.Update))
            {
                <h3 class="pi-sub">Will change</h3>
                <ul class="pi-issues pi-issues--plain">
                    @foreach (var r in preview.Rows.Where(r => r.Outcome == ProgrammeRowOutcome.Update)) { <li>@RowLabel(r): @string.Join(", ", r.Changes)</li> }
                </ul>
            }
            @if (preview.Rows.Any(r => r.Warnings.Count > 0))
            {
                <h3 class="pi-sub">Warnings</h3>
                <ul class="pi-issues pi-issues--plain">
                    @foreach (var r in preview.Rows.Where(r => r.Warnings.Count > 0).Take(80)) { <li>@RowLabel(r): @string.Join(" ", r.Warnings)</li> }
                </ul>
            }
            <div class="form-actions">
                <QButton Text="Back" Variant="ghost" OnClick="@(() => stage = Stage.Check)" Disabled="@working" />
                <QButton Text="@ImportButtonText" Icon="check-lg" Variant="primary" Loading="@working" Disabled="@(working || NothingToWrite(preview))" OnClick="@CommitAsync" id="pi-commit" />
            </div>
        </QCard>
    }

    @* ---------------- 5. Done ---------------- *@
    @if (stage == Stage.Done && committed != null)
    {
        <QCard Title="Imported" Icon="check-circle" Class="pi-section" id="pi-done">
            <p class="pi-sentence">@DoneSentence(committed)</p>
            <div class="form-actions">
                <QButton Text="Open the calendar" Icon="calendar3" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/calendar?tab=calendar"))" />
                <QButton Text="Open the rota" Icon="calendar-week" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/admin/staff/duties?tab=rota"))" />
                @if (committed.JobId is { } jobId)
                {
                    <QButton Text="Undo this import" Icon="arrow-counterclockwise" Variant="danger" OnClick="@(() => AskUndo(jobId))" id="pi-undo" />
                }
                <QButton Text="Import more" Variant="ghost" OnClick="@Reset" />
            </div>
        </QCard>
    }
}

<QModal Visible="@historyOpen" VisibleChanged="@(v => historyOpen = v)" Title="Import history" Icon="clock-history" Size="lg">
    @if (jobs == null)
    {
        <div class="pi-loading"><QSpinner Size="sm" /><span>Loading...</span></div>
    }
    else if (jobs.Count == 0)
    {
        <QEmptyState Icon="clock-history" Title="No imports yet" />
    }
    else
    {
        <table class="data-table q-stack" id="pi-jobs">
            <thead><tr><th>When</th><th>Files</th><th class="num">Events</th><th class="num">Meetings</th><th class="num">Rota</th><th></th></tr></thead>
            <tbody>
                @foreach (var j in jobs)
                {
                    <tr class="@(j.Undone ? "row-muted" : "")">
                        <td>@QDateFormat.DT(j.CreatedAt.ToLocalTime())<div class="cell-sub">@j.CreatedByName</div></td>
                        <td>@string.Join(", ", j.SourceFiles)</td>
                        <td class="num">@j.EventsCreated</td>
                        <td class="num">@j.MeetingsCreated</td>
                        <td class="num">@j.RotaSlotsCreated</td>
                        <td class="row-actions">
                            @if (j.Undone)
                            {
                                <QChip Text="@($"Undone {QDateFormat.D(j.UndoneAt?.ToLocalTime())}")" Size="sm" Variant="muted" />
                            }
                            else
                            {
                                <QButton Text="Undo" Size="sm" Variant="ghost" OnClick="@(() => AskUndo(j.Id))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</QModal>

<QModal Visible="@(undoJobId != null)" VisibleChanged="@(v => { if (!v) undoJobId = null; })" Title="Undo this import?" Icon="arrow-counterclockwise">
    <ChildContent>
        <p>Its events are removed and its meetings and rota slots cancelled. A meeting or slot whose register has been taken is kept — a register is history.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Keep it" Variant="ghost" OnClick="@(() => undoJobId = null)" />
        <QButton Text="Undo the import" Variant="danger" Loading="@working" OnClick="@UndoAsync" id="pi-undo-confirm" />
    </FooterContent>
</QModal>

<style>
    .pi-steps { display: flex; flex-wrap: wrap; gap: var(--q-row-gap); list-style: none; padding: 0; margin: 0 0 var(--qm-block-gap); font-size: var(--qm-text-sm); }
    .pi-steps li { display: flex; align-items: center; gap: 6px; color: var(--qm-text-muted); }
    .pi-steps li span { display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center; border-radius: var(--qm-radius-full); border: 1px solid var(--qm-border); font-size: var(--qm-text-xs); }
    .pi-steps li.pi-step--active { color: var(--qm-text-primary); font-weight: 600; }
    .pi-steps li.pi-step--active span { background: var(--qm-primary); color: var(--qm-text-on-primary); border-color: var(--qm-primary); }
    .pi-steps li.pi-step--done span { background: var(--qm-bg-secondary); }
    .pi-drop { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: var(--qm-empty-pad); border: 1px dashed var(--qm-border-hover); border-radius: var(--qm-radius-md); cursor: pointer; text-align: center; }
    .pi-drop-main { font-weight: 600; }
    .pi-drop-sub, .pi-muted { color: var(--qm-text-muted); font-size: var(--qm-text-sm); }
    .pi-file { position: absolute; width: 1px; height: 1px; opacity: 0; }
    .pi-loading { display: flex; align-items: center; gap: var(--q-row-gap); padding: var(--qm-block-gap) 0; }
    .pi-note { display: flex; align-items: center; gap: 6px; color: var(--qm-text-secondary); font-size: var(--qm-text-sm); margin: 0 0 var(--qm-block-gap); }
    .pi-refusal { color: var(--qm-danger); }
    .pi-table { border-top: 1px solid var(--qm-border); padding-top: var(--qm-block-gap); margin-top: var(--qm-block-gap); }
    .pi-table:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
    .pi-table-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--q-row-gap); }
    .pi-kind { min-width: 220px; }
    .pi-reasons { margin: 6px 0; padding-left: 18px; font-size: var(--qm-text-sm); color: var(--qm-text-secondary); }
    .pi-columns { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: var(--q-row-gap); margin: 6px 0; }
    .pi-column { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .pi-column-name { font-size: var(--qm-text-xs); color: var(--qm-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pi-section { margin-top: var(--qm-block-gap); }
    .pi-issues { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--q-row-gap); }
    .pi-issues--plain { font-size: var(--qm-text-sm); gap: 4px; }
    .pi-issue { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--q-row-gap); padding: 8px 0; border-bottom: 1px solid var(--qm-border); }
