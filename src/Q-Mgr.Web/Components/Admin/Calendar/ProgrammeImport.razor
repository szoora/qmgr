    private IEnumerable<ProgrammeCandidate> AllCandidates() => files.SelectMany(f => f.Candidates);

    private IEnumerable<ProgrammeCandidate> Live() => AllCandidates().Where(c => c.Include && c.MergedIntoId == null && c.StartsOn.HasValue);

    private IEnumerable<ProgrammeCandidate> MeetingRowsAll() => AllCandidates().Where(c => c.Include && c.MergedIntoId == null && c.Kind == ProgrammeRowKind.Meeting);

