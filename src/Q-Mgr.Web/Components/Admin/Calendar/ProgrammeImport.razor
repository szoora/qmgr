    private IEnumerable<ProgrammeCandidate> MeetingRows()
        => ctx!.CanImportDuties
            ? Live().Where(c => c.Kind == ProgrammeRowKind.Meeting && c.Attendance is not (MeetingAttendance.EventOnly or MeetingAttendance.Undecided) && c.StartTime != null)
            : Enumerable.Empty<ProgrammeCandidate>();

