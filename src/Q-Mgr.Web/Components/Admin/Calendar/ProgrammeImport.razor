    private IEnumerable<IGrouping<DateOnly, ProgrammeCandidate>> AgendaDays()
        => EventRows().Concat(MeetingRows()).GroupBy(c => c.StartsOn!.Value).OrderBy(g => g.Key);

    private sealed record PersonLine(string Name, string Text);

    private List<PersonLine> PerPerson()
    {
        var names = ctx!.People.ToDictionary(p => p.UserId, p => p.FullName);
        return Live().Where(c => c.Kind == ProgrammeRowKind.Rota)
            .GroupBy(c => c.UserId.HasValue && names.ContainsKey(c.UserId.Value) ? names[c.UserId.Value] : $"{c.PersonText} (not matched)")
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => new PersonLine(g.Key, string.Join("; ", g.GroupBy(c => c.RotaName).Select(r =>
                $"{r.Key}: {string.Join(", ", r.OrderBy(c => c.StartsOn).Select(c => c.EndsOn.HasValue && c.EndsOn != c.StartsOn ? $"{QDateFormat.D(c.StartsOn)} – {QDateFormat.D(c.EndsOn)}" : c.StartsOn!.Value.ToString("ddd dd MMM", CultureInfo.InvariantCulture)))}"))))
            .ToList();
    }

    private static string When(ProgrammeCandidate c)
        => c.StartsOn.HasValue ? $"{c.StartsOn.Value.ToString("ddd dd MMM", CultureInfo.InvariantCulture)}{(c.StartTime != null ? ", " + c.StartTime : "")}" : "No date";

    private string KindLabel(ProgrammeCandidate c)
        => c.Kind == ProgrammeRowKind.Meeting && MeetingRows().Contains(c) ? "Meeting" : c.SeriesName != null ? "Programme" : c.Category ?? "Event";

    // ---- 4. Preview with the server, then commit ------------------------------------------------------------

    private ProgrammeImportRequest BuildRequest(bool previewOnly)
    {
        // Approval mode: the staged request, exactly as it was sent — the page never re-reads a file it does not have.
        if (stagedRequest != null)
            return stagedRequest with { Preview = previewOnly, InboxJobId = InboxJobId, InboxSection = InboxSection, NotifyPeople = notifyPeople };

        var meetings = MeetingRows().ToList();
        var meetingKeys = meetings.ToDictionary(m => m.Id, m => m.SourceKey);
        var categories = ctx!.Settings.Categories;

        var request = new ProgrammeImportRequest
        {
            Preview = previewOnly,
            SourceFiles = files.Where(f => f.Refusal == null).Select(f => f.FileName).ToList(),
            NotifyPeople = notifyPeople,
            Events = EventRows().Select(c => new ProgrammeEventRow
            {
                SourceKey = Trim(c.SourceKey, 200),
                Title = Trim(c.Title, 200),
                StartsOn = c.StartsOn!.Value,
                EndsOn = c.EndsOn ?? c.StartsOn!.Value,
                StartTime = c.StartTime,
                EndTime = c.StartTime == null ? null : c.EndTime,
                Category = categories.FirstOrDefault(x => string.Equals(x, c.Category, StringComparison.OrdinalIgnoreCase)),
                Audience = c.Audience,
                ClassNames = c.ClassNames,
                Location = TrimOrNull(c.Location, 200),
                ResponsibleText = TrimOrNull(c.ResponsibleText, 300),
                ResponsibleUserIds = c.ResponsibleUserIds,
                ResponsibleDepartmentIds = c.ResponsibleDepartmentIds,
                SeriesName = TrimOrNull(c.SeriesName, 200),
                SameAsMeetingKey = c.SameAsMeetingId != null && meetingKeys.TryGetValue(c.SameAsMeetingId, out var mk) ? mk : null,
                StaffAudience = c.SameAsMeetingId != null && meetings.FirstOrDefault(m => m.Id == c.SameAsMeetingId) is { } linked ? EventAudienceFor(linked) : null,
                // A MEETING going in as an event says why, so Import health can say it later (E10).
                NoRegisterReason = c.Kind == ProgrammeRowKind.Meeting ? NoRegisterReason(c) : null
            })
            // Every meeting with a register is on the calendar too, as ONE event linked to it (B1) — unless another line of
            // the documents is already that event. Same source key as the meeting, so a re-import matches it.
            .Concat(meetings.Where(m => !EventRows().Any(e => e.SameAsMeetingId == m.Id)).Select(m => new ProgrammeEventRow
            {
                SourceKey = Trim(m.SourceKey, 200),
                Title = Trim(m.Title, 200),
                StartsOn = m.StartsOn!.Value,
                EndsOn = m.StartsOn!.Value,
                StartTime = m.StartTime,
                EndTime = m.EndTime,
                Category = categories.FirstOrDefault(x => string.Equals(x, m.Category ?? "Meetings", StringComparison.OrdinalIgnoreCase)),
                Audience = EventAudience.Staff,
                Location = TrimOrNull(m.Location, 200),
                ResponsibleText = TrimOrNull(m.ResponsibleText, 300),
                ResponsibleUserIds = m.ResponsibleUserIds,
                ResponsibleDepartmentIds = m.ResponsibleDepartmentIds,
                SameAsMeetingKey = Trim(m.SourceKey, 200),
                StaffAudience = EventAudienceFor(m)
            })).ToList(),
            Meetings = meetings.Select(m => new ProgrammeMeetingRow
            {
                SourceKey = Trim(m.SourceKey, 200),
                Title = Trim(m.Title, 200),
                Date = m.StartsOn!.Value,
                StartTime = m.StartTime,
                EndTime = m.EndTime,
                Location = TrimOrNull(m.Location, 200),
                ConvenerText = TrimOrNull(m.ResponsibleText, 300),
                RecorderUserIds = m.RecorderUserIds,
                ExpectedUserIds = ExpectedFor(m),
                ExpectedText = m.Attendance switch
                {
                    MeetingAttendance.Everyone => "every member of staff",
                    MeetingAttendance.DepartmentHeads => "the heads of department",
                    MeetingAttendance.RoleHolders => $"the people the rota lists as {m.AttendanceRole}",
                    MeetingAttendance.Chosen => TrimOrNull(StaffAudienceRule.Describe(m.StaffAudience ?? new StaffAudienceDto { AllStaff = false },
                        code => ctx.Audience.Roles.FirstOrDefault(r => r.Code == code)?.Name ?? code,
                        id => ctx.Audience.Departments.FirstOrDefault(d => d.Id == id)?.Name,
                        id => ctx.Audience.People.FirstOrDefault(p => p.UserId == id)?.FullName), 300),
                    _ => null
                }
            }).ToList(),
            RotaSlots = RotaRows().Select(r => new ProgrammeRotaRow
            {
                SourceKey = Trim(r.SourceKey, 200),
                RotaName = Trim(r.RotaName ?? r.Title, 120),
                UserId = r.UserId!.Value,
                StartsOn = r.StartsOn!.Value,
                EndsOn = r.EndsOn ?? r.StartsOn!.Value
            }).ToList()
        };

        if (setTerm && termFromDocs is { } term)
        {
            var existing = ctx.Terms.FirstOrDefault(t => t.Start <= term.End && term.Start <= t.End);
            request.Term = new ProgrammeTermUpdate
            {
                Key = existing?.Key,
                Name = existing?.Name ?? termName ?? $"Term {term.Start.Year}",
                Start = term.Start,
                End = term.End,
                Theme = termTheme
            };
        }

        var learned = new ImportAliasesDto();
        foreach (var answer in people.Values.Where(a => a.Confirmed && a.UserId.HasValue))
            learned.People[StaffNameResolver.AliasKey(answer.Written)] = answer.UserId!.Value;
        // E9: an attendance the reader settled is remembered BY ITS WORDS, so the next document that says "Administration,
        // Senior Ladies & Matrons" is read without asking again.
        foreach (var m in meetings.Where(m => m.Attendance == MeetingAttendance.Chosen && m.StaffAudience is { } a && !a.IsEmpty && !string.IsNullOrWhiteSpace(m.ResponsibleText)))
            learned.Offices[OfficeResolver.AliasKey(m.ResponsibleText)] = new OfficeAliasDto
            {
                AllStaff = m.StaffAudience!.AllStaff, StaffGroups = m.StaffAudience.StaffGroups, RoleCodes = m.StaffAudience.RoleCodes,
                DepartmentIds = m.StaffAudience.DepartmentIds, UserIds = m.StaffAudience.UserIds
            };
        // The people a rota lists BY ROLE ("Prep Supervisor") are remembered as that role's holders, so a meeting of
        // "Prep supervisors" in a document uploaded ANOTHER day still knows who they are (cross-upload, E9).
        foreach (var role in roles)
        {
            var holders = ProgrammeChecks.RoleHolders(files, role).Where(n => n.UserId.HasValue).Select(n => n.UserId!.Value).Distinct().ToList();
            if (holders.Count == 0) continue;
            learned.Offices[OfficeResolver.AliasKey(role)] = new OfficeAliasDto { UserIds = holders };
            learned.Offices[OfficeResolver.AliasKey(role + "s")] = new OfficeAliasDto { UserIds = holders };
        }
        if (learned.People.Count > 0 || learned.Offices.Count > 0) request.LearnedAliases = learned;
        return request;
    }

    /// <summary>The page refuses first what the server would refuse (the rule in CLAUDE.md).</summary>
    private string? ClientProblem(ProgrammeImportRequest r)
    {
        if (r.Events.Count + r.Meetings.Count + r.RotaSlots.Count == 0 && r.Term == null) return "There is nothing to import: every row is left out or merged.";
        if (r.Events.Count > 1000 || r.Meetings.Count > 300 || r.RotaSlots.Count > 1500) return "That is more than one import can take — split the documents.";
        if (r.Meetings.Any(m => m.StartTime == null)) return "A meeting has no start time.";
        if (r.Meetings.Any(m => m.ExpectedUserIds is { Count: 0 })) return "A meeting expects nobody the staff list holds — choose who is expected, or import it as an event.";
        return null;
    }

    private async Task PreviewAsync()
    {
        var request = BuildRequest(previewOnly: true);
        if (ClientProblem(request) is { } problem) { Toast.Notify(ToastSeverity.Warning, "Not ready to import", problem); return; }
        working = true;
        try
        {
            preview = await ImportApi.ImportAsync(branchId, request);
            stage = Stage.Confirm;
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "The server could not check the import", ex.Message);
        }
        finally { working = false; }
    }

    private async Task CommitAsync()
    {
        var request = BuildRequest(previewOnly: false);
        if (ClientProblem(request) is { } problem) { Toast.Notify(ToastSeverity.Warning, "Not ready to import", problem); return; }
        working = true;
        try
        {
            committed = await ImportApi.ImportAsync(branchId, request);
            stage = Stage.Done;
            Toast.Notify(ToastSeverity.Success, "Imported", DoneSentence(committed));
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "The import did not go through", ex.Message);
        }
        finally { working = false; }
    }

    private static bool NothingToWrite(ProgrammeImportResultDto r)
        => r.EventsCreated + r.EventsUpdated + r.MeetingsCreated + r.MeetingsUpdated + r.RotaSlotsCreated == 0;

    private string ImportButtonText => preview == null || NothingToWrite(preview) ? "Nothing new to import" : "Import";

    private static string Plural(int n, string one, string many) => n == 1 ? $"1 {one}" : $"{n} {many}";

    private string ConfirmSentence(ProgrammeImportResultDto r)
    {
        if (NothingToWrite(r))
            return $"Everything in these documents is already here — {Plural(r.Unchanged, "row", "rows")} unchanged. Nothing would be created.";
        var parts = new List<string>();
        if (r.EventsCreated > 0) parts.Add(Plural(r.EventsCreated, "event", "events"));
        if (r.MeetingsCreated > 0) parts.Add(Plural(r.MeetingsCreated, "meeting", "meetings"));
        if (r.RotaSlotsCreated > 0) parts.Add(Plural(r.RotaSlotsCreated, "duty slot", "duty slots"));
        var sentence = parts.Count > 0 ? $"Create {JoinAnd(parts)}" : "Create nothing new";
        var updates = r.EventsUpdated + r.MeetingsUpdated;
        if (updates > 0) sentence += $", update {Plural(updates, "entry", "entries")}";
        if (r.PeopleNotified > 0 && notifyPeople) sentence += $", and tell {Plural(r.PeopleNotified, "person", "people")} their dates";
        sentence += ".";
        if (r.Unchanged > 0) sentence += $" {Plural(r.Unchanged, "row is", "rows are")} already there and will not change.";
        if (r.Refused > 0) sentence += $" {Plural(r.Refused, "row is", "rows are")} refused (listed below).";
        if (setTerm && termFromDocs != null) sentence += " The term dates will be set.";
        return sentence;
    }

    private string DoneSentence(ProgrammeImportResultDto r)
    {
        var parts = new List<string>();
        if (r.EventsCreated > 0) parts.Add(Plural(r.EventsCreated, "event", "events"));
        if (r.MeetingsCreated > 0) parts.Add(Plural(r.MeetingsCreated, "meeting", "meetings"));
        if (r.RotaSlotsCreated > 0) parts.Add(Plural(r.RotaSlotsCreated, "duty slot", "duty slots"));
        var text = parts.Count > 0 ? $"Created {JoinAnd(parts)}." : "Nothing new was created.";
        if (r.EventsUpdated + r.MeetingsUpdated > 0) text += $" Updated {Plural(r.EventsUpdated + r.MeetingsUpdated, "entry", "entries")}.";
        if (r.PeopleNotified > 0) text += $" {Plural(r.PeopleNotified, "person was", "people were")} told their dates.";
        if (r.TermUpdated) text += " The term dates were set.";
        return text;
    }

    private static string JoinAnd(List<string> parts)
        => parts.Count <= 1 ? string.Join(string.Empty, parts) : string.Join(", ", parts.Take(parts.Count - 1)) + " and " + parts[^1];

    private string RowLabel(ProgrammeRowResultDto r)
    {
        var c = AllCandidates().FirstOrDefault(x => x.SourceKey == r.SourceKey);
        if (c != null) return c.Kind == ProgrammeRowKind.Rota ? $"{c.PersonText}, {When(c)}" : $"{c.Title} ({When(c)})";
        // Approval mode has no candidates — only the staged request — so the row is named from that.
        if (stagedRequest != null)
        {
            if (stagedRequest.Events.FirstOrDefault(e => e.SourceKey == r.SourceKey) is { } e) return $"{e.Title} ({QDateFormat.D(e.StartsOn)})";
            if (stagedRequest.Meetings.FirstOrDefault(m => m.SourceKey == r.SourceKey) is { } m) return $"{m.Title} ({QDateFormat.D(m.Date)})";
            if (stagedRequest.RotaSlots.FirstOrDefault(s => s.SourceKey == r.SourceKey) is { } s) return $"{s.RotaName} ({QDateFormat.D(s.StartsOn)})";
        }
        return r.SourceKey;
    }

    // ---- Routing and approval (E11) ----------------------------------------------------------------------------

    private static bool IsRouted(ProgrammeTableKind kind) => kind is ProgrammeTableKind.StaffList or ProgrammeTableKind.StudentList or ProgrammeTableKind.TimetableGrid;

    private static string RoutedSection(ProgrammeTableKind kind) => kind switch
    {
        ProgrammeTableKind.StaffList => ImportSectionKinds.Staff,
        ProgrammeTableKind.StudentList => ImportSectionKinds.Students,
        _ => ImportSectionKinds.Timetable
    };

    private IEnumerable<(ProgrammeFileReading File, ProgrammeTableReading Table)> RoutedTables()
        => files.Where(f => f.Refusal == null && f.Document != null).SelectMany(f => f.Tables.Where(t => IsRouted(t.Kind)).Select(t => (f, t)));

    /// <summary>
    /// Whether this person may import these documents straight away, as before: they keep the calendar, may make meetings
    /// and rota slots when there are any, the school does not require a second approver, and nothing in the documents
    /// belongs to another section. Otherwise the documents go to the Import inbox, and each part to its owner.
    /// </summary>
    private bool MayImportDirectly => WhyApproval == null;

    private string? WhyApproval
    {
        get
        {
            if (importSettings.RequireSecondApprover) return "This school has a second person approve every import, so the documents go to the Import inbox.";
            if (!canManageCalendar) return "Events are approved by the people who keep the calendar, so the documents go to them.";
            if (RoutedTables().Any()) return "Part of these documents belongs to another section, so they go to the Import inbox — each part to the people who approve it.";
            return null;
        }
    }

    /// <summary>Splits the checked documents into their sections and stages them. Nothing is written until each is approved.</summary>
    private async Task SendForApprovalAsync()
    {
        var request = BuildRequest(previewOnly: false);
        var sections = new List<SubmitImportSectionDto>();
        var meetingEvents = request.Events.Where(e => !string.IsNullOrWhiteSpace(e.SameAsMeetingKey) && request.Meetings.Any(m => m.SourceKey == e.SameAsMeetingKey)).ToList();
        var plainEvents = request.Events.Except(meetingEvents).ToList();
        if (plainEvents.Count > 0 || request.Term != null)
            sections.Add(new SubmitImportSectionDto
            {
                Kind = ImportSectionKinds.Events, Title = "Calendar events", RowCount = plainEvents.Count,
                RouteReason = "Activities and programme items read from the documents.",
                Programme = request with { Events = plainEvents, Meetings = new(), RotaSlots = new() }
            });
        if (request.Meetings.Count > 0)
            sections.Add(new SubmitImportSectionDto
            {
                Kind = ImportSectionKinds.Meetings, Title = "Meetings and registers", RowCount = request.Meetings.Count,
                RouteReason = "Staff meetings with a register, and their places on the calendar.",
                Programme = request with { Events = meetingEvents, Meetings = request.Meetings, RotaSlots = new(), Term = null }
            });
        if (request.RotaSlots.Count > 0)
            sections.Add(new SubmitImportSectionDto
            {
                Kind = ImportSectionKinds.Rota, Title = "Duty rota", RowCount = request.RotaSlots.Count,
                RouteReason = "People on duty, by date.",
                Programme = request with { Events = new(), Meetings = new(), RotaSlots = request.RotaSlots, Term = null, LearnedAliases = null }
            });
        foreach (var (file, table) in RoutedTables())
            sections.Add(new SubmitImportSectionDto
            {
                Kind = RoutedSection(table.Kind),
                Title = $"{ImportSectionKinds.Label(RoutedSection(table.Kind))} — {file.FileName}, table {table.TableIndex + 1}",
                RowCount = table.DataRows,
                RouteReason = string.Join(" ", table.Reasons),
                Csv = TableCsv(file, table),
                FileName = $"{System.IO.Path.GetFileNameWithoutExtension(file.FileName)}-table{table.TableIndex + 1}.csv"
            });
        if (sections.Count == 0) { Toast.Notify(ToastSeverity.Warning, "Nothing to send", "Every row is left out or merged."); return; }

        working = true;
        try
        {
            await InboxApi.SubmitAsync(branchId, new SubmitImportRequest { SourceFiles = request.SourceFiles, Sections = sections });
            stage = Stage.Sent;
            Toast.Notify(ToastSeverity.Success, "Sent for approval", $"{Plural(sections.Count, "part", "parts")} waiting in the Import inbox.");
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not send the documents", ex.Message);
        }
        finally { working = false; }
    }

    /// <summary>A routed table as CSV for its own importer — RFC 4180 quoting, the cells exactly as read.</summary>
    private static string TableCsv(ProgrammeFileReading file, ProgrammeTableReading table)
    {
        var grid = file.Document!.Tables[table.TableIndex].ToGrid();
        var start = Math.Max(0, table.HeaderRow);
        static string Q(string? v) => "\"" + (v ?? string.Empty).Replace("\"", "\"\"") + "\"";
        return string.Join("\r\n", grid.Skip(start).Where(r => r.Any(c => !string.IsNullOrWhiteSpace(c))).Select(r => string.Join(",", r.Select(Q))));
    }

    private async Task RejectAsync()
    {
        if (InboxJobId is not { } job || InboxSection == null) return;
        working = true;
        try
        {
            await InboxApi.RejectAsync(branchId, job, InboxSection, string.IsNullOrWhiteSpace(rejectNote) ? null : rejectNote.Trim());
            Toast.Notify(ToastSeverity.Success, "Rejected", "The person who sent it can see why.");
            Navigation.NavigateTo("/imports");
        }
        catch (Exception ex)
        {
            Toast.Notify(ToastSeverity.Error, "Could not reject it", ex.Message);
        }
        finally { working = false; }
    }

