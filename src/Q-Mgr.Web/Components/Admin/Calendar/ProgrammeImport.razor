@code {
    [Parameter] public bool Embedded { get; set; }
    /// <summary>
    /// Set by the Import inbox: this page then APPROVES one staged section of a document somebody else sent (E11) —
    /// it checks the staged rows with the server and commits them through the one import path, which claims the
    /// section in the same transaction. Nothing is re-read from a file.
    /// </summary>
    [Parameter] public Guid? InboxJobId { get; set; }
    [Parameter] public string? InboxSection { get; set; }
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool ApprovalMode => InboxJobId.HasValue && !string.IsNullOrWhiteSpace(InboxSection);
    private ProgrammeImportRequest? stagedRequest;
    private bool rejecting;
    private string? rejectNote;
    private ProgrammeImportHealthDto? health;
    private bool healthLoading;
    private ImportSettingsDto importSettings = new();
    private bool canManageCalendar;

    private const string InputId = "pi-files";
    private const string MappingPrefix = "qmgr-programme-table:";

    private enum Stage { Choose, Understand, Check, Confirm, Done, Sent }

    /// <summary>Whether the commit tells each person their new duties (one message each). On by default.</summary>
    private bool notifyPeople = true;

    private Guid branchId;
    private Stage stage = Stage.Choose;
    private ProgrammeImportContextDto? ctx;
    private string? loadError;
    private List<ProgrammeFileReading> files = new();
    private ProgrammeCheckResult? checks;
    private List<PersonQuestion> personQuestions = new();
    private readonly Dictionary<string, PersonAnswer> people = new(StringComparer.Ordinal);
    private readonly HashSet<string> acknowledged = new(StringComparer.Ordinal);
    private List<string> roles = new();
    private (DateOnly Start, DateOnly End)? termFromDocs;
    private string? termName, termTheme;
    private bool setTerm;
    private ProgrammeImportResultDto? preview, committed;
    private List<ProgrammeImportJobDto>? jobs;
    private bool historyOpen, working, reading;
    private string? readingName;
    private Guid? undoJobId;
    private int agendaDays = 30;
    private int addedRows;

    private sealed record KindOption(ProgrammeTableKind Kind, string Label);
    private sealed record RoleOption(ProgrammeColumnRole Role, string Label);
    private sealed record AttendanceOption(MeetingAttendance Value, string Label);

    /// <summary>One name as the documents wrote it, and who the reader or the ladder said it is.</summary>
    private sealed class PersonAnswer
    {
        public string Written { get; set; } = string.Empty;
        public NameMatchResult Match { get; set; } = new();
        public Guid? UserId { get; set; }
        public bool Skipped { get; set; }
        /// <summary>The reader chose it (as opposed to a certain match): learned as an alias.</summary>
        public bool Confirmed { get; set; }
    }

    private sealed class PersonQuestion
    {
        public string Key { get; set; } = string.Empty;
        public string Written { get; set; } = string.Empty;
        public NameMatchResult Match { get; set; } = new();
        public Guid Chosen { get; set; }
        public bool Answered { get; set; }
        public int Slots { get; set; }
    }

    private static readonly List<KindOption> KindOptions = new()
    {
        new(ProgrammeTableKind.TermActivities, "Term activities"),
        new(ProgrammeTableKind.DailyProgramme, "Timed programme"),
        new(ProgrammeTableKind.MeetingSchedule, "Schedule of meetings"),
        new(ProgrammeTableKind.PersonRota, "Duty rota (by person)"),
        new(ProgrammeTableKind.PeriodRota, "Duty rota (by week)"),
        new(ProgrammeTableKind.StaffList, "Staff list — for the staff import"),
        new(ProgrammeTableKind.StudentList, "Student roll — for the roll's import"),
        new(ProgrammeTableKind.TimetableGrid, "Timetable — for the timetable's import"),
        new(ProgrammeTableKind.Ignore, "Leave this table out"),
        new(ProgrammeTableKind.Unknown, "Not recognised")
    };

    private static readonly List<RoleOption> RoleOptions = new()
    {
        new(ProgrammeColumnRole.None, "Not used"),
        new(ProgrammeColumnRole.Week, "Week"),
        new(ProgrammeColumnRole.Date, "Date"),
        new(ProgrammeColumnRole.Time, "Time"),
        new(ProgrammeColumnRole.Title, "Activity / meeting"),
        new(ProgrammeColumnRole.Venue, "Venue"),
        new(ProgrammeColumnRole.Responsible, "Responsible / convener"),
        new(ProgrammeColumnRole.Person, "Person"),
        new(ProgrammeColumnRole.Phone, "Phone"),
        new(ProgrammeColumnRole.PeriodLabel, "Week number"),
        new(ProgrammeColumnRole.Serial, "Serial number")
    };

    // ---- Loading ------------------------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        TrackBranch();
        canManageCalendar = await PermissionService.HasPermissionAsync(Permissions.CalendarManage);
        try { importSettings = await InboxApi.GetSettingsAsync(); } catch { importSettings = new(); }
        await LoadContextAsync();
        if (ApprovalMode) await LoadStagedAsync();
    }

    /// <summary>Approval mode: the staged section, checked with the server as it stands now.</summary>
    private async Task LoadStagedAsync()
    {
        try
        {
            var staged = await InboxApi.GetStagedAsync(branchId, InboxJobId!.Value, InboxSection!);
            if (staged.Programme == null) { loadError = "This part of the document is not one this page imports."; return; }
            stagedRequest = staged.Programme;
            notifyPeople = stagedRequest.NotifyPeople;
            working = true;
            preview = await ImportApi.ImportAsync(branchId, BuildRequest(previewOnly: true));
            stage = Stage.Confirm;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally { working = false; }
    }

    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        Reset();
        ctx = null;
        await LoadContextAsync();
    }

    private async Task LoadContextAsync()
    {
        loadError = null;
        if (branchId == Guid.Empty) return;
        try
        {
            ctx = await ImportApi.GetContextAsync(branchId);
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
    }

    private void Reset()
    {
        stage = Stage.Choose;
        files = new();
        checks = null;
        personQuestions = new();
        people.Clear();
        acknowledged.Clear();
        roles = new();
        termFromDocs = null;
        setTerm = false;
        preview = null;
        committed = null;
        agendaDays = 30;
    }

    // ---- 1. Choose ----------------------------------------------------------------------------------------

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        IReadOnlyList<IBrowserFile> chosen;
        try { chosen = e.GetMultipleFiles(20); }
        catch (InvalidOperationException)
        {
            Toast.Notify(ToastSeverity.Warning, "Too many files", "Choose at most 20 documents at a time.");
            return;
        }
        if (chosen.Count == 0) return;
        reading = true;
        files = new();
        try
        {
            for (var i = 0; i < chosen.Count; i++)
            {
                var name = chosen[i].Name;
                readingName = name;
                StateHasChanged();
                if (chosen[i].Size > 10 * 1024 * 1024)
                {
                    files.Add(new ProgrammeFileReading { FileName = name, Refusal = $"\"{name}\" is over 10 MB — this page reads programmes, not archives." });
                    continue;
                }
                try
                {
                    ProgrammeFileReading file;
                    if (DocumentReader.IsDocumentName(name))
                        file = ProgrammeTableParser.Read(await ImportDocumentReading.ReadAsync(JS, InputId, name, i));
                    else
                        file = ProgrammeTableParser.Read(await SheetDocumentAsync(name, i));
                    await RestoreReadingsAsync(file);
                    files.Add(file);
                }
                catch (ImportDocumentException ex)
                {
                    files.Add(new ProgrammeFileReading { FileName = name, Refusal = ex.Message });
                }
                catch (Exception ex) when (ex is JSException or InvalidOperationException or FormatException or System.Xml.XmlException)
                {
                    files.Add(new ProgrammeFileReading { FileName = name, Refusal = $"\"{name}\" could not be read: {ex.Message}" });
                }
            }
            stage = Stage.Understand;
        }
        finally
        {
            reading = false;
        }
    }

    private sealed record SheetCsv(string Name, string Csv);

    /// <summary>A spreadsheet's sheets as one document with a table per sheet — SheetJS reads it, as for every import.</summary>
    private async Task<ImportDocument> SheetDocumentAsync(string name, int index)
    {
        var sheets = await JS.InvokeAsync<SheetCsv[]>("importDocuments.sheetsAt", InputId, index);
        var doc = new ImportDocument { FileName = name, Format = "sheet" };
        foreach (var sheet in sheets ?? Array.Empty<SheetCsv>())
        {
            var table = new ImportDocTable();
            foreach (var line in CsvText.Lines(sheet.Csv))
                table.Rows.Add(CsvText.ParseLine(line).Select(c => new ImportDocCell { Text = ImportDocText.Tidy(c) }).ToList());
            if (table.Rows.Count > 0) doc.Tables.Add(table);
        }
        if (doc.Tables.Count == 0) throw new ImportDocumentException($"\"{name}\" has no rows in it.");
        return doc;
    }

    // ---- 2. Understand: overrides, remembered by the table's header ----------------------------------------

    private sealed class RememberedReading
    {
        public ProgrammeTableKind Kind { get; set; }
        public List<ProgrammeColumnRole> Roles { get; set; } = new();
    }

    private async Task RestoreReadingsAsync(ProgrammeFileReading file)
    {
        if (file.Document == null) return;
        foreach (var table in file.Tables.Where(t => t.MappingKey.Length > 0))
        {
            try
            {
                var json = await JS.InvokeAsync<string?>("localStorage.getItem", MappingPrefix + table.MappingKey);
                if (string.IsNullOrEmpty(json)) continue;
                var remembered = JsonSerializer.Deserialize<RememberedReading>(json);
                if (remembered == null || remembered.Roles.Count != table.Roles.Count) continue;
                table.Kind = remembered.Kind;
                table.Roles = remembered.Roles;
                table.Reasons.Add("Read the way you chose last time for a table with these headings.");
                ProgrammeTableParser.ParseTable(file, file.Document, table);
            }
            catch (JSException) { /* storage unavailable: the automatic reading stands */ }
            catch (JsonException) { /* a stale entry: ignored */ }
        }
    }

    private async Task RememberAsync(ProgrammeTableReading table)
    {
        if (table.MappingKey.Length == 0) return;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", MappingPrefix + table.MappingKey,
                JsonSerializer.Serialize(new RememberedReading { Kind = table.Kind, Roles = table.Roles }));
        }
        catch (JSException) { /* storage unavailable: nothing remembered, nothing lost */ }
    }

    private async Task OnKindChangedAsync(ProgrammeFileReading file, ProgrammeTableReading table, ProgrammeTableKind kind)
    {
        table.Kind = kind;
        if (file.Document != null) ProgrammeTableParser.ParseTable(file, file.Document, table);
        await RememberAsync(table);
    }

    private async Task OnRoleChangedAsync(ProgrammeFileReading file, ProgrammeTableReading table, int column, ProgrammeColumnRole role)
    {
        table.Roles[column] = role;
        if (file.Document != null) ProgrammeTableParser.ParseTable(file, file.Document, table);
        await RememberAsync(table);
    }

    private static string TableSummary(ProgrammeFileReading file, ProgrammeTableReading table)
    {
        var rows = file.Candidates.Where(c => c.TableIndex == table.TableIndex).ToList();
        var parts = new List<string>();
        var events = rows.Count(c => c.Kind == ProgrammeRowKind.Event && !c.FromNote);
        var meetings = rows.Count(c => c.Kind == ProgrammeRowKind.Meeting && !c.FromNote);
        var rota = rows.Count(c => c.Kind == ProgrammeRowKind.Rota);
        var notes = rows.Count(c => c.FromNote);
        if (events > 0) parts.Add($"{events} event{(events == 1 ? "" : "s")}");
        if (meetings > 0) parts.Add($"{meetings} staff meeting{(meetings == 1 ? "" : "s")}");
        if (rota > 0) parts.Add($"{rota} duty assignment{(rota == 1 ? "" : "s")} for {file.RotaPeople} people, {file.NotOnRota.Count} not on the rota");
        if (file.EmptyWeeks > 0) parts.Add($"{file.EmptyWeeks} empty week{(file.EmptyWeeks == 1 ? "" : "s")}");
        if (notes > 0) parts.Add($"{notes} found in a note");
        return parts.Count == 0 ? "Nothing read from this table." : "Read: " + string.Join(" · ", parts) + ".";
    }

    // ---- 3. Check ------------------------------------------------------------------------------------------

    private void GoToCheck()
    {
        ResolvePeople();
        ResolveOffices();
        roles = ProgrammeChecks.Roles(files);
        foreach (var m in MeetingRowsAll().Where(m => m.Attendance == MeetingAttendance.Undecided && m.AttendanceRole == null))
        {
            var role = ProgrammeChecks.RoleForMeeting(files, m.Title);
            if (role != null) { m.Attendance = MeetingAttendance.RoleHolders; m.AttendanceRole = role; }
        }
        ResolveAttendance();
        termFromDocs = ProgrammeChecks.TermFrom(files);
        termTheme = files.Select(f => f.Theme).FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));
        termName = TermNameFromDocs();
        RunChecks();
        stage = Stage.Check;
    }

    /// <summary>Every rota row, and every person a rota lists by role, through the name ladder (plan §6).</summary>
    private void ResolvePeople()
    {
        var rows = files.SelectMany(f => f.Candidates).Where(c => c.Kind == ProgrammeRowKind.Rota && !string.IsNullOrWhiteSpace(c.PersonText)).ToList();
        foreach (var c in rows)
        {
            var key = ProgrammeText.NameKey(c.PersonText);
            if (!people.TryGetValue(key, out var answer))
            {
                var match = StaffNameResolver.Resolve(c.PersonText, StaffNameResolver.PhoneKey(ctx!.OrganizationId, c.PhoneText), ctx.People, ctx.Aliases);
                people[key] = answer = new PersonAnswer { Written = c.PersonText!, Match = match, UserId = match.Verdict == NameMatchVerdict.Match ? match.UserId : null };
            }
            c.UserId = answer.UserId;
            if (answer.Skipped) c.Include = false;
        }
        foreach (var n in files.SelectMany(f => f.NotOnRota))
        {
            var key = ProgrammeText.NameKey(n.PersonText);
            if (!people.TryGetValue(key, out var answer))
            {
                var match = StaffNameResolver.Resolve(n.PersonText, StaffNameResolver.PhoneKey(ctx!.OrganizationId, n.PhoneText), ctx.People, ctx.Aliases);
                answer = new PersonAnswer { Written = n.PersonText, Match = match, UserId = match.Verdict == NameMatchVerdict.Match ? match.UserId : null };
                // Only asked about when a meeting's attendance uses them (see ExpectedFor).
                people[key] = answer;
            }
            n.UserId = answer.UserId;
        }

        personQuestions = people
            .Where(p => p.Value.UserId == null && !p.Value.Skipped && rows.Any(r => ProgrammeText.NameKey(r.PersonText) == p.Key))
            .Select(p => new PersonQuestion
            {
                Key = p.Key,
                Written = p.Value.Written,
                Match = p.Value.Match,
                Chosen = p.Value.Match.Candidates.Count == 1 ? p.Value.Match.Candidates[0].UserId : Guid.Empty,
                Slots = rows.Count(r => ProgrammeText.NameKey(r.PersonText) == p.Key)
            })
            .OrderBy(q => q.Written, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    /// <summary>Owners written as offices ("Biology HOD", "Academic Office") to departments and their heads.</summary>
    private void ResolveOffices()
    {
        foreach (var c in files.SelectMany(f => f.Candidates).Where(c => c.Kind != ProgrammeRowKind.Rota && !string.IsNullOrWhiteSpace(c.ResponsibleText)))
        {
            var office = OfficeResolver.Resolve(c.ResponsibleText, ctx!.Departments, ctx.Aliases);
            c.ResponsibleDepartmentIds = office.DepartmentIds;
            c.ResponsibleUserIds = office.UserIds;
            if (c.Kind == ProgrammeRowKind.Meeting) c.RecorderUserIds = office.UserIds;
        }
    }

    /// <summary>
    /// E9: a meeting whose attendance its title did not settle is READ from the document's own words — "Administration,
    /// Senior Ladies &amp; Matrons", "All staff", "HODs", "Class teachers", a name — through AudienceTextResolver. Words it
    /// cannot place leave the row Undecided, a question on the row; it never guesses and never silently gives up.
    /// </summary>
    private void ResolveAttendance()
    {
        foreach (var m in MeetingRowsAll().Where(m => m.Attendance == MeetingAttendance.Undecided))
        {
            var reading = AudienceTextResolver.Resolve(m.ResponsibleText, ctx!.Audience, ctx.People, ctx.Aliases);
            m.AudienceReadings = reading.Readings;
            m.AudienceUnresolved = reading.Unresolved;
            if (reading.Audience.IsEmpty) continue;
            m.StaffAudience = reading.Audience;
            // A partial reading is kept as the starting point, but the row stays a question until the reader confirms it.
            if (reading.Resolved) m.Attendance = reading.Audience.AllStaff ? MeetingAttendance.Everyone : MeetingAttendance.Chosen;
        }
    }

    private void SetChosenAudience(ProgrammeCandidate m, StaffAudienceDto audience)
    {
        m.StaffAudience = audience;
        m.AudienceUnresolved = new();
        RunChecks();
    }

    private string RegistersSentence
    {
        get
        {
            var all = MeetingRowsAll().ToList();
            var registers = MeetingRows().Count();
            var undecided = all.Count(m => m.Attendance == MeetingAttendance.Undecided);
            var events = all.Count - registers - undecided;
            var text = $"{Plural(all.Count, "meeting", "meetings")} in these documents: {Plural(registers, "gets a register", "get a register")}";
            if (events > 0) text += $", {Plural(events, "goes in as a calendar event only", "go in as calendar events only")}";
            if (undecided > 0) text += $", and {Plural(undecided, "needs", "need")} you to say who is expected";
            return text + ".";
        }
    }

    /// <summary>Why a meeting will be a calendar event only — shown on its row, and kept on the import for Import health.</summary>
    private string NoRegisterReason(ProgrammeCandidate m)
    {
        if (!ctx!.CanImportDuties) return ctx.DutiesRefusal ?? "Meetings cannot be imported with registers from this account.";
        if (m.StartTime == null) return "No time is written, and a register needs one.";
        if (m.Attendance == MeetingAttendance.EventOnly) return "A calendar event only — you chose it.";
        if (m.Attendance == MeetingAttendance.Undecided) return "Who is expected was not decided.";
        return "Calendar event only.";
    }

    private string ExpectedLabel(ProgrammeCandidate m) => ExpectedFor(m) is { } ids ? Plural(ids.Count, "person", "people") : "everyone";

    /// <summary>Who could take a register when the document named nobody: the heads of the departments it is for.</summary>
    private List<Guid> SuggestedRecorders(ProgrammeCandidate m)
    {
        var departments = (m.StaffAudience?.DepartmentIds ?? new()).Concat(m.ResponsibleDepartmentIds).ToHashSet();
        return ctx!.Audience.Departments.Where(d => departments.Contains(d.Id) && d.HeadUserId.HasValue)
            .Select(d => d.HeadUserId!.Value).Concat(m.ResponsibleUserIds).Distinct().Take(3).ToList();
    }

    private string PersonName(Guid id) => ctx?.Audience.People.FirstOrDefault(p => p.UserId == id)?.FullName ?? "them";

    private void RunChecks()
    {
        checks = ProgrammeChecks.Run(files, ctx!.Settings, ctx.National);
        foreach (var issue in checks.Issues) issue.Resolved = acknowledged.Contains(IssueKey(issue));
    }

    private static string IssueKey(ProgrammeIssue i)
        => $"{i.Kind}|{i.Date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}|{string.Join(',', i.CandidateIds)}|{i.PersonText}";

    private int OpenMustDecide => (checks?.MustDecide.Count(i => !i.Resolved) ?? 0) + personQuestions.Count(q => !q.Answered)
        + MeetingRows().Count(ExpectsNobody)
        // E9: a meeting nobody has said who attends, and a register nobody is named to take, are both questions.
        + (ctx?.CanImportDuties == true ? MeetingRowsAll().Count(m => m.Attendance == MeetingAttendance.Undecided && m.StartsOn.HasValue) : 0)
        + MeetingRows().Count(m => m.RecorderUserIds.Count == 0 && !m.RecordersDecided);

    /// <summary>A meeting with a register whose attendance resolves to nobody on the staff list — a question, not a submit-time refusal.</summary>
    private bool ExpectsNobody(ProgrammeCandidate m)
        => ctx != null && ctx.CanImportDuties && m.Kind == ProgrammeRowKind.Meeting
           && m.Attendance is not (MeetingAttendance.EventOnly or MeetingAttendance.Undecided)
           && m.StartTime != null && ExpectedFor(m) is { Count: 0 };

    private IEnumerable<StaffCandidate> PeopleFor(PersonQuestion q)
    {
        var first = q.Match.Candidates.Select(c => c.UserId).ToHashSet();
        return ctx!.People.Where(p => first.Contains(p.UserId))
            .Concat(ctx.People.Where(p => !first.Contains(p.UserId)).OrderBy(p => p.FullName, StringComparer.OrdinalIgnoreCase));
    }

    private void AnswerPerson(PersonQuestion q)
    {
        if (q.Chosen == Guid.Empty) return;
        q.Answered = true;
        if (people.TryGetValue(q.Key, out var answer))
        {
            answer.UserId = q.Chosen;
            answer.Confirmed = true;
        }
        foreach (var c in AllCandidates().Where(c => c.Kind == ProgrammeRowKind.Rota && ProgrammeText.NameKey(c.PersonText) == q.Key)) c.UserId = q.Chosen;
        foreach (var n in files.SelectMany(f => f.NotOnRota).Where(n => ProgrammeText.NameKey(n.PersonText) == q.Key)) n.UserId = q.Chosen;
        RunChecks();
    }

    private void SkipPerson(PersonQuestion q)
    {
        q.Answered = true;
        if (people.TryGetValue(q.Key, out var answer)) answer.Skipped = true;
        foreach (var c in AllCandidates().Where(c => c.Kind == ProgrammeRowKind.Rota && ProgrammeText.NameKey(c.PersonText) == q.Key)) c.Include = false;
        RunChecks();
    }

    private void ChooseDate(ProgrammeIssue issue, DateOnly date)
    {
        var rows = AllCandidates().Where(c => issue.CandidateIds.Contains(c.Id)).ToList();
        foreach (var c in rows)
        {
            if (c.StartsOn is { } start)
            {
                var length = (c.EndsOn ?? start).DayNumber - start.DayNumber;
                c.StartsOn = date;
                c.EndsOn = date.AddDays(length);
            }
            else { c.StartsOn = date; c.EndsOn = date; }
            c.WeekdayMismatch = false;
        }
        // Two documents about one thing: keep the first, the others fold into it on the chosen date.
        if (issue.Kind == ProgrammeIssueKind.Conflict && rows.Count > 1)
        {
            var keep = rows.FirstOrDefault(r => r.Kind == ProgrammeRowKind.Meeting) ?? rows[0];
            foreach (var other in rows.Where(r => r != keep)) other.MergedIntoId = keep.Id;
        }
        acknowledged.Add(IssueKey(issue));
        RunChecks();
    }

    private void ApplySuggestion(ProgrammeIssue issue)
    {
        var slot = AllCandidates().FirstOrDefault(c => c.Id == issue.SuggestCandidateId);
        if (slot == null || issue.SuggestTo is not { } to) return;
        slot.StartsOn = to;
        slot.EndsOn = to;
        slot.Notes.Add($"Date changed from {issue.SuggestFrom?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)} on your say-so.");
        RunChecks();
    }

    private void FillGap(ProgrammeIssue issue, Guid userId)
    {
        if (userId == Guid.Empty || issue.Date is not { } date) return;
        var rotaName = AllCandidates().Where(c => c.Kind == ProgrammeRowKind.Rota && c.RotaName != null).Select(c => c.RotaName!).Distinct()
            .FirstOrDefault(n => issue.Message.Contains(n, StringComparison.Ordinal));
        var template = AllCandidates().FirstOrDefault(c => c.Kind == ProgrammeRowKind.Rota && c.RotaName == rotaName)
                       ?? AllCandidates().FirstOrDefault(c => c.Kind == ProgrammeRowKind.Rota);
        if (template == null) return;
        var person = ctx!.People.First(p => p.UserId == userId);
        var file = files.First(f => f.FileName == template.FileName);
        var row = new ProgrammeCandidate
        {
            Id = $"added#{++addedRows}",
            FileName = template.FileName,
            TableIndex = template.TableIndex,
            TableKind = template.TableKind,
            Kind = ProgrammeRowKind.Rota,
            Title = template.RotaName ?? template.Title,
            RotaName = template.RotaName,
            PersonText = person.FullName,
            UserId = userId,
            StartsOn = date,
            EndsOn = date,
            DateText = date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
            SourceKey = ProgrammeTableParser.RotaKey(template.RotaName ?? template.Title, person.FullName, date)
        };
        row.Notes.Add("Added here to fill a gap.");
        file.Candidates.Add(row);
        people.TryAdd(ProgrammeText.NameKey(person.FullName), new PersonAnswer { Written = person.FullName, UserId = userId });
        RunChecks();
    }

    private void DateUndated(ProgrammeIssue issue, DateTime? value)
    {
        if (value is not { } v) return;
        var date = DateOnly.FromDateTime(v);
        foreach (var c in AllCandidates().Where(c => issue.CandidateIds.Contains(c.Id)))
        {
            c.StartsOn = date;
            c.EndsOn = date;
            if (c.Kind != ProgrammeRowKind.Rota)
                c.SourceKey = c.SourceKey.Replace(":undated", ":" + date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), StringComparison.Ordinal);
        }
        RunChecks();
    }

    private void LeaveOut(ProgrammeIssue issue)
    {
        foreach (var c in AllCandidates().Where(c => issue.CandidateIds.Contains(c.Id))) c.Include = false;
        RunChecks();
    }

    private void MeetingAsEvent(ProgrammeIssue issue)
    {
        foreach (var c in AllCandidates().Where(c => issue.CandidateIds.Contains(c.Id))) c.Attendance = MeetingAttendance.EventOnly;
        RunChecks();
    }

    private void Acknowledge(ProgrammeIssue issue)
    {
        acknowledged.Add(IssueKey(issue));
        issue.Resolved = true;
    }

    private void SetAttendance(ProgrammeCandidate m, MeetingAttendance a)
    {
        m.Attendance = a;
        if (a == MeetingAttendance.RoleHolders && m.AttendanceRole == null) m.AttendanceRole = roles.FirstOrDefault();
        if (a == MeetingAttendance.Chosen && m.StaffAudience == null) m.StaffAudience = new StaffAudienceDto { AllStaff = false };
        RunChecks();
    }

    private List<AttendanceOption> AttendanceOptions(ProgrammeCandidate m)
    {
        var list = new List<AttendanceOption>();
        if (m.Attendance == MeetingAttendance.Undecided) list.Add(new(MeetingAttendance.Undecided, "Choose who is expected"));
        list.Add(new(MeetingAttendance.Everyone, "Every member of staff"));
        list.Add(new(MeetingAttendance.DepartmentHeads, "Heads of department"));
        list.Add(new(MeetingAttendance.Chosen, "Groups, roles or people…"));
        if (roles.Count > 0) list.Add(new(MeetingAttendance.RoleHolders, "People the rota lists as…"));
        list.Add(new(MeetingAttendance.EventOnly, "Calendar event only — no register"));
        return list;
    }

    /// <summary>The expected list a meeting will be sent with: null = everyone.</summary>
    private List<Guid>? ExpectedFor(ProgrammeCandidate m) => m.Attendance switch
    {
        MeetingAttendance.Everyone => null,
        MeetingAttendance.DepartmentHeads => ctx!.Departments.Where(d => d.HeadUserId.HasValue).Select(d => d.HeadUserId!.Value).Distinct().ToList(),
        MeetingAttendance.RoleHolders => m.AttendanceRole == null ? new List<Guid>()
            : ProgrammeChecks.RoleHolders(files, m.AttendanceRole).Where(n => n.UserId.HasValue).Select(n => n.UserId!.Value).Distinct().ToList(),
        // Chosen: the audience through the ONE membership rule, over people whose staff group the server resolved.
        MeetingAttendance.Chosen when m.StaffAudience is { AllStaff: true } => null,
        MeetingAttendance.Chosen => StaffAudienceRule.Members(m.StaffAudience ?? new StaffAudienceDto { AllStaff = false }, ctx!.Audience.People)
            .Select(p => p.UserId).Concat(m.ExpectedUserIds).Distinct().ToList(),
        _ => new List<Guid>()
    };

    /// <summary>The staff audience a meeting's CALENDAR EVENT carries: the same people its register expects.</summary>
    private StaffAudienceDto EventAudienceFor(ProgrammeCandidate m) => m.Attendance switch
    {
        MeetingAttendance.Chosen when m.StaffAudience != null => m.StaffAudience,
        _ when ExpectedFor(m) is { } ids => new StaffAudienceDto { AllStaff = false, UserIds = ids },
        _ => StaffAudienceDto.Everyone()
    };

    private string TermLabel()
    {
        if (termFromDocs is not { } t) return string.Empty;
        return $"Set {termName ?? "the term"} to {QDateFormat.D(t.Start)} – {QDateFormat.D(t.End)}" + (termTheme != null ? $", theme \"{termTheme}\"" : string.Empty);
    }

    private string? TermNameFromDocs()
    {
        foreach (var title in files.Select(f => f.Title).Where(t => t != null))
        {
            var words = ProgrammeText.Words(title);
            var i = words.IndexOf("TERM");
            if (i >= 0 && i + 1 < words.Count && int.TryParse(words[i + 1], out var n) && n is >= 1 and <= 4)
            {
                var year = files.Select(f => f.Year).FirstOrDefault(y => y.HasValue);
                return $"Term {n} {year}".Trim();
            }
        }
        return null;
    }

