    private bool canManageStudents;
    private bool showConsentModal, isSavingConsent;
    private StudentDto? consentTargetStudent;
    private string consentNotes = "";

    private void OpenConsentModal(StudentDto s)
    {
        consentTargetStudent = s;
        consentNotes = s.DataConsentNotes ?? "";
        showConsentModal = true;
    }

    private async Task SaveConsent(bool given)
    {
        if (consentTargetStudent == null) return;
        isSavingConsent = true;
        try
        {
            var updated = await StudentApi.UpdateConsentAsync(branchId, consentTargetStudent.Id,
                new UpdateStudentConsentRequest { Given = given, Notes = given ? consentNotes : null });
            if (updated == null)
            {
                NotificationService.Notify(ToastSeverity.Error, "Could not save", "Consent wasn't updated — check the notes are under 500 characters and try again.");
                return;
            }
            NotificationService.Notify(ToastSeverity.Success, given ? "Consent recorded" : "Consent withdrawn", $"{updated.FullName}'s data consent updated.");
            showConsentModal = false;
            await LoadStudents();
        }
        finally
        {
            isSavingConsent = false;
        }
    }

    // ---------------- Subject-access-request export ----------------

    private async Task ExportStudentData(StudentDto s)
    {
        var file = await StudentApi.ExportStudentDataAsync(branchId, s.Id);
        if (file == null)
        {
            NotificationService.Notify(ToastSeverity.Error, "Export failed", "Couldn't build the data export — this needs both roster and welfare view access.");
            return;
        }
        var dataUrl = "data:application/json;base64," + Convert.ToBase64String(file.Content);
        await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, file.FileName);
        NotificationService.Notify(ToastSeverity.Success, "Export ready", $"{file.FileName} downloaded");
    }

