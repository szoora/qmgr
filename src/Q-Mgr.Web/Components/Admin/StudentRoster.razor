        PreviousSchool = m.PreviousSchool
    };

    /// <summary>
    /// Mirrors StudentsController.ValidateProfile field for field. When a rule fails the tab
    /// holding the offending field is opened, because an error message about a field on a hidden
    /// tab is indistinguishable from nothing happening.
    /// </summary>
    private bool ValidateStudentForm()
    {
        fieldErrors.Clear();
        studentFormError = null;
        var today = DateOnly.FromDateTime(DateTime.Now);

        if (string.IsNullOrWhiteSpace(studentModel.FullName))
            fieldErrors[nameof(studentModel.FullName)] = "Full name is required";
        else if (studentModel.FullName.Trim().Length > 255)
            fieldErrors[nameof(studentModel.FullName)] = "Full name cannot exceed 255 characters";

        if (studentModel.DateOfBirth is { } dob)
        {
            if (dob > today)
                fieldErrors[nameof(studentModel.DateOfBirth)] = "Date of birth cannot be in the future";
            else if (dob < today.AddYears(-130))
                fieldErrors[nameof(studentModel.DateOfBirth)] = "That is not a plausible date of birth";
        }

        if (studentModel.AdmissionDate is { } adm)
        {
            if (adm > today.AddYears(1))
                fieldErrors[nameof(studentModel.AdmissionDate)] = "Admission cannot be more than a year ahead";
            else if (studentModel.DateOfBirth is { } d && adm < d)
                fieldErrors[nameof(studentModel.AdmissionDate)] = "Admission cannot precede the date of birth";
        }

        if (!string.IsNullOrWhiteSpace(studentModel.HomeDistrict) && string.IsNullOrWhiteSpace(studentModel.HomeCountry))
            fieldErrors[nameof(studentModel.HomeCountry)] = "Choose the country before the district";
        else if (!Geography.IsValidDistrict(studentModel.HomeCountry, studentModel.HomeDistrict))
            fieldErrors[nameof(studentModel.HomeDistrict)] = "That area is not in the chosen country";

        if (fieldErrors.Count == 0) return true;

        // Open the tab holding the offending field — an error about a field on a hidden tab is
        // indistinguishable from nothing happening.
        var offending = fieldErrors.Keys.First();
        activeTab = offending is nameof(UpdateStudentRequest.HomeCountry) or nameof(UpdateStudentRequest.HomeDistrict)
            ? "home"
            : "identity";
        studentFormError = fieldErrors.Values.First();
        return false;
    }

