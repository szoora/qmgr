    // ---------------- Quick-Log Welfare Record ----------------

    private bool canLogWelfare, canViewWelfare;
    private bool showQuickLogModal;
    private bool quickLogCategoryError, quickLogDescriptionError;
    private StudentDto? quickLogStudent;
    private List<WelfareCategoryDto> quickLogCategories = new();
    private CreateWelfareRecordRequest quickLogModel = new();

    private async Task OpenQuickLogModal(StudentDto s)
    {
        quickLogStudent = s;
        quickLogModel = new CreateWelfareRecordRequest { StudentId = s.Id, CaseType = QMgr.Domain.Enums.WelfareCaseType.Achievement, Tier = QMgr.Domain.Enums.WelfareTier.Low };
        quickLogCategoryError = quickLogDescriptionError = false;

        if (!quickLogCategories.Any())
        {
            var response = await Http.GetAsync($"api/v1/branches/{branchId}/welfare/categories");
            if (response.IsSuccessStatusCode)
                quickLogCategories = await response.Content.ReadFromJsonAsync<List<WelfareCategoryDto>>(JsonOptions) ?? new();
            else
                // Category is required on this form, so an empty list does not merely look odd:
                // it makes the dialog impossible to submit, with nothing on screen saying why.
                NotificationService.Notify(ToastSeverity.Error, "Could not load welfare categories",
                    await ApiErrorService.GetErrorMessageAsync(response, "The category list could not be loaded."));
        }

        showQuickLogModal = true;
    }

    private void SelectQuickLogCaseType(QMgr.Domain.Enums.WelfareCaseType caseType)
    {
        quickLogModel.CaseType = caseType;
        quickLogModel.CategoryId = Guid.Empty;
    }

    private void OnQuickLogCategorySelected(Guid categoryId)
    {
        quickLogModel.CategoryId = categoryId;
        var category = quickLogCategories.FirstOrDefault(c => c.Id == categoryId);
        if (category != null)
        {
            quickLogModel.Tier = category.DefaultTier;
            quickLogModel.Points = category.DefaultPoints;
        }
    }

    private async Task SaveQuickLog()
    {
        quickLogCategoryError = quickLogModel.CategoryId == Guid.Empty;
        var description = (quickLogModel.Description ?? "").Trim();
        quickLogDescriptionError = description.Length < 10 || description.Length > 2000;

        if (quickLogCategoryError || quickLogDescriptionError)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please fix the highlighted fields");
            return;
        }

        try
        {
            quickLogModel.Description = description;
            quickLogModel.OccurredAt = DateTime.Now;

            var response = await Http.PostAsJsonAsync($"api/v1/branches/{branchId}/welfare-records", quickLogModel, JsonOptions);
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", $"Record logged for {quickLogStudent?.FullName}");
                showQuickLogModal = false;
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save record: {ex.Message}");
        }
    }
