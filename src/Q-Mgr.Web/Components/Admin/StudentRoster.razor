    // QDatePicker binds DateTime?; the entity and DTO use DateOnly because a birthday has no time
    // of day and storing one invites a timezone bug that silently shifts a child's date of birth
    // across midnight. These two properties are the bridge, and they are the only place the
    // conversion happens.
    /// <summary>
    /// Changing country clears a district that does not belong to the new one. Silently keeping
    /// "Mbarara" after switching to Kenya would leave a value the server then rejects, and the
    /// user would have no idea which field was at fault. A district that IS valid in the new
    /// country (Busia exists in both Uganda and Kenya) is kept — clearing it would be needless.
    /// </summary>
    private void OnCountryChanged(string? country)
    {
        studentModel.HomeCountry = country;

        if (!Geography.IsValidDistrict(country, studentModel.HomeDistrict))
            studentModel.HomeDistrict = null;

        if (string.IsNullOrWhiteSpace(country))
            studentModel.HomeDistrict = null;

        fieldErrors.Remove(nameof(studentModel.HomeCountry));
        fieldErrors.Remove(nameof(studentModel.HomeDistrict));
    }

