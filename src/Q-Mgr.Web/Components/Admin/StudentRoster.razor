    private async Task SaveStudent()
    {
        // Client-side first: it costs no round trip and it can point at the exact field. The
        // server re-runs every one of these regardless — the form is a courtesy, the API is the
        // boundary, and a rule that only exists in Razor is not enforced at all.
        if (!ValidateStudentForm()) return;

        isSavingStudent = true;
        studentFormError = null;
        try
        {
            if (editingStudentId.HasValue)
            {
                await StudentApi.UpdateStudentAsync(branchId, editingStudentId.Value, studentModel);
            }
            else
            {
                // Copy every background field across, not just the three the roster used to
                // collect — a create that silently dropped the tabs the user just filled in is
                // the obvious trap here.
                await StudentApi.CreateStudentAsync(branchId, ToCreateRequest(studentModel));
            }
            NotificationService.Notify(ToastSeverity.Success, "Saved", $"{studentModel.FullName} saved.");
            showStudentModal = false;
            await LoadStudents();
        }
        catch (InvalidOperationException ex)
        {
            // Shown inside the dialog as well as toasted: the dialog stays open on failure, and a
            // toast that has already faded is no help to someone re-reading the form.
            studentFormError = ex.Message;
            NotificationService.Notify(ToastSeverity.Error, "Could not save", ex.Message);
        }
        finally
        {
            isSavingStudent = false;
        }
    }

