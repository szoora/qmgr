    private string OriginalNameOf(VocabularyItemDto item) =>
        vocabOriginalNames.TryGetValue(item, out var original) ? original : item.Name;

    /// <summary>
    /// How many students hold this value. Keyed on the ORIGINAL name, because the count came from
    /// the database and the database still has the old string until the save propagates the rename.
    /// </summary>
    private int UsageFor(string tab, string name)
    {
        var key = tab switch { "classes" => "classes", "houses" => "houses", "dormitories" => "dormitories", _ => "" };
        if (key.Length == 0 || !vocabUsage.TryGetValue(key, out var list)) return 0;
        return list.FirstOrDefault(u => string.Equals(u.Name, name, StringComparison.OrdinalIgnoreCase))?.StudentCount ?? 0;
    }

    private void RenameItem(string tab, VocabularyItemDto item, string newName)
    {
        vocabError = null;
        newName = newName.Trim();
        if (newName.Length == 0)
        {
            vocabError = "A name cannot be blank";
            return;
        }

        var clash = ItemsFor(tab).Any(i => !ReferenceEquals(i, item) && string.Equals(i.Name, newName, StringComparison.OrdinalIgnoreCase));
        if (clash)
        {
            vocabError = $"'{newName}' is already on this list";
            return;
        }

        item.Name = newName;
    }

    private void AddItem(string tab)
    {
        vocabError = null;
        var name = newItemName.Trim();
        if (name.Length == 0) return;

        var items = ItemsFor(tab);
        if (items.Any(i => string.Equals(i.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            vocabError = $"'{name}' is already on this list";
            return;
        }

        items.Add(new VocabularyItemDto
        {
            Name = name,
            SortOrder = items.Count == 0 ? 0 : items.Max(i => i.SortOrder) + 1,
            IsActive = true
        });
        newItemName = "";
    }

    private void AddSuggestion(string tab)
    {
        vocabError = null;
        var value = newItemName.Trim();
        if (value.Length == 0) return;

        var list = SuggestionsFor(tab);
        if (list.Any(v => string.Equals(v, value, StringComparison.OrdinalIgnoreCase)))
        {
            vocabError = $"'{value}' is already suggested";
            return;
        }

        list.Add(value);
        newItemName = "";
    }

    /// <summary>
    /// Removing is only reachable when nothing holds the value — the button is disabled otherwise
    /// and the server refuses it regardless. Retiring is the answer for a class that still has
    /// students in it.
    /// </summary>
    private void RemoveItem(string tab, VocabularyItemDto item)
    {
        vocabError = null;
        if (UsageFor(tab, OriginalNameOf(item)) > 0)
        {
            vocabError = $"'{item.Name}' is still in use — retire it instead of removing it";
            return;
        }
        ItemsFor(tab).Remove(item);
        vocabOriginalNames.Remove(item);
    }

    /// <summary>
    /// Order is explicit because the natural one is wrong: S.1 … S.10 sorts alphabetically as
    /// S.1, S.10, S.2, which is the first thing a school notices.
    /// </summary>
    private void MoveItem(string tab, VocabularyItemDto item, int direction)
    {
        var ordered = ItemsFor(tab).OrderBy(i => i.SortOrder).ToList();
        var index = ordered.IndexOf(item);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= ordered.Count) return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);
        for (var i = 0; i < ordered.Count; i++) ordered[i].SortOrder = i;
    }

    private async Task SaveVocabularies()
    {
        vocabError = null;
        isSavingVocab = true;
        try
        {
            var request = new UpdateBranchVocabulariesRequest
            {
                Vocabularies = vocabEdit,
                ClassRenames = RenamesFor(vocabEdit.Classes),
                HouseRenames = RenamesFor(vocabEdit.Houses),
                DormitoryRenames = RenamesFor(vocabEdit.Dormitories)
            };

            var result = await StudentApi.UpdateVocabulariesAsync(branchId, request);
            vocabularies = result.Vocabularies;

            // Colour lives on the class entry now; keep the roster's own colour lookup in step so
            // the pills update without a reload.
            classColors = vocabularies.Classes
                .Where(c => !string.IsNullOrWhiteSpace(c.Color))
                .ToDictionary(c => c.Name, c => c.Color!, StringComparer.OrdinalIgnoreCase);

            NotificationService.Notify(ToastSeverity.Success, "Saved",
                result.StudentsRenamed > 0
                    ? $"Lists saved. {result.StudentsRenamed} student record{(result.StudentsRenamed == 1 ? "" : "s")} updated by the rename."
                    : "Lists saved.");

            showVocabModal = false;
            await LoadStudents();
        }
        catch (InvalidOperationException ex)
        {
            vocabError = ex.Message;
        }
        finally
        {
            isSavingVocab = false;
        }
    }

    private Dictionary<string, string> RenamesFor(List<VocabularyItemDto> items)
    {
        var renames = new Dictionary<string, string>();
        foreach (var item in items)
        {
            if (!vocabOriginalNames.TryGetValue(item, out var original)) continue;
            if (!string.Equals(original, item.Name, StringComparison.Ordinal))
                renames[original] = item.Name;
        }
        return renames;
    }
