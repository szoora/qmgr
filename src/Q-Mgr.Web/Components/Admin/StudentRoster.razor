    /// <summary>
    /// The primary class teacher for a class name, or null. Trim().ToLower() on BOTH sides — the
    /// same normalization ClassTeachersController.NormalizeClassName, StudentScopeService and
    /// WelfareAlertService use. A stray space here would show "No teacher" for a class that has
    /// one, which is the cosmetic face of a safeguarding-relevant matching bug.
    /// </summary>
    private ClassTeacherDto? ClassTeacherFor(string? className)
    {
        if (string.IsNullOrWhiteSpace(className)) return null;
        var key = className.Trim().ToLowerInvariant();

        return classTeachers.FirstOrDefault(t =>
                   t.Role == ClassTeacherRole.ClassTeacher && t.ClassName.Trim().ToLowerInvariant() == key)
               ?? classTeachers.FirstOrDefault(t => t.ClassName.Trim().ToLowerInvariant() == key);
    }

    /// <summary>The teacher's contact card as one hover line — job title, email, phones, office.</summary>
    private static string ContactTitle(ClassTeacherDto t)
    {
        var parts = new List<string> { $"{t.FullName} — class teacher" };
        if (!string.IsNullOrWhiteSpace(t.JobTitle)) parts.Add(t.JobTitle!);
        if (!string.IsNullOrWhiteSpace(t.Email)) parts.Add(t.Email);
        if (!string.IsNullOrWhiteSpace(t.Phone)) parts.Add(t.Phone!);
        if (!string.IsNullOrWhiteSpace(t.AlternatePhone)) parts.Add(t.AlternatePhone!);
        if (!string.IsNullOrWhiteSpace(t.OfficeLocation)) parts.Add(t.OfficeLocation!);
        return string.Join(" · ", parts);
    }

