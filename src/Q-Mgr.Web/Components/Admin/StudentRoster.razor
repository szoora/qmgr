@page "/admin/students/roster"
@* The old route is kept so bookmarks and any link already sent to a school still work. The roster
   lived under /admin/visitors when the welfare features were part of the visitor module; they are
   separate modules now and a welfare-only subscriber should not see "visitors" in their URL. *@
@page "/admin/visitors/roster"
@implements IAsyncDisposable
@inject IStudentApiService StudentApi
@inject IBatchApiService BatchApi
@inject INotificationClientService NotificationClient
@inject IToastService NotificationService
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions JsonOptions
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IClassTeacherApiService ClassTeacherApi
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Shared.UI
@using QMgr.Web.Services

<PageTitle>Student Roster - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Student Roster</h1>
            <p class="subtitle">Pre-register visiting-day guardians against your student roll, so check-in is a search and a tap — not a form.</p>
        </div>
        <div class="header-actions">
            <QButton Text="Import History" Icon="clock-history" Variant="secondary" OnClick="@OpenHistoryModal" />
            <PermissionGuard Permission="students.manage">
                <QButton Text="Lists" Icon="list-check" Variant="secondary" OnClick="@OpenVocabModal" Title="Classes, houses, dormitories and the suggestion lists" />
                <QButton Text="Bulk Import" Icon="file-earmark-spreadsheet" Variant="secondary" OnClick="@OpenImportModal" />
                <QButton Text="Add Student" Icon="person-plus-fill" Variant="primary" OnClick="@OpenAddStudentModal" />
            </PermissionGuard>
        </div>
    </div>

    <div class="roster-toolbar">
        <input class="roster-search-input" @bind="filterQuery" @bind:event="oninput" placeholder="Filter by student name, code, class, or guardian name..." />
        <label class="roster-toggle">
            <input type="checkbox" @bind="includeInactive" @bind:after="LoadStudents" />
            <span>Show inactive</span>
        </label>
        <QButton Text="@($"Print Selected ({selectedStudentIds.Count})")" Icon="printer-fill" Variant="secondary" OnClick="@PrintAllStudentCards"
                 Disabled="@(selectedStudentIds.Count == 0)"
                 Title="Print Student Visitation Cards for the checked students — 8 per A4 sheet" />

        @* Export gates on the permission that governs *reading* the roster, not a second one of
           its own. Downloading a list is a bigger data-protection event than paging through it,
           but a separate permission on every list is friction nobody asked for — and this page is
           already behind students.view. *@
        <QDataExport TItem="StudentDto"
                     Title="Student roster"
                     FileStem="@($"roster-{(BranchState.CurrentBranchName ?? "branch")}")"
                     Subtitle="@ExportSubtitle"
                     Columns="@RosterExportColumns"
                     RowProvider="@ProvideExportRowsAsync" />
    </div>

    @* The batch bar appears only when something is selected, and says what is selected — a bar
       that is always there reads as chrome, and one that says "Actions" makes somebody click it
       to find out what it would act on. *@
    @if (selectedStudentIds.Count > 0 && canManageStudents)
    {
        <div class="batch-bar">
            <span class="batch-bar-count">
                <QIcon Name="check2-square" />
                <strong>@selectedStudentIds.Count.ToString("N0")</strong> selected
            </span>

            <QButton Text="Promote to next class" Icon="arrow-up-circle" Size="sm" Variant="primary"
                     OnClick="@(() => OpenBatch(BatchOperation.AdvanceClass))"
                     Title="Move each selected student to the next class in this branch's list" />

            <div class="dropdown">
                <QButton Text="Set a field" Icon="pencil-square" Size="sm" Variant="secondary"
                         data-bs-toggle="dropdown" aria-expanded="false" />
                <ul class="dropdown-menu batch-menu">
                    @foreach (var f in BatchFields)
                    {
                        <li><button type="button" class="dropdown-item" @onclick="@(() => OpenSetField(f))">@FieldLabel(f)</button></li>
                    }
                </ul>
            </div>

            <div class="dropdown">
                <QButton Text="More" Icon="three-dots" Size="sm" Variant="ghost"
                         data-bs-toggle="dropdown" aria-expanded="false" />
                <ul class="dropdown-menu dropdown-menu-end batch-menu">
                    <li><button type="button" class="dropdown-item" @onclick="@(() => OpenBatch(BatchOperation.SetConsent, "give"))">
                        <QIcon Name="patch-check" /> Record data consent
                    </button></li>
                    <li><button type="button" class="dropdown-item" @onclick="@(() => OpenBatch(BatchOperation.SetConsent, "withdraw"))">
                        <QIcon Name="patch-exclamation" /> Withdraw data consent
                    </button></li>
                    <li><hr class="dropdown-divider" /></li>
                    @* Retiring a child hides them from the roster, the gate and visiting day, so it
                       is its own deliberate action and never a side effect of promotion. *@
                    <li><button type="button" class="dropdown-item batch-danger" @onclick="@(() => OpenBatch(BatchOperation.Deactivate))">
                        <QIcon Name="box-arrow-right" /> Mark as left
                    </button></li>
                </ul>
            </div>

            <button type="button" class="batch-clear" @onclick="@(() => selectedStudentIds.Clear())">Clear selection</button>
        </div>
    }

    @* Undo stays offered until it is used or the page is left. There is deliberately no time
       limit — a window would be arbitrary, and the real question is whether anything has moved
       underneath, which the server asks when the button is pressed. *@
    @if (lastBatchJobId.HasValue)
    {
        <div class="batch-done">
            <QIcon Name="check-circle-fill" />
            <span>@lastBatchSummary</span>
            <QButton Text="Undo this" Icon="arrow-counterclockwise" Size="sm" Variant="ghost" OnClick="@UndoLastBatch" />
            <button type="button" class="batch-clear" @onclick="@(() => lastBatchJobId = null)">Dismiss</button>
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-state"><QSpinner Size="lg" /><span>Loading roster...</span></div>
    }
    else if (!students.Any())
    {
        <div class="empty-state">
            <QIcon Name="mortarboard" Size="xl" />
            <h3>No students on the roster yet</h3>
            <p>Add students one at a time, or use Bulk Import to upload your whole roll from a spreadsheet.</p>
        </div>
    }
    else
    {
        <div class="roster-table">
            <div class="roster-row roster-header">
                <span class="roster-select">
                    <input type="checkbox" checked="@AllFilteredSelected" @onchange="@(e => ToggleSelectAll((bool)(e.Value ?? false)))"
                           title="Select all matching the current filter" />
                </span>
                <span>Student</span>
                <span>Code</span>
                <span>Class</span>
                <span>Guardians</span>
                <span></span>
            </div>
            @foreach (var s in FilteredStudents)
            {
                <div class="roster-row @(s.IsActive ? "" : "inactive")">
                    <span class="roster-select">
                        <input type="checkbox" checked="@selectedStudentIds.Contains(s.Id)" @onchange="@(e => ToggleStudentSelection(s.Id, (bool)(e.Value ?? false)))" />
                    </span>
                    <span class="roster-name">
                        @* The name is the way in to the student. It is what people aim at first,
                           and making it the link removed an icon from the action cluster that did
                           nothing else. *@
                        @if (canViewWelfare)
                        {
                            <a class="roster-name-text roster-name-link" href="@($"/admin/students/{s.Id}/picture")"
                               title="@($"Open {s.FullName}'s picture")">@s.FullName</a>
                        }
                        else
                        {
                            <span class="roster-name-text">@s.FullName</span>
                        }
                        @* A patch, not a shield. The shield is what a *restriction* looks like on
                           this row (below, and on the flag chips), and one glyph meaning both
                           "consent is on file" and "a guardian may not have contact" a centimetre
                           apart is how somebody misreads a safeguarding row. *@
                        <span class="consent-icon @(s.DataConsentGivenAt.HasValue ? "consent-icon--given" : "")"
                              title="@(s.DataConsentGivenAt.HasValue ? $"Data consent recorded {QDateFormat.D(s.DataConsentGivenAt.Value.ToLocalTime())}{(string.IsNullOrWhiteSpace(s.DataConsentNotes) ? "" : " — " + s.DataConsentNotes)}" : "No data consent on file")">
                            <QIcon Name="@(s.DataConsentGivenAt.HasValue ? "patch-check-fill" : "patch-question")" Size="sm" />
                        </span>

                        @* A restriction is the one thing on this row somebody has to act on at the
                           gate, so it is loud and it comes first. The reason behind it stays on the
                           picture page, where the confidential tier governs it. *@
                        @if (s.HasGuardianRestriction)
                        {
                            <span class="roster-chip restriction" title="A guardian on this child has a contact restriction — open the picture for the detail">
                                <QIcon Name="shield-exclamation" Size="12" />
                                Restricted
                            </span>
                        }
                        @foreach (var f in s.Flags.Take(3))
                        {
                            <span class="roster-chip tier-@f.Tier.ToString().ToLowerInvariant() @(f.IsReviewOverdue ? "overdue" : "")"
                                  title="@($"{f.CategoryName}{(f.IsReviewOverdue ? " — review overdue" : "")}")">
                                @f.CategoryName
                            </span>
                        }
                        @if (s.Flags.Count > 3)
                        {
                            <span class="roster-chip more" title="@string.Join(", ", s.Flags.Skip(3).Select(f => f.CategoryName))">
                                +@(s.Flags.Count - 3)
                            </span>
                        }
                    </span>
                    <span class="roster-code">@(s.StudentCode ?? "—")</span>
                    <span class="roster-class-cell">
                        @if (!string.IsNullOrEmpty(s.ClassName))
                        {
                            <span class="class-pill" style="@($"background:{GetClassColor(s.ClassName)}")">@s.ClassName</span>

                            @* "Who do I call about this child" answered on the row itself. The DTO
                               already carries the teacher's contact block, so this costs no extra
                               request — and the tel: link matters because the front desk reads this
                               list on a touch screen where a tooltip never appears. *@
                            @if (ClassTeacherFor(s.ClassName) is { } ct)
                            {
                                <span class="roster-ct">
                                    <QIcon Name="person-video3" Size="11" />
                                    @if (!string.IsNullOrWhiteSpace(ct.Phone))
                                    {
                                        <a href="tel:@ct.Phone" title="@ContactTitle(ct)">@ct.FullName</a>
                                    }
                                    else
                                    {
                                        <span title="@ContactTitle(ct)">@ct.FullName</span>
                                    }
                                </span>
                            }
                        }
                        else
                        {
                            @:—
                        }
                    </span>
                    <span class="roster-guardians">
                        @if (s.Guardians.Any())
                        {
                            @foreach (var g in s.Guardians)
                            {
                                <span class="guardian-chip">
                                    @g.FullName (@g.Relationship)
                                    <QButton Icon="printer-fill" Size="sm" Variant="ghost" Class="guardian-print-btn"
                                             OnClick="@(() => PrintGuardianCard(s, g))" Title="@($"Print visiting-day pass for {g.FullName}")" />
                                </span>
                            }
                        }
                        else
                        {
                            <span class="roster-empty-guardians">None yet</span>
                        }
                    </span>
                    @* One action on the row, everything else behind a menu that names them.
                       There were eight identical ghost icons here and no way to tell them apart
                       without hovering each one in turn — and two of them were the same glyph in
                       outline and filled form (person-vcard for "open picture", person-vcard-fill
                       for "print card"). Logging a record is the only thing done on every pass
                       down this list; editing a student, adding a guardian, printing a card, an
                       export or a consent withdrawal are all occasional, so they are one
                       deliberate click away where they get a written label rather than a tooltip
                       nobody hovers. The one that stays keeps its label at every width. *@
                    <span class="roster-actions">
                        @if (canLogWelfare)
                        {
                            <QButton Icon="journal-plus" Text="Log" Size="sm" Variant="primary" Class="roster-action"
                                     OnClick="@(() => OpenQuickLogModal(s))" Title="Log achievement, behavior or welfare record" />
                        }
                        <div class="dropdown roster-more">
                            <QButton Icon="three-dots" Size="sm" Variant="ghost" Title="More actions"
                                     data-bs-toggle="dropdown" aria-expanded="false" aria-label="@($"More actions for {s.FullName}")" />
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <button type="button" class="dropdown-item" @onclick="@(() => OpenEditStudentModal(s))">
                                        <QIcon Name="pencil" /> Edit student
                                    </button>
                                </li>
                                @if (canViewWelfare)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="@(() => Navigation.NavigateTo($"/admin/students/{s.Id}/picture"))">
                                            <QIcon Name="person-vcard" /> Open student picture
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="@(() => Navigation.NavigateTo($"/admin/students/{s.Id}/welfare"))">
                                            <QIcon Name="clipboard2-pulse" /> Welfare timeline
                                        </button>
                                    </li>
                                }
                                @* Next to the card it prints: both are about the guardians rather
                                   than the child, and a guardian is added once, not every day. *@
                                <li>
                                    <button type="button" class="dropdown-item" @onclick="@(() => OpenAddGuardianModal(s))">
                                        <QIcon Name="person-plus" /> Add guardian
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item" @onclick="@(() => PrintStudentIdCard(s))">
                                        <QIcon Name="printer-fill" /> Print visitation card
                                    </button>
                                </li>

                                @* Below the line: the two that carry legal weight rather than daily use. *@
                                @if (canManageStudents || canViewWelfare)
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                @if (canManageStudents)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="@(() => OpenConsentModal(s))">
                                            <QIcon Name="@(s.DataConsentGivenAt.HasValue ? "patch-exclamation" : "patch-check")" />
                                            @(s.DataConsentGivenAt.HasValue ? "Withdraw or re-record consent" : "Record data consent")
                                        </button>
                                    </li>
                                }
                                @if (canViewWelfare)
                                {
                                    <li>
                                        <button type="button" class="dropdown-item" @onclick="@(() => ExportStudentData(s))"
                                                title="Everything held about this student as one JSON file">
                                            <QIcon Name="file-earmark-arrow-down" /> Export data (SAR)
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </span>
                </div>
            }
        </div>
    }
</div>

@* Set-a-field needs its value before there is anything to preview. The options come from the
   branch's own lists or the field's real enum — never free text, because a typo'd house name
   silently creates a new house nobody can find again. *@
<QModal @bind-Visible="showSetFieldPrompt" Title="@($"Set {(pendingField.HasValue ? FieldLabel(pendingField.Value).ToLowerInvariant() : "field")}")" Size="sm">
    <ChildContent>
        <p class="form-hint">This will be written to all @selectedStudentIds.Count.ToString("N0") selected students. You'll see exactly what changes before anything is saved.</p>
        @if (SetFieldOptions.Any())
        {
            <QSelect TValue="string" TItem="string" Value="@setFieldValue" Items="@SetFieldOptions"
                     Label="@(pendingField.HasValue ? FieldLabel(pendingField.Value) : "Value")"
                     ValueChanged="@(v => setFieldValue = v ?? "")" />
        }
        else
        {
            <QInput TValue="string" @bind-Value="@setFieldValue" Label="Value" MaxLength="100" />
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showSetFieldPrompt = false)" />
        <QButton Text="Preview" Icon="arrow-right" Variant="primary" OnClick="@ConfirmSetField"
                 Disabled="@string.IsNullOrWhiteSpace(setFieldValue)" />
    </FooterContent>
</QModal>

@* The batch preview-and-commit dialog. Shared with every other list that runs a batch — the
   roster owns none of its behaviour, only the request it hands over. *@
<QBatchDialog @ref="batchDialog" BranchId="@branchId" OnQueued="@OnBatchQueued" />

@* Suggestion sources for the fields that stay free text. A datalist offers the known values and
   accepts anything else, which is the right shape for a vocabulary a school will always have an
   outlier for. Rendered once here rather than inside the dialog so they survive its open/close. *@
<datalist id="vocab-languages">
    @foreach (var v in vocabularies.HomeLanguages)
    {
        <option value="@v"></option>
    }
</datalist>
<datalist id="vocab-religions">
    @foreach (var v in vocabularies.Religions)
    {
        <option value="@v"></option>
    }
</datalist>
<datalist id="vocab-relationships">
    @foreach (var v in vocabularies.GuardianRelationships)
    {
        <option value="@v"></option>
    }
</datalist>

@* ---------------- Add / Edit Student ---------------- *@
<QModal @bind-Visible="showStudentModal" Title="@(editingStudentId.HasValue ? "Edit Student" : "Add Student")" Size="lg">
    <ChildContent>
        @* Four tabs, not one long scroll. The roster form was four fields; it is now twenty-three,
           and a wall of inputs is how a matron ends up filling in nothing. Identity is what the
           gate needs, so it stays first and is the only tab that can be required. *@
        <div class="stu-tabs" role="tablist">
            @foreach (var tab in ProfileTabs)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@(activeTab == tab.Key ? "true" : "false")"
                        class="stu-tab @(activeTab == tab.Key ? "active" : "")"
                        @onclick="@(() => activeTab = tab.Key)">
                    <QIcon Name="@tab.Icon" Size="15" />
                    <span>@tab.Label</span>
                    @if (TabFilledCount(tab.Key) > 0)
                    {
                        <span class="stu-tab-count">@TabFilledCount(tab.Key)</span>
                    }
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(studentFormError))
        {
            <div class="stu-form-error" role="alert">
                <QIcon Name="exclamation-triangle-fill" Size="16" />
                <span>@studentFormError</span>
            </div>
        }

        <div class="stu-tab-panel" @key="activeTab">
            @if (activeTab == "identity")
            {
                <div class="stu-grid">
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.FullName" Label="Full name" Required="true"
                                Placeholder="Jane Student" MaxLength="255"
                                HasError="@fieldErrors.ContainsKey(nameof(studentModel.FullName))"
                                ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.FullName))" />
                    </div>
                    <QInput TValue="string" @bind-Value="studentModel.StudentCode" Label="Student / admission code"
                            Placeholder="S001" MaxLength="100" HelperText="Roll number. Bulk import matches on this." />
                    @* A picker once the branch has any classes configured, a text box while it has
                       none — a school that has not set its list up yet must still be able to
                       record a student. Same fallback on House and Dormitory below. *@
                    @if (ClassOptions.Any())
                    {
                        <QSelect TValue="string" TItem="string" @bind-Value="studentModel.ClassName"
                                 Label="Class" Placeholder="Not set" AllowClear="true"
                                 Items="@ClassOptions" ValueSelector="@(c => c)" TextSelector="@(c => c)" />
                    }
                    else
                    {
                        <QInput TValue="string" @bind-Value="studentModel.ClassName" Label="Class" Placeholder="S.4" MaxLength="100"
                                HelperText="Add classes under Lists to get a picker." />
                    }

                    <QDatePicker @bind-Value="dateOfBirthValue" Label="Date of birth"
                                 HasError="@fieldErrors.ContainsKey(nameof(studentModel.DateOfBirth))"
                                 ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.DateOfBirth))" />
                    <QSelect TValue="StudentSex?" TItem="EnumOption<StudentSex>" @bind-Value="studentModel.Sex"
                             Label="Sex" Placeholder="Not recorded" AllowClear="true"
                             Items="@SexOptions" ValueSelector="@(o => (StudentSex?)o.Value)" TextSelector="@(o => o.Label)" />

                    <QDatePicker @bind-Value="admissionDateValue" Label="Admission date"
                                 HasError="@fieldErrors.ContainsKey(nameof(studentModel.AdmissionDate))"
                                 ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.AdmissionDate))" />
                    <QSelect TValue="StudentResidency?" TItem="EnumOption<StudentResidency>" @bind-Value="studentModel.Residency"
                             Label="Residency" Placeholder="Not recorded" AllowClear="true"
                             HelperText="Decides who is responsible overnight."
                             Items="@ResidencyOptions" ValueSelector="@(o => (StudentResidency?)o.Value)" TextSelector="@(o => o.Label)" />

                    @if (HouseOptions.Any())
                    {
                        <QSelect TValue="string" TItem="string" @bind-Value="studentModel.House"
                                 Label="House" Placeholder="Not set" AllowClear="true"
                                 Items="@HouseOptions" ValueSelector="@(h => h)" TextSelector="@(h => h)"
                                 HelperText="First responder, and how reports group." />
                    }
                    else
                    {
                        <QInput TValue="string" @bind-Value="studentModel.House" Label="House" Placeholder="Kabalega" MaxLength="100"
                                HelperText="First responder, and how reports group." />
                    }

                    @if (DormitoryOptions.Any())
                    {
                        <QSelect TValue="string" TItem="string" @bind-Value="studentModel.DormitoryOrStream"
                                 Label="Dormitory or stream" Placeholder="Not set" AllowClear="true"
                                 Items="@DormitoryOptions" ValueSelector="@(d => d)" TextSelector="@(d => d)" />
                    }
                    else
                    {
                        <QInput TValue="string" @bind-Value="studentModel.DormitoryOrStream" Label="Dormitory or stream" Placeholder="Block C" MaxLength="100" />
                    }

                    @if (editingStudentId.HasValue)
                    {
                        <div class="span-2">
                            <QCheckbox @bind-Value="studentModel.IsActive" Label="Active (on the current roster)" />
                        </div>
                    }
                </div>
            }
            else if (activeTab == "home")
            {
                <div class="stu-grid">
                    <QSelect TValue="string" TItem="string" Value="@studentModel.HomeCountry"
                             ValueChanged="@OnCountryChanged"
                             Label="Home country" Placeholder="Not recorded" AllowClear="true"
                             Items="@Geography.Countries" ValueSelector="@(c => c)" TextSelector="@(c => c)"
                             HasError="@fieldErrors.ContainsKey(nameof(studentModel.HomeCountry))"
                             ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.HomeCountry))" />

                    @* A picker where the list is known, a text box where it is not. An empty
                       dropdown for a country nobody has listed would be a dead end, and forcing a
                       school to pick a wrong district to get past the form is worse than free text. *@
                    @if (Geography.HasDistricts(studentModel.HomeCountry))
                    {
                        <QSelect TValue="string" TItem="string" @bind-Value="studentModel.HomeDistrict"
                                 Label="@Geography.DistrictLabelFor(studentModel.HomeCountry)"
                                 Placeholder="Not recorded" AllowClear="true"
                                 Items="@Geography.DistrictsFor(studentModel.HomeCountry)"
                                 ValueSelector="@(d => d)" TextSelector="@(d => d)"
                                 HelperText="How quickly a guardian can actually arrive."
                                 HasError="@fieldErrors.ContainsKey(nameof(studentModel.HomeDistrict))"
                                 ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.HomeDistrict))" />
                    }
                    else
                    {
                        <QInput TValue="string" @bind-Value="studentModel.HomeDistrict"
                                Label="@Geography.DistrictLabelFor(studentModel.HomeCountry)"
                                Placeholder="@(string.IsNullOrWhiteSpace(studentModel.HomeCountry) ? "Choose a country first" : "Type the area")"
                                MaxLength="120"
                                Disabled="@string.IsNullOrWhiteSpace(studentModel.HomeCountry)"
                                HelperText="@(string.IsNullOrWhiteSpace(studentModel.HomeCountry) ? "Pick a country first." : "No list for this country — type it.")"
                                HasError="@fieldErrors.ContainsKey(nameof(studentModel.HomeDistrict))"
                                ErrorMessage="@fieldErrors.GetValueOrDefault(nameof(studentModel.HomeDistrict))" />
                    }

                    <QSelect TValue="StudentLivesWith?" TItem="EnumOption<StudentLivesWith>" @bind-Value="studentModel.LivesWith"
                             Label="Lives with" Placeholder="Not recorded" AllowClear="true"
                             Items="@LivesWithOptions" ValueSelector="@(o => (StudentLivesWith?)o.Value)" TextSelector="@(o => o.Label)" />
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.HomeAddress" Label="Home address" Type="textarea" Rows="2" MaxLength="500" />
                    </div>
                    @* Suggested, not closed: a school will always have an outlier, and a closed
                       list here would only push real answers into "Other". *@
                    <QInput TValue="string" @bind-Value="studentModel.HomeLanguage" Label="Home language" Placeholder="Runyankole" MaxLength="80"
                            List="vocab-languages"
                            HelperText="For difficult conversations." />
                    <QInput TValue="string" @bind-Value="studentModel.Religion" Label="Religion" MaxLength="80" List="vocab-religions" />
                </div>
            }
            else if (activeTab == "health")
            {
                <div class="stu-note-inline">
                    <QIcon Name="shield-lock" Size="15" />
                    <span>Staff summary, not a medical record. Pastoral staff only.</span>
                </div>
                <div class="stu-grid">
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.MedicalConditions" Label="Medical conditions" Type="textarea" Rows="2" MaxLength="1000"
                                Placeholder="Epilepsy — carries medication, matron holds a spare"
                                HelperText="So staff know what to do." />
                    </div>
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.Allergies" Label="Allergies" Type="textarea" Rows="2" MaxLength="1000"
                                Placeholder="Peanuts — kitchen notified" />
                    </div>
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.RegularMedication" Label="Regular medication" Type="textarea" Rows="2" MaxLength="1000"
                                HelperText="Who administers it and when." />
                    </div>
                    <div class="span-2">
                        <QInput TValue="string" @bind-Value="studentModel.DisabilityOrLearningNeed" Label="Disability or learning need" Type="textarea" Rows="2" MaxLength="1000"
                                HelperText="Often changes the right response." />
                    </div>
                </div>
            }
            else if (activeTab == "continuity")
            {
                <div class="stu-grid">
                    <QSelect TValue="StudentFeesStatus?" TItem="EnumOption<StudentFeesStatus>" @bind-Value="studentModel.FeesStatus"
                             Label="Fees status" Placeholder="Not recorded" AllowClear="true"
                             HelperText="Arrears predict absence."
                             Items="@FeesOptions" ValueSelector="@(o => (StudentFeesStatus?)o.Value)" TextSelector="@(o => o.Label)" />
                    <QInput TValue="string" @bind-Value="studentModel.SponsorName" Label="Sponsor" MaxLength="200"
                            HelperText="Who to notify, alongside a parent." />
                    <QSelect TValue="StudentTransportMode?" TItem="EnumOption<StudentTransportMode>" @bind-Value="studentModel.TransportMode"
                             Label="Transport" Placeholder="Not recorded" AllowClear="true"
                             Items="@TransportOptions" ValueSelector="@(o => (StudentTransportMode?)o.Value)" TextSelector="@(o => o.Label)" />
                    <QInput TValue="string" @bind-Value="studentModel.PreviousSchool" Label="Previous school" MaxLength="200"
                            HelperText="Repeated moves are a risk marker." />
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showStudentModal = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SaveStudent"
                 Loading="@isSavingStudent"
                 Disabled="@(isSavingStudent || string.IsNullOrWhiteSpace(studentModel.FullName))" />
    </FooterContent>
</QModal>

@* ---------------- Data Consent ---------------- *@
<QModal @bind-Visible="showConsentModal" Title="@($"Data Consent — {consentTargetStudent?.FullName}")" Size="md">
    <ChildContent>
        @if (consentTargetStudent?.DataConsentGivenAt is { } givenAt)
        {
            <p class="consent-status consent-status--given">
                <QIcon Name="shield-check" /> Consent recorded @QDateFormat.DT(givenAt.ToLocalTime())
            </p>
            @if (!string.IsNullOrWhiteSpace(consentTargetStudent.DataConsentNotes))
            {
                <p class="form-hint" style="margin-top: 0;">@consentTargetStudent.DataConsentNotes</p>
            }
        }
        else
        {
            <p class="consent-status"><QIcon Name="shield" /> No data-processing consent on file for this student.</p>
        }
        <div class="form-grid">
            <label class="full-width">
                Notes (optional)
                <textarea @bind="consentNotes" rows="3" maxlength="500" placeholder="e.g., Signed consent form received from mother, 12 Feb 2026"></textarea>
            </label>
        </div>
        <p class="form-hint">Recording consent stamps the current time and your name. Withdrawing clears the record entirely — the notes included.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showConsentModal = false)" />
        @if (consentTargetStudent?.DataConsentGivenAt.HasValue == true)
        {
            <QButton Text="Withdraw consent" Icon="shield-slash" Variant="danger" OnClick="@(() => SaveConsent(false))" Disabled="@isSavingConsent" />
            <QButton Text="Re-record" Icon="shield-check" Variant="primary" OnClick="@(() => SaveConsent(true))" Disabled="@isSavingConsent" />
        }
        else
        {
            <QButton Text="Record consent" Icon="shield-check" Variant="primary" OnClick="@(() => SaveConsent(true))" Disabled="@isSavingConsent" />
        }
    </FooterContent>
</QModal>

@* ---------------- Classes, houses & lists ----------------
   Replaces the old colour-only dialog. Colour now lives ON the class entry rather than in a
   parallel map keyed by class name, which is what made a rename orphan its colour: the old key
   kept a colour nobody used and the new name had none. *@
<QModal @bind-Visible="showVocabModal" Title="Classes, houses & lists" Size="lg">
    <ChildContent>
        <div class="stu-tabs" role="tablist">
            @foreach (var tab in VocabTabs)
            {
                <button type="button" role="tab"
                        aria-selected="@(vocabTab == tab.Key ? "true" : "false")"
                        class="stu-tab @(vocabTab == tab.Key ? "active" : "")"
                        @onclick="@(() => vocabTab = tab.Key)">
                    <QIcon Name="@tab.Icon" Size="15" />
                    <span>@tab.Label</span>
                    <span class="stu-tab-count">@VocabCount(tab.Key)</span>
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(vocabError))
        {
            <div class="stu-form-error" role="alert">
                <QIcon Name="exclamation-triangle-fill" Size="16" />
                <span>@vocabError</span>
            </div>
        }

        <div class="stu-tab-panel" @key="vocabTab">
            @if (vocabTab is "classes" or "houses" or "dormitories")
            {
                var items = ItemsFor(vocabTab);
                var withColor = vocabTab == "classes";

                <p class="vocab-note">
                    @if (withColor)
                    {
                        <span>Renaming updates every student in it. In-use entries cannot be removed — retire them.</span>
                    }
                    else
                    {
                        <span>Renaming updates every student. In-use entries cannot be removed.</span>
                    }
                </p>

                @if (!items.Any())
                {
                    <p class="form-hint">Nothing here yet. Add the first one below.</p>
                }
                else
                {
                    <div class="vocab-list">
                        @foreach (var item in items.OrderBy(i => i.SortOrder).ToList())
                        {
                            var usage = UsageFor(vocabTab, OriginalNameOf(item));
                            <div class="vocab-row @(item.IsActive ? "" : "retired")">
                                @if (withColor)
                                {
                                    <input class="vocab-color" type="color" value="@(item.Color ?? UnassignedClassColor)"
                                           title="Colour on the roster and the printed pass"
                                           @onchange="@(e => item.Color = e.Value?.ToString())" />
                                }
                                <input class="vocab-name" value="@item.Name"
                                       maxlength="100"
                                       @onchange="@(e => RenameItem(vocabTab, item, e.Value?.ToString() ?? ""))" />

                                <span class="vocab-usage" title="Students currently holding this value">
                                    @(usage == 0 ? "unused" : $"{usage} student{(usage == 1 ? "" : "s")}")
                                </span>

                                @* Who holds this class, shown where the class is edited. A class
                                   with no teacher is the state that silently fires no alerts, so
                                   it says so here rather than only on the Class Teachers page.
                                   Matched on the ORIGINAL name: assignments are keyed on the stored
                                   spelling, and this row may be mid-rename. *@
                                @if (withColor && classTeachersLoaded)
                                {
                                    var holder = ClassTeacherFor(OriginalNameOf(item));
                                    @if (holder != null)
                                    {
                                        <a class="vocab-ct" href="/admin/students/class-teachers"
                                           title="@($"{holder.FullName} holds this class — open Class Teachers")">
                                            <QIcon Name="person-video3" Size="12" />
                                            <span>@holder.FullName</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="vocab-ct vocab-ct-none" href="/admin/students/class-teachers"
                                           title="Nobody is alerted when a student in this class has a record logged — open Class Teachers to assign one">
                                            <QIcon Name="person-dash" Size="12" />
                                            <span>No teacher</span>
                                        </a>
                                    }
                                }

                                <button type="button" class="vocab-btn" title="Move up" @onclick="@(() => MoveItem(vocabTab, item, -1))">
                                    <QIcon Name="chevron-up" Size="13" />
                                </button>
                                <button type="button" class="vocab-btn" title="Move down" @onclick="@(() => MoveItem(vocabTab, item, 1))">
                                    <QIcon Name="chevron-down" Size="13" />
                                </button>
                                <button type="button" class="vocab-btn @(item.IsActive ? "" : "on")"
                                        title="@(item.IsActive ? "Retire — stops being offered on new records, students already in it keep it" : "Bring back")"
                                        @onclick="@(() => item.IsActive = !item.IsActive)">
                                    <QIcon Name="@(item.IsActive ? "eye" : "eye-slash")" Size="13" />
                                </button>
                                <button type="button" class="vocab-btn danger" title="@(usage > 0 ? "In use — retire it instead" : "Remove")"
                                        disabled="@(usage > 0)"
                                        @onclick="@(() => RemoveItem(vocabTab, item))">
                                    <QIcon Name="trash" Size="13" />
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="vocab-add">
                    <input class="vocab-name" placeholder="@AddPlaceholder(vocabTab)" value="@newItemName"
                           maxlength="100"
                           @onchange="@(e => newItemName = e.Value?.ToString() ?? "")" />
                    <QButton Text="Add" Icon="plus-lg" Variant="secondary" Size="sm" OnClick="@(() => AddItem(vocabTab))" />
                </div>
            }
            else
            {
                <p class="vocab-note">
                    Offered as you type. Anything else is still accepted.
                </p>

                <div class="vocab-list">
                    @foreach (var value in SuggestionsFor(vocabTab).ToList())
                    {
                        <div class="vocab-row">
                            <span class="vocab-name-static">@value</span>
                            <button type="button" class="vocab-btn danger" title="Remove suggestion"
                                    @onclick="@(() => SuggestionsFor(vocabTab).Remove(value))">
                                <QIcon Name="trash" Size="13" />
                            </button>
                        </div>
                    }
                </div>

                <div class="vocab-add">
                    <input class="vocab-name" placeholder="@AddPlaceholder(vocabTab)" value="@newItemName"
                           maxlength="100"
                           @onchange="@(e => newItemName = e.Value?.ToString() ?? "")" />
                    <QButton Text="Add" Icon="plus-lg" Variant="secondary" Size="sm" OnClick="@(() => AddSuggestion(vocabTab))" />
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showVocabModal = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" Loading="@isSavingVocab" Disabled="@isSavingVocab" OnClick="@SaveVocabularies" />
    </FooterContent>
</QModal>

@* ---------------- Add Guardian ---------------- *@
<QModal @bind-Visible="showGuardianModal" Title="@($"Add Guardian — {guardianTargetStudent?.FullName}")" Size="md">
    <ChildContent>
        <div class="form-grid">
            <label class="full-width">Full Name *<input @bind="guardianModel.FullName" placeholder="Robert Guardian" /></label>
            <label>Phone<input @bind="guardianModel.Phone" placeholder="0753404044" /></label>
            <label>Email<input @bind="guardianModel.Email" placeholder="guardian@example.com" /></label>
            <label class="full-width">Relationship<input @bind="guardianModel.Relationship" list="vocab-relationships" placeholder="Father, Mother, Guardian, Auntie..." /></label>
        </div>
        <p class="form-hint">A phone or email is required — it's how this guardian is matched at the gate.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showGuardianModal = false)" />
        <QButton Text="Add" Icon="check-lg" Variant="primary" OnClick="@SaveGuardian"
                 Disabled="@(string.IsNullOrWhiteSpace(guardianModel.FullName) || (string.IsNullOrWhiteSpace(guardianModel.Phone) && string.IsNullOrWhiteSpace(guardianModel.Email)))" />
    </FooterContent>
</QModal>

@* ---------------- Bulk Import ---------------- *@
<QModal @bind-Visible="showImportModal" Title="Bulk Import Roster" Size="lg">
    <ChildContent>
        @if (importJob == null)
        {
            <div class="import-upload">
                <p>
                    Upload an Excel (.xlsx/.xls) or CSV file with columns for student name, student code, class,
                    guardian name, guardian phone/email, and relationship — column order doesn't matter, and common
                    header variations are recognized automatically.
                </p>
                <input type="file" id="roster-file-input" accept=".xlsx,.xls,.csv" @onchange="OnFileSelected" />

                @if (isParsingFile)
                {
                    <div class="loading-state"><QSpinner Size="sm" /><span>Reading file...</span></div>
                }
                else if (headerErrors.Any())
                {
                    <div class="import-errors">
                        <strong>Couldn't read this file:</strong>
                        <ul>
                            @foreach (var err in headerErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                else if (parsedRows.Any())
                {
                    <div class="import-preview">
                        <p><strong>@parsedRows.Count</strong> row@(parsedRows.Count == 1 ? "" : "s") parsed from <strong>@parsedFileName</strong>. First few rows:</p>
                        <div class="import-preview-table">
                            <div class="import-preview-row import-preview-header">
                                <span>Student</span><span>Code</span><span>Class</span><span>Guardian</span><span>Phone</span><span>Email</span><span>Relationship</span>
                            </div>
                            @foreach (var r in parsedRows.Take(5))
                            {
                                <div class="import-preview-row">
                                    <span>@r.StudentFullName</span><span>@r.StudentCode</span><span>@r.ClassName</span>
                                    <span>@r.GuardianFullName</span><span>@r.GuardianPhone</span><span>@r.GuardianEmail</span><span>@r.Relationship</span>
                                </div>
                            }
                            @if (parsedRows.Count > 5)
                            {
                                <p class="import-preview-more">+ @(parsedRows.Count - 5) more row@(parsedRows.Count - 5 == 1 ? "" : "s")</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="import-progress">
                <div class="import-progress-header">
                    <span class="import-status-badge @importJob.Status.ToString().ToLower()">@importJob.Status</span>
                    <span>@importJob.ProcessedRows / @importJob.TotalRows rows processed</span>
                </div>
                <div class="import-progress-bar">
                    <div class="import-progress-fill" style="width: @(importJob.TotalRows > 0 ? (importJob.ProcessedRows * 100 / importJob.TotalRows) : 0)%"></div>
                </div>
                <div class="import-summary-grid">
                    <div class="import-summary-tile created"><span class="value">@importJob.CreatedCount</span><span class="label">Created</span></div>
                    <div class="import-summary-tile updated"><span class="value">@importJob.UpdatedCount</span><span class="label">Updated</span></div>
                    <div class="import-summary-tile duplicate"><span class="value">@importJob.DuplicateCount</span><span class="label">Duplicates</span></div>
                    <div class="import-summary-tile failed"><span class="value">@importJob.FailedCount</span><span class="label">Failed</span></div>
                </div>

                @if (importJob.Status == RosterImportStatus.Completed || importJob.Status == RosterImportStatus.CompletedWithErrors)
                {
                    <QButton Text="@(showImportEntries ? "Hide Row-by-Row Log" : "View Row-by-Row Log")" Icon="list-ul" Variant="secondary" OnClick="@ToggleImportEntries" />
                    @if (showImportEntries)
                    {
                        <div class="import-log">
                            @foreach (var entry in importEntries)
                            {
                                <div class="import-log-row outcome-@ImportOutcomeDisplay.CssModifier(entry.Outcome)">
                                    <span class="import-log-rownum">#@entry.RowNumber</span>
                                    <span class="import-log-outcome">@ImportOutcomeDisplay.Label(entry.Outcome)</span>
                                    <span class="import-log-name">@(entry.StudentName ?? "—") / @(entry.GuardianName ?? "—")</span>
                                    <span class="import-log-message">@entry.Message</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (importJob == null)
        {
            <QButton Text="Cancel" Variant="ghost" OnClick="@CloseImportModal" />
            <QButton Text="@($"Start Import{(parsedRows.Any() ? $" ({parsedRows.Count} rows)" : "")}")" Icon="upload" Variant="primary"
                     OnClick="@StartImport" Disabled="@(!parsedRows.Any() || isStartingImport)" />
        }
        else
        {
            <QButton Text="Close" Variant="primary" OnClick="@CloseImportModal" />
        }
    </FooterContent>
</QModal>

@* ---------------- Import History ---------------- *@
<QModal @bind-Visible="showHistoryModal" Title="Import History" Size="lg">
    <ChildContent>
        @if (!historyJobs.Any())
        {
            <p class="form-hint">No imports yet.</p>
        }
        else
        {
            <div class="import-log">
                @foreach (var job in historyJobs)
                {
                    <div class="import-log-row outcome-@(job.FailedCount > 0 ? "failed" : "created")">
                        <span class="import-log-rownum">@QDateFormat.CDT(job.CreatedAt.ToLocalTime())</span>
                        <span class="import-log-outcome">@job.Status</span>
                        <span class="import-log-name">@(job.SourceFileName ?? (job.Source == "api_sync" ? "External sync" : "Manual entry"))</span>
                        <span class="import-log-message">@job.TotalRows rows &middot; @job.CreatedCount created &middot; @job.UpdatedCount updated &middot; @job.DuplicateCount duplicate &middot; @job.FailedCount failed</span>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@(() => showHistoryModal = false)" />
    </FooterContent>
</QModal>

@* ---------------- Quick-Log Welfare Record (mobile bottom-sheet) ---------------- *@
@*
    The sheet is a normal-flow CHILD of the backdrop, centered/bottom-aligned via the backdrop's
    own flexbox (exactly QModal's proven pattern) rather than position:fixed + transform on the
    sheet itself. A `transform` on the sheet - even a resting `translateY(0)` - creates a new CSS
    containing block for any `position:fixed` descendant, which breaks QSelect's dropdown (it
    computes viewport coordinates via JS assuming nothing between it and the viewport is
    transformed). Found live: the Category dropdown rendered detached in a screen corner until
    this was restructured.
*@
<div class="qm-welfare-sheet-backdrop @(showQuickLogModal ? "qm-welfare-sheet-backdrop--open" : "")" @onclick="@(() => showQuickLogModal = false)">
    <div class="qm-welfare-sheet" @onclick="@(() => {})" @onclick:stopPropagation="true">
        <div class="qm-welfare-sheet-handle"></div>
        <div class="qm-welfare-sheet-header">
            <h3>Log Record — @quickLogStudent?.FullName</h3>
            <QButton Icon="x-lg" Size="sm" Variant="ghost" OnClick="@(() => showQuickLogModal = false)" />
        </div>
        <div class="qm-welfare-sheet-body">
            <div class="qm-welfare-form-group">
                <label>Case Type *</label>
                <div class="qm-welfare-case-type-tabs">
                    @foreach (var ct in new[] { QMgr.Domain.Enums.WelfareCaseType.Achievement, QMgr.Domain.Enums.WelfareCaseType.Behavior, QMgr.Domain.Enums.WelfareCaseType.Welfare })
                    {
                        <button type="button" class="qm-welfare-case-tab qm-welfare-case-tab--@ct.ToString().ToLowerInvariant() @(quickLogModel.CaseType == ct ? "active" : "")"
                                @onclick="@(() => SelectQuickLogCaseType(ct))">
                            @ct
                        </button>
                    }
                </div>
            </div>
            <div class="qm-welfare-form-group">
                <QSelect TValue="Guid" TItem="WelfareCategoryDto" Value="@quickLogModel.CategoryId" ValueChanged="@OnQuickLogCategorySelected"
                         Items="@quickLogCategories.Where(c => c.CaseType == quickLogModel.CaseType)" TextSelector="@(x => x.Name)" ValueSelector="@(x => x.Id)"
                         Label="Category" Required="true" HasError="@quickLogCategoryError" ErrorMessage="Select a category" />
            </div>
            <div class="qm-welfare-form-group">
                <QInput TValue="string" @bind-Value="@quickLogModel.Description" Type="textarea" Label="What happened?" Rows="3"
                        Placeholder="Minimum 10 characters" Required="true" MaxLength="2000"
                        HasError="@quickLogDescriptionError" ErrorMessage="Describe what happened (10-2000 characters)" />
            </div>
        </div>
        <div class="qm-welfare-sheet-footer">
            <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showQuickLogModal = false)" />
            <QButton Text="Save Record" Icon="check-lg" Variant="primary" OnClick="@SaveQuickLog" />
        </div>
    </div>
</div>

<style>
    /* ---------------- Vocabulary editor ---------------- */

    .vocab-note {
        margin: 0 0 14px;
        padding: 9px 12px;
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        font-size: 12.5px;
        line-height: 1.5;
    }

    .vocab-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }

    .vocab-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-card);
    }

    /* A retired entry is still readable — students already in it keep it — so it dims rather than
       disappears. Hiding it would make "why can nobody pick S.6 any more" unanswerable. */
    .vocab-row.retired { opacity: .55; }
    .vocab-row.retired .vocab-name { text-decoration: line-through; }

    .vocab-color {
        width: 30px; height: 30px; padding: 0;
        border: 1px solid var(--qm-border); border-radius: var(--qm-radius-sm);
        background: none; cursor: pointer; flex-shrink: 0;
    }

    .vocab-name {
        flex: 1 1 auto; min-width: 0;
        padding: 6px 9px;
        border: 1px solid transparent;
        border-radius: var(--qm-radius-sm);
        background: transparent;
        color: var(--qm-text-primary);
        font-family: var(--qm-font-primary);
        font-size: 13.5px;
    }

    .vocab-name:hover { border-color: var(--qm-border); }
    .vocab-name:focus { outline: none; border-color: var(--qm-primary); background: var(--qm-bg-elevated); }

    .vocab-name-static { flex: 1 1 auto; font-size: 13.5px; padding: 6px 9px; }

    .vocab-usage {
        font-size: 11px;
        color: var(--qm-text-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    /* Who holds the class, on the row where the class is edited. Tinted from --qm-primary-rgb so
       it follows the theme with no [data-theme="light"] override. */
    .vocab-ct {
        display: inline-flex; align-items: center; gap: 5px;
        max-width: 150px;
        padding: 3px 8px;
        border-radius: 999px;
        background: rgba(var(--qm-primary-rgb), 0.10);
        color: var(--qm-primary);
        font-size: 11.5px;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .vocab-ct span { overflow: hidden; text-overflow: ellipsis; }
    .vocab-ct:hover { background: rgba(var(--qm-primary-rgb), 0.18); }

    /* An unheld class is the state this feature fails silently in, so it reads as a gap rather
       than as another chip. */
    .vocab-ct-none {
        background: transparent;
        border: 1px dashed var(--qm-border);
        color: var(--qm-text-muted);
    }
    .vocab-ct-none:hover { background: var(--qm-bg-elevated); color: var(--qm-text-secondary); }

    .vocab-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 26px; height: 26px; flex-shrink: 0;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-card);
        color: var(--qm-text-secondary);
        cursor: pointer;
        transition: color .15s ease, border-color .15s ease;
    }

    .vocab-btn:hover:not(:disabled) { color: var(--qm-primary); border-color: var(--qm-primary); }
    .vocab-btn.on { color: var(--qm-primary); border-color: var(--qm-primary); }
    .vocab-btn.danger:hover:not(:disabled) { color: var(--qm-danger); border-color: var(--qm-danger); }
    .vocab-btn:disabled { opacity: .35; cursor: not-allowed; }
    .vocab-btn:focus-visible { outline: 2px solid var(--qm-primary); outline-offset: 1px; }

    .vocab-add {
        display: flex; align-items: center; gap: 8px;
        padding-top: 12px;
        border-top: 1px dashed var(--qm-border);
    }

    .vocab-add .vocab-name { border-color: var(--qm-border); }

    /* ---------------- Roster chips ---------------- */

    .roster-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: 6px;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 600;
        vertical-align: middle;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        border: 1px solid var(--qm-border);
        animation: rosterChipIn .28s ease both;
    }

    .roster-chip.tier-medium { background: rgba(var(--qm-warning-rgb), .12); color: var(--qm-accent-orange); border-color: rgba(var(--qm-warning-rgb), .28); }
    .roster-chip.tier-high   { background: rgba(var(--qm-danger-rgb), .12);  color: var(--qm-danger);       border-color: rgba(var(--qm-danger-rgb), .28); }
    .roster-chip.restriction { background: rgba(var(--qm-danger-rgb), .15);  color: var(--qm-danger);       border-color: rgba(var(--qm-danger-rgb), .35); font-weight: 700; }
    .roster-chip.more        { color: var(--qm-text-muted); cursor: default; }
    .roster-chip.overdue     { border-style: dashed; }

    @@keyframes rosterChipIn {
        from { opacity: 0; transform: translateX(-3px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .roster-chip { animation: none !important; }
    }

    /* ---------------- Tabbed student profile ---------------- */

    .stu-tabs {
        display: flex;
        gap: 2px;
        border-bottom: 1px solid var(--qm-border);
        margin: -4px 0 18px;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .stu-tabs::-webkit-scrollbar { display: none; }

    .stu-tab {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 14px;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        color: var(--qm-text-secondary);
        font-family: var(--qm-font-primary);
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
        /* The underline slides between tabs rather than blinking on and off — the cheapest way to
           make four panels read as one form with four views instead of four separate screens. */
        transition: color .18s ease, border-color .18s ease;
    }

    .stu-tab:hover { color: var(--qm-text-primary); }

    .stu-tab.active {
        color: var(--qm-primary);
        border-bottom-color: var(--qm-primary);
        font-weight: 600;
    }

    .stu-tab:focus-visible {
        outline: 2px solid var(--qm-primary);
        outline-offset: -2px;
        border-radius: 3px 3px 0 0;
    }

    /* How many fields on that tab are already filled. Deliberately quiet — it is an orientation
       aid for someone part-way through a long form, not a score. */
    .stu-tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 17px;
        height: 17px;
        padding: 0 4px;
        border-radius: 9px;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-muted);
        font-size: 10px;
        font-weight: 700;
    }

    .stu-tab.active .stu-tab-count {
        background: var(--qm-primary-light);
        color: var(--qm-primary);
    }

    /* @@key on the panel forces a fresh element per tab, so this replays on every switch. A 6px
       rise, not a slide across — a horizontal slide implies the tabs are a sequence you move
       through, and these are four views of one thing. */
    /* `backwards`, NOT `both` — and this is load-bearing, not a style preference.
       `both` keeps the final keyframe applied forever, so `transform: translateY(0)` stays on the
       element after the animation ends. A transform of ANY value (zero included) makes an element
       a containing block for its fixed-position descendants, and QSelect deliberately renders its
       dropdown `position: fixed` at JS-measured screen coordinates precisely so no scrollable
       ancestor can clip it. With `both`, that dropdown resolved against this panel instead of the
       viewport and got clipped by the modal's scroll container — the option list vanished and the
       modal grew a horizontal scrollbar. `backwards` drops the transform once the animation
       finishes, which is visually identical (the last frame is translateY(0)) and leaves fixed
       positioning working. Same reason on .stu-grid > * below. */
    .stu-tab-panel {
        animation: stuPanelIn .22s ease backwards;
    }

    /* Opacity only — NO transform. A transform on this element makes it a containing block for
       fixed-position descendants, and QSelect renders its option list `position: fixed` at
       JS-measured VIEWPORT coordinates. With a transform active those coordinates resolve against
       this panel instead, so the list lands far down and to the right and drags a horizontal
       scrollbar into the modal. It bites while the animation is still RUNNING, so no fill-mode
       trick avoids it — the transform simply cannot be here. */
    @@keyframes stuPanelIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .stu-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 16px;
    }

    .stu-grid > .span-2 { grid-column: 1 / -1; }

    /* Fields fade in a beat behind the panel, in reading order. Six steps only — past that the
       last field waits long enough to feel like the form is still loading.

       `backwards`, not `both`: a `both` fill keeps the last keyframe applied forever, so
       `transform: translateY(0)` would stay on the element, and a transform of ANY value (zero
       included) makes it a containing block for fixed-position descendants. These wrappers are the
       direct parents of QSelect triggers, and QSelect deliberately renders its option list
       `position: fixed` at JS-measured screen coordinates so no scrollable ancestor can clip it —
       a persisted transform here would quietly redefine what "fixed" resolves against.
       `backwards` drops the transform once the animation finishes, which is visually identical
       because the last frame is already translateY(0). */
    .stu-grid > * {
        animation: stuFieldIn .26s ease backwards;
    }

    .stu-grid > *:nth-child(1) { animation-delay: .02s; }
    .stu-grid > *:nth-child(2) { animation-delay: .05s; }
    .stu-grid > *:nth-child(3) { animation-delay: .08s; }
    .stu-grid > *:nth-child(4) { animation-delay: .11s; }
    .stu-grid > *:nth-child(5) { animation-delay: .14s; }
    .stu-grid > *:nth-child(n+6) { animation-delay: .16s; }

    /* Opacity only, for the containing-block reason on stuPanelIn above — these wrappers are the
       DIRECT parents of the QSelect triggers, so a transform here is the one that actually
       displaced the country dropdown. */
    @@keyframes stuFieldIn {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    .stu-form-error {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 11px 13px;
        margin-bottom: 16px;
        border-radius: var(--qm-radius-sm);
        background: rgba(var(--qm-danger-rgb), .1);
        border: 1px solid rgba(var(--qm-danger-rgb), .3);
        color: var(--qm-danger);
        font-size: 13px;
        animation: stuShake .3s ease;
    }

    /* Two small nudges, not a wobble. Enough to catch the eye of someone who pressed Save and is
       already looking at the button rather than the top of the dialog. */
    @@keyframes stuShake {
        0%, 100% { transform: translateX(0); }
        25%      { transform: translateX(-4px); }
        75%      { transform: translateX(4px); }
    }

    .stu-note-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        margin-bottom: 16px;
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        font-size: 12.5px;
    }

    @@media (max-width: 640px) {
        .stu-grid { grid-template-columns: 1fr; }
        .stu-grid > .span-2 { grid-column: 1; }
    }

    /* Every animation above is decoration over content that is already correct and already in the
       DOM — so honouring the preference costs nothing and skipping it would be an accessibility
       bug, not a style choice. */
    @@media (prefers-reduced-motion: reduce) {
        .stu-tab-panel,
        .stu-grid > *,
        .stu-form-error {
            animation: none !important;
        }
        .stu-tab { transition: none; }
    }
    .roster-toolbar { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }

    /* The batch bar. Present only while something is selected, and leading with the count —
       a bar that is always there reads as chrome, and one labelled "Actions" makes somebody
       click it to find out what it would act on. */
    .batch-bar {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        background: var(--qm-primary-light); border: 1px solid var(--qm-primary);
        border-radius: var(--qm-radius-md); padding: 10px 14px; margin-bottom: 16px;
    }
    .batch-bar-count { display: flex; align-items: center; gap: 7px; font-size: 14px; margin-right: 4px; }
    .batch-bar-count strong { font-variant-numeric: tabular-nums; }
    .batch-bar .dropdown { display: inline-flex; }

    .batch-menu {
        min-width: 220px; padding: 6px;
        border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md);
        background: var(--qm-bg-card); box-shadow: var(--qm-shadow-md);
    }
    .batch-menu .dropdown-item {
        display: flex; align-items: center; gap: 9px; width: 100%;
        padding: 8px 10px; border: none; background: none; border-radius: var(--qm-radius-sm);
        font-size: 13px; text-align: left; color: var(--qm-text-primary); cursor: pointer;
    }
    .batch-menu .dropdown-item:hover,
    .batch-menu .dropdown-item:focus-visible { background: var(--qm-primary-light); }
    .batch-menu .dropdown-item .q-icon { color: var(--qm-text-muted); flex: none; }
    .batch-menu .dropdown-item.batch-danger { color: var(--qm-danger); }
    .batch-menu .dropdown-item.batch-danger .q-icon { color: var(--qm-danger); }
    .batch-menu .dropdown-divider { margin: 6px 4px; border-top-color: var(--qm-border); }

    .batch-clear {
        margin-left: auto; background: none; border: none; padding: 2px 6px; cursor: pointer;
        font: inherit; font-size: 13px; color: var(--qm-text-muted); text-decoration: underline;
    }

    .batch-done {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        background: rgba(var(--qm-success-rgb), 0.1); border: 1px solid var(--qm-success);
        border-radius: var(--qm-radius-md); padding: 10px 14px; margin-bottom: 16px; font-size: 14px;
    }
    .batch-done .q-icon { color: var(--qm-success); }
    .roster-search-input { flex: 1; min-width: 240px; padding: 10px 14px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); background: var(--qm-bg-card); color: var(--qm-text-primary); }
    .roster-toggle { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--qm-text-muted); cursor: pointer; }

    /* One grid for the whole table, with every row contributing its cells to it.
       Each row used to be its own grid sharing only a template string, and two of that template's
       six tracks are `auto` — the checkbox and the actions. An `auto` track is sized by the widest
       content in ITS OWN grid, so the header's empty trailing cell measured 0 while a data row's
       eight action buttons measured ~300px. The `fr` tracks then split different leftovers and
       every heading sat to the right of the column it named.
       `display: contents` makes the rows' cells direct items of the table grid, so all six tracks
       are measured once across every row. Adding a ninth button now moves the heading with it. */
    .roster-table {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-lg);
        display: grid;
        grid-template-columns: auto 2.4fr 0.8fr 0.8fr 1.9fr auto;
    }

    /* No `overflow: hidden` here, deliberately: it used to clip the header background to the
       rounded corners, but it would equally clip the row's actions menu, which has to escape the
       table. The corners are rounded on the corner cells instead. */
    .roster-row:first-child > *:first-child { border-top-left-radius: var(--qm-radius-lg); }
    .roster-row:first-child > *:last-child { border-top-right-radius: var(--qm-radius-lg); }
    .roster-row:last-child > *:first-child { border-bottom-left-radius: var(--qm-radius-lg); }
    .roster-row:last-child > *:last-child { border-bottom-right-radius: var(--qm-radius-lg); }

    .roster-row { display: contents; }

    /* Padding and the separator move to the cells, because a row with `display: contents` has no
       box of its own to carry them. No column-gap for the same reason the borders live here: a gap
       would break the separator into dashes, so the spacing is padding inside each cell instead. */
    .roster-row > * {
        display: flex;
        align-items: center;
        min-width: 0;
        padding: 12px 12px 12px 0;
        border-bottom: 1px solid var(--qm-border);
        font-size: 14px;
    }

    .roster-row > *:first-child { padding-left: 16px; }
    .roster-row > *:last-child { padding-right: 16px; }
    .roster-row:last-child > * { border-bottom: none; }

    .roster-select { display: flex; align-items: center; }
    .roster-select input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
    .roster-header > * { font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--qm-text-muted); background: var(--qm-bg-secondary); font-weight: 600; }
    .roster-row.inactive > * { opacity: 0.5; }
    /* Flex-wrap, not inline-flex: a student can carry a restriction warning plus several flag
       chips, and letting them wrap onto a second line keeps the NAME on one line — the name is
       what somebody is scanning the column for. */
    .roster-name { font-weight: 600; color: var(--qm-text-primary); display: flex; flex-wrap: wrap; align-items: center; gap: 5px; row-gap: 4px; }
    .roster-name > .roster-chip { margin-left: 0; }
    .roster-name-text { white-space: nowrap; }
    .roster-name-link { color: inherit; text-decoration: none; }
    .roster-name-link:hover { color: var(--qm-primary); text-decoration: underline; }
    .roster-name-link:focus-visible { outline: 2px solid var(--qm-primary); outline-offset: 2px; border-radius: 2px; }
    .consent-icon { display: inline-flex; color: var(--qm-text-muted); opacity: 0.55; cursor: help; }
    .consent-icon--given { color: var(--qm-success, #3f7d58); opacity: 1; }
    .consent-status { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; font-size: 14px; color: var(--qm-text-muted); }
    .consent-status--given { color: var(--qm-success, #3f7d58); font-weight: 600; }
    .form-grid textarea { width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-sm); background: var(--qm-bg-card); color: var(--qm-text-primary); font: inherit; resize: vertical; }
    .roster-code { font-family: monospace; color: var(--qm-text-muted); }
    .roster-guardians { font-size: 13px; color: var(--qm-text-muted); display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .roster-empty-guardians { font-style: italic; }
    .guardian-chip { display: inline-flex; align-items: center; gap: 2px; white-space: nowrap; }
    .guardian-print-btn { padding: 2px !important; min-width: unset !important; }
    .class-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; color: #fff; font-size: 12px; font-weight: 600; }

    /* min-width:0 so this grid child can shrink below its content — a cell that refuses to
       shrink is what widened the document and made the whole page scroll sideways. */
    .roster-class-cell { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; min-width: 0; }
    .roster-ct { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; font-size: 11.5px; color: var(--qm-text-muted); min-width: 0; }
    .roster-ct a, .roster-ct span { color: inherit; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .roster-ct a:hover { color: var(--qm-primary); text-decoration: underline; }
    .class-color-list { display: flex; flex-direction: column; gap: 10px; }
    .class-color-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--qm-border); }
    .class-color-row:last-child { border-bottom: none; }
    .class-color-row input[type="color"] { width: 44px; height: 32px; padding: 2px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-sm); background: var(--qm-bg-card); cursor: pointer; }
    .roster-actions { display: flex; flex-wrap: wrap; gap: 6px; justify-self: end; align-items: center; }

    /* The label stays visible at every width, phone included. There is only one inline action now,
       so it costs almost nothing horizontally — and an unlabelled icon is the thing this whole
       rework was undoing. Everything else lives in the menu, where it is written out in words. */

    /* The row's own menu. Bootstrap's dropdown is already loaded app-wide and drives the user menu
       in MainLayout, so this needs no new component and no new script. */
    .roster-more { display: inline-flex; }
    .roster-more .dropdown-menu {
        min-width: 232px;
        padding: 6px;
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-md);
        background: var(--qm-bg-card);
        box-shadow: var(--qm-shadow-md);
    }

    .roster-more .dropdown-item {
        display: flex; align-items: center; gap: 10px;
        width: 100%;
        padding: 8px 10px;
        border: none; background: none;
        border-radius: var(--qm-radius-sm);
        font-size: 13px; text-align: left;
        color: var(--qm-text-primary);
        cursor: pointer;
    }

    .roster-more .dropdown-item:hover,
    .roster-more .dropdown-item:focus-visible {
        background: var(--qm-primary-light);
        color: var(--qm-text-primary);
    }

    .roster-more .dropdown-item .q-icon { color: var(--qm-text-muted); flex: none; }
    .roster-more .dropdown-divider { margin: 6px 4px; border-top-color: var(--qm-border); }

    .loading-state, .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--qm-text-muted); text-align: center; }
    .empty-state h3 { color: var(--qm-text-primary); margin: 0; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
    .form-grid label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--qm-text-muted); }
    .form-grid label.full-width { grid-column: 1 / -1; }
    .form-grid input { width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-sm); background: var(--qm-bg-card); color: var(--qm-text-primary); }
    .checkbox-label { flex-direction: row !important; align-items: center; gap: 8px !important; }
    .form-hint { font-size: 12px; color: var(--qm-text-muted); margin-top: 10px; }

    .import-upload input[type=file] { margin: 12px 0; display: block; }
    .import-errors { background: rgba(220, 38, 38, 0.08); border: 1px solid var(--qm-danger); border-radius: var(--qm-radius-md); padding: 12px 16px; color: var(--qm-danger); font-size: 13px; margin-top: 12px; }
    .import-errors ul { margin: 6px 0 0; padding-left: 18px; }

    .import-preview { margin-top: 16px; font-size: 13px; }
    .import-preview-table { border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); overflow: hidden; margin-top: 8px; }
    .import-preview-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid var(--qm-border); overflow: hidden; }
    .import-preview-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .import-preview-row:last-child { border-bottom: none; }
    .import-preview-header { background: var(--qm-bg-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: var(--qm-text-muted); }
    .import-preview-more { text-align: center; padding: 8px; color: var(--qm-text-muted); font-size: 12px; margin: 0; }

    .import-progress-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 14px; }
    .import-status-badge { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 3px 10px; border-radius: 999px; background: var(--qm-bg-secondary); color: var(--qm-text-muted); }
    .import-status-badge.processing, .import-status-badge.pending { background: rgba(169, 120, 31, 0.15); color: #a9781f; }
    .import-status-badge.completed { background: rgba(63, 125, 88, 0.15); color: #3f7d58; }
    .import-status-badge.completedwitherrors { background: rgba(217, 83, 79, 0.12); color: var(--qm-danger, #d9534f); }
    .import-status-badge.failed { background: rgba(217, 83, 79, 0.15); color: var(--qm-danger, #d9534f); }

    .import-progress-bar { height: 8px; background: var(--qm-bg-secondary); border-radius: 999px; overflow: hidden; margin-bottom: 16px; }
    .import-progress-fill { height: 100%; background: var(--qm-primary); transition: width 0.3s ease; }

    .import-summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; }
    .import-summary-tile { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px; border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); }
    .import-summary-tile .value { font-size: 22px; font-weight: 700; color: var(--qm-text-primary); }
    .import-summary-tile .label { font-size: 12px; color: var(--qm-text-muted); }
    .import-summary-tile.failed .value { color: var(--qm-danger, #d9534f); }
    .import-summary-tile.duplicate .value { color: #a9781f; }
    .import-summary-tile.created .value { color: #3f7d58; }

    .import-log { max-height: 360px; overflow-y: auto; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); margin-top: 12px; }
    .import-log-row { display: grid; grid-template-columns: 100px 110px 1fr 2fr; gap: 10px; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid var(--qm-border); align-items: center; }
    .import-log-row:last-child { border-bottom: none; }
    .import-log-rownum { font-family: monospace; color: var(--qm-text-muted); white-space: nowrap; }
    .import-log-outcome { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .outcome-created .import-log-outcome { color: #3f7d58; }
    .outcome-updated .import-log-outcome { color: var(--qm-primary); }
    .outcome-duplicateinfile .import-log-outcome { color: #a9781f; }
    .outcome-alreadyexists .import-log-outcome { color: #7a6a55; }
    .outcome-failed .import-log-outcome { color: var(--qm-danger, #d9534f); }
    .import-log-message { color: var(--qm-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    @@media (max-width: 900px) {
        /* Back to a stacked card per student. The row needs its box back to carry the padding and
           the separator, which the desktop layout keeps on the cells. */
        .roster-table { display: block; }
        .roster-row { display: block; padding: 12px 16px; border-bottom: 1px solid var(--qm-border); }
        .roster-row:last-child { border-bottom: none; }
        .roster-row > * { padding: 0; border-bottom: none; }
        .roster-row > *:first-child { padding-left: 0; }
        .roster-row > *:last-child { padding-right: 0; }
        .roster-header { display: none; }
        .import-preview-row { grid-template-columns: 1fr 1fr; }
        .import-log-row { grid-template-columns: 1fr; }
    }

    /* Quick-log welfare record - mobile-first bottom sheet (slides up from the bottom on phones,
       reads as a centered panel on wider screens) rather than a third styling mechanism; uses the
       same --qm-* tokens as the rest of this file's inline style block.

       The sheet is centered/bottom-aligned via the BACKDROP's own flexbox (the same pattern
       QModal already uses successfully) rather than position:fixed + transform on the sheet
       itself. A `transform` on the sheet - even a resting `translateY(0)` - creates a new CSS
       containing block for any position:fixed descendant, which breaks QSelect's own dropdown
       (it computes viewport coordinates via JS on the assumption that nothing between it and the
       viewport is transformed). Found live: the Category dropdown rendered detached in a corner
       of the screen until this was restructured - the sheet no longer uses position:fixed or
       transform at all, on either breakpoint. */
    .qm-welfare-sheet-backdrop {
        position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); z-index: 1000;
        display: flex; align-items: flex-end; justify-content: center;
        opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
    }
    .qm-welfare-sheet-backdrop--open { opacity: 1; pointer-events: auto; }

    .qm-welfare-sheet {
        width: 100%; background: var(--qm-bg-card); border-top: 1px solid var(--qm-border);
        border-radius: 16px 16px 0 0; max-height: 85vh; display: flex; flex-direction: column;
        box-shadow: var(--qm-shadow-lg, 0 -4px 24px rgba(0,0,0,0.2));
    }

    .qm-welfare-sheet-handle { width: 40px; height: 4px; background: var(--qm-border); border-radius: 999px; margin: 10px auto 0; flex-shrink: 0; }
    .qm-welfare-sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; border-bottom: 1px solid var(--qm-border); flex-shrink: 0; }
    .qm-welfare-sheet-header h3 { margin: 0; font-size: 16px; color: var(--qm-text-primary); }
    .qm-welfare-sheet-body { padding: 16px 20px; overflow-y: auto; flex: 1; }
    .qm-welfare-sheet-footer { display: flex; justify-content: flex-end; gap: 10px; padding: 12px 20px; border-top: 1px solid var(--qm-border); background: var(--qm-bg-elevated); flex-shrink: 0; }

    .qm-welfare-form-group { margin-bottom: 16px; }
    .qm-welfare-form-group > label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 500; color: var(--qm-text-secondary); }

    .qm-welfare-case-type-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .qm-welfare-case-tab {
        padding: 10px 8px; border-radius: var(--qm-radius-md); border: 1px solid var(--qm-border);
        background: var(--qm-bg-elevated); color: var(--qm-text-secondary); font-size: 12px; font-weight: 600;
        cursor: pointer; transition: all 0.15s ease;
    }
    .qm-welfare-case-tab--achievement.active { background: var(--qm-welfare-achievement, #c99a5b); border-color: var(--qm-welfare-achievement, #c99a5b); color: #fff; }
    .qm-welfare-case-tab--behavior.active { background: var(--qm-welfare-behavior, #c2624f); border-color: var(--qm-welfare-behavior, #c2624f); color: #fff; }
    .qm-welfare-case-tab--welfare.active { background: var(--qm-welfare-concern, #5a9c92); border-color: var(--qm-welfare-concern, #5a9c92); color: #fff; }

    @@media (min-width: 640px) {
        .qm-welfare-sheet-backdrop { align-items: center; }
        .qm-welfare-sheet { width: 90%; max-width: 480px; border-radius: var(--qm-radius-xl); border-top: 1px solid var(--qm-border); }
        .qm-welfare-sheet-handle { display: none; }
    }
</style>

@code {
    private Guid branchId;
    private bool isLoading = true;
    private bool includeInactive = false;
    private string filterQuery = "";
    private List<StudentDto> students = new();
    private PrintLetterheadDto? printLetterhead;

    private IEnumerable<StudentDto> FilteredStudents => string.IsNullOrWhiteSpace(filterQuery)
        ? students
        : students.Where(s =>
            s.FullName.Contains(filterQuery, StringComparison.OrdinalIgnoreCase) ||
            (s.StudentCode?.Contains(filterQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (s.ClassName?.Contains(filterQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            s.Guardians.Any(g => g.FullName.Contains(filterQuery, StringComparison.OrdinalIgnoreCase)));

    // Which students to include in the next batch print — persists across filter changes (so
    // picking a few from class A, then filtering to class B and picking more, combines both) but
    // "select all" only ever acts on what the current filter shows, same as most bulk-action UIs.
    private HashSet<Guid> selectedStudentIds = new();

    // ---- Batch operations -------------------------------------------------------------------
    //
    // The roster owns none of the batch machinery. It builds a BatchRequest describing what the
    // operator picked and hands it to the shared dialog, which previews it, commits it and reports
    // back. Everything after that — the resolver, the background writer, the undo — is the same
    // code every other list in the app uses.

    private QBatchDialog? batchDialog;

    /// <summary>The fields a batch may set, in the order they matter on a term boundary.</summary>
    private static readonly BatchField[] BatchFields =
    {
        BatchField.House, BatchField.DormitoryOrStream, BatchField.ClassName,
        BatchField.Residency, BatchField.FeesStatus, BatchField.TransportMode, BatchField.SponsorName
    };

    private static string FieldLabel(BatchField f) => f switch
    {
        BatchField.ClassName => "Class (set directly)",
        BatchField.House => "House",
        BatchField.DormitoryOrStream => "Dormitory / stream",
        BatchField.Residency => "Residency",
        BatchField.FeesStatus => "Fees status",
        BatchField.TransportMode => "Transport",
        BatchField.SponsorName => "Sponsor",
        _ => f.ToString()
    };

    private async Task OpenBatch(BatchOperation operation, string? value = null)
    {
        if (batchDialog == null) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = operation,
            Ids = selectedStudentIds.ToList(),
            Value = value
        });
    }

    private BatchField? pendingField;

    /// <summary>
    /// Set-a-field needs a value before it can be previewed, so it goes through a small prompt
    /// first. The vocabulary fields offer the branch's own list; the enum fields offer their real
    /// options — neither is free text, because a typo'd house name silently creates a new house.
    /// </summary>
    private async Task OpenSetField(BatchField field)
    {
        pendingField = field;
        setFieldValue = field switch
        {
            BatchField.House => vocabularies.Houses.FirstOrDefault(h => h.IsActive)?.Name ?? "",
            BatchField.DormitoryOrStream => vocabularies.Dormitories.FirstOrDefault(d => d.IsActive)?.Name ?? "",
            BatchField.ClassName => vocabularies.Classes.FirstOrDefault(c => c.IsActive)?.Name ?? "",
            BatchField.Residency => nameof(StudentResidency.Boarder),
            BatchField.FeesStatus => nameof(StudentFeesStatus.Clear),
            BatchField.TransportMode => nameof(StudentTransportMode.SchoolBus),
            _ => ""
        };
        showSetFieldPrompt = true;
        await Task.CompletedTask;
    }

    private bool showSetFieldPrompt;
    private string setFieldValue = "";

    private List<string> SetFieldOptions => pendingField switch
    {
        BatchField.House => vocabularies.Houses.Where(h => h.IsActive).OrderBy(h => h.SortOrder).Select(h => h.Name).ToList(),
        BatchField.DormitoryOrStream => vocabularies.Dormitories.Where(d => d.IsActive).OrderBy(d => d.SortOrder).Select(d => d.Name).ToList(),
        BatchField.ClassName => vocabularies.Classes.Where(c => c.IsActive).OrderBy(c => c.SortOrder).Select(c => c.Name).ToList(),
        BatchField.Residency => Enum.GetNames<StudentResidency>().ToList(),
        BatchField.FeesStatus => Enum.GetNames<StudentFeesStatus>().ToList(),
        BatchField.TransportMode => Enum.GetNames<StudentTransportMode>().ToList(),
        _ => new List<string>()
    };

    private async Task ConfirmSetField()
    {
        if (batchDialog == null || pendingField is not { } field) return;
        showSetFieldPrompt = false;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.SetField,
            Ids = selectedStudentIds.ToList(),
            Field = field,
            Value = setFieldValue
        });
    }

    /// <summary>
    /// A batch has been queued. The roster listens on the same progress channel the import already
    /// uses, so the existing HandleImportProgress reload path covers it — this just clears the
    /// selection, because leaving 731 rows ticked after acting on them invites acting twice.
    /// </summary>
    private async Task OnBatchQueued(BatchAcceptedDto accepted)
    {
        lastBatchJobId = accepted.JobId;
        lastBatchSummary = accepted.Summary;
        selectedStudentIds.Clear();
        await Task.CompletedTask;
    }

    private Guid? lastBatchJobId;
    private string? lastBatchSummary;

    /// <summary>Reverses the batch that just ran, if nothing has moved underneath it.</summary>
    private async Task UndoLastBatch()
    {
        if (lastBatchJobId is not { } jobId) return;

        var result = await BatchApi.UndoAsync(branchId, jobId);
        NotificationService.Notify(
            result.Success ? ToastSeverity.Success : ToastSeverity.Warning,
            result.Success ? "Reversed" : "Not reversed",
            result.Message + (result.ConflictedRows.Any() ? " — " + string.Join("; ", result.ConflictedRows.Take(3)) : ""),
            result.Success ? 5000 : 12000);

        if (result.Success)
        {
            lastBatchJobId = null;
            await LoadStudents();
        }
    }

    // ---- Export -----------------------------------------------------------------------------

    private string ExportSubtitle =>
        (string.IsNullOrWhiteSpace(filterQuery) ? "All students" : $"Filtered by \"{filterQuery}\"")
        + (includeInactive ? ", including inactive" : ", active only");

    /// <summary>
    /// Declared once and used by every format, so a column added here cannot be forgotten in the
    /// workbook — which is exactly how the hand-rolled exports this replaces drifted apart.
    /// </summary>
    private static readonly List<ExportColumn<StudentDto>> RosterExportColumns = new()
    {
        new("Student code", s => s.StudentCode, ExportType.Text, 14),
        new("Full name", s => s.FullName, ExportType.Text, 28),
        new("Class", s => s.ClassName, ExportType.Text, 10),
        new("House", s => s.House, ExportType.Text, 14),
        new("Dormitory / stream", s => s.DormitoryOrStream, ExportType.Text, 18),
        new("Residency", s => s.Residency, ExportType.Text, 12),
        new("Fees status", s => s.FeesStatus, ExportType.Text, 14),
        new("Date of birth", s => s.DateOfBirth, ExportType.Date, 14),
        new("Sex", s => s.Sex, ExportType.Text, 8),
        new("Admitted", s => s.AdmissionDate, ExportType.Date, 14),
        new("Guardians", s => s.Guardians.Count, ExportType.Number, 10),
        new("Guardian names", s => string.Join("; ", s.Guardians.Select(g => $"{g.FullName} ({g.Relationship})")), ExportType.Text, 40),
        new("Guardian phones", s => string.Join("; ", s.Guardians.Select(g => g.Phone).Where(p => !string.IsNullOrWhiteSpace(p))), ExportType.Text, 30),
        new("Data consent", s => s.DataConsentGivenAt.HasValue, ExportType.Bool, 12),
        new("Active", s => s.IsActive, ExportType.Bool, 8)
    };

    /// <summary>
    /// Everything matching the current filters — which on this page is the whole loaded roster
    /// narrowed by the search box, not the rows scrolled into view.
    /// </summary>
    private Task<ExportRows<StudentDto>> ProvideExportRowsAsync() =>
        Task.FromResult(new ExportRows<StudentDto>(FilteredStudents.ToList(), false));

    private bool AllFilteredSelected => FilteredStudents.Any() && FilteredStudents.All(s => selectedStudentIds.Contains(s.Id));

    private void ToggleSelectAll(bool select)
    {
        foreach (var s in FilteredStudents)
        {
            if (select) selectedStudentIds.Add(s.Id);
            else selectedStudentIds.Remove(s.Id);
        }
    }

    private void ToggleStudentSelection(Guid studentId, bool select)
    {
        if (select) selectedStudentIds.Add(studentId);
        else selectedStudentIds.Remove(studentId);
    }

    // Admin-defined, not auto-derived — a class only gets a color once someone picks one via
    // the Class Colors modal below. Unassigned classes render with UnassignedClassColor instead
    // of a guessed one.
    private const string UnassignedClassColor = "#9aa0a6";
    private Dictionary<string, string> classColors = new();

    private string GetClassColor(string? className) =>
        !string.IsNullOrWhiteSpace(className) && classColors.TryGetValue(className, out var color) ? color : UnassignedClassColor;


    /// <summary>
    /// Pre-print a "Visiting Day Pass" for one guardian ahead of the actual visit — distinct from
    /// VisitorManagement.razor's PrintBadge, which prints the real single-use check-in/checkout
    /// badge for an ACTIVE visit. There's no Visit row yet here, so this card carries no real
    /// entry token; its QR is a plain lookup aid (guardian+student id pair), not a validated,
    /// scannable credential — the printed text says so explicitly so nobody mistakes it for one.
    /// </summary>
    private async Task PrintGuardianCard(StudentDto student, StudentGuardianDto guardian)
    {
        var qrPayload = $"ROSTER:{guardian.VisitorProfileId:N}:{student.Id:N}";
        var qrDataUrl = await JS.InvokeAsync<string?>("visitorBadge.getQrDataUrl", qrPayload);
        if (string.IsNullOrEmpty(qrDataUrl))
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Couldn't generate the pass for printing");
            return;
        }

        var classColor = GetClassColor(student.ClassName);
        var classLine = string.IsNullOrEmpty(student.ClassName) ? "Unassigned" : System.Net.WebUtility.HtmlEncode(student.ClassName);
        var contactLine = LetterheadContactLine();
        var contactLineHtml = string.IsNullOrEmpty(contactLine) ? "" : $"""<div class="contact-line">{contactLine}</div>""";
        var orgHeaderHtml = string.IsNullOrEmpty(LetterheadOrgName) ? "" : $"""
            <div class="org-header">
                {LetterheadLogoTag}
                <span>{LetterheadOrgName}</span>
            </div>
            """;

        var html = $$"""
            <html>
            <head>
                <title>Visiting Day Pass - {{System.Net.WebUtility.HtmlEncode(guardian.FullName)}}</title>
                <style>
                    @page { size: 90mm 130mm; margin: 6mm; }
                    body { font-family: Arial, sans-serif; text-align: center; margin: 0; }
                    .badge { border: 2px solid {{classColor}}; border-radius: 8px; overflow: hidden; }
                    .org-header { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 10px 0; font-size: 13px; font-weight: 700; color: #333; }
                    .org-header img { width: 20px; height: 20px; object-fit: contain; }
                    .class-band { background: {{classColor}}; color: #fff; font-weight: 700; font-size: 14px; padding: 6px 0; letter-spacing: 0.5px; margin-top: 8px; }
                    .content { padding: 16px; }
                    img.qr-img { width: 170px; height: 170px; }
                    .name { font-size: 20px; font-weight: 700; margin-top: 10px; }
                    .relationship { font-size: 13px; color: #555; margin-top: 2px; }
                    .hint { font-size: 11px; color: #888; margin-top: 12px; }
                    .date { font-size: 10px; color: #aaa; margin-top: 6px; }
                    .contact-line { font-size: 10px; color: #999; margin-top: 8px; padding-top: 8px; border-top: 1px solid #eee; }
                </style>
            </head>
            <body>
                <div class="badge">
                    {{orgHeaderHtml}}
                    <div class="class-band">{{classLine}}</div>
                    <div class="content">
                        <img class="qr-img" src="{{qrDataUrl}}" alt="QR pass" />
                        <div class="name">{{System.Net.WebUtility.HtmlEncode(guardian.FullName)}}</div>
                        <div class="relationship">{{System.Net.WebUtility.HtmlEncode(guardian.Relationship)}} of {{System.Net.WebUtility.HtmlEncode(student.FullName)}}</div>
                        <div class="hint">Visiting Day Pass — present at check-in.<br />Not valid for entry without staff verification.</div>
                        <div class="date">Printed {{QDateFormat.D(DateTime.Now)}}</div>
                        {{contactLineHtml}}
                    </div>
                </div>
            </body>
            </html>
            """;

        await JS.InvokeVoidAsync("QMgrPrint.init", "browser");
        var result = await JS.InvokeAsync<PrintJsResult>("QMgrPrint.print", new { htmlContent = html, autoPrint = false });
        if (!result.Success)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Print Notice", result.Message ?? "Print may not have completed.");
        }
    }

    // Shared by the single-card and batch print paths below — structural only (no color), since
    // batch mode puts differently-colored cards on one sheet and each card supplies its own
    // border/band color inline rather than through a single hardcoded class rule.
    private const string CardCss = """
        .card { width: 85.6mm; height: 54mm; box-sizing: border-box; border: 1.5px solid #ccc; border-radius: 3mm; overflow: hidden; display: flex; flex-direction: column; background: #fff; }
        .class-band { color: #fff; font-size: 6.5pt; font-weight: 700; padding: 1.5mm 3mm; display: flex; align-items: center; justify-content: space-between; gap: 2mm; text-transform: uppercase; letter-spacing: 0.3px; }
        .class-band .org-name { display: flex; align-items: center; gap: 1.5mm; text-align: right; }
        .letterhead-logo { width: 4mm; height: 4mm; object-fit: contain; border-radius: 1px; background: #fff; flex-shrink: 0; }
        .body { flex: 1; display: flex; padding: 2mm 3mm; gap: 2mm; overflow: hidden; }
        .info { flex: 1; min-width: 0; }
        .student-name { font-size: 11pt; font-weight: 700; line-height: 1.15; }
        .student-code { font-size: 7pt; color: #666; margin-top: 0.5mm; }
        .guardians-label { font-size: 6pt; color: #999; margin-top: 1.5mm; text-transform: uppercase; letter-spacing: 0.3px; }
        .guardian-row { font-size: 7.5pt; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .guardian-row .rel { color: #777; }
        .guardian-row.none { font-style: italic; color: #999; }
        .qr { width: 15mm; height: 15mm; flex-shrink: 0; }
        .footer { font-size: 5pt; color: #999; text-align: center; padding: 1mm 2mm; border-top: 0.5px solid #eee; }
        .footer .contact-line { color: #777; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .footer .disclaimer-line { margin-top: 0.5mm; }
        """;

    // The tenant's own identity (name/address/contact), not the app's — fetched once and reused
    // across every card this page prints. Null (fetch failed) or an empty OrganizationName both
    // degrade gracefully to "just omit the letterhead" rather than showing a placeholder.
    private string LetterheadOrgName => string.IsNullOrWhiteSpace(printLetterhead?.OrganizationName)
        ? "" : System.Net.WebUtility.HtmlEncode(printLetterhead.OrganizationName);

    private string LetterheadLogoTag => string.IsNullOrWhiteSpace(printLetterhead?.LogoUrl)
        ? "" : $"""<img class="letterhead-logo" src="{System.Net.WebUtility.HtmlEncode(printLetterhead.LogoUrl)}" alt="" />""";

    private string LetterheadContactLine()
    {
        var parts = new List<string?> { printLetterhead?.Address, printLetterhead?.ContactPhone, printLetterhead?.ContactEmail }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        return parts.Any() ? System.Net.WebUtility.HtmlEncode(string.Join("  ·  ", parts)) : "";
    }

    /// <summary>
    /// Builds one card's markup (a durable, ID-card-sized — CR80, 85.6x54mm, standard credit-
    /// card/badge size — "Student Visitation Card" listing every guardian on file), or null if
    /// its QR couldn't be generated. Shared by PrintStudentIdCard (one card, its own print job)
    /// and PrintAllStudentCards (many cards laid out on shared A4 sheets) so the two stay
    /// visually identical rather than two copies of the same markup drifting apart.
    /// </summary>
    private async Task<string?> BuildStudentCardMarkupAsync(StudentDto student)
    {
        var qrDataUrl = await JS.InvokeAsync<string?>("visitorBadge.getQrDataUrl", $"STUDENT:{student.Id:N}");
        if (string.IsNullOrEmpty(qrDataUrl)) return null;

        var classColor = GetClassColor(student.ClassName);
        var classLine = string.IsNullOrEmpty(student.ClassName) ? "No Class" : System.Net.WebUtility.HtmlEncode(student.ClassName);
        var codeLine = string.IsNullOrEmpty(student.StudentCode) ? "" : System.Net.WebUtility.HtmlEncode(student.StudentCode);

        var guardianRows = student.Guardians.Any()
            ? string.Join("", student.Guardians.Select(g =>
                $"""<div class="guardian-row">{System.Net.WebUtility.HtmlEncode(g.FullName)} <span class="rel">({System.Net.WebUtility.HtmlEncode(g.Relationship)})</span></div>"""))
            : """<div class="guardian-row none">No guardians on file yet</div>""";

        var contactLine = LetterheadContactLine();
        var contactLineHtml = string.IsNullOrEmpty(contactLine) ? "" : $"""<div class="contact-line">{contactLine}</div>""";

        return $$"""
            <div class="card" style="border-color:{{classColor}}">
                <div class="class-band" style="background:{{classColor}}">
                    <span>{{classLine}}</span>
                    <span class="org-name">{{LetterheadOrgName}}{{LetterheadLogoTag}}</span>
                </div>
                <div class="body">
                    <div class="info">
                        <div class="student-name">{{System.Net.WebUtility.HtmlEncode(student.FullName)}}</div>
                        <div class="student-code">{{codeLine}}</div>
                        <div class="guardians-label">Authorized Guardians</div>
                        {{guardianRows}}
                    </div>
                    <img class="qr" src="{{qrDataUrl}}" alt="QR" />
                </div>
                <div class="footer">
                    {{contactLineHtml}}
                    <div class="disclaimer-line">Student Visitation Card — verify guardian identity at check-in.</div>
                </div>
            </div>
            """;
    }

    /// <summary>
    /// Prints one Student Visitation Card, as opposed to PrintGuardianCard's per-guardian
    /// visiting-day pass. Meant to double as an identification document staff can check a
    /// presented guardian against (or that's kept on file at the gate/office), not a one-off
    /// event pass — so unlike the visiting-day pass this doesn't get reprinted per visit, just
    /// whenever the guardian list changes. Same QR-is-a-lookup-aid-not-a-credential caveat.
    /// </summary>
    private async Task PrintStudentIdCard(StudentDto student)
    {
        var cardHtml = await BuildStudentCardMarkupAsync(student);
        if (cardHtml == null)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Couldn't generate the card for printing");
            return;
        }

        var html = $$"""
            <html>
            <head>
                <title>Student Visitation Card - {{System.Net.WebUtility.HtmlEncode(student.FullName)}}</title>
                <style>
                    @page { size: 85.6mm 54mm; margin: 0; }
                    body { font-family: Arial, sans-serif; margin: 0; }
                    {{CardCss}}
                </style>
            </head>
            <body>
                {{cardHtml}}
            </body>
            </html>
            """;

        await JS.InvokeVoidAsync("QMgrPrint.init", "browser");
        var result = await JS.InvokeAsync<PrintJsResult>("QMgrPrint.print", new { htmlContent = html, autoPrint = false });
        if (!result.Success)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Print Notice", result.Message ?? "Print may not have completed.");
        }
    }

    /// <summary>
    /// Batch-prints Student Visitation Cards for every checked student — 8 per A4 sheet (2
    /// columns x 4 rows of CR80 cards, the standard packing for this card size with room for cut
    /// margins), spilling onto additional sheets past 8. Selection is explicit (checkboxes plus
    /// a filter-scoped "select all") rather than always defaulting to everyone, so staff can
    /// print the whole roster, a couple of specific students, or one class (filter to it, then
    /// select all) without those being three different features.
    /// </summary>
    private async Task PrintAllStudentCards()
    {
        var targets = students.Where(s => s.IsActive && selectedStudentIds.Contains(s.Id)).ToList();
        if (!targets.Any())
        {
            NotificationService.Notify(ToastSeverity.Warning, "Nothing to print", "Select at least one student first.");
            return;
        }

        var cardBlocks = new List<string>();
        var skipped = 0;
        foreach (var student in targets)
        {
            var cardHtml = await BuildStudentCardMarkupAsync(student);
            if (cardHtml == null) { skipped++; continue; }
            cardBlocks.Add(cardHtml);
        }

        if (!cardBlocks.Any())
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Couldn't generate any cards for printing");
            return;
        }

        const int cardsPerPage = 8;
        var pagesHtml = string.Join("", cardBlocks
            .Select((html, i) => (html, page: i / cardsPerPage))
            .GroupBy(x => x.page)
            .Select(page => $"""<div class="sheet-page">{string.Join("", page.Select(x => x.html))}</div>"""));

        var html = $$"""
            <html>
            <head>
                <title>Student Visitation Cards ({{cardBlocks.Count}})</title>
                <style>
                    @page { size: A4; margin: 10mm; }
                    body { font-family: Arial, sans-serif; margin: 0; }
                    .sheet-page { display: grid; grid-template-columns: repeat(2, 85.6mm); grid-auto-rows: 54mm; gap: 4mm 8mm; justify-content: center; page-break-after: always; }
                    .sheet-page:last-child { page-break-after: auto; }
                    {{CardCss}}
                </style>
            </head>
            <body>
                {{pagesHtml}}
            </body>
            </html>
            """;

        await JS.InvokeVoidAsync("QMgrPrint.init", "browser");
        var result = await JS.InvokeAsync<PrintJsResult>("QMgrPrint.print", new { htmlContent = html, autoPrint = false });
        if (!result.Success)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Print Notice", result.Message ?? "Print may not have completed.");
        }
        else if (skipped > 0)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Some cards skipped", $"{skipped} student(s) couldn't be included.");
        }
    }

