@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Admin.Staff
@inject IStaffOnboardingApiService Onboarding
@inject IStaffPerformanceApiService StaffApi
@inject IToastService Toast
@inject IPermissionService PermissionService
@inherits BranchAwareComponentBase
@inject IAuthService AuthService
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IJSRuntime JS
@inject IOrganizationApiService OrganizationApi
@inject NavigationManager Navigation
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions JsonOptions

@*
    Onboarding (duty rota plan §12.4–12.5). The Status tab is who has not signed in yet, whose temporary
    password expired and who has not acknowledged the acceptable-use notice — with Re-issue, singly or in
    bulk, the old password or link invalidated at once. The Join link tab switches staff sign-up on, issues
    and rotates the link (shown once, with a QR code for the staff-room noticeboard), restricts email
    domains and sets the acceptable-use notice the first-sign-in checklist asks for. Temporary passwords come
    back from a re-issue once and live only in this page's memory until printed.
*@

@if (!Embedded)
{
    <QPageTitle Text="Staff Onboarding" />
}

<div class="admin-page">
    <QPageActions Embedded="@Embedded">
        <Title>
            <h1>Staff Onboarding</h1>
            <p class="subtitle">Getting staff signed in: who still has to, a new temporary password or invitation for anyone stuck, and the join link for people to ask for an account themselves.</p>
        </Title>
        <Actions>
            @if (pendingJoinRequests > 0)
            {
                <QButton Text="@($"{pendingJoinRequests} join request{(pendingJoinRequests == 1 ? "" : "s")} waiting")" Icon="person-check" Variant="primary" OnClick="@(() => Navigation.NavigateTo("/admin/users?tab=requests"))" />
            }
        </Actions>
    </QPageActions>

    @if (moduleMissing)
    {
        <QEmptyState Icon="box-seam" Title="Staff onboarding is part of Welfare & Performance" Text="Add the module under Billing to use onboarding and the join link." />
    }
    else
    {
        <QTabs Tabs="@Tabs" @bind-ActiveKey="activeTab" IdPrefix="ob" AriaLabel="Onboarding" />

        @if (activeTab == "status")
        {
            @if (status == null)
            {
                <QSpinner />
            }
            else
            {
                @* ONE LIST, ONE BAR (2026-09-23). This tab carried three stat tiles repeating the
                   three lists' counts, a hand-rolled bulk strip and three tables of raw browser
                   checkboxes. The counts live on QBulkBar's chips now - the same bar Users & Roles
                   uses - and the chip decides which list is on screen, so select-all can only ever
                   reach the rows the reader is looking at. *@
                <QBulkBar Filters="@StatusFilters" ActiveFilter="@statusFilter" ActiveFilterChanged="@OnStatusFilterChanged"
                          SearchPlaceholder="Search name, username or email"
                          Search="@search" SearchChanged="@OnSearchChanged"
                          ShowSelection="@canReissue"
                          VisibleCount="@VisibleRows.Count" SelectedCount="@selected.Count"
                          AllSelected="@AllVisibleSelected" AllSelectedChanged="@ToggleSelectAllVisible"
                          ClearSelection="@(() => selected.Clear())"
                          IdleHint="Tick people to give them a new temporary password or invitation">
                    <Actions>
                        @* Slips and SMS open the dialog because both hand out a PASSWORD and the
                           administrator now has a choice to make about it. An invitation carries no
                           password - it is a link to a page where the person chooses their own - so
                           the dialog would have nothing to ask and it still fires directly. *@
                        <QButton Text="Print slips" Icon="printer" Variant="secondary" Size="sm" OnClick="@(() => OpenReissue(StaffImportDeliveryMode.Slips))" Loading="@working" Disabled="@working"
                                 Title="New temporary passwords, on printable slips" />
                        <QButton Text="By SMS" Icon="phone" Variant="secondary" Size="sm" OnClick="@(() => OpenReissue(StaffImportDeliveryMode.Sms))" Disabled="@working"
                                 Title="New temporary passwords, texted" />
                        <QButton Text="Invitation" Icon="envelope" Variant="secondary" Size="sm" OnClick="@(() => ReissueAsync(StaffImportDeliveryMode.Invitation, null))" Disabled="@working"
                                 Title="A new invitation link by email" />
                    </Actions>
                </QBulkBar>

                <p class="ob-sub ob-help">@FilterHelp</p>

                @if (VisibleRows.Count == 0)
                {
                    <QEmptyState Icon="check-circle" Title="@(string.IsNullOrWhiteSpace(search) ? "Nobody" : "No one matches")"
                                 Text="@(string.IsNullOrWhiteSpace(search) ? null : "Clear the search.")" />
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table q-stack">
                            <thead>
                                <tr>
                                    @if (canReissue) { <th class="ob-tick"></th> }
                                    <th>Name</th><th>Username</th><th>Role</th><th>Added</th>@if (ShowAccess) { <th>Access</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @* All above QPaging.VirtualizeAbove rows renders through <Virtualize>, so choosing All on a large list
                                   never ships every row down the circuit at once (plan STUDENT_ROSTER_AND_LIST_STANDARD §1, L3). *@
                                @if (PageSize == QPager.All && VisibleRows.Count > QPaging.VirtualizeAbove)
                                {
                                    <Virtualize Items="@VisibleRows" Context="r" ItemSize="52" SpacerElement="tr">@OnboardingRow(r)</Virtualize>
                                }
                                else
                                {
                                    @foreach (var r in PagedRows)
                                    {
                                        @OnboardingRow(r)
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <QPager Count="@VisibleRows.Count" PageSize="@PageSize" PageIndex="@pageIndex" PageIndexChanged="@(p => pageIndex = p)" PageSizeOptions="@QPagerDefaults.Sizes" AllowAll="true" StorageKey="staff-onboarding"
                    PageSizeChanged="@(n => { PageSize = n; pageIndex = 0; })" SelectedCount="@selected.Count" ItemLabel="people" />
                }
            }
        }
        else if (activeTab == "join")
        {
            @if (settings == null)
            {
                <QSpinner />
            }
            else if (!canApprove)
            {
                <QEmptyState Icon="lock" Title="The join link needs Approve Join Requests" Text="Ask an Administrator or Manager to set it up." />
            }
            else
            {
                <QCard Title="Join link" Icon="link-45deg">
                    <p class="ob-lede">
                        Staff open the link, prove their email with a code, and choose a password. They cannot sign in until
                        someone with <em>Approve Join Requests</em> approves them and picks their role. Anyone holding the
                        link can apply, so rotate it if it leaks — the old one stops working at once.
                    </p>
                    <QCheckbox @bind-Value="@form.JoinEnabled" Label="Staff sign-up is on" />
                    @if (issued != null)
                    {
                        <div class="ob-link" role="region" aria-label="New join link">
                            <div class="ob-link-text">
                                <strong>Copy this link now — it will not be shown again.</strong>
                                <code class="ob-url">@JoinUrl</code>
                                <div class="ob-link-actions">
                                    <QButton Text="Copy" Icon="clipboard" Variant="secondary" Size="sm" OnClick="@CopyLinkAsync" />
                                    <QButton Text="Print noticeboard sheet" Icon="printer" Variant="secondary" Size="sm" OnClick="@(() => showNoticeboard = true)" />
                                </div>
                                @if (issued.ExpiresAt != null) { <span class="ob-sub">Valid until @QDateFormat.DT(issued.ExpiresAt.Value.ToLocalTime())</span> }
                            </div>
                            <div id="ob-qr" class="ob-qr" aria-label="QR code for the join link"></div>
                        </div>
                    }
                    else if (settings.HasJoinLink)
                    {
                        <p class="ob-sub">A link was issued @(settings.JoinCodeIssuedAt is { } at ? QDateFormat.DT(at.ToLocalTime()) : "")@(settings.JoinCodeExpiresAt is { } ex ? $", valid until {QDateFormat.DT(ex.ToLocalTime())}" : ""). The link itself is not stored; rotate to get a new one to share.</p>
                    }
                    <div class="ob-actions">
                        <QInput TValue="int?" Type="number" Label="Link valid for (days, empty = until rotated)" @bind-Value="@linkValidDays" Min="0" Max="365" />
                        <QButton Text="@(settings.HasJoinLink ? "Rotate link" : "Create link")" Icon="arrow-repeat" Variant="primary" OnClick="@RotateAsync" Loading="@working" Disabled="@working" />
                    </div>
                </QCard>

                <QCard Title="Who may apply" Icon="shield-check">
                    <QInput TValue="string" Label="Allowed email domains (optional)" @bind-Value="@domainsText"
                            Hint="Comma-separated, e.g. myschool.ac.ug. Empty means any address — approval still decides." />
                    @if (branches.Count > 1)
                    {
                        <QSelect TValue="Guid?" TItem="BranchChoice" Label="Branch when the applicant does not choose" @bind-Value="@form.DefaultBranchId" AllowClear="true"
                                 Items="@branches" ValueSelector="@(b => (Guid?)b.Id)" TextSelector="@(b => b.Name)" Placeholder="Ask the approver" />
                    }
                    <QInput TValue="int" Type="number" Label="Unanswered requests expire after (days)" @bind-Value="@form.RequestExpiryDays" Min="1" Max="90"
                            HelperText="@($"Rejected and expired requests are deleted {settings.PurgeAfterDays} days later.")" />
                </QCard>

                <QCard Title="Acceptable-use and data-protection notice" Icon="file-earmark-text">
                    <p class="ob-lede">New staff confirm they have read this on their first-sign-in checklist. It is a staff notice that asks for acknowledgement, so it records who confirmed and when.</p>
                    @if (settings.AcceptableUseNoticeId != null)
                    {
                        <p>Current notice: <strong>@settings.AcceptableUseNoticeTitle</strong></p>
                    }
                    <div class="ob-actions">
                        <QSelect TValue="Guid?" TItem="StaffNoticeDto" Label="Notice" @bind-Value="@form.AcceptableUseNoticeId" AllowClear="true"
                                 Items="@acknowledgementNotices" ValueSelector="@(n => (Guid?)n.Id)" TextSelector="@(n => n.Title)" Placeholder="No notice" />
                        @if (settings.AcceptableUseNoticeId == null)
                        {
                            <QButton Text="Create one from a default text" Icon="plus-lg" Variant="secondary" OnClick="@CreateNoticeAsync" Disabled="@working" />
                        }
                    </div>
                </QCard>

                <div class="ob-save">
                    <QButton Text="Save settings" Icon="check-lg" Variant="primary" OnClick="@SaveSettingsAsync" Loading="@working" Disabled="@working" />
                </div>
            }
        }
    }
</div>

@* THE CHOICE, PUT ONCE, IN WORDS (2026-09-22). A school with 133 staff who have no email address
   reads these out down a phone line, and ten random characters is where that goes wrong. So an
   administrator may type one password for the whole group — but the default is still one each, and
   the cost of the other is stated rather than buried, because it is a real one. *@
<QModal Visible="@showReissue" Title="Re-issue access" Icon="key" OnClose="@(() => showReissue = false)">
    <ChildContent>
        <p class="ob-lede">
            @selected.Count @(selected.Count == 1 ? "person" : "people") selected.
            @(reissueMode == StaffImportDeliveryMode.Sms
                ? "Each one is texted their password. Anyone with no phone number is listed afterwards so you can print their slip instead."
                : "You will get a printable slip for each person. The passwords cannot be shown again once you close it.")
        </p>

        @* OFF is the safe answer, so off is the default and the checkbox is the deliberate act.
           A pair of radio buttons would put the two on an equal footing, and they are not. *@
        <QCheckbox @bind-Value="@sharedPassword" Label="Use the same password for everyone"
                   Hint="Easier to read out to a room or down a phone line — which is the whole reason this exists, for the staff who have no email address. Leave it off and each person gets their own ten characters, which is safer." />

        @if (sharedPassword)
        {
            <QInput Label="The password everyone gets" @bind-Value="@sharedPasswordText" Required="true"
                    Hint="It has to pass the same rules a person's own password does, so it cannot be a common word, this school's name, or anyone's username. If it is refused, the reason says which."
                    Placeholder="Type it as you will read it out" />
            <p class="ob-warn">
                <QIcon Name="exclamation-triangle" Size="14" />
                <span>Until each of them signs in and chooses their own, everyone in this group can sign in as everyone else. Hand it out as close as you can to when people will actually use it.</span>
            </p>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showReissue = false)" Disabled="@working" />
        <QButton Text="@(reissueMode == StaffImportDeliveryMode.Sms ? "Send by SMS" : "Make the slips")" Icon="key"
                 Variant="primary" Loading="@working"
                 Disabled="@(working || (sharedPassword && string.IsNullOrWhiteSpace(sharedPasswordText)))"
                 OnClick="@(() => ReissueAsync(reissueMode, sharedPassword ? sharedPasswordText : null))" />
    </FooterContent>
</QModal>

@if (slips.Count > 0 && showSlips)
{
    <TemporaryPasswordSlips Slips="@slips" OrganizationName="@organizationName" SignInAddress="@($"{Navigation.BaseUri}login")" OnClose="@CloseSlips" />
}

@if (showNoticeboard && issued != null)
{
    <div class="tps-overlay ob-board" role="dialog" aria-modal="true" aria-label="Join link noticeboard sheet">
        <QPrintSheet SheetId="ob-board-sheet" Title="Join link" OnBack="@(() => showNoticeboard = false)" BackText="Close">
            <div class="ob-board-sheet">
                @* The print-sheet audit (white-label plan, C3) found this: a poster a school pins
                   up in its own staffroom carrying OUR name, on the one printed surface a
                   white-labelling tenant is most likely to put on a wall. The other eight sheets
                   already fetched branding; this one had none at all. *@
                <h1>Join @organizationName@(brandingRemovesAttribution ? "" : " on Q-Mgr")</h1>
                <p>Staff: scan the code or type the address to ask for your account. An administrator will approve you.</p>
                <div id="ob-board-qr" class="ob-board-qr"></div>
                <p class="ob-board-url">@JoinUrl</p>
                <p class="ob-sub">Use your own email address. Never share your password with anyone.</p>
            </div>
        </QPrintSheet>
    </div>
}

<style>
    .ob-lede { font-size: var(--qm-text-base); color: var(--qm-text-secondary); margin: 0 0 10px; }
    .ob-sub { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }
    /* A warning, not a hint: it changes what somebody DOES with the password, so it stays on the
       page rather than folding into a QInfo. ONE span holding the whole sentence — a flex row puts
       every text run in its own column, which is how these end up ragged. */
    .ob-warn { display: flex; align-items: flex-start; gap: 8px; margin: 10px 0 0; font-size: var(--qm-text-sm); color: var(--qm-warning); }
    .ob-help { margin: 0 0 8px; }
    .ob-tick { width: 34px; }
    .ob-row--picked td { background: rgba(var(--qm-primary-rgb), .06); }
    .ob-person { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .ob-person-text { display: flex; flex-direction: column; min-width: 0; }
    .ob-actions { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; margin-top: 10px; }
    .ob-actions > * { min-width: 0; }
    .ob-link { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin: 12px 0; padding: 12px; border: 1px solid var(--qm-warning); border-radius: var(--qm-radius-md); }
    .ob-link-text { flex: 1 1 260px; min-width: 0; display: grid; gap: 6px; }
    .ob-url { overflow-wrap: anywhere; font-size: var(--qm-text-base); }
    .ob-link-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .ob-qr { background: #fff; padding: 8px; border-radius: var(--qm-radius-sm); }
    .ob-save { margin-top: 14px; display: flex; justify-content: flex-end; }
    .ob-board-sheet { text-align: center; padding-top: 20mm; }
    .ob-board-sheet h1 { font-size: 22pt; margin: 0 0 8px; }
    .ob-board-qr { display: flex; justify-content: center; margin: 14mm 0 8mm; }
    .ob-board-url { font-family: "Courier New", monospace; font-size: 11pt; overflow-wrap: anywhere; }
    .tps-overlay { position: fixed; inset: 0; z-index: 1200; overflow: auto; background: #f3f3f3; /* fixed paper backdrop: this overlay previews a print sheet */ }
    @@media print {
        body * { visibility: hidden !important; }
        .ob-board, .ob-board * { visibility: visible !important; }
        .ob-board { position: absolute; inset: 0; overflow: visible; background: #fff; }
    }
</style>

@code {
    /// <summary>True when the Users & Roles hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private static readonly IReadOnlyList<QTab> Tabs = new List<QTab>
    {
        new("status", "Status", "people"),
        new("join", "Join link", "link-45deg"),
    };

    private string activeTab = "status";
    private bool moduleMissing, canApprove, canReissue, working, showSlips, showNoticeboard;

    /// <summary>The re-issue dialog: which delivery it was opened for, and the password choice.</summary>
    private bool showReissue, sharedPassword;
    private StaffImportDeliveryMode reissueMode = StaffImportDeliveryMode.Slips;
    private string sharedPasswordText = string.Empty;
    private int pendingJoinRequests;
    private Guid branchId;
    private string organizationName = string.Empty;

    /// <summary>
    /// Whether the printed join poster drops "on Q-Mgr". Defaults to false, so a failed branding
    /// fetch leaves our name on rather than silently taking it off.
    /// </summary>
    private bool brandingRemovesAttribution;
    private OnboardingStatusDto? status;
    private StaffOnboardingSettingsDto? settings;
    private SaveStaffOnboardingSettingsRequest form = new();
    private string? domainsText;
    private int? linkValidDays;
    private JoinLinkIssuedDto? issued;
    private List<StaffNoticeDto> acknowledgementNotices = new();
    private List<BranchChoice> branches = new();
    private readonly HashSet<Guid> selected = new();
    private List<TemporaryPasswordSlipDto> slips = new();

    private sealed record BranchChoice(Guid Id, string Name, bool IsActive = true);

    private string JoinUrl => issued == null ? string.Empty : $"{Navigation.BaseUri.TrimEnd('/')}{issued.Path}";

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.UsersView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }
        canApprove = await PermissionService.HasPermissionAsync(Permissions.UsersApprove);
        canReissue = await PermissionService.HasPermissionAsync(Permissions.UsersEdit);

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
        {
            moduleMissing = true;
            return;
        }

        organizationName = (await AuthService.GetCurrentUserAsync())?.OrganizationName ?? string.Empty;

        var branding = await OrganizationApi.GetMyBrandingAsync();
        if (branding.Resolved && !string.IsNullOrWhiteSpace(branding.BrandName)) organizationName = branding.BrandName!;
        brandingRemovesAttribution = branding.AttributionRemoved;
        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;
        TrackBranch();

        await LoadStatusAsync();
        if (canApprove) await LoadSettingsAsync();
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            status = await Onboarding.GetStatusAsync(branchId == Guid.Empty ? null : branchId);
            pendingJoinRequests = status.PendingJoinRequests;
            // Open on the list that needs somebody: an expired password locks a person out outright.
            if (!statusPicked) statusFilter = status.TemporaryPasswordExpired.Count > 0 ? "expired" : "notsignedin";
            if (statusFilter == "notack" && status.AcceptableUseNoticeId == null) statusFilter = "notsignedin";
            if (pageIndex * PageSize >= VisibleRows.Count) pageIndex = 0;
            PruneSelection();
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not load onboarding status", ex.Message); }
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            settings = await Onboarding.GetSettingsAsync();
            form = new SaveStaffOnboardingSettingsRequest
            {
                JoinEnabled = settings.JoinEnabled,
                AllowedEmailDomains = settings.AllowedEmailDomains,
                DefaultBranchId = settings.DefaultBranchId,
                RequestExpiryDays = settings.RequestExpiryDays,
                AcceptableUseNoticeId = settings.AcceptableUseNoticeId
            };
            domainsText = string.Join(", ", settings.AllowedEmailDomains);
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not load the join link settings", ex.Message); }

        try
        {
            var all = await Http.GetFromJsonAsync<List<BranchChoice>>("api/v1/branches", JsonOptions) ?? new();
            branches = all.Where(b => b.IsActive).OrderBy(b => b.Name).ToList();
        }
        catch { branches = new(); }

        try
        {
            if (branchId != Guid.Empty && await PermissionService.HasPermissionAsync(Permissions.StaffNoticesManage))
                acknowledgementNotices = (await StaffApi.GetManagedNoticesAsync(branchId)).Where(n => n.RequiresAcknowledgement).ToList();
            else if (branchId != Guid.Empty)
                acknowledgementNotices = (await StaffApi.GetMyNoticesAsync(branchId)).Where(n => n.RequiresAcknowledgement).ToList();
        }
        catch { acknowledgementNotices = new(); }
    }

    private static string AccessText(OnboardingStatusRowDto r)
    {
        if (r.TemporaryPasswordExpired) return $"Temporary password expired {QDateFormat.DT(r.TemporaryPasswordExpiresAt?.ToLocalTime())}";
        if (r.MustChangePassword) return $"Temporary password until {QDateFormat.DT(r.TemporaryPasswordExpiresAt?.ToLocalTime())}";
        if (r.InvitationPending) return "Invitation sent, not yet used";
        return "No temporary password or invitation";
    }

    private void Toggle(Guid id, bool on)
    {
        if (on) selected.Add(id); else selected.Remove(id);
    }

    // THE LIST ON SCREEN. A chip picks one of the three lists; the search narrows it. Select-all
    // covers exactly these rows, and a filter or search change prunes the selection to them - the
    // rule QBulkBar cannot enforce itself, because only this page knows what a row is.
    private string statusFilter = "notsignedin";
    private bool statusPicked;
    private string search = string.Empty;
    private int pageIndex;
    private int PageSize = QPagerDefaults.Size;

    private IReadOnlyList<QBulkBar.Filter> StatusFilters
    {
        get
        {
            if (status == null) return Array.Empty<QBulkBar.Filter>();
            var list = new List<QBulkBar.Filter>
            {
                new("expired", "Password expired", status.TemporaryPasswordExpired.Count),
                new("notsignedin", "Not signed in yet", status.NotSignedIn.Count),
            };
            if (status.AcceptableUseNoticeId != null)
                list.Add(new("notack", "Not acknowledged", status.NotAcknowledged.Count));
            return list;
        }
    }

    private List<OnboardingStatusRowDto> FilterRows => status == null ? new() : statusFilter switch
    {
        "expired" => status.TemporaryPasswordExpired,
        "notack" => status.NotAcknowledged,
        _ => status.NotSignedIn,
    };

    private bool ShowAccess => statusFilter != "notack";

    private string FilterHelp => statusFilter switch
    {
        "expired" => "They cannot sign in until you issue a new temporary password or invitation.",
        "notack" => "Signed in, but has not confirmed they have read the acceptable-use notice. It is on their portal checklist.",
        _ => "Accounts nobody has signed in to. A temporary password or invitation may still be on its way.",
    };

    private List<OnboardingStatusRowDto> VisibleRows
    {
        get
        {
            IEnumerable<OnboardingStatusRowDto> q = FilterRows;
            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();
                q = q.Where(r => r.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)
                              || r.Username.Contains(term, StringComparison.OrdinalIgnoreCase)
                              || (r.Email ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return q.OrderBy(r => r.SortName ?? r.FullName, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private List<OnboardingStatusRowDto> PagedRows => QPaging.Page(VisibleRows, pageIndex, PageSize).ToList();

    private bool AllVisibleSelected => VisibleRows.Count > 0 && VisibleRows.All(r => selected.Contains(r.UserId));

    private void ToggleSelectAllVisible(bool on)
    {
        foreach (var r in VisibleRows) Toggle(r.UserId, on);
    }

    private void PruneSelection()
    {
        var visible = VisibleRows.Select(r => r.UserId).ToHashSet();
        selected.RemoveWhere(id => !visible.Contains(id));
    }

    private void OnStatusFilterChanged(string key)
    {
        statusPicked = true;
        statusFilter = key;
        pageIndex = 0;
        PruneSelection();
    }

    private void OnSearchChanged(string term)
    {
        search = term;
        pageIndex = 0;
        PruneSelection();
    }

    private void OpenReissue(StaffImportDeliveryMode mode)
    {
        if (selected.Count == 0) return;
        reissueMode = mode;
        // A fresh choice every time. Remembering "the same password for everyone" across two
        // re-issues is how a password meant for one afternoon's group gets handed to a second.
        sharedPassword = false;
        sharedPasswordText = string.Empty;
        showReissue = true;
    }

    private async Task ReissueAsync(StaffImportDeliveryMode mode, string? chosenPassword)
    {
        if (selected.Count == 0) return;
        working = true;
        try
        {
            var result = await Onboarding.ReissueAsync(new ReissueAccessRequest
            {
                UserIds = selected.ToList(),
                Mode = mode,
                TemporaryPassword = string.IsNullOrWhiteSpace(chosenPassword) ? null : chosenPassword
            });
            showReissue = false;
            foreach (var m in result.Messages) Toast.Notify(ToastSeverity.Warning, "Re-issue", m);
            Toast.Notify(ToastSeverity.Success, $"Access re-issued for {result.Reissued} {(result.Reissued == 1 ? "person" : "people")}",
                mode == StaffImportDeliveryMode.Invitation ? "Invitations sent." : "Print the slips now — the passwords cannot be shown again.");
            if (result.Slips.Count > 0)
            {
                slips = result.Slips;
                showSlips = true;
            }
            selected.Clear();
            await LoadStatusAsync();
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not re-issue", ex.Message); }
        finally { working = false; }
    }

    private void CloseSlips()
    {
        // Closing discards them: nothing on the server can show them again.
        showSlips = false;
        slips = new();
    }

    private async Task RotateAsync()
    {
        working = true;
        try
        {
            issued = await Onboarding.RotateJoinLinkAsync(linkValidDays);
            Toast.Notify(ToastSeverity.Success, "New join link issued", "Any earlier link has stopped working.");
            await LoadSettingsAsync();
            StateHasChanged();
            await Task.Yield();
            try { await JS.InvokeAsync<bool>("renderQrInto", "ob-qr", JoinUrl, 160); } catch { }
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not issue the link", ex.Message); }
        finally { working = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showNoticeboard && issued != null)
        {
            try { await JS.InvokeAsync<bool>("renderQrInto", "ob-board-qr", JoinUrl, 260); } catch { }
        }
        if (issued != null && activeTab == "join")
        {
            try { await JS.InvokeAsync<bool>("renderQrInto", "ob-qr", JoinUrl, 160); } catch { }
        }
    }

    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", JoinUrl);
            Toast.Notify(ToastSeverity.Success, "Link copied");
        }
        catch { Toast.Notify(ToastSeverity.Warning, "Copy it by hand", "The browser did not allow copying."); }
    }

    private async Task SaveSettingsAsync()
    {
        working = true;
        try
        {
            form.AllowedEmailDomains = (domainsText ?? string.Empty).Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            settings = await Onboarding.SaveSettingsAsync(form);
            Toast.Notify(ToastSeverity.Success, "Onboarding settings saved");
            await LoadSettingsAsync();
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not save", ex.Message); }
        finally { working = false; }
    }

    private async Task CreateNoticeAsync()
    {
        working = true;
        try
        {
            settings = await Onboarding.CreateAcceptableUseNoticeAsync();
            Toast.Notify(ToastSeverity.Success, "Acceptable-use notice published", "Edit its wording on the Notices page if you wish.");
            await LoadSettingsAsync();
        }
        catch (InvalidOperationException ex) { Toast.Notify(ToastSeverity.Error, "Could not create the notice", ex.Message); }
        finally { working = false; }
    }

    /// <summary>
    /// The branch changed under the page. The guard on an unchanged or empty branch, the
    /// marshalling onto the renderer and the StateHasChanged afterwards all live in
    /// BranchAwareComponentBase now, so only the page-specific reset and reload remain.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        await LoadStatusAsync();
        if (canApprove) await LoadSettingsAsync();
    }


    /// <summary>One row, shared by the paged loop and the virtualised All so the two cannot drift.</summary>
    private RenderFragment OnboardingRow(OnboardingStatusRowDto r) => __builder =>
    {
                                    <tr class="@(selected.Contains(r.UserId) ? "ob-row--picked" : "")">
                                        @if (canReissue)
                                        {
                                            <td class="ob-tick">
                                                @* No label: the name is in the next cell. The title carries it. *@
                                                <span title="@($"Select {r.FullName}")">
                                                    <QCheckbox Value="@selected.Contains(r.UserId)" ValueChanged="@(v => Toggle(r.UserId, v))" />
                                                </span>
                                            </td>
                                        }
                                        <td>
                                            <div class="ob-person">
                                                <QAvatar Name="@r.FullName" Title="@r.FullName" />
                                                <div class="ob-person-text">
                                                    <span>@r.FullName</span>
                                                    <span class="cell-sub">@(string.IsNullOrWhiteSpace(r.Email) ? "No email address" : r.Email)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@r.Username</td>
                                        <td>@(r.RoleName ?? "—")</td>
                                        <td>@QDateFormat.D(r.CreatedAt.ToLocalTime())</td>
                                        @if (ShowAccess)
                                        {
                                            <td>@AccessText(r)</td>
                                        }
                                    </tr>
    };
}
