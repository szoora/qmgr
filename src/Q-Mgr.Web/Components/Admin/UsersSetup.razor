                NotificationService.Notify(ToastSeverity.Success,
                    role.IsActive ? "Role deactivated" : "Role activated",
                    role.IsActive
                        ? $"'{role.Name}' can no longer be assigned; its holders' permissions were revoked at once."
                        : $"'{role.Name}' can be assigned again.");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update role: {ex.Message}");
        }
    }

    private void DeleteRole(RoleInfo role)
    {
        if (role.IsSystem) return;
        roleToDelete = role;
        roleDeleteConfirmMessage = role.UserCount > 0
            ? $"'{role.Name}' is held by {role.UserCount} user{(role.UserCount == 1 ? "" : "s")}. The server will refuse to delete it until they are moved to another role. Try anyway?"
            : $"Delete the role '{role.Name}'? This cannot be undone. Its permissions and scopes are lost; no user holds it.";
        showRoleDeleteConfirm = true;
    }

    private async Task HandleRoleDeleteConfirm(bool confirmed)
    {
        showRoleDeleteConfirm = false;
        var role = roleToDelete;
        roleToDelete = null;
        if (!confirmed || role == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/v1/roles/{role.Id}");
            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Role deleted", $"'{role.Name}' was removed.");
                await LoadData();
            }
            else
            {
                // The API's own words: "Cannot delete role 'X' because it has N user(s) assigned."
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete role: {ex.Message}");
        }
    }

