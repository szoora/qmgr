@code {
    private static string GetRoleVariant(string? role) => role?.ToLowerInvariant() switch
    {
        "superadmin" => "danger",
        "operator" => "success",
        "viewer" => "secondary",
        _ => "primary" // admin and anything unrecognized
    };

    private string activeTab = "users";
    private bool isLoading = true;
    private bool isLoadingRoles = true;
    private bool showDialog = false;
    private bool showRoleDialog = false;
    private UserInfo? editingUser;
    private RoleInfo? editingRole;
    private UserFormData formData = new();

    private List<UserInfo> users = new();
    private List<RoleInfo> roles = new();
    private List<RoleOption> roleOptions = new();
    private List<BranchOption> branchOptions = new();
    private List<PermissionInfo> allPermissions = new();
    private Dictionary<string, bool> selectedPermissions = new();

    // Permission check
    private bool canEditRoles = false;
    private bool canCreateUsers = false;
    private bool canEditUsers = false;
    private bool canDeleteUsers = false;
    private bool isSuperAdmin = false;
    private List<OrgOption> orgOptions = new();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private UserInfo? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        // Permission check and data loading moved to OnAfterRenderAsync
        // to ensure tokens are loaded from localStorage first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionSvc.HasPermissionAsync(Permissions.UsersView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canEditRoles = await PermissionSvc.HasPermissionAsync(Permissions.RolesEdit);
            canCreateUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersCreate);
            canEditUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersEdit);
            canDeleteUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersDelete);
            isSuperAdmin = await PermissionSvc.IsSuperAdminAsync();
            if (isSuperAdmin)
            {
                await LoadOrganizations();
            }
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load users from API
            var usersResponse = await Http.GetAsync("api/v1/users?includeInactive=true");
            if (usersResponse.IsSuccessStatusCode)
            {
                var apiUsers = await usersResponse.Content.ReadFromJsonAsync<List<UserDto>>(JsonOptions) ?? new();
                users = apiUsers.Select(u => new UserInfo
                {
                    Id = u.Id,
                    FullName = u.FullName,
                    Username = u.Username,
                    Email = u.Email,
                    Role = u.RoleName,
                    RoleId = u.RoleId,
                    Branch = u.AssignedBranchName,
                    BranchId = u.AssignedBranchId,
                    IsActive = u.IsActive
                }).ToList();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(usersResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }

            // Load branches for dropdown
            var branchesResponse = await Http.GetAsync("api/v1/branches?includeInactive=true");
            if (branchesResponse.IsSuccessStatusCode)
            {
                var apiBranches = await branchesResponse.Content.ReadFromJsonAsync<List<BranchDto>>(JsonOptions) ?? new();
                branchOptions = apiBranches.Select(b => new BranchOption { Id = b.Id, Name = b.Name }).ToList();
            }

            // Load roles for dropdown
            var rolesResponse = await Http.GetAsync("api/v1/roles");
            if (rolesResponse.IsSuccessStatusCode)
            {
                var apiRoles = await rolesResponse.Content.ReadFromJsonAsync<List<RoleApiDto>>(JsonOptions) ?? new();
                roleOptions = apiRoles.Select(r => new RoleOption { Id = r.Id, Name = r.Name }).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Connection Error", $"Failed to connect to API: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

        // Load roles data for the roles tab
        await LoadRolesData();
    }

    // BUG FIX (Phase 58 follow-up): SuperAdmin's own tenant context is the Platform org,
    // which never has branches of its own, so the plain `GET api/v1/branches` call above
    // always came back empty for a SuperAdmin session - the "Add User" Branch dropdown
    // looked broken even though nothing was actually wrong with it. SuperAdmin now picks
    // which tenant the new user belongs to first, and branches are (re)loaded for that
    // specific organization via BranchesController's new `organizationId` override param.
    private async Task LoadOrganizations()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/admin/tenants?pageSize=200");
            if (response.IsSuccessStatusCode)
            {
                var paged = await response.Content.ReadFromJsonAsync<PagedResultDto<TenantSummaryDto>>(JsonOptions);
                orgOptions = paged?.Items.Select(o => new OrgOption { Id = o.Id, Name = o.Name }).ToList() ?? new();
            }
        }
        catch
        {
            orgOptions = new();
        }
    }

    private async Task LoadBranchesForOrganization(Guid? organizationId)
    {
        if (organizationId == null)
        {
            branchOptions = new();
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/v1/branches?includeInactive=true&organizationId={organizationId}");
            if (response.IsSuccessStatusCode)
            {
                var apiBranches = await response.Content.ReadFromJsonAsync<List<BranchDto>>(JsonOptions) ?? new();
                branchOptions = apiBranches.Select(b => new BranchOption { Id = b.Id, Name = b.Name }).ToList();
            }
        }
        catch
        {
            branchOptions = new();
        }
    }

    private async Task OnOrganizationSelected(Guid? organizationId)
    {
        formData.OrganizationId = organizationId;
        formData.BranchId = null;
        await LoadBranchesForOrganization(organizationId);
    }

    private async Task LoadRolesData()
    {
        isLoadingRoles = true;
        try
        {
            // Load roles with permissions
            var rolesResponse = await Http.GetAsync("api/v1/roles");
            if (rolesResponse.IsSuccessStatusCode)
            {
                var apiRoles = await rolesResponse.Content.ReadFromJsonAsync<List<RoleApiDto>>(JsonOptions) ?? new();
                roles = apiRoles.Select(r => new RoleInfo
                {
                    Id = r.Id,
                    Name = r.Name,
                    Code = r.Code,
                    Icon = r.Icon,
                    Color = r.Color,
                    IsSystem = r.IsSystem,
                    UserCount = users.Count(u => u.RoleId == r.Id),
                    Permissions = r.Permissions?.ToList() ?? new()
                }).ToList();
            }

            // Load all available permissions
            var permissionsResponse = await Http.GetAsync("api/v1/roles/permissions");
            if (permissionsResponse.IsSuccessStatusCode)
            {
                var apiPermissions = await permissionsResponse.Content.ReadFromJsonAsync<List<PermissionApiDto>>(JsonOptions) ?? new();
                allPermissions = apiPermissions.Select(p => new PermissionInfo
                {
                    Id = p.Id,
                    Code = p.Code,
                    Name = p.Name,
                    Description = p.Description,
                    Category = p.Category,
                    SortOrder = p.SortOrder
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load roles: {ex.Message}");
        }
        finally
        {
            isLoadingRoles = false;
        }
    }

    private string GetAvatarColor(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "var(--qm-text-muted)";
        var colors = new[] { "var(--qm-primary)", "var(--qm-secondary)", "var(--qm-success)", "var(--qm-warning)", "var(--qm-danger)" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    private void ShowAddDialog()
    {
        editingUser = null;
        formData = new UserFormData
        {
            IsActive = true,
            RoleId = roleOptions.FirstOrDefault(r => r.Name == "Staff")?.Id ?? roleOptions.FirstOrDefault()?.Id ?? Guid.Empty
        };
        if (isSuperAdmin)
        {
            // No organization picked yet - the Branch dropdown starts empty (and disabled,
            // see the modal markup) until one is, instead of silently showing zero branches.
            branchOptions = new();
        }
        showDialog = true;
    }

    private void EditUser(UserInfo user)
    {
        editingUser = user;
        var names = user.FullName?.Split(' ') ?? Array.Empty<string>();
        formData = new UserFormData
        {
            FirstName = names.FirstOrDefault() ?? "",
            LastName = names.Length > 1 ? string.Join(" ", names.Skip(1)) : "",
            Email = user.Email ?? "",
            Username = user.Username ?? "",
            RoleId = user.RoleId,
            BranchId = user.BranchId,
            IsActive = user.IsActive
        };
        showDialog = true;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(formData.Username) || string.IsNullOrWhiteSpace(formData.Email))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Username and email are required");
            return;
        }

        if (editingUser == null && string.IsNullOrWhiteSpace(formData.Password))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Password is required for new users");
            return;
        }

        if (formData.RoleId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please select a role");
            return;
        }

        if (isSuperAdmin && editingUser == null && formData.OrganizationId == null)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please select an organization");
            return;
        }

        try
        {
            HttpResponseMessage response;
            if (editingUser == null)
            {
                var createRequest = new
                {
                    Username = formData.Username,
                    Email = formData.Email,
                    Password = formData.Password,
                    FirstName = formData.FirstName,
                    LastName = formData.LastName,
                    RoleId = formData.RoleId,
                    AssignedBranchId = formData.BranchId,
                    OrganizationId = formData.OrganizationId
                };
                response = await Http.PostAsJsonAsync("api/v1/users", createRequest, JsonOptions);
            }
            else
            {
                var updateRequest = new
                {
                    Email = formData.Email,
                    Password = string.IsNullOrWhiteSpace(formData.Password) ? null : formData.Password,
                    FirstName = formData.FirstName,
                    LastName = formData.LastName,
                    RoleId = formData.RoleId,
                    AssignedBranchId = formData.BranchId
                };
                response = await Http.PutAsJsonAsync($"api/v1/users/{editingUser.Id}", updateRequest, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingUser == null ? "User created" : "User updated");
                showDialog = false;
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save user: {ex.Message}");
        }
    }

    private void DeleteUser(UserInfo user)
    {
        userToDelete = user;
        deleteConfirmMessage = $"Are you sure you want to delete '{user.FullName}'? This action cannot be undone.";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && userToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/v1/users/{userToDelete.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(ToastSeverity.Success, "Success", "User deleted");
                    await LoadData();
                }
                else
                {
                    var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                    NotificationService.Notify(ToastSeverity.Error, title, detail);
                }
            }
            catch (Exception ex)
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete user: {ex.Message}");
            }
        }

        userToDelete = null;
    }

    // Role editing methods
    private void EditRole(RoleInfo role)
    {
        editingRole = role;
        selectedPermissions = allPermissions.ToDictionary(
            p => p.Code,
            p => role.Permissions.Contains(p.Code)
        );
        showRoleDialog = true;
    }

    private void ToggleCategoryPermissions(string category)
    {
        var categoryPermissions = allPermissions.Where(p => p.Category == category).ToList();
        var allSelected = AreAllCategoryPermissionsSelected(category);

        foreach (var perm in categoryPermissions)
        {
            selectedPermissions[perm.Code] = !allSelected;
        }
    }

    private bool AreAllCategoryPermissionsSelected(string category)
    {
        var categoryPermissions = allPermissions.Where(p => p.Category == category);
        return categoryPermissions.All(p => selectedPermissions.GetValueOrDefault(p.Code, false));
    }

    private async Task SaveRolePermissions()
    {
        if (editingRole == null) return;

        try
        {
            var permissionCodes = selectedPermissions
                .Where(kvp => kvp.Value)
                .Select(kvp => kvp.Key)
                .ToList();

            var response = await Http.PutAsJsonAsync(
                $"api/v1/roles/{editingRole.Id}/permissions",
                new { Permissions = permissionCodes },
                JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Role permissions updated");
                showRoleDialog = false;
                await LoadRolesData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save permissions: {ex.Message}");
        }
    }

