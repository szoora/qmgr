    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task SaveRole()
    {
        if (isSavingRole) return;

        var name = roleForm.Name?.Trim() ?? "";
        var code = Slugify(roleForm.Code);
        if (string.IsNullOrWhiteSpace(name))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "A role needs a name.");
            return;
        }
        if (roleBeingEdited == null && string.IsNullOrWhiteSpace(code))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "A role needs a code: lower-case letters, digits and hyphens.");
            return;
        }

        isSavingRole = true;
        try
        {
            if (roleBeingEdited == null)
            {
                var response = await Http.PostAsJsonAsync("api/v1/roles", new
                {
                    Code = code,
                    Name = name,
                    Description = NullIfBlank(roleForm.Description),
                    Color = NullIfBlank(roleForm.Color),
                    Icon = NullIfBlank(roleForm.Icon),
                    SortOrder = roleForm.SortOrder,
                    PermissionIds = SelectedPermissionIds(),
                    DataScope = roleForm.DataScope,
                    StaffScope = roleForm.StaffScope
                }, JsonOptions);

                if (!response.IsSuccessStatusCode)
                {
                    var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                    NotificationService.Notify(ToastSeverity.Error, title, detail);
                    return;
                }

                NotificationService.Notify(ToastSeverity.Success, "Role created", $"'{name}' is ready to assign.");
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"api/v1/roles/{roleBeingEdited.Id}", new
                {
                    Name = name,
                    Description = NullIfBlank(roleForm.Description),
                    Color = NullIfBlank(roleForm.Color),
                    Icon = NullIfBlank(roleForm.Icon),
                    SortOrder = roleForm.SortOrder,
                    DataScope = roleForm.DataScope,
                    StaffScope = roleForm.StaffScope
                }, JsonOptions);

                if (!response.IsSuccessStatusCode)
                {
                    var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                    NotificationService.Notify(ToastSeverity.Error, title, detail);
                    return;
                }

                // Permissions travel separately, and only when the set actually changed: the
                // permissions endpoint replaces the whole set and invalidates every holder's cache.
                var wanted = allPermissions.Where(p => selectedPermissions.GetValueOrDefault(p.Code, false)).Select(p => p.Code).ToHashSet();
                var current = roleBeingEdited.Permissions.ToHashSet();
                if (!wanted.SetEquals(current))
                {
                    var permResponse = await Http.PutAsJsonAsync(
                        $"api/v1/roles/{roleBeingEdited.Id}/permissions",
                        new { PermissionIds = SelectedPermissionIds() },
                        JsonOptions);

                    if (!permResponse.IsSuccessStatusCode)
                    {
                        // The role itself DID save; say so rather than reporting one failure for two writes.
                        var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(permResponse);
                        NotificationService.Notify(ToastSeverity.Warning, "Role saved, permissions not", $"{title}: {detail}");
                        showRoleEditor = false;
                        await LoadData();
                        return;
                    }
                }

                NotificationService.Notify(ToastSeverity.Success, "Role updated", $"'{name}' saved.");
            }

            showRoleEditor = false;
            // Reload the lot: the Add User dialog's role dropdown is fed from the same call.
            await LoadData();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save role: {ex.Message}");
        }
        finally
        {
            isSavingRole = false;
        }
    }

    private async Task ToggleRole(RoleInfo role)
    {
        if (role.IsSystem) return;
        try
        {
            var response = await Http.PatchAsync($"api/v1/roles/{role.Id}/toggle", null);
            if (response.IsSuccessStatusCode)
