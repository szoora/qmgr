@page "/admin/users"
@inject HttpClient Http
@inject IToastService NotificationService
@inject JsonSerializerOptions JsonOptions
@inject IPermissionService PermissionSvc
@inject NavigationManager Navigation
@inherits BranchAwareComponentBase
@inject IStudentApiService StudentApi
@inject IClassTeacherApiService ClassTeacherApi
@using System.Text.Json
@using QMgr.Web.Services
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Shared.UI

<PageTitle>Users & Roles - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Users & Roles</h1>
            <p class="subtitle">Manage system users and their permissions</p>
        </div>
        <div class="header-actions">
            @* Gated on the same read this page already needed to render at all. *@
            <QDataExport TItem="UserInfo"
                         Title="Users"
                         FileStem="users"
                         Subtitle="@ExportSubtitle"
                         Columns="@UserExportColumns"
                         RowProvider="@ProvideExportRowsAsync"
                         Disabled="@(!users.Any())"
                         DisabledReason="There are no users to export." />
            @if (canCreateUsers)
            {
                <QButton Text="Add User" Icon="person-plus-fill" Variant="primary" OnClick="@ShowAddDialog" />
            }
        </div>
    </div>

    <QTabs Tabs="@PageTabs" @bind-ActiveKey="activeTab" AriaLabel="Users and roles" IdPrefix="users-tab" />

    @if (activeTab == "users")
    {
        @if (isLoading)
        {
            <div class="loading-container">
                <QSpinner Size="lg" />
            </div>
        }
        else
        {
            @* Staff arrive and leave in cohorts at term boundaries, which is the whole reason
               this is a batch rather than a row action. Radzen's grid already does multi-select,
               so the selection needs no new affordance. *@
            @if (selectedUsers?.Any() == true && canEditUsers)
            {
                <div class="batch-bar">
                    <span class="batch-bar-count"><QIcon Name="check2-square" /> <strong>@selectedUsers.Count.ToString("N0")</strong> selected</span>
                    <QButton Text="Enable" Icon="person-check" Size="sm" Variant="secondary" OnClick="@(() => RunUserActive(true))" />
                    <QButton Text="Disable" Icon="person-slash" Size="sm" Variant="secondary" OnClick="@(() => RunUserActive(false))"
                             Title="They can no longer sign in. Their records and history stay." />
                    <div class="dropdown">
                        <QButton Text="Change role" Icon="shield" Size="sm" Variant="secondary" data-bs-toggle="dropdown" aria-expanded="false" />
                        <ul class="dropdown-menu batch-menu">
                            @foreach (var r in roles)
                            {
                                <li><button type="button" class="dropdown-item" @onclick="@(() => RunUserRole(r.Id))">@r.Name</button></li>
                            }
                        </ul>
                    </div>
                    <button type="button" class="batch-clear" @onclick="@(() => selectedUsers = null)">Clear selection</button>
                </div>
            }

            <div class="data-table-container">
                <RadzenDataGrid Data="@users" TItem="UserInfo" AllowFiltering="true" AllowSorting="true" AllowPaging="true" PageSize="10"
                                SelectionMode="Radzen.DataGridSelectionMode.Multiple" @bind-Value="@selectedUsers">
                    <Columns>
                        <RadzenDataGridColumn TItem="UserInfo" Property="FullName" Title="Name">
                            <Template Context="user">
                                <div class="user-cell">
                                    <QAvatar Name="@user.FullName" Title="@user.FullName" />
                                    <div class="user-info">
                                        <span class="user-name">@user.FullName</span>
                                        <span class="user-email">@user.Email</span>
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserInfo" Property="Username" Title="Username" Width="150px" />
                        <RadzenDataGridColumn TItem="UserInfo" Property="Role" Title="Role" Width="120px">
                            <Template Context="user">
                                <QBadge Variant="@GetRoleVariant(user.Role)" Text="@user.Role" Size="sm" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserInfo" Property="Branch" Title="Branch" Width="150px" />
                        <RadzenDataGridColumn TItem="UserInfo" Property="IsActive" Title="Status" Width="100px">
                            <Template Context="user">
                                <QBadge Variant="@(user.IsActive ? "success" : "secondary")"
                                        Text="@(user.IsActive ? "Active" : "Inactive")" Size="sm" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="UserInfo" Title="Actions" Width="100px" Sortable="false" Filterable="false">
                            <Template Context="user">
                                @if (canEditUsers)
                                {
                                    <QButton Icon="pencil-fill" Variant="ghost" Size="sm" OnClick="@(() => EditUser(user))" />
                                }
                                @if (canDeleteUsers)
                                {
                                    <QButton Icon="trash-fill" Variant="ghost" Size="sm" OnClick="@(() => DeleteUser(user))" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
    }
    else
    {
        @if (isLoadingRoles)
        {
            <div class="loading-container">
                <QSpinner Size="lg" />
            </div>
        }
        else
        {
            @* ── The role editor Role.DataScope's doc comment promised (plan §5.4) ────────────────
               System roles are fixed by the seeder: the API refuses rename, scope, toggle, delete
               AND permission changes on them (400), so a system card offers only a read-only view.
               A custom role gets the full set. *@
            <div class="roles-toolbar">
                <p class="roles-intro">
                    A role is a set of permissions plus two row scopes: which <strong>students</strong> and which
                    <strong>staff</strong> its holders may see. System roles are fixed; create a custom role to change anything.
                </p>
                @if (canCreateRoles)
                {
                    <QButton Text="New Role" Icon="plus-lg" Variant="primary" Size="sm" OnClick="@ShowCreateRoleDialog" />
                }
            </div>
            <div class="roles-grid">
                @foreach (var role in roles)
                {
                    <div class="role-card @(role.IsActive ? "" : "role-card--inactive")">
                        <div class="role-header">
                            <div class="role-icon" style="background: @(string.IsNullOrWhiteSpace(role.Color) ? "var(--qm-text-muted)" : role.Color)">
                                <QIcon Name="@(string.IsNullOrWhiteSpace(role.Icon) ? "shield" : role.Icon)" />
                            </div>
                            <div class="role-title">
                                <h4>@role.Name</h4>
                                <span class="role-code">@role.Code</span>
                                <span>@role.UserCount @(role.UserCount == 1 ? "user" : "users")</span>
                            </div>
                            <div class="role-badges">
                                @if (role.IsSystem)
                                {
                                    <span class="system-badge">System</span>
                                }
                                @if (!role.IsActive)
                                {
                                    <span class="inactive-badge">Inactive</span>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(role.Description))
                        {
                            <p class="role-description">@role.Description</p>
                        }
                        @* Scope chips only when a scope is narrower than the whole organization: the
                           default is silent so a card that says nothing means "sees everything the
                           permissions allow", which is what every role meant before scopes existed. *@
                        @if (role.DataScope != RoleDataScope.Organization || role.StaffScope != StaffDataScope.Organization)
                        {
                            <div class="role-scopes">
                                @if (role.DataScope != RoleDataScope.Organization)
                                {
                                    <span class="scope-chip" title="@StudentScopeHelp(role.DataScope)">
                                        <QIcon Name="mortarboard-fill" /> Students: @StudentScopeLabel(role.DataScope)
                                    </span>
                                }
                                @if (role.StaffScope != StaffDataScope.Organization)
                                {
                                    <span class="scope-chip" title="@StaffScopeHelp(role.StaffScope)">
                                        <QIcon Name="people-fill" /> Staff: @StaffScopeLabel(role.StaffScope)
                                    </span>
                                }
                            </div>
                        }
                        <div class="role-permissions">
                            <h5>Permissions (@role.Permissions.Count)</h5>
                            <ul>
                                @foreach (var perm in role.Permissions.Take(5))
                                {
                                    <li><QIcon Name="check-lg" /> @perm</li>
                                }
                                @if (role.Permissions.Count > 5)
                                {
                                    <li class="more">+@(role.Permissions.Count - 5) more</li>
                                }
                            </ul>
                        </div>
                        <div class="role-actions">
                            @if (role.IsSystem)
                            {
                                <QButton Text="View Permissions" Icon="shield-lock-fill" Variant="secondary" Size="sm" OnClick="@(() => EditRole(role))" />
                            }
                            else
                            {
                                @if (canEditRoles)
                                {
                                    <QButton Text="Edit" Icon="pencil-fill" Variant="secondary" Size="sm" OnClick="@(() => ShowEditRoleDialog(role))" />
                                    <QButton Text="Permissions" Icon="shield-lock-fill" Variant="secondary" Size="sm" OnClick="@(() => EditRole(role))" />
                                    <QButton Text="@(role.IsActive ? "Deactivate" : "Activate")"
                                             Icon="@(role.IsActive ? "pause-circle" : "play-circle")"
                                             Variant="ghost" Size="sm" OnClick="@(() => ToggleRole(role))" />
                                }
                                @if (canDeleteRoles)
                                {
                                    <QButton Text="Delete" Icon="trash-fill" Variant="ghost" Size="sm" Class="role-delete-btn" OnClick="@(() => DeleteRole(role))" />
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<QModal @bind-Visible="showDialog" Title="@(editingUser == null ? "Add User" : "Edit User")" Size="md">
    <ChildContent>
        <div class="form-row">
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@formData.FirstName" Label="First Name *" />
            </div>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@formData.LastName" Label="Last Name *" />
            </div>
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Email" Type="email" Label="Email *" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.Username" Label="Username *" />
        </div>
        @if (editingUser == null)
        {
            <div class="form-group">
                <QInput TValue="string" @bind-Value="@formData.Password" Type="password" Label="Password *" />
            </div>
        }
        @if (isSuperAdmin && editingUser == null)
        {
            <div class="form-group">
                <QSelect TValue="Guid?" TItem="OrgOption" Value="@formData.OrganizationId" ValueChanged="@OnOrganizationSelected" Items="@orgOptions"
                         ValueSelector="@(o => (Guid?)o.Id)" TextSelector="@(o => o.Name)" Label="Organization *"
                         HelperText="Platform Admin accounts have no branches of their own - pick the tenant this user belongs to." />
            </div>
        }
        <div class="form-row">
            <div class="form-group">
                <QSelect TValue="Guid" TItem="RoleOption" Value="@formData.RoleId" ValueChanged="@OnRoleSelected" Items="@roleOptions"
                         ValueSelector="@(r => r.Id)" TextSelector="@(r => r.Name)" Label="Role *" />
            </div>
            <div class="form-group">
                <QSelect TValue="Guid?" TItem="BranchOption" Value="@formData.BranchId" ValueChanged="@OnBranchSelected" Items="@branchOptions"
                         ValueSelector="@(b => (Guid?)b.Id)" TextSelector="@(b => b.Name)" Label="Branch" AllowClear="true"
                         Disabled="@(isSuperAdmin && editingUser == null && formData.OrganizationId == null)"
                         Placeholder="@(isSuperAdmin && editingUser == null && formData.OrganizationId == null ? "Select an organization first" : "Select...")" />
            </div>
        </div>

        @* ── Classes, only for the Class Teacher role ─────────────────────────────────────
           A class teacher's role gives them permissions; their CLASS ASSIGNMENTS are what give
           them any rows at all. Creating one without a class produced an account that opened to
           an empty app, and the only thing that said so was a warning on a different page. *@
        @if (IsClassTeacherRoleSelected)
        {
            <div class="form-group">
                @if (!canManageClassTeachers)
                {
                    <div class="us-ct-warn">
                        <QIcon Name="info-circle-fill" />
                        <span>
                            This role sees only the students in its assigned classes. You do not hold
                            <strong>Manage Class Teachers</strong>, so the classes must be assigned for you on the
                            <strong>Class Teachers</strong> page — until then this account sees no students at all.
                        </span>
                    </div>
                }
                else if (formData.BranchId == null)
                {
                    <div class="us-ct-warn">
                        <QIcon Name="info-circle-fill" />
                        <span>Pick a branch above to choose classes — an assignment belongs to a class in one branch.</span>
                    </div>
                }
                else if (isLoadingClasses)
                {
                    <div class="us-ct-warn"><QSpinner Size="sm" /><span>Loading this branch's classes...</span></div>
                }
                else if (!classOptions.Any())
                {
                    <div class="us-ct-warn">
                        <QIcon Name="exclamation-triangle-fill" />
                        <span>
                            This branch has no classes configured yet. Add them under
                            <strong>Student Roster → Lists</strong> first, then assign them here.
                        </span>
                    </div>
                }
                else
                {
                    <QMultiSelect TValue="string" TItem="ClassOption"
                                  SelectedValues="@selectedClasses"
                                  SelectedValuesChanged="@(v => selectedClasses = v.ToList())"
                                  Items="@classOptions"
                                  ValueSelector="@(c => c.Name)"
                                  TextSelector="@(c => c.Label)"
                                  Label="Classes this teacher holds"
                                  Placeholder="Choose one or more classes" />
                    <p class="form-hint">
                        Saved as class-teacher assignments. A class that already has a class teacher is
                        skipped with a note — one class has one class teacher, and an assistant is added
                        from the Class Teachers page.
                        @if (selectedClasses.Count == 0)
                        {
                            <strong> With none chosen, this account will see no students at all.</strong>
                        }
                    </p>
                }
            </div>
        }

        <div class="form-group">
            <QCheckbox @bind-Value="@formData.IsActive" Label="User is active" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showDialog = false)" />
        <QButton Text="@(editingUser == null ? "Create" : "Save")" Icon="@(editingUser == null ? "person-plus-fill" : "check-lg")" Variant="primary" OnClick="@SaveUser" />
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete User"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

<!-- Role Permissions Editor Dialog (read-only for a system role: the API refuses the write) -->
<QModal @bind-Visible="showRoleDialog" Title="@($"{(editingRole?.IsSystem == true ? "Permissions" : "Edit Permissions")}: {editingRole?.Name}")" Size="lg">
    <ChildContent>
        @if (editingRole != null)
        {
            <div class="role-editor">
                <div class="role-info-header">
                    <div class="role-icon" style="background: @(string.IsNullOrWhiteSpace(editingRole.Color) ? "var(--qm-text-muted)" : editingRole.Color)">
                        <QIcon Name="@(string.IsNullOrWhiteSpace(editingRole.Icon) ? "shield" : editingRole.Icon)" />
                    </div>
                    <div>
                        <h4>@editingRole.Name</h4>
                        <span class="role-code">@editingRole.Code</span>
                    </div>
                </div>

                @if (editingRole.IsSystem)
                {
                    <div class="us-ct-warn">
                        <QIcon Name="info-circle-fill" />
                        <span>System role permissions cannot be modified. Create a custom role instead.</span>
                    </div>
                }

                @PermissionEditor(editingRole.IsSystem)
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="@(editingRole?.IsSystem == true ? "Close" : "Cancel")" Icon="x-lg" Variant="ghost" OnClick="@(() => showRoleDialog = false)" />
        @if (editingRole?.IsSystem != true)
        {
            <QButton Text="Save Permissions" Icon="check-lg" Variant="primary" OnClick="@SaveRolePermissions" Loading="@isSavingRole" />
        }
    </FooterContent>
</QModal>

<!-- Role Editor Dialog: create, or edit a custom role's identity and its two scopes -->
<QModal @bind-Visible="showRoleEditor" Title="@(roleBeingEdited == null ? "New Role" : $"Edit Role: {roleBeingEdited.Name}")" Size="lg">
    <ChildContent>
        <div class="role-editor">
            <div class="form-row">
                <div class="form-group">
                    @* @bind:after, never a separate @oninput: the slug follows the name while the code is untouched. *@
                    <QInput TValue="string" @bind-Value="roleForm.Name" @bind-Value:after="SyncCodeFromName"
                            Label="Name *" Placeholder="e.g. Deputy Head Teacher" MaxLength="100" />
                </div>
                <div class="form-group">
                    <QInput TValue="string" @bind-Value="roleForm.Code" @bind-Value:after="MarkCodeEdited"
                            Label="Code *" Placeholder="deputy-head-teacher" MaxLength="50"
                            ReadOnly="@(roleBeingEdited != null)"
                            HelperText="@(roleBeingEdited != null
                                ? "A code is permanent: permission checks and reports refer to it."
                                : "Lower-case letters, digits and hyphens. Follows the name until you edit it.")" />
                </div>
            </div>

            <div class="form-group">
                <QInput TValue="string" @bind-Value="roleForm.Description" Type="textarea" Rows="2" Label="Description"
                        Placeholder="Who holds this role and what it is for" MaxLength="500" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Colour</label>
                    <div class="colour-swatches">
                        @foreach (var preset in RoleColourPresets)
                        {
                            <button type="button" class="colour-swatch @(IsSelectedColour(preset) ? "selected" : "")"
                                    style="background: @preset" title="@preset" aria-label="@($"Use colour {preset}")"
                                    @onclick="@(() => roleForm.Color = preset)">
                                @if (IsSelectedColour(preset))
                                {
                                    <QIcon Name="check-lg" />
                                }
                            </button>
                        }
                    </div>
                    <QInput TValue="string" @bind-Value="roleForm.Color" Placeholder="#7a2847" MaxLength="30"
                            HelperText="A preset above, or any CSS colour." />
                </div>
                <div class="form-group">
                    <label>Icon</label>
                    <div class="icon-preview-row">
                        <div class="role-icon" style="background: @(string.IsNullOrWhiteSpace(roleForm.Color) ? "var(--qm-text-muted)" : roleForm.Color)">
                            <QIcon Name="@(string.IsNullOrWhiteSpace(roleForm.Icon) ? "shield" : roleForm.Icon.Trim())" />
                        </div>
                        <div class="icon-preview-input">
                            <QInput TValue="string" @bind-Value="roleForm.Icon" Placeholder="shield" MaxLength="50"
                                    HelperText="A Bootstrap Icons name, e.g. mortarboard-fill, people-fill, clipboard-check." />
                        </div>
                    </div>
                    <QInput TValue="int" @bind-Value="roleForm.SortOrder" Type="number" Min="0" Max="10000" Label="Sort order"
                            HelperText="Lower sorts first in role lists. System roles use 1–99." />
                </div>
            </div>

            @* ── The two row scopes. Permissions gate ACTIONS; these gate ROWS (CLAUDE.md, RBAC). ── *@
            <div class="scope-section">
                <h5 class="scope-heading"><QIcon Name="funnel-fill" /> Row scopes</h5>
                <div class="form-row">
                    <div class="form-group">
                        <QSelect TValue="RoleDataScope" TItem="StudentScopeOption" @bind-Value="roleForm.DataScope"
                                 Items="@StudentScopeOptions" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Text)"
                                 Label="Student scope" />
                        <p class="scope-help">
                            <strong>Organization</strong> — sees every student the permissions allow.
                            <strong>Assigned classes</strong> — sees only students in classes this role's holders are
                            assigned to; fails closed, so a holder with no class sees no students at all.
                        </p>
                    </div>
                    <div class="form-group">
                        <QSelect TValue="StaffDataScope" TItem="StaffScopeOption" @bind-Value="roleForm.StaffScope"
                                 Items="@StaffScopeOptions" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Text)"
                                 Label="Staff scope" />
                        <p class="scope-help">
                            <strong>Organization</strong> — sees every staff member the permissions allow.
                            <strong>Assigned departments</strong> — heads of department: members of the departments the
                            holder heads or deputises; fails closed.
                            <strong>Direct reports</strong> — line managers: staff whose line manager is the holder; fails closed.
                            <strong>Self only</strong> — sees nobody but themselves. Teachers and support staff.
                            A person always reads their own file regardless.
                        </p>
                    </div>
                </div>
            </div>

            <div class="scope-section">
                <h5 class="scope-heading"><QIcon Name="shield-lock-fill" /> Permissions (@selectedPermissions.Count(kvp => kvp.Value))</h5>
                @PermissionEditor(false)
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@(() => showRoleEditor = false)" />
        <QButton Text="@(roleBeingEdited == null ? "Create Role" : "Save Changes")"
                 Icon="@(roleBeingEdited == null ? "plus-lg" : "check-lg")"
                 Variant="primary" OnClick="@SaveRole" Loading="@isSavingRole" />
    </FooterContent>
</QModal>

<!-- Role Delete Confirmation -->
<ConfirmDialog
    IsVisible="@showRoleDeleteConfirm"
    Title="Delete Role"
    Message="@roleDeleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleRoleDeleteConfirm" />

<style>

    .batch-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; background: var(--qm-primary-light); border: 1px solid var(--qm-primary); border-radius: var(--qm-radius-md); padding: 10px 14px; margin-bottom: 14px; }
    .batch-bar-count { display: flex; align-items: center; gap: 7px; font-size: 14px; }
    .batch-bar-count strong { font-variant-numeric: tabular-nums; }
    .batch-bar .dropdown { display: inline-flex; }
    .batch-menu { min-width: 190px; padding: 6px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); background: var(--qm-bg-card); box-shadow: var(--qm-shadow-md); }
    .batch-menu .dropdown-item { display: block; width: 100%; padding: 8px 10px; border: none; background: none; border-radius: var(--qm-radius-sm); font-size: 13px; text-align: left; color: var(--qm-text-primary); cursor: pointer; }
    .batch-menu .dropdown-item:hover { background: var(--qm-primary-light); }
    .batch-clear { margin-left: auto; background: none; border: none; padding: 2px 6px; cursor: pointer; font: inherit; font-size: 13px; color: var(--qm-text-muted); text-decoration: underline; }

    .admin-page { padding: 0; }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-content h1 { margin: 0 0 4px; color: var(--qm-text-primary); }
    .subtitle { margin: 0; color: var(--qm-text-muted); font-size: 14px; }

    .loading-container {
        display: flex;
        justify-content: center;
        padding: 60px;
    }

    .data-table-container {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
        overflow: hidden;
    }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Radzen's column filter icons are ~20px buttons, too small to hit with a thumb. On a phone they
       get the 40px target the Staff pages use (sweep warning, 2026-09-16). */
    @@media (max-width: 640px) {
        .data-table-container .rz-grid-filter-icon {
            min-width: 40px;
            min-height: 40px;
        }
    }

    .user-info { display: flex; flex-direction: column; }
    .user-name { font-weight: 500; color: var(--qm-text-primary); }
    .user-email { font-size: 12px; color: var(--qm-text-muted); }

    .roles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
    }

    .role-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
    }

    .role-header {
        display: flex;
        /* Without this the row stretches its children: the System badge, which carries its own
           margin-left:auto, grew to the full header height and rendered as a tall block behind
           its text. Reported from production 2026-09-18. */
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 16px;
