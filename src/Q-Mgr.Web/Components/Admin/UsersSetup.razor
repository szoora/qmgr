    /// <summary>
    /// The category-grouped permission checklist, shared by the permissions modal and the role
    /// editor so there is one copy of it. Read-only for a system role, since the API refuses the write.
    /// </summary>
    private RenderFragment PermissionEditor(bool readOnly) => __builder =>
    {
        <div class="permissions-editor">
            @foreach (var category in allPermissions.GroupBy(p => p.Category).OrderBy(g => g.Key))
            {
                <div class="permission-category">
                    <h5 class="category-header">
                        <span>@category.Key</span>
                        @if (!readOnly)
                        {
                            <button type="button" class="select-all-btn" @onclick="@(() => ToggleCategoryPermissions(category.Key))">
                                @(AreAllCategoryPermissionsSelected(category.Key) ? "Deselect All" : "Select All")
                            </button>
                        }
                    </h5>
                    <div class="permissions-list">
                        @foreach (var permission in category.OrderBy(p => p.SortOrder))
                        {
                            <div class="permission-item">
                                <QCheckbox @bind-Value="@selectedPermissions[permission.Code]"
                                           Label="@permission.Name"
                                           Disabled="@readOnly" />
                                @if (!string.IsNullOrEmpty(permission.Description))
                                {
                                    <span class="permission-description">@permission.Description</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    };

