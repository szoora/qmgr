    private bool AreAllCategoryPermissionsSelected(string category)
    {
        var categoryPermissions = allPermissions.Where(p => p.Category == category);
        return categoryPermissions.All(p => selectedPermissions.GetValueOrDefault(p.Code, false));
    }

    /// <summary>
    /// The permission ids currently ticked. UpdateRolePermissionsRequest takes <c>PermissionIds</c>
    /// (GUIDs); this used to post <c>{ Permissions: [codes] }</c>, which deserialized to an empty
    /// list and would have wiped every permission off the role on Save.
    /// </summary>
    private List<Guid> SelectedPermissionIds() => allPermissions
        .Where(p => selectedPermissions.GetValueOrDefault(p.Code, false))
        .Select(p => p.Id)
        .Distinct()
        .ToList();

