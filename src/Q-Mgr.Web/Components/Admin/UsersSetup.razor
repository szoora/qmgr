<QBatchDialog @ref="batchDialog" BranchId="@BranchState.CurrentBranchId" OnQueued="@OnBatchQueued" />

@code {
    private static string GetRoleVariant(string? role) => role?.ToLowerInvariant() switch
    {
        "superadmin" => "danger",
        "operator" => "success",
        "viewer" => "secondary",
        _ => "primary" // admin and anything unrecognized
    };

    private string activeTab = "users";

    private static readonly IReadOnlyList<QTab> PageTabs = new List<QTab>
    {
        new("users", "Users", "people-fill"),
        new("roles", "Roles", "shield-lock-fill")
    };
    private bool isLoading = true;
    private bool isLoadingRoles = true;
    private bool showDialog = false;
    private bool showRoleDialog = false;
    private UserInfo? editingUser;
    private RoleInfo? editingRole;
    private UserFormData formData = new();

    // ---- Batch: staff accounts ---------------------------------------------------------------
    //
    // Radzen's grid already does multi-select, so this needed no new selection affordance —
    // only the bar and the two operations. Both go through the same resolver, preview and undo
    // every other list uses.

    // ---- Export -----------------------------------------------------------------------------

    private string ExportSubtitle => $"{users.Count:N0} user(s) · {QDateFormat.D(DateTime.Now)}";

    private static readonly List<ExportColumn<UserInfo>> UserExportColumns = new()
    {
        new("Username", u => u.Username, ExportType.Text, 20),
        new("Full name", u => u.FullName, ExportType.Text, 26),
        new("Email", u => u.Email, ExportType.Text, 30),
        new("Role", u => u.Role, ExportType.Text, 20),
        new("Branch", u => u.Branch, ExportType.Text, 24),
        new("Active", u => u.IsActive, ExportType.Bool, 10)
    };

    private Task<ExportRows<UserInfo>> ProvideExportRowsAsync() =>
        Task.FromResult(new ExportRows<UserInfo>(users, false));

    private IList<UserInfo>? selectedUsers;
    private QBatchDialog? batchDialog;

    private async Task RunUserActive(bool enable)
    {
        if (batchDialog == null || selectedUsers == null) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.SetUserActive,
            Ids = selectedUsers.Select(u => u.Id).ToList(),
            Value = enable ? "true" : "false"
        });
    }

    private async Task RunUserRole(Guid roleId)
    {
        if (batchDialog == null || selectedUsers == null) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.SetUserRole,
            Ids = selectedUsers.Select(u => u.Id).ToList(),
            TargetUserId = roleId
        });
    }

    private async Task OnBatchQueued(BatchAcceptedDto accepted)
    {
        selectedUsers = null;
        NotificationService.Notify(ToastSeverity.Info, "Running", accepted.Summary, 6000);
        await Task.Delay(1500);
        await LoadData();
    }

    private List<UserInfo> users = new();
    private List<RoleInfo> roles = new();
    private List<RoleOption> roleOptions = new();
    private List<BranchOption> branchOptions = new();
    private List<PermissionInfo> allPermissions = new();
    private Dictionary<string, bool> selectedPermissions = new();

    // Permission check
    private bool canEditRoles = false;
    private bool canCreateRoles = false;
    private bool canDeleteRoles = false;
    private bool canCreateUsers = false;
    private bool canEditUsers = false;
    private bool canDeleteUsers = false;
    private bool isSuperAdmin = false;
    private List<OrgOption> orgOptions = new();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private UserInfo? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        // Permission check and data loading moved to OnAfterRenderAsync
        // to ensure tokens are loaded from localStorage first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionSvc.HasPermissionAsync(Permissions.UsersView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canEditRoles = await PermissionSvc.HasPermissionAsync(Permissions.RolesEdit);
            canCreateRoles = await PermissionSvc.HasPermissionAsync(Permissions.RolesCreate);
            canDeleteRoles = await PermissionSvc.HasPermissionAsync(Permissions.RolesDelete);
            canCreateUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersCreate);
            canEditUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersEdit);
            canDeleteUsers = await PermissionSvc.HasPermissionAsync(Permissions.UsersDelete);
            // Deliberately a SEPARATE permission from users.edit: the API keeps
            // classes.teachers.manage from implying account administration, so this form must too.
            canManageClassTeachers = await PermissionSvc.HasPermissionAsync(Permissions.ClassTeachersManage);
            isSuperAdmin = await PermissionSvc.IsSuperAdminAsync();

            await BranchState.InitializeAsync();
            TrackBranch();

            if (isSuperAdmin)
            {
                await LoadOrganizations();
            }
            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load users from API
            var usersResponse = await Http.GetAsync("api/v1/users?includeInactive=true");
            if (usersResponse.IsSuccessStatusCode)
            {
                var apiUsers = await usersResponse.Content.ReadFromJsonAsync<List<UserDto>>(JsonOptions) ?? new();
                users = apiUsers.Select(u => new UserInfo
                {
                    Id = u.Id,
                    FullName = u.FullName,
                    Username = u.Username,
                    Email = u.Email,
                    Role = u.RoleName,
                    RoleId = u.RoleId,
                    Branch = u.AssignedBranchName,
                    BranchId = u.AssignedBranchId,
                    IsActive = u.IsActive
                }).ToList();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(usersResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }

            // Load branches for dropdown
            var branchesResponse = await Http.GetAsync("api/v1/branches?includeInactive=true");
            if (branchesResponse.IsSuccessStatusCode)
            {
                var apiBranches = await branchesResponse.Content.ReadFromJsonAsync<List<BranchDto>>(JsonOptions) ?? new();
                branchOptions = apiBranches.Select(b => new BranchOption { Id = b.Id, Name = b.Name }).ToList();
            }

            // Load roles for dropdown
            var rolesResponse = await Http.GetAsync("api/v1/roles");
            if (rolesResponse.IsSuccessStatusCode)
            {
                var apiRoles = await rolesResponse.Content.ReadFromJsonAsync<List<RoleApiDto>>(JsonOptions) ?? new();
                roleOptions = apiRoles.Select(r => new RoleOption { Id = r.Id, Name = r.Name, Code = r.Code }).ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Connection Error", $"Failed to connect to API: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }

        // Load roles data for the roles tab
        await LoadRolesData();
    }

    // BUG FIX (Phase 58 follow-up): SuperAdmin's own tenant context is the Platform org,
    // which never has branches of its own, so the plain `GET api/v1/branches` call above
    // always came back empty for a SuperAdmin session - the "Add User" Branch dropdown
    // looked broken even though nothing was actually wrong with it. SuperAdmin now picks
    // which tenant the new user belongs to first, and branches are (re)loaded for that
    // specific organization via BranchesController's new `organizationId` override param.
    private async Task LoadOrganizations()
    {
        try
        {
            var response = await Http.GetAsync("api/v1/admin/tenants?pageSize=200");
            if (response.IsSuccessStatusCode)
            {
                var paged = await response.Content.ReadFromJsonAsync<PagedResultDto<TenantSummaryDto>>(JsonOptions);
                orgOptions = paged?.Items.Select(o => new OrgOption { Id = o.Id, Name = o.Name }).ToList() ?? new();
            }
            else
            {
                // An empty picker reads as "this account has no organizations", which is a
                // different and much more alarming statement than "the list failed to load".
                NotificationService.Notify(ToastSeverity.Error, "Could not load organizations",
                    await ApiErrorService.GetErrorMessageAsync(response, "The organization list could not be loaded."));
            }
        }
        catch
        {
            orgOptions = new();
        }
    }

    private async Task LoadBranchesForOrganization(Guid? organizationId)
    {
        if (organizationId == null)
        {
            branchOptions = new();
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/v1/branches?includeInactive=true&organizationId={organizationId}");
            if (response.IsSuccessStatusCode)
            {
                var apiBranches = await response.Content.ReadFromJsonAsync<List<BranchDto>>(JsonOptions) ?? new();
                branchOptions = apiBranches.Select(b => new BranchOption { Id = b.Id, Name = b.Name }).ToList();
            }
            else
            {
                // Same reasoning as LoadOrganizations: an empty branch picker is a claim about
                // the organization, not an admission that the request failed.
                NotificationService.Notify(ToastSeverity.Error, "Could not load branches",
                    await ApiErrorService.GetErrorMessageAsync(response, "The branch list could not be loaded."));
            }
        }
        catch
        {
            branchOptions = new();
        }
    }

    private async Task OnOrganizationSelected(Guid? organizationId)
    {
        formData.OrganizationId = organizationId;
        formData.BranchId = null;
        await LoadBranchesForOrganization(organizationId);
    }

    private async Task LoadRolesData()
    {
        isLoadingRoles = true;
        try
        {
            // The list endpoint returns RoleListDto — counts and scopes, no permission codes — so
            // the codes and sort order come from GET roles/{id} per role. Until 2026-09-16 this
            // read a `Permissions` list the list shape never had, so every card said
            // "Permissions (0)" and the editor opened with nothing ticked. Inactive roles are
            // included here so a deactivated custom role can be found and reactivated.
            var rolesResponse = await Http.GetAsync("api/v1/roles?includeInactive=true");
            if (rolesResponse.IsSuccessStatusCode)
            {
                var apiRoles = await rolesResponse.Content.ReadFromJsonAsync<List<RoleApiDto>>(JsonOptions) ?? new();
                var loaded = new List<RoleInfo>();
                foreach (var r in apiRoles)
                {
                    var detail = await LoadRoleDetailAsync(r.Id);
                    loaded.Add(new RoleInfo
                    {
                        Id = r.Id,
                        Name = r.Name,
                        Code = r.Code,
                        Description = r.Description,
                        Icon = r.Icon,
                        Color = r.Color,
                        IsSystem = r.IsSystem,
                        IsActive = r.IsActive,
                        DataScope = r.DataScope,
                        StaffScope = r.StaffScope,
                        SortOrder = detail?.SortOrder ?? 100,
                        // Counted over the users list this page already holds (inactive included),
                        // because that is the count DELETE refuses on — the API's UserCount is active only.
                        UserCount = users.Count(u => u.RoleId == r.Id),
                        Permissions = detail?.Permissions ?? new()
                    });
                }
                roles = loaded;
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(rolesResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }

            // GET roles/permissions is GROUPED by category ({ Category, Permissions[] }); reading it
            // as a flat list gave every item an empty Code, and ToDictionary over those threw the
            // moment the editor opened. The API already orders within a category by SortOrder, so
            // the arrival index stands in for it.
            var permissionsResponse = await Http.GetAsync("api/v1/roles/permissions");
            if (permissionsResponse.IsSuccessStatusCode)
            {
                var grouped = await permissionsResponse.Content.ReadFromJsonAsync<List<PermissionCategoryApiDto>>(JsonOptions) ?? new();
                allPermissions = grouped
                    .SelectMany(g => g.Permissions.Select((p, i) => new PermissionInfo
                    {
                        Id = p.Id,
                        Code = p.Code,
                        Name = p.Name,
                        Description = p.Description,
                        Category = string.IsNullOrWhiteSpace(p.Category) ? g.Category : p.Category,
                        SortOrder = i
                    }))
                    .Where(p => !string.IsNullOrWhiteSpace(p.Code))
                    .GroupBy(p => p.Code)
                    .Select(g => g.First())
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load roles: {ex.Message}");
        }
        finally
        {
            isLoadingRoles = false;
        }
    }

    private string GetAvatarColor(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "var(--qm-text-muted)";
        var colors = new[] { "var(--qm-primary)", "var(--qm-secondary)", "var(--qm-success)", "var(--qm-warning)", "var(--qm-danger)" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    private async Task ShowAddDialog()
    {
        editingUser = null;
        formData = new UserFormData
        {
            IsActive = true,
            RoleId = roleOptions.FirstOrDefault(r => r.Name == "Staff")?.Id ?? roleOptions.FirstOrDefault()?.Id ?? Guid.Empty
        };
        if (isSuperAdmin)
        {
            // No organization picked yet - the Branch dropdown starts empty (and disabled,
            // see the modal markup) until one is, instead of silently showing zero branches.
            branchOptions = new();
        }

        selectedClasses = new();
        originalAssignments = new();
        await RefreshClassOptionsAsync();

        showDialog = true;
    }

    private async Task EditUser(UserInfo user)
    {
        editingUser = user;
        var names = user.FullName?.Split(' ') ?? Array.Empty<string>();
        formData = new UserFormData
        {
            FirstName = names.FirstOrDefault() ?? "",
            LastName = names.Length > 1 ? string.Join(" ", names.Skip(1)) : "",
            Email = user.Email ?? "",
            Username = user.Username ?? "",
            RoleId = user.RoleId,
            BranchId = user.BranchId,
            IsActive = user.IsActive
        };

        selectedClasses = new();
        originalAssignments = new();
        await RefreshClassOptionsAsync();
        await LoadExistingAssignmentsAsync(user.Id);

        showDialog = true;
    }

    // =====================================================================================
    // Class-teacher assignments.
    //
    // The permission set on a role says what a class teacher MAY do; their ClassTeacherAssignment
    // rows are what give them any students at all. Splitting those across two pages is how you
    // end up with an account that opens to an empty app, so the classes are chosen here — where
    // the role is chosen — and written through the same endpoint the Class Teachers page uses.
    // ClassTeacherAssignment is a table rather than a field on the class precisely because
    // UpdateVocabularies writes the whole class list OVER the stored blob (see CLAUDE.md).
    // =====================================================================================

    private bool canManageClassTeachers;
    private bool isLoadingClasses;
    private List<ClassOption> classOptions = new();
    private List<string> selectedClasses = new();

    /// <summary>What this user already held when the dialog opened, so a removal can be ended rather than orphaned.</summary>
    private List<ClassTeacherDto> originalAssignments = new();

    private sealed record ClassOption(string Name, string Label);

    private bool IsClassTeacherRoleSelected =>
        roleOptions.FirstOrDefault(r => r.Id == formData.RoleId)?.Code == RoleCodes.ClassTeacher;

    private async Task OnRoleSelected(Guid roleId)
    {
        formData.RoleId = roleId;

        // Only fetched when the Class Teacher role is actually picked — every other role would be
        // paying for a class list it never shows.
        if (IsClassTeacherRoleSelected && !classOptions.Any())
            await RefreshClassOptionsAsync();
    }

    private async Task OnBranchSelected(Guid? branchId)
    {
        formData.BranchId = branchId;

        // The class list belongs to the branch, so a branch change invalidates the selection
        // rather than silently keeping class names that may not exist in the new one.
        selectedClasses = new();
        await RefreshClassOptionsAsync();
    }

    private async Task RefreshClassOptionsAsync()
    {
        classOptions = new();
        if (!canManageClassTeachers || formData.BranchId is not { } branchId || branchId == Guid.Empty) return;

        isLoadingClasses = true;
        try
        {
            // Retired classes are excluded: students already in one keep it, but nobody should be
            // newly assigned to a class that is no longer offered.
            var vocab = await StudentApi.GetVocabulariesAsync(branchId);
            var coverage = await ClassTeacherApi.GetCoverageAsync(branchId);

            classOptions = vocab.Classes
                .Where(c => c.IsActive)
                .OrderBy(c => c.SortOrder)
                .Select(c =>
                {
                    var held = coverage.Classes.FirstOrDefault(x =>
                        x.ClassName.Trim().ToLowerInvariant() == c.Name.Trim().ToLowerInvariant())?.ClassTeacher;

                    // Says who already holds it, in the picker. Choosing a held class is not
                    // blocked here — the API is the authority and returns a 409 — but an
                    // administrator should be able to see the collision before they hit Save.
                    var label = held == null || held.UserId == editingUser?.Id
                        ? c.Name
                        : $"{c.Name} — held by {held.FullName}";
                    return new ClassOption(c.Name, label);
                })
                .ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Could not load classes", ex.Message);
        }
        finally
        {
            isLoadingClasses = false;
        }
    }

    private async Task LoadExistingAssignmentsAsync(Guid userId)
    {
        if (!canManageClassTeachers || formData.BranchId is not { } branchId || branchId == Guid.Empty) return;

        var all = await ClassTeacherApi.GetAssignmentsAsync(branchId);
        originalAssignments = all.Where(a => a.UserId == userId).ToList();
        selectedClasses = originalAssignments.Select(a => a.ClassName).ToList();
    }

    /// <summary>
    /// Reconciles the picked classes against what the user already held: new ones are assigned,
    /// removed ones are ENDED (never deleted — the history of who could see a child's file is the
    /// audit answer). Runs after the user is saved, and a failure here is reported without
    /// claiming the user save failed, because it did not.
    /// </summary>
    private async Task SyncClassAssignmentsAsync(Guid userId)
    {
        if (!canManageClassTeachers || formData.BranchId is not { } branchId || branchId == Guid.Empty) return;

        var wanted = selectedClasses
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var held = originalAssignments;
        var problems = new List<string>();
        var added = 0;
        var ended = 0;

        foreach (var className in wanted)
        {
            if (held.Any(h => h.ClassName.Trim().Equals(className, StringComparison.OrdinalIgnoreCase))) continue;
            try
            {
                await ClassTeacherApi.AssignAsync(branchId, new AssignClassTeacherRequest
                {
                    ClassName = className,
                    UserId = userId,
                    Role = ClassTeacherRole.ClassTeacher
                });
                added++;
            }
            catch (Exception ex)
            {
                // The commonest case is a 409 because the class already has a class teacher. The
                // service throws with the server's own words, so the administrator is told which
                // class and why rather than "some assignments failed".
                problems.Add($"{className}: {ex.Message}");
            }
        }

        foreach (var assignment in held)
        {
            if (wanted.Any(w => w.Equals(assignment.ClassName.Trim(), StringComparison.OrdinalIgnoreCase))) continue;
            try
            {
                await ClassTeacherApi.EndAsync(branchId, assignment.Id,
                    new EndClassTeacherRequest { Reason = "Removed while editing the user account" });
                ended++;
            }
            catch (Exception ex)
            {
                problems.Add($"{assignment.ClassName}: {ex.Message}");
            }
        }

        if (added > 0 || ended > 0)
        {
            var parts = new List<string>();
            if (added > 0) parts.Add($"{added} class{(added == 1 ? "" : "es")} assigned");
            if (ended > 0) parts.Add($"{ended} ended");
            NotificationService.Notify(ToastSeverity.Success, "Classes updated", string.Join(", ", parts) + ".");
        }

        foreach (var problem in problems)
            NotificationService.Notify(ToastSeverity.Warning, "Class not assigned", problem);
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(formData.Username) || string.IsNullOrWhiteSpace(formData.Email))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Username and email are required");
            return;
        }

        if (editingUser == null && string.IsNullOrWhiteSpace(formData.Password))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Password is required for new users");
            return;
        }

        if (formData.RoleId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please select a role");
            return;
        }

        if (isSuperAdmin && editingUser == null && formData.OrganizationId == null)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Please select an organization");
            return;
        }

        try
        {
            HttpResponseMessage response;
            if (editingUser == null)
            {
                var createRequest = new
                {
                    Username = formData.Username,
                    Email = formData.Email,
                    Password = formData.Password,
                    FirstName = formData.FirstName,
                    LastName = formData.LastName,
                    RoleId = formData.RoleId,
                    AssignedBranchId = formData.BranchId,
                    OrganizationId = formData.OrganizationId
                };
                response = await Http.PostAsJsonAsync("api/v1/users", createRequest, JsonOptions);
            }
            else
            {
                var updateRequest = new
                {
                    Email = formData.Email,
                    Password = string.IsNullOrWhiteSpace(formData.Password) ? null : formData.Password,
                    FirstName = formData.FirstName,
                    LastName = formData.LastName,
                    RoleId = formData.RoleId,
                    AssignedBranchId = formData.BranchId
                };
                response = await Http.PutAsJsonAsync($"api/v1/users/{editingUser.Id}", updateRequest, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingUser == null ? "User created" : "User updated");

                // After the user exists, not before: a new account has no id to assign a class to
                // until the POST comes back. A class-assignment problem is reported on its own and
                // does not retract the "user created" above, which is true either way.
                if (IsClassTeacherRoleSelected)
                {
                    var savedUserId = editingUser?.Id;
                    if (savedUserId == null)
                    {
                        var created = await response.Content.ReadFromJsonAsync<UserDto>(JsonOptions);
                        savedUserId = created?.Id;
                    }

                    if (savedUserId is { } uid && uid != Guid.Empty)
                        await SyncClassAssignmentsAsync(uid);
                    else if (selectedClasses.Any())
                        NotificationService.Notify(ToastSeverity.Warning, "Classes not assigned",
                            "The account was created but its id did not come back, so the classes were not assigned. Assign them on the Class Teachers page.");
                }

                showDialog = false;
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save user: {ex.Message}");
        }
    }

    private void DeleteUser(UserInfo user)
    {
        userToDelete = user;
        deleteConfirmMessage = $"Are you sure you want to delete '{user.FullName}'? This action cannot be undone.";
        showDeleteConfirm = true;
