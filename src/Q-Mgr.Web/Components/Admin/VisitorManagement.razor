    /// <summary>
    /// Collapses a name to the form two spellings of the same person share: case-folded, outer
    /// whitespace gone, runs of inner whitespace flattened to one space. Deliberately NOT a fuzzy
    /// match — this drives a warning the operator reads, and a warning that fires on merely
    /// similar names is one they learn to click through without reading.
    /// </summary>
    private static string NormalizeName(string? name) =>
        string.Join(" ", (name ?? "").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)).ToLowerInvariant();

    /// <summary>Candidates whose name is, character for character, the one being typed.</summary>
    private List<VisitorProfileSearchResultDto> ExactDuplicates()
    {
        var typed = NormalizeName(duplicatePendingName);
        if (typed.Length == 0) return new();
        return duplicateCandidates.Where(c => NormalizeName(c.FullName) == typed).ToList();
    }

    /// <summary>Candidates the name search matched but which are not a straight match.</summary>
    private List<VisitorProfileSearchResultDto> SimilarDuplicates()
    {
        var typed = NormalizeName(duplicatePendingName);
        if (typed.Length == 0) return new();
        return duplicateCandidates.Where(c => NormalizeName(c.FullName) != typed).ToList();
    }

    private static string DuplicateMeta(VisitorProfileSearchResultDto d)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(d.Company)) parts.Add(d.Company!);
        var contact = d.Phone ?? d.Email;
        if (!string.IsNullOrWhiteSpace(contact)) parts.Add(contact!);
        parts.Add(d.TotalVisits == 1 ? "1 visit" : $"{d.TotalVisits} visits");
        if (d.LastVisitAt.HasValue) parts.Add($"last {QDateFormat.C(d.LastVisitAt.Value)}");
        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Runs as the operator types in either modal’s Full Name field. Skipped entirely once a
    /// profile has been picked from the search box — at that point they have already told us which
    /// person this is, and warning them about the very record they chose would be noise.
    /// </summary>
    private async Task OnNameTyped(string? name, Guid? selectedProfileId)
    {
        duplicatePendingName = name ?? "";
        // The name changed, so an earlier "different person" decision no longer applies to it.
        if (duplicateAcknowledgedFor != null && NormalizeName(duplicateAcknowledgedFor) != NormalizeName(duplicatePendingName))
            duplicateAcknowledgedFor = null;

        duplicateDebounce?.Cancel();

        if (selectedProfileId.HasValue || NormalizeName(duplicatePendingName).Length < 3)
        {
            duplicateCandidates = new();
            return;
        }

        var cts = new CancellationTokenSource();
        duplicateDebounce = cts;
        try
        {
            await Task.Delay(400, cts.Token);
            var matches = await VisitorApi.SearchVisitorProfilesAsync(branchId, duplicatePendingName.Trim());
            cts.Token.ThrowIfCancellationRequested();
            duplicateCandidates = matches;
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
        catch (OperationCanceledException) { /* superseded by a newer keystroke */ }
        catch { /* a duplicate hint is an assist, not a gate — never surface its own failure */ }
    }

    private void ResetDuplicateState()
    {
        duplicateDebounce?.Cancel();
        duplicateCandidates = new();
        duplicatePendingName = "";
        duplicateAcknowledgedFor = null;
        showDuplicateConfirm = false;
        duplicateApply = null;
        duplicatePendingSubmit = null;
    }

    private void UseFirstDuplicate()
    {
        var first = ExactDuplicates().FirstOrDefault();
        showDuplicateConfirm = false;
        duplicatePendingSubmit = null;
        if (first == null || duplicateApply == null) return;
        duplicateApply(first);
        duplicateCandidates = new();
    }

    private async Task ContinueDespiteDuplicate()
    {
        duplicateAcknowledgedFor = duplicatePendingName;
        showDuplicateConfirm = false;
        var submit = duplicatePendingSubmit;
        duplicatePendingSubmit = null;
        if (submit != null) await submit();
    }

    /// <summary>
    /// True when the operator should be interrupted: an existing record carries exactly this
    /// name, they did not pick it from the search box, and they have not already said this is
    /// somebody else.
    /// </summary>
    private bool NeedsDuplicateConfirmation(Guid? selectedProfileId) =>
        !selectedProfileId.HasValue
        && ExactDuplicates().Any()
        && NormalizeName(duplicateAcknowledgedFor) != NormalizeName(duplicatePendingName);

    /// <summary>
    /// The inline banner. Visible the whole time matches exist — this is the part that stops the
    /// duplicate being created at all, rather than asking about it once at the end.
    /// </summary>
    private RenderFragment RenderDuplicateWarning(Action<VisitorProfileSearchResultDto> onUse) => __builder =>
    {
        var exact = ExactDuplicates();
        var similar = SimilarDuplicates();
        if (!exact.Any() && !similar.Any()) return;

        <div class="dup-warning @(exact.Any() ? "dup-warning--strong" : "")">
            <p class="dup-warning__head">
                <QIcon Name="exclamation-triangle-fill" />
                @if (exact.Any())
                {
                    <text>@DuplicateHeadline(exact.Count, true)</text>
                }
                else
                {
                    <text>@DuplicateHeadline(similar.Count, false)</text>
                }
            </p>
            <div class="dup-list">
                @foreach (var d in exact.Concat(similar))
                {
                    <div class="dup-row">
                        <span class="dup-row__name">
                            @d.FullName
                            @if (d.IsWatchlisted)
                            {
                                <WatchlistFlagIcon Name="@d.FullName" Reason="@d.WatchlistReason" />
                            }
                            @if (d.HasActiveVisit)
                            {
                                <span class="dup-row__onsite">On site now</span>
                            }
                        </span>
                        <span class="dup-row__meta">@DuplicateMeta(d)</span>
                        <QButton Text="Use this person" Icon="person-check-fill" Size="sm" Variant="secondary" OnClick="@(() => { onUse(d); duplicateCandidates = new(); })" />
                    </div>
                }
            </div>
        </div>
    };

    private static string DuplicateHeadline(int count, bool exact) => exact
        ? (count == 1
            ? "An existing record already uses this exact name. Reuse it instead of creating a duplicate."
            : $"{count} existing records already use this exact name. Reuse one instead of creating a duplicate.")
        : (count == 1
            ? "A similar name is already on file — check this is not the same person."
            : $"{count} similar names are already on file — check this is not the same person.");

    private async Task OnSearchInput(string? value)
    {
        searchQuery = value ?? "";

        searchDebounce?.Cancel();
        if (searchQuery.Trim().Length < 2)
        {
            searchResults = new();
            rosterSearchResults = new();
            return;
        }

        var cts = new CancellationTokenSource();
        searchDebounce = cts;
        try
        {
            await Task.Delay(300, cts.Token);
            // Roster matches first (they're the more specific, higher-value result for a
            // visiting-day search), then plain returning-visitor matches — run together, not
            // sequentially, so one slow query doesn't hold up the other.
            // The roster belongs to Student Welfare. A visitor-only organization was searching it
            // on every keystroke and being refused every time — the service swallowed the 403 and
            // returned an empty list, so nothing looked broken while the request went out anyway.
            var rosterTask = hasStudentWelfare
                ? StudentApi.SearchAsync(branchId, searchQuery)
                : Task.FromResult(new List<StudentGuardianSearchResultDto>());
            var visitorTask = VisitorApi.SearchVisitorProfilesAsync(branchId, searchQuery);
            await Task.WhenAll(rosterTask, visitorTask);
            cts.Token.ThrowIfCancellationRequested();

            rosterSearchResults = rosterTask.Result;
            // A guardian already shown under their roster match shouldn't also show as a
            // duplicate plain "returning visitor" a few pixels below it.
            var rosterProfileIds = rosterSearchResults.Select(r => r.GuardianProfileId).ToHashSet();
            searchResults = visitorTask.Result.Where(p => !rosterProfileIds.Contains(p.Id)).ToList();
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
        catch (OperationCanceledException) { /* superseded by a newer keystroke */ }
    }

    // Renders inline rather than as a child component — keeps this modal's own model in one
    // place instead of splitting state across a wrapper component + event callbacks for what's
    // only used in two spots on this page.
    private RenderFragment RenderReturningVisitorSearch(
        VisitorProfileSearchResultDto? selected,
        StudentGuardianSearchResultDto? selectedRoster,
        Action<VisitorProfileSearchResultDto> onSelect,
        Action<StudentGuardianSearchResultDto> onSelectRoster) => __builder =>
    {
        <div class="returning-search">
            @if (selectedRoster != null)
            {
                <div class="returning-selected roster">
                    <span><QIcon Name="mortarboard-fill" /> <strong>@selectedRoster.GuardianName</strong> (@selectedRoster.Relationship of @selectedRoster.StudentName@(string.IsNullOrEmpty(selectedRoster.ClassName) ? "" : $", {selectedRoster.ClassName}"))</span>
                    @if (selectedRoster.CheckInsToday > 0)
                    {
                        <span class="card-usage-flag @(selectedRoster.CheckInsToday >= CardAbuseWarningThreshold ? "warn" : "")" title="How many times this guardian's card has already been checked in today, across any student">
                            <QIcon Name="@(selectedRoster.CheckInsToday >= CardAbuseWarningThreshold ? "exclamation-triangle" : "info-circle")" />
                            Checked in @(selectedRoster.CheckInsToday)x today
                        </span>
                    }
                    <QButton Icon="x-lg" Size="sm" Variant="ghost" OnClick="@(() => { if (selectedRoster == checkInSelectedRoster) { checkInSelectedRoster = null; checkInOverrideReason = ""; } if (selectedRoster == preRegisterSelectedRoster) preRegisterSelectedRoster = null; })" />
                </div>
            }
            else if (selected != null)
            {
                <div class="returning-selected">
                    <span><QIcon Name="arrow-repeat" /> Returning visitor: <strong>@selected.FullName</strong> (@selected.TotalVisits visits)</span>
                    <QButton Icon="x-lg" Size="sm" Variant="ghost" OnClick="@(() => { if (selected == checkInSelectedProfile) checkInSelectedProfile = null; if (selected == preRegisterSelectedProfile) preRegisterSelectedProfile = null; })" />
                </div>
            }
            else
            {
                <input @bind:get="searchQuery" @bind:set="OnSearchInput" @bind:event="oninput" placeholder="Search by visitor or student name, phone, email or ID..." />
                @if (rosterSearchResults.Any() || searchResults.Any())
                {
                    <div class="returning-results">
                        @foreach (var r in rosterSearchResults)
                        {
                            <div class="returning-result roster" @onclick="@(() => onSelectRoster(r))">
                                <span class="returning-result-name">
                                    <QIcon Name="mortarboard-fill" Class="roster-flag" />
                                    @r.GuardianName
                                    <span class="roster-badge">@r.Relationship of @r.StudentName</span>
                                </span>
                                <span class="returning-result-meta">
                                    @(r.ClassName ?? "") @(string.IsNullOrEmpty(r.ClassName) ? "" : "·") @(r.GuardianPhone ?? r.GuardianEmail ?? "")
                                    @if (r.CheckInsToday > 0)
                                    {
                                        <span class="@(r.CheckInsToday >= CardAbuseWarningThreshold ? "card-usage-flag warn" : "card-usage-flag")">
                                            · checked in @(r.CheckInsToday)x today
                                        </span>
                                    }
                                </span>
                            </div>
                        }
                        @foreach (var p in searchResults)
                        {
                            <div class="returning-result" @onclick="@(() => onSelect(p))">
                                <span class="returning-result-name">
                                    @p.FullName
                                    @if (p.IsWatchlisted)
                                    {
                                        <WatchlistFlagIcon Name="@p.FullName" Reason="@p.WatchlistReason" />
                                    }
                                    @if (p.HasActiveVisit)
                                    {
                                        <span class="frequency-flag">Currently checked in elsewhere</span>
                                    }
                                </span>
                                <span class="returning-result-meta">
                                    @(p.Company ?? "") @(string.IsNullOrEmpty(p.Company) ? "" : "·") @(p.Phone ?? p.Email ?? "")
                                    · @p.TotalVisits visit@(p.TotalVisits == 1 ? "" : "s")
                                    @(p.LastVisitAt.HasValue ? $"· last {QDateFormat.C(p.LastVisitAt.Value)}" : "")
                                </span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    };

