@code {
    private static readonly (ReportSubscriptionKind Value, string Text)[] SubscriptionKindOptions =
    {
        (ReportSubscriptionKind.Exceptions, "Exceptions — needs attention"), (ReportSubscriptionKind.Summary, "Summary — headline figures"),
        (ReportSubscriptionKind.VisitorLog, "Visitor log"), (ReportSubscriptionKind.Compliance, "Compliance")
    };

    // A guardian's roster card being checked in more than once on visiting day isn't inherently
    // wrong (morning drop-off + afternoon pick-up is a normal 2), but past this threshold it's
    // worth a front-desk glance rather than a silent auto-approve — see CheckInsToday on
    // StudentGuardianSearchResultDto. Admin-configurable (Visitor Settings); defaults to 2 until
    // loaded in OnInitializedAsync so early renders never null-ref.
    private VisitingDaySettingsDto visitingDaySettings = new();
    private int CardAbuseWarningThreshold => visitingDaySettings.CardCheckInWarningThreshold;
    private bool isManagerOrAbove;

    // Only the walk-in Check-In modal needs this — Pre-Register never triggers the gate itself
    // (VisitorsController.PreRegister doesn't check it; the gate fires when the visit actually
    // starts, i.e. CheckIn or CheckInExisting), so the pre-registration step never needs a reason.
    private string checkInOverrideReason = "";

    private bool CardNeedsOverride(StudentGuardianSearchResultDto? roster) =>
        roster != null && roster.CheckInsToday >= CardAbuseWarningThreshold && !roster.GuardianIsWatchlisted && !isManagerOrAbove;

    // ---- Batch: end-of-day check-out ---------------------------------------------------------
    //
    // The evacuation report already answers "who is still in the building". Nothing closed them
    // out, so a visit left open on Friday was still open on Monday. This is that gap.

    private bool canCheckOut;
    private readonly HashSet<Guid> selectedVisitIds = new();
    private QBatchDialog? batchDialog;

    private void ToggleVisitSelection(Guid id, bool select)
    {
        if (select) selectedVisitIds.Add(id);
        else selectedVisitIds.Remove(id);
    }

    /// <summary>
    /// Selects exactly the visits that are still open — which is what somebody locking up actually
    /// wants, and saves them ticking forty boxes to find the four that matter.
    /// </summary>
    private void SelectAllOnSite()
    {
        foreach (var v in visitors.Where(v => v.CheckedInAt.HasValue && !v.CheckedOutAt.HasValue))
            selectedVisitIds.Add(v.Id);
    }

    private async Task RunCheckOutBatch()
    {
        if (batchDialog == null) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.CheckOutVisitors,
            Ids = selectedVisitIds.ToList()
        });
    }

    private async Task OnBatchQueued(BatchAcceptedDto accepted)
    {
        selectedVisitIds.Clear();
        NotificationService.Notify(ToastSeverity.Info, "Running", accepted.Summary, 6000);
        await Task.Delay(1500);
        await LoadData();
    }

    // ---- Export -----------------------------------------------------------------------------

    private string ExportSubtitle => $"{visitors.Count:N0} visit(s) in the current view · {QDateFormat.D(DateTime.Now)}";

    private static readonly List<ExportColumn<VisitorDto>> VisitorExportColumns = new()
    {
        new("Badge", v => v.BadgeCode, ExportType.Text, 12),
        new("Visitor", v => v.FullName, ExportType.Text, 26),
        new("Phone", v => v.Phone, ExportType.Text, 16),
        new("Company", v => v.Company, ExportType.Text, 22),
        new("Purpose", v => v.Purpose, ExportType.Text, 24),
        new("Host", v => v.HostName, ExportType.Text, 22),
        new("Visiting", v => v.StudentName, ExportType.Text, 24),
        new("Checked in", v => v.CheckedInAt?.ToLocalTime(), ExportType.Date, 18),
        new("Checked out", v => v.CheckedOutAt?.ToLocalTime(), ExportType.Date, 18),
        new("Vehicle", v => v.VehiclePlate, ExportType.Text, 12),
        new("Watchlisted", v => v.IsWatchlisted, ExportType.Bool, 12)
    };

    /// <summary>The rows in the current view — the evacuation list, if that is what is on screen.</summary>
    private Task<ExportRows<VisitorDto>> ProvideExportRowsAsync() =>
        Task.FromResult(new ExportRows<VisitorDto>(visitors, false));

    private List<VisitorDto> allVisitors = new();
    private List<VisitorDto> visitors = new();
    // ---- Paging (list-page sweep, plan Phase 2) --------------------------------------------
    // Every row here is a component subtree Blazor Server diffs and ships down the circuit, so
    // the page renders a page of them rather than the whole list.
    private const int PageSize = 25;
    private int pageIndex;
    private int SafePageIndex => Math.Min(pageIndex, Math.Max(0, (visitors.Count() - 1) / PageSize));
    private IEnumerable<VisitorDto> PagedVisitors => visitors.Skip(SafePageIndex * PageSize).Take(PageSize);
    private VisitorSummaryDto? summary;
    private bool isLoading = true;
    private Guid branchId;
    private string activeFilter = "all";

    private readonly Dictionary<string, string> filterTabs = new()
    {
        ["all"] = "All Today",
        ["onsite"] = "On Site",
        ["upcoming"] = "Pre-Registered",
        ["watchlist"] = "Watchlisted",
    };

    private CheckInVisitorRequest checkInModel = new();
    private PreRegisterVisitorRequest preRegisterModel = new();
    private DateTime? scheduledAtLocal;
    private bool showCheckInModal;
    private bool showPreRegisterModal;
    private VisitorProfileSearchResultDto? checkInSelectedProfile;
    private VisitorProfileSearchResultDto? preRegisterSelectedProfile;
    private StudentGuardianSearchResultDto? checkInSelectedRoster;
    private StudentGuardianSearchResultDto? preRegisterSelectedRoster;
    /// <summary>Whether the organization also holds Student Welfare, which owns the roster this
    /// module searches for visiting-day check-ins.</summary>
    private bool hasStudentWelfare;

    private List<StudentGuardianSearchResultDto> rosterSearchResults = new();

    private bool showCheckInExistingModal;
    private CheckInVisitorRequest checkInExistingModel = new();
    private VisitorDto? visitorPendingCheckIn;

    private bool showDeleteConfirm;
    private string deleteConfirmMessage = "";
    private string deleteReason = "";
    private VisitorDto? visitorPendingDelete;

    private bool showFlagConfirm;
    private string flagConfirmMessage = "";
    private string flagReason = "";
    private bool pendingFlagState;
    private VisitorDto? visitorPendingFlag;

    private bool showBadgeModal;
    private VisitorDto? badgeVisitor;

    // Shared returning-visitor search state — only one modal is open at a time, so one set of
    // fields is enough; RenderReturningVisitorSearch scopes results to whichever modal called it.
    private string searchQuery = "";
    private List<VisitorProfileSearchResultDto> searchResults = new();
    private CancellationTokenSource? searchDebounce;

    // ---- Duplicate visitor detection -------------------------------------------------------
    // The server already merges a repeat visitor onto their existing profile when the form
    // carries an email, a phone or an ID number (VisitorsController.FindOrCreateProfileAsync).
    // What it deliberately will NOT do is match on name — a name is not an identity, and merging
    // two different people who happen to share one is unrecoverable. The consequence is that a
    // name-only walk-in creates a brand-new profile EVERY time, which is how four separate
    // "Mucunguzi" records ended up on one branch, two of them simultaneously on site.
    //
    // The fix belongs here rather than in the matcher: show the operator — who can actually tell
    // the two apart — what already exists, and make reusing it one click. Warning only, never a
    // block; see the duplicate-confirmation modal above for why.
    private List<VisitorProfileSearchResultDto> duplicateCandidates = new();
    private CancellationTokenSource? duplicateDebounce;
    private string duplicatePendingName = "";
    /// <summary>The name the operator has already said belongs to a different person.</summary>
    private string? duplicateAcknowledgedFor;
    private bool showDuplicateConfirm;
    private Action<VisitorProfileSearchResultDto>? duplicateApply;
    private Func<Task>? duplicatePendingSubmit;

    // Which modal (by idPrefix) currently has its camera live, if any — only one at a time.
    private string? photoCapturingFor;

    private bool consentRequired;
    private string consentText = "";
    private bool checkInConsentGiven;
    private bool checkInExistingConsentGiven;

    private bool showSettingsModal;
    private VisitorConsentSettingsDto consentSettingsModel = new();
    private VisitorRetentionSettingsDto retentionSettingsModel = new();
    private VisitingDaySettingsDto visitingDaySettingsModel = new();
    private VisitorReportingSettingsDto reportingSettingsModel = new();
    private bool canExportReports;

    /// <summary>
    /// Bound separately because the DTO's field is nullable ("use the general threshold") and a
    /// number input cannot express null. Reconciled on save.
    /// </summary>
    private int contractorOverstayHours = 12;

    private Guid organizationId;

    private bool showPassesModal;
    private List<VisitorPassDto> passes = new();
    private CreateVisitorPassRequest newPassRequest = new();
    private VisitorPassDto? createdPass;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.VisitorsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        canCheckOut = await PermissionService.HasPermissionAsync(Permissions.VisitorsCheckOut);
        canExportReports = await PermissionService.HasPermissionAsync(Permissions.ReportsExport);

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.VisitorManagement))
        {
            Navigation.NavigateTo(BillingLinks.Modules, forceLoad: false);
            return;
        }

        // Visiting-day check-in matches an arriving guardian against the student roster, which is a
        // Student Welfare feature this module borrows. Without it the search simply has no roster half.
        hasStudentWelfare = ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare);

        await BranchState.InitializeAsync();
        branchId = BranchState.CurrentBranchId;

        var user = await AuthService.GetCurrentUserAsync();
        if (user != null) organizationId = user.OrganizationId;

        var consent = await VisitorApi.GetConsentSettingsAsync(branchId);
        consentRequired = consent.Required;
        consentText = consent.Text;

        isManagerOrAbove = await PermissionService.IsManagerOrAboveAsync();
        visitingDaySettings = await VisitorApi.GetVisitingDaySettingsAsync(branchId);

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        allVisitors = await VisitorApi.GetVisitorsAsync(branchId);
        summary = await VisitorApi.GetSummaryAsync(branchId);
        ApplyFilter(activeFilter);

        isLoading = false;
    }

    private void ApplyFilter(string filter)
    {
        activeFilter = filter;
        visitors = filter switch
        {
            "onsite" => allVisitors.Where(v => v.Status == VisitorStatus.CheckedIn).ToList(),
            "upcoming" => allVisitors.Where(v => v.Status == VisitorStatus.PreRegistered).ToList(),
            "watchlist" => allVisitors.Where(v => v.IsWatchlisted).ToList(),
            _ => allVisitors,
        };
        StateHasChanged();
    }

    private void OpenCheckInModal()
    {
        checkInModel = new CheckInVisitorRequest();
