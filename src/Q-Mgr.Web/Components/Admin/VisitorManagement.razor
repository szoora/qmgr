@page "/admin/visitors"
@using QMgr.Web.Services
@using System.Text.Json
@inject IVisitorApiService VisitorApi
@inject IStudentApiService StudentApi
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Shared.UI

<PageTitle>Visitor Management - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Visitor Management<QInfo Text="Check in visitors, notify hosts, and keep a record of who's on site" Label="Visitor Management" /></h1>
            <p class="subtitle">Check in visitors, notify hosts, and keep a record of who's on site</p>
        </div>
        <div class="header-actions">
            @* Gated on visitors.view, which is what this page already requires to be read at
               all — downloading the day's visitors is not a second decision. *@
            <QDataExport TItem="VisitorDto"
                         Title="Visitors"
                         FileStem="visitors"
                         Subtitle="@ExportSubtitle"
                         Columns="@VisitorExportColumns"
                         RowProvider="@ProvideExportRowsAsync"
                         Disabled="@(!visitors.Any())"
                         DisabledReason="No visits match the current view." />
            <QButton Text="Scan Badge" Icon="qr-code-scan" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/admin/visitors/scan"))" />
            <QButton Text="Display Board" Icon="display" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/admin/visitors/board"))" />
            <PermissionGuard Permission="students.view">
            </PermissionGuard>
            <PermissionGuard Permission="visitors.manage">
                <QButton Text="Group Passes" Icon="people-fill" Variant="secondary" OnClick="@OpenPassesModal" />
                <QButton Text="Audit Log" Icon="clock-history" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/admin/visitors/audit"))" />
                <QButton Icon="gear-fill" Variant="secondary" OnClick="@OpenSettingsModal" />
            </PermissionGuard>
            <PermissionGuard Permission="visitors.checkin">
                <QButton Text="Pre-Register" Icon="calendar-plus" Variant="secondary" OnClick="@OpenPreRegisterModal" />
                <QButton Text="Check In Visitor" Icon="person-plus-fill" Variant="primary" OnClick="@OpenCheckInModal" />
            </PermissionGuard>
        </div>
    </div>

    @if (summary != null)
    {
        <QStatRow>
            <QStatTile Icon="person-check-fill" Variant="success" Value="@summary.CurrentlyOnSite.ToString()" Label="On site now" />
            <QStatTile Icon="people-fill" Variant="primary" Value="@summary.TotalToday.ToString()" Label="Today" />
            <QStatTile Icon="calendar-event" Variant="info" Value="@summary.PreRegisteredUpcoming.ToString()" Label="Pre-registered" />
            <QStatTile Icon="shield-exclamation" Variant="@(summary.WatchlistedOnSite > 0 ? "danger" : "secondary")" Value="@summary.WatchlistedOnSite.ToString()" Label="Watchlisted on site" />
        </QStatRow>
    }

    <QTabs Tabs="@(filterTabs.Select(t => new QTab(t.Key, t.Value)).ToList())" ActiveKey="@activeFilter" ActiveKeyChanged="@ApplyFilter" AriaLabel="Which visitors" />

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading visitors...</span>
        </div>
    }
    else if (!visitors.Any())
    {
        <div class="empty-state">
            <QIcon Name="person-badge" />
            <h3>No Visitors</h3>
            <p>Visitors will appear here once checked in or pre-registered</p>
        </div>
    }
    else
    {
            @* Closing out the building at the end of the day. The bar appears only when visits are
               selected, and the operation refuses anyone already checked out or never checked in
               rather than stamping a checkout time on them. *@
            @if (selectedVisitIds.Count > 0 && canCheckOut)
            {
                <div class="batch-bar">
                    <span class="batch-bar-count"><QIcon Name="check2-square" /> <strong>@selectedVisitIds.Count.ToString("N0")</strong> selected</span>
                    <QButton Text="Check out" Icon="box-arrow-right" Size="sm" Variant="primary" OnClick="@RunCheckOutBatch"
                             Title="Close out every selected visit that is still open" />
                    <button type="button" class="batch-clear" @onclick="@(() => selectedVisitIds.Clear())">Clear selection</button>
                </div>
            }

            @if (visitors.Any(v => v.CheckedInAt.HasValue && !v.CheckedOutAt.HasValue))
            {
                <div class="onsite-hint">
                    <QIcon Name="info-circle" />
                    <span>@visitors.Count(v => v.CheckedInAt.HasValue && !v.CheckedOutAt.HasValue) still on site.</span>
                    <button type="button" class="batch-clear" style="margin-left:0" @onclick="SelectAllOnSite">Select them all</button>
                </div>
            }

        @* Paging (plan Phase 2). The on-site list is a day's traffic on a busy front desk and
           every row here is a card with actions — a component subtree Blazor Server diffs and ships
           down the circuit. The page already has its own search and status filters above. *@
        <div class="visitor-list">
            @foreach (var visitor in PagedVisitors)
            {
                <div class="visitor-card @(visitor.IsWatchlisted ? "watchlisted" : "") status-@visitor.Status.ToString().ToLower()">
                    @if (canCheckOut)
                    {
                        <input type="checkbox" class="visitor-select" checked="@selectedVisitIds.Contains(visitor.Id)"
                               @onchange="@(e => ToggleVisitSelection(visitor.Id, (bool)(e.Value ?? false)))"
                               aria-label="@($"Select {visitor.FullName}")" />
                    }
                    <div class="visitor-main">
                        <div class="visitor-identity">
                            <span class="badge-code">@visitor.BadgeCode</span>
                            <span class="visitor-name">
                                @visitor.FullName
                                @if (visitor.IsWatchlisted)
                                {
                                    <WatchlistFlagIcon Name="@visitor.FullName" Reason="@visitor.WatchlistReason" FlaggedAt="@visitor.WatchlistAddedAt" />
                                }
                            </span>
                            @if (!string.IsNullOrEmpty(visitor.Company))
                            {
                                <span class="visitor-company">@visitor.Company</span>
                            }
                            @if (visitor.TotalVisits > 1)
                            {
                                <span class="returning-badge" title="@($"{visitor.TotalVisits} total visits")">
                                    <QIcon Name="arrow-repeat" /> Returning (@visitor.TotalVisits)
                                </span>
                            }
                            @if (visitor.VisitsLast24Hours > 3)
                            {
                                <span class="frequency-flag" title="Unusually frequent — worth a second look">
                                    <QIcon Name="exclamation-triangle" /> @visitor.VisitsLast24Hours visits/24h
                                </span>
                            }
                        </div>
                        <span class="status-badge">@visitor.Status</span>
                    </div>

                    <div class="visitor-details">
                        <span class="detail-item"><QIcon Name="briefcase-fill" /> @visitor.Purpose</span>
                        @if (!string.IsNullOrEmpty(visitor.HostName))
                        {
                            <span class="detail-item"><QIcon Name="person-fill" /> Host: @visitor.HostName</span>
                        }
                        @if (!string.IsNullOrEmpty(visitor.Phone))
                        {
                            <span class="detail-item"><QIcon Name="telephone-fill" /> @visitor.Phone</span>
                        }
                        @if (!string.IsNullOrEmpty(visitor.VehiclePlate))
                        {
                            <span class="detail-item"><QIcon Name="car-front-fill" /> @visitor.VehiclePlate</span>
                        }
                        @if (visitor.ScheduledAt.HasValue)
                        {
                            <span class="detail-item"><QIcon Name="calendar-event" /> Scheduled @QDateFormat.CDT(visitor.ScheduledAt.Value)</span>
                        }
                        @if (visitor.CheckedInAt.HasValue)
                        {
                            <span class="detail-item"><QIcon Name="box-arrow-in-right" /> In: @QDateFormat.T(visitor.CheckedInAt.Value)</span>
                        }
                        @if (visitor.CheckedOutAt.HasValue)
                        {
                            <span class="detail-item"><QIcon Name="box-arrow-right" /> Out: @QDateFormat.T(visitor.CheckedOutAt.Value)</span>
                        }
                    </div>

                    <div class="visitor-actions">
                        @if (visitor.Status == VisitorStatus.PreRegistered)
                        {
                            <PermissionGuard Permission="visitors.checkin">
                                <QButton Text="Check In" Icon="box-arrow-in-right" Size="sm" Variant="primary" OnClick="@(() => OpenCheckInExistingModal(visitor))" />
                            </PermissionGuard>
                        }
                        @if (visitor.Status == VisitorStatus.CheckedIn)
                        {
                            <PermissionGuard Permission="visitors.checkout">
                                <QButton Text="Badge" Icon="qr-code" Size="sm" Variant="ghost" OnClick="@(() => ShowBadge(visitor))" />
                                <QButton Text="Check Out" Icon="box-arrow-right" Size="sm" Variant="secondary" OnClick="@(() => CheckOut(visitor))" />
                            </PermissionGuard>
                        }
                        <PermissionGuard Permission="visitors.manage">
                            <QButton Text="@(visitor.IsWatchlisted ? "Unflag" : "Flag")" Icon="shield-exclamation" Size="sm" Variant="ghost" OnClick="@(() => RequestToggleWatchlist(visitor))" />
                            <QButton Icon="trash" Size="sm" Variant="ghost" OnClick="@(() => RequestDeleteVisitor(visitor))" />
                        </PermissionGuard>
                    </div>
                </div>
            }
        </div>
        <QPager Count="@visitors.Count" PageSize="@PageSize" PageIndex="@pageIndex" PageIndexChanged="@(i => pageIndex = i)" ItemLabel="visitors" />
    }
</div>

<QBatchDialog @ref="batchDialog" BranchId="@BranchState.CurrentBranchId" OnQueued="@OnBatchQueued" />

<QModal @bind-Visible="showCheckInModal" Title="Check In Visitor" Size="md">
    <ChildContent>
        @RenderReturningVisitorSearch(checkInSelectedProfile, checkInSelectedRoster, p => ApplyProfileToCheckIn(p), r => ApplyRosterToCheckIn(r))
        <div class="form-grid">
            <label>Full Name *<input @bind="checkInModel.FullName" @bind:event="oninput" @bind:after="@(() => OnNameTyped(checkInModel.FullName, checkInModel.VisitorProfileId))" placeholder="Jane Doe" /></label>
            <label>Company<input @bind="checkInModel.Company" placeholder="SACC Software Limited" /></label>
            <label>Phone<input @bind="checkInModel.Phone" placeholder="0753404044" /></label>
            <label>Email<input @bind="checkInModel.Email" placeholder="support@getsacc.com" /></label>
            <label>ID Number<input @bind="checkInModel.IdNumber" placeholder="Passport / National ID" /></label>
            <label>Vehicle Plate<input @bind="checkInModel.VehiclePlate" placeholder="KDA 123B" /></label>
            <label>Purpose of Visit *<input @bind="checkInModel.Purpose" placeholder="Meeting, delivery, interview..." /></label>
            <label>Host Name<input @bind="checkInModel.HostName" placeholder="Who are they visiting?" /></label>
            <label class="full-width">Notes<textarea @bind="checkInModel.Notes" rows="2"></textarea></label>
        </div>
        @RenderDuplicateWarning(p => ApplyProfileToCheckIn(p))
        @RenderPhotoCapture("checkin-photo", url => checkInModel.PhotoUrl = url, checkInModel.PhotoUrl)
        @if (consentRequired)
        {
            @RenderConsentCheckbox(checkInConsentGiven, v => checkInConsentGiven = v)
        }
        @if (CardNeedsOverride(checkInSelectedRoster))
        {
            <div class="card-override-box">
                <p><QIcon Name="shield-exclamation" /> This card has already been checked in @checkInSelectedRoster!.CheckInsToday time(s) today. Flag it with a reason to proceed, or ask a Manager/Admin to complete this check-in instead.</p>
                <label class="full-width">Reason to flag this card *<input @bind="checkInOverrideReason" placeholder="e.g. confirmed with school office — legitimate re-visit" /></label>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => CloseCheckInModal())" />
        @if (CardNeedsOverride(checkInSelectedRoster))
        {
            <QButton Text="Flag Card & Check In" Icon="shield-exclamation" Variant="warning" OnClick="@SubmitCheckIn"
                     Disabled="@(string.IsNullOrWhiteSpace(checkInModel.FullName) || string.IsNullOrWhiteSpace(checkInModel.Purpose) || (consentRequired && !checkInConsentGiven) || string.IsNullOrWhiteSpace(checkInOverrideReason))" />
        }
        else
        {
            <QButton Text="Check In" Icon="person-plus-fill" Variant="primary" OnClick="@SubmitCheckIn"
                     Disabled="@(string.IsNullOrWhiteSpace(checkInModel.FullName) || string.IsNullOrWhiteSpace(checkInModel.Purpose) || (consentRequired && !checkInConsentGiven))" />
        }
    </FooterContent>
</QModal>

<QModal @bind-Visible="showCheckInExistingModal" Title="Check In Visitor" Size="md">
    <ChildContent>
        <p class="confirm-message">Confirm arrival for <strong>@visitorPendingCheckIn?.FullName</strong>.</p>
        <div class="form-grid">
            <label>ID Number<input @bind="checkInExistingModel.IdNumber" placeholder="Passport / National ID" /></label>
            <label>Vehicle Plate<input @bind="checkInExistingModel.VehiclePlate" placeholder="KDA 123B" /></label>
        </div>
        @RenderPhotoCapture("checkin-existing-photo", url => checkInExistingModel.PhotoUrl = url, checkInExistingModel.PhotoUrl)
        @if (consentRequired)
        {
            @RenderConsentCheckbox(checkInExistingConsentGiven, v => checkInExistingConsentGiven = v)
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => CloseCheckInExistingModal())" />
        <QButton Text="Check In" Icon="box-arrow-in-right" Variant="primary" OnClick="@SubmitCheckInExisting"
                 Disabled="@(consentRequired && !checkInExistingConsentGiven)" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showPreRegisterModal" Title="Pre-Register Visitor" Size="md">
    <ChildContent>
        @RenderReturningVisitorSearch(preRegisterSelectedProfile, preRegisterSelectedRoster, p => ApplyProfileToPreRegister(p), r => ApplyRosterToPreRegister(r))
        <div class="form-grid">
            <label>Full Name *<input @bind="preRegisterModel.FullName" @bind:event="oninput" @bind:after="@(() => OnNameTyped(preRegisterModel.FullName, preRegisterModel.VisitorProfileId))" placeholder="Jane Doe" /></label>
            <label>Company<input @bind="preRegisterModel.Company" placeholder="SACC Software Limited" /></label>
            <label>Phone<input @bind="preRegisterModel.Phone" placeholder="0753404044" /></label>
            <label>Email<input @bind="preRegisterModel.Email" placeholder="support@getsacc.com" /></label>
            <label>Vehicle Plate<input @bind="preRegisterModel.VehiclePlate" placeholder="KDA 123B" /></label>
            @* The project's date picker plus a time field rather than <input type="datetime-local">,
               whose date renders in the browser's locale. *@
            <div class="q-datetime-pair">
                <QDatePicker Label="Scheduled date" @bind-Value="scheduledAtLocal" Clearable="true" Min="@DateTime.Today" />
                <QDatePicker Label="Time" ShowTime="true" @bind-Value="scheduledAtLocal" />
            </div>
            <label>Purpose of Visit *<input @bind="preRegisterModel.Purpose" placeholder="Meeting, delivery, interview..." /></label>
            <label>Host Name<input @bind="preRegisterModel.HostName" placeholder="Who are they visiting?" /></label>
            <label class="full-width">Notes<textarea @bind="preRegisterModel.Notes" rows="2"></textarea></label>
        </div>
        @RenderDuplicateWarning(p => ApplyProfileToPreRegister(p))
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showPreRegisterModal = false)" />
        <QButton Text="Pre-Register" Icon="calendar-plus" Variant="primary" OnClick="@SubmitPreRegister"
                 Disabled="@(string.IsNullOrWhiteSpace(preRegisterModel.FullName) || string.IsNullOrWhiteSpace(preRegisterModel.Purpose))" />
    </FooterContent>
</QModal>

@*
    Duplicate confirmation. AGGRESSIVE but NEVER blocking, by explicit product decision: two
    people really can share a name, and a front desk that cannot admit the second one is worse
    than a register with a duplicate in it. So this interrupts, names the existing record, and
    makes "use the existing person" the easy default — but "different person" is always there and
    always works.
*@
<QModal @bind-Visible="showDuplicateConfirm" Title="This name is already on file" Icon="exclamation-triangle-fill" Size="sm">
    <ChildContent>
        <p class="confirm-message">
            <strong>@duplicatePendingName</strong> already exists as a visitor record.
            Checking in again as a new person creates a second record for the same name.
        </p>
        <div class="dup-list">
            @foreach (var d in ExactDuplicates())
            {
                <div class="dup-row">
                    <span class="dup-row__name">
                        @d.FullName
                        @if (d.IsWatchlisted)
                        {
                            <WatchlistFlagIcon Name="@d.FullName" Reason="@d.WatchlistReason" />
                        }
                        @if (d.HasActiveVisit)
                        {
                            <span class="dup-row__onsite">On site now</span>
                        }
                    </span>
                    <span class="dup-row__meta">@DuplicateMeta(d)</span>
                </div>
            }
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Use the existing record" Icon="person-check-fill" Variant="primary" OnClick="@UseFirstDuplicate" />
        <QButton Text="Different person — continue" Icon="person-plus" Variant="ghost" OnClick="@ContinueDespiteDuplicate" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showBadgeModal" Title="Visitor Badge" Size="sm">
    <ChildContent>
        @if (badgeVisitor != null)
        {
            <div class="badge-card">
                <div id="badge-qr-canvas" class="badge-qr-container"></div>
                <div class="badge-name">@badgeVisitor.FullName</div>
                <div class="badge-code">@badgeVisitor.BadgeCode</div>
                @if (!string.IsNullOrEmpty(badgeVisitor.HostName))
                {
                    <div class="badge-host">Visiting: @badgeVisitor.HostName</div>
                }
                <p class="badge-hint">Scan at the exit to check out automatically — single-use, a photographed or reprinted copy stops working the moment it's scanned once.</p>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@(() => showBadgeModal = false)" />
        <QButton Text="Print" Icon="printer-fill" Variant="primary" OnClick="@PrintBadge" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showSettingsModal" Title="Visitor Settings" Size="md">
    <ChildContent>
        <div class="settings-section">
            <h3>Consent / NDA<QInfo Text="When enabled, every check-in requires the visitor (or the staff member on their behalf) to accept this statement before the visit can start." Label="Consent / NDA" /></h3>
            <label class="settings-toggle">
                <input type="checkbox" @bind="consentSettingsModel.Required" />
                <span>Require consent at check-in</span>
            </label>
            <label class="full-width-label">
                Consent text
                <textarea @bind="consentSettingsModel.Text" rows="3" disabled="@(!consentSettingsModel.Required)"></textarea>
            </label>
        </div>
        <div class="settings-section">
            <h3>Visiting Day</h3>
            <p class="settings-hint">
                Controls for the roster (school visiting-day) check-in flow — how many times a
                guardian's card can be checked in before front-desk staff must flag it (or a
                Manager/Admin completes it instead), and whether guardians get an SMS confirming
                their card was used.
            </p>
            <label>
                Flag threshold (check-ins per day)
                <input type="number" min="1" max="20" @bind="visitingDaySettingsModel.CardCheckInWarningThreshold" />
            </label>
            <label class="settings-toggle">
                <input type="checkbox" @bind="visitingDaySettingsModel.NotifyGuardianOnCheckIn" />
                <span>Text the guardian to confirm their card was used at check-in</span>
            </label>
        </div>
        <div class="settings-section">
            <h3>Data Retention</h3>
            <p class="settings-hint">
                Visit records (name, phone, email, ID, photo) are automatically and permanently purged after this many days.
                Default is 730 days (2 years) — a common baseline for security/compliance logs; adjust to match your jurisdiction's actual requirement.
            </p>
            <label>
                Retention period (days)
                <input type="number" min="30" max="3650" @bind="retentionSettingsModel.RetentionDays" />
            </label>
        </div>

        <div class="settings-section">
            <h3>Reporting Thresholds<QInfo Text="What counts as an exception on the Visitors report. A visit still open past these hours is listed as an overstay; a visitor reaching the visit count is listed as unusually frequent. Neither blocks anything — they decide what gets surfaced." Label="Reporting Thresholds" /></h3>
            <label>
                Overstay after (hours)
                <input type="number" min="1" max="168" @bind="reportingSettingsModel.OverstayThresholdHours" />
            </label>
            <label>
                Contractor overstay after (hours)
                <input type="number" min="1" max="168" @bind="contractorOverstayHours" />
            </label>
            <p class="settings-hint">Contractors on a day permit legitimately stay far longer than a parent on a twenty-minute visit, so they get their own threshold.</p>
            <label>
                Frequent visitor from (visits in the report range)
                <input type="number" min="2" max="100" @bind="reportingSettingsModel.FrequentVisitorThreshold" />
            </label>
        </div>

        <div class="settings-section">
            <h3>Evacuation &amp; Scheduled Reports<QInfo Text="Where the roll call is emailed from the evacuation screen, and which reports go out on their own. A scheduled report is an export that leaves the building on a timer, so editing this needs the same permission as downloading the log by hand." Label="Evacuation &amp; Scheduled Reports" /></h3>
            <label class="full-width-label">
                Evacuation roll call goes to
                <input type="email" @bind="reportingSettingsModel.EvacuationEmail" placeholder="fire.marshal@yourschool.ac.ug" />
            </label>

            @if (!canExportReports)
            {
                <p class="settings-hint">You do not have the reports.export permission, so scheduled reports are read-only here.</p>
            }

            @foreach (var sub in reportingSettingsModel.Subscriptions)
            {
                <div class="subscription-row">
                    <div class="subscription-head">
                        <label class="settings-toggle">
                            <input type="checkbox" @bind="sub.Enabled" disabled="@(!canExportReports)" />
                            <span>Enabled</span>
                        </label>
                        <QButton Icon="trash" Size="sm" Variant="ghost" Disabled="@(!canExportReports)"
                                 OnClick="@(() => reportingSettingsModel.Subscriptions.Remove(sub))" />
                    </div>
                    <div class="subscription-grid">
                        <QSelect TValue="ReportSubscriptionKind" TItem="(ReportSubscriptionKind Value, string Text)" @bind-Value="sub.Kind"
                                 Items="@SubscriptionKindOptions" ValueSelector="@(o => o.Value)" TextSelector="@(o => o.Text)" Label="Report" Disabled="@(!canExportReports)" />
                        <QSelect TValue="ReportSubscriptionCadence" TItem="ReportSubscriptionCadence" @bind-Value="sub.Cadence"
                                 Items="@(new[] { ReportSubscriptionCadence.Daily, ReportSubscriptionCadence.Weekly, ReportSubscriptionCadence.Monthly })"
                                 TextSelector="@(x => x.ToString())" Label="How often" Disabled="@(!canExportReports)" />
                        <label>
                            Send at (branch time)
                            <input type="number" min="0" max="23" @bind="sub.SendAtHour" disabled="@(!canExportReports)" />
                        </label>
                    </div>
                    <label class="full-width-label">
                        Send to
                        <input type="text" @bind="sub.Recipients" placeholder="one@school.ac.ug, another@school.ac.ug" disabled="@(!canExportReports)" />
                    </label>
                    @if (sub.LastSentAt.HasValue)
                    {
                        <p class="settings-hint">Last sent @QDateFormat.DT(sub.LastSentAt.Value.ToLocalTime()).</p>
                    }
                </div>
            }

            @if (canExportReports)
            {
                <QButton Text="Add a scheduled report" Icon="plus-lg" Size="sm" Variant="secondary" OnClick="@AddSubscription" />
            }
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showSettingsModal = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SaveSettings" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showPassesModal" Title="Group Passes" Size="md">
    <ChildContent>
        <div class="settings-section">
            <h3>New Pass<QInfo Text="A single QR badge that admits a group (e.g. a contractor crew or tour) — up to the cap you set, checked in/out individually at the scanner." Label="New Pass" /></h3>
            <div class="form-grid">
                <label>Label *<input @bind="newPassRequest.Label" placeholder="e.g. ACME Contractors - Roof Repair" /></label>
                <label>Max Visitors<input type="number" min="1" max="200" @bind="newPassRequest.MaxVisitors" /></label>
                <label>Valid For (hours)<input type="number" min="1" max="168" @bind="newPassRequest.ValidHours" /></label>
            </div>
            <QButton Text="Create Pass" Icon="qr-code" Variant="primary" OnClick="@CreatePass"
                     Disabled="@string.IsNullOrWhiteSpace(newPassRequest.Label)" />
        </div>

        @if (createdPass != null)
        {
            <div class="settings-section">
                <h3>New Pass Created</h3>
                <div class="badge-card">
                    <div id="pass-qr-canvas" class="badge-qr-container"></div>
                    <div class="badge-name">@createdPass.Label</div>
                    <div class="badge-code">Admits up to @createdPass.MaxVisitors, expires @QDateFormat.CDT(createdPass.ExpiresAt.ToLocalTime())</div>
                </div>
                <QButton Text="Print" Icon="printer-fill" Variant="secondary" OnClick="@PrintPass" />
            </div>
        }

        <div class="settings-section">
            <h3>Active Passes</h3>
            @if (passes.Count == 0)
            {
                <p class="settings-hint">No active group passes for this branch.</p>
            }
            else
            {
                @foreach (var pass in passes)
                {
                    <div class="visitor-row">
                        <div>
                            <strong>@pass.Label</strong>
                            <div class="settings-hint">@pass.CurrentVisitors / @pass.MaxVisitors on site &middot; expires @QDateFormat.CDT(pass.ExpiresAt.ToLocalTime())</div>
                        </div>
                        <QButton Text="Revoke" Icon="x-circle" Size="sm" Variant="ghost" OnClick="@(() => RevokePass(pass))" />
                    </div>
                }
            }
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@ClosePassesModal" />
    </FooterContent>
</QModal>

<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="Delete Visitor Record"
               Message="@deleteConfirmMessage"
               ConfirmText="Delete"
               CancelText="Cancel"
               ConfirmButtonClass="btn-danger"
               RequireReason="true"
               ReasonLabel="Reason for deletion *"
               ReasonPlaceholder="e.g. duplicate entry, entered in error, visitor requested removal..."
               @bind-Reason="deleteReason"
               OnClose="@HandleDeleteConfirm" />

<ConfirmDialog IsVisible="@showFlagConfirm"
               Title="@(pendingFlagState ? "Add to Watchlist" : "Remove from Watchlist")"
               Message="@flagConfirmMessage"
               ConfirmText="@(pendingFlagState ? "Flag" : "Unflag")"
               CancelText="Cancel"
               ConfirmButtonClass="@(pendingFlagState ? "btn-danger" : "btn-warning")"
               RequireReason="@pendingFlagState"
               ReasonLabel="Reason *"
               ReasonPlaceholder="Why is this visitor being flagged?"
               @bind-Reason="flagReason"
               OnClose="@HandleToggleWatchlistConfirm" />

