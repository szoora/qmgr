@using QMgr.Web.Components.Shared
@using System.Net.Http.Json
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IJSRuntime JS
@inject IPermissionService PermissionService

@if (!Embedded)
{
    <PageTitle>Customer Links - Q-Mgr</PageTitle>
}

<div class="customer-links-page">
    @if (!Embedded)
    {
<div class="page-header">
            <div class="header-content">
                <h1><i class="bi bi-link-45deg"></i> Customer Links</h1>
                <p class="subtitle">Create and share links for customer-facing features</p>
            </div>
        </div>
    }

    <!-- Branch Selector -->
    <div class="branch-selector-card">
        <QSelect TValue="string" TItem="BranchDto" @bind-Value="selectedBranchId" @bind-Value:after="OnBranchChanged"
                 Items="@branches" ValueSelector="@(b => b.Id.ToString())" TextSelector="@(b => b.Name)"
                 Label="Select Branch" Placeholder="Select a branch" />
    </div>

    @if (!string.IsNullOrEmpty(selectedBranchId))
    {
        <div class="links-grid">
            <!-- Kiosk Link Card -->
            <div class="link-card kiosk">
                <div class="card-icon">
                    <i class="bi bi-tablet"></i>
                </div>
                <div class="card-content">
                    <h3>Self-Service Kiosk</h3>
                    <p>Allow customers to take queue tickets from their own device or a kiosk terminal.</p>
                    <div class="link-preview">
                        <code>@GetKioskUrl()</code>
                    </div>
                </div>
                <div class="card-actions">
                    <QButton Text="Preview" Icon="eye" Variant="secondary" Size="sm" OnClick="@(() => PreviewLink(GetKioskUrl()))" />
                    <QButton Text="Share" Icon="share" Variant="primary" Size="sm" OnClick="@(() => ShareKiosk())" />
                </div>
            </div>

            <!-- Feedback Link Card -->
            <div class="link-card feedback">
                <div class="card-icon">
                    <i class="bi bi-chat-heart"></i>
                </div>
                <div class="card-content">
                    <h3>Customer Feedback</h3>
                    <p>Collect customer feedback and ratings after their service experience.</p>
                    <div class="link-preview">
                        <code>@GetFeedbackUrl()</code>
                    </div>
                </div>
                <div class="card-actions">
                    <QButton Text="Preview" Icon="eye" Variant="secondary" Size="sm" OnClick="@(() => PreviewLink(GetFeedbackUrl()))" />
                    <QButton Text="Share" Icon="share" Variant="primary" Size="sm" OnClick="@(() => ShareFeedback())" />
                </div>
            </div>

            <!-- Queue Display Link Card -->
            <div class="link-card display">
                <div class="card-icon">
                    <i class="bi bi-tv"></i>
                </div>
                <div class="card-content">
                    <h3>Queue Display</h3>
                    <p>Digital signage showing current queue status and called tickets.</p>
                    <div class="link-preview">
                        <code>@GetDisplayUrl()</code>
                    </div>
                </div>
                <div class="card-actions">
                    <QButton Text="Preview" Icon="eye" Variant="secondary" Size="sm" OnClick="@(() => PreviewLink(GetDisplayUrl()))" />
                    <QButton Text="Share" Icon="share" Variant="primary" Size="sm" OnClick="@(() => ShareDisplay())" />
                </div>
            </div>

            <!-- Full-Screen Signage Card -->
            <div class="link-card signage">
                <div class="card-icon">
                    <i class="bi bi-fullscreen"></i>
                </div>
                <div class="card-content">
                    <h3>Full-Screen Signage</h3>
                    <p>Content-only signage screen (playlists, campaigns, banner) with no queue panel.</p>
                    <div class="link-preview">
                        <code>@GetSignageUrl()</code>
                    </div>
                </div>
                <div class="card-actions">
                    <QButton Text="Preview" Icon="eye" Variant="secondary" Size="sm" OnClick="@(() => PreviewLink(GetSignageUrl()))" />
                    <QButton Text="Share" Icon="share" Variant="primary" Size="sm" OnClick="@(() => ShareSignage())" />
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions">
            <h3>Quick Actions</h3>
            <div class="actions-grid">
                <QButton Text="Download All QR Codes" Icon="qr-code" Variant="secondary" OnClick="@DownloadAllQRCodes" />
                <QButton Text="Print Signage" Icon="printer" Variant="secondary" OnClick="@PrintSignage" />
                <QButton Text="Copy All Links" Icon="clipboard" Variant="secondary" OnClick="@CopyAllLinks" />
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-building"></i>
            <h3>Select a Branch</h3>
            <p>Choose a branch to generate customer-facing links</p>
        </div>
    }
</div>

<!-- Share Dialog -->
<ShareDialog @bind-IsVisible="showShareDialog"
             Url="@shareUrl"
             Title="@shareTitle"
             Description="@shareDescription" />

<style>
    .customer-links-page {
        max-width: 1200px;
    }

    .branch-selector-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px 24px;
        margin-bottom: 24px;
    }

    .branch-selector-card label {
        display: block;
        font-size: var(--qm-text-base);
        font-weight: 600;
        color: var(--qm-text-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .branch-selector-card .form-select {
        background: var(--qm-bg-elevated);
        border: 1px solid var(--qm-border);
        color: var(--qm-text-primary);
        padding: 12px 16px;
        border-radius: var(--qm-radius-lg);
        font-size: var(--qm-text-md);
        max-width: 400px;
    }

    .branch-selector-card .form-select:focus {
        border-color: var(--qm-primary);
        box-shadow: 0 0 0 3px var(--qm-primary-light);
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .link-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 24px;
        transition: all 0.3s ease;
    }

    .link-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    }

    .card-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        font-size: var(--qm-text-stat);
    }

    .link-card.kiosk .card-icon {
        background: linear-gradient(135deg, color-mix(in srgb, var(--qm-primary) 20%, transparent), color-mix(in srgb, var(--qm-primary-dark) 20%, transparent));
        color: var(--qm-primary);
    }

    .link-card.feedback .card-icon {
        background: color-mix(in srgb, var(--qm-danger) 15%, transparent);
        color: var(--qm-danger);
    }

    .link-card.display .card-icon {
        background: color-mix(in srgb, var(--qm-success) 15%, transparent);
        color: var(--qm-success);
    }

    .link-card.signage .card-icon {
        background: color-mix(in srgb, var(--qm-warning) 15%, transparent);
        color: var(--qm-warning);
    }

    .card-content h3 {
        margin: 0 0 8px;
        font-size: var(--qm-text-lg);
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .card-content p {
        margin: 0 0 16px;
        font-size: var(--qm-text-base);
        color: var(--qm-text-muted);
        line-height: 1.5;
    }

    .link-preview {
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
        padding: 10px 14px;
        margin-bottom: 16px;
        overflow-x: auto;
    }

    .link-preview code {
        font-family: 'JetBrains Mono', monospace;
        font-size: var(--qm-text-sm);
        color: var(--qm-primary);
        white-space: nowrap;
    }

    .card-actions {
        display: flex;
    }

    /* Quick Actions */
    .quick-actions {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 24px;
    }

    .quick-actions h3 {
        margin: 0 0 16px;
        font-size: var(--qm-text-md);
        font-weight: 600;
        color: var(--qm-text-primary);
    }

    .actions-grid {
        display: flex;
        flex-wrap: wrap;
        gap: var(--q-row-gap);
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .links-grid {
            grid-template-columns: 1fr;
        }

        .card-actions {
            flex-direction: column;
        }

        .actions-grid {
            flex-direction: column;
        }

        .branch-selector-card .form-select {
            max-width: 100%;
        }
    }
</style>

@code {
    /// <summary>True when the Appearance hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private List<BranchDto> branches = new();
    private string selectedBranchId = "";
    private BranchDto? selectedBranch;

    // Share dialog state
    private bool showShareDialog = false;
    private string shareUrl = "";
    private string shareTitle = "";
    private string shareDescription = "";

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.SettingsView))
        {
            NavigationManager.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await LoadBranches();
    }

    private async Task LoadBranches()
    {
        try
        {
            branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/v1/branches?includeInactive=true", JsonOptions) ?? new();
            if (branches.Any())
            {
                selectedBranchId = branches.First().Id.ToString();
                selectedBranch = branches.First();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load branches: {ex.Message}");
        }
    }

    private void OnBranchChanged()
    {
        if (Guid.TryParse(selectedBranchId, out var branchId))
        {
            selectedBranch = branches.FirstOrDefault(b => b.Id == branchId);
        }
        else
        {
            selectedBranch = null;
        }
    }

    private string GetBaseUrl()
    {
        var uri = new Uri(NavigationManager.BaseUri);
        return $"{uri.Scheme}://{uri.Authority}";
    }

    // Route-parameter form of each public URL — the pages resolve the branch as
    // route param -> ?branch= -> (signed-in only) selected branch, with no demo fallback.
    // Kiosk needs the "/branch/" segment because "/kiosk/{IndustryParam}" is a string
    // catch-all that would otherwise swallow a bare GUID as an industry name.
    // Feedback stays query-form: FeedbackEntry (/feedback) only reads ?branch= to label
    // the page; the form itself is keyed by a per-ticket code (/feedback/{code}).
    // There is no ticket-status link: no anonymous per-ticket lookup endpoint exists
    // (QueueController exposes only branch-level status/wait-time; TokensController is
    // [Authorize]), so that card was dropped rather than pointing at a route that
    // doesn't exist.
    private string GetKioskUrl() => $"{GetBaseUrl()}/kiosk/branch/{selectedBranchId}";
    private string GetFeedbackUrl() => $"{GetBaseUrl()}/feedback?branch={selectedBranchId}";
    private string GetDisplayUrl() => $"{GetBaseUrl()}/display/{selectedBranchId}";
    private string GetSignageUrl() => $"{GetBaseUrl()}/display/signage/{selectedBranchId}";

    private void PreviewLink(string url)
    {
        NavigationManager.NavigateTo(url, true);
    }

    // Separate share methods to avoid escape character issues in Razor
    private void ShareKiosk() => ShareLink(GetKioskUrl(), "Self-Service Kiosk", "Join our queue from your phone!");
    private void ShareFeedback() => ShareLink(GetFeedbackUrl(), "Customer Feedback", "Share your feedback with us!");
    private void ShareDisplay() => ShareLink(GetDisplayUrl(), "Queue Display", "View live queue status");
    private void ShareSignage() => ShareLink(GetSignageUrl(), "Full-Screen Signage", "Content-only signage screen");

    private void ShareLink(string url, string title, string description)
    {
        shareUrl = url;
        shareTitle = title;
        shareDescription = description;
        showShareDialog = true;
    }

    /// <summary>The four public links this branch has, in the order they appear on the page.</summary>
    private (string Title, string Hint, string Url)[] PublicLinks() => new[]
    {
        ("Self-Service Kiosk", "Scan to take a ticket", GetKioskUrl()),
        ("Customer Feedback", "Scan to tell us how we did", GetFeedbackUrl()),
        ("Queue Display", "Scan to follow the queue on your phone", GetDisplayUrl()),
        ("Full-Screen Signage", "Scan to open the signage screen", GetSignageUrl())
    };

    /// <summary>
    /// One PNG per link, generated in the browser by the qrcodejs already loaded app-wide for
    /// visitor badges — no new dependency, and no server round trip for something the page already
    /// knows the URLs of.
    /// </summary>
    /// <remarks>
    /// Four separate files rather than one contact sheet, because that is what the button says and
    /// what the files are for: dropping into a poster, a letter or a door sticker individually.
    /// Browsers ask permission before a page saves several files at once, so the toast warns about
    /// it rather than leaving the user thinking three of the four silently failed.
    /// </remarks>
    private async Task DownloadAllQRCodes()
    {
        if (string.IsNullOrEmpty(selectedBranchId)) return;

        var slug = Slugify(selectedBranch?.Name ?? "branch");
        var saved = 0;

        foreach (var (title, _, url) in PublicLinks())
        {
            var dataUrl = await JS.InvokeAsync<string?>("visitorBadge.getQrDataUrl", url);
            if (string.IsNullOrEmpty(dataUrl)) continue;

            await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, $"qr-{slug}-{Slugify(title)}.png");
            saved++;
        }

        NotificationService.Notify(
            saved == 0 ? ToastSeverity.Error : ToastSeverity.Success,
            saved == 0 ? "Couldn't generate the codes" : "QR codes downloaded",
            saved == 0
                ? "The QR generator didn't load. Refresh the page and try again."
                : $"{saved} PNG files saved. Your browser may ask you to allow multiple downloads.");
    }

    /// <summary>
    /// A printable A5 card per link — branch name, what the code is for, the QR, and the URL in
    /// text underneath for anyone who would rather type it. Goes through the same
    /// QMgrPrint.browserPrint the ticket and roster printing already use.
    /// </summary>
    private async Task PrintSignage()
    {
        if (string.IsNullOrEmpty(selectedBranchId)) return;

        var cards = new List<string>();
        foreach (var (title, hint, url) in PublicLinks())
        {
            var qr = await JS.InvokeAsync<string?>("visitorBadge.getQrDataUrl", url);
            if (string.IsNullOrEmpty(qr)) continue;

            cards.Add($"""
                <section class="card">
                    <h1>{System.Net.WebUtility.HtmlEncode(selectedBranch?.Name ?? "")}</h1>
                    <h2>{System.Net.WebUtility.HtmlEncode(title)}</h2>
                    <img src="{qr}" alt="" />
                    <p class="hint">{System.Net.WebUtility.HtmlEncode(hint)}</p>
                    <p class="url">{System.Net.WebUtility.HtmlEncode(url)}</p>
                </section>
                """);
        }

        if (cards.Count == 0)
        {
            NotificationService.Notify(ToastSeverity.Error, "Couldn't build the signage",
                "The QR generator didn't load. Refresh the page and try again.");
            return;
        }

        // Black on white, no theme tokens: this is going onto paper, where the app's dark palette
        // would print as a solid block of ink.
        // $$ so that single braces are literal CSS and {{...}} is the interpolation — a raw string
        // literal does not use doubled braces as an escape the way "..." does.
        var html = $$"""
            <html><head><meta charset="utf-8"><title>Signage</title><style>
                @page { size: A5; margin: 12mm; }
                body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; color: #000; }
                .card { page-break-after: always; text-align: center; padding: 8mm 0; }
                .card:last-child { page-break-after: auto; }
                h1 { font-size: 20pt; margin: 0 0 2mm; }
                h2 { font-size: 14pt; font-weight: 600; margin: 0 0 6mm; color: #333; }
                img { width: 70mm; height: 70mm; }
                .hint { font-size: 13pt; margin: 6mm 0 2mm; }
                .url { font-size: 9pt; color: #555; word-break: break-all; margin: 0 8mm; }
            </style></head><body>{{string.Join("", cards)}}</body></html>
            """;

        await JS.InvokeVoidAsync("QMgrPrint.browserPrint", html, true);
    }

    /// <summary>Filename-safe, lower case, no runs of dashes.</summary>
    private static string Slugify(string value)
    {
        var chars = value.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray();
        return string.Join('-', new string(chars).Split('-', StringSplitOptions.RemoveEmptyEntries));
    }

    private async Task CopyAllLinks()
    {
        var links = $"Self-Service Kiosk: {GetKioskUrl()}\n" +
                    $"Customer Feedback: {GetFeedbackUrl()}\n" +
                    $"Queue Display: {GetDisplayUrl()}\n" +
                    $"Full-Screen Signage: {GetSignageUrl()}";

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", links);
            NotificationService.Notify(ToastSeverity.Success, "Copied", "All links copied to clipboard!");
        }
        catch
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to copy links");
        }
    }

    // DTOs
    private record BranchDto
    {
        public Guid Id { get; init; }
        public string Name { get; init; } = "";
    }
}
