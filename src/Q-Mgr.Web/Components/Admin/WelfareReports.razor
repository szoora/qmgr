@page "/admin/welfare-reports"
@implements IAsyncDisposable
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IStudentApiService StudentApi
@inject INotificationClientService NotificationClient
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Services

<PageTitle>Welfare Reports - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Welfare Reports</h1>
            <p class="subtitle">
                @if (scopedClasses.Any())
                {
                    <text>Dashboard overview and searchable records for the classes you hold.</text>
                }
                else
                {
                    <text>Dashboard overview and searchable records across the whole branch.</text>
                }
            </p>
        </div>
        <div class="header-actions">
            @* Both withheld from a class-scoped caller, for one reason with two faces: the API
               refuses the import outright (it writes rows for any student in the file, and the
               processor runs in a Hangfire worker where the row-level scope cannot be enforced),
               so the Import button would only produce a 403 — and since they can never START an
               import, the history endpoint scopes to "jobs you began yourself" and always answers
               with an empty list. A button that opens a permanently empty modal reads as a broken
               feature, not as an absent permission. Found in the browser 2026-09-13. *@
            @if (!scopedClasses.Any())
            {
                <QButton Text="Import History" Icon="clock-history" Variant="secondary" OnClick="@OpenHistoryModal" />
            }
            @if (canImport && !scopedClasses.Any())
            {
                <QButton Text="Import Records" Icon="file-earmark-spreadsheet" Variant="secondary" OnClick="@OpenImportModal"
                         Title="Backfill historical achievement / behavior / welfare records from a spreadsheet" />
            }
        </div>
    </div>

    @* Every figure on this page is already narrowed server-side for a class-scoped role. Saying so
       is the point: a form tutor reading their own class's total as the school's is a wrong
       conclusion drawn from a correct query, and nothing here used to say which it was. *@
    @if (scopedClasses.Any())
    {
        <div class="wr-scope-note">
            <QIcon Name="funnel-fill" />
            <span>
                These figures cover <strong>@string.Join(", ", scopedClasses)</strong> only —
                the class@(scopedClasses.Count == 1 ? "" : "es") you hold. They are not
                branch-wide totals.
            </span>
        </div>
    }

    <QTabs Tabs="@ReportTabs" ActiveKey="@activeTab" ActiveKeyChanged="@SwitchTab" AriaLabel="Welfare report sections" />

    @if (activeTab == "dashboard")
    {
        <QFilterBar>
            <QDateRangePicker Range="@dashboardRange" RangeChanged="@OnDashboardRangeChanged" ShowCaption="false" />
            <QButton Text="Apply" Icon="funnel-fill" Variant="secondary" OnClick="@LoadSummary" />
        </QFilterBar>

        @if (isLoadingSummary)
        {
            <div class="loading-container"><QSpinner Size="lg" /><span>Loading dashboard...</span></div>
        }
        else if (summary != null)
        {
            <QStatRow>
                <QStatTile Value="@summary.TotalRecords.ToString()" Label="Total Records" />
                <QStatTile Value="@summary.OpenActionsCount.ToString()" Label="Open / In Progress" />
                <QStatTile Value="@summary.OverdueActionsCount.ToString()" Label="Overdue Actions" Variant="danger" />
            </QStatRow>

            <div class="report-columns">
                <div class="report-panel">
                    <h3>By Category</h3>
                    <QBarList Items="@CategoryBars" EmptyText="No records in this range." />
                </div>
                <div class="report-panel">
                    <h3>By Staff (Consistency Check)</h3>
                    <p class="form-hint">Who's logging what, and how often — a school's own process-consistency check, not an evaluation of any one student group.</p>
                    <QBarList Items="@StaffBars" EmptyText="No records in this range." />
                </div>
            </div>
        }
    }
    else if (activeTab == "search")
    {
        <QFilterBar Wrap="true">
            <input class="search-input" @bind="searchKeyword" @bind:event="oninput" placeholder="Search description or action taken..." />
            <QDateRangePicker Range="@searchRange" RangeChanged="@OnSearchRangeChanged" ShowCaption="false" ShowPresets="false" />
            <QSelect TValue="WelfareCaseType?" TItem="(string Label, WelfareCaseType? Value)" Value="@searchCaseType" Items="@caseTypeFilterOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Label="Case Type" ValueChanged="@(v => searchCaseType = v)" />
            <QSelect TValue="WelfareStatus?" TItem="(string Label, WelfareStatus? Value)" Value="@searchStatus" Items="@statusFilterOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Label="Status" ValueChanged="@(v => searchStatus = v)" />
            <QButton Text="Search" Icon="search" Variant="primary" OnClick="@LoadSearch" />
            @* The shared export replaces this page's own CSV writer — same rows, four formats,
               and a column list that cannot drift from the one the workbook uses. *@
            <QDataExport TItem="WelfareRecordDto"
                         Title="Welfare records"
                         FileStem="welfare-records"
                         Subtitle="@ExportSubtitle"
                         Columns="@WelfareExportColumns"
                         RowProvider="@ProvideExportRowsAsync"
                         Disabled="@(!VisibleSearchResults.Any())"
                         DisabledReason="Nothing matches the current filters." />
        </QFilterBar>

        @* Arriving from a dashboard tile applies a filter the filter bar above can't express, so
           it is shown as a removable chip. A filter you can't see is a bug report waiting to
           happen — "the search is missing records" — and this is the fix for that. *@
        @if (dueView != null)
        {
            <div class="due-view-row">
                <QChip Icon="funnel-fill" Removable="true" OnRemove="@ClearDueView" RemoveLabel="Clear this filter">
                    <span>Showing <strong>@DueViewLabel</strong> only — @VisibleSearchResults.Count of @searchResults.Count records</span>
                </QChip>
            </div>
        }

        @if (isLoadingSearch)
        {
            <div class="loading-container"><QSpinner Size="lg" /><span>Searching...</span></div>
        }
        else if (!VisibleSearchResults.Any())
        {
            <div class="empty-state">
                <QIcon Name="search" Size="xl" />
                <h3>No matching records</h3>
                <p>Try widening the date range or clearing a filter.</p>
            </div>
        }
        else
        {
            @* Same bar as the roster, same dialog, same pipeline behind it — a welfare record is
               a different noun over identical machinery. *@
            @if (selectedRecordIds.Count > 0 && CanBatch)
            {
                <div class="batch-bar">
                    <span class="batch-bar-count"><QIcon Name="check2-square" /> <strong>@selectedRecordIds.Count.ToString("N0")</strong> selected</span>

                    <QButton Text="Assign to…" Icon="person-check" Size="sm" Variant="primary"
                             OnClick="@OpenAssignPrompt"
                             Title="Give every selected record the same owner for its follow-up action" />

                    <QButton Text="Set review date" Icon="calendar-check" Size="sm" Variant="secondary"
                             OnClick="@(() => showReviewPrompt = true)" />

                    <div class="dropdown">
                        <QButton Text="Set status" Icon="flag" Size="sm" Variant="secondary"
                                 data-bs-toggle="dropdown" aria-expanded="false" />
                        <ul class="dropdown-menu batch-menu">
                            @foreach (var st in BatchStatuses)
                            {
                                <li><button type="button" class="dropdown-item" @onclick="@(() => RunStatusBatch(st))">@st</button></li>
                            }
                        </ul>
                    </div>

                    <button type="button" class="batch-clear" @onclick="@(() => selectedRecordIds.Clear())">Clear selection</button>
                </div>
            }

            <div class="results-table">
                <div class="results-row results-header">
                    <span class="results-select">
                        @if (CanBatch)
                        {
                            <input type="checkbox" checked="@AllVisibleSelected"
                                   @onchange="@(e => ToggleSelectAll((bool)(e.Value ?? false)))"
                                   title="Select every record matching the current filters" />
                        }
                    </span>
                    <span>Student</span><span>Category</span><span>Tier</span><span>Status</span><span>Occurred</span><span>Reported By</span><span></span>
                </div>
                @foreach (var r in VisibleSearchResults)
                {
                    <div class="results-row">
                        <span class="results-select">
                            @if (CanBatch)
                            {
                                <input type="checkbox" checked="@selectedRecordIds.Contains(r.Id)"
                                       @onchange="@(e => ToggleSelection(r.Id, (bool)(e.Value ?? false)))" />
                            }
                        </span>
                        <span class="results-student">@r.StudentName</span>
                        <span>@r.CategoryName</span>
                        <span class="tier-badge tier-badge--@r.Tier.ToString().ToLowerInvariant()">@r.Tier</span>
                        <QChip Text="@r.Status.ToString()" Size="sm" Color="@WelfareDisplay.StatusColor(r.Status)" Class="results-chip" />
                        <span>@QDateFormat.D(r.OccurredAt.ToLocalTime())</span>
                        <span>@r.ReportedByName</span>
                        <span class="results-actions">
                            <QButton Icon="eye-fill" Size="sm" Variant="ghost" Title="View timeline" OnClick="@(() => Navigation.NavigateTo($"/admin/students/{r.StudentId}/welfare"))" />
                            <QButton Icon="printer-fill" Size="sm" Variant="ghost" Title="Print incident pack" OnClick="@(() => PrintRecord(r))" />
                        </span>
                    </div>
                }
            </div>
        }
    }


@* ---------------- Cohorts & disproportionality ---------------- *@
@if (activeTab == "cohorts")
{
    <QFilterBar>
        <QSelect TValue="int" TItem="WindowOption" @bind-Value="cohortDays" Items="@windowOptions"
                 TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)" Label="Window" />
        <QButton Text="Run" Icon="arrow-repeat" Variant="primary" OnClick="@LoadCohorts" Loading="@isLoadingCohorts" />
    </QFilterBar>

    <div class="cohort-note">
        <span>Counts show volume. The <strong>punitive</strong> share is the number worth watching.</span>
    </div>

    @if (isLoadingCohorts)
    {
        <div class="loading-container"><QSpinner Size="lg" /><span>Running...</span></div>
    }
    else if (cohorts == null)
    {
        <div class="empty-state">
            <QIcon Name="bar-chart-steps" Size="xl" />
            <h3>Nothing run yet</h3>
            <p>Choose a window and press Run.</p>
        </div>
    }
    else if (cohorts.TotalRecords == 0)
    {
        <div class="empty-state">
            <QIcon Name="bar-chart-steps" Size="xl" />
            <h3>No records in that window</h3>
            <p>Nothing was logged in the last @cohorts.WindowDays days.</p>
        </div>
    }
    else
    {
        <div class="cohort-grid">
            @RenderCohort("By house", cohorts.ByHouse)
            @RenderCohort("By residency", cohorts.ByResidency)
            @RenderCohort("By sex", cohorts.BySex)
            @RenderCohort("By fees status", cohorts.ByFeesStatus)
        </div>
    }
}
</div>

@* ---------------- Import Historical Records ---------------- *@
@*
    Deliberately the same modal shape as StudentRoster.razor's Bulk Import (file input → preview →
    start → live progress → row-by-row log): it's the same background job, the same
    RosterImportProgress SignalR event and the same entries log — only the row columns differ.
*@
@* Both of these collect the one value the batch needs before there is anything to preview. *@
<QModal @bind-Visible="showAssignPrompt" Title="Assign follow-up to" Size="sm">
    <ChildContent>
        <p class="form-hint">
            Every selected record's follow-up action moves to this person. Their existing owner is
            replaced — you'll see exactly which records change before anything is saved.
        </p>
        <QSelect TValue="Guid?" TItem="StaffOption" Value="@assignTargetUserId" Items="@staffOptions"
                 TextSelector="@(x => x.Name)" ValueSelector="@(x => (Guid?)x.Id)"
                 Label="Staff member" ValueChanged="@(v => assignTargetUserId = v)" />
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showAssignPrompt = false)" />
        <QButton Text="Preview" Icon="arrow-right" Variant="primary" OnClick="@ConfirmAssign" Disabled="@(assignTargetUserId is null)" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showReviewPrompt" Title="Set a review date" Size="sm">
    <ChildContent>
        <p class="form-hint">
            The overdue-action reminder job already watches this date, so setting it here puts every
            selected record back into that sweep.
        </p>
        <QDatePicker @bind-Value="@reviewDateValue" Label="Review by" />
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showReviewPrompt = false)" />
        <QButton Text="Preview" Icon="arrow-right" Variant="primary" OnClick="@ConfirmReviewDate" Disabled="@(reviewDateValue is null)" />
    </FooterContent>
</QModal>

<QBatchDialog @ref="batchDialog" BranchId="@branchId" OnQueued="@OnBatchQueued" />

<QModal @bind-Visible="showImportModal" Title="Import Historical Records" Size="lg">
    <ChildContent>
        @if (importJob == null)
        {
            <div class="import-upload">
                <p>
                    Upload an Excel (.xlsx/.xls) or CSV export of your previous system's ledger with columns for
                    <strong>student code</strong>, <strong>case type</strong> (Achievement / Behavior / Welfare),
                    <strong>category</strong> (must already exist under Welfare Categories), <strong>date</strong> and
                    <strong>description</strong>; optionally points, tier, action taken and status. Column order doesn't
                    matter and common header variations are recognized. Students are matched by code — import the roster first.
                    Imported records default to <em>Resolved</em> and are attributed to you as the importer.
                </p>
                <input type="file" id="welfare-file-input" accept=".xlsx,.xls,.csv" @onchange="OnFileSelected" />

                @if (isParsingFile)
                {
                    <div class="loading-container loading-container--inline"><QSpinner Size="sm" /><span>Reading file...</span></div>
                }
                else if (headerErrors.Any())
                {
                    <div class="import-errors">
                        <strong>Couldn't read this file:</strong>
                        <ul>
                            @foreach (var err in headerErrors)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                else if (parsedRows.Any())
                {
                    <div class="import-preview">
                        <p><strong>@parsedRows.Count</strong> row@(parsedRows.Count == 1 ? "" : "s") parsed from <strong>@parsedFileName</strong>. First few rows:</p>
                        <div class="import-preview-table">
                            <div class="import-preview-row import-preview-header">
                                <span>Code</span><span>Case Type</span><span>Category</span><span>Date</span><span>Tier</span><span>Points</span><span>Description</span>
                            </div>
                            @foreach (var r in parsedRows.Take(5))
                            {
                                <div class="import-preview-row">
                                    <span>@r.StudentCode</span><span>@r.CaseType</span><span>@r.Category</span><span>@r.OccurredAt</span>
                                    <span>@r.Tier</span><span>@r.Points</span><span title="@r.Description">@r.Description</span>
                                </div>
                            }
                            @if (parsedRows.Count > 5)
                            {
                                <p class="import-preview-more">+ @(parsedRows.Count - 5) more row@(parsedRows.Count - 5 == 1 ? "" : "s")</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="import-progress">
                <div class="import-progress-header">
                    <span class="import-status-badge @importJob.Status.ToString().ToLower()">@importJob.Status</span>
                    <span>@importJob.ProcessedRows / @importJob.TotalRows rows processed</span>
                </div>
                <div class="import-progress-bar">
                    <div class="import-progress-fill" style="width: @(importJob.TotalRows > 0 ? (importJob.ProcessedRows * 100 / importJob.TotalRows) : 0)%"></div>
                </div>
                <div class="import-summary-grid">
                    <div class="import-summary-tile created"><span class="value">@importJob.CreatedCount</span><span class="label">Created</span></div>
                    <div class="import-summary-tile duplicate"><span class="value">@importJob.DuplicateCount</span><span class="label">Duplicates</span></div>
                    <div class="import-summary-tile failed"><span class="value">@importJob.FailedCount</span><span class="label">Failed</span></div>
                </div>
                @if (importJob.Status == RosterImportStatus.Failed && !string.IsNullOrWhiteSpace(importJob.FailureReason))
                {
                    <div class="import-errors">@importJob.FailureReason</div>
                }

                @if (importJob.Status == RosterImportStatus.Completed || importJob.Status == RosterImportStatus.CompletedWithErrors)
                {
                    <QButton Text="@(showImportEntries ? "Hide Row-by-Row Log" : "View Row-by-Row Log")" Icon="list-ul" Variant="secondary" OnClick="@ToggleImportEntries" />
                    @if (showImportEntries)
                    {
                        <div class="import-log">
                            @foreach (var entry in importEntries)
                            {
                                <div class="import-log-row outcome-@ImportOutcomeDisplay.CssModifier(entry.Outcome)">
                                    <span class="import-log-rownum">#@entry.RowNumber</span>
                                    <span class="import-log-outcome">@ImportOutcomeDisplay.Label(entry.Outcome)</span>
                                    @* For a welfare job the entry's GuardianName column carries the category name. *@
                                    <span class="import-log-name">@(entry.StudentName ?? entry.StudentCode ?? "—") / @(entry.GuardianName ?? "—")</span>
                                    <span class="import-log-message" title="@entry.Message">@entry.Message</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (importJob == null)
        {
            <QButton Text="Cancel" Variant="ghost" OnClick="@CloseImportModal" />
            <QButton Text="@($"Start Import{(parsedRows.Any() ? $" ({parsedRows.Count} rows)" : "")}")" Icon="upload" Variant="primary"
                     OnClick="@StartImport" Disabled="@(!parsedRows.Any() || isStartingImport)" />
        }
        else
        {
            <QButton Text="Close" Variant="primary" OnClick="@CloseImportModal" />
        }
    </FooterContent>
</QModal>

@* ---------------- Import History ---------------- *@
<QModal @bind-Visible="showHistoryModal" Title="Record Import History" Size="lg">
    <ChildContent>
        @if (!historyJobs.Any())
        {
            <p class="form-hint">No historical-record imports yet.</p>
        }
        else
        {
            <div class="import-log">
                @foreach (var job in historyJobs)
                {
                    <div class="import-log-row outcome-@(job.FailedCount > 0 ? "failed" : "created")">
                        <span class="import-log-rownum">@QDateFormat.CDT(job.CreatedAt.ToLocalTime())</span>
                        <span class="import-log-outcome">@job.Status</span>
                        <span class="import-log-name">@(job.SourceFileName ?? "Unnamed upload")</span>
                        <span class="import-log-message">@job.TotalRows rows &middot; @job.CreatedCount created &middot; @job.DuplicateCount duplicate &middot; @job.FailedCount failed</span>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@(() => showHistoryModal = false)" />
    </FooterContent>
</QModal>

<style>
    /* ---------------- Cohorts ---------------- */

    .cohort-note {
        display: flex; align-items: flex-start; gap: 9px;
        padding: 11px 14px; margin-bottom: 16px;
        border-radius: var(--qm-radius-sm);
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        font-size: 12.5px; line-height: 1.55;
    }

    .cohort-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 16px;
    }

    .cohort-panel {
        padding: 16px 18px;
        border-radius: var(--qm-radius-md);
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        animation: cohortIn .3s ease both;
    }

    .cohort-grid > .cohort-panel:nth-child(2) { animation-delay: .05s; }
    .cohort-grid > .cohort-panel:nth-child(3) { animation-delay: .10s; }
    .cohort-grid > .cohort-panel:nth-child(4) { animation-delay: .15s; }

    .cohort-panel h3 { margin: 0 0 12px; font-size: 14px; }

    .cohort-share {
        font-size: 11.5px;
        color: var(--qm-text-muted);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    /* The only conditional colour on this screen. It marks a slice worth looking at, and it is
       deliberately not red — the report raises a question about practice, it does not accuse. */
    .cohort-share.high {
        color: var(--qm-accent-orange);
        font-weight: 600;
    }

    @@keyframes cohortIn {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .cohort-panel { animation: none !important; }
    }

    .admin-page { padding: 0; }
    .page-header { margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; }
    .header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* Import modal — same classes/tokens as StudentRoster.razor's Bulk Import so the two read as one feature. */
    .loading-container--inline { padding: 16px; flex-direction: row; gap: 10px; border: none; background: none; }
    .import-upload p { font-size: 13px; color: var(--qm-text-secondary); margin: 0 0 8px; line-height: 1.5; }
    .import-upload input[type=file] { margin: 12px 0; display: block; color: var(--qm-text-primary); }
    .import-errors { background: rgba(220, 38, 38, 0.08); border: 1px solid var(--qm-danger, #dc2626); border-radius: var(--qm-radius-md); padding: 12px 16px; color: var(--qm-danger, #dc2626); font-size: 13px; margin-top: 12px; }
    .import-errors ul { margin: 6px 0 0; padding-left: 18px; }
    .import-preview { margin-top: 16px; font-size: 13px; color: var(--qm-text-primary); }
    .import-preview-table { border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); overflow: hidden; margin-top: 8px; }
    .import-preview-row { display: grid; grid-template-columns: 0.8fr 0.9fr 1fr 0.9fr 0.6fr 0.5fr 2fr; gap: 8px; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid var(--qm-border); overflow: hidden; }
    .import-preview-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .import-preview-row:last-child { border-bottom: none; }
    .import-preview-header { background: var(--qm-bg-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; color: var(--qm-text-muted); }
    .import-preview-more { text-align: center; padding: 8px; color: var(--qm-text-muted); font-size: 12px; margin: 0; }
    .import-progress-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 14px; color: var(--qm-text-primary); }
    .import-status-badge { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; padding: 3px 10px; border-radius: 999px; background: var(--qm-bg-secondary); color: var(--qm-text-muted); }
    .import-status-badge.processing, .import-status-badge.pending { background: rgba(169, 120, 31, 0.15); color: #a9781f; }
    .import-status-badge.completed { background: rgba(63, 125, 88, 0.15); color: #3f7d58; }
    .import-status-badge.completedwitherrors, .import-status-badge.failed { background: rgba(217, 83, 79, 0.12); color: var(--qm-danger, #d9534f); }
    .import-progress-bar { height: 8px; background: var(--qm-bg-secondary); border-radius: 999px; overflow: hidden; margin-bottom: 16px; }
    .import-progress-fill { height: 100%; background: var(--qm-primary); transition: width 0.3s ease; }
    .import-summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 16px; }
    .import-summary-tile { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px; border-radius: var(--qm-radius-md); background: var(--qm-bg-secondary); }
    .import-summary-tile .value { font-size: 22px; font-weight: 700; color: var(--qm-text-primary); }
    .import-summary-tile .label { font-size: 12px; color: var(--qm-text-muted); }
    .import-summary-tile.failed .value { color: var(--qm-danger, #d9534f); }
    .import-summary-tile.duplicate .value { color: #a9781f; }
    .import-summary-tile.created .value { color: #3f7d58; }
    .import-log { max-height: 360px; overflow-y: auto; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); margin-top: 12px; }
    .import-log-row { display: grid; grid-template-columns: 100px 110px 1fr 2fr; gap: 10px; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid var(--qm-border); align-items: center; color: var(--qm-text-primary); }
    .import-log-row:last-child { border-bottom: none; }
    .import-log-rownum { font-family: monospace; color: var(--qm-text-muted); white-space: nowrap; }
    .import-log-outcome { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .outcome-created .import-log-outcome { color: #3f7d58; }
    .outcome-updated .import-log-outcome { color: var(--qm-primary); }
    .outcome-duplicateinfile .import-log-outcome { color: #a9781f; }
    .outcome-alreadyexists .import-log-outcome { color: #7a6a55; }
    .outcome-failed .import-log-outcome { color: var(--qm-danger, #d9534f); }
    .import-log-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .import-log-message { color: var(--qm-text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .header-content h1 { margin: 0 0 4px; font-size: 28px; color: var(--qm-text-primary); }
    .subtitle { margin: 0; color: var(--qm-text-muted); font-size: 14px; }

    /* Deliberately quiet — a standing fact about the caller's role, not a problem to fix. Tinted
       from --qm-primary-rgb so it follows the theme without a [data-theme="light"] override. */
    .wr-scope-note {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 11px 14px;
        margin-bottom: 16px;
        border: 1px solid var(--qm-border);
        border-left: 3px solid var(--qm-primary);
        border-radius: var(--qm-radius-md);
        background: rgba(var(--qm-primary-rgb), 0.07);
        font-size: 13px;
        line-height: 1.5;
        color: var(--qm-text-secondary);
    }
    .wr-scope-note i, .wr-scope-note span:first-child { color: var(--qm-primary); flex-shrink: 0; margin-top: 2px; }
    .wr-scope-note strong { color: var(--qm-text-primary); }

    /* Tabs, filter bars, stat tiles, bar lists and status chips are the shared Q* components in
       q-components.css; this block keeps only what is particular to this page. */
    .due-view-row { display: flex; margin-bottom: 12px; }
    .due-view-row .q-chip { max-width: 100%; white-space: normal; }
    .search-input { flex: 1; min-width: 220px; padding: 10px 14px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); background: var(--qm-bg-card); color: var(--qm-text-primary); align-self: stretch; }

    .loading-container, .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: var(--qm-text-muted); background: var(--qm-bg-card); border-radius: var(--qm-radius-xl); border: 1px solid var(--qm-border); }
    .empty-state .rzi { font-size: 64px; margin-bottom: 16px; color: var(--qm-primary); }
    .empty-state h3 { margin: 0 0 8px; color: var(--qm-text-primary); }
    .empty-state p { margin: 0; }

    .report-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; }
    .report-panel { background: var(--qm-bg-card); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-lg); padding: 18px; }
    .report-panel h3 { margin: 0 0 12px; font-size: 15px; color: var(--qm-text-primary); }
    .form-hint { font-size: 12px; color: var(--qm-text-muted); margin: 0 0 10px; }

    .results-table { background: var(--qm-bg-card); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-lg); overflow: hidden; }
    .batch-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; background: var(--qm-primary-light); border: 1px solid var(--qm-primary); border-radius: var(--qm-radius-md); padding: 10px 14px; margin-bottom: 16px; }
    .batch-bar-count { display: flex; align-items: center; gap: 7px; font-size: 14px; }
    .batch-bar-count strong { font-variant-numeric: tabular-nums; }
    .batch-bar .dropdown { display: inline-flex; }
    .batch-menu { min-width: 190px; padding: 6px; border: 1px solid var(--qm-border); border-radius: var(--qm-radius-md); background: var(--qm-bg-card); box-shadow: var(--qm-shadow-md); }
    .batch-menu .dropdown-item { display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px; border: none; background: none; border-radius: var(--qm-radius-sm); font-size: 13px; text-align: left; color: var(--qm-text-primary); cursor: pointer; }
    .batch-menu .dropdown-item:hover, .batch-menu .dropdown-item:focus-visible { background: var(--qm-primary-light); }
    .batch-clear { margin-left: auto; background: none; border: none; padding: 2px 6px; cursor: pointer; font: inherit; font-size: 13px; color: var(--qm-text-muted); text-decoration: underline; }
    .results-select { display: flex; align-items: center; }
    .results-select input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }

    .results-row { display: grid; grid-template-columns: auto 1.3fr 1.3fr 0.8fr 1fr 1fr 1.2fr auto; gap: 10px; padding: 12px 16px; align-items: center; border-bottom: 1px solid var(--qm-border); font-size: 13px; }
    .results-row:last-child { border-bottom: none; }
    .results-header { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--qm-text-muted); background: var(--qm-bg-secondary); font-weight: 600; }
    .results-student { font-weight: 600; color: var(--qm-text-primary); }
    .results-actions { display: flex; flex-wrap: wrap; gap: 4px; justify-self: end; }

    .tier-badge { font-size: 10px; text-transform: uppercase; letter-spacing: .03em; padding: 2px 7px; border-radius: 999px; background: var(--qm-bg-secondary); color: var(--qm-text-muted); justify-self: start; }
    .tier-badge--high { background: rgba(220, 38, 38, 0.12); color: var(--qm-danger, #dc2626); }
    .tier-badge--medium { background: rgba(217, 119, 6, 0.12); color: var(--qm-accent-orange, #d97706); }
    .tier-badge--low { background: rgba(22, 163, 74, 0.12); color: var(--qm-accent-green, #16a34a); }

    .results-chip { justify-self: start; }

    @@media (max-width: 900px) {
        .results-row { grid-template-columns: 1fr 1fr; }
        .results-header { display: none; }
        .import-preview-row { grid-template-columns: 1fr 1fr; }
        .import-log-row { grid-template-columns: 1fr; }
    }
</style>

@code {
    /// <summary>Which tab to open on. The dashboard's stat tiles link straight here.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    /// <summary>
    /// A view filter over the search results: "open" for anything not resolved, "overdue" for
    /// those of them past their due date. Neither is a server-side filter — `SearchRecords` has no
    /// notion of overdue — so both are applied here over the rows it returns.
    ///
    /// They exist so the dashboard's "Open actions" and "Overdue" tiles can open a list that
    /// actually holds the number printed on them: these two predicates are word for word what
    /// WelfareController.GetSummary counts for OpenActionsCount and OverdueActionsCount.
    /// </summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }

    private Guid branchId;
    private string activeTab = "dashboard";

    /// <summary>Null, "open" or "overdue" — see ViewParam.</summary>
    private string? dueView;

    /// <summary>The rows rendered by the search tab, after the due-view filter.</summary>
    private List<WelfareRecordDto> VisibleSearchResults => dueView switch
    {
        "open" => searchResults.Where(IsOpen).ToList(),
        "overdue" => searchResults.Where(IsOverdue).ToList(),
        _ => searchResults
    };

    private static bool IsOpen(WelfareRecordDto r) => r.Status != WelfareStatus.Resolved;

    private static bool IsOverdue(WelfareRecordDto r) =>
        IsOpen(r) && r.ActionDueDate.HasValue && r.ActionDueDate.Value < DateTime.UtcNow;

    private string DueViewLabel => dueView switch
    {
        "open" => "Open (not resolved)",
        "overdue" => "Overdue",
        _ => ""
    };

    /// <summary>Drops the filter and the query string with it, so a refresh doesn't bring it back.</summary>
    private void ClearDueView()
    {
        dueView = null;
        Navigation.NavigateTo("/admin/welfare-reports?tab=search", replace: true);
    }

    // ---------------- Dashboard ----------------
    private bool isLoadingSummary;
    private DateRange dashboardRange = DateRange.LastDays(30);

    // The existing query path takes nullable DateTimes; the range above is what the shared control
    // binds to and both stay in step through OnDashboardRangeChanged.
    private DateTime? dashboardFrom;
    private DateTime? dashboardTo;
    private WelfareSummaryDto? summary;

    /// <summary>
    /// The classes the caller's row-level scope narrows every figure on this page to. Empty for an
    /// unscoped role. Read off the summary response rather than fetched separately — the server is
    /// the only thing that knows the caller's DataScope, and it is already answering.
    /// </summary>
    private List<string> scopedClasses = new();

    // ---------------- Cohorts ----------------
    private bool isLoadingCohorts;
    private int cohortDays = 90;
    private WelfareCohortReportDto? cohorts;

    private sealed record WindowOption(int Value, string Label);

    private readonly List<WindowOption> windowOptions = new()
    {
        new(30, "Last 30 days"),
        new(90, "Last term (90 days)"),
        new(180, "Last 180 days"),
        new(365, "Last year")
    };

    private async Task LoadCohorts()
    {
        isLoadingCohorts = true;
        try
        {
            cohorts = await Http.GetFromJsonAsync<WelfareCohortReportDto>(
                $"api/v1/branches/{branchId}/welfare/cohorts?days={cohortDays}", JsonOptions);
        }
        catch (Exception)
        {
            cohorts = null;
            NotificationService.Notify(ToastSeverity.Error, "Could not run", "The cohort report failed to load.");
        }
        finally
        {
            isLoadingCohorts = false;
        }
    }

    /// <summary>
    /// One slice table. The bar length is the record count; the punitive share sits beside it as a
    /// number rather than a second bar, because two bars invite reading them as a ratio to each
    /// other when only one of them is a rate.
    /// </summary>
    private RenderFragment RenderCohort(string title, List<CohortSliceDto> slices) =>
        @<div class="cohort-panel">
            <h3>@title</h3>
            <QBarList Items="@slices.Select(s => new QBarItem(s.Label, s.TotalRecords, Tag: s)).ToList()"
                      MinPercent="0"
                      EmptyText="Nothing to group.">
                <RowSuffix Context="item">
                    @{
                        var s = (CohortSliceDto)item.Tag!;
                    }
                    @* Above a third of a group's records ending in punishment is worth a second look;
                       it is a threshold for attention, never a verdict. *@
                    <span class="cohort-share @(s.PunitiveShare >= 33 ? "high" : "")"
                          title="@($"{s.PunitiveCount} of {s.TotalRecords} records reached a punitive response")">
                        @($"{s.PunitiveShare:0.#}% punitive")
                    </span>
                </RowSuffix>
            </QBarList>
        </div>;

    private static readonly IReadOnlyList<QTab> ReportTabs = new[]
    {
        new QTab("dashboard", "Dashboard"),
        new QTab("search", "Search & Export"),
        new QTab("cohorts", "Cohorts")
    };

    private IReadOnlyList<QBarItem> CategoryBars => summary == null
        ? Array.Empty<QBarItem>()
        : summary.ByCategory.Select(c => new QBarItem(c.CategoryName, c.Count, Hint: $"({c.CaseType})")).ToList();

    private IReadOnlyList<QBarItem> StaffBars => summary == null
        ? Array.Empty<QBarItem>()
        : summary.ByStaff.Select(s => new QBarItem(s.StaffName, s.Count, Color: "var(--qm-welfare-concern)")).ToList();

    // ---------------- Search ----------------
    private bool isLoadingSearch;
    private string searchKeyword = "";
    private DateRange searchRange = DateRange.LastDays(90);
    private DateTime? searchFrom;
    private DateTime? searchTo;

    private void OnDashboardRangeChanged(DateRange next)
    {
        dashboardRange = next;
        dashboardFrom = next.From.ToDateTime(TimeOnly.MinValue);
        dashboardTo = next.To.ToDateTime(TimeOnly.MinValue);
    }

    private void OnSearchRangeChanged(DateRange next)
    {
        searchRange = next;
        searchFrom = next.From.ToDateTime(TimeOnly.MinValue);
        searchTo = next.To.ToDateTime(TimeOnly.MinValue);
    }
    private WelfareCaseType? searchCaseType;
    private WelfareStatus? searchStatus;
    private List<WelfareRecordDto> searchResults = new();

    private readonly List<(string Label, WelfareCaseType? Value)> caseTypeFilterOptions = new()
    {
        ("All Case Types", null),
        ("Achievement", WelfareCaseType.Achievement),
        ("Behavior", WelfareCaseType.Behavior),
        ("Welfare", WelfareCaseType.Welfare)
    };

    private readonly List<(string Label, WelfareStatus? Value)> statusFilterOptions = new()
    {
        ("All Statuses", null),
        ("Open", WelfareStatus.Open),
        ("Under Review", WelfareStatus.UnderReview),
        ("Action Taken", WelfareStatus.ActionTaken),
        ("Resolved", WelfareStatus.Resolved)
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await PermissionService.HasPermissionAsync(Permissions.WelfareReportsView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            await ModuleState.LoadAsync(ModuleApi);
            if (!ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
            {
                Navigation.NavigateTo("/billing/modules", forceLoad: false);
                return;
            }

            canImport = await PermissionService.HasPermissionAsync(Permissions.WelfareCreate);
            canEditWelfare = await PermissionService.HasPermissionAsync(Permissions.WelfareEdit);

            // Arriving from a dashboard tile: open the tab it asked for, with its filter applied.
            // Anything else in ?view= is ignored rather than showing an empty list for a filter
            // nobody can see or clear.
            if (ViewParam is "open" or "overdue") dueView = ViewParam;
            if (TabParam is "search" or "cohorts" or "dashboard") activeTab = TabParam;

            await BranchState.InitializeAsync();
            branchId = BranchState.CurrentBranchId;

            // Live import progress arrives on the branch group of the same hub the roster page
            // listens to — one event ("RosterImportProgress") for both import kinds; the JobId
            // check in HandleImportProgress keeps each page to its own job.
            NotificationClient.OnRosterImportProgressReceived += HandleImportProgress;
            await NotificationClient.JoinBranchAsync(branchId);

            await LoadSummary();
            if (activeTab == "search") await LoadSearch();
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        NotificationClient.OnRosterImportProgressReceived -= HandleImportProgress;
        return ValueTask.CompletedTask;
    }

    // ---------------- Import historical records ----------------

    private bool canImport;
    private bool showImportModal, isParsingFile, isStartingImport, showImportEntries;
    private string? parsedFileName;
    private List<WelfareImportRow> parsedRows = new();
    private List<string> headerErrors = new();
    private RosterImportJobDto? importJob;
    private List<RosterImportJobEntryDto> importEntries = new();
    private bool showHistoryModal;
    private List<RosterImportJobDto> historyJobs = new();

    private record ParsedFileResult(string? FileName, List<WelfareImportRow> Rows, List<string> HeaderErrors);

    private void OpenImportModal()
    {
        parsedRows = new();
        headerErrors = new();
        parsedFileName = null;
        importJob = null;
        showImportEntries = false;
        importEntries = new();
        showImportModal = true;
    }

    private async Task CloseImportModal()
    {
        showImportModal = false;
        if (importJob != null)
        {
            // A completed import changed the ledger — refresh whatever the page is showing.
            // Awaited, not fire-and-forget (see StudentRoster.CloseImportModal for why).
            await LoadSummary();
            if (activeTab == "search") await LoadSearch();
        }
    }

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        isParsingFile = true;
        headerErrors = new();
        parsedRows = new();
        try
        {
            var json = await JS.InvokeAsync<string>("rosterImport.parseFile", "welfare-file-input", "welfare");
            var result = JsonSerializer.Deserialize<ParsedFileResult>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (result != null)
            {
                parsedFileName = result.FileName;
                parsedRows = result.Rows;
                headerErrors = result.HeaderErrors;
            }
        }
        catch (Exception ex)
        {
            headerErrors = new() { $"Failed to read the file: {ex.Message}" };
        }
        finally
        {
            isParsingFile = false;
        }
    }

    private async Task StartImport()
    {
        isStartingImport = true;
        try
        {
            importJob = await StudentApi.StartWelfareImportAsync(branchId, new StartWelfareImportRequest
            {
                SourceFileName = parsedFileName,
                Rows = parsedRows
            });
        }
        catch (InvalidOperationException ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not start import", ex.Message);
        }
        finally
        {
            isStartingImport = false;
        }
    }

    private async Task HandleImportProgress(RosterImportProgressEvent progress)
    {
        if (importJob == null || progress.JobId != importJob.Id) return;

        importJob = importJob with
        {
            Status = progress.Status,
            TotalRows = progress.TotalRows,
            ProcessedRows = progress.ProcessedRows,
            CreatedCount = progress.CreatedCount,
            UpdatedCount = progress.UpdatedCount,
            DuplicateCount = progress.DuplicateCount,
            FailedCount = progress.FailedCount
        };

        // The final broadcast carries no FailureReason — re-fetch the job row once it's terminal
        // so a whole-job failure (not just per-row ones) shows its reason instead of a bare badge.
        if (progress.Status == RosterImportStatus.Failed)
            importJob = await StudentApi.GetImportJobAsync(branchId, importJob.Id, RosterImportKind.Welfare) ?? importJob;

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleImportEntries()
    {
        showImportEntries = !showImportEntries;
        if (showImportEntries && importJob != null && !importEntries.Any())
        {
            importEntries = await StudentApi.GetImportJobEntriesAsync(branchId, importJob.Id, RosterImportKind.Welfare);
        }
    }

    private async Task OpenHistoryModal()
    {
        historyJobs = await StudentApi.GetImportJobsAsync(branchId, RosterImportKind.Welfare);
        showHistoryModal = true;
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == "search" && !searchResults.Any() && !isLoadingSearch)
            _ = LoadSearch();
    }

    private async Task LoadSummary()
    {
        isLoadingSummary = true;
        try
        {
            var url = $"api/v1/branches/{branchId}/welfare/summary";
            var query = new List<string>();
            if (dashboardFrom.HasValue) query.Add($"dateFrom={dashboardFrom:yyyy-MM-dd}");
            if (dashboardTo.HasValue) query.Add($"dateTo={dashboardTo:yyyy-MM-dd}");
            if (query.Any()) url += "?" + string.Join("&", query);

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                summary = await response.Content.ReadFromJsonAsync<WelfareSummaryDto>(JsonOptions);
                scopedClasses = summary?.ScopedToClasses ?? new();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load dashboard: {ex.Message}");
        }
        finally
        {
            isLoadingSummary = false;
        }
    }

    private async Task LoadSearch()
    {
        isLoadingSearch = true;
        try
        {
            var query = new List<string>();
            if (!string.IsNullOrWhiteSpace(searchKeyword)) query.Add($"keyword={Uri.EscapeDataString(searchKeyword)}");
            if (searchFrom.HasValue) query.Add($"dateFrom={searchFrom:yyyy-MM-dd}");
            if (searchTo.HasValue) query.Add($"dateTo={searchTo:yyyy-MM-dd}");
            if (searchCaseType.HasValue) query.Add($"caseType={searchCaseType}");
            if (searchStatus.HasValue) query.Add($"status={searchStatus}");

            var url = $"api/v1/branches/{branchId}/welfare-records";
            if (query.Any()) url += "?" + string.Join("&", query);

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
                searchResults = await response.Content.ReadFromJsonAsync<List<WelfareRecordDto>>(JsonOptions) ?? new();
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Search failed: {ex.Message}");
        }
        finally
        {
            isLoadingSearch = false;
            // Called fire-and-forget from SwitchTab (`_ = LoadSearch()`), so there's no awaited
            // chain back to that event handler for Blazor to auto-render after it completes — same
            // gotcha as StudentWelfareTimeline's notify-draft flow, fixed the same way.
            await InvokeAsync(StateHasChanged);
        }
    }

    // ---- Batch operations -------------------------------------------------------------------
    //
    // A welfare record is a different noun over identical machinery: the same selection, the same
    // preview dialog, the same resolver, the same undo. This page contributes the ids and the
    // operation; nothing else about batching lives here.

    private bool canEditWelfare;

    /// <summary>
    /// Bulk edits need the permission AND an unscoped caller. The API refuses every batch from a
    /// class-scoped caller — a batch is applied by a Hangfire worker, which cannot narrow it to the
    /// caller's classes — so offering the checkboxes to a class teacher would only produce a 403
    /// after they had selected twenty records. Same shape as the import button above.
    /// </summary>
    private bool CanBatch => canEditWelfare && !scopedClasses.Any();
    private readonly HashSet<Guid> selectedRecordIds = new();
    private QBatchDialog? batchDialog;

    private bool AllVisibleSelected => VisibleSearchResults.Any() && VisibleSearchResults.All(r => selectedRecordIds.Contains(r.Id));

    private void ToggleSelectAll(bool select)
    {
        foreach (var r in VisibleSearchResults)
        {
            if (select) selectedRecordIds.Add(r.Id);
            else selectedRecordIds.Remove(r.Id);
        }
    }

    private void ToggleSelection(Guid id, bool select)
    {
        if (select) selectedRecordIds.Add(id);
        else selectedRecordIds.Remove(id);
    }

    /// <summary>
    /// Draft is deliberately absent: a draft is somebody's unfinished note, and moving one in bulk
    /// would finalize a record its author had not finished writing.
    /// </summary>
    private static readonly WelfareStatus[] BatchStatuses =
    {
        WelfareStatus.Open, WelfareStatus.UnderReview, WelfareStatus.ActionTaken, WelfareStatus.Resolved
    };

    private bool showAssignPrompt;
    private bool showReviewPrompt;
    private Guid? assignTargetUserId;
    private DateTime? reviewDateValue = DateTime.Today.AddDays(14);

    private async Task RunStatusBatch(WelfareStatus status)
    {
        if (batchDialog == null) return;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.SetWelfareStatus,
            Ids = selectedRecordIds.ToList(),
            Value = status.ToString()
        });
    }

    private async Task OpenAssignPrompt()
    {
        await LoadStaffAsync();
        showAssignPrompt = true;
    }

    private async Task ConfirmAssign()
    {
        if (batchDialog == null || assignTargetUserId is null) return;
        showAssignPrompt = false;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.AssignWelfareAction,
            Ids = selectedRecordIds.ToList(),
            TargetUserId = assignTargetUserId
        });
    }

    private async Task ConfirmReviewDate()
    {
        if (batchDialog == null || reviewDateValue is null) return;
        showReviewPrompt = false;
        await batchDialog.ShowAsync(new BatchRequest
        {
            Operation = BatchOperation.SetWelfareReviewDate,
            Ids = selectedRecordIds.ToList(),
            DateValue = reviewDateValue
        });
    }

    private async Task OnBatchQueued(BatchAcceptedDto accepted)
    {
        selectedRecordIds.Clear();
        NotificationService.Notify(ToastSeverity.Info, "Running", accepted.Summary, 6000);
        // The search is re-run once the job has had a moment; the ledger is what people read next.
        await Task.Delay(1500);
        await LoadSearch();
    }

    private record StaffOption(Guid Id, string Name);
    private List<StaffOption> staffOptions = new();

    private async Task LoadStaffAsync()
    {
        if (staffOptions.Any()) return;
        var response = await Http.GetAsync($"api/v1/users?branchId={branchId}");
        if (!response.IsSuccessStatusCode) return;
        var users = await response.Content.ReadFromJsonAsync<List<StaffApiUser>>(JsonOptions) ?? new();
        staffOptions = users.Where(u => u.IsActive).Select(u => new StaffOption(u.Id, u.FullName)).ToList();
    }

    private record StaffApiUser(Guid Id, string FullName, bool IsActive);

    // ---- Export ---------------------------------------------------------------------------
    //
    // This page used to write its own CSV, one of eight such implementations across the app. The
    // columns are declared once below and used by every format, so a column added here cannot be
    // forgotten in the workbook.

    private string ExportSubtitle
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(searchKeyword)) parts.Add($"matching \"{searchKeyword}\"");
            if (searchCaseType.HasValue) parts.Add(searchCaseType.Value.ToString());
            if (searchStatus.HasValue) parts.Add(searchStatus.Value.ToString());
            if (dueView != null) parts.Add(DueViewLabel.ToLowerInvariant());
            if (searchFrom.HasValue && searchTo.HasValue)
                parts.Add(QDateFormat.Range(searchFrom.Value, searchTo.Value));
            else if (searchFrom.HasValue)
                parts.Add($"{QDateFormat.D(searchFrom.Value)} onwards");
            else if (searchTo.HasValue)
                parts.Add($"up to {QDateFormat.D(searchTo.Value)}");
            return parts.Any() ? "Filtered: " + string.Join(", ", parts) : "All records";
        }
    }

