@page "/admin/welfare-my-actions"
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Services

<QPageTitle Text="My Welfare Actions" />

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>My Open Actions</h1>
            <p class="subtitle">Welfare follow-ups assigned to you — the mobile "what do I still owe" view, oldest due date first.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container"><QSpinner Size="lg" /><span>Loading your actions...</span></div>
    }
    else if (!actions.Any())
    {
        <QEmptyState Icon="check2-circle" Title="Nothing open right now"
                     Text="Any welfare record assigned to you for follow-up will show up here." />
    }
    else
    {
        @* Chips with counts, a search and paging (plan Phase 2). A to-do list only grows, and the
           one thing a reader wants from it is "what is overdue" — which a chip answers and a wall
           of rows does not. No selection: closing a welfare follow-up is a decision per child with
           its own record, and a bulk "resolve" would be the sweep inventing a safeguarding action. *@
        <QBulkBar Filters="@FilterChips" ActiveFilter="@filter" ActiveFilterChanged="@SetFilter"
                  Search="@search" SearchChanged="@SetSearch" ShowSelection="false"
                  SearchPlaceholder="Search by student, category or action" />

        @if (Visible.Count == 0)
        {
            <QEmptyState Icon="funnel" Title="Nothing matches" Text="Clear the search or choose a different filter.">
                <Action><QButton Text="Show everything" Icon="arrow-counterclockwise" Variant="secondary" Size="sm" OnClick="@ClearFilters" /></Action>
            </QEmptyState>
        }
        else
        {
        <div class="action-list">
            @foreach (var record in Paged)
            {
                var isOverdue = record.ActionDueDate.HasValue && record.ActionDueDate.Value < DateTime.UtcNow;
                <div class="action-row @(isOverdue ? "action-row--overdue" : "")" @onclick="@(() => Navigation.NavigateTo($"/admin/students/{record.StudentId}/welfare"))">
                    <div class="action-row-marker" style="background-color: @(record.CategoryColor ?? "var(--qm-primary)")">
                        <QIcon Name="@CaseTypeIcon(record.CaseType)" />
                    </div>
                    <div class="action-row-body">
                        <div class="action-row-title">
                            <strong>@record.StudentName</strong>
                            <QChip Text="@record.Status.ToString()" Size="sm" Color="@WelfareDisplay.StatusColor(record.Status)" />
                            @if (isOverdue)
                            {
                                <span class="overdue-tag">Overdue</span>
                            }
                        </div>
                        <p class="action-row-desc">@(string.IsNullOrWhiteSpace(record.ActionTaken) ? record.CategoryName : record.ActionTaken)</p>
                        @if (record.ActionDueDate.HasValue)
                        {
                            <span class="action-row-due">Due @QDateFormat.D(record.ActionDueDate.Value.ToLocalTime())</span>
                        }
                    </div>
                    <QIcon Name="chevron-right" />
                </div>
            }
        </div>
        <QPager Count="@Visible.Count" PageSize="@PageSize" PageIndex="@pageIndex" PageIndexChanged="@(i => pageIndex = i)" PageSizeOptions="@QPagerDefaults.Sizes" AllowAll="true" StorageKey="welfare-open-actions"
                    PageSizeChanged="@(n => { PageSize = n; pageIndex = 0; })" ItemLabel="actions" />
        }
    }
</div>

<style>.header-content h1 { margin: 0 0 4px; color: var(--qm-text-primary); }
    .loading-container { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: var(--qm-text-muted); background: var(--qm-bg-card); border-radius: var(--qm-radius-xl); border: 1px solid var(--qm-border); }

    .action-list { display: flex; flex-direction: column; gap: 10px; }
    .action-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding: 14px 16px; background: var(--qm-bg-card); border: 1px solid var(--qm-border); border-radius: var(--qm-radius-lg); cursor: pointer; transition: all 0.15s ease; }
    .action-row:hover { border-color: var(--qm-primary); box-shadow: var(--qm-shadow-md); }
    .action-row--overdue { border-left: 3px solid var(--qm-danger); }

    .action-row-marker { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--qm-text-on-primary); flex-shrink: 0; }
    .action-row-body { flex: 1; min-width: 0; }
    .action-row-title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; color: var(--qm-text-primary); }
    .action-row-desc { margin: 4px 0; font-size: var(--qm-text-base); color: var(--qm-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .action-row-due { font-size: var(--qm-text-sm); color: var(--qm-text-muted); }

    .overdue-tag { padding: 1px 7px; border-radius: 999px; background: rgba(var(--qm-danger-rgb), 0.12); color: var(--qm-danger); font-weight: 700; font-size: var(--qm-text-xs); text-transform: uppercase; }
</style>

@code {
    private int PageSize = QPagerDefaults.Size;

    private Guid branchId;
    private bool isLoading = true;
    private List<WelfareRecordDto> actions = new();
    private string search = string.Empty;
    private string filter = "all";
    private int pageIndex;

    private bool IsOverdue(WelfareRecordDto r) => r.ActionDueDate.HasValue && r.ActionDueDate.Value < DateTime.UtcNow;

    private List<QBulkBar.Filter> FilterChips => new()
    {
        new("all", "All", actions.Count),
        new("overdue", "Overdue", actions.Count(IsOverdue)),
        new("dated", "With a date", actions.Count(r => r.ActionDueDate.HasValue && !IsOverdue(r))),
        new("undated", "No date", actions.Count(r => !r.ActionDueDate.HasValue)),
    };

    private List<WelfareRecordDto> Visible
    {
        get
        {
            IEnumerable<WelfareRecordDto> rows = actions;
            rows = filter switch
            {
                "overdue" => rows.Where(IsOverdue),
                "dated" => rows.Where(r => r.ActionDueDate.HasValue && !IsOverdue(r)),
                "undated" => rows.Where(r => !r.ActionDueDate.HasValue),
                _ => rows
            };
            if (!string.IsNullOrWhiteSpace(search))
            {
                var q = search.Trim();
                bool Has(string? s) => (s ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase);
                rows = rows.Where(r => Has(r.StudentName) || Has(r.CategoryName) || Has(r.ActionTaken));
            }
            return rows.ToList();
        }
    }

    private int SafePageIndex => QPaging.SafeIndex(pageIndex, Visible.Count, PageSize);
    private IEnumerable<WelfareRecordDto> Paged => QPaging.Page(Visible, SafePageIndex, PageSize);

    private void SetFilter(string key) { filter = key; pageIndex = 0; }
    private void SetSearch(string value) { search = value ?? string.Empty; pageIndex = 0; }
    private void ClearFilters() { filter = "all"; search = string.Empty; pageIndex = 0; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!await PermissionService.HasPermissionAsync(Permissions.WelfareView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            await ModuleState.LoadAsync(ModuleApi);
            if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
            {
                Navigation.NavigateTo(BillingLinks.Modules, forceLoad: false);
                return;
            }

            await BranchState.InitializeAsync();
            branchId = BranchState.CurrentBranchId;
            TrackBranch();

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var response = await Http.GetAsync($"api/v1/branches/{branchId}/welfare-records/my-actions");
            if (response.IsSuccessStatusCode)
            {
                actions = await response.Content.ReadFromJsonAsync<List<WelfareRecordDto>>(JsonOptions) ?? new();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load your actions: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string CaseTypeIcon(WelfareCaseType caseType) => caseType switch
    {
        WelfareCaseType.Achievement => "trophy-fill",
        WelfareCaseType.Behavior => "exclamation-triangle-fill",
        WelfareCaseType.Welfare => "shield-fill-check",
        _ => "clipboard2-pulse-fill"
    };

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
        await LoadData();
    }
}
