        font-size: 12px;
        color: var(--qm-text-primary);
        margin-bottom: 6px;
    }

    .webhook-url span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .webhook-url .q-icon { color: var(--qm-primary); flex-shrink: 0; }
    .webhook-events { display: flex; gap: 6px; flex-wrap: wrap; }
    .webhook-muted { font-size: 12px; color: var(--qm-text-muted); }

    .event-badge {
        padding: 2px 8px;
        border-radius: var(--qm-radius-sm);
        font-size: 10px;
        background: var(--qm-bg-elevated);
        color: var(--qm-text-secondary);
        border: 1px solid var(--qm-border);
