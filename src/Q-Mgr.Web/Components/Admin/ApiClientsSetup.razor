        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        margin: 0 0 16px;
        background: color-mix(in srgb, var(--qm-warning) 15%, transparent);
        border-radius: var(--qm-radius-lg);
        font-size: 13px;
        color: var(--qm-text-primary);
    }

    .client-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--qm-border);
        margin: 0 16px;
        border-radius: var(--qm-radius-lg);
        overflow: hidden;
    }

    .stat {
        background: var(--qm-bg-elevated);
        padding: 12px;
        text-align: center;
    }

    .stat-value { display: block; font-size: 18px; font-weight: 600; color: var(--qm-text-primary); }
    .stat-label { font-size: 11px; color: var(--qm-text-muted); text-transform: uppercase; }

    .client-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-top: 1px solid var(--qm-border);
        margin-top: 16px;
    }

    .client-permissions { display: flex; gap: 6px; flex-wrap: wrap; }

    .scope-badge {
        padding: 4px 8px;
        border-radius: var(--qm-radius-md);
        font-size: 10px;
        background: var(--qm-primary-light);
        color: var(--qm-primary);
        font-weight: 500;
    }

    .scope-badge.more { background: var(--qm-bg-elevated); color: var(--qm-text-muted); }

    .client-actions { display: flex; gap: 4px; }

    .form-group { margin-bottom: 16px; }
    .form-group > label {
        display: block;
        margin-bottom: 6px;
        font-size: 13px;
        font-weight: 500;
        color: var(--qm-text-secondary);
    }

    .scopes-grid { display: flex; flex-direction: column; gap: 10px; }

    .scope-option {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
    }

    .scope-info { display: flex; flex-direction: column; }
    .scope-name { font-weight: 500; color: var(--qm-text-primary); }
    .scope-desc { font-size: 12px; color: var(--qm-text-muted); }
</style>

@code {
    private List<ApiClientDto> apiClients = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showDialog = false;
    private bool showSecretDialog = false;
    private string revealedSecret = "";
    private string revealedWebhookSecret = "";
    private ApiClientDto? editingClient;
    private ClientFormData formData = new();
    private List<ScopeOption> availableScopes = new();
    private List<WebhookEventOption> availableWebhookEvents = new();
    private List<string> systemTypes = new() { "hospital_mgmt", "banking", "pharmacy", "school_mgmt", "custom" };
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ApiClientsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (!ModuleState.ActiveModuleCodes.Contains(ModuleCodes.IntegrationsApi))
        {
            Navigation.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        canCreate = await PermissionService.HasPermissionAsync(Permissions.ApiClientsCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permissions.ApiClientsEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permissions.ApiClientsDelete);

        availableScopes = new List<ScopeOption>
        {
            new() { Name = "queue:read", Description = "View queue status, counts and wait times" },
            new() { Name = "queue:write", Description = "Manage queue operations (pause, reorder, reset)" },
            new() { Name = "token:read", Description = "Look up tokens by id, external reference or customer" },
            new() { Name = "token:create", Description = "Create new tokens" },
            new() { Name = "token:manage", Description = "Call, complete, cancel and transfer tokens" },
            new() { Name = "counter:read", Description = "View counter information" },
            new() { Name = "service:read", Description = "View service types" },
            new() { Name = "stats:read", Description = "Access analytics and reports" },
            new() { Name = "roster:read", Description = "View the student/guardian visitor roster" },
            new() { Name = "roster:write", Description = "Push student/guardian roster updates (e.g. from a School Management Information System)" },
            new() { Name = "content:read", Description = "View media, playlists, displays and schedules" },
            new() { Name = "content:write", Description = "Upload media and manage playlists, displays and schedules" },
            new() { Name = "settings:write", Description = "Change organization and branch settings" },
            new() { Name = "visitors:read", Description = "View visitor records and check-in history" },
            new() { Name = "visitors:write", Description = "Register, check in and check out visitors" },
            new() { Name = "marketing:read", Description = "View campaigns, audiences and delivery stats" },
            new() { Name = "marketing:send", Description = "Create and send broadcast campaigns" },
            new() { Name = "welfare:read", Description = "View student welfare records and reports" },
            new() { Name = "welfare:write", Description = "Create and update student welfare records" }
        };

        await LoadWebhookEvents();
        await LoadApiClients();
    }

    /// <summary>
    /// Subscribable (outbound) events, from the API's canonical catalog so the picker can never
    /// drift from what WebhookService actually emits. Falls back to the shared static catalog if
    /// the request fails — same source of truth, just not round-tripped.
    /// </summary>
    private async Task LoadWebhookEvents()
    {
        IEnumerable<WebhookEventDto>? catalog = null;
        try
        {
            catalog = await Http.GetFromJsonAsync<List<WebhookEventDto>>("api/v1/api-clients/webhook-events", JsonOptions);
        }
        catch
        {
            // Fall through to the static catalog below.
        }

        catalog ??= WebhookEventCatalog.All;
        availableWebhookEvents = catalog
            .Where(e => string.Equals(e.Direction, "outbound", StringComparison.OrdinalIgnoreCase))
            .Select(e => new WebhookEventOption { Name = e.Name, Description = e.Description })
            .ToList();
    }

    // Same public-base-URL resolution MainLayout uses for the API Documentation link:
    // ApiPublicUrl is the browser-reachable hostname; Http.BaseAddress is an internal address
    // that only makes sense from the Web server itself.
    private string InboundEndpointFor(ApiClientDto client)
    {
        try
        {
            var publicUrl = Configuration["ApiPublicUrl"] ?? Http.BaseAddress!.ToString();
            return new Uri(new Uri(publicUrl), $"/api/v1/webhooks/inbound/{client.Id}").ToString();
        }
        catch
        {
            return $"/api/v1/webhooks/inbound/{client.Id}";
        }
    }

    private async Task LoadApiClients()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<ApiClientDto>>("api/v1/api-clients", JsonOptions);
            apiClients = result ?? new();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load API clients: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetSystemTypeIcon(string? systemType) => systemType switch
    {
        "hospital_mgmt" => "hospital",
        "banking" => "bank",
        "pharmacy" => "capsule",
        "school_mgmt" => "mortarboard-fill",
        _ => "key-fill"
    };

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            NotificationService.Notify(ToastSeverity.Success, "Copied", "Copied to clipboard");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to copy: {ex.Message}");
        }
    }

    private void ShowAddDialog()
    {
        editingClient = null;
        formData = new ClientFormData { IsActive = true };
        foreach (var s in availableScopes) s.IsSelected = false;
        foreach (var e in availableWebhookEvents) e.IsSelected = false;
        showDialog = true;
    }

    private void EditClient(ApiClientDto client)
    {
        editingClient = client;
        formData = new ClientFormData
        {
            Name = client.Name,
            Description = client.Description,
            SystemType = client.SystemType,
            IsActive = client.IsActive,
            WebhookUrl = client.WebhookUrl
        };
        foreach (var s in availableScopes)
            s.IsSelected = client.Scopes.Contains(s.Name);
        foreach (var e in availableWebhookEvents)
            e.IsSelected = client.WebhookEvents.Contains(e.Name, StringComparer.OrdinalIgnoreCase);
        showDialog = true;
    }

    private void RevealSecrets(string? clientSecret, string? webhookSecret)
    {
        revealedSecret = clientSecret ?? "";
        revealedWebhookSecret = webhookSecret ?? "";
        showSecretDialog = !string.IsNullOrEmpty(revealedSecret) || !string.IsNullOrEmpty(revealedWebhookSecret);
    }

    private async Task SaveClient()
    {
        if (string.IsNullOrWhiteSpace(formData.Name))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Required", "Client name is required");
            return;
        }

        var webhookUrl = string.IsNullOrWhiteSpace(formData.WebhookUrl) ? null : formData.WebhookUrl.Trim();
        if (webhookUrl != null)
        {
            var validHttps = Uri.TryCreate(webhookUrl, UriKind.Absolute, out var uri)
                && (uri.Scheme == Uri.UriSchemeHttps || (uri.Scheme == Uri.UriSchemeHttp && uri.IsLoopback));
            if (!validHttps)
            {
                NotificationService.Notify(ToastSeverity.Warning, "Invalid webhook URL", "Use an absolute https:// URL (http:// is only allowed for localhost).");
                return;
            }
        }

        isSaving = true;
        try
        {
            var selectedScopes = availableScopes.Where(s => s.IsSelected).Select(s => s.Name).ToList();
            var selectedEvents = webhookUrl == null
                ? new List<string>()
                : availableWebhookEvents.Where(e => e.IsSelected).Select(e => e.Name).ToList();

            if (editingClient == null)
            {
                var response = await Http.PostAsJsonAsync("api/v1/api-clients", new CreateApiClientRequest
                {
                    Name = formData.Name,
                    Description = formData.Description,
                    SystemType = formData.SystemType,
                    IsActive = formData.IsActive,
                    Scopes = selectedScopes,
                    WebhookUrl = webhookUrl,
                    WebhookEvents = selectedEvents
                }, JsonOptions);

                if (response.IsSuccessStatusCode)
                {
                    var reveal = await response.Content.ReadFromJsonAsync<ApiClientSecretRevealDto>(JsonOptions);
                    showDialog = false;
                    await LoadApiClients();
                    if (reveal != null)
                        RevealSecrets(reveal.ClientSecret, reveal.Client.WebhookSecret);
                    NotificationService.Notify(ToastSeverity.Success, "Created", "API client created");
                }
                else
                {
                    NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to create API client ({(int)response.StatusCode}): {await ReadErrorMessage(response)}");
                }
            }
            else
            {
                var response = await Http.PutAsJsonAsync($"api/v1/api-clients/{editingClient.Id}", new UpdateApiClientRequest
                {
                    Name = formData.Name,
                    Description = formData.Description,
                    SystemType = formData.SystemType,
                    IsActive = formData.IsActive,
                    Scopes = selectedScopes,
                    WebhookUrl = webhookUrl,
                    WebhookEvents = selectedEvents
                }, JsonOptions);

                if (response.IsSuccessStatusCode)
                {
                    // The API generates a webhook signing secret the first time a URL is set and
                    // returns it on this response only — surface it with the same one-time modal.
                    var updated = await response.Content.ReadFromJsonAsync<ApiClientDto>(JsonOptions);
                    showDialog = false;
                    await LoadApiClients();
                    if (!string.IsNullOrEmpty(updated?.WebhookSecret))
                        RevealSecrets(null, updated.WebhookSecret);
                    NotificationService.Notify(ToastSeverity.Success, "Saved", "API client updated");
                }
                else
                {
                    NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to update API client ({(int)response.StatusCode}): {await ReadErrorMessage(response)}");
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to save API client: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RegenerateSecret(ApiClientDto client)
    {
        try
        {
            var response = await Http.PostAsync($"api/v1/api-clients/{client.Id}/regenerate-secret", null);
            if (response.IsSuccessStatusCode)
            {
                var reveal = await response.Content.ReadFromJsonAsync<ApiClientSecretRevealDto>(JsonOptions);
                if (reveal != null)
                    RevealSecrets(reveal.ClientSecret, null);
                NotificationService.Notify(ToastSeverity.Warning, "Secret Regenerated", "The previous secret no longer works. Update your applications.");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to regenerate secret ({(int)response.StatusCode})");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to regenerate secret: {ex.Message}");
        }
    }

    private async Task RotateWebhookSecret(ApiClientDto client)
    {
        try
        {
            var response = await Http.PostAsync($"api/v1/api-clients/{client.Id}/webhook-secret/rotate", null);
            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<ApiClientDto>(JsonOptions);
                await LoadApiClients();
                if (!string.IsNullOrEmpty(updated?.WebhookSecret))
                    RevealSecrets(null, updated.WebhookSecret);
                NotificationService.Notify(ToastSeverity.Warning, "Webhook Secret Rotated",
                    client.HasWebhookSecret
                        ? "The previous webhook secret no longer verifies. Update the integration on the other side."
                        : "A webhook signing secret has been created for this client.");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to rotate webhook secret ({(int)response.StatusCode})");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to rotate webhook secret: {ex.Message}");
        }
    }

    private static async Task<string> ReadErrorMessage(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return response.ReasonPhrase ?? "";
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind == JsonValueKind.Object)
            {
                if (doc.RootElement.TryGetProperty("message", out var message)) return message.GetString() ?? "";
                if (doc.RootElement.TryGetProperty("detail", out var detail)) return detail.GetString() ?? "";
                if (doc.RootElement.TryGetProperty("title", out var title)) return title.GetString() ?? "";
            }
            return body.Length > 200 ? body[..200] : body;
        }
        catch
        {
            return response.ReasonPhrase ?? "";
        }
    }

    private async Task DeleteClient(ApiClientDto client)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/v1/api-clients/{client.Id}");
            if (response.IsSuccessStatusCode)
            {
                apiClients.Remove(client);
                NotificationService.Notify(ToastSeverity.Success, "Deleted", "API client removed");
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete API client ({(int)response.StatusCode})");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to delete API client: {ex.Message}");
        }
    }

