@page "/admin/students/class-teachers"
@inject IClassTeacherApiService ClassTeacherApi
@inject HttpClient Http
@inject System.Text.Json.JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IStaffPerformanceApiService StaffApi
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Services

<PageTitle>Class Teachers - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Class Teachers</h1>
            <p class="subtitle">Who holds pastoral responsibility for each class, and who teaches it which subject. A class teacher sees their own classes' students and their welfare, and is alerted about them. A subject teacher sees only the students they teach, with no guardians, welfare or discipline.</p>
        </div>
        <div class="header-actions">
            @if (canManage)
            {
                <QButton Text="History" Icon="clock-history" Variant="secondary" OnClick="@(() => ShowHistoryDialog(null))"
                         Title="Who held each class before — the audit answer to who could see a child's file last term" />
                <QButton Text="Assign a Subject Teacher" Icon="book" Variant="secondary" OnClick="@(() => ShowSubjectDialog(null))" />
                <QButton Text="Assign a Class Teacher" Icon="person-plus" Variant="primary" OnClick="@(() => ShowAssignDialog(null))" />
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading class teachers...</span>
        </div>
    }
    else
    {
        @* ── The ways this feature fails silently, surfaced first ──────────────────────────
           Every one of these is a state where the app looks configured and quietly does
           nothing: a class nobody is told about, a teacher who sees an empty app, a child
           whose class name matches no configured class and so never reaches their teacher. *@
        @if (coverage.ClassesWithNoTeacher.Any() || coverage.ScopedUsersWithNoClass.Any() || coverage.UnknownStudentClasses.Any() || coverage.SubjectGaps.Any())
        {
            <div class="ct-warnings">
                @if (coverage.ClassesWithNoTeacher.Any())
                {
                    <div class="ct-warn">
                        <QIcon Name="exclamation-triangle-fill" />
                        <div>
                            <strong>@coverage.ClassesWithNoTeacher.Count class@(coverage.ClassesWithNoTeacher.Count == 1 ? "" : "es") with no teacher</strong>
                            <p>Nobody is alerted when a student in @(coverage.ClassesWithNoTeacher.Count == 1 ? "this class" : "these classes") has a record logged: @string.Join(", ", coverage.ClassesWithNoTeacher)</p>
                        </div>
                    </div>
                }
                @if (coverage.ScopedUsersWithNoClass.Any())
                {
                    <div class="ct-warn">
                        <QIcon Name="person-x-fill" />
                        <div>
                            <strong>@coverage.ScopedUsersWithNoClass.Count teaching account@(coverage.ScopedUsersWithNoClass.Count == 1 ? "" : "s") with no class</strong>
                            @* Capped: every Teacher has a class scope since the duty rota build, so before subjects are
                               assigned this is the whole teaching staff, and a paragraph of fifty names reads as noise. *@
                            <p>
                                @(coverage.ScopedUsersWithNoClass.Count == 1 ? "This account sees" : "These accounts see") no students at all until assigned a class or a subject:
                                @string.Join(", ", coverage.ScopedUsersWithNoClass.OrderBy(u => u.FullName).Take(OrphanNamesShown).Select(u => u.FullName))@(coverage.ScopedUsersWithNoClass.Count > OrphanNamesShown ? $", and {coverage.ScopedUsersWithNoClass.Count - OrphanNamesShown} more" : "")
                            </p>
                        </div>
                    </div>
                }
                @if (coverage.UnknownStudentClasses.Any())
                {
                    <div class="ct-warn ct-warn-strong">
                        <QIcon Name="question-diamond-fill" />
                        <div>
                            <strong>Students in a class that is not on the list</strong>
                            <p>
                                These class names are held by students but match no configured class, so those students are invisible to every class teacher.
                                Fix the spelling on the roster, or add the class under <em>Classes, houses &amp; lists</em>:
                                @string.Join(", ", coverage.UnknownStudentClasses.Select(u => $"\"{u.ClassName}\" ({u.StudentCount})"))
                            </p>
                        </div>
                    </div>
                }
                @if (coverage.SubjectGaps.Any())
                {
                    @* A stream's curriculum is what its level teaches anywhere: S2B with no Physics teacher
                       while S2A has one would never be timetabled, and nothing else would say so. *@
                    <div class="ct-warn">
                        <QIcon Name="book-half" />
                        <div>
                            <strong>@coverage.SubjectGaps.Count stream@(coverage.SubjectGaps.Count == 1 ? "" : "s") missing a subject its level teaches</strong>
                            <ul class="ct-gap-list">
                                @foreach (var g in coverage.SubjectGaps)
                                {
                                    <li><span class="ct-gap-class">@g.ClassName</span> (@g.Level): @string.Join(", ", g.MissingSubjects)</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }

        @if (canManage && coverage.Classes.Any() && coverage.Classes.All(c => string.IsNullOrWhiteSpace(c.Level)))
        {
            <p class="ct-level-hint">
                <QIcon Name="info-circle" />
                Give each class a <strong>level</strong> (S2 for S2A, S2B…) under <em>Student Roster → Lists</em> to group streams and to find a stream missing a subject its level teaches.
            </p>
        }

        @if (!coverage.Classes.Any())
        {
            <div class="empty-state">
                <QIcon Name="mortarboard-fill" Size="xl" />
                <h3>No classes configured</h3>
                <p>Add your classes under <em>Student Roster → Lists</em> first. A class teacher is assigned to a class, so the class has to exist.</p>
                <QButton Text="Go to Student Roster" Icon="arrow-right" Variant="secondary" OnClick="@(() => Navigation.NavigateTo("/admin/students/roster"))" />
            </div>
        }
        else
        {
            <div class="ct-grid">
                @foreach (var row in coverage.Classes)
                {
                    <div class="ct-card @(row.ClassTeacher == null ? "ct-card-empty" : "")">
                        <div class="ct-card-head">
                            <div class="ct-class">
                                <span class="ct-swatch" style="background:@(row.Color ?? "var(--qm-border)")"></span>
                                <h3>@row.ClassName</h3>
                                @if (!string.IsNullOrWhiteSpace(row.Level))
                                {
                                    <QChip Text="@row.Level" Size="sm" Title="Level: groups this class with its other streams" />
                                }
                            </div>
                            <span class="ct-count">@row.StudentCount student@(row.StudentCount == 1 ? "" : "s")</span>
                        </div>

                        @if (row.ClassTeacher is { } ct)
                        {
                            @RenderTeacher(ct, isPrimary: true)
                        }
                        else
                        {
                            <div class="ct-none">
                                <QIcon Name="dash-circle" />
                                <span>No class teacher</span>
                                @if (canManage)
                                {
                                    <QButton Text="Assign" Icon="person-plus" Variant="ghost" Size="sm" OnClick="@(() => ShowAssignDialog(row.ClassName))" />
                                }
                            </div>
                        }

                        @foreach (var a in row.Assistants)
                        {
                            @RenderTeacher(a, isPrimary: false)
                        }

                        @* Subject teachers: the Teaching tier. Compact rows — the contact card belongs to the
                           pastoral lead, the person a parent or the front desk actually calls. *@
                        <div class="ct-subjects">
                            <div class="ct-subjects-head">
                                <span>Subject teachers</span>
                                @if (row.SubjectTeachers.Any())
                                {
                                    <span class="ct-count">@row.SubjectTeachers.Sum(t => t.PeriodsPerWeek ?? 0) periods a week</span>
                                }
                            </div>
                            @if (!row.SubjectTeachers.Any())
                            {
                                <div class="ct-subjects-none">None assigned</div>
                            }
                            else
                            {
                                <ul class="ct-subject-list">
                                    @foreach (var st in row.SubjectTeachers)
                                    {
                                        <li class="ct-subject">
                                            <div class="ct-subject-main">
                                                <QChip Text="@(st.SubjectCode ?? st.SubjectName)" Size="sm" Class="q-chip--mono" Title="@st.SubjectName" />
                                                <span class="ct-subject-name">@st.SubjectName</span>
                                                <span class="ct-subject-teacher">
                                                    @st.FullName
                                                    @if (!st.UserIsActive)
                                                    {
                                                        <QBadge Text="Account inactive" Variant="danger" />
                                                    }
                                                </span>
                                            </div>
                                            <div class="ct-subject-side">
                                                <span class="ct-periods" title="Planned periods a week">@(st.PeriodsPerWeek?.ToString() ?? "—") / wk</span>
                                                @if (canManage)
                                                {
                                                    <QButton Icon="pencil" Variant="ghost" Size="sm" Title="Change periods a week" OnClick="@(() => ShowPeriodsDialog(st))" />
                                                    <QButton Icon="person-dash" Variant="ghost" Size="sm" Title="End this assignment" OnClick="@(() => ShowEndDialog(st))" />
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (canManage)
                        {
                            <div class="ct-card-foot">
                                @if (row.ClassTeacher != null)
                                {
                                    <QButton Text="Add assistant" Icon="plus" Variant="ghost" Size="sm" OnClick="@(() => ShowAssignDialog(row.ClassName, ClassTeacherRole.Assistant))" />
                                }
                                <QButton Text="Add subject teacher" Icon="book" Variant="ghost" Size="sm" OnClick="@(() => ShowSubjectDialog(row.ClassName))" />
                                <QButton Text="History" Icon="clock-history" Variant="ghost" Size="sm" OnClick="@(() => ShowHistoryDialog(row.ClassName))" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@* ── Assign ────────────────────────────────────────────────────────────────────────────── *@
<QModal @bind-Visible="showAssign" Title="Assign a class teacher" Icon="person-plus" Size="md" ShowDefaultFooter="false">
    <ChildContent>
    <div class="form-grid">
        <QSelect TValue="string" TItem="ClassTeacherCoverageDto"
                 Label="Class"
                 Value="@form.ClassName"
                 ValueChanged="@(v => form.ClassName = v ?? string.Empty)"
                 Items="@coverage.Classes"
                 ValueSelector="@(c => c.ClassName)"
                 TextSelector="@(c => $"{c.ClassName} — {c.StudentCount} student{(c.StudentCount == 1 ? "" : "s")}")"
                 Placeholder="Choose a class" />

        <QSelect TValue="Guid" TItem="StaffOption"
                 Label="Member of staff"
                 Value="@form.UserId"
                 ValueChanged="@(v => form.UserId = v)"
                 Items="@staff"
                 ValueSelector="@(s => s.Id)"
                 TextSelector="@(s => s.Label)"
                 Placeholder="Choose a member of staff" />

        <QSelect TValue="ClassTeacherRole" TItem="RoleOption"
                 Label="Role"
                 Value="@form.Role"
                 ValueChanged="@(v => form.Role = v)"
                 Items="@roleOptions"
                 ValueSelector="@(r => r.Value)"
                 TextSelector="@(r => r.Label)" />

        @* The single most common way to get this wrong: assigning a class to somebody whose
           RBAC role has no class scope. They are notified but see the whole school (or, on a
           role with no welfare access, nothing at all). Better said here than discovered later. *@
        @if (SelectedStaffRoleCode() is { } rc && rc != RoleCodes.ClassTeacher)
        {
            <div class="ct-inline-warn">
                <QIcon Name="info-circle-fill" />
                <span>
                    This person's role is <strong>@rc</strong>, not Class Teacher. They will be alerted about this class,
                    but their visibility is whatever that role already gives them — assigning a class does not narrow it.
                </span>
            </div>
        }
    </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showAssign = false)" />
        <QButton Text="Assign" Icon="check-lg" Variant="primary" OnClick="@SaveAssignment" Disabled="@(saving || form.UserId == Guid.Empty || string.IsNullOrWhiteSpace(form.ClassName))" />
    </FooterContent>
</QModal>

@* ── Assign a subject teacher ───────────────────────────────────────────────────────────── *@
<QModal @bind-Visible="showSubject" Title="Assign a subject teacher" Icon="book" Size="md" ShowDefaultFooter="false">
    <ChildContent>
    <div class="form-grid">
        <QSelect TValue="string" TItem="ClassTeacherCoverageDto"
                 Label="Class"
                 Value="@subjectForm.ClassName"
                 ValueChanged="@(v => subjectForm.ClassName = v ?? string.Empty)"
                 Items="@coverage.Classes"
                 ValueSelector="@(c => c.ClassName)"
                 TextSelector="@(c => string.IsNullOrWhiteSpace(c.Level) ? c.ClassName : $"{c.ClassName} ({c.Level})")"
                 Placeholder="Choose a class" />

        <QSelect TValue="Guid" TItem="SubjectDto"
                 Label="Subject"
                 Value="@subjectForm.SubjectId"
                 ValueChanged="@(v => subjectForm.SubjectId = v)"
                 Items="@subjects"
                 ValueSelector="@(s => s.Id)"
                 TextSelector="@(s => $"{s.Name} ({s.Code})")"
                 Placeholder="@(subjects.Count == 0 ? "No subjects — add them on the Subjects page" : "Choose a subject")" />

        <QSelect TValue="Guid" TItem="StaffOption"
                 Label="Teacher"
                 Value="@subjectForm.UserId"
                 ValueChanged="@(v => subjectForm.UserId = v)"
                 Items="@staff"
                 ValueSelector="@(s => s.Id)"
                 TextSelector="@(s => s.Label)"
                 Placeholder="Choose a member of staff" />

        <QInput TValue="int?" Label="Periods a week" Type="number" Min="0" Max="60" @bind-Value="subjectForm.PeriodsPerWeek"
                HelperText="The planned load. The timetable compares what it places against this." />

        @if (SubjectStaffRoleCode() is { } rc && rc != RoleCodes.Teacher && rc != RoleCodes.ClassTeacher)
        {
            <div class="ct-inline-warn">
                <QIcon Name="info-circle-fill" />
                <span>
                    This person's role is <strong>@rc</strong>, not Teacher. A subject assignment narrows what a
                    Teacher sees to the students they teach; on this role their visibility is whatever the role already gives them.
                </span>
            </div>
        }
        @if (DuplicateSubjectAssignment())
        {
            <div class="ct-inline-warn">
                <QIcon Name="exclamation-circle-fill" />
                <span>This person already teaches that subject in this class.</span>
            </div>
        }
    </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showSubject = false)" />
        <QButton Text="Assign" Icon="check-lg" Variant="primary" OnClick="@SaveSubjectAssignment"
                 Disabled="@(saving || subjectForm.UserId == Guid.Empty || subjectForm.SubjectId == Guid.Empty || string.IsNullOrWhiteSpace(subjectForm.ClassName) || DuplicateSubjectAssignment())" />
    </FooterContent>
</QModal>

@* ── Periods a week ──────────────────────────────────────────────────────────────────────── *@
<QModal @bind-Visible="showPeriods" Title="Periods a week" Icon="pencil" Size="sm" ShowDefaultFooter="false">
    <ChildContent>
    @if (periodsTarget is { } pt)
    {
        <p class="ct-end-lead"><strong>@pt.FullName</strong> — @pt.SubjectName in <strong>@pt.ClassName</strong>.</p>
        <QInput TValue="int?" Label="Periods a week" Type="number" Min="0" Max="60" @bind-Value="periodsValue"
                HelperText="Leave blank if not planned yet. To change the teacher, subject or class, end this assignment and assign again, so the history stays true." />
    }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showPeriods = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SavePeriods" Disabled="@(saving || periodsValue is < 0 or > 60)" />
    </FooterContent>
</QModal>

@* ── End an assignment ─────────────────────────────────────────────────────────────────── *@
<QModal @bind-Visible="showEnd" Title="End this assignment" Icon="person-dash" Size="sm" ShowDefaultFooter="false">
    <ChildContent>
    @if (ending is { } e)
    {
        @if (e.Role == ClassTeacherRole.SubjectTeacher)
        {
            <p class="ct-end-lead">
                <strong>@e.FullName</strong> will no longer teach <strong>@e.SubjectName</strong> in <strong>@e.ClassName</strong>,
                and from their next request stops seeing those students unless they teach them another subject.
                The assignment is kept in the history, not deleted.
            </p>
        }
        else
        {
            <p class="ct-end-lead">
                <strong>@e.FullName</strong> will immediately stop seeing students in <strong>@e.ClassName</strong>,
                and stop being alerted about them. The assignment is kept in the history, not deleted.
            </p>
        }
        <QInput TValue="string" Label="Reason (optional)" @bind-Value="endReason" Placeholder="e.g. End of term, class handover" />
    }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showEnd = false)" />
        <QButton Text="End assignment" Icon="person-dash" Variant="danger" OnClick="@ConfirmEnd" Disabled="@saving" />
    </FooterContent>
</QModal>

@* ── Contact details ───────────────────────────────────────────────────────────────────── *@
<QModal @bind-Visible="showContact" Title="@($"Contact details — {contactTarget?.FullName}")" Icon="person-vcard" Size="md" ShowDefaultFooter="false">
    <ChildContent>
    <div class="form-grid">
        <p class="ct-end-lead">
            How staff and the front desk reach this teacher about a child in their class. Shown on
            the class card, the roster row and the student's profile.
        </p>
        <QInput TValue="string" Label="Job title" @bind-Value="contactForm.JobTitle" Placeholder="e.g. Form tutor, Head of Year 4" MaxLength="120" />
        <QInput TValue="string" Label="Phone" @bind-Value="contactForm.Phone" Placeholder="0753404044" MaxLength="30" />
        <QInput TValue="string" Label="Alternate phone" @bind-Value="contactForm.AlternatePhone" Placeholder="A second number to try" MaxLength="30" />
        <QInput TValue="string" Label="Office location" @bind-Value="contactForm.OfficeLocation" Placeholder="e.g. Staff room, Block B" MaxLength="200" />
        <p class="form-hint">
            Clearing a field removes it — this replaces the whole contact block rather than merging,
            so a stale number can actually be taken off. The email address is part of the account and
            is changed in the user editor.
        </p>
    </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="ghost" OnClick="@(() => showContact = false)" />
        <QButton Text="Save" Icon="check-lg" Variant="primary" OnClick="@SaveContact" Disabled="@saving" />
    </FooterContent>
</QModal>

@* ── History ───────────────────────────────────────────────────────────────────────────────
   Assignments are ended, never deleted, precisely so this view can exist: "who could see this
   child's file last term" is an audit question a school will eventually be asked. *@
<QModal @bind-Visible="showHistory" Title="@(historyClass == null ? "Class-teacher history" : $"History — {historyClass}")" Icon="clock-history" Size="lg" ShowDefaultFooter="false">
    <ChildContent>
    @if (isLoadingHistory)
    {
        <div class="loading-container"><QSpinner Size="md" /><span>Loading history...</span></div>
    }
    else if (!history.Any())
    {
        <p class="ct-end-lead">
            Nothing recorded @(historyClass == null ? "for this branch" : $"for {historyClass}") yet.
            Every assignment made from now on appears here, including after it ends.
        </p>
    }
    else
    {
        <div class="ct-hist-wrap">
            <table class="ct-hist">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Teacher</th>
                        <th>Role</th>
                        <th>Held</th>
                        <th>Assigned by</th>
                        <th>Ended</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in history)
                    {
                        <tr class="@(h.EndedAt == null ? "ct-hist-live" : "")">
                            <td><strong>@h.ClassName</strong></td>
                            <td>
                                @h.FullName
                                @if (!h.UserIsActive)
                                {
                                    <span class="ct-hist-sub">account inactive</span>
                                }
                            </td>
                            <td>@RoleLabel(h)</td>
                            <td class="ct-hist-when">
                                @QDateFormat.LocalDT(h.AssignedAt)
                                @if (h.EndedAt == null)
                                {
                                    <span class="ct-hist-sub">still current</span>
                                }
                                else
                                {
                                    <span class="ct-hist-sub">to @QDateFormat.LocalDT(h.EndedAt)</span>
                                }
                            </td>
                            <td>@h.AssignedByName</td>
                            <td>
                                @if (h.EndedAt == null)
                                {
                                    <span class="ct-hist-sub">—</span>
                                }
                                else
                                {
                                    @(h.EndedByName ?? "Unknown")
                                    @if (!string.IsNullOrWhiteSpace(h.EndReason))
                                    {
                                        <span class="ct-hist-sub">@h.EndReason</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="form-hint">
            Newest first, capped at the 500 most recent. A row with <strong>still current</strong>
            is a live assignment, not history.
        </p>
    }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Variant="ghost" OnClick="@(() => showHistory = false)" />
    </FooterContent>
</QModal>

@code {
    private bool isLoading = true;
    private bool canManage;
    private bool saving;

    private ClassTeacherCoverageReportDto coverage = new();
    private List<StaffOption> staff = new();

    private bool showAssign;
    private bool showEnd;
    private ClassTeacherDto? ending;
    private string endReason = string.Empty;
    private AssignClassTeacherRequest form = new();

    private bool showContact;
    private ClassTeacherDto? contactTarget;
    private UpdateStaffContactRequest contactForm = new();

    private const int OrphanNamesShown = 10;
    private List<SubjectDto> subjects = new();
    private bool showSubject;
    private AssignSubjectTeacherRequest subjectForm = new();
    private bool showPeriods;
    private ClassTeacherDto? periodsTarget;
    private int? periodsValue;

    private bool showHistory;
    private bool isLoadingHistory;
    private string? historyClass;
    private List<ClassTeacherDto> history = new();

    private record StaffOption(Guid Id, string Label, string RoleCode);
    private record RoleOption(ClassTeacherRole Value, string Label);

    private static readonly List<RoleOption> roleOptions = new()
    {
        new(ClassTeacherRole.ClassTeacher, "Class teacher (one per class)"),
        new(ClassTeacherRole.Assistant, "Assistant class teacher"),
    };

    // OnAfterRenderAsync, never OnInitialized: there is no JS interop during prerendering, so
    // auth state reads as anonymous for everyone in that pass and a permission check made there
    // would bounce a signed-in user. (Prerendering is off here anyway, but the rule stands —
    // see CLAUDE.md.)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!await PermissionService.HasPermissionAsync(Permissions.StudentsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.StudentWelfare))
        {
            Navigation.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        canManage = await PermissionService.HasPermissionAsync(Permissions.ClassTeachersManage);

        await BranchState.InitializeAsync();
        TrackBranch();

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            await BranchState.InitializeAsync();
            var branchId = BranchState.CurrentBranchId;
            if (branchId == Guid.Empty)
            {
                NotificationService.Notify(ToastSeverity.Warning, "No branch selected", "Pick a branch in the header first.");
                return;
            }

            coverage = await ClassTeacherApi.GetCoverageAsync(branchId);

            if (canManage)
            {
                // Only live subjects are offered: a retired one cannot be newly assigned.
                try { subjects = await StaffApi.GetSubjectsAsync(branchId); }
                catch { subjects = new(); }
            }

            // The staff picker. Anyone in the organization can hold a class — a head of year on a
            // custom role is a legitimate assistant — so this is not filtered to the class-teacher
            // role; the dialog warns instead when the role carries no class scope.
            var users = await Http.GetFromJsonAsync<List<UserPickDto>>("api/v1/users?pageSize=500", JsonOptions);
            staff = (users ?? new())
                .Where(u => u.IsActive)
                .OrderBy(u => u.FullName)
                .Select(u => new StaffOption(u.Id, string.IsNullOrWhiteSpace(u.FullName) ? u.Username : $"{u.FullName} ({u.RoleName})", u.RoleCode ?? ""))
                .ToList();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not load class teachers", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string? SelectedStaffRoleCode()
        => staff.FirstOrDefault(s => s.Id == form.UserId)?.RoleCode is { Length: > 0 } rc ? rc : null;

    private void ShowAssignDialog(string? className, ClassTeacherRole role = ClassTeacherRole.ClassTeacher)
    {
        form = new AssignClassTeacherRequest { ClassName = className ?? string.Empty, Role = role };
        showAssign = true;
    }

    private async Task SaveAssignment()
    {
        saving = true;
        try
        {
            await ClassTeacherApi.AssignAsync(BranchState.CurrentBranchId, form);
            NotificationService.Notify(ToastSeverity.Success, "Assigned", $"{form.ClassName} now has a class teacher.");
            showAssign = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // The service THROWS with the server's own message (unlike IQueueApiService), so this
            // shows the real reason — "That class already has a class teacher", not "failed".
            NotificationService.Notify(ToastSeverity.Error, "Could not assign", ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private string? SubjectStaffRoleCode()
        => staff.FirstOrDefault(s => s.Id == subjectForm.UserId)?.RoleCode is { Length: > 0 } rc ? rc : null;

    private bool DuplicateSubjectAssignment()
        => subjectForm.UserId != Guid.Empty && subjectForm.SubjectId != Guid.Empty
           && coverage.Classes.FirstOrDefault(c => string.Equals(c.ClassName, subjectForm.ClassName, StringComparison.OrdinalIgnoreCase)) is { } row
           && row.SubjectTeachers.Any(t => t.UserId == subjectForm.UserId && t.SubjectId == subjectForm.SubjectId);

    private void ShowSubjectDialog(string? className)
    {
        subjectForm = new AssignSubjectTeacherRequest { ClassName = className ?? string.Empty };
        showSubject = true;
    }

    private async Task SaveSubjectAssignment()
    {
        saving = true;
        try
        {
            var dto = await ClassTeacherApi.AssignSubjectTeacherAsync(BranchState.CurrentBranchId, subjectForm);
            NotificationService.Notify(ToastSeverity.Success, "Assigned", $"{dto.FullName} now teaches {dto.SubjectName} in {dto.ClassName}.");
            showSubject = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not assign", ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowPeriodsDialog(ClassTeacherDto assignment)
    {
        periodsTarget = assignment;
        periodsValue = assignment.PeriodsPerWeek;
        showPeriods = true;
    }

    private async Task SavePeriods()
    {
        if (periodsTarget == null) return;
        saving = true;
        try
        {
            await ClassTeacherApi.UpdatePeriodsAsync(BranchState.CurrentBranchId, periodsTarget, periodsValue);
            NotificationService.Notify(ToastSeverity.Success, "Saved", $"{periodsTarget.SubjectName} in {periodsTarget.ClassName}: {(periodsValue?.ToString() ?? "no")} periods a week.");
            showPeriods = false;
            periodsTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not save", ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private static string RoleLabel(ClassTeacherDto a) => a.Role switch
    {
        ClassTeacherRole.ClassTeacher => "Class teacher",
        ClassTeacherRole.Assistant => "Assistant",
        ClassTeacherRole.SubjectTeacher => $"Subject teacher — {a.SubjectName ?? "unknown subject"}",
        _ => a.Role.ToString()
    };

    private void ShowEndDialog(ClassTeacherDto assignment)
    {
        ending = assignment;
        endReason = string.Empty;
        showEnd = true;
    }

    private async Task ConfirmEnd()
    {
        if (ending == null) return;
        saving = true;
        try
        {
            await ClassTeacherApi.EndAsync(BranchState.CurrentBranchId, ending.Id, new EndClassTeacherRequest { Reason = endReason });
            NotificationService.Notify(ToastSeverity.Success, "Assignment ended",
                ending.Role == ClassTeacherRole.SubjectTeacher
                    ? $"{ending.FullName} no longer teaches {ending.SubjectName} in {ending.ClassName}."
                    : $"{ending.FullName} no longer holds {ending.ClassName}.");
            showEnd = false;
            ending = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not end the assignment", ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private void ShowContactDialog(ClassTeacherDto teacher)
    {
        contactTarget = teacher;

        // Pre-filled from the DTO's own contact block. The save is a full replace, so anything not
        // shown here would be blanked — every field the endpoint writes is on the form.
        contactForm = new UpdateStaffContactRequest
        {
            Phone = teacher.Phone,
            AlternatePhone = teacher.AlternatePhone,
            OfficeLocation = teacher.OfficeLocation,
            JobTitle = teacher.JobTitle
        };
        showContact = true;
    }

    private async Task SaveContact()
    {
        if (contactTarget == null) return;
        saving = true;
        try
        {
            await ClassTeacherApi.UpdateContactAsync(BranchState.CurrentBranchId, contactTarget.UserId, contactForm);
            NotificationService.Notify(ToastSeverity.Success, "Contact updated", $"{contactTarget.FullName}'s details have been saved.");
            showContact = false;
            contactTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not save the contact details", ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ShowHistoryDialog(string? className)
    {
        historyClass = className;
        history = new();
        showHistory = true;
        isLoadingHistory = true;

        try
        {
            history = await ClassTeacherApi.GetHistoryAsync(BranchState.CurrentBranchId, className);
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private RenderFragment RenderTeacher(ClassTeacherDto t, bool isPrimary) => @<div class="ct-person @(isPrimary ? "" : "ct-person-assistant")">
        <div class="ct-person-main">
            <div class="ct-avatar">@Initials(t.FullName)</div>
            <div class="ct-person-text">
                <div class="ct-name">
                    @t.FullName
                    @if (!isPrimary)
                    {
                        <QBadge Text="Assistant" Variant="secondary" />
                    }
                    @if (!t.UserIsActive)
                    {
                        <QBadge Text="Account inactive" Variant="danger" />
                    }
                    else if (t.RoleCode != RoleCodes.ClassTeacher)
                    {
                        <QBadge Text="@t.RoleCode" Variant="warning" />
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(t.JobTitle))
                {
                    <div class="ct-title">@t.JobTitle</div>
                }
                <div class="ct-contact">
                    <span><QIcon Name="envelope" /> <a href="mailto:@t.Email">@t.Email</a></span>
                    @if (!string.IsNullOrWhiteSpace(t.Phone))
                    {
                        <span><QIcon Name="telephone" /> <a href="tel:@t.Phone">@t.Phone</a></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.AlternatePhone))
                    {
                        <span><QIcon Name="telephone-plus" /> <a href="tel:@t.AlternatePhone">@t.AlternatePhone</a></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.OfficeLocation))
                    {
                        <span><QIcon Name="geo-alt" /> @t.OfficeLocation</span>
                    }
                </div>
            </div>
        </div>
        @if (canManage)
        {
            <div class="ct-person-actions">
                @* Edited here rather than only in the user editor: the people who maintain "who do
                   I call about this child" are not always the people who administer accounts, which
                   is why the API gives this its own endpoint under classes.teachers.manage. *@
                <QButton Icon="pencil" Variant="ghost" Size="sm" Title="Edit contact details" OnClick="@(() => ShowContactDialog(t))" />
                <QButton Icon="person-dash" Variant="ghost" Size="sm" Title="End this assignment" OnClick="@(() => ShowEndDialog(t))" />
            </div>
        }
    </div>;

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    /// <summary>Only the fields this picker needs — deliberately not the full UserDto, which carries far more than a name picker should pull over the wire.</summary>
    private record UserPickDto
    {
        public Guid Id { get; init; }
        public string Username { get; init; } = "";
        public string FullName { get; init; } = "";
        public string RoleName { get; init; } = "";
        public string? RoleCode { get; init; }
        public bool IsActive { get; init; }
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        await LoadAsync();
    }
}

