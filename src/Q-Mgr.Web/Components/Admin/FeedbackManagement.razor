</style>

@code {
    // ---- Tabs -------------------------------------------------------------------------------
    private const string ResponsesTab = "responses";
    private const string QuestionsTab = "questions";
    private string activeTab = ResponsesTab;

    // Mirrors FeedbackController.MaxActiveQuestionsPerBranch. The server is the authority and
    // rejects an over-cap save; this only stops the button offering something that will fail.
    private const int MaxActiveQuestions = 8;

    private List<FeedbackQuestionDto> questions = new();
    private bool isLoadingQuestions;
    private bool questionsLoaded;
    private bool showQuestionDialog;
    private bool isSavingQuestion;
    private Guid? editingQuestionId;
    // A plain mutable class, not the init-only SaveFeedbackQuestionRequest record: @bind-Value
    // needs a settable property, and an init-only one cannot be assigned outside construction.
    private sealed class QuestionFormModel
    {
        public string QuestionText { get; set; } = string.Empty;
        public FeedbackQuestionType QuestionType { get; set; } = FeedbackQuestionType.Rating;
        public Guid? ServiceTypeId { get; set; }
        public bool IsRequired { get; set; }
        public bool IsActive { get; set; } = true;
        public int DisplayOrder { get; set; }
    }

    private QuestionFormModel questionForm = new();
    private List<string> questionOptions = new();

    private int activeQuestionCount => questions.Count(q => q.IsActive);

    private record QuestionTypeOption(string Label, FeedbackQuestionType Value);
    private record ServiceFilterOption(string Label, Guid? Value);

    private readonly List<QuestionTypeOption> questionTypeOptions = new()
    {
        new("Rating (1 to 5)", FeedbackQuestionType.Rating),
        new("Yes or no", FeedbackQuestionType.YesNo),
        new("Choose one", FeedbackQuestionType.SingleChoice),
        new("Free text", FeedbackQuestionType.FreeText)
    };

    private List<ServiceFilterOption> serviceFilterOptions = new() { new("Every service", null) };

    private static string DescribeType(FeedbackQuestionType type) => type switch
    {
        FeedbackQuestionType.Rating => "Rating 1-5",
        FeedbackQuestionType.YesNo => "Yes / no",
        FeedbackQuestionType.SingleChoice => "Choose one",
        FeedbackQuestionType.FreeText => "Free text",
        _ => type.ToString()
    };

    private bool IsFirst(FeedbackQuestionDto q) =>
        questions.OrderBy(x => x.DisplayOrder).FirstOrDefault()?.Id == q.Id;

    private bool IsLast(FeedbackQuestionDto q) =>
        questions.OrderBy(x => x.DisplayOrder).LastOrDefault()?.Id == q.Id;

    private async Task OpenQuestionsTab()
    {
        activeTab = QuestionsTab;
        if (!questionsLoaded)
        {
            await LoadQuestions();
        }
    }

    private async Task LoadQuestions()
    {
        isLoadingQuestions = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var branchId = BranchState.CurrentBranchId;
            if (branchId == Guid.Empty) return;

            var response = await Http.GetAsync($"api/v1/branches/{branchId}/feedback-questions?includeInactive=true");
            if (response.IsSuccessStatusCode)
            {
                questions = await response.Content.ReadFromJsonAsync<List<FeedbackQuestionDto>>(JsonOptions) ?? new();
                questionsLoaded = true;
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Could not load questions",
                    await ApiErrorService.GetErrorMessageAsync(response, "The survey questions could not be loaded."));
            }

            // Service-type filter choices come from the summary the responses tab already loads.
            var serviceResponse = await Http.GetAsync($"api/v1/branches/{branchId}/service-types");
            if (serviceResponse.IsSuccessStatusCode)
            {
                var serviceTypes = await serviceResponse.Content.ReadFromJsonAsync<List<ServiceTypeDto>>(JsonOptions) ?? new();
                serviceFilterOptions = new List<ServiceFilterOption> { new("Every service", null) };
                serviceFilterOptions.AddRange(serviceTypes.Select(s => new ServiceFilterOption(s.Name, s.Id)));
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not load questions", ex.Message);
        }
        finally
        {
            isLoadingQuestions = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OpenQuestionEditor(FeedbackQuestionDto? existing)
    {
        editingQuestionId = existing?.Id;
        questionOptions = existing?.Options.ToList() ?? new List<string>();
        questionForm = new QuestionFormModel
        {
            QuestionText = existing?.QuestionText ?? string.Empty,
            QuestionType = existing?.QuestionType ?? FeedbackQuestionType.Rating,
            ServiceTypeId = existing?.ServiceTypeId,
            IsRequired = existing?.IsRequired ?? false,
            IsActive = existing?.IsActive ?? true,
            DisplayOrder = existing?.DisplayOrder ?? (questions.Count == 0 ? 1 : questions.Max(q => q.DisplayOrder) + 1)
        };
        showQuestionDialog = true;
    }

    private void OnQuestionTypeChanged(FeedbackQuestionType type)
    {
        questionForm.QuestionType = type;
        if (type == FeedbackQuestionType.SingleChoice && questionOptions.Count == 0)
        {
            questionOptions = new List<string> { string.Empty, string.Empty };
        }
    }

    private async Task SaveQuestion()
    {
        if (string.IsNullOrWhiteSpace(questionForm.QuestionText))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Question needed", "Enter the question the customer will read.");
            return;
        }

        if (questionForm.QuestionType == FeedbackQuestionType.SingleChoice &&
            questionOptions.Count(o => !string.IsNullOrWhiteSpace(o)) < 2)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Choices needed", "A choose-one question needs at least two choices.");
            return;
        }

        isSavingQuestion = true;
        try
        {
            var branchId = BranchState.CurrentBranchId;
            var payload = new SaveFeedbackQuestionRequest
            {
                QuestionText = questionForm.QuestionText,
                QuestionType = questionForm.QuestionType,
                ServiceTypeId = questionForm.ServiceTypeId,
                IsRequired = questionForm.IsRequired,
                IsActive = questionForm.IsActive,
                DisplayOrder = questionForm.DisplayOrder,
                Options = questionOptions.Where(o => !string.IsNullOrWhiteSpace(o)).ToList()
            };

            var response = editingQuestionId == null
                ? await Http.PostAsJsonAsync($"api/v1/branches/{branchId}/feedback-questions", payload)
                : await Http.PutAsJsonAsync($"api/v1/branches/{branchId}/feedback-questions/{editingQuestionId}", payload);

            if (response.IsSuccessStatusCode)
            {
                showQuestionDialog = false;
                NotificationService.Notify(ToastSeverity.Success, "Saved", "The survey question was saved.");
                await LoadQuestions();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Could not save",
                    await ApiErrorService.GetErrorMessageAsync(response, "The question could not be saved."));
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not save", ex.Message);
        }
        finally
        {
            isSavingQuestion = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleQuestion(FeedbackQuestionDto q)
    {
        var branchId = BranchState.CurrentBranchId;
        var payload = new SaveFeedbackQuestionRequest
        {
            QuestionText = q.QuestionText,
            QuestionType = q.QuestionType,
            Options = q.Options.ToList(),
            ServiceTypeId = q.ServiceTypeId,
            DisplayOrder = q.DisplayOrder,
            IsRequired = q.IsRequired,
            IsActive = !q.IsActive
        };

        var response = await Http.PutAsJsonAsync($"api/v1/branches/{branchId}/feedback-questions/{q.Id}", payload);
        if (response.IsSuccessStatusCode)
        {
            await LoadQuestions();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not update",
                await ApiErrorService.GetErrorMessageAsync(response, "The question could not be updated."));
        }
    }

    private async Task DeleteQuestion(FeedbackQuestionDto q)
    {
        var branchId = BranchState.CurrentBranchId;
        var response = await Http.DeleteAsync($"api/v1/branches/{branchId}/feedback-questions/{q.Id}");
        if (response.IsSuccessStatusCode)
        {
            NotificationService.Notify(ToastSeverity.Success, "Deleted", "The survey question was removed.");
            await LoadQuestions();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not delete",
                await ApiErrorService.GetErrorMessageAsync(response, "The question could not be deleted."));
        }
    }

    /// <summary>
    /// Swaps a question with its neighbour and persists the whole order, because display order is
    /// only meaningful relative to the other questions.
    /// </summary>
    private async Task MoveQuestion(FeedbackQuestionDto q, int direction)
    {
        var ordered = questions.OrderBy(x => x.DisplayOrder).ToList();
        var index = ordered.FindIndex(x => x.Id == q.Id);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= ordered.Count) return;

        (ordered[index], ordered[target]) = (ordered[target], ordered[index]);

        var branchId = BranchState.CurrentBranchId;
        var payload = new ReorderFeedbackQuestionsRequest
        {
            QuestionIds = ordered.Select(x => x.Id).ToList()
        };

        var response = await Http.PutAsJsonAsync($"api/v1/branches/{branchId}/feedback-questions/reorder", payload);
        if (response.IsSuccessStatusCode)
        {
            await LoadQuestions();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Could not reorder",
                await ApiErrorService.GetErrorMessageAsync(response, "The new order could not be saved."));
        }
    }

    // ---- Responses --------------------------------------------------------------------------
    private List<FeedbackDto> feedbacks = new();
    private FeedbackSummaryDto? summary;
    private bool isLoading = true;
    private bool showDetailDialog = false;
    private int page = 1;
    private int pageSize = 20;
    private bool canRespond = false;

    private Dictionary<Guid, string> responseTexts = new();

    // Filters
    private int? filterRating;
    private FeedbackCategory? filterCategory;
    private FeedbackSource? filterSource;
    private bool? filterHasResponse;

    private readonly List<(string Label, int? Value)> ratingOptions = new()
    {
        ("5 Stars", 5),
        ("4 Stars", 4),
        ("3 Stars", 3),
        ("2 Stars", 2),
        ("1 Star", 1)
    };

    private readonly List<(string Label, FeedbackCategory? Value)> categoryOptions = new()
    {
        ("General", FeedbackCategory.General),
        ("Service Quality", FeedbackCategory.ServiceQuality),
        ("Wait Time", FeedbackCategory.WaitTime),
        ("Staff Behavior", FeedbackCategory.StaffBehavior),
        ("Facility", FeedbackCategory.Facility),
        ("Other", FeedbackCategory.Other)
    };

    private readonly List<(string Label, FeedbackSource? Value)> sourceOptions = new()
    {
        ("Kiosk", FeedbackSource.Kiosk),
        ("Link", FeedbackSource.Link),
        ("Mobile", FeedbackSource.Mobile),
        ("Web", FeedbackSource.Web)
    };

    private readonly List<(string Label, bool? Value)> responseOptions = new()
    {
        ("Has Response", true),
        ("Needs Response", false)
    };

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.FeedbackView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (!ModuleState.ActiveModuleCodes.Contains(ModuleCodes.EngagementCommunications))
        {
            Navigation.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        canRespond = await PermissionService.HasPermissionAsync(Permissions.FeedbackRespond);

        await LoadData();
    }

    private async Task OnRatingChanged(int? value)
    {
        filterRating = value;
        await LoadData();
    }

    private async Task OnCategoryChanged(FeedbackCategory? value)
    {
        filterCategory = value;
        await LoadData();
    }

    private async Task OnSourceChanged(FeedbackSource? value)
    {
        filterSource = value;
        await LoadData();
    }

    private async Task OnResponseFilterChanged(bool? value)
    {
        filterHasResponse = value;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        page = 1;
        try
        {
            await BranchState.InitializeAsync();
            var branchId = BranchState.CurrentBranchId;

            if (branchId == Guid.Empty)
            {
                NotificationService.Notify(ToastSeverity.Warning, "No Branch Selected", "Please select a branch from the header first.");
                isLoading = false;
                return;
            }

            // Load summary
            var summaryResponse = await Http.GetAsync($"api/v1/branches/{branchId}/feedbacks/summary");
            if (summaryResponse.IsSuccessStatusCode)
            {
                summary = await summaryResponse.Content.ReadFromJsonAsync<FeedbackSummaryDto>(JsonOptions);
            }

            // Build query string
            var query = $"api/v1/branches/{branchId}/feedbacks?page={page}&pageSize={pageSize}";
            if (filterRating.HasValue) query += $"&rating={filterRating}";
            if (filterCategory.HasValue) query += $"&category={filterCategory}";
            if (filterSource.HasValue) query += $"&source={filterSource}";
            if (filterHasResponse.HasValue) query += $"&hasResponse={filterHasResponse}";

            var feedbacksResponse = await Http.GetAsync(query);
            if (feedbacksResponse.IsSuccessStatusCode)
            {
                feedbacks = await feedbacksResponse.Content.ReadFromJsonAsync<List<FeedbackDto>>(JsonOptions) ?? new();
                responseTexts = feedbacks.ToDictionary(f => f.Id, f => string.Empty);
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(feedbacksResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load feedback: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMore()
    {
        page++;
        var branchId = BranchState.CurrentBranchId;

        var query = $"api/v1/branches/{branchId}/feedbacks?page={page}&pageSize={pageSize}";
        if (filterRating.HasValue) query += $"&rating={filterRating}";
        if (filterCategory.HasValue) query += $"&category={filterCategory}";
        if (filterSource.HasValue) query += $"&source={filterSource}";
        if (filterHasResponse.HasValue) query += $"&hasResponse={filterHasResponse}";

        try
        {
            var response = await Http.GetAsync(query);
            if (response.IsSuccessStatusCode)
            {
                var moreFeedbacks = await response.Content.ReadFromJsonAsync<List<FeedbackDto>>(JsonOptions) ?? new();
                feedbacks.AddRange(moreFeedbacks);
                foreach (var f in moreFeedbacks)
                {
                    responseTexts[f.Id] = string.Empty;
                }
            }
        }
        catch { }
    }

    private async Task RespondToFeedback(FeedbackDto feedback)
    {
        var responseText = responseTexts.GetValueOrDefault(feedback.Id);
        if (string.IsNullOrWhiteSpace(responseText)) return;

        try
        {
            var branchId = BranchState.CurrentBranchId;
            var request = new { Response = responseText };
            var response = await Http.PostAsJsonAsync($"api/v1/branches/{branchId}/feedbacks/{feedback.Id}/respond", request, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Response sent successfully");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to send response: {ex.Message}");
        }
    }

    private void ExportFeedback()
    {
        NotificationService.Notify(ToastSeverity.Info, "Export", "Export feature coming soon");
    }

    private string GetSourceIcon(FeedbackSource source)
    {
        return source switch
        {
            FeedbackSource.Kiosk => "computer",
            FeedbackSource.Link => "link",
            FeedbackSource.Mobile => "smartphone",
            FeedbackSource.Web => "language",
            _ => "help"
        };
    }

    private string GetCategoryIcon(FeedbackCategory category)
    {
        return category switch
        {
            FeedbackCategory.General => "chat",
            FeedbackCategory.ServiceQuality => "star",
            FeedbackCategory.WaitTime => "clock",
            FeedbackCategory.StaffBehavior => "person",
            FeedbackCategory.Facility => "building",
            FeedbackCategory.Other => "three-dots",
            _ => "question-circle"
        };
    }
}
