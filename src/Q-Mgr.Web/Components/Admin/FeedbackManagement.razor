@page "/admin/feedback"
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Domain.Constants
@using QMgr.Web.Components.Shared
@using QMgr.Web.Services

<PageTitle>Feedback Management - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Customer Feedback</h1>
            <p class="subtitle">View and respond to customer feedback</p>
        </div>
        <div class="header-actions">
            <PermissionGuard Permission="feedback.analytics">
                <QButton Text="Export" Icon="download" Variant="secondary" OnClick="@ExportFeedback" />
            </PermissionGuard>
            <QButton Text="Refresh" Icon="arrow-clockwise" Variant="primary" OnClick="@LoadData" />
        </div>
    </div>

    <div class="tab-bar" role="tablist" aria-label="Feedback sections">
        <button type="button" role="tab" id="tab-responses"
                aria-selected="@(activeTab == ResponsesTab ? "true" : "false")"
                class="tab-btn @(activeTab == ResponsesTab ? "active" : "")"
                @onclick="@(() => activeTab = ResponsesTab)">
            <QIcon Name="chat-quote-fill" />
            <span>Responses &amp; analytics</span>
        </button>
        <button type="button" role="tab" id="tab-questions"
                aria-selected="@(activeTab == QuestionsTab ? "true" : "false")"
                class="tab-btn @(activeTab == QuestionsTab ? "active" : "")"
                @onclick="@OpenQuestionsTab">
            <QIcon Name="ui-checks" />
            <span>Survey questions</span>
            @if (questions.Count > 0)
            {
                <span class="tab-count">@questions.Count(q => q.IsActive)</span>
            }
        </button>
    </div>

    @if (activeTab == ResponsesTab)
    {

    <!-- Summary Cards -->
    @if (summary != null)
    {
        <div class="summary-cards">
            <div class="summary-card">
                <div class="card-icon total">
                    <QIcon Name="chat-quote-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.TotalFeedbacks</span>
                    <span class="card-label">Total Feedbacks</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon rating">
                    <QIcon Name="star-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.AverageRating.ToString("F1")</span>
                    <span class="card-label">Average Rating</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon positive">
                    <QIcon Name="emoji-smile-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@(summary.FiveStarCount + summary.FourStarCount)</span>
                    <span class="card-label">Positive (4-5 stars)</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon pending">
                    <QIcon Name="hourglass-split" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.PendingResponseCount</span>
                    <span class="card-label">Awaiting Response</span>
                </div>
            </div>
        </div>

        <!-- Rating Distribution -->
        <div class="rating-distribution">
            <h3>Rating Distribution</h3>
            <div class="distribution-bars">
                @for (int star = 5; star >= 1; star--)
                {
                    var count = star switch
                    {
                        5 => summary.FiveStarCount,
                        4 => summary.FourStarCount,
                        3 => summary.ThreeStarCount,
                        2 => summary.TwoStarCount,
                        1 => summary.OneStarCount,
                        _ => 0
                    };
                    var percentage = summary.TotalFeedbacks > 0 ? (double)count / summary.TotalFeedbacks * 100 : 0;
                    <div class="distribution-row">
                        <span class="star-label">@star <QIcon Name="star-fill" /></span>
                        <div class="bar-container">
                            <div class="bar-fill" style="width: @percentage%"></div>
                        </div>
                        <span class="bar-count">@count</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="filters-section">
        <div class="filter-group">
            <QSelect TValue="int?" TItem="(string Label, int? Value)" Value="@filterRating" ValueChanged="@OnRatingChanged" Items="@ratingOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Rating" Placeholder="All Ratings" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="FeedbackCategory?" TItem="(string Label, FeedbackCategory? Value)" Value="@filterCategory" ValueChanged="@OnCategoryChanged" Items="@categoryOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Category" Placeholder="All Categories" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="FeedbackSource?" TItem="(string Label, FeedbackSource? Value)" Value="@filterSource" ValueChanged="@OnSourceChanged" Items="@sourceOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Source" Placeholder="All Sources" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="bool?" TItem="(string Label, bool? Value)" Value="@filterHasResponse" ValueChanged="@OnResponseFilterChanged" Items="@responseOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Response Status" Placeholder="All" AllowClear="true" Class="filter-select" />
        </div>
    </div>

    <!-- Feedback List -->
    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading feedback...</span>
        </div>
    }
    else if (!feedbacks.Any())
    {
        <div class="empty-state">
            <QIcon Name="chat-quote-fill" />
            <h3>No Feedback Yet</h3>
            <p>Customer feedback will appear here once submitted</p>
        </div>
    }
    else
    {
        <div class="feedback-list">
            @foreach (var feedback in feedbacks)
            {
                <div class="feedback-card @(string.IsNullOrEmpty(feedback.Response) ? "needs-response" : "")">
                    <div class="feedback-header">
                        <div class="rating-display">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <QIcon Name="@(feedback.Rating >= i ? "star-fill" : "star")" Class="@(feedback.Rating >= i ? "filled" : "")" />
                            }
                        </div>
                        <div class="feedback-meta">
                            <span class="source-badge @feedback.Source.ToString().ToLower()">
                                @GetSourceIcon(feedback.Source)
                                @feedback.Source
                            </span>
                            <span class="timestamp">@feedback.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="feedback-body">
                        @if (!string.IsNullOrEmpty(feedback.Comment))
                        {
                            <p class="comment">"@feedback.Comment"</p>
                        }
                        else
                        {
                            <p class="no-comment">No comment provided</p>
                        }

                        <div class="feedback-details">
                            @if (!string.IsNullOrEmpty(feedback.TokenDisplayNumber))
                            {
                                <span class="detail-item">
                                    <QIcon Name="ticket-detailed-fill" />
                                    @feedback.TokenDisplayNumber
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(feedback.ServiceTypeName))
                            {
                                <span class="detail-item">
                                    <QIcon Name="grid-fill" />
                                    @feedback.ServiceTypeName
                                </span>
                            }
                            <span class="detail-item category">
                                <QIcon Name="@GetCategoryIcon(feedback.Category)" />
                                @feedback.Category
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(feedback.CustomerName) || !string.IsNullOrEmpty(feedback.CustomerEmail) || !string.IsNullOrEmpty(feedback.CustomerPhone))
                        {
                            <div class="customer-info">
                                @if (!string.IsNullOrEmpty(feedback.CustomerName))
                                {
                                    <span><QIcon Name="person-fill" /> @feedback.CustomerName</span>
                                }
                                @if (!string.IsNullOrEmpty(feedback.CustomerEmail))
                                {
                                    <span><QIcon Name="envelope-fill" /> @feedback.CustomerEmail</span>
                                }
                                @if (!string.IsNullOrEmpty(feedback.CustomerPhone))
                                {
                                    <span><QIcon Name="telephone-fill" /> @feedback.CustomerPhone</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="feedback-footer">
                        @if (!string.IsNullOrEmpty(feedback.Response))
                        {
                            <div class="response-section">
                                <div class="response-header">
                                    <QIcon Name="reply-fill" />
                                    <span>Response</span>
                                    @if (feedback.RespondedAt.HasValue)
                                    {
                                        <span class="response-time">@feedback.RespondedAt.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                </div>
                                <p class="response-text">@feedback.Response</p>
                            </div>
                        }
                        else if (canRespond)
                        {
                            <div class="respond-section">
                                <textarea @bind="responseTexts[feedback.Id]" placeholder="Write a response..." rows="2"></textarea>
                                <QButton Text="Send Response" Icon="send-fill" Size="sm"
                                              Variant="primary" OnClick="@(() => RespondToFeedback(feedback))"
                                              Disabled="@(string.IsNullOrWhiteSpace(responseTexts.GetValueOrDefault(feedback.Id)))" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (feedbacks.Count >= pageSize)
        {
            <div class="load-more">
                <QButton Text="Load More" Icon="arrow-down-circle" Variant="secondary" OnClick="@LoadMore" />
            </div>
        }
    }
    }

    @if (activeTab == QuestionsTab)
    {
        <QCard Class="questions-card">
            <div class="questions-intro">
                <div>
                    <h3>Survey questions</h3>
                    <p>
                        Asked after the star rating on the public feedback form. Keep the list short:
                        a survey that takes more than about a minute does not get finished.
                        @if (activeQuestionCount >= MaxActiveQuestions)
                        {
                            <strong> You have reached the maximum of @MaxActiveQuestions active questions.</strong>
                        }
                    </p>
                </div>
                <PermissionGuard Permission="feedback.respond">
                    <QButton Text="Add question" Icon="plus-lg" Variant="primary"
                             Disabled="@(activeQuestionCount >= MaxActiveQuestions)"
                             OnClick="@(() => OpenQuestionEditor(null))" />
                </PermissionGuard>
            </div>

            @if (isLoadingQuestions)
            {
                <div class="questions-empty"><span>Loading questions…</span></div>
            }
            else if (questions.Count == 0)
            {
                <div class="questions-empty">
                    <QIcon Name="ui-checks" />
                    <span>No survey questions yet. The public form still asks for a star rating, a recommendation score and a comment.</span>
                </div>
            }
            else
            {
                <div class="question-list">
                    @foreach (var q in questions.OrderBy(q => q.DisplayOrder).ToList())
                    {
                        <div class="question-row @(q.IsActive ? "" : "is-inactive")">
                            <div class="question-order">
                                <button type="button" class="order-btn" title="Move up" aria-label="@($"Move '{q.QuestionText}' up")"
                                        disabled="@(IsFirst(q))" @onclick="@(() => MoveQuestion(q, -1))">
                                    <QIcon Name="chevron-up" />
                                </button>
                                <button type="button" class="order-btn" title="Move down" aria-label="@($"Move '{q.QuestionText}' down")"
                                        disabled="@(IsLast(q))" @onclick="@(() => MoveQuestion(q, 1))">
                                    <QIcon Name="chevron-down" />
                                </button>
                            </div>
                            <div class="question-main">
                                <span class="question-text">@q.QuestionText</span>
                                <div class="question-meta">
                                    <span class="question-chip">@DescribeType(q.QuestionType)</span>
                                    @if (q.IsRequired)
                                    {
                                        <span class="question-chip is-required">Required</span>
                                    }
                                    @if (q.ServiceTypeId != null)
                                    {
                                        <span class="question-chip">Only @(q.ServiceTypeName ?? "one service")</span>
                                    }
                                    @if (!q.IsActive)
                                    {
                                        <span class="question-chip is-inactive">Hidden</span>
                                    }
                                </div>
                            </div>
                            <PermissionGuard Permission="feedback.respond">
                                <div class="question-actions">
                                    <QButton Icon="@(q.IsActive ? "eye-slash" : "eye")" Variant="ghost" Size="sm"
                                             Text="@(q.IsActive ? "Hide" : "Show")" OnClick="@(() => ToggleQuestion(q))" />
                                    <QButton Icon="pencil-fill" Variant="ghost" Size="sm" Text="Edit"
                                             OnClick="@(() => OpenQuestionEditor(q))" />
                                    <QButton Icon="trash-fill" Variant="danger" Size="sm" Text="Delete"
                                             OnClick="@(() => DeleteQuestion(q))" />
                                </div>
                            </PermissionGuard>
                        </div>
                    }
                </div>
            }
        </QCard>

        @* A preview beats a description: it is the only way to see what the customer will read. *@
        <QCard Class="questions-preview" Title="What the customer sees" Icon="phone">
            <div class="preview-frame">
                <div class="preview-step"><span class="preview-step-num">1</span> How was your experience? (1 to 5 stars)</div>
                @{
                    var previewOrder = 2;
                }
                @foreach (var q in questions.Where(q => q.IsActive).OrderBy(q => q.DisplayOrder))
                {
                    <div class="preview-step">
                        <span class="preview-step-num">@previewOrder</span>
                        @q.QuestionText
                        @if (q.IsRequired)
                        {
                            <span class="preview-required">*</span>
                        }
                        <span class="preview-type">@DescribeType(q.QuestionType)</span>
                    </div>
                    previewOrder++;
                }
                <div class="preview-step"><span class="preview-step-num">@previewOrder</span> How likely are you to recommend us? (0 to 10)</div>
                <div class="preview-step"><span class="preview-step-num">@(previewOrder + 1)</span> Anything else you would like to tell us? (optional)</div>
            </div>
        </QCard>
    }
</div>

<QModal @bind-Visible="showQuestionDialog" Title="@(editingQuestionId == null ? "Add question" : "Edit question")" Size="md">
    <ChildContent>
        <div class="question-form">
            <div class="form-group">
                <label for="q-text">Question</label>
                <QInput TValue="string" @bind-Value="questionForm.QuestionText" Id="q-text"
                        Placeholder="e.g. Was the counter easy to find?" MaxLength="200" />
            </div>
            <div class="form-group">
                <label for="q-type">Answer type</label>
                <QSelect TValue="FeedbackQuestionType" TItem="QuestionTypeOption" Id="q-type"
                         Data="@questionTypeOptions" TextField="Label" ValueField="Value"
                         Value="@questionForm.QuestionType" ValueChanged="@OnQuestionTypeChanged" />
            </div>
            @if (questionForm.QuestionType == FeedbackQuestionType.SingleChoice)
            {
                <div class="form-group">
                    <label>Choices</label>
                    @for (var i = 0; i < questionOptions.Count; i++)
                    {
                        var index = i;
                        <div class="choice-row">
                            <QInput TValue="string" Value="@questionOptions[index]"
                                    ValueChanged="@(v => questionOptions[index] = v ?? string.Empty)"
                                    Placeholder="@($"Choice {index + 1}")" MaxLength="80" />
                            <QButton Icon="trash-fill" Variant="danger" Size="sm"
                                     OnClick="@(() => questionOptions.RemoveAt(index))" />
                        </div>
                    }
                    <QButton Text="Add choice" Icon="plus-lg" Variant="secondary" Size="sm"
                             OnClick="@(() => questionOptions.Add(string.Empty))" />
                </div>
            }
            <div class="form-group">
                <label for="q-service">Ask for</label>
                <QSelect TValue="Guid?" TItem="ServiceFilterOption" Id="q-service"
                         Data="@serviceFilterOptions" TextField="Label" ValueField="Value"
                         Value="@questionForm.ServiceTypeId" ValueChanged="@(v => questionForm.ServiceTypeId = v)" />
            </div>
            <div class="settings-toggle-group">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="q-required"
                           checked="@questionForm.IsRequired"
                           @onchange="@(e => questionForm.IsRequired = (bool)(e.Value ?? false))" />
                </div>
                <div class="settings-toggle-info">
                    <label class="settings-toggle-label" for="q-required">Answer required</label>
                    <small>The customer cannot submit without answering. Use sparingly.</small>
                </div>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Variant="secondary" OnClick="@(() => showQuestionDialog = false)" />
        <QButton Text="Save" Variant="primary" OnClick="@SaveQuestion" Loading="@isSavingQuestion" />
    </FooterContent>
</QModal>

<QModal @bind-Visible="showDetailDialog" Title="Feedback Details" Size="md">
    <ChildContent>
        <!-- Detail dialog content -->
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showDetailDialog = false)" />
    </FooterContent>
</QModal>

<style>
    .admin-page {
        padding: 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-content h1 {
        margin: 0 0 4px;
        font-size: 28px;
        color: var(--qm-text-primary);
    }

    .subtitle {
        margin: 0;
        color: var(--qm-text-muted);
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    /* Summary Cards */
    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .card-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-icon .rzi {
        font-size: 28px;
    }

    .card-icon.total {
        background: color-mix(in srgb, var(--qm-info) 15%, transparent);
        color: var(--qm-info);
    }

    .card-icon.rating {
        background: color-mix(in srgb, var(--qm-warning) 15%, transparent);
        color: var(--qm-warning);
    }

    .card-icon.positive {
        background: color-mix(in srgb, var(--qm-success) 15%, transparent);
        color: var(--qm-success);
    }

    .card-icon.pending {
        background: var(--qm-secondary-light);
        color: var(--qm-secondary);
    }

    .card-content {
        display: flex;
        flex-direction: column;
    }

    .card-value {
        font-size: 28px;
        font-weight: 700;
        color: var(--qm-text-primary);
        line-height: 1.2;
    }

    .card-label {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    /* Rating Distribution */
    .rating-distribution {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 24px;
        margin-bottom: 24px;
    }

    .rating-distribution h3 {
        margin: 0 0 20px;
        font-size: 16px;
        color: var(--qm-text-primary);
    }

    .distribution-bars {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .distribution-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .star-label {
        width: 48px;
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 14px;
        color: var(--qm-text-secondary);
    }

    .star-label .rzi {
        font-size: 16px;
        color: var(--qm-warning);
    }

    .bar-container {
        flex: 1;
        height: 8px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--qm-warning) 0%, var(--qm-warning) 100%);
        border-radius: var(--qm-radius-sm);
        transition: width 0.5s ease;
    }

    .bar-count {
        width: 40px;
        text-align: right;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    /* Filters */
    .filters-section {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 24px;
        padding: 20px;
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-group .filter-select {
        min-width: 150px;
    }

    .filter-group .filter-select .q-select__label {
        font-size: 12px;
        font-weight: 500;
        color: var(--qm-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Loading & Empty States */
    .loading-container, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        color: var(--qm-text-muted);
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
    }

    .empty-state .rzi {
        font-size: 64px;
        margin-bottom: 16px;
        color: var(--qm-primary);
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--qm-text-primary);
    }

    .empty-state p {
        margin: 0;
    }

    /* Feedback List */
    .feedback-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .feedback-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .feedback-card:hover {
        box-shadow: var(--qm-shadow-md);
    }

    .feedback-card.needs-response {
        border-left: 4px solid var(--qm-secondary);
    }

    .feedback-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        background: var(--qm-bg-elevated);
        border-bottom: 1px solid var(--qm-border);
    }

    .rating-display {
        display: flex;
        gap: 4px;
    }

    .rating-display .rzi {
        font-size: 20px;
        color: color-mix(in srgb, var(--qm-text-primary) 20%, transparent);
    }

    .rating-display .rzi.filled {
        color: var(--qm-warning);
    }

    .feedback-meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .source-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: var(--qm-radius-md);
        font-size: 12px;
        font-weight: 500;
    }

    .source-badge.kiosk {
        background: color-mix(in srgb, var(--qm-info) 15%, transparent);
        color: var(--qm-info);
    }

    .source-badge.link {
        background: var(--qm-secondary-light);
        color: var(--qm-secondary);
    }

    .source-badge.mobile {
        background: color-mix(in srgb, var(--qm-success) 15%, transparent);
        color: var(--qm-success);
    }

    .source-badge.web {
        background: color-mix(in srgb, var(--qm-warning) 15%, transparent);
        color: var(--qm-warning);
    }

    .timestamp {
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    .feedback-body {
        padding: 20px;
    }

    .comment {
        font-size: 15px;
