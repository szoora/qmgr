@page "/admin/feedback"
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IBranchStateService BranchState
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared
@using QMgr.Web.Services

<PageTitle>Feedback Management - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Customer Feedback</h1>
            <p class="subtitle">View and respond to customer feedback</p>
        </div>
        <div class="header-actions">
            <PermissionGuard Permission="feedback.analytics">
                <QButton Text="Export" Icon="download" Variant="secondary" OnClick="@ExportFeedback" />
            </PermissionGuard>
            <QButton Text="Refresh" Icon="arrow-clockwise" Variant="primary" OnClick="@LoadData" />
        </div>
    </div>

    <!-- Summary Cards -->
    @if (summary != null)
    {
        <div class="summary-cards">
            <div class="summary-card">
                <div class="card-icon total">
                    <QIcon Name="chat-quote-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.TotalFeedbacks</span>
                    <span class="card-label">Total Feedbacks</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon rating">
                    <QIcon Name="star-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.AverageRating.ToString("F1")</span>
                    <span class="card-label">Average Rating</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon positive">
                    <QIcon Name="emoji-smile-fill" />
                </div>
                <div class="card-content">
                    <span class="card-value">@(summary.FiveStarCount + summary.FourStarCount)</span>
                    <span class="card-label">Positive (4-5 stars)</span>
                </div>
            </div>
            <div class="summary-card">
                <div class="card-icon pending">
                    <QIcon Name="hourglass-split" />
                </div>
                <div class="card-content">
                    <span class="card-value">@summary.PendingResponseCount</span>
                    <span class="card-label">Awaiting Response</span>
                </div>
            </div>
        </div>

        <!-- Rating Distribution -->
        <div class="rating-distribution">
            <h3>Rating Distribution</h3>
            <div class="distribution-bars">
                @for (int star = 5; star >= 1; star--)
                {
                    var count = star switch
                    {
                        5 => summary.FiveStarCount,
                        4 => summary.FourStarCount,
                        3 => summary.ThreeStarCount,
                        2 => summary.TwoStarCount,
                        1 => summary.OneStarCount,
                        _ => 0
                    };
                    var percentage = summary.TotalFeedbacks > 0 ? (double)count / summary.TotalFeedbacks * 100 : 0;
                    <div class="distribution-row">
                        <span class="star-label">@star <QIcon Name="star-fill" /></span>
                        <div class="bar-container">
                            <div class="bar-fill" style="width: @percentage%"></div>
                        </div>
                        <span class="bar-count">@count</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filters -->
    <div class="filters-section">
        <div class="filter-group">
            <QSelect TValue="int?" TItem="(string Label, int? Value)" Value="@filterRating" ValueChanged="@OnRatingChanged" Items="@ratingOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Rating" Placeholder="All Ratings" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="FeedbackCategory?" TItem="(string Label, FeedbackCategory? Value)" Value="@filterCategory" ValueChanged="@OnCategoryChanged" Items="@categoryOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Category" Placeholder="All Categories" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="FeedbackSource?" TItem="(string Label, FeedbackSource? Value)" Value="@filterSource" ValueChanged="@OnSourceChanged" Items="@sourceOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Source" Placeholder="All Sources" AllowClear="true" Class="filter-select" />
        </div>
        <div class="filter-group">
            <QSelect TValue="bool?" TItem="(string Label, bool? Value)" Value="@filterHasResponse" ValueChanged="@OnResponseFilterChanged" Items="@responseOptions"
                     TextSelector="@(x => x.Label)" ValueSelector="@(x => x.Value)"
                     Label="Response Status" Placeholder="All" AllowClear="true" Class="filter-select" />
        </div>
    </div>

    <!-- Feedback List -->
    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading feedback...</span>
        </div>
    }
    else if (!feedbacks.Any())
    {
        <div class="empty-state">
            <QIcon Name="chat-quote-fill" />
            <h3>No Feedback Yet</h3>
            <p>Customer feedback will appear here once submitted</p>
        </div>
    }
    else
    {
        <div class="feedback-list">
            @foreach (var feedback in feedbacks)
            {
                <div class="feedback-card @(string.IsNullOrEmpty(feedback.Response) ? "needs-response" : "")">
                    <div class="feedback-header">
                        <div class="rating-display">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <QIcon Name="@(feedback.Rating >= i ? "star-fill" : "star")" Class="@(feedback.Rating >= i ? "filled" : "")" />
                            }
                        </div>
                        <div class="feedback-meta">
                            <span class="source-badge @feedback.Source.ToString().ToLower()">
                                @GetSourceIcon(feedback.Source)
                                @feedback.Source
                            </span>
                            <span class="timestamp">@feedback.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="feedback-body">
                        @if (!string.IsNullOrEmpty(feedback.Comment))
                        {
                            <p class="comment">"@feedback.Comment"</p>
                        }
                        else
                        {
                            <p class="no-comment">No comment provided</p>
                        }

                        <div class="feedback-details">
                            @if (!string.IsNullOrEmpty(feedback.TokenDisplayNumber))
                            {
                                <span class="detail-item">
                                    <QIcon Name="ticket-detailed-fill" />
                                    @feedback.TokenDisplayNumber
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(feedback.ServiceTypeName))
                            {
                                <span class="detail-item">
                                    <QIcon Name="grid-fill" />
                                    @feedback.ServiceTypeName
                                </span>
                            }
                            <span class="detail-item category">
                                <QIcon Name="@GetCategoryIcon(feedback.Category)" />
                                @feedback.Category
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(feedback.CustomerName) || !string.IsNullOrEmpty(feedback.CustomerEmail) || !string.IsNullOrEmpty(feedback.CustomerPhone))
                        {
                            <div class="customer-info">
                                @if (!string.IsNullOrEmpty(feedback.CustomerName))
                                {
                                    <span><QIcon Name="person-fill" /> @feedback.CustomerName</span>
                                }
                                @if (!string.IsNullOrEmpty(feedback.CustomerEmail))
                                {
                                    <span><QIcon Name="envelope-fill" /> @feedback.CustomerEmail</span>
                                }
                                @if (!string.IsNullOrEmpty(feedback.CustomerPhone))
                                {
                                    <span><QIcon Name="telephone-fill" /> @feedback.CustomerPhone</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="feedback-footer">
                        @if (!string.IsNullOrEmpty(feedback.Response))
                        {
                            <div class="response-section">
                                <div class="response-header">
                                    <QIcon Name="reply-fill" />
                                    <span>Response</span>
                                    @if (feedback.RespondedAt.HasValue)
                                    {
                                        <span class="response-time">@feedback.RespondedAt.Value.ToString("MMM dd, yyyy")</span>
                                    }
                                </div>
                                <p class="response-text">@feedback.Response</p>
                            </div>
                        }
                        else if (canRespond)
                        {
                            <div class="respond-section">
                                <textarea @bind="responseTexts[feedback.Id]" placeholder="Write a response..." rows="2"></textarea>
                                <QButton Text="Send Response" Icon="send-fill" Size="sm"
                                              Variant="primary" OnClick="@(() => RespondToFeedback(feedback))"
                                              Disabled="@(string.IsNullOrWhiteSpace(responseTexts.GetValueOrDefault(feedback.Id)))" />
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (feedbacks.Count >= pageSize)
        {
            <div class="load-more">
                <QButton Text="Load More" Icon="arrow-down-circle" Variant="secondary" OnClick="@LoadMore" />
            </div>
        }
    }
</div>

<QModal @bind-Visible="showDetailDialog" Title="Feedback Details" Size="md">
    <ChildContent>
        <!-- Detail dialog content -->
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="ghost" OnClick="@(() => showDetailDialog = false)" />
    </FooterContent>
</QModal>

<style>
