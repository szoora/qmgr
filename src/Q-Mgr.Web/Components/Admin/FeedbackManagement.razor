</style>

@code {
    private List<FeedbackDto> feedbacks = new();
    private FeedbackSummaryDto? summary;
    private bool isLoading = true;
    private bool showDetailDialog = false;
    private int page = 1;
    private int pageSize = 20;
    private bool canRespond = false;

    private Dictionary<Guid, string> responseTexts = new();

    // Filters
    private int? filterRating;
    private FeedbackCategory? filterCategory;
    private FeedbackSource? filterSource;
    private bool? filterHasResponse;

    private readonly List<(string Label, int? Value)> ratingOptions = new()
    {
        ("5 Stars", 5),
        ("4 Stars", 4),
        ("3 Stars", 3),
        ("2 Stars", 2),
        ("1 Star", 1)
    };

    private readonly List<(string Label, FeedbackCategory? Value)> categoryOptions = new()
    {
        ("General", FeedbackCategory.General),
        ("Service Quality", FeedbackCategory.ServiceQuality),
        ("Wait Time", FeedbackCategory.WaitTime),
        ("Staff Behavior", FeedbackCategory.StaffBehavior),
        ("Facility", FeedbackCategory.Facility),
        ("Other", FeedbackCategory.Other)
    };

    private readonly List<(string Label, FeedbackSource? Value)> sourceOptions = new()
    {
        ("Kiosk", FeedbackSource.Kiosk),
        ("Link", FeedbackSource.Link),
        ("Mobile", FeedbackSource.Mobile),
        ("Web", FeedbackSource.Web)
    };

    private readonly List<(string Label, bool? Value)> responseOptions = new()
    {
        ("Has Response", true),
        ("Needs Response", false)
    };

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.FeedbackView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        canRespond = await PermissionService.HasPermissionAsync(Permissions.FeedbackRespond);

        await LoadData();
    }

    private async Task OnRatingChanged(int? value)
    {
        filterRating = value;
        await LoadData();
    }

    private async Task OnCategoryChanged(FeedbackCategory? value)
    {
        filterCategory = value;
        await LoadData();
    }

    private async Task OnSourceChanged(FeedbackSource? value)
    {
        filterSource = value;
        await LoadData();
    }

    private async Task OnResponseFilterChanged(bool? value)
    {
        filterHasResponse = value;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        page = 1;
        try
        {
            await BranchState.InitializeAsync();
            var branchId = BranchState.CurrentBranchId;

            if (branchId == Guid.Empty)
            {
                NotificationService.Notify(ToastSeverity.Warning, "No Branch Selected", "Please select a branch from the header first.");
                isLoading = false;
                return;
            }

            // Load summary
            var summaryResponse = await Http.GetAsync($"api/v1/branches/{branchId}/feedbacks/summary");
            if (summaryResponse.IsSuccessStatusCode)
            {
                summary = await summaryResponse.Content.ReadFromJsonAsync<FeedbackSummaryDto>(JsonOptions);
            }

            // Build query string
            var query = $"api/v1/branches/{branchId}/feedbacks?page={page}&pageSize={pageSize}";
            if (filterRating.HasValue) query += $"&rating={filterRating}";
            if (filterCategory.HasValue) query += $"&category={filterCategory}";
            if (filterSource.HasValue) query += $"&source={filterSource}";
            if (filterHasResponse.HasValue) query += $"&hasResponse={filterHasResponse}";

            var feedbacksResponse = await Http.GetAsync(query);
            if (feedbacksResponse.IsSuccessStatusCode)
            {
                feedbacks = await feedbacksResponse.Content.ReadFromJsonAsync<List<FeedbackDto>>(JsonOptions) ?? new();
                responseTexts = feedbacks.ToDictionary(f => f.Id, f => string.Empty);
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(feedbacksResponse);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load feedback: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMore()
    {
        page++;
        var branchId = BranchState.CurrentBranchId;

        var query = $"api/v1/branches/{branchId}/feedbacks?page={page}&pageSize={pageSize}";
        if (filterRating.HasValue) query += $"&rating={filterRating}";
        if (filterCategory.HasValue) query += $"&category={filterCategory}";
        if (filterSource.HasValue) query += $"&source={filterSource}";
        if (filterHasResponse.HasValue) query += $"&hasResponse={filterHasResponse}";

        try
        {
            var response = await Http.GetAsync(query);
            if (response.IsSuccessStatusCode)
            {
                var moreFeedbacks = await response.Content.ReadFromJsonAsync<List<FeedbackDto>>(JsonOptions) ?? new();
                feedbacks.AddRange(moreFeedbacks);
                foreach (var f in moreFeedbacks)
                {
                    responseTexts[f.Id] = string.Empty;
                }
            }
        }
        catch { }
    }

    private async Task RespondToFeedback(FeedbackDto feedback)
    {
        var responseText = responseTexts.GetValueOrDefault(feedback.Id);
        if (string.IsNullOrWhiteSpace(responseText)) return;

        try
        {
            var branchId = BranchState.CurrentBranchId;
            var request = new { Response = responseText };
            var response = await Http.PostAsJsonAsync($"api/v1/branches/{branchId}/feedbacks/{feedback.Id}/respond", request, JsonOptions);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Response sent successfully");
                await LoadData();
            }
            else
            {
                var (title, detail) = await ApiErrorService.GetErrorDetailsAsync(response);
                NotificationService.Notify(ToastSeverity.Error, title, detail);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to send response: {ex.Message}");
        }
    }

    private void ExportFeedback()
    {
        NotificationService.Notify(ToastSeverity.Info, "Export", "Export feature coming soon");
    }

    private string GetSourceIcon(FeedbackSource source)
    {
        return source switch
        {
            FeedbackSource.Kiosk => "computer",
            FeedbackSource.Link => "link",
            FeedbackSource.Mobile => "smartphone",
            FeedbackSource.Web => "language",
            _ => "help"
        };
    }

    private string GetCategoryIcon(FeedbackCategory category)
    {
        return category switch
        {
            FeedbackCategory.General => "chat",
            FeedbackCategory.ServiceQuality => "star",
            FeedbackCategory.WaitTime => "clock",
            FeedbackCategory.StaffBehavior => "person",
            FeedbackCategory.Facility => "building",
            FeedbackCategory.Other => "three-dots",
            _ => "question-circle"
        };
    }
