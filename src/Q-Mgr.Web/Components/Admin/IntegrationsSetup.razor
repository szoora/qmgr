@page "/admin/integrations"
@using System.Text.Json
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inject IAuthService AuthService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>Integrations - Q-Mgr</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Integrations</h1>
            <p class="subtitle">Connect Q-Mgr with external systems and services</p>
        </div>
    </div>

    <div class="integrations-grid">
        @foreach (var integration in integrations)
        {
            <div class="integration-card @(integration.IsConnected ? "connected" : "")">
                <div class="integration-header">
                    <div class="integration-logo" style="background: @integration.Color">
                        <QIcon Name="@integration.Icon" />
                    </div>
                    <div class="integration-status">
                        @if (integration.IsConnected)
                        {
                            <span class="status connected"><QIcon Name="check-circle-fill" /> Connected</span>
                        }
                        else
                        {
                            <span class="status">Not Connected</span>
                        }
                    </div>
                </div>
                <div class="integration-body">
                    <h4>@integration.Name</h4>
                    <p>@integration.Description</p>
                    <div class="integration-features">
                        @foreach (var feature in integration.Features.Take(3))
                        {
                            <span class="feature-tag"><QIcon Name="check-lg" /> @feature</span>
                        }
                    </div>
                </div>
                <div class="integration-footer">
                    @if (integration.IsConnected)
                    {
                        <QButton Text="Configure" Icon="gear-fill" Variant="secondary" Size="sm" OnClick="@(() => ConfigureIntegration(integration))" />
                        <QButton Text="Disconnect" Icon="x-circle-fill" Variant="ghost" Size="sm" OnClick="@(() => DisconnectIntegration(integration))" />
                    }
                    else
                    {
                        <QButton Text="Connect" Icon="link-45deg" Variant="primary" Size="sm" OnClick="@(() => ConnectIntegration(integration))" />
                    }
                </div>
            </div>
        }
    </div>

    <div class="webhooks-section">
        <div class="section-header">
            <h2>Webhooks</h2>
            <QButton Text="Add Webhook" Icon="plus-lg" Size="sm" OnClick="@AddWebhook" />
        </div>
        <div class="webhooks-list">
            @foreach (var webhook in webhooks)
            {
                <div class="webhook-item">
                    <div class="webhook-info">
                        <span class="webhook-url">@webhook.Url</span>
                        <div class="webhook-events">
                            @foreach (var evt in webhook.Events)
                            {
                                <span class="event-tag">@evt</span>
                            }
                        </div>
                    </div>
                    <div class="webhook-status">
                        <QBadge Variant="@(webhook.IsActive ? "success" : "secondary")"
                                Text="@(webhook.IsActive ? "Active" : "Inactive")" Size="sm" />
                    </div>
                    <div class="webhook-actions">
                        <QButton Icon="pencil-fill" Variant="ghost" Size="sm" />
                        <QButton Icon="trash-fill" Variant="ghost" Size="sm" OnClick="@(() => webhooks.Remove(webhook))" />
                    </div>
                </div>
            }
            @if (!webhooks.Any())
            {
                <div class="empty-webhooks">
                    <QIcon Name="arrow-repeat" />
                    <p>No webhooks configured</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .admin-page { padding: 0; }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

    .header-content h1 { margin: 0 0 4px; font-size: 28px; color: var(--qm-text-primary); }
    .subtitle { margin: 0; color: var(--qm-text-muted); font-size: 14px; }

    .integrations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .integration-card {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .integration-card:hover { box-shadow: var(--qm-shadow-md); }
    .integration-card.connected { border-color: var(--qm-success); }

    .integration-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px;
        background: var(--qm-bg-elevated);
    }

    .integration-logo {
        width: 48px;
        height: 48px;
        border-radius: var(--qm-radius-lg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
    }

    .integration-status .status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .integration-status .status.connected { color: var(--qm-success); }

    .integration-body { padding: 16px; }
    .integration-body h4 { margin: 0 0 8px; color: var(--qm-text-primary); }
    .integration-body p { margin: 0 0 12px; font-size: 13px; color: var(--qm-text-muted); line-height: 1.5; }

    .integration-features { display: flex; flex-wrap: wrap; gap: 8px; }

    .feature-tag {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-md);
        font-size: 11px;
        color: var(--qm-text-secondary);
    }

    .feature-tag .rzi { font-size: 12px; color: var(--qm-success); }

    .integration-footer {
        display: flex;
        gap: 12px;
        padding: 12px 16px;
        border-top: 1px solid var(--qm-border);
    }

    .webhooks-section {
        background: var(--qm-bg-card);
        border: 1px solid var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .section-header h2 { margin: 0; font-size: 18px; color: var(--qm-text-primary); }

    .webhooks-list { display: flex; flex-direction: column; gap: 12px; }

    .webhook-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px;
        background: var(--qm-bg-elevated);
        border-radius: var(--qm-radius-lg);
        border: 1px solid var(--qm-border);
    }

    .webhook-info { flex: 1; }
    .webhook-url { font-family: var(--qm-font-mono); font-size: 13px; color: var(--qm-primary); }

    .webhook-events {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }

    .event-tag {
        padding: 2px 8px;
        background: var(--qm-primary-light);
        color: var(--qm-primary);
        border-radius: var(--qm-radius-sm);
        font-size: 10px;
        font-weight: 500;
    }

    .webhook-actions { display: flex; gap: 4px; }

    .empty-webhooks {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px;
        color: var(--qm-text-muted);
    }

    .empty-webhooks .rzi { font-size: 48px; margin-bottom: 12px; }
</style>

@code {
    private List<IntegrationInfo> integrations = new();
    private List<WebhookInfo> webhooks = new();

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.SettingsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        // SMS Gateway / Email Service reflect the organization's real NotificationSettings
        // (see /admin/notification-settings) rather than a hardcoded "Connected" badge.
        var (smsEnabled, emailEnabled) = await LoadNotificationChannelState();

        integrations = new List<IntegrationInfo>
        {
            new() { Name = "SMS Gateway", Description = "Send SMS notifications to customers when their token is called", Icon = "chat-dots", Color = "#10b981", IsConnected = smsEnabled, IsBuilt = true, ConfigureUrl = "/admin/notification-settings", Features = new() { "Token Notifications", "Appointment Reminders", "Custom Templates" } },
            new() { Name = "Email Service", Description = "Send email notifications and reports to customers and staff", Icon = "envelope", Color = "#8c2f52", IsConnected = emailEnabled, IsBuilt = true, ConfigureUrl = "/admin/notification-settings", Features = new() { "Token Updates", "Daily Reports", "Custom Branding" } },
            new() { Name = "Display Signage", Description = "Q-Mgr's built-in digital signage module for queue displays", Icon = "tv", Color = "#f59e0b", IsConnected = true, IsBuilt = true, ConfigureUrl = "/content/playlists", Features = new() { "Real-time Updates", "Multi-screen Support", "Custom Layouts" } },
            new() { Name = "WhatsApp Business", Description = "Send WhatsApp messages for token updates and notifications", Icon = "whatsapp", Color = "#25D366", IsConnected = false, IsBuilt = false, Features = new() { "Rich Media Messages", "Interactive Buttons", "Quick Replies" } },
            new() { Name = "Hospital Information System", Description = "Integrate with HIS for patient queue management", Icon = "hospital", Color = "#ef4444", IsConnected = false, IsBuilt = false, Features = new() { "Patient Lookup", "Appointment Sync", "Department Routing" } },
            new() { Name = "Banking Core System", Description = "Connect to core banking for customer identification", Icon = "bank", Color = "#47393f", IsConnected = false, IsBuilt = false, Features = new() { "Customer Lookup", "Account Verification", "Service Routing" } }
        };

        // No real webhook subscriptions exist yet — an empty list (not fabricated sample rows) is the honest state.
        webhooks = new List<WebhookInfo>();
    }

    private async Task<(bool SmsEnabled, bool EmailEnabled)> LoadNotificationChannelState()
    {
        try
        {
            var user = await AuthService.GetCurrentUserAsync();
            if (user?.OrganizationId is not Guid organizationId || organizationId == Guid.Empty)
            {
                // No fallback to a specific tenant's ID — an unresolved org means "don't know",
                // not "assume the demo tenant". Report both channels as disabled rather than
                // silently reading/showing another tenant's notification-channel state.
                return (false, false);
            }

            var response = await Http.GetAsync($"api/v1/notifications/settings/{organizationId}");
            if (!response.IsSuccessStatusCode) return (false, false);

            var settings = await response.Content.ReadFromJsonAsync<NotificationChannelState>(JsonOptions);
            return settings == null ? (false, false) : (settings.SmsEnabled, settings.EmailEnabled);
        }
        catch
        {
            // Settings not configured yet or unreachable — honestly report both channels as not connected.
            return (false, false);
        }
    }

    private void ConnectIntegration(IntegrationInfo integration)
    {
        if (!integration.IsBuilt)
        {
            NotificationService.Notify(ToastSeverity.Info, "Not Yet Available",
                $"{integration.Name} integration hasn't been built yet — this card reflects the product roadmap, not a working connection.");
            return;
        }

        Navigation.NavigateTo(integration.ConfigureUrl ?? "/admin/notification-settings");
    }

    private void DisconnectIntegration(IntegrationInfo integration)
    {
        NotificationService.Notify(ToastSeverity.Info, "Manage from Settings",
            $"Disable {integration.Name} from its settings page rather than here, so the change is actually saved.");
        Navigation.NavigateTo(integration.ConfigureUrl ?? "/admin/notification-settings");
    }

    private void ConfigureIntegration(IntegrationInfo integration)
    {
        Navigation.NavigateTo(integration.ConfigureUrl ?? "/admin/notification-settings");
    }

    private void AddWebhook()
    {
        NotificationService.Notify(ToastSeverity.Info, "Not Yet Available", "Webhook subscriptions haven't been built yet.");
    }

    private class NotificationChannelState
    {
        public bool SmsEnabled { get; set; }
        public bool EmailEnabled { get; set; }
    }

    private class IntegrationInfo
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public bool IsConnected { get; set; }
        public bool IsBuilt { get; set; }
        public string? ConfigureUrl { get; set; }
        public List<string> Features { get; set; } = new();
    }

    private class WebhookInfo
    {
        public string Url { get; set; } = "";
        public List<string> Events { get; set; } = new();
        public bool IsActive { get; set; }
    }
}
