@using System.Text.Json
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared
@inject HttpClient Http
@inject JsonSerializerOptions JsonOptions
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IPermissionService PermissionService
@inject NavigationManager Navigation

@if (!Embedded)
{
    <QPageTitle Text="Counters Setup" />
}

<QPageActions Embedded="@Embedded">
    <Title>
        <h1><QIcon Name="door-open-fill" /> Counters Setup</h1>
        <p class="page-subtitle">Manage service counters for your branch</p>
    </Title>
    <Actions>
        @if (canCreate)
        {
            <QButton Text="Add counter" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" />
        }
    </Actions>
</QPageActions>

@if (isLoading)
{
    <div class="loading-container"><QSpinner Size="lg" /><span>Loading counters...</span></div>
}
else if (!counters.Any())
{
    <QEmptyState Icon="door-open" Title="No counters yet" Text="A counter is a place staff serve customers from.">
        <Action>
            @if (canCreate) { <QButton Text="Add counter" Icon="plus-lg" Variant="primary" OnClick="@ShowAddDialog" /> }
        </Action>
    </QEmptyState>
}
else
{
    <QCard NoPadding="true">
        <div class="table-wrap">
            <table class="data-table q-stack">
                <thead><tr><th class="num">No.</th><th>Counter</th><th>Services</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var counter in counters)
                    {
                        <tr class="@(counter.IsActive ? "" : "row-muted")">
                            <td class="num"><strong>@counter.CounterNumber</strong></td>
                            <td>@counter.DisplayName</td>
                            <td>
                                @if (counter.ServiceTypes?.Any() == true)
                                {
                                    <span class="cell-tags">
                                        @foreach (var st in counter.ServiceTypes.Take(3))
                                        {
                                            <QChip Text="@st.Name" Color="@(st.Color ?? "var(--qm-primary)")" Size="sm" />
                                        }
                                        @if (counter.ServiceTypes.Count > 3)
                                        {
                                            <QChip Text="@($"+{counter.ServiceTypes.Count - 3}")" Variant="muted" Size="sm" Title="@string.Join(", ", counter.ServiceTypes.Skip(3).Select(s => s.Name))" />
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span class="cell-sub">None assigned</span>
                                }
                            </td>
                            <td>
                                @if (!counter.IsActive)
                                {
                                    <QChip Text="Disabled" Variant="muted" Size="sm" />
                                }
                                else
                                {
                                    <QChip Text="@counter.Status.ToString()" Variant="@CounterStatusVariant(counter.Status.ToString())" Size="sm" />
                                }
                            </td>
                            <td class="row-actions">
                                @if (canEdit)
                                {
                                    <QButton Icon="pencil" Variant="ghost" Size="sm" OnClick="@(() => ShowEditDialog(counter))" Title="Edit" />
                                    <QButton Icon="@(counter.IsActive ? "toggle-on" : "toggle-off")" Variant="ghost" Size="sm"
                                             OnClick="@(() => ToggleCounter(counter))" Title="@(counter.IsActive ? "Disable" : "Enable")" />
                                }
                                @if (canDelete)
                                {
                                    <QButton Icon="trash" Variant="ghost" Size="sm" OnClick="@(() => DeleteCounter(counter))" Title="Delete" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </QCard>
}

<!-- Add/Edit Dialog -->
<QModal @bind-Visible="showDialog" Title="@(editingCounter == null ? "Add Counter" : "Edit Counter")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.CounterNumber" Label="Counter Number *" Placeholder="e.g., 1, A1, T01" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@formData.DisplayName" Label="Display Name" Placeholder="e.g., Counter 1, Teller A" />
        </div>
        <div class="form-group">
            <QMultiSelect TValue="Guid" TItem="ServiceTypeDto"
                          @bind-SelectedValues="@formData.ServiceTypeIds"
                          Items="@availableServiceTypes"
                          ValueSelector="@(s => s.Id)"
                          TextSelector="@(s => s.Name)"
                          Label="Assigned Services"
                          Placeholder="Select services this counter handles" />
        </div>
        <div class="form-group">
            <QCheckbox @bind-Value="@formData.IsEnabled" Label="Counter is active" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="ghost" OnClick="@CloseDialog" />
        <QButton Text="@(editingCounter == null ? "Add Counter" : "Save Changes")" Icon="@(editingCounter == null ? "plus-lg" : "check-lg")" Variant="primary" OnClick="@SaveCounter" />
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Counter"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

<style>.page-header h1 {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 8px;
        color: var(--qm-text-primary);
    }

    .page-header h1 .rzi {
        color: var(--qm-primary);
    }
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--qm-border);
    }

    .card-header h3 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: var(--qm-text-lg);
        color: var(--qm-text-primary);
    }

    /* Dialog */
    .dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(4px);
    }

    .dialog-content {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
        box-shadow: var(--qm-shadow-lg);
        width: 90%;
        max-width: 480px;
    }

    .dialog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--qm-border);
    }

    .dialog-header h3 {
        margin: 0;
        color: var(--qm-text-primary);
    }

    .dialog-body {
        padding: 24px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: var(--qm-text-primary);
    }

    .dialog-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 16px 24px;
        border-top: 1px solid var(--qm-border);
    }

    /* Ensure Radzen dropdown popup appears above modal */
    :deep(.rz-popup) {
        z-index: 10000 !important;
    }
</style>

@code {
    /// <summary>A counter's live state, in the shared chip colours: open and serving read as good,
    /// on a break as a pause, closed or offline as muted.</summary>
    private static string CounterStatusVariant(string status) => status.ToLowerInvariant() switch
    {
        "active" or "open" or "available" => "success",
        "serving" or "busy" => "primary",
        "break" or "paused" or "onbreak" => "warning",
        _ => "muted"
    };

    /// <summary>True when the Branches hub is hosting this page inside its own tab strip: the host
    /// then owns the page title and the tab strip. There is no route to this component any other
    /// way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private List<CounterDto> counters = new();
    private List<ServiceTypeDto> availableServiceTypes = new();
    private bool isLoading = true;
    private bool showDialog = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private CounterDto? editingCounter;
    private CounterFormData formData = new();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private CounterDto? counterToDelete;

    protected override async Task OnInitializedAsync()
    {
        // Permission check and data loading moved to OnAfterRenderAsync
        // to ensure tokens are loaded from localStorage first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check permission (tokens are now loaded from localStorage)
            if (!await PermissionService.HasPermissionAsync(Permissions.CountersView))
            {
                Navigation.NavigateTo("/unauthorized", forceLoad: true);
                return;
            }

            canCreate = await PermissionService.HasPermissionAsync(Permissions.CountersCreate);
            canEdit = await PermissionService.HasPermissionAsync(Permissions.CountersEdit);
            canDelete = await PermissionService.HasPermissionAsync(Permissions.CountersDelete);

            await BranchState.InitializeAsync();
            TrackBranch();


            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            await BranchState.InitializeAsync();
            var branchId = BranchState.CurrentBranchId;

            if (branchId == Guid.Empty)
            {
                NotificationService.Notify(ToastSeverity.Warning, "No Branch Selected", "Please select a branch from the header first.");
                isLoading = false;
                return;
            }

            var countersTask = Http.GetFromJsonAsync<List<CounterDto>>($"api/v1/branches/{branchId}/counters?includeInactive=true", JsonOptions);
            var servicesTask = Http.GetFromJsonAsync<List<ServiceTypeDto>>($"api/v1/branches/{branchId}/service-types?includeInactive=true", JsonOptions);

            await Task.WhenAll(countersTask, servicesTask);

            counters = await countersTask ?? new();
            availableServiceTypes = await servicesTask ?? new();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", $"Failed to load counters: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddDialog()
    {
        editingCounter = null;
        var nextNumber = counters.Any()
            ? (int.TryParse(counters.Max(c => c.CounterNumber), out var max) ? (max + 1).ToString() : (counters.Count + 1).ToString())
            : "1";
        formData = new CounterFormData
        {
            CounterNumber = nextNumber,
            IsEnabled = true
        };
        showDialog = true;
    }

    private void ShowEditDialog(CounterDto counter)
    {
        editingCounter = counter;
        formData = new CounterFormData
        {
            CounterNumber = counter.CounterNumber,
            DisplayName = counter.DisplayName,
            ServiceTypeIds = counter.ServiceTypes?.Select(s => s.Id) ?? Enumerable.Empty<Guid>(),
            IsEnabled = counter.Status != CounterStatus.Inactive
        };
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingCounter = null;
    }

    private async Task SaveCounter()
    {
        try
        {
            var branchId = BranchState.CurrentBranchId;
            var endpoint = editingCounter == null
                ? $"api/v1/branches/{branchId}/counters"
                : $"api/v1/branches/{branchId}/counters/{editingCounter.Id}";

            var request = new
            {
                CounterNumber = formData.CounterNumber,
                DisplayName = formData.DisplayName ?? $"Counter {formData.CounterNumber}",
                ServiceTypeIds = formData.ServiceTypeIds,
                IsEnabled = formData.IsEnabled
            };

            HttpResponseMessage response;
            if (editingCounter == null)
            {
                response = await Http.PostAsJsonAsync(endpoint, request, JsonOptions);
            }
            else
            {
                response = await Http.PutAsJsonAsync(endpoint, request, JsonOptions);
            }

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    editingCounter == null ? "Counter added" : "Counter updated");
                CloseDialog();
                await LoadData();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to save counter");
            }
        }
        catch
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to save counter");
        }
    }

    private async Task ToggleCounter(CounterDto counter)
    {
        try
        {
            var branchId = BranchState.CurrentBranchId;
            var response = await Http.PatchAsync($"api/v1/branches/{branchId}/counters/{counter.Id}/toggle", null);

            if (response.IsSuccessStatusCode)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success",
                    counter.IsActive ? "Counter disabled" : "Counter enabled");
                await LoadData();
            }
            else
            {
                // Same silent-4xx gap as the delete below: the server refuses to disable a counter
                // that still has a customer at it, and that reason has to be shown.
                NotificationService.Notify(ToastSeverity.Error,
                    counter.IsActive ? "Could not disable counter" : "Could not enable counter",
                    await ApiErrorService.GetErrorMessageAsync(response, "The counter could not be updated."));
            }
        }
        catch
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to update counter");
        }
    }

    private void DeleteCounter(CounterDto counter)
    {
        counterToDelete = counter;
        deleteConfirmMessage = $"Are you sure you want to delete Counter {counter.CounterNumber}?";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && counterToDelete != null)
        {
            try
            {
                var branchId = BranchState.CurrentBranchId;
                var response = await Http.DeleteAsync($"api/v1/branches/{branchId}/counters/{counterToDelete.Id}");

                if (response.IsSuccessStatusCode)
                {
                    NotificationService.Notify(ToastSeverity.Success, "Success", "Counter deleted");
                    await LoadData();
                }
                else
                {
                    // A non-success status used to do nothing at all — no toast, no message —
                    // because DeleteAsync does not throw on a 4xx and only the catch reported
                    // anything. The server refuses this delete while a customer is still at the
                    // counter, and that reason has to reach the person who clicked.
                    NotificationService.Notify(ToastSeverity.Error, "Could not delete counter",
                        await ApiErrorService.GetErrorMessageAsync(response, "The counter could not be deleted."));
                }
            }
            catch
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to delete counter");
            }
        }

        counterToDelete = null;
    }

    private class CounterFormData
    {
        public string CounterNumber { get; set; } = "1";
        public string? DisplayName { get; set; }
        public IEnumerable<Guid> ServiceTypeIds { get; set; } = Enumerable.Empty<Guid>();
        public bool IsEnabled { get; set; } = true;
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        await LoadData();
    }
}
