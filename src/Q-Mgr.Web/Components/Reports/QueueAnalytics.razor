@page "/reports/queue"
@using QMgr.Application.DTOs
@inject IReportsApiService ReportsApi
@inject IQueueApiService QueueApi
@inject IPermissionService PermissionService
@inject IBranchStateService BranchState
@inject IToastService NotificationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Queue Analytics - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Queue Analytics</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Reports", "/reports"), new("Queue Analytics") })" />
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner @(isForbidden ? "warn" : "")">
        <QIcon Name="exclamation-triangle-fill" />
        <span>@errorMessage</span>
        @if (isForbidden)
        {
            <QButton Text="View plans" Icon="box-seam" Variant="secondary" Size="sm" OnClick="@(() => Navigation.NavigateTo("/billing/modules"))" />
        }
        else
        {
            <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@LoadData" />
        }
    </div>
}

<div class="analytics-page">
    <!-- Filters — the Date Range drives the from/to of every figure below AND the CSV export -->
    <QCard Class="filter-card">
        <div class="filter-row">
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" Value="@selectedPeriod" ValueChanged="@OnPeriodChanged"
                    Items="@periods" Label="Date Range" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QSelect TValue="Guid?" TItem="ServiceTypeReportRowDto" Value="@selectedServiceType" ValueChanged="@OnServiceTypeChanged"
                    Items="@serviceRows" TextSelector="@(s => s.Name)" ValueSelector="@(s => (Guid?)s.ServiceTypeId)"
                    Label="Service Type" Placeholder="All Services" AllowClear="true" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
                <QButton Text="Export" Icon="cloud-download-fill" Variant="secondary" OnClick="@ExportCsv" Loading="@isExporting" Disabled="@isExporting" />
            </div>
        </div>
        <p class="range-caption">Showing @RangeCaption@(SelectedServiceName is null ? "" : $" · {SelectedServiceName} only")</p>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading analytics data...</span>
        </div>
    }
    else if (overview is null)
    {
        <QCard Class="chart-card">
            <p class="chart-empty">No analytics to show. Pick a branch and a date range, then refresh.</p>
        </QCard>
    }
    else
    {
        <!-- Summary Stats -->
        <div class="stats-row">
            <div class="stats-card">
                <div class="stats-icon primary"><QIcon Name="people-fill" /></div>
                <div class="stats-info">
                    <span class="stats-number">@Issued</span>
                    <span class="stats-label">Tokens Issued</span>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon success"><QIcon Name="check-circle-fill" /></div>
                <div class="stats-info">
                    <span class="stats-number">@Served</span>
                    <span class="stats-label">Served</span>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon warning"><QIcon Name="clock-fill" /></div>
                <div class="stats-info">
                    <span class="stats-number">@FormatMinutes(AvgWait)</span>
                    <span class="stats-label">Avg Wait</span>
                    <span class="stats-note">@(Served == 0 ? "No tokens were served in this range" : $"across {Served} served tokens")</span>
                </div>
            </div>
            <div class="stats-card">
                <div class="stats-icon info"><QIcon Name="graph-up-arrow" /></div>
                <div class="stats-info">
                    <span class="stats-number">@PeakHourLabel</span>
                    <span class="stats-label">Peak Hour (UTC)</span>
                    <span class="stats-note">All service types</span>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="charts-row">
            <QCard Class="chart-card">
                <h4>Tokens by Hour</h4>
                @if (overview.ByHour.Any(h => h.Count > 0))
                {
                    <RadzenChart Style="height: 300px;">
                        <RadzenColumnSeries Data="@hourlyData" CategoryProperty="Hour" ValueProperty="Count" Title="Tokens" />
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis>
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                    <p class="chart-note">Hour of day in UTC, counted by the time each token was issued. Covers all service types.</p>
                }
                else
                {
                    <p class="chart-empty">No tokens were issued in this range.</p>
                }
            </QCard>

            <QCard Class="chart-card">
                <h4>By Service Type</h4>
                @if (pieData.Any())
                {
                    <RadzenChart Style="height: 300px;">
                        <RadzenPieSeries Data="@pieData" Title="Service" CategoryProperty="Name" ValueProperty="Count" />
                    </RadzenChart>
                }
                else
                {
                    <p class="chart-empty">No tokens were issued in this range, so there is nothing to break down by service type.</p>
                }
            </QCard>
        </div>

        <!-- Detailed Table -->
        <QCard Class="table-card">
            <h4>Service Type Breakdown</h4>
            @if (visibleServiceRows.Any())
            {
                <RadzenDataGrid Data="@visibleServiceRows" TItem="ServiceTypeReportRowDto" AllowSorting="true" AllowPaging="true" PageSize="10">
                    <Columns>
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="Name" Title="Service Type" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="Issued" Title="Issued" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="Served" Title="Served" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="NoShow" Title="No-Show" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="Cancelled" Title="Cancelled" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="StillOpen" Title="Still Open" TextAlign="TextAlign.Center" />
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="AvgWaitMinutes" Title="Avg Wait (min)" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                <span class="@GetWaitClass(item.AvgWaitMinutes)">@FormatNumber(item.AvgWaitMinutes)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ServiceTypeReportRowDto" Property="AvgServiceMinutes" Title="Avg Service (min)" TextAlign="TextAlign.Center">
                            <Template Context="item">
                                @FormatNumber(item.AvgServiceMinutes)
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <p class="chart-note">A dash means no token of that type was served in this range — there is nothing to average, which is not the same as an average of zero.</p>
            }
            else
            {
                <p class="chart-empty">No service types are configured for this branch.</p>
            }
        </QCard>
    }
</div>

<style>
    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: color-mix(in srgb, var(--qm-danger) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--qm-danger) 35%, transparent);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 20px;
        color: var(--qm-danger);
    }

    .error-banner.warn {
        background: color-mix(in srgb, var(--qm-warning) 12%, transparent);
        border-color: color-mix(in srgb, var(--qm-warning) 35%, transparent);
        color: var(--qm-warning);
    }

    .error-banner .rzi {
        font-size: 24px;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        color: var(--qm-text-secondary);
    }

    .analytics-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .filter-card {
        padding: 16px 24px;
    }

    .filter-row {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-item:last-child {
        flex-direction: row;
        gap: 10px;
    }

    .range-caption {
        margin: 14px 0 0 0;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
    }

    .stats-card {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        box-shadow: var(--qm-shadow-sm);
    }

    .stats-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: var(--qm-text-on-primary);
        flex-shrink: 0;
    }

    .stats-icon.primary { background: var(--qm-primary); }
    .stats-icon.success { background: var(--qm-success); }
    .stats-icon.warning { background: var(--qm-warning); }
    .stats-icon.info { background: var(--qm-info); }

    .stats-info {
        display: flex;
        flex-direction: column;
    }

    .stats-number {
        font-size: 24px;
        font-weight: 700;
    }

    .stats-label {
        font-size: 13px;
        color: var(--qm-text-secondary);
    }

    .stats-note {
        font-size: 11px;
        color: var(--qm-text-muted);
        margin-top: 2px;
    }

    .charts-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
    }

    .chart-card, .table-card {
        padding: 20px;
    }

    .chart-card h4, .table-card h4 {
        margin: 0 0 16px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .chart-empty {
        font-size: 13px;
        color: var(--qm-text-muted);
        margin: 0;
    }

    .chart-note {
        font-size: 11px;
        color: var(--qm-text-muted);
        margin: 12px 0 0 0;
    }

    .wait-good { color: var(--qm-success); font-weight: 600; }
    .wait-medium { color: var(--qm-warning); font-weight: 600; }
    .wait-bad { color: var(--qm-danger); font-weight: 600; }
    .wait-none { color: var(--qm-text-muted); }
</style>

@code {
    // Both payloads are the JSON siblings of the /overview and /services CSV exports, over the
    // same range the Export button sends — nothing on this page is computed anywhere else.
    private QueueOverviewReportDto? overview;
    private List<ServiceTypeReportRowDto> serviceRows = new();

    private string selectedPeriod = "today";
    private Guid? selectedServiceType;
    private bool isLoading = true;
    private bool isExporting;
    private bool isForbidden;
    private string? errorMessage;

    private const string Dash = "—";

    private record HourPoint(string Hour, int Count);
    private record ServicePiePoint(string Name, int Count);

    private List<HourPoint> hourlyData = new();
    private List<ServicePiePoint> pieData = new();

    private List<string> periods = new() { "today", "yesterday", "week", "month" };

    private ServiceTypeReportRowDto? SelectedRow =>
        selectedServiceType is null ? null : serviceRows.FirstOrDefault(s => s.ServiceTypeId == selectedServiceType);

    private string? SelectedServiceName => SelectedRow?.Name;

    private List<ServiceTypeReportRowDto> visibleServiceRows
    {
        get
        {
            var row = SelectedRow;
            return row is null ? serviceRows : new List<ServiceTypeReportRowDto> { row };
        }
    }

    // When a service type is picked, the tiles narrow to that type's real figures rather than
    // continuing to show branch-wide totals under a filtered heading.
    private int Issued => SelectedRow?.Issued ?? overview?.TotalIssued ?? 0;
    private int Served => SelectedRow?.Served ?? overview?.TotalServed ?? 0;

    private double? AvgWait
    {
        get
        {
            var row = SelectedRow;
            return row is not null ? row.AvgWaitMinutes : overview?.AvgWaitMinutes;
        }
    }

    private string PeakHourLabel
    {
        get
        {
            var peak = overview?.ByHour.OrderByDescending(h => h.Count).FirstOrDefault();
            return peak is null || peak.Count == 0 ? Dash : $"{peak.Hour:00}:00";
        }
    }

    private string RangeCaption
    {
        get
        {
            var (from, to) = ResolvePeriod(selectedPeriod);
            return from == to ? from.ToString("MMM d, yyyy") : $"{from:MMM d, yyyy} – {to:MMM d, yyyy}";
        }
    }

    /// <summary>Null means nothing was served, so there is no average — an em dash, never "0".</summary>
    private static string FormatMinutes(double? minutes) => minutes.HasValue ? $"{minutes.Value:0.#} min" : Dash;
    private static string FormatNumber(double? value) => value.HasValue ? value.Value.ToString("0.#") : Dash;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ReportsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await BranchState.InitializeAsync();
        await LoadData();
    }

    private async Task OnPeriodChanged(string period)
    {
        selectedPeriod = period;
        await LoadData();
    }

    private async Task OnServiceTypeChanged(Guid? serviceTypeId)
    {
        // Purely a view filter over data already loaded for the range — no refetch needed, and
        // nothing is recomputed client-side beyond picking which server-computed row to show.
        selectedServiceType = serviceTypeId;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        isForbidden = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var branchId = BranchState.CurrentBranchId;
            if (branchId == Guid.Empty)
            {
                ResetData();
                errorMessage = "Select a branch to see its queue analytics.";
                return;
            }

            var (from, to) = ResolvePeriod(selectedPeriod);

            var overviewResult = await ReportsApi.GetOverviewAsync(branchId, from, to);
            if (!overviewResult.Success)
            {
                ResetData();
                isForbidden = overviewResult.IsForbidden;
                errorMessage = overviewResult.DisplayMessage;
                return;
            }

            var servicesResult = await ReportsApi.GetServiceTypesAsync(branchId, from, to);
            if (!servicesResult.Success)
            {
                ResetData();
                isForbidden = servicesResult.IsForbidden;
                errorMessage = servicesResult.DisplayMessage;
                return;
            }

            overview = overviewResult.Data;
            serviceRows = servicesResult.Data!.ServiceTypes;

            hourlyData = overview!.ByHour
                .Select(h => new HourPoint($"{h.Hour:00}:00", h.Count))
                .ToList();

            pieData = serviceRows
                .Where(s => s.Issued > 0)
                .OrderByDescending(s => s.Issued)
                .Select(s => new ServicePiePoint(s.Name, s.Issued))
                .ToList();

            // A previously-selected service type may not exist in the new range's rows.
            if (selectedServiceType is not null && serviceRows.All(s => s.ServiceTypeId != selectedServiceType))
                selectedServiceType = null;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetData()
    {
        overview = null;
        serviceRows = new();
        hourlyData = new();
        pieData = new();
    }

    /// <summary>
    /// Exports the service-type CSV for exactly the range on screen — the same from/to that
    /// produced every figure above, so the file and the page always agree.
    /// </summary>
    private async Task ExportCsv()
    {
        var branchId = BranchState.CurrentBranchId;
        if (branchId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Warning, "No branch selected", "Select a branch before exporting.", 4000);
            return;
        }

        var (from, to) = ResolvePeriod(selectedPeriod);
        isExporting = true;
        try
        {
            var result = await QueueApi.ExportReportCsvAsync(ReportExportKind.Services, branchId, from, to);
            if (!result.Success)
            {
                if (result.IsForbidden)
                    NotificationService.Notify(ToastSeverity.Warning, "Export not available",
                        result.ErrorMessage ?? "You don't have permission to export reports, or your plan doesn't include exports.", 6000);
                else
                    NotificationService.Notify(ToastSeverity.Error, "Export failed",
                        result.ErrorMessage ?? "Couldn't export queue analytics. Please try again.", 5000);
                return;
            }

            var dataUrl = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(result.Csv!);
            await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, $"service-types-{from:yyyyMMdd}-{to:yyyyMMdd}.csv");
        }
        finally
        {
            isExporting = false;
        }
    }

    private static (DateOnly From, DateOnly To) ResolvePeriod(string period)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return period switch
        {
            "yesterday" => (today.AddDays(-1), today.AddDays(-1)),
            "week" => (today.AddDays(-6), today),
            "month" => (today.AddDays(-29), today),
            _ => (today, today)
        };
    }

    private static string GetWaitClass(double? minutes)
    {
        if (!minutes.HasValue) return "wait-none";
        return minutes.Value switch
        {
            <= 5 => "wait-good",
            <= 15 => "wait-medium",
            _ => "wait-bad"
        };
    }
}
