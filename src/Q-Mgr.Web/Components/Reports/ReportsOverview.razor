@page "/reports"
@using QMgr.Application.DTOs
@inject IQueueApiService QueueApi
@inject IReportsApiService ReportsApi
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IToastService NotificationService
@inherits BranchAwareComponentBase
@inject IJSRuntime JS
@using QMgr.Web.Services

<PageTitle>Reports &amp; Analytics - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Reports &amp; Analytics</h1>
    <div class="breadcrumb">
        <span>Overview of queue performance and analytics</span>
    </div>
</div>

<div class="reports-overview">
    <!-- Date Range — drives every figure on this page AND the CSV export below -->
    <QCard Class="filter-card">
        <div class="filter-row">
            @* One shared control, so "Last 30 days" means here exactly what it means on every
               other report — this page used to offer three quick ranges of its own while the
               visitor report offered seven different ones. *@
            <div class="filter-item filter-item--range">
                <QDateRangePicker Range="@range" RangeChanged="@OnRangeChanged" Disabled="@isLoading" ShowCaption="false" />
            </div>
            <div class="filter-item">
                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
            </div>
        </div>
        <p class="range-caption">Showing @range.Caption</p>
    </QCard>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="error-banner @(isForbidden ? "warn" : "")">
            <QIcon Name="exclamation-triangle-fill" />
            <span>@loadError</span>
            @if (isForbidden)
            {
                <QButton Text="View plans" Icon="box-seam" Variant="secondary" Size="sm" OnClick="@(() => Navigation.NavigateTo(BillingLinks.Modules))" />
            }
            else
            {
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@LoadData" />
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading report data...</span>
        </div>
    }
    else
    {
        <!-- Quick Stats Summary — every figure below is measured over the selected range -->
        <QStatRow>
            <QStatTile Icon="check-circle-fill" Variant="primary" Value="@(overview?.TotalServed.ToString() ?? Dash)" Label="Tokens served" Sub="@ServedSubLabel" />
            <QStatTile Icon="clock-fill" Variant="success" Value="@FormatMinutes(overview?.AvgWaitMinutes)" Label="Average wait" Sub="@AverageSubLabel" />
            <QStatTile Icon="stopwatch-fill" Variant="warning" Value="@FormatMinutes(overview?.AvgServiceMinutes)" Label="Average service" Sub="@AverageSubLabel" />
            <QStatTile Icon="door-open-fill" Variant="info" Value="@(overview is null ? Dash : $"{overview.ActiveCounters}/{overview.TotalCounters}")" Label="Active counters" Sub="Right now, not over the range" />
        </QStatRow>

        <!-- Daily series -->
        <QCard Class="chart-card">
            <h4>Tokens per Day</h4>
            @if (dailyChartData.Any(d => d.Issued > 0 || d.Served > 0))
            {
                <RadzenChart Style="height: 280px;">
                    <RadzenLineSeries Data="@dailyChartData" CategoryProperty="Day" ValueProperty="Issued" Title="Issued" Smooth="true" />
                    <RadzenLineSeries Data="@dailyChartData" CategoryProperty="Day" ValueProperty="Served" Title="Served" Smooth="true" />
                    <RadzenCategoryAxis Padding="20" FormatString="@("{0:" + QDateFormat.Compact + "}")" />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                </RadzenChart>
            }
            else
            {
                <p class="chart-empty">No tokens were issued in this range.</p>
            }
        </QCard>
    }

    <!-- Report Cards -->
    <div class="report-cards">
        @* Whole routes, not NavigateToReport("queue"). Building a route by interpolating a
           fragment makes it invisible to any sweep for who links where — which is exactly how
           this card's sibling went on pointing at /reports/feedback after that route was
           retired, while every literal caller was found and fixed. *@
        <QCard Class="report-card" @onclick="@(() => Navigation.NavigateTo("/reports/queue"))">
            <div class="report-card-icon queue">
                <QIcon Name="bar-chart-fill" />
            </div>
            <h3>Queue Analytics</h3>
            <p>Analyze queue patterns, peak hours, and service distribution</p>
            <span class="report-link">View Report <QIcon Name="arrow-right" /></span>
        </QCard>

        <QCard Class="report-card" @onclick="@(() => Navigation.NavigateTo("/reports/counters"))">
            <div class="report-card-icon counters">
                <QIcon Name="speedometer2" />
            </div>
            <h3>Counter Performance</h3>
            <p>Monitor counter efficiency, staff performance, and utilization</p>
            <span class="report-link">View Report <QIcon Name="arrow-right" /></span>
        </QCard>

        @* /reports/feedback was retired on 2026-09-19: the feedback reports are a tab of the
           Feedback hub now. *@
        <QCard Class="report-card" @onclick="@(() => Navigation.NavigateTo("/admin/feedback?tab=reports"))">
            <div class="report-card-icon feedback">
                <QIcon Name="chat-dots-fill" />
            </div>
            <h3>Customer Feedback</h3>
            <p>Review customer satisfaction scores and feedback trends</p>
            <span class="report-link">View Report <QIcon Name="arrow-right" /></span>
        </QCard>
    </div>

    <!-- Export -->
    <QCard Class="filter-card">
        <h4>Download This Report</h4>
        <div class="filter-row">
            <div class="filter-item">
                <QSelect TValue="string" TItem="ReportTypeOption" @bind-Value="@selectedReportType" Items="@reportTypes"
                    TextSelector="@(r => r.Text)" ValueSelector="@(r => r.Value)" Label="Report Type" />
            </div>
            <div class="filter-item filter-actions">
                <QButton Text="Export CSV" Icon="file-earmark-text-fill" Variant="primary" OnClick="@GenerateReport" Loading="@isExporting" Disabled="@isExporting" />
                <QButton Text="Print / Save as PDF" Icon="printer-fill" Variant="secondary" OnClick="@PrintSummary" />
            </div>
        </div>
        <p class="range-caption">The download covers exactly the range shown above — @range.Caption.</p>
    </QCard>
</div>

<style>
    .reports-overview {
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }










    .report-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .report-card {
        cursor: pointer;
        transition: var(--qm-transition-fast);
        padding: 24px;
    }

    .report-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--qm-shadow-md);
    }

    .report-card-icon {
        width: 56px;
        height: 56px;
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--qm-text-stat);
        margin-bottom: 16px;
        color: var(--qm-text-on-primary);
    }

    .report-card-icon.queue { background: var(--qm-primary); }
    .report-card-icon.counters { background: var(--qm-secondary); }
    .report-card-icon.feedback { background: var(--qm-accent-pink); }

    .report-card h3 {
        margin: 0 0 8px 0;
        font-size: var(--qm-text-lg);
        font-weight: 600;
    }

    .report-card p {
        margin: 0 0 16px 0;
        color: var(--qm-text-secondary);
        font-size: var(--qm-text-base);
    }

    .report-link {
        color: var(--qm-primary);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .filter-card {
        padding: 24px;
    }

    .filter-card h4, .chart-card h4 {
        margin: 0 0 20px 0;
        font-size: var(--qm-text-md);
        font-weight: 600;
    }

    .chart-card {
        padding: 20px;
    }

    .chart-empty {
        font-size: var(--qm-text-base);
        color: var(--qm-text-muted);
        margin: 0;
    }
    .filter-item {
        display: flex;
        flex-direction: column;
        gap: var(--q-row-gap, 8px);
    }

    .filter-actions, .quick-ranges {
        display: flex;
        gap: 10px;
        flex-direction: row;
    }

    .range-caption {
        margin: 14px 0 0 0;
        font-size: var(--qm-text-sm);
        color: var(--qm-text-muted);
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        color: var(--qm-text-secondary);
    }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: color-mix(in srgb, var(--qm-danger) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--qm-danger) 35%, transparent);
        border-radius: var(--qm-radius-lg);
        color: var(--qm-danger);
    }

    .error-banner.warn {
        background: color-mix(in srgb, var(--qm-warning) 12%, transparent);
        border-color: color-mix(in srgb, var(--qm-warning) 35%, transparent);
        color: var(--qm-warning);
    }

    .error-banner .rzi {
        font-size: var(--qm-text-stat);
    }
</style>

@code {
    // Every number on this page comes from this one payload, which is the JSON sibling of the
    // CSV the Export button downloads for the same range — screen and download cannot disagree.
    private QueueOverviewReportDto? overview;
    private bool isLoading = true;
    private bool isForbidden;
    private string? loadError;

    private DateRange range = DateRange.LastDays(7);

    // Kept as the bridge to the existing ResolveRange()/load code below rather than rewriting this
    // page's whole data path for a control swap.
    private DateTime? fromDate = DateTime.Today.AddDays(-6);
    private DateTime? toDate = DateTime.Today;
    private string selectedReportType = "summary";
    private bool isExporting;
    private Guid currentBranchId;
    private string currentBranchName = "";

    private const string Dash = "—";

    private record DayChartPoint(DateTime Day, int Issued, int Served);
    private List<DayChartPoint> dailyChartData = new();

    private List<ReportTypeOption> reportTypes = new()
    {
        new ReportTypeOption { Text = "Daily Queue Summary", Value = "summary" },
        new ReportTypeOption { Text = "Counter Performance", Value = "counters" },
        new ReportTypeOption { Text = "Service Type Analysis", Value = "services" }
    };

    private class ReportTypeOption
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private async Task OnRangeChanged(DateRange next)
    {
        range = next;
        fromDate = next.From.ToDateTime(TimeOnly.MinValue);
        toDate = next.To.ToDateTime(TimeOnly.MinValue);
        await LoadData();
    }

    private string ServedSubLabel => overview is null
        ? "No data loaded"
        : overview.TotalIssued == 0
            ? "No tokens were issued in this range"
            : $"of {overview.TotalIssued} issued";

    private string AverageSubLabel => overview is null
        ? "No data loaded"
        : overview.TotalServed == 0
            ? "No tokens were served in this range"
            : $"across {overview.TotalServed} served tokens";

    /// <summary>
    /// A null average means nothing was served, so there is nothing to average — it is rendered
    /// as an em dash, never as "0 min", which would read as a measurement rather than an absence.
    /// </summary>
    private static string FormatMinutes(double? minutes) =>
        minutes.HasValue ? $"{minutes.Value:0.#} min" : Dash;

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ReportsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await BranchState.InitializeAsync();
        currentBranchId = BranchState.CurrentBranchId;
        currentBranchName = BranchState.CurrentBranchName ?? "";
        await LoadData();
    }




    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;
        isForbidden = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (currentBranchId == Guid.Empty)
            {
                overview = null;
                dailyChartData = new();
                loadError = "Select a branch to see its report figures.";
                return;
            }

            var (from, to) = ResolveRange();
            var result = await ReportsApi.GetOverviewAsync(currentBranchId, from, to);

            if (!result.Success)
            {
                overview = null;
                dailyChartData = new();
                isForbidden = result.IsForbidden;
                loadError = result.DisplayMessage;
                return;
            }

            overview = result.Data;
            dailyChartData = overview!.ByDay
                .Select(d => new DayChartPoint(d.Day.ToDateTime(TimeOnly.MinValue), d.Issued, d.Served))
                .ToList();
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    /// <summary>
    /// Downloads the selected report as CSV from ReportsController — same data: URL +
    /// downloadDataUrl pattern VisitorReport uses, and the same from/to the figures above were
    /// computed for, so the download can never cover a different period than the screen.
    /// </summary>
    private async Task GenerateReport()
    {
        if (currentBranchId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Warning, "No branch selected", "Select a branch before generating a report.", 4000);
            return;
        }

        var (from, to) = ResolveRange();
        var (kind, filePrefix) = selectedReportType switch
        {
            "counters" => (ReportExportKind.Counters, "counter-performance"),
            "services" => (ReportExportKind.Services, "service-types"),
            _ => (ReportExportKind.Overview, "queue-summary")
        };

        isExporting = true;
        try
        {
            var result = await QueueApi.ExportReportCsvAsync(kind, currentBranchId, from, to);
            if (!result.Success)
            {
                NotifyExportFailure(result);
                return;
            }

            var dataUrl = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(result.Csv!);
            await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, $"{filePrefix}-{from:yyyyMMdd}-{to:yyyyMMdd}.csv");
            NotificationService.Notify(ToastSeverity.Success, "Report ready", "Your CSV download has started.", 3000);
        }
        finally
        {
            isExporting = false;
        }
    }

    /// <summary>
    /// Opens a printable page of the on-screen summary via the shared print helper (same
    /// QMgrPrint.init("browser") + autoPrint:false flow WelfareReports/StudentRoster use) —
    /// the browser's own print dialog is the "Save as PDF" path, with no server-side PDF
    /// dependency (see CLAUDE.md's no-third-party-server-deps constraint). It prints exactly
    /// what is on screen, including the em dashes where there was nothing to measure.
    /// </summary>
    private async Task PrintSummary()
    {
        var branchLabel = string.IsNullOrWhiteSpace(currentBranchName) ? "" : $" — {System.Net.WebUtility.HtmlEncode(currentBranchName)}";
        var (from, to) = ResolveRange();
        var served = overview?.TotalServed.ToString() ?? Dash;
        var issued = overview?.TotalIssued.ToString() ?? Dash;
        var noShow = overview?.TotalNoShow.ToString() ?? Dash;
        var counters = overview is null ? Dash : $"{overview.ActiveCounters} of {overview.TotalCounters}";
        var html = $$"""
            <html>
            <head>
                <title>Queue Summary{{branchLabel}}</title>
                <style>
                    body { font-family: Arial, sans-serif; margin: 24px; color: #222; }
                    h1 { font-size: var(--qm-text-lg); margin-bottom: 2px; }
                    .meta-line { color: #666; font-size: var(--qm-text-sm); margin-bottom: 20px; }
                    table { border-collapse: collapse; width: 100%; max-width: 520px; }
                    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #ddd; font-size: var(--qm-text-base); }
                    th { font-size: var(--qm-text-xs); text-transform: uppercase; color: #888; letter-spacing: .03em; }
                    td.value { font-weight: 700; font-size: var(--qm-text-md); text-align: right; }
                    .note { margin-top: 20px; color: #888; font-size: var(--qm-text-xs); }
                </style>
            </head>
            <body>
                <h1>Queue Summary{{branchLabel}}</h1>
                <div class="meta-line">Range {{QDateFormat.Range(from, to)}} · Printed {{QDateFormat.DT(DateTime.Now)}}</div>
                <table>
                    <tr><th>Metric</th><th style="text-align:right">Value</th></tr>
                    <tr><td>Tokens issued</td><td class="value">{{issued}}</td></tr>
                    <tr><td>Tokens served</td><td class="value">{{served}}</td></tr>
                    <tr><td>No-shows</td><td class="value">{{noShow}}</td></tr>
                    <tr><td>Average wait time</td><td class="value">{{FormatMinutes(overview?.AvgWaitMinutes)}}</td></tr>
                    <tr><td>Average service time</td><td class="value">{{FormatMinutes(overview?.AvgServiceMinutes)}}</td></tr>
                    <tr><td>Active counters (now)</td><td class="value">{{counters}}</td></tr>
                </table>
                <p class="note">A dash means there was nothing to measure in this range, not a value of zero. Averages cover served tokens only. Use "Export CSV" for the full day-by-day figures.</p>
            </body>
            </html>
            """;

        try
        {
            await JS.InvokeVoidAsync("QMgrPrint.init", "browser");
            await JS.InvokeAsync<object>("QMgrPrint.print", new { htmlContent = html, autoPrint = false });
        }
        catch (JSException ex)
        {
            NotificationService.Notify(ToastSeverity.Error, "Print failed", ex.Message, 5000);
        }
    }

    private (DateOnly From, DateOnly To) ResolveRange()
    {
        var to = DateOnly.FromDateTime(toDate ?? DateTime.Today);
        var from = DateOnly.FromDateTime(fromDate ?? (toDate ?? DateTime.Today).AddDays(-6));
        if (from > to) (from, to) = (to, from);
        return (from, to);
    }

    private void NotifyExportFailure(ReportExportResult result)
    {
        if (result.IsForbidden)
            NotificationService.Notify(ToastSeverity.Warning, "Export not available",
                result.ErrorMessage ?? "You don't have permission to export reports, or your plan doesn't include exports.", 6000);
        else
            NotificationService.Notify(ToastSeverity.Error, "Export failed",
                result.ErrorMessage ?? "Couldn't generate the report. Please try again.", 5000);
    }

    /// <summary>
    /// Subscribe to branch changes. In OnAfterRenderAsync and not OnInitializedAsync on purpose:
    /// branch and auth state are read from localStorage over JS interop, which does not exist
    /// during prerendering and races an uninitialised store on a cold navigation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await BranchState.InitializeAsync();
        TrackBranch();
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        await LoadData();
    }
}
