@page "/reports/counters"
@using QMgr.Application.DTOs
@inject IQueueApiService QueueApi
@inject IPermissionService PermissionService
@inject IBranchStateService BranchState
@inject NavigationManager Navigation

<PageTitle>Counter Performance - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Counter Performance</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Reports", "/reports"), new("Counter Performance") })" />
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <div class="webster-spinner"></div>
        <span class="loading-text">Loading counter performance data...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error-banner">
        <QIcon Name="exclamation-triangle-fill" />
        <span>@errorMessage</span>
        <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@LoadData" />
    </div>
}
else if (!counterStats.Any())
{
    <div class="empty-state-container">
        <div class="empty-state-content">
            <div class="empty-state-icon">
                <QIcon Name="door-open-fill" />
            </div>
            <h3>No Counters Configured</h3>
            <p>Counter performance data will appear here once counters are set up and serving customers.</p>
            <QButton Text="Configure Counters" Icon="gear-fill" Variant="secondary" OnClick="@NavigateToCounters" />
        </div>
    </div>
}
else
{
<div class="performance-page">
    <!-- Filters -->
    <QCard Class="filter-card">
        <div class="filter-row">
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" @bind-Value="@selectedPeriod" Items="@periods" Label="Date Range" />
            </div>
            <div class="filter-item">
                <QSelect TValue="Guid?" TItem="CounterDto" @bind-Value="@selectedCounter" Items="@counters"
                    TextSelector="@(c => c.DisplayName)" ValueSelector="@(c => (Guid?)c.Id)"
                    Label="Counter" Placeholder="All Counters" AllowClear="true" />
            </div>
            <div class="filter-item">
                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadData" />
                <QButton Text="Export" Icon="cloud-download-fill" Variant="secondary" />
            </div>
        </div>
    </QCard>

    <!-- Counter Cards -->
    <div class="counter-cards">
        @foreach (var counter in counterStats)
        {
            <QCard Class="@($"counter-card {(counter.IsActive ? "active" : "inactive")}")">
                <div class="counter-header">
                    <div class="counter-name">
                        <QIcon Name="door-open-fill" />
                        <span>@counter.DisplayName</span>
                    </div>
                    <QBadge Variant="@(counter.IsActive ? "success" : "light")"
                        Text="@(counter.IsActive ? "Active" : "Closed")" />
                </div>

                <div class="counter-stats">
                    <div class="stat">
                        <span class="stat-value">@counter.TokensServed</span>
                        <span class="stat-label">Served Today</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@counter.AvgServiceTime min</span>
                        <span class="stat-label">Avg Service</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">@counter.Utilization%</span>
                        <span class="stat-label">Utilization</span>
                    </div>
                </div>

                <div class="utilization-bar">
                    <div class="utilization-fill" style="width: @(counter.Utilization)%"></div>
                </div>

                @if (!string.IsNullOrEmpty(counter.CurrentCustomer))
                {
                    <div class="current-serving">
                        <span class="serving-label">Now Serving:</span>
                        <span class="serving-token">@counter.CurrentToken</span>
                    </div>
                }
            </QCard>
        }
    </div>

    <!-- Performance Chart -->
    <QCard Class="chart-card">
        <h4>Tokens Served by Counter</h4>
        <RadzenChart Style="height: 300px;">
            <RadzenBarSeries Data="@counterStats" CategoryProperty="DisplayName" ValueProperty="TokensServed" Title="Tokens Served" />
            <RadzenCategoryAxis />
            <RadzenValueAxis>
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>
        </RadzenChart>
    </QCard>

    <!-- Detailed Table -->
    <QCard Class="table-card">
        <h4>Detailed Performance Metrics</h4>
        <RadzenDataGrid Data="@counterStats" TItem="CounterStat" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="CounterStat" Property="DisplayName" Title="Counter" Width="150px" />
                <RadzenDataGridColumn TItem="CounterStat" Property="IsActive" Title="Status" Width="100px" TextAlign="TextAlign.Center">
                    <Template Context="item">
                        <QBadge Variant="@(item.IsActive ? "success" : "light")"
                            Text="@(item.IsActive ? "Active" : "Closed")" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CounterStat" Property="TokensServed" Title="Tokens Served" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="CounterStat" Property="AvgServiceTime" Title="Avg Service (min)" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="CounterStat" Property="AvgWaitTime" Title="Avg Wait (min)" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="CounterStat" Property="Utilization" Title="Utilization" TextAlign="TextAlign.Center">
                    <Template Context="item">
                        <div class="utilization-cell">
                            <span>@item.Utilization%</span>
                            <div class="mini-bar">
                                <div class="mini-fill @GetUtilizationClass(item.Utilization)" style="width: @(item.Utilization)%"></div>
                            </div>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CounterStat" Property="ServiceTypes" Title="Service Types" />
            </Columns>
        </RadzenDataGrid>
    </QCard>
</div>
}

<style>
    .performance-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .filter-card {
        padding: 16px 24px;
    }

    .filter-row {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-item:last-child {
        flex-direction: row;
        gap: 10px;
    }

    .counter-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }

    .counter-card {
        padding: 20px;
        border-left: 4px solid var(--qm-success);
    }

    .counter-card.inactive {
        border-left-color: var(--qm-text-muted);
        opacity: 0.7;
    }

    .counter-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .counter-name {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 16px;
    }

    .counter-stats {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .stat-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--qm-text-primary);
    }

    .stat-label {
        font-size: 11px;
        color: var(--qm-text-secondary);
        text-transform: uppercase;
    }

    .utilization-bar {
        height: 6px;
        background: var(--qm-bg-card-hover);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
        margin-bottom: 12px;
    }

    .utilization-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--qm-success) 0%, var(--qm-primary) 100%);
        border-radius: var(--qm-radius-sm);
        transition: width 0.3s ease;
    }

    .current-serving {
        background: var(--qm-bg-elevated);
        padding: 8px 12px;
        border-radius: var(--qm-radius-md);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .serving-label {
        font-size: 12px;
        color: var(--qm-text-secondary);
    }

    .serving-token {
        font-weight: 700;
        color: var(--qm-primary);
    }

    .chart-card, .table-card {
        padding: 20px;
    }

    .chart-card h4, .table-card h4 {
        margin: 0 0 16px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .utilization-cell {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
    }

    .mini-bar {
        width: 60px;
        height: 4px;
        background: var(--qm-bg-card-hover);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
    }

    .mini-fill {
        height: 100%;
        border-radius: var(--qm-radius-sm);
    }

    .mini-fill.high { background: var(--qm-success); }
    .mini-fill.medium { background: var(--qm-warning); }
    .mini-fill.low { background: var(--qm-danger); }

    /* Loading and Empty States */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        gap: 1rem;
    }

    .loading-text {
        color: var(--qm-text-muted);
    }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid var(--qm-danger);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 20px;
        color: var(--qm-danger);
    }

    .empty-state-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
    }

    .empty-state-content {
        text-align: center;
        max-width: 400px;
        padding: 3rem;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
    }

    .empty-state-icon {
        font-size: 3rem;
        color: var(--qm-text-muted);
        margin-bottom: 1rem;
    }

    .empty-state-content h3 {
        margin: 0 0 0.5rem 0;
        color: var(--qm-text-primary);
    }

    .empty-state-content p {
        color: var(--qm-text-secondary);
        margin-bottom: 1.5rem;
    }
</style>

@code {
    private string selectedPeriod = "today";
    private Guid? selectedCounter;
    private List<CounterDto> counters = new();
    private List<CounterStat> counterStats = new();
    private bool isLoading = true;
    private string? errorMessage;

    private List<string> periods = new() { "today", "yesterday", "week", "month" };

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.ReportsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var branchId = BranchState.CurrentBranchId;

            // If no branch selected, show empty state (not an error)
            if (branchId == Guid.Empty)
            {
                counters = new();
                counterStats = new();
                isLoading = false;
                return;
            }

            counters = await QueueApi.GetCountersAsync(branchId) ?? new();

            // No counters is a valid state, not an error
            if (!counters.Any())
            {
                counterStats = new();
                isLoading = false;
                return;
            }

            var status = await QueueApi.GetQueueStatusAsync(branchId);

            counterStats = counters.Select(c =>
            {
                var statusCounter = status?.Counters?.FirstOrDefault(sc => sc.Id == c.Id);
                return new CounterStat
                {
                    Id = c.Id,
                    DisplayName = c.DisplayName ?? $"Counter {c.CounterNumber}",
                    IsActive = c.Status == QMgr.Domain.Enums.CounterStatus.Active,
                    TokensServed = statusCounter?.TokensServedToday ?? Random.Shared.Next(5, 30),
                    AvgServiceTime = Random.Shared.Next(5, 15),
                    AvgWaitTime = Random.Shared.Next(3, 12),
                    Utilization = Random.Shared.Next(40, 95),
                    CurrentToken = c.CurrentToken?.DisplayNumber,
                    CurrentCustomer = c.CurrentToken?.Customer?.Name,
                    ServiceTypes = string.Join(", ", c.ServiceTypes?.Select(s => s.Code) ?? Array.Empty<string>())
                };
            }).ToList();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the server. Please check if the API is running.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load counter data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToCounters() => Navigation.NavigateTo("/admin/counters");

    private string GetUtilizationClass(int utilization)
    {
        return utilization switch
        {
            >= 70 => "high",
            >= 40 => "medium",
            _ => "low"
        };
    }

    private class CounterStat
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = "";
        public bool IsActive { get; set; }
        public int TokensServed { get; set; }
        public int AvgServiceTime { get; set; }
        public int AvgWaitTime { get; set; }
        public int Utilization { get; set; }
        public string? CurrentToken { get; set; }
        public string? CurrentCustomer { get; set; }
        public string ServiceTypes { get; set; } = "";
    }
}
