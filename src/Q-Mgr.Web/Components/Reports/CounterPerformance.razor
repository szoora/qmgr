@page "/reports/counters"
@using QMgr.Application.DTOs
@inject IReportsApiService ReportsApi
@inject IQueueApiService QueueApi
@inject IPermissionService PermissionService
@inject IBranchStateService BranchState
@inject NavigationManager Navigation
@inject IToastService NotificationService
@inject IJSRuntime JS

<PageTitle>Counter Performance - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Counter Performance</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Reports", "/reports"), new("Counter Performance") })" />
    </div>
</div>

<div class="performance-page">
    <!-- Filters — the Date Range drives every figure below AND the CSV export -->
    <QCard Class="filter-card">
        <div class="filter-row">
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" Value="@selectedPeriod" ValueChanged="@OnPeriodChanged"
                    Items="@periods" Label="Date Range" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QSelect TValue="Guid?" TItem="CounterPerformanceDto" Value="@selectedCounter" ValueChanged="@OnCounterChanged"
                    Items="@allCounters" TextSelector="@(c => c.DisplayName)" ValueSelector="@(c => (Guid?)c.CounterId)"
                    Label="Counter" Placeholder="All Counters" AllowClear="true" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
                <QButton Text="Export" Icon="cloud-download-fill" Variant="secondary" OnClick="@ExportCsv" Loading="@isExporting" Disabled="@isExporting" />
            </div>
        </div>
        <p class="range-caption">Showing @RangeCaption</p>
    </QCard>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner @(isForbidden ? "warn" : "")">
            <QIcon Name="exclamation-triangle-fill" />
            <span>@errorMessage</span>
            @if (isForbidden)
            {
                <QButton Text="View plans" Icon="box-seam" Variant="secondary" Size="sm" OnClick="@(() => Navigation.NavigateTo("/billing/modules"))" />
            }
            else
            {
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@LoadData" />
            }
        </div>
    }
    else if (isLoading)
    {
        <div class="loading-container">
            <div class="webster-spinner"></div>
            <span class="loading-text">Loading counter performance data...</span>
        </div>
    }
    else if (!allCounters.Any())
    {
        <div class="empty-state-container">
            <div class="empty-state-content">
                <div class="empty-state-icon">
                    <QIcon Name="door-open-fill" />
                </div>
                <h3>No Counters Configured</h3>
                <p>Counter performance data will appear here once counters are set up and serving customers.</p>
                <QButton Text="Configure Counters" Icon="gear-fill" Variant="secondary" OnClick="@NavigateToCounters" />
            </div>
        </div>
    }
    else
    {
        @if (!counterStats.Any(c => c.TokensHandled > 0))
        {
            <QCard Class="notice-card">
                <QIcon Name="info-circle-fill" />
                <span>No tokens were handled by @(selectedCounter is null ? "any counter" : "this counter") in this range. The figures below are all empty rather than zero, because there is nothing to measure.</span>
            </QCard>
        }

        <!-- Counter Cards -->
        <div class="counter-cards">
            @foreach (var counter in counterStats)
            {
                <QCard Class="@($"counter-card {(counter.Status == QMgr.Domain.Enums.CounterStatus.Active ? "active" : "inactive")}")">
                    <div class="counter-header">
                        <div class="counter-name">
                            <QIcon Name="door-open-fill" />
                            <span>@counter.DisplayName</span>
                        </div>
                        <QBadge Variant="@(counter.Status == QMgr.Domain.Enums.CounterStatus.Active ? "success" : "light")"
                            Text="@counter.Status.ToString()" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(counter.AssignedStaff))
                    {
                        <div class="counter-staff">@counter.AssignedStaff</div>
                    }

                    <div class="counter-stats">
                        <div class="stat">
                            <span class="stat-value">@counter.Served</span>
                            <span class="stat-label">Served</span>
                        </div>
                        <div class="stat">
                            <span class="stat-value">@FormatNumber(counter.AvgServiceMinutes)</span>
                            <span class="stat-label">Avg Service (min)</span>
                        </div>
                        <div class="stat" title="@utilisationDefinition">
                            <span class="stat-value">@FormatPercent(counter.UtilisationPercent)</span>
                            <span class="stat-label">Utilisation</span>
                        </div>
                    </div>

                    <div class="utilization-bar">
                        <div class="utilization-fill" style="width: @(BarWidth(counter.UtilisationPercent))%"></div>
                    </div>

                    <div class="counter-footnote">
                        @if (counter.UtilisationPercent.HasValue)
                        {
                            <span>@counter.TotalServiceMinutes serving min of @counter.ActiveMinutes active min</span>
                        }
                        else
                        {
                            <span>No recorded activity in this range</span>
                        }
                    </div>
                </QCard>
            }
        </div>

        <!-- Performance Chart -->
        <QCard Class="chart-card">
            <h4>Tokens Served by Counter</h4>
            @if (counterStats.Any(c => c.Served > 0))
            {
                <RadzenChart Style="height: 300px;">
                    <RadzenBarSeries Data="@counterStats" CategoryProperty="DisplayName" ValueProperty="Served" Title="Tokens Served" />
                    <RadzenCategoryAxis />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                </RadzenChart>
            }
            else
            {
                <p class="chart-empty">No tokens were served in this range.</p>
            }
        </QCard>

        <!-- Detailed Table -->
        <QCard Class="table-card">
            <h4>Detailed Performance Metrics</h4>
            <RadzenDataGrid Data="@counterStats" TItem="CounterPerformanceDto" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="DisplayName" Title="Counter" Width="150px" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="Status" Title="Status" Width="110px" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <QBadge Variant="@(item.Status == QMgr.Domain.Enums.CounterStatus.Active ? "success" : "light")"
                                Text="@item.Status.ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="AssignedStaff" Title="Assigned Staff">
                        <Template Context="item">
                            @(string.IsNullOrWhiteSpace(item.AssignedStaff) ? Dash : item.AssignedStaff)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="TokensHandled" Title="Handled" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="Served" Title="Served" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="NoShow" Title="No-Show" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="Transferred" Title="Transferred" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="AvgWaitMinutes" Title="Avg Wait (min)" TextAlign="TextAlign.Center">
                        <Template Context="item">@FormatNumber(item.AvgWaitMinutes)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="AvgServiceMinutes" Title="Avg Service (min)" TextAlign="TextAlign.Center">
                        <Template Context="item">@FormatNumber(item.AvgServiceMinutes)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="TotalServiceMinutes" Title="Total Service (min)" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Property="UtilisationPercent" Title="Utilisation" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <div class="utilization-cell" title="@utilisationDefinition">
                                <span>@FormatPercent(item.UtilisationPercent)</span>
                                @if (item.UtilisationPercent.HasValue)
                                {
                                    <div class="mini-bar">
                                        <div class="mini-fill @GetUtilizationClass(item.UtilisationPercent)" style="width: @(BarWidth(item.UtilisationPercent))%"></div>
                                    </div>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="CounterPerformanceDto" Title="Service Types" Sortable="false">
                        <Template Context="item">
                            @(item.ServiceTypes.Any() ? string.Join(", ", item.ServiceTypes) : Dash)
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <!-- The utilisation definition is served by the API alongside the numbers, so this
                 caption can never describe a different calculation than the one that produced them. -->
            <p class="definition-note">
                <strong>How utilisation is measured:</strong> @utilisationDefinition
            </p>
            <p class="definition-note">A dash means there was nothing to measure in this range — it is not a value of zero.</p>
        </QCard>
    }
</div>

<style>
    .performance-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .filter-card {
        padding: 16px 24px;
    }

    .filter-row {
        display: flex;
        gap: 20px;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-item:last-child {
        flex-direction: row;
        gap: 10px;
    }

    .range-caption {
        margin: 14px 0 0 0;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .notice-card {
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--qm-text-secondary);
        font-size: 13px;
    }

    .counter-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
    }

    .counter-card {
        padding: 20px;
        border-left: 4px solid var(--qm-success);
    }

    .counter-card.inactive {
        border-left-color: var(--qm-text-muted);
        opacity: 0.7;
    }

    .counter-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .counter-name {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 16px;
    }

    .counter-staff {
        font-size: 12px;
        color: var(--qm-text-secondary);
        margin-bottom: 12px;
    }

    .counter-stats {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        gap: 8px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .stat-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--qm-text-primary);
    }

    .stat-label {
        font-size: 11px;
        color: var(--qm-text-secondary);
        text-transform: uppercase;
    }

    .utilization-bar {
        height: 6px;
        background: var(--qm-bg-card-hover);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
        margin-bottom: 10px;
    }

    .utilization-fill {
        height: 100%;
        background: var(--qm-primary);
        border-radius: var(--qm-radius-sm);
        transition: width 0.3s ease;
    }

    .counter-footnote {
        font-size: 11px;
        color: var(--qm-text-muted);
    }

    .chart-card, .table-card {
        padding: 20px;
    }

    .chart-card h4, .table-card h4 {
        margin: 0 0 16px 0;
        font-size: 16px;
        font-weight: 600;
    }

    .chart-empty {
        font-size: 13px;
        color: var(--qm-text-muted);
        margin: 0;
    }

    .definition-note {
        margin: 14px 0 0 0;
        font-size: 11px;
        line-height: 1.6;
        color: var(--qm-text-muted);
    }

    .utilization-cell {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
    }

    .mini-bar {
        width: 60px;
        height: 4px;
        background: var(--qm-bg-card-hover);
        border-radius: var(--qm-radius-sm);
        overflow: hidden;
    }

    .mini-fill {
        height: 100%;
        border-radius: var(--qm-radius-sm);
    }

    .mini-fill.high { background: var(--qm-success); }
    .mini-fill.medium { background: var(--qm-warning); }
    .mini-fill.low { background: var(--qm-danger); }

    /* Loading and Empty States */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        gap: 1rem;
    }

    .loading-text {
        color: var(--qm-text-muted);
    }

    .error-banner {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        background: color-mix(in srgb, var(--qm-danger) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--qm-danger) 35%, transparent);
        border-radius: var(--qm-radius-lg);
        color: var(--qm-danger);
    }

    .error-banner.warn {
        background: color-mix(in srgb, var(--qm-warning) 12%, transparent);
        border-color: color-mix(in srgb, var(--qm-warning) 35%, transparent);
        color: var(--qm-warning);
    }

    .empty-state-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
    }

    .empty-state-content {
        text-align: center;
        max-width: 400px;
        padding: 3rem;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        border: 1px solid var(--qm-border);
    }

    .empty-state-icon {
        font-size: 3rem;
        color: var(--qm-text-muted);
        margin-bottom: 1rem;
    }

    .empty-state-content h3 {
        margin: 0 0 0.5rem 0;
        color: var(--qm-text-primary);
    }

    .empty-state-content p {
        color: var(--qm-text-secondary);
        margin-bottom: 1.5rem;
    }
</style>

@code {
    // Everything on this page is the CounterPerformanceReportDto the API computed for the
    // selected range — the JSON sibling of the CSV the Export button downloads. There is no
    // client-side derivation of any metric.
    private List<CounterPerformanceDto> allCounters = new();
    private string utilisationDefinition = "";

    private string selectedPeriod = "today";
    private Guid? selectedCounter;
    private bool isLoading = true;
    private bool isExporting;
    private bool isForbidden;
    private string? errorMessage;

    private const string Dash = "—";

    private List<string> periods = new() { "today", "yesterday", "week", "month" };

    /// <summary>The rows actually rendered — the Counter filter is a view filter over the real rows.</summary>
    private List<CounterPerformanceDto> counterStats =>
        selectedCounter is null
            ? allCounters
            : allCounters.Where(c => c.CounterId == selectedCounter).ToList();

    private string RangeCaption
    {
        get
        {
            var (from, to) = ResolvePeriod(selectedPeriod);
            return from == to ? from.ToString("MMM d, yyyy") : $"{from:MMM d, yyyy} – {to:MMM d, yyyy}";
        }
    }

    /// <summary>Null means the counter served nothing in the range — an em dash, never "0".</summary>
    private static string FormatNumber(double? value) => value.HasValue ? value.Value.ToString("0.#") : Dash;
    private static string FormatPercent(double? value) => value.HasValue ? $"{value.Value:0.#}%" : Dash;

    /// <summary>
    /// Bar width only — the displayed percentage itself is never clamped. Formatted invariant so
    /// a comma-decimal locale can't emit "width: 45,5%", which browsers drop silently.
    /// </summary>
    private static string BarWidth(double? value) =>
        (value.HasValue ? Math.Clamp(value.Value, 0, 100) : 0)
            .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ReportsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await BranchState.InitializeAsync();
        await LoadData();
    }

    private async Task OnPeriodChanged(string period)
    {
        selectedPeriod = period;
        await LoadData();
    }

    private async Task OnCounterChanged(Guid? counterId)
    {
        selectedCounter = counterId;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        isForbidden = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var branchId = BranchState.CurrentBranchId;
            if (branchId == Guid.Empty)
            {
                allCounters = new();
                utilisationDefinition = "";
                errorMessage = "Select a branch to see its counter performance.";
                return;
            }

            var (from, to) = ResolvePeriod(selectedPeriod);
            var result = await ReportsApi.GetCounterPerformanceAsync(branchId, from, to);

            if (!result.Success)
            {
                allCounters = new();
                utilisationDefinition = "";
                isForbidden = result.IsForbidden;
                errorMessage = result.DisplayMessage;
                return;
            }

            allCounters = result.Data!.Counters;
            utilisationDefinition = result.Data.UtilisationDefinition;

            if (selectedCounter is not null && allCounters.All(c => c.CounterId != selectedCounter))
                selectedCounter = null;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToCounters() => Navigation.NavigateTo("/admin/counters");

    /// <summary>
    /// Downloads the per-counter CSV for exactly the range on screen — same data: URL +
    /// downloadDataUrl pattern VisitorReport uses. The export always includes every counter so
    /// idle ones stay visible (mirroring the API's own reasoning), which is why the on-screen
    /// "Counter" filter is deliberately not applied to the file.
    /// </summary>
    private async Task ExportCsv()
    {
        var branchId = BranchState.CurrentBranchId;
        if (branchId == Guid.Empty)
        {
            NotificationService.Notify(ToastSeverity.Warning, "No branch selected", "Select a branch before exporting.", 4000);
            return;
        }

        var (from, to) = ResolvePeriod(selectedPeriod);
        isExporting = true;
        try
        {
            var result = await QueueApi.ExportReportCsvAsync(ReportExportKind.Counters, branchId, from, to);
            if (!result.Success)
            {
                if (result.IsForbidden)
                    NotificationService.Notify(ToastSeverity.Warning, "Export not available",
                        result.ErrorMessage ?? "You don't have permission to export reports, or your plan doesn't include exports.", 6000);
                else
                    NotificationService.Notify(ToastSeverity.Error, "Export failed",
                        result.ErrorMessage ?? "Couldn't export counter performance. Please try again.", 5000);
                return;
            }

            var dataUrl = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(result.Csv!);
            await JS.InvokeVoidAsync("downloadDataUrl", dataUrl, $"counter-performance-{from:yyyyMMdd}-{to:yyyyMMdd}.csv");
        }
        finally
        {
            isExporting = false;
        }
    }

    private static (DateOnly From, DateOnly To) ResolvePeriod(string period)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return period switch
        {
            "yesterday" => (today.AddDays(-1), today.AddDays(-1)),
            "week" => (today.AddDays(-6), today),
            "month" => (today.AddDays(-29), today),
            _ => (today, today)
        };
    }

    private static string GetUtilizationClass(double? utilization)
    {
        if (!utilization.HasValue) return "";
        return utilization.Value switch
        {
            >= 70 => "high",
            >= 40 => "medium",
            _ => "low"
        };
    }
}
