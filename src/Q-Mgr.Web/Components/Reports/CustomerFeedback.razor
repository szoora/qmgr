        .stats-row { grid-template-columns: minmax(0, 1fr); }
        .mini-stats { flex-wrap: wrap; }
        .mini-stat { flex: 1 1 140px; min-width: 0; }
        .charts-row { grid-template-columns: minmax(0, 1fr); }
