</style>

@code {
    /// <summary>True when the Feedback hub is hosting this page inside its own tab strip: the host
    /// then owns the page title, the header band and the tabs. There is no route to reach this
    /// component any other way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    // Every figure on this page is the FeedbackReportDto the API computed for the selected
    // range — the JSON sibling of the feedback CSV the Export button downloads. Nothing here is
    // generated, sampled or hardcoded.
    private FeedbackReportDto? report;

    /// <summary>The five star bars, coloured from positive to negative as the page always coloured them.</summary>
    private IReadOnlyList<QBarItem> RatingBars => report == null
        ? Array.Empty<QBarItem>()
        : report.Distribution.Select(d => new QBarItem(
            $"{d.Stars} star",
            (decimal)d.Percent,
            Count: d.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture),
            Color: d.Stars switch
            {
                5 => "var(--qm-success)",
                4 => "var(--qm-accent-green)",
                3 => "var(--qm-accent-yellow)",
                2 => "var(--qm-accent-orange)",
                _ => "var(--qm-danger)"
            })).ToList();

    private string selectedPeriod = "month";
    private string? selectedRating;
    private string? selectedService;
    private bool isLoading = true;
    private bool isForbidden;
    private string? errorMessage;

    private List<string> periods = new() { "today", "week", "month", "quarter", "year" };
    private List<string> ratings = new() { "5 Stars", "4 Stars", "3 Stars", "2 Stars", "1 Star" };

    /// <summary>Populated from the service types that actually appear in this range's feedback.</summary>
    private List<string> serviceNames = new();

    private record TrendPoint(DateTime Day, double Rating);
    private List<TrendPoint> trendData = new();

    private string RangeCaption
    {
        get
        {
            var (from, to) = ResolvePeriod(selectedPeriod);
            return QDateFormat.Range(from, to);
        }
    }

    /// <summary>
    /// The Rating / Service Type pickers narrow the on-screen comment list only. They are a view
    /// filter over rows the API already returned for this range — no figure is recomputed here.
    /// </summary>
    private List<FeedbackCommentDto> filteredComments
    {
        get
        {
            if (report is null) return new();
            IEnumerable<FeedbackCommentDto> rows = report.RecentComments;

            if (!string.IsNullOrEmpty(selectedRating))
            {
                var stars = selectedRating[0] - '0';
                rows = rows.Where(c => c.Rating == stars);
            }

            if (!string.IsNullOrEmpty(selectedService))
                rows = rows.Where(c => string.Equals(c.ServiceTypeName, selectedService, StringComparison.OrdinalIgnoreCase));

            return rows.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ReportsView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.EngagementCommunications))
        {
            Navigation.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        await BranchState.InitializeAsync();
        await LoadData();
    }

    private async Task OnPeriodChanged(string period)
    {
        selectedPeriod = period;
        await LoadData();
    }

    private async Task OnRatingChanged(string? rating)
    {
        selectedRating = rating;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnServiceChanged(string? service)
    {
        selectedService = service;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        isForbidden = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var branchId = BranchState.CurrentBranchId;
            if (branchId == Guid.Empty)
            {
                Reset();
                errorMessage = "Select a branch to see its customer feedback.";
                return;
            }

            var (from, to) = ResolvePeriod(selectedPeriod);
            var result = await ReportsApi.GetFeedbackAsync(branchId, from, to);

            if (!result.Success)
            {
                Reset();
                isForbidden = result.IsForbidden;
                errorMessage = result.DisplayMessage;
                return;
            }

            report = result.Data;
            trendData = report!.ByDay
                .Select(d => new TrendPoint(d.Day.ToDateTime(TimeOnly.MinValue), d.AverageRating))
                .ToList();

            serviceNames = report.ByServiceType.Select(s => s.Name).ToList();
            if (selectedService is not null && !serviceNames.Contains(selectedService))
                selectedService = null;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Reset()
    {
        report = null;
        trendData = new();
        serviceNames = new();
    }

    /// <summary>
    /// Downloads the raw feedback log for exactly the range on screen — same data: URL +
    /// downloadDataUrl pattern VisitorReport uses, and the same from/to that produced every
    /// figure above. The CSV additionally carries customer contact details, which is why it is
    /// gated on the stronger reports.export permission while this page's data is not.
    /// </summary>
    /// <summary>
    /// Goes through the gated report endpoint rather than rendering the comments already loaded —
    /// ReportsExport and the plan's export feature are both API-side checks, and this is a bulk
    /// export of customer names, contact details and free-text comments.
    /// </summary>
    private async Task<(IReadOnlyList<ExportColumn<string[]>> Columns, ExportRows<string[]> Rows)> ProvideExportSourceAsync()
    {
        var branchId = BranchState.CurrentBranchId;
        if (branchId == Guid.Empty)
            throw new InvalidOperationException("Select a branch before exporting.");

        var (from, to) = ResolvePeriod(selectedPeriod);
        var result = await QueueApi.ExportReportCsvAsync(ReportExportKind.Feedback, branchId, from, to);

        if (!result.Success)
            throw new InvalidOperationException(result.ErrorMessage
                ?? (result.IsForbidden
                    ? "You don't have permission to export reports, or your plan doesn't include exports."
                    : "Couldn't export customer feedback. Please try again."));

        return ExportCsvSource.Parse(result.Csv!);
    }

    private static (DateOnly From, DateOnly To) ResolvePeriod(string period)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return period switch
        {
            "today" => (today, today),
            "week" => (today.AddDays(-6), today),
            "quarter" => (today.AddDays(-89), today),
            "year" => (today.AddDays(-364), today),
            _ => (today.AddDays(-29), today) // "month"
        };
    }

    /// <summary>
    /// Subscribe to branch changes. In OnAfterRenderAsync and not OnInitializedAsync on purpose:
    /// branch and auth state are read from localStorage over JS interop, which does not exist
    /// during prerendering and races an uninitialised store on a cold navigation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await BranchState.InitializeAsync();
        TrackBranch();
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        await LoadData();
    }
}
