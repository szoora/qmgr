@using QMgr.Application.DTOs
@using QMgr.Domain.Constants
@using QMgr.Web.Services
@using QMgr.Web.Components.Shared.UI
@inject IReportsApiService ReportsApi
@inject IQueueApiService QueueApi
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inherits BranchAwareComponentBase
@inject IToastService NotificationService
@inject IJSRuntime JS


<div class="feedback-page">
    <!-- Filters — the Date Range drives every figure on this page AND the CSV export -->
    <QCard Class="filter-card">
        <div class="filter-row">
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" Value="@selectedPeriod" ValueChanged="@OnPeriodChanged"
                    Items="@periods" Label="Date Range" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" Value="@selectedRating" ValueChanged="@OnRatingChanged"
                    Items="@ratings" Label="Rating" Placeholder="All Ratings" AllowClear="true" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QSelect TValue="string" TItem="string" Value="@selectedService" ValueChanged="@OnServiceChanged"
                    Items="@serviceNames" Label="Service Type" Placeholder="All Services" AllowClear="true" Disabled="@isLoading" />
            </div>
            <div class="filter-item">
                <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadData" Disabled="@isLoading" />
            </div>
        </div>
        <p class="range-caption">
            Showing @RangeCaption. The Rating and Service Type filters narrow the list of comments below; the summary and charts always cover the whole range.
        </p>
    </QCard>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-banner @(isForbidden ? "warn" : "")">
            <QIcon Name="exclamation-triangle-fill" />
            <span>@errorMessage</span>
            @if (isForbidden)
            {
                <QButton Text="View plans" Icon="box-seam" Variant="secondary" Size="sm" OnClick="@(() => Navigation.NavigateTo("/billing/modules"))" />
            }
            else
            {
                <QButton Text="Retry" Icon="arrow-clockwise" Variant="danger" Size="sm" OnClick="@LoadData" />
            }
        </div>
    }
    else if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading feedback...</span>
        </div>
    }
    else if (report is null || report.TotalCount == 0)
    {
        <QCard Class="empty-card">
            <div class="empty-state-icon"><QIcon Name="chat-dots-fill" /></div>
            <h3>No feedback in this range</h3>
            <p>No customer submitted feedback between @RangeCaption. Pick a wider date range, or check back once customers have rated a visit.</p>
            <QDataExport TItem="string[]" Title="Customer feedback" FileStem="customer-feedback"
                         Subtitle="@RangeCaption" SourceProvider="@ProvideExportSourceAsync" />
        </QCard>
    }
    else
    {
        <!-- Summary Stats -->
        <div class="stats-row">
            <QCard Class="rating-card">
                <div class="rating-display">
                    <span class="rating-value">@(report.AverageRating!.Value.ToString("F1"))</span>
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <QIcon Name="@(i <= Math.Round(report.AverageRating!.Value) ? "star-fill" : "star")"
                                Class="@(i <= Math.Round(report.AverageRating!.Value) ? "star-on" : "star-off")" />
                        }
                    </div>
                    <span class="rating-label">Overall Rating</span>
                    <span class="rating-count">Based on @report.TotalCount @(report.TotalCount == 1 ? "review" : "reviews")</span>
                </div>
            </QCard>

            <div class="mini-stats">
                <div class="mini-stat positive">
                    <QIcon Name="emoji-smile-fill" />
                    <div class="mini-info">
                        <span class="mini-value">@report.PositivePercent.ToString("0.#")%</span>
                        <span class="mini-label">Positive (4-5 stars) · @report.PositiveCount</span>
                    </div>
                </div>
                <div class="mini-stat neutral">
                    <QIcon Name="emoji-neutral-fill" />
                    <div class="mini-info">
                        <span class="mini-value">@report.NeutralPercent.ToString("0.#")%</span>
                        <span class="mini-label">Neutral (3 stars) · @report.NeutralCount</span>
                    </div>
                </div>
                <div class="mini-stat negative">
                    <QIcon Name="emoji-frown-fill" />
                    <div class="mini-info">
                        <span class="mini-value">@report.NegativePercent.ToString("0.#")%</span>
                        <span class="mini-label">Negative (1-2 stars) · @report.NegativeCount</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rating Distribution + Trend -->
        <div class="charts-row">
            <QCard Class="chart-card">
                <h4>Rating Distribution</h4>
                @* Each bar is its star rating's share of all responses, so Max is 100 and the figure is the count. *@
                <QBarList Items="@RatingBars" Max="100" />
            </QCard>

            <QCard Class="chart-card">
                <h4>Feedback Trend</h4>
                @if (trendData.Count > 1)
                {
                    <RadzenChart Style="height: 250px;">
                        <RadzenLineSeries Data="@trendData" CategoryProperty="Day" ValueProperty="Rating" Title="Avg Rating" Smooth="true" />
                        <RadzenCategoryAxis Padding="20" FormatString="@("{0:" + QDateFormat.Compact + "}")" />
                        <RadzenValueAxis Min="1" Max="5">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                    </RadzenChart>
                    <p class="chart-note">Only days that received feedback are plotted — a day with none has no average to show.</p>
                }
                else if (trendData.Count == 1)
                {
                    <p class="chart-empty">
                        All feedback in this range arrived on one day (@QDateFormat.D(trendData[0].Day), averaging
                        @trendData[0].Rating.ToString("F1") stars), so there is no trend to plot yet.
                    </p>
                }
                else
                {
                    <p class="chart-empty">No feedback in this range.</p>
                }
            </QCard>
        </div>

        <!-- By service type / by counter -->
        <div class="charts-row">
            <QCard Class="table-card">
                <h4>By Service Type</h4>
                @if (report.ByServiceType.Any())
                {
                    <RadzenDataGrid Data="@report.ByServiceType" TItem="FeedbackBreakdownDto" AllowSorting="true">
                        <Columns>
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="Name" Title="Service Type" />
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="Count" Title="Reviews" TextAlign="TextAlign.Center" Width="100px" />
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="AverageRating" Title="Avg Rating" TextAlign="TextAlign.Center" Width="110px">
                                <Template Context="item">@item.AverageRating.ToString("F1")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
                else
                {
                    <p class="chart-empty">No feedback in this range.</p>
                }
            </QCard>

            <QCard Class="table-card">
                <h4>By Counter</h4>
                @if (report.ByCounter.Any())
                {
                    <RadzenDataGrid Data="@report.ByCounter" TItem="FeedbackBreakdownDto" AllowSorting="true">
                        <Columns>
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="Name" Title="Counter" />
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="Count" Title="Reviews" TextAlign="TextAlign.Center" Width="100px" />
                            <RadzenDataGridColumn TItem="FeedbackBreakdownDto" Property="AverageRating" Title="Avg Rating" TextAlign="TextAlign.Center" Width="110px">
                                <Template Context="item">@item.AverageRating.ToString("F1")</Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
                else
                {
                    <p class="chart-empty">No feedback in this range.</p>
                }
            </QCard>
        </div>

        <!-- Feedback List -->
        <QCard Class="feedback-list-card">
            <div class="list-header">
                <h4>Recent Feedback</h4>
                @* "All" is deliberate: the Rating / Service Type controls filter the list on
                   screen, while the export is the whole range the report covers. *@
                <QDataExport TItem="string[]" Title="Customer feedback" FileStem="customer-feedback"
                             Text="Export all" Subtitle="@RangeCaption" SourceProvider="@ProvideExportSourceAsync" />
            </div>

            @if (!filteredComments.Any())
            {
                <p class="chart-empty">No feedback matches the Rating / Service Type filters above.</p>
            }
            else
            {
                <div class="feedback-list">
                    @foreach (var feedback in filteredComments)
                    {
                        <div class="feedback-item">
                            <div class="feedback-left">
                                <div class="feedback-rating">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <QIcon Name="@(i <= feedback.Rating ? "star-fill" : "star")"
                                            Class="@(i <= feedback.Rating ? "star-on small" : "star-off small")" />
                                    }
                                </div>
                                <div class="feedback-meta">
                                    <span class="feedback-service">@(feedback.ServiceTypeName ?? "Unspecified service")</span>
                                    <span class="feedback-date">@QDateFormat.DT(feedback.SubmittedAt.ToLocalTime())</span>
                                </div>
                            </div>
                            <div class="feedback-content">
                                @if (!string.IsNullOrWhiteSpace(feedback.Comment))
                                {
                                    <p class="feedback-comment">"@feedback.Comment"</p>
                                }
                                else
                                {
                                    <p class="feedback-no-comment">No comment provided</p>
                                }
                                <div class="feedback-response">
                                    @if (feedback.HasResponse)
                                    {
                                        <QBadge Variant="success" Text="@($"Responded{(feedback.RespondedAt.HasValue ? $" · {QDateFormat.C(feedback.RespondedAt.Value.ToLocalTime())}" : "")}")" />
                                    }
                                    else
                                    {
                                        <QBadge Variant="light" Text="Awaiting response" />
                                    }
                                    <span class="feedback-category">@feedback.Category · @feedback.Source</span>
                                </div>
                            </div>
                            <div class="feedback-right">
                                <span class="feedback-counter">@(feedback.CounterName ?? "—")</span>
                                <span class="feedback-token">@(string.IsNullOrWhiteSpace(feedback.TokenDisplayNumber) ? "" : $"Token: {feedback.TokenDisplayNumber}")</span>
                            </div>
                        </div>
                    }
                </div>

                <p class="chart-note">
                    Showing @filteredComments.Count of @report.RecentComments.Count most recent entries
                    (@report.TotalCount in this range in total). Customer contact details are in the CSV export only.
                </p>
            }
        </QCard>
    }
</div>

<style>
