@page "/content/campaigns"
@using QMgr.Application.DTOs
@using QMgr.Web.Components.Shared
@using QMgr.Web.Components.Shared.UI
@using QMgr.Web.Services
@inject IContentApiService ContentApi
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IBranchStateService BranchState
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IJSRuntime JS
@using QMgr.Domain.Constants

<PageTitle>Campaigns - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Campaigns</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Digital Signage", "/content/media"), new("Campaigns") })" />
    </div>
</div>

<div class="campaigns-page">
    <!-- Toolbar -->
    <QCard Class="toolbar-card">
        <div class="toolbar">
            <div class="toolbar-left">
                <QInput TValue="string" @bind-Value="@searchTerm" Placeholder="Search campaigns..." IconLeft="search" />
            </div>
            <div class="toolbar-right">
                @if (canCreate)
                {
                    <QButton Text="New Campaign" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
                }
            </div>
        </div>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading campaigns...</span>
        </div>
    }
    else if (!campaigns.Any())
    {
        <div class="empty-state">
            <QIcon Name="megaphone-fill" />
            <h3>No Campaigns Yet</h3>
            <p>Create a campaign to run date-ranged promotions across your existing playlist content, with impression tracking on the public display.</p>
            @if (canCreate)
            {
                <QButton Text="Create First Campaign" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
            }
        </div>
    }
    else
    {
        <div class="campaigns-grid">
            @foreach (var campaign in FilteredCampaigns)
            {
                <QCard Class="campaign-card">
                    <div class="campaign-icon">
                        <QIcon Name="megaphone-fill" />
                    </div>
                    <div class="campaign-info">
                        <div class="campaign-title-row">
                            <h3>@campaign.Name</h3>
                            <QBadge Variant="@(GetStatusBadgeStyle(campaign))" Text="@GetStatusLabel(campaign)" />
                        </div>
                        <p>@(campaign.Description ?? "No description")</p>
                        <div class="campaign-meta">
                            <span class="meta-item">
                                <QIcon Name="calendar-event-fill" />
                                @QDateFormat.D(campaign.StartDate) &ndash; @QDateFormat.D(campaign.EndDate)
                            </span>
                            <span class="meta-item">
                                <QIcon Name="eye-fill" />
                                @campaign.TotalImpressions.ToString("N0") @(campaign.TotalImpressions == 1 ? "impression" : "impressions")
                            </span>
                        </div>
                    </div>
                    <div class="campaign-actions">
                        <QButton Icon="graph-up" Size="sm" Variant="secondary" OnClick="@(() => ShowStats(campaign))" />
                        @if (canEdit)
                        {
                            <QButton Icon="pencil-fill" Size="sm" Variant="secondary" OnClick="@(() => EditCampaign(campaign))" />
                        }
                        @if (canDelete)
                        {
                            <QButton Icon="trash-fill" Size="sm" Variant="danger" OnClick="@(() => DeleteCampaign(campaign))" />
                        }
                    </div>
                </QCard>
            }
        </div>
    }
</div>

<!-- Create/Edit Campaign Dialog -->
<QModal @bind-Visible="showDialog" Title="@(isEditing ? "Edit Campaign" : "Create Campaign")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@editModel.Name" Label="Name *" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@editModel.Description" Type="textarea" Label="Description" Rows="2" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Start Date *</label>
                <QDatePicker @bind-Value="@editModel.StartDate" />
            </div>
            <div class="form-group">
                <label>End Date *</label>
                <QDatePicker @bind-Value="@editModel.EndDate" />
            </div>
        </div>
        @if (isEditing)
        {
            <div class="form-group checkbox-group">
                <QCheckbox @bind-Value="@editModel.IsActive" Label="Active" />
            </div>
        }
        <p class="qm-admin-form-hint">Attach existing media to this campaign from the Media Library's "Add to Playlist" dialog once it's created.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@CloseDialog" />
        <QButton Text="@(isEditing ? "Save" : "Create")" Icon="@(isEditing ? "check-lg" : "plus-lg")" Variant="primary" OnClick="@SaveCampaign" />
    </FooterContent>
</QModal>

<!-- Impression Stats Dialog -->
<QModal @bind-Visible="showStatsDialog" Title="@($"Impressions: {statsCampaign?.Name}")" Icon="graph-up" Size="xl">
    <ChildContent>
        @* One range control, not two loose browser date fields plus three private preset buttons.
           The old pair emitted two separate changes for one edit and could briefly hold a
           From-after-To pair; QDateRangePicker normalizes and emits once. *@
        <div class="stats-filter-row">
            <QDateRangePicker Range="@statsRange" RangeChanged="@OnStatsRangeChanged" ShowCaption="false" />
            <div class="stats-filter-item">
                <QButton Text="Apply" Icon="funnel-fill" Size="sm" Variant="primary" OnClick="@LoadStats" Disabled="@statsLoading" />
            </div>
        </div>

        @if (statsLoading)
        {
            <div class="stats-loading">
                <QSpinner Size="lg" />
                <span>Loading impressions...</span>
            </div>
        }
        else if (stats == null)
        {
            <div class="stats-empty">
                <QIcon Name="exclamation-triangle" />
                <h4>Couldn't load impressions</h4>
                <p>Try a different date range or reload the page.</p>
            </div>
        }
        else if (stats.TotalImpressions == 0)
        {
            <div class="stats-empty">
                <QIcon Name="eye-slash" />
                <h4>No impressions yet</h4>
                <p>Nothing was recorded between @QDateFormat.D(stats.From) and @QDateFormat.D(stats.To). Impressions are logged each time a media item attached to this campaign plays on a public display.</p>
            </div>
        }
        else
        {
            <QStatRow Class="stats-tiles">
                <QStatTile Value="@stats.TotalImpressions.ToString("N0")" Label="Total Impressions" Variant="primary" />
                <QStatTile Value="@stats.UniqueMediaItems.ToString("N0")" Label="Media Items Shown" Variant="primary" />
                <QStatTile Value="@StatsDayCount.ToString("N0")" Label="Days in Range" Variant="primary" />
                <QStatTile Value="@StatsPerDay.ToString("N1")" Label="Avg. per Day" Variant="primary" />
            </QStatRow>

            <div class="stats-chart-card">
                <h4>Impressions by Day</h4>
                <RadzenChart Style="height: 240px;">
                    <RadzenLineSeries Data="@dailyChartData" CategoryProperty="Day" ValueProperty="Count" Title="Impressions" Smooth="true" />
                    <RadzenCategoryAxis Padding="20" FormatString="@("{0:" + QDateFormat.Compact + "}")" />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                </RadzenChart>
            </div>

            <div class="stats-tables-row">
                @* Each bar is that row's share of every impression in the period; the figure is the count. *@
                <div class="stats-table-card">
                    <h4>By Media</h4>
                    <QBarList Items="@MediaBars" Max="@(stats.TotalImpressions > 0 ? (decimal?)stats.TotalImpressions : null)" EmptyText="No impressions in this period." />
                </div>

                <div class="stats-table-card">
                    <h4>By Branch</h4>
                    <QBarList Items="@BranchBars" Max="@(stats.TotalImpressions > 0 ? (decimal?)stats.TotalImpressions : null)" EmptyText="No impressions in this period." />
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="secondary" OnClick="@CloseStatsDialog" />
        @if (canExport)
        {
            <QDataExport TItem="string[]"
                         Title="Campaign impressions"
                         FileStem="@($"campaign-{Slugify(statsCampaign?.Name ?? "stats")}-impressions")"
                         Subtitle="@($"{statsCampaign?.Name} · {QDateFormat.Range(statsFrom, statsTo)}")"
                         Variant="primary"
                         SourceProvider="@ProvideStatsExportSourceAsync"
                         Disabled="@(statsLoading || stats == null)"
                         DisabledReason="Load the campaign's statistics first." />
        }
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Campaign"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

<style>
    .campaigns-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .toolbar-card {
        padding: 16px 24px;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .toolbar-left, .toolbar-right {
        display: flex;
        gap: var(--q-row-gap, 8px);
    }

    .loading-container, .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        color: var(--qm-text-secondary);
        text-align: center;
    }

    .empty-state {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        padding: 80px 20px;
    }

    .empty-state .rzi {
        font-size: 64px;
        color: var(--qm-text-muted);
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--qm-text-primary);
    }

    .empty-state p {
        margin: 0 0 24px;
        max-width: 480px;
    }

    .campaigns-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 20px;
    }

    .campaign-card {
        padding: 20px;
        display: flex;
        gap: 16px;
    }

    .campaign-icon {
        width: 56px;
        height: 56px;
        background: linear-gradient(135deg, var(--qm-primary) 0%, var(--qm-primary-dark) 100%);
        border-radius: var(--qm-radius-xl);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .campaign-icon .rzi {
        font-size: 28px;
        color: var(--qm-text-on-primary);
    }

    .campaign-info {
        flex: 1;
        min-width: 0;
    }

    .campaign-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

    .campaign-title-row h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
    }

    .campaign-info p {
        margin: 0 0 12px;
        font-size: 13px;
        color: var(--qm-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .campaign-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        color: var(--qm-text-secondary);
    }

    .meta-item .rzi {
        font-size: 14px;
    }

    .campaign-actions {
        display: flex;
        align-items: center;
        align-self: center;
        gap: 8px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
        font-size: 13px;
    }

    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Impression stats dialog */
    .stats-filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .stats-filter-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .stats-filter-item label {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 13px;
        color: var(--qm-text-muted);
    }

    /* The `input[type="date"]` block and the .stats-quick-ranges row that used to live here went
       with the two loose date fields and the three private preset buttons they styled —
       QDateRangePicker brings its own. */

    .stats-loading, .stats-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 48px 20px;
        text-align: center;
        color: var(--qm-text-secondary);
    }

    .stats-empty .rzi {
        font-size: 48px;
        color: var(--qm-text-muted);
    }

