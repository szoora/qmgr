@page "/content/campaigns"
@using QMgr.Application.DTOs
@using QMgr.Web.Components.Shared
@inject IContentApiService ContentApi
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager Navigation
@inject IBranchStateService BranchState
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@inject IJSRuntime JS
@using QMgr.Domain.Constants

<PageTitle>Campaigns - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Campaigns</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Digital Signage", "/content/media"), new("Campaigns") })" />
    </div>
</div>

<div class="campaigns-page">
    <!-- Toolbar -->
    <QCard Class="toolbar-card">
        <div class="toolbar">
            <div class="toolbar-left">
                <QInput TValue="string" @bind-Value="@searchTerm" Placeholder="Search campaigns..." IconLeft="search" />
            </div>
            <div class="toolbar-right">
                @if (canCreate)
                {
                    <QButton Text="New Campaign" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
                }
            </div>
        </div>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading campaigns...</span>
        </div>
    }
    else if (!campaigns.Any())
    {
        <div class="empty-state">
            <QIcon Name="megaphone-fill" />
            <h3>No Campaigns Yet</h3>
            <p>Create a campaign to run date-ranged promotions across your existing playlist content, with impression tracking on the public display.</p>
            @if (canCreate)
            {
                <QButton Text="Create First Campaign" Icon="plus-lg" Variant="primary" OnClick="@ShowCreateDialog" />
            }
        </div>
    }
    else
    {
        <div class="campaigns-grid">
            @foreach (var campaign in FilteredCampaigns)
            {
                <QCard Class="campaign-card">
                    <div class="campaign-icon">
                        <QIcon Name="megaphone-fill" />
                    </div>
                    <div class="campaign-info">
                        <div class="campaign-title-row">
                            <h3>@campaign.Name</h3>
                            <QBadge Variant="@(GetStatusBadgeStyle(campaign))" Text="@GetStatusLabel(campaign)" />
                        </div>
                        <p>@(campaign.Description ?? "No description")</p>
                        <div class="campaign-meta">
                            <span class="meta-item">
                                <QIcon Name="calendar-event-fill" />
                                @campaign.StartDate.ToString("MMM d, yyyy") &ndash; @campaign.EndDate.ToString("MMM d, yyyy")
                            </span>
                            <span class="meta-item">
                                <QIcon Name="eye-fill" />
                                @campaign.TotalImpressions.ToString("N0") @(campaign.TotalImpressions == 1 ? "impression" : "impressions")
                            </span>
                        </div>
                    </div>
                    <div class="campaign-actions">
                        <QButton Icon="graph-up" Size="sm" Variant="secondary" OnClick="@(() => ShowStats(campaign))" />
                        @if (canEdit)
                        {
                            <QButton Icon="pencil-fill" Size="sm" Variant="secondary" OnClick="@(() => EditCampaign(campaign))" />
                        }
                        @if (canDelete)
                        {
                            <QButton Icon="trash-fill" Size="sm" Variant="danger" OnClick="@(() => DeleteCampaign(campaign))" />
                        }
                    </div>
                </QCard>
            }
        </div>
    }
</div>

<!-- Create/Edit Campaign Dialog -->
<QModal @bind-Visible="showDialog" Title="@(isEditing ? "Edit Campaign" : "Create Campaign")" Size="md">
    <ChildContent>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@editModel.Name" Label="Name *" />
        </div>
        <div class="form-group">
            <QInput TValue="string" @bind-Value="@editModel.Description" Type="textarea" Label="Description" Rows="2" />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Start Date *</label>
                <QDatePicker @bind-Value="@editModel.StartDate" />
            </div>
            <div class="form-group">
                <label>End Date *</label>
                <QDatePicker @bind-Value="@editModel.EndDate" />
            </div>
        </div>
        @if (isEditing)
        {
            <div class="form-group checkbox-group">
                <QCheckbox @bind-Value="@editModel.IsActive" Label="Active" />
            </div>
        }
        <p class="qm-admin-form-hint">Attach existing media to this campaign from the Media Library's "Add to Playlist" dialog once it's created.</p>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@CloseDialog" />
        <QButton Text="@(isEditing ? "Save" : "Create")" Icon="@(isEditing ? "check-lg" : "plus-lg")" Variant="primary" OnClick="@SaveCampaign" />
    </FooterContent>
</QModal>

<!-- Impression Stats Dialog -->
<QModal @bind-Visible="showStatsDialog" Title="@($"Impressions: {statsCampaign?.Name}")" Icon="graph-up" Size="xl">
    <ChildContent>
        <div class="stats-filter-row">
            <div class="stats-filter-item">
                <label>From<input type="date" @bind="statsFrom" /></label>
            </div>
            <div class="stats-filter-item">
                <label>To<input type="date" @bind="statsTo" /></label>
            </div>
            <div class="stats-filter-item stats-quick-ranges">
                <QButton Text="7 days" Size="sm" Variant="ghost" OnClick="@(() => ApplyStatsQuickRange(6))" />
                <QButton Text="30 days" Size="sm" Variant="ghost" OnClick="@(() => ApplyStatsQuickRange(29))" />
                <QButton Text="90 days" Size="sm" Variant="ghost" OnClick="@(() => ApplyStatsQuickRange(89))" />
            </div>
            <div class="stats-filter-item">
                <QButton Text="Apply" Icon="funnel-fill" Size="sm" Variant="primary" OnClick="@LoadStats" Disabled="@statsLoading" />
            </div>
        </div>

        @if (statsLoading)
        {
            <div class="stats-loading">
                <QSpinner Size="lg" />
                <span>Loading impressions...</span>
            </div>
        }
        else if (stats == null)
        {
            <div class="stats-empty">
                <QIcon Name="exclamation-triangle" />
                <h4>Couldn't load impressions</h4>
                <p>Try a different date range or reload the page.</p>
            </div>
        }
        else if (stats.TotalImpressions == 0)
        {
            <div class="stats-empty">
                <QIcon Name="eye-slash" />
                <h4>No impressions yet</h4>
                <p>Nothing was recorded between @stats.From.ToString("MMM d, yyyy") and @stats.To.ToString("MMM d, yyyy"). Impressions are logged each time a media item attached to this campaign plays on a public display.</p>
            </div>
        }
        else
        {
            <div class="stats-tiles">
                <div class="stats-tile">
                    <div class="stats-tile-value">@stats.TotalImpressions.ToString("N0")</div>
                    <div class="stats-tile-label">Total Impressions</div>
                </div>
                <div class="stats-tile">
                    <div class="stats-tile-value">@stats.UniqueMediaItems.ToString("N0")</div>
                    <div class="stats-tile-label">Media Items Shown</div>
                </div>
                <div class="stats-tile">
                    <div class="stats-tile-value">@StatsDayCount.ToString("N0")</div>
                    <div class="stats-tile-label">Days in Range</div>
                </div>
                <div class="stats-tile">
                    <div class="stats-tile-value">@StatsPerDay.ToString("N1")</div>
                    <div class="stats-tile-label">Avg. per Day</div>
                </div>
            </div>

            <div class="stats-chart-card">
                <h4>Impressions by Day</h4>
                <RadzenChart Style="height: 240px;">
                    <RadzenLineSeries Data="@dailyChartData" CategoryProperty="Day" ValueProperty="Count" Title="Impressions" Smooth="true" />
                    <RadzenCategoryAxis Padding="20" FormatString="{0:MMM dd}" />
                    <RadzenValueAxis>
                        <RadzenGridLines Visible="true" />
                    </RadzenValueAxis>
                </RadzenChart>
            </div>

            <div class="stats-tables-row">
                <div class="stats-table-card">
                    <h4>By Media</h4>
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Media</th>
                                <th class="stats-share-col">Share</th>
                                <th class="stats-count-col">Impressions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in stats.ByMedia)
                            {
                                <tr>
                                    <td class="stats-name-col" title="@m.Title">@m.Title</td>
                                    <td class="stats-share-col">
                                        <div class="stats-bar"><div class="stats-bar-fill" style="width: @SharePercent(m.Count)%"></div></div>
                                    </td>
                                    <td class="stats-count-col">@m.Count.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="stats-table-card">
                    <h4>By Branch</h4>
                    <table class="stats-table">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th class="stats-share-col">Share</th>
                                <th class="stats-count-col">Impressions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in stats.ByBranch)
                            {
                                <tr>
                                    <td class="stats-name-col" title="@b.BranchName">@b.BranchName</td>
                                    <td class="stats-share-col">
                                        <div class="stats-bar"><div class="stats-bar-fill" style="width: @SharePercent(b.Count)%"></div></div>
                                    </td>
                                    <td class="stats-count-col">@b.Count.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Close" Icon="x-lg" Variant="secondary" OnClick="@CloseStatsDialog" />
        @if (canExport)
        {
            <QButton Text="@(isExporting ? "Exporting..." : "Export CSV")" Icon="cloud-download-fill" Variant="primary" OnClick="@ExportStatsCsv" Disabled="@(isExporting || statsLoading || stats == null)" />
        }
    </FooterContent>
</QModal>

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Campaign"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

