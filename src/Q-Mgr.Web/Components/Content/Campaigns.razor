</style>

@code {
    private List<CampaignDto> campaigns = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private bool showDialog = false;
    private bool isEditing = false;
    private CampaignEditModel editModel = new();
    private Guid? editingId;

    private Guid branchId = Guid.Empty; // resolved from BranchState; no demo-branch fallback

    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private CampaignDto? campaignToDelete;

    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private bool canExport = false;

    // Impression stats dialog state
    private bool showStatsDialog = false;
    private bool statsLoading = false;
    private CampaignDto? statsCampaign;
    private CampaignStatsDto? stats;
    // The range control's state. statsFrom/statsTo read off it rather than being held separately,
    // so there is no second copy to drift — the API's own cap is written back into the range.
    private DateRange statsRange = DateRange.LastDays(30);
    private DateOnly statsFrom => statsRange.From;
    private DateOnly statsTo => statsRange.To;

    // RadzenChart's category axis wants a DateTime to format/order against — DayCountDto carries
    // a DateOnly, so this is a charting-only projection (same pattern as VisitorReport.razor).
    private record DayChartPoint(DateTime Day, int Count);
    private List<DayChartPoint> dailyChartData = new();

    private int StatsDayCount => stats == null ? 0 : stats.To.DayNumber - stats.From.DayNumber + 1;
    private double StatsPerDay => StatsDayCount == 0 || stats == null ? 0 : (double)stats.TotalImpressions / StatsDayCount;

    private IEnumerable<CampaignDto> FilteredCampaigns => campaigns
        .Where(c => string.IsNullOrEmpty(searchTerm) || c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!await PermissionService.HasPermissionAsync(Permissions.ContentView))
        {
            Navigation.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.EngagementCommunications))
        {
            Navigation.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        canCreate = await PermissionService.HasPermissionAsync(Permissions.ContentCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permissions.ContentEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permissions.ContentDelete);
        canExport = await PermissionService.HasPermissionAsync(Permissions.ReportsExport);

        await BranchState.InitializeAsync();
        if (BranchState.CurrentBranchId != Guid.Empty)
        {
            branchId = BranchState.CurrentBranchId;
        }

        await LoadCampaigns();
    }

    private async Task LoadCampaigns()
    {
        isLoading = true;
        campaigns = await ContentApi.GetCampaignsAsync(branchId);
        isLoading = false;
    }

    private string GetStatusLabel(CampaignDto c)
    {
        var now = DateTime.UtcNow;
        if (!c.IsActive) return "Paused";
        if (now < c.StartDate) return "Scheduled";
        if (now > c.EndDate) return "Ended";
        return "Running";
    }

    private string GetStatusBadgeStyle(CampaignDto c) => GetStatusLabel(c) switch
    {
        "Running" => "success",
        "Scheduled" => "info",
        "Ended" => "secondary",
        _ => "warning"
    };

    private void ShowCreateDialog()
    {
        editModel = new CampaignEditModel
        {
            StartDate = DateTime.UtcNow.Date,
            EndDate = DateTime.UtcNow.Date.AddDays(30),
            IsActive = true
        };
        isEditing = false;
        editingId = null;
        showDialog = true;
    }

    private void EditCampaign(CampaignDto campaign)
    {
        editModel = new CampaignEditModel
        {
            Name = campaign.Name,
            Description = campaign.Description,
            StartDate = campaign.StartDate,
            EndDate = campaign.EndDate,
            IsActive = campaign.IsActive
        };
        isEditing = true;
        editingId = campaign.Id;
        showDialog = true;
    }

    private void CloseDialog() => showDialog = false;

    private async Task SaveCampaign()
    {
        if (string.IsNullOrEmpty(editModel.Name))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Name is required.");
            return;
        }

        if (editModel.StartDate == null || editModel.EndDate == null)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Start and end date are required.");
            return;
        }

        if (editModel.EndDate < editModel.StartDate)
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "End date must be on or after the start date.");
            return;
        }

        if (isEditing && editingId.HasValue)
        {
            var request = new UpdateCampaignRequest
            {
                Name = editModel.Name,
                Description = editModel.Description,
                StartDate = editModel.StartDate,
                EndDate = editModel.EndDate,
                IsActive = editModel.IsActive
            };

            var result = await ContentApi.UpdateCampaignAsync(editingId.Value, request);
            if (result != null)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Campaign updated.");
                showDialog = false;
                await LoadCampaigns();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to update campaign.");
            }
        }
        else
        {
            var request = new CreateCampaignRequest
            {
                Name = editModel.Name,
                Description = editModel.Description,
                StartDate = editModel.StartDate.Value,
                EndDate = editModel.EndDate.Value
            };

            var result = await ContentApi.CreateCampaignAsync(branchId, request);
            if (result != null)
            {
                NotificationService.Notify(ToastSeverity.Success, "Success", "Campaign created.");
                showDialog = false;
                await LoadCampaigns();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to create campaign.");
            }
        }
    }

    private void DeleteCampaign(CampaignDto campaign)
    {
        campaignToDelete = campaign;
        deleteConfirmMessage = $"Delete '{campaign.Name}'? Playlist items attached to it keep playing, just no longer as part of this campaign.";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && campaignToDelete != null)
        {
            var success = await ContentApi.DeleteCampaignAsync(campaignToDelete.Id);
            if (success)
            {
                NotificationService.Notify(ToastSeverity.Success, "Deleted", "Campaign deleted.");
                await LoadCampaigns();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to delete campaign.");
            }
        }

        campaignToDelete = null;
    }

    #region Impression stats

    private async Task ShowStats(CampaignDto campaign)
    {
        statsCampaign = campaign;
        stats = null;
        dailyChartData = new();
        statsRange = DateRange.LastDays(30);
        showStatsDialog = true;
        await LoadStats();
    }

    private void CloseStatsDialog() => showStatsDialog = false;

    private async Task OnStatsRangeChanged(DateRange range)
    {
        statsRange = range;
        await LoadStats();
    }

    private async Task LoadStats()
    {
        if (statsCampaign == null) return;

        statsLoading = true;
        await InvokeAsync(StateHasChanged);

        stats = await ContentApi.GetCampaignStatsAsync(statsCampaign.Id, statsFrom, statsTo);
        dailyChartData = stats?.Daily
            .Select(d => new DayChartPoint(d.Day.ToDateTime(TimeOnly.MinValue), d.Count))
            .ToList() ?? new();

        // The API may have swapped or capped the range (366-day max) — reflect what it actually used.
        if (stats != null)
            statsRange = new DateRange(stats.From, stats.To);

        statsLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<QBarItem> MediaBars => stats == null
        ? Array.Empty<QBarItem>()
        : stats.ByMedia.Select(m => new QBarItem(m.Title, m.Count, Count: m.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))).ToList();

    private IReadOnlyList<QBarItem> BranchBars => stats == null
        ? Array.Empty<QBarItem>()
        : stats.ByBranch.Select(b => new QBarItem(b.BranchName, b.Count, Count: b.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))).ToList();

    /// <summary>
    /// The per-impression rows only exist server-side — this page holds the rolled-up statistics,
    /// not the log the export is for.
    /// </summary>
    private async Task<(IReadOnlyList<ExportColumn<string[]>> Columns, ExportRows<string[]> Rows)> ProvideStatsExportSourceAsync()
    {
        if (statsCampaign == null)
            throw new InvalidOperationException("Open a campaign's statistics before exporting.");

        var csv = await ContentApi.ExportCampaignStatsCsvAsync(statsCampaign.Id, statsFrom, statsTo);
        if (csv == null)
            throw new InvalidOperationException("Couldn't export this campaign's impressions. Please try again.");

        return ExportCsvSource.Parse(csv);
    }

    // Mirrors the API's filename slug so the browser-side download name matches the server's.
    private static string Slugify(string name)
    {
        var sb = new System.Text.StringBuilder();
        var lastWasDash = true;
        foreach (var ch in name.ToLowerInvariant())
        {
            if (ch < 128 && char.IsLetterOrDigit(ch))
            {
                sb.Append(ch);
                lastWasDash = false;
            }
            else if (!lastWasDash)
            {
                sb.Append('-');
                lastWasDash = true;
            }
            if (sb.Length >= 40) break;
        }
        var slug = sb.ToString().Trim('-');
        return slug.Length > 0 ? slug : "campaign";
    }

    #endregion

    private class CampaignEditModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public DateTime? StartDate { get; set; } = DateTime.UtcNow.Date;
        public DateTime? EndDate { get; set; } = DateTime.UtcNow.Date.AddDays(30);
        public bool IsActive { get; set; } = true;
    }
}
