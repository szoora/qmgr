    private bool showPreviewDialog = false;
    private MediaContentDto? previewMedia;
    private NewMediaModel newMedia = new();

    // URL validation and detection
    private bool isValidatingUrl = false;
    private string? urlValidationError;
    private string? detectedPlatform;
    private string? detectedThumbnail;
    private bool showUrlPreview = false;
    private bool CanAddMedia => !string.IsNullOrWhiteSpace(newMedia.Name) &&
                                 !string.IsNullOrWhiteSpace(newMedia.FileUrl) &&
                                 urlValidationError == null;

    // Upload related fields
    private List<SelectedFile> selectedFiles = new();
    private bool isDragging = false;
    private bool isUploading = false;
    private double uploadProgress = 0;
    private string currentUploadFile = "";
    // Deliberately well under the default 100MB tenant storage quota (enforced server-side in
    // ContentController.MaxUploadSizeBytes, which this must match) so a single upload can't
    // consume most/all of it — pushes larger media toward linking an external platform
    // (YouTube, Vimeo, Google Drive, TikTok) instead. HubOptions.MaximumReceiveMessageSize in
    // Program.cs (200MB) is just the SignalR circuit's outer ceiling, unrelated to this business cap.
    private const long MaxFileSize = 25 * 1024 * 1024;

    private Guid organizationId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    private List<string> contentTypes = new() { "Image", "Video", "Audio", "Text", "Html", "Pdf" };
    private List<ContentType> contentTypeValues = Enum.GetValues<ContentType>().ToList();

    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private MediaContentDto? mediaToDelete;

    // Add to playlist state
    private bool showAddToPlaylistDialog = false;
    private bool isAddingToPlaylist = false;
    private MediaContentDto? mediaToAddToPlaylist;
    private List<PlaylistDto> availablePlaylists = new();
    private Guid selectedPlaylistId = Guid.Empty;
    private List<CampaignDto> availableCampaigns = new();
    private Guid? selectedCampaignId;

    // Edit media state
    private bool showEditMediaDialog = false;
    private bool isSavingMedia = false;
    private MediaContentDto? mediaToEdit;
    private string editMediaName = "";
    private string editMediaDescription = "";
    private string editMediaTagsInput = "";

    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;

    private IEnumerable<MediaContentDto> FilteredMedia => mediaItems
        .Where(m => string.IsNullOrEmpty(searchTerm) || m.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(m => !filterType.HasValue || m.ContentType == filterType.Value);

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.ContentView))
        {
            NavigationManager.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (!ModuleState.ActiveModuleCodes.Contains(ModuleCodes.EngagementCommunications))
        {
            NavigationManager.NavigateTo("/billing/modules", forceLoad: false);
            return;
        }

        var currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null && currentUser.OrganizationId != Guid.Empty)
        {
            organizationId = currentUser.OrganizationId;
        }

        canCreate = await PermissionService.HasPermissionAsync(Permissions.ContentCreate);
        canEdit = await PermissionService.HasPermissionAsync(Permissions.ContentEdit);
        canDelete = await PermissionService.HasPermissionAsync(Permissions.ContentDelete);

        await LoadMedia();
    }

    private async Task LoadMedia()
    {
        isLoading = true;
        mediaItems = await ContentApi.GetMediaContentsAsync(organizationId);
        isLoading = false;
    }

    private void ShowUploadDialog()
    {
        selectedFiles.Clear();
        uploadProgress = 0;
        showUploadDialog = true;
    }

    private void HandleDragEnter() => isDragging = true;
    private void HandleDragLeave() => isDragging = false;
    private void HandleDrop() => isDragging = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // Read each file's bytes into memory right here, while the InputFile element
        // that raised this event is still mounted. Once selectedFiles becomes non-empty
        // the UI swaps to the "Add More" InputFile (a different element/id) and the one
        // that produced this IBrowserFile is removed from the DOM — its JS-side file
        // reference (_blazorFilesById) goes with it, so deferring the read to when
        // "Upload" is clicked later fails with "Cannot read properties of null
        // (reading '_blazorFilesById')". Buffering now, before that swap happens,
        // avoids depending on the IBrowserFile staying valid at all.
        foreach (var file in e.GetMultipleFiles(10))
        {
            if (file.Size > MaxFileSize)
            {
                NotificationService.Notify(ToastSeverity.Warning, "File Too Large", $"{file.Name} exceeds the 25MB upload limit. Try linking it instead via Add URL (YouTube, Vimeo, Google Drive, TikTok).");
                continue;
            }

            if (selectedFiles.Any(f => f.Name == file.Name))
                continue;

            try
            {
                using var buffer = new MemoryStream();
                await using (var browserStream = file.OpenReadStream(MaxFileSize))
                {
                    await browserStream.CopyToAsync(buffer);
                }

                selectedFiles.Add(new SelectedFile
                {
                    Name = file.Name,
                    Size = file.Size,
                    ContentType = file.ContentType,
                    Data = buffer.ToArray()
                });
            }
            catch (Exception ex)
            {
                NotificationService.Notify(ToastSeverity.Error, "Read Failed", $"Failed to read {file.Name}: {ex.Message}");
            }
        }
        StateHasChanged();
    }

    private void RemoveFile(SelectedFile file)
    {
        selectedFiles.Remove(file);
    }

    private void CancelUpload()
    {
        if (!isUploading)
        {
            showUploadDialog = false;
            selectedFiles.Clear();
        }
    }

    private async Task UploadFiles()
    {
        if (!selectedFiles.Any()) return;

        isUploading = true;
        uploadProgress = 0;
        var totalFiles = selectedFiles.Count;
        var uploadedCount = 0;

        try
        {
            foreach (var file in selectedFiles.ToList())
            {
                currentUploadFile = file.Name;

                try
                {
                    // file.Data was already buffered in HandleFileSelected, while the
                    // originating InputFile element was still mounted — see the comment
                    // there. Wrapping it in a fresh MemoryStream here is fully replayable,
                    // so it's also safe against HttpClient re-reading the request content
                    // on retry/redirect.
                    using var buffer = new MemoryStream(file.Data);

                    var result = await ContentApi.UploadMediaContentAsync(
                        organizationId, buffer, file.Name, file.ContentType, Path.GetFileNameWithoutExtension(file.Name));

                    if (result == null)
                        throw new InvalidOperationException("Upload failed.");

                    uploadedCount++;
                }
                catch (Exception ex)
                {
                    NotificationService.Notify(ToastSeverity.Error, "Upload Failed", $"Failed to upload {file.Name}: {ex.Message}");
                }

                uploadProgress = (uploadedCount / (double)totalFiles) * 100;
                StateHasChanged();
            }

            if (uploadedCount > 0)
            {
                NotificationService.Notify(ToastSeverity.Success, "Upload Complete", $"Successfully uploaded {uploadedCount} file(s).");
                showUploadDialog = false;
                selectedFiles.Clear();
                await LoadMedia();
            }
        }
        finally
        {
            isUploading = false;
            uploadProgress = 0;
        }
    }


    private string GetFileIcon(string mimeType)
    {
