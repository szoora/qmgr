@page "/content/media"
@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject IContentApiService ContentApi
@inject IToastService NotificationService
@inject NavigationManager NavigationManager
@inject IPermissionService PermissionService
@inject IAuthService AuthService
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Domain.Constants

<PageTitle>Media Library - Q-Mgr</PageTitle>

<div class="page-header">
    <h1>Media Library</h1>
    <div class="breadcrumb">
        <QBreadcrumb Items="@(new List<QBreadcrumbItem> { new("Digital Signage", "/content/media"), new("Media Library") })" />
    </div>
</div>

<div class="media-library-page">
    <!-- Toolbar -->
    <QCard Class="toolbar-card">
        <div class="toolbar">
            <div class="toolbar-left">
                <QInput TValue="string" @bind-Value="@searchTerm" Placeholder="Search media..." IconLeft="search" />
                <QSelect TValue="ContentType?" TItem="ContentType" @bind-Value="@filterType" Items="@contentTypeValues"
                         ValueSelector="@(c => (ContentType?)c)" TextSelector="@(c => c.ToString())" Placeholder="All Types" AllowClear="true" />
            </div>
            <div class="toolbar-right">
                @if (canCreate)
                {
                    <!-- Add URL is the primary/default action: linking existing content on YouTube,
                         Vimeo, Google Drive, TikTok, Spotify, or SoundCloud doesn't use any of this
                         platform's own storage. Upload Media remains available (capped per-file and
                         subject to the org's storage quota) for content with nowhere else to live. -->
                    <QButton Text="Add URL" Icon="link-45deg" Variant="primary" OnClick="@ShowAddUrlDialog" />
                    <QButton Text="Upload Media" Icon="cloud-upload-fill" Variant="secondary" OnClick="@ShowUploadDialog" />
                }
            </div>
        </div>
    </QCard>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading media library...</span>
        </div>
    }
    else if (!mediaItems.Any())
    {
        <div class="empty-state">
            <QIcon Name="images" />
            <h3>No Media Found</h3>
            <p>Link a video from YouTube, Vimeo, Google Drive, or TikTok, or upload a file directly.</p>
            @if (canCreate)
            {
                <div class="empty-state-actions">
                    <QButton Text="Add URL" Icon="link-45deg" Variant="primary" OnClick="@ShowAddUrlDialog" />
                    <QButton Text="Upload Media" Icon="cloud-upload" Variant="secondary" OnClick="@ShowUploadDialog" />
                </div>
            }
        </div>
    }
    else
    {
        <!-- Media Grid -->
        <div class="media-grid">
            @foreach (var media in FilteredMedia)
            {
                <div class="media-card" @onclick="@(() => SelectMedia(media))">
                    <div class="media-preview">
                        @if (!string.IsNullOrEmpty(media.ThumbnailUrl))
                        {
                            <img src="@media.ThumbnailUrl" alt="@media.Name" />
                        }
                        else
                        {
                            <div class="media-icon">
                                <QIcon Name="@GetMediaIconBootstrap(media.ContentType)" />
                            </div>
                        }
                        <div class="media-type-badge">@GetMediaSourceBadge(media)</div>
                        <div class="play-overlay">
                            <QIcon Name="@GetPlayIconBootstrap(media.ContentType)" />
                        </div>
                    </div>
                    <div class="media-info">
                        <h4>@media.Name</h4>
                        <p>@FormatFileSize(media.FileSizeBytes)</p>
                        @if (media.DurationSeconds.HasValue)
                        {
                            <span class="duration">@FormatDuration(media.DurationSeconds.Value)</span>
                        }
                    </div>
                    <div class="media-actions">
                        @if (canEdit)
                        {
                            <QButton Icon="pencil-fill" Size="sm" Variant="secondary" OnClick="@(async () => await EditMedia(media))" StopPropagation="true" />
                        }
                        @if (canDelete)
                        {
                            <QButton Icon="trash-fill" Size="sm" Variant="danger" OnClick="@(() => DeleteMedia(media))" StopPropagation="true" />
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Upload Dialog -->
<QModal @bind-Visible="showUploadDialog" Title="Upload Media" Size="md">
    <ChildContent>
        <div class="upload-area @(isDragging ? "dragging" : "") @(selectedFiles.Any() ? "has-files" : "")"
             @ondragenter="HandleDragEnter"
             @ondragleave="HandleDragLeave"
             @ondragover:preventDefault="true"
             @ondrop="HandleDrop">

            @if (!selectedFiles.Any())
            {
                <div class="upload-prompt">
                    <QIcon Name="cloud-upload" />
                    <p>Drag & drop files here or</p>
                    <!-- Positioned to cover the whole drop zone (see .file-input CSS) so
                         the browser's native drag-and-drop-onto-file-input behavior does
                         the actual file reading — HandleDrop above only resets the
                         "isDragging" highlight, it never reads dropped files itself,
                         since Blazor's DragEventArgs doesn't expose DataTransfer.files. -->
                    <InputFile OnChange="HandleFileSelected" multiple accept="image/*,video/*,audio/*,.pdf" class="file-input" id="fileInput" />
                    <label for="fileInput" class="browse-btn">Browse Files</label>
                    <span class="file-types">Images, Videos, Audio, PDF (Max 25MB each — link larger files via Add URL instead)</span>
                </div>
            }
            else
            {
                <div class="selected-files">
                    @foreach (var file in selectedFiles)
                    {
                        <div class="file-item">
                            <QIcon Name="@GetFileIconBootstrap(file.ContentType)" />
                            <div class="file-details">
                                <span class="file-name">@file.Name</span>
                                <span class="file-size">@FormatFileSize(file.Size)</span>
                            </div>
                            <QButton Icon="x-lg" Size="sm" Variant="ghost" OnClick="@(() => RemoveFile(file))" />
                        </div>
                    }
                    <div class="add-more">
                        <InputFile OnChange="HandleFileSelected" multiple accept="image/*,video/*,audio/*,.pdf" class="file-input" id="fileInputMore" />
                        <label for="fileInputMore" class="add-more-btn">
                            <QIcon Name="plus-lg" /> Add More
                        </label>
                    </div>
                </div>
            }
        </div>

        @if (isUploading)
        {
            <div class="upload-progress">
                <div class="progress" role="progressbar" aria-valuenow="@uploadProgress" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(uploadProgress)%">@uploadProgress%</div>
                </div>
                <span>Uploading @currentUploadFile...</span>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@CancelUpload" Disabled="@isUploading" />
        <QButton Text="@GetUploadButtonText()"
                  Icon="cloud-upload-fill"
                  Variant="primary"
                  OnClick="@UploadFiles"
                  Disabled="@(!selectedFiles.Any() || isUploading)" />
    </FooterContent>
</QModal>

<!-- Preview Dialog -->
<QModal @bind-Visible="showPreviewDialog" Title="@(previewMedia?.Name ?? "Preview")" Size="md">
    <ChildContent>
        @if (previewMedia != null)
        {
            <div class="preview-body">
                <QMgr.Web.Components.Shared.MediaPlayer
                    Url="@previewMedia.FileUrl"
                    Title="@previewMedia.Name"
                    ContentType="@previewMedia.ContentType"
                    AutoPlay="true" />
            </div>
            <div class="media-details">
                <span class="detail-item">
                    <QIcon Name="grid" />
                    @previewMedia.ContentType
                </span>
                @if (previewMedia.FileSizeBytes.HasValue)
                {
                    <span class="detail-item">
                        <QIcon Name="rulers" />
                        @FormatFileSize(previewMedia.FileSizeBytes)
                    </span>
                }
                @if (previewMedia.DurationSeconds.HasValue)
                {
                    <span class="detail-item">
                        <QIcon Name="clock" />
                        @FormatDuration(previewMedia.DurationSeconds.Value)
                    </span>
                }
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (previewMedia != null)
        {
            <QButton Text="Open in New Tab" Icon="box-arrow-up-right" Variant="secondary"
                      OnClick="@(() => OpenInNewTab(previewMedia.FileUrl))" />
            @if (canEdit)
            {
                <QButton Text="Add to Playlist" Icon="plus-circle-fill" Variant="primary"
                          OnClick="@(() => AddToPlaylist(previewMedia))" />
            }
        }
    </FooterContent>
</QModal>

<!-- Add to Playlist Dialog -->
<QModal @bind-Visible="showAddToPlaylistDialog" Title="Add to Playlist" Size="sm">
    <ChildContent>
        @if (mediaToAddToPlaylist != null)
        {
            <p class="qm-admin-form-hint">Add "@mediaToAddToPlaylist.Name" to:</p>

            @if (!availablePlaylists.Any())
            {
                <div class="qm-admin-alert info">
                    <QIcon Name="info-circle-fill" />
                    <p>No playlists yet. Create one on the Playlists page first.</p>
                </div>
            }
            else
            {
                <QSelect TValue="Guid" TItem="PlaylistDto" @bind-Value="selectedPlaylistId" Items="@availablePlaylists"
                         TextSelector="@(p => p.Name)" ValueSelector="@(p => p.Id)" />

                @if (availableCampaigns.Any())
                {
                    <div class="form-group" style="margin-top: 12px;">
                        <QSelect TValue="Guid?" TItem="CampaignDto" @bind-Value="selectedCampaignId" Items="@availableCampaigns"
                                 ValueSelector="@(c => (Guid?)c.Id)" TextSelector="@(c => c.Name)"
                                 AllowClear="true" Label="Attach to Campaign (optional)" Placeholder="No campaign" />
                    </div>
                }
            }
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@(() => showAddToPlaylistDialog = false)" Disabled="@isAddingToPlaylist" />
        @if (availablePlaylists.Any())
        {
            <QButton Text="@(isAddingToPlaylist ? "Adding..." : "Add")" Icon="plus-circle-fill" Variant="primary"
                      OnClick="@ConfirmAddToPlaylist" Disabled="@(isAddingToPlaylist || selectedPlaylistId == Guid.Empty)" />
        }
    </FooterContent>
</QModal>

<!-- Edit Media Dialog -->
<QModal @bind-Visible="showEditMediaDialog" Title="Edit Media" Size="sm">
    <ChildContent>
        @if (mediaToEdit != null)
        {
            <div class="form-group">
                <QInput TValue="string" @bind-Value="editMediaName" Label="Name" />
            </div>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="editMediaDescription" Label="Description" />
            </div>
            <div class="form-group">
                <QInput TValue="string" @bind-Value="editMediaTagsInput" Label="Tags" Placeholder="Comma-separated, e.g. promo, lobby, summer" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@(() => showEditMediaDialog = false)" Disabled="@isSavingMedia" />
        <QButton Text="@(isSavingMedia ? "Saving..." : "Save")" Icon="check-circle-fill" Variant="primary"
                  OnClick="@ConfirmEditMedia" Disabled="@(isSavingMedia || string.IsNullOrWhiteSpace(editMediaName))" />
    </FooterContent>
</QModal>

<!-- Add URL Dialog -->
@if (showAddUrlDialog)
{
    <div class="dialog-overlay" @onclick="@(() => showAddUrlDialog = false)">
        <div class="dialog-content add-url-dialog" @onclick:stopPropagation="true">
            <div class="dialog-header">
                <h3><i class="bi bi-link-45deg"></i> Add Online Content</h3>
                <button class="close-btn" @onclick="@(() => showAddUrlDialog = false)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="form-group">
                <label class="form-label">URL <span class="required">*</span></label>
                <div class="url-input-wrapper">
                    <input type="url" class="form-control @(urlValidationError != null ? "is-invalid" : "")"
                           @bind="newMedia.FileUrl"
                           @bind:event="oninput"
                           @onblur="ValidateAndDetectUrl"
                           placeholder="Paste YouTube, Vimeo, TikTok, or direct media URL..." />
                    @if (isValidatingUrl)
                    {
                        <div class="url-spinner">
                            <span class="spinner-border spinner-border-sm"></span>
                        </div>
                    }
                    else if (detectedPlatform != null)
                    {
                        <div class="platform-badge @detectedPlatform.ToLower()">
                            <i class="bi @GetPlatformIcon(detectedPlatform)"></i>
                            @detectedPlatform
                        </div>
                    }
                </div>
                @if (urlValidationError != null)
                {
                    <div class="invalid-feedback d-block">@urlValidationError</div>
                }
            </div>

            @if (showUrlPreview && !string.IsNullOrEmpty(newMedia.FileUrl))
            {
                <div class="url-preview">
                    <div class="preview-header">
                        <span>Preview</span>
                        <button class="btn-sm" @onclick="() => showUrlPreview = false">
                            <i class="bi bi-eye-slash"></i>
                        </button>
                    </div>
                    <div class="preview-content">
                        @if (detectedPlatform == "YouTube" && !string.IsNullOrEmpty(detectedThumbnail))
                        {
                            <img src="@detectedThumbnail" alt="Video thumbnail" />
                            <div class="play-icon"><i class="bi bi-play-circle-fill"></i></div>
                        }
                        else if (detectedPlatform == "Vimeo" && !string.IsNullOrEmpty(detectedThumbnail))
                        {
                            <img src="@detectedThumbnail" alt="Video thumbnail" />
                            <div class="play-icon"><i class="bi bi-play-circle-fill"></i></div>
                        }
                        else if (newMedia.ContentType == ContentType.Image)
                        {
                            <img src="@newMedia.FileUrl" alt="Image preview" @onerror="HandlePreviewError" />
                        }
                        else
                        {
                            <div class="preview-placeholder">
                                <i class="bi @GetContentTypeIcon(newMedia.ContentType)"></i>
                                <span>@newMedia.ContentType content</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="form-row">
                <div class="form-group flex-grow-1">
                    <label class="form-label">Name <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="newMedia.Name" placeholder="Enter display name" />
                </div>
                <div class="form-group" style="width: 140px;">
                    <label class="form-label">Type</label>
                    <select class="form-select" @bind="newMedia.ContentType">
                        @foreach (var type in contentTypeValues)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Description <span class="optional">(optional)</span></label>
                <textarea class="form-control" @bind="newMedia.Description" rows="2" placeholder="Add notes about this content..."></textarea>
            </div>

            <div class="supported-platforms">
                <span class="label">Supported:</span>
                <span class="platform"><i class="bi bi-youtube"></i> YouTube</span>
                <span class="platform"><i class="bi bi-vimeo"></i> Vimeo</span>
                <span class="platform"><i class="bi bi-tiktok"></i> TikTok</span>
                <span class="platform"><i class="bi bi-google"></i> Google Drive</span>
                <span class="platform"><i class="bi bi-spotify"></i> Spotify</span>
                <span class="platform"><i class="bi bi-soundwave"></i> SoundCloud</span>
                <span class="platform"><i class="bi bi-link-45deg"></i> Direct URLs</span>
            </div>

            <div class="dialog-actions">
                <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@(() => showAddUrlDialog = false)" />
                <QButton Text="Add to Library" Icon="plus-lg" Variant="primary" Disabled="@(!CanAddMedia)" OnClick="AddMediaFromUrl" />
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Dialog -->
<ConfirmDialog
    IsVisible="@showDeleteConfirm"
    Title="Delete Media"
    Message="@deleteConfirmMessage"
    ConfirmText="Delete"
    CancelText="Cancel"
    ConfirmButtonClass="btn-danger"
    OnClose="@HandleDeleteConfirm" />

<style>
    .media-library-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .toolbar-card {
        padding: 16px 24px;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .toolbar-left, .toolbar-right {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        gap: 16px;
        color: var(--qm-text-secondary);
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        text-align: center;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
    }

    .empty-state .rzi {
        font-size: 64px;
        color: var(--qm-text-muted);
        margin-bottom: 16px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: var(--qm-text-primary);
    }

    .empty-state p {
        margin: 0 0 24px;
        color: var(--qm-text-secondary);
    }

    .empty-state-actions {
        display: flex;
        gap: 12px;
    }

    .media-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }

    .media-card {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .media-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .media-preview {
        position: relative;
        height: 140px;
        background: var(--qm-bg-card-hover);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .media-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .media-icon .rzi {
        font-size: 48px;
        color: var(--qm-text-muted);
    }

    /* Overlay badge on top of an arbitrary thumbnail image - stays a dark
       translucent scrim regardless of theme so it stays legible over any image. */
    .media-type-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 4px 8px;
        background: rgba(0,0,0,0.6);
        color: var(--qm-text-on-primary);
        border-radius: var(--qm-radius-sm);
        font-size: 11px;
        text-transform: uppercase;
    }

    .media-info {
        padding: 12px 16px;
    }

    .media-info h4 {
        margin: 0 0 4px;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .media-info p {
        margin: 0;
        font-size: 12px;
        color: var(--qm-text-secondary);
    }

    .media-info .duration {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 6px;
        background: var(--qm-bg-card-hover);
        border-radius: var(--qm-radius-sm);
        font-size: 11px;
    }

    .media-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 8px 12px;
        border-top: 1px solid var(--qm-bg-card-hover);
    }

    /* Modal backdrop scrim - conventionally stays a dark overlay in both
       light and dark mode, not theme-dependent. */
    .dialog-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .dialog-content {
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-xl);
        padding: 24px;
        width: 90%;
        max-width: 500px;
    }

    .dialog-content h3 {
        margin: 0 0 20px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-group .rz-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 500;
    }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 24px;
    }

    /* Upload Dialog Styles */
    .upload-dialog {
        max-width: 600px;
    }

    .upload-area {
        position: relative;
        border: 2px dashed var(--qm-border);
        border-radius: var(--qm-radius-xl);
        padding: 40px 20px;
        text-align: center;
        transition: all 0.3s ease;
        background: var(--qm-bg-elevated);
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .upload-area.dragging {
        border-color: var(--qm-primary);
        background: var(--qm-primary-light);
    }

    .upload-area.has-files {
        padding: 20px;
        align-items: flex-start;
    }

    .upload-prompt {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .upload-prompt .rzi {
        font-size: 64px;
        color: var(--qm-primary);
        opacity: 0.7;
    }

    .upload-prompt p {
        margin: 0;
        color: var(--qm-text-secondary);
    }

    /* Covers the whole .upload-area invisibly (rather than display:none) so
       it's the actual native drop target for drag-and-drop — a display:none
       input can never receive a drop event. The visible "Browse Files"
       label still works via its `for` attribute regardless. */
    .file-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 1;
    }

    /* Keep the "Add More" input's compact inline behavior — it isn't the
       primary drop target, only the initial empty-state one is. */
    .add-more .file-input {
        position: static;
        width: auto;
        height: auto;
        display: none;
    }

    .browse-btn {
        padding: 12px 28px;
        background: var(--qm-gradient-primary);
        color: var(--qm-text-on-primary);
        border-radius: var(--qm-radius-lg);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .browse-btn:hover {
        box-shadow: var(--qm-shadow-neon);
        transform: translateY(-2px);
    }

    .file-types {
        font-size: 12px;
        color: var(--qm-text-muted);
        margin-top: 8px;
    }

    .selected-files {
        width: 100%;
    }

    .file-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: var(--qm-bg-card);
        border-radius: var(--qm-radius-lg);
        margin-bottom: 10px;
        border: 1px solid var(--qm-border);
    }

    .file-item .rzi {
        font-size: 28px;
        color: var(--qm-primary);
    }

    .file-details {
        flex: 1;
        text-align: left;
    }

    .file-name {
        display: block;
        font-weight: 500;
        color: var(--qm-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 280px;
    }

    .file-size {
        display: block;
        font-size: 12px;
        color: var(--qm-text-muted);
    }

    .add-more {
        text-align: center;
        margin-top: 12px;
    }

    .add-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        background: var(--qm-bg-card);
        border: 1px dashed var(--qm-border);
        border-radius: var(--qm-radius-lg);
        color: var(--qm-text-secondary);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .add-more-btn:hover {
        border-color: var(--qm-primary);
        color: var(--qm-primary);
    }

    .upload-progress {
        margin-top: 16px;
