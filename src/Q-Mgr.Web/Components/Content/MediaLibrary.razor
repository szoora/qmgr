    private async Task ValidateAndDetectUrl()
    {
        var url = newMedia.FileUrl?.Trim();

        if (string.IsNullOrEmpty(url))
        {
            urlValidationError = null;
            detectedPlatform = null;
            detectedThumbnail = null;
            showUrlPreview = false;
            return;
        }

        // Basic URL validation
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) ||
            (uri.Scheme != "http" && uri.Scheme != "https"))
        {
            urlValidationError = "Please enter a valid URL starting with http:// or https://";
            detectedPlatform = null;
            detectedThumbnail = null;
            showUrlPreview = false;
            return;
        }

        urlValidationError = null;
        isValidatingUrl = true;
        StateHasChanged();

        try
        {
            // Detect platform and fetch metadata
            var urlLower = url.ToLower();

            if (urlLower.Contains("youtube.com") || urlLower.Contains("youtu.be"))
            {
                detectedPlatform = "YouTube";
                newMedia.ContentType = ContentType.Video;
                detectedThumbnail = GetYouTubeThumbnail(url);
                showUrlPreview = true;

                // Auto-generate name from video ID (or channel ID, for a channel's
                // "currently live" link, which has no fixed video ID) if empty
                if (string.IsNullOrEmpty(newMedia.Name))
                {
                    var channelId = ExtractYouTubeLiveChannelId(url);
                    newMedia.Name = !string.IsNullOrEmpty(channelId)
                        ? $"YouTube Live (channel {channelId})"
                        : $"YouTube Video ({ExtractYouTubeVideoId(url)})";
                }
            }
            else if (urlLower.Contains("vimeo.com"))
            {
                detectedPlatform = "Vimeo";
                newMedia.ContentType = ContentType.Video;
                showUrlPreview = true;

                var videoId = ExtractVimeoVideoId(url);
                if (string.IsNullOrEmpty(newMedia.Name))
                    newMedia.Name = $"Vimeo Video ({videoId})";

                // Vimeo thumbnails require API call - use placeholder
                detectedThumbnail = null;
            }
            else if (urlLower.Contains("tiktok.com"))
            {
                detectedPlatform = "TikTok";
                newMedia.ContentType = ContentType.Video;
                showUrlPreview = true;

                var videoId = ExtractTikTokVideoId(url);
                if (string.IsNullOrEmpty(newMedia.Name))
                    newMedia.Name = !string.IsNullOrEmpty(videoId) ? $"TikTok Video ({videoId})" : "TikTok Video";

                // TikTok thumbnails require the oEmbed API - use placeholder
                detectedThumbnail = null;
            }
            else if (urlLower.Contains("drive.google.com") || urlLower.Contains("docs.google.com"))
            {
                detectedPlatform = "Google";
                if (urlLower.Contains("presentation"))
                    newMedia.ContentType = ContentType.PowerPoint;
                else
                    newMedia.ContentType = ContentType.Video;
                showUrlPreview = true;
            }
            else if (urlLower.Contains("spotify.com"))
            {
                detectedPlatform = "Spotify";
                newMedia.ContentType = ContentType.Audio;
                showUrlPreview = true;
            }
            else if (urlLower.Contains("soundcloud.com"))
            {
                detectedPlatform = "SoundCloud";
                newMedia.ContentType = ContentType.Audio;
                showUrlPreview = true;
            }
            else
            {
                // Direct URL - detect by extension
                detectedPlatform = "Direct";
                var ext = GetUrlExtension(url);

                if (new[] { ".mp4", ".webm", ".ogg", ".mov", ".avi", ".mkv" }.Contains(ext))
                {
                    newMedia.ContentType = ContentType.Video;
                    showUrlPreview = true;
                }
                else if (new[] { ".mp3", ".wav", ".ogg", ".aac", ".flac", ".m4a" }.Contains(ext))
                {
                    newMedia.ContentType = ContentType.Audio;
                    showUrlPreview = true;
                }
                else if (new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".bmp" }.Contains(ext))
                {
                    newMedia.ContentType = ContentType.Image;
                    showUrlPreview = true;
                }
                else if (ext == ".pdf")
                {
                    newMedia.ContentType = ContentType.Pdf;
                    showUrlPreview = true;
                }
                else if (new[] { ".ppt", ".pptx", ".odp" }.Contains(ext))
                {
                    newMedia.ContentType = ContentType.PowerPoint;
                    showUrlPreview = true;
                }

                // Auto-generate name from filename if empty
                if (string.IsNullOrEmpty(newMedia.Name))
                {
                    var filename = Path.GetFileNameWithoutExtension(uri.LocalPath);
                    if (!string.IsNullOrEmpty(filename))
                        newMedia.Name = filename;
                }
            }
        }
        finally
        {
            isValidatingUrl = false;
            StateHasChanged();
        }
    }

    private string? GetYouTubeThumbnail(string url)
    {
        var videoId = ExtractYouTubeVideoId(url);
        if (!string.IsNullOrEmpty(videoId))
        {
            // Try high quality first, then medium
            return $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";
        }
        return null;
    }

    private string ExtractYouTubeVideoId(string url)
    {
        // Handle youtu.be/VIDEO_ID format
        if (url.Contains("youtu.be/"))
        {
            var start = url.IndexOf("youtu.be/") + 9;
            var end = url.IndexOf('?', start);
            return end > 0 ? url.Substring(start, end - start) : url.Substring(start);
        }

        // Handle youtube.com/live/VIDEO_ID format (YouTube's live-event permalink)
        if (url.Contains("/live/"))
        {
            var start = url.IndexOf("/live/") + 6;
            var end = url.IndexOfAny(new[] { '?', '/' }, start);
            return end > 0 ? url.Substring(start, end - start) : url.Substring(start);
        }

        // Handle youtube.com/watch?v=VIDEO_ID format
        if (url.Contains("v="))
        {
            var start = url.IndexOf("v=") + 2;
            var end = url.IndexOf('&', start);
            return end > 0 ? url.Substring(start, end - start) : url.Substring(start);
        }

        // Handle youtube.com/embed/VIDEO_ID format
        if (url.Contains("/embed/"))
        {
            var start = url.IndexOf("/embed/") + 7;
            var end = url.IndexOf('?', start);
            return end > 0 ? url.Substring(start, end - start) : url.Substring(start);
        }

        return "";
    }

    private string ExtractYouTubeLiveChannelId(string url)
    {
        // youtube.com/channel/UCxxxxxxxx/live — a channel's "currently live" link,
        // no fixed video ID. Matches the same helper in MediaPlayer.razor, which is
        // what actually resolves this into a playable embed via YouTube's dedicated
        // live_stream embed target.
        const string marker = "/channel/";
        var idx = url.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (idx < 0 || !url.TrimEnd('/').EndsWith("/live", StringComparison.OrdinalIgnoreCase))
            return "";

        var start = idx + marker.Length;
        var end = url.IndexOfAny(new[] { '?', '/' }, start);
        return end > 0 ? url.Substring(start, end - start) : url.Substring(start);
    }

    private string ExtractVimeoVideoId(string url)
    {
        var match = System.Text.RegularExpressions.Regex.Match(url, @"vimeo\.com/(\d+)");
        return match.Success ? match.Groups[1].Value : "";
    }

    private string ExtractTikTokVideoId(string url)
    {
        // tiktok.com/@username/video/VIDEO_ID — matches the same helper in MediaPlayer.razor.
        // Short vm.tiktok.com/xxxxx redirect links aren't resolvable client-side.
        var match = System.Text.RegularExpressions.Regex.Match(url, @"/video/(\d+)");
        return match.Success ? match.Groups[1].Value : "";
    }

    private string GetUrlExtension(string url)
    {
        try
        {
            var uri = new Uri(url);
            var path = uri.AbsolutePath;
            var lastDot = path.LastIndexOf('.');
            if (lastDot > 0)
                return path.Substring(lastDot).ToLower();
        }
        catch { }
        return "";
    }

