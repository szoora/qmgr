    private async Task AddMediaFromUrl()
    {
        if (string.IsNullOrEmpty(newMedia.Name) || string.IsNullOrEmpty(newMedia.FileUrl))
        {
            NotificationService.Notify(ToastSeverity.Warning, "Validation", "Name and URL are required.");
            return;
        }

        // Determine thumbnail URL
        string? thumbnailUrl = null;
        if (newMedia.ContentType == ContentType.Image)
        {
            thumbnailUrl = newMedia.FileUrl;
        }
        else if (!string.IsNullOrEmpty(detectedThumbnail))
        {
            thumbnailUrl = detectedThumbnail;
        }

        var request = new CreateMediaContentRequest
        {
            Name = newMedia.Name,
            Description = newMedia.Description,
            ContentType = newMedia.ContentType,
            StorageType = StorageType.Url,
            FileUrl = newMedia.FileUrl,
            ThumbnailUrl = thumbnailUrl
        };

        var result = await ContentApi.CreateMediaContentAsync(organizationId, request);
        if (result != null)
        {
            var platformText = detectedPlatform != null ? $" from {detectedPlatform}" : "";
            NotificationService.Notify(ToastSeverity.Success, "Success", $"Media added{platformText} successfully.");
            showAddUrlDialog = false;

            // Reset detection state
            detectedPlatform = null;
            detectedThumbnail = null;
            showUrlPreview = false;

            await LoadMedia();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to add media.");
        }
    }

