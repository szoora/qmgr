    private async Task AddToPlaylist(MediaContentDto media)
    {
        mediaToAddToPlaylist = media;
        showPreviewDialog = false;
        availablePlaylists = await ContentApi.GetPlaylistsAsync(organizationId);
        selectedPlaylistId = availablePlaylists.FirstOrDefault()?.Id ?? Guid.Empty;
        availableCampaigns = await ContentApi.GetCampaignsAsync(organizationId);
        selectedCampaignId = null;
        showAddToPlaylistDialog = true;
    }

    private async Task ConfirmAddToPlaylist()
    {
        if (mediaToAddToPlaylist == null || selectedPlaylistId == Guid.Empty)
            return;

        isAddingToPlaylist = true;
        try
        {
            var result = await ContentApi.AddPlaylistItemAsync(selectedPlaylistId, new AddPlaylistItemRequest
            {
                MediaContentId = mediaToAddToPlaylist.Id,
                CampaignId = selectedCampaignId
            });

            if (result != null)
            {
                var playlistName = availablePlaylists.FirstOrDefault(p => p.Id == selectedPlaylistId)?.Name ?? "playlist";
                NotificationService.Notify(ToastSeverity.Success, "Added", $"{mediaToAddToPlaylist.Name} added to {playlistName}.");
                showAddToPlaylistDialog = false;
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to add media to playlist.");
            }
        }
        finally
        {
            isAddingToPlaylist = false;
        }
    }

    private Task EditMedia(MediaContentDto media)
    {
        mediaToEdit = media;
        editMediaName = media.Name;
        editMediaDescription = media.Description ?? "";
        editMediaTagsInput = media.Tags != null ? string.Join(", ", media.Tags) : "";
        showEditMediaDialog = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmEditMedia()
    {
        if (mediaToEdit == null || string.IsNullOrWhiteSpace(editMediaName))
            return;

        isSavingMedia = true;
        try
        {
            var tags = editMediaTagsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToArray();

            var result = await ContentApi.UpdateMediaContentAsync(mediaToEdit.Id, new UpdateMediaContentRequest
            {
                Name = editMediaName,
                Description = string.IsNullOrWhiteSpace(editMediaDescription) ? null : editMediaDescription,
                Tags = tags.Length > 0 ? tags : null
            });

            if (result != null)
            {
                NotificationService.Notify(ToastSeverity.Success, "Saved", $"{result.Name} updated.");
                showEditMediaDialog = false;
                await LoadMedia();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to update media.");
            }
        }
        finally
        {
            isSavingMedia = false;
        }
    }

    private void DeleteMedia(MediaContentDto media)
    {
        mediaToDelete = media;
        deleteConfirmMessage = $"Delete '{media.Name}'?";
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteConfirm(bool confirmed)
    {
        showDeleteConfirm = false;

        if (confirmed && mediaToDelete != null)
        {
            var success = await ContentApi.DeleteMediaContentAsync(mediaToDelete.Id);
            if (success)
            {
                NotificationService.Notify(ToastSeverity.Success, "Deleted", "Media deleted successfully.");
                await LoadMedia();
            }
            else
            {
                NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to delete media.");
            }
        }

        mediaToDelete = null;
    }

