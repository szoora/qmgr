@using QMgr.Application.DTOs
@using QMgr.Domain.Enums
@using QMgr.Web.Services
@inject IContentApiService ContentApi
@inject IToastService NotificationService
@inject IPermissionService PermissionService
@inject NavigationManager NavigationManager
@inherits BranchAwareComponentBase
@inject IModuleApiService ModuleApi
@inject IModuleStateService ModuleState
@using QMgr.Domain.Constants


<div class="schedules-page">
    <QPageActions Embedded="@Embedded">
        <Actions>
            <QButton Text="Refresh" Icon="arrow-clockwise" Variant="secondary" OnClick="@LoadPlaylists" />
        </Actions>
    </QPageActions>

    <QFilterBar>
        <QInput TValue="string" @bind-Value="@searchTerm" Placeholder="Search playlists..." IconLeft="search" />
        <QSelect TValue="string" TItem="string" @bind-Value="@filterScheduleType" Items="@scheduleTypeOptions" Placeholder="All Schedule Types" AllowClear="true" />
    </QFilterBar>

    @if (isLoading)
    {
        <div class="loading-container">
            <QSpinner Size="lg" />
            <span>Loading schedules...</span>
        </div>
    }
    else if (!playlists.Any())
    {
        <div class="empty-state">
            <QIcon Name="clock-fill" />
            <h3>No Playlists Found</h3>
            <p>Create playlists first to configure their schedules.</p>
            <QButton Text="Go to Playlists" Icon="collection-play-fill" Variant="primary" OnClick="@GoToPlaylists" />
        </div>
    }
    else
    {
        <!-- Schedule Cards -->
        <div class="schedules-grid">
            @foreach (var playlist in PagedPlaylists)
            {
                <QCard Class="schedule-card">
                    <div class="schedule-header">
                        <div class="playlist-info">
                            <QIcon Name="collection-play-fill" />
                            <div>
                                <h3>@playlist.Name</h3>
                                <p>@(playlist.Description ?? "No description")</p>
                            </div>
                        </div>
                        <QBadge Variant="@GetScheduleBadgeStyle(playlist.ScheduleType)" Text="@GetScheduleTypeLabel(playlist.ScheduleType)" />
                    </div>

                    <div class="schedule-details">
                        @if (playlist.ScheduleType == "always")
                        {
                            <div class="schedule-info always">
                                <QIcon Name="infinity" />
                                <span>Plays continuously - no schedule restrictions</span>
                            </div>
                        }
                        else if (playlist.ScheduleType == "scheduled")
                        {
                            <div class="schedule-info scheduled">
                                <QIcon Name="clock-fill" />
                                @if (!string.IsNullOrEmpty(playlist.Schedule))
                                {
                                    <span>@FormatSchedule(playlist.Schedule)</span>
                                }
                                else
                                {
                                    <span class="not-configured">Schedule not configured</span>
                                }
                            </div>
                        }
                        else if (playlist.ScheduleType == "conditional")
                        {
                            <div class="schedule-info conditional">
                                <QIcon Name="list-check" />
                                @if (!string.IsNullOrEmpty(playlist.Schedule))
                                {
                                    <span>@FormatSchedule(playlist.Schedule)</span>
                                }
                                else
                                {
                                    <span class="not-configured">Conditions not configured</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="schedule-meta">
                        <span class="meta-item">
                            <QIcon Name="images" />
                            @playlist.ItemCount items
                        </span>
                        <span class="meta-item">
                            <QIcon Name="stopwatch-fill" />
                            @playlist.DefaultDurationSeconds sec/item
                        </span>
                        @if (playlist.Loop)
                        {
                            <span class="meta-item">
                                <QIcon Name="arrow-repeat" />
                                Loop
                            </span>
                        }
                    </div>

                    <div class="schedule-actions">
                        @if (canEdit)
                        {
                            <QButton Text="Configure Schedule" Icon="calendar-event-fill" Size="sm" Variant="primary" OnClick="@(() => ShowScheduleDialog(playlist))" />
                        }
                    </div>
                </QCard>
            }
        </div>
        <QPager Count="@(FilteredPlaylists.Count())" PageSize="@PageSize" PageIndex="@pageIndex" PageIndexChanged="@(i => pageIndex = i)" ItemLabel="playlists" />

        <!-- Weekly overview on the shared week grid (duty rota plan §9, Phase 6): the same scrolling, keyboard and
             phone list as the timetable and the rota, and two playlists over the same hours shown as an overlap. -->
        <QCard Class="timeline-card">
            <h3>Weekly Schedule Overview</h3>
            <QWeekGrid TItem="ScheduleSlot" Columns="@WeekColumns" Rows="@WeekRows" Items="@WeekItems"
                       RowKey="@(x => x.Band)" ColumnKey="@(x => x.Day)" CellState="@OverlapState" CellTitle="@OverlapTitle"
                       AriaLabel="Weekly schedule overview" CornerLabel="Time" EmptyDayText="Nothing scheduled." MaxHeight="520px">
                <CellTemplate Context="cell">
                    @foreach (var slot in cell.Items)
                    {
                        <span class="sched-chip" title="@slot.Playlist.Name">@slot.Playlist.Name</span>
                    }
                </CellTemplate>
            </QWeekGrid>
        </QCard>
    }
</div>

<!-- Schedule Configuration Dialog -->
<QModal @bind-Visible="showScheduleDialog" Title="@($"Configure Schedule - {selectedPlaylist?.Name}")" Size="md">
    <ChildContent>
        <div class="form-group">
            <label class="form-label">Schedule Type</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="scheduleType" id="schedule-always" value="always" checked="@(scheduleModel.ScheduleType == "always")" @onchange="@(() => scheduleModel.ScheduleType = "always")" />
                <label class="form-check-label" for="schedule-always">Always (plays continuously)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="scheduleType" id="schedule-scheduled" value="scheduled" checked="@(scheduleModel.ScheduleType == "scheduled")" @onchange="@(() => scheduleModel.ScheduleType = "scheduled")" />
                <label class="form-check-label" for="schedule-scheduled">Scheduled (time-based)</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="scheduleType" id="schedule-conditional" value="conditional" checked="@(scheduleModel.ScheduleType == "conditional")" @onchange="@(() => scheduleModel.ScheduleType = "conditional")" />
                <label class="form-check-label" for="schedule-conditional">Conditional (rule-based)</label>
            </div>
        </div>

        @if (scheduleModel.ScheduleType == "scheduled")
        {
            <div class="schedule-config">
                <h4>Time Schedule</h4>
                <div class="form-group">
                    <label class="form-label">Active Days</label>
                    <div class="days-selector">
                        @foreach (var day in daysOfWeek)
                        {
                            <QCheckbox @bind-Value="@scheduleModel.ActiveDays[day]" Label="@day.Substring(0, 3)" />
                        }
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Start Time</label>
                        <QDatePicker @bind-Value="@scheduleModel.StartTime" ShowTime="true" Style="width: 100%;" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">End Time</label>
                        <QDatePicker @bind-Value="@scheduleModel.EndTime" ShowTime="true" Style="width: 100%;" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Start Date (Optional)</label>
                        <QDatePicker @bind-Value="@scheduleModel.StartDate" Style="width: 100%;" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">End Date (Optional)</label>
                        <QDatePicker @bind-Value="@scheduleModel.EndDate" Style="width: 100%;" />
                    </div>
                </div>
            </div>
        }

        @if (scheduleModel.ScheduleType == "conditional")
        {
            <div class="schedule-config">
                <h4>Conditional Rules</h4>
                <div class="form-group">
                    <QSelect TValue="string" TItem="string" @bind-Value="@scheduleModel.ConditionType" Items="@conditionTypes" Label="Condition Type" />
                </div>
                <div class="form-group">
                    <QInput TValue="string" @bind-Value="@scheduleModel.ConditionValue" Placeholder="e.g., queue_count > 10" Label="Condition Value" />
                </div>
                <p class="help-text">
                    Conditional schedules trigger based on system events like queue length, time of day, or custom triggers.
                </p>
            </div>
        }

        <div class="form-group">
            <QInput TValue="int" @bind-Value="@scheduleModel.Priority" Type="number" Label="Priority (higher = more important)" Min="1" Max="100" />
        </div>
    </ChildContent>
    <FooterContent>
        <QButton Text="Cancel" Icon="x-lg" Variant="secondary" OnClick="@CloseDialog" />
        <QButton Text="Save Schedule" Icon="check-lg" Variant="primary" OnClick="@SaveSchedule" />
    </FooterContent>
</QModal>

