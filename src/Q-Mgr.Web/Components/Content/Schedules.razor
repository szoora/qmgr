@code {
    /// <summary>True when the Signage hub is hosting this page inside its own tab strip: the host
    /// then owns the page title, the header band and the tabs. There is no route to reach this
    /// component any other way — see CLAUDE.md, "A hub owns the route; its sections own nothing".</summary>
    [Parameter] public bool Embedded { get; set; }

    private List<PlaylistDetailDto> playlists = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string? filterScheduleType;

    private bool canEdit = false;

    private bool showScheduleDialog = false;
    private PlaylistDetailDto? selectedPlaylist;
    private ScheduleEditModel scheduleModel = new();

    private Guid branchId = Guid.Empty; // resolved from BranchState; no demo-branch fallback

    private List<string> scheduleTypeOptions = new() { "always", "scheduled", "conditional" };
    private List<string> conditionTypes = new() { "queue_length", "time_of_day", "day_of_week", "custom" };
    private List<string> daysOfWeek = new() { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };

    private IEnumerable<PlaylistDetailDto> FilteredPlaylists => playlists
        .Where(p => string.IsNullOrEmpty(searchTerm) || p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(filterScheduleType) || p.ScheduleType == filterScheduleType);

    // ---- Paging (list-page sweep, plan Phase 2) --------------------------------------------
    // Every row here is a component subtree Blazor Server diffs and ships down the circuit, so
    // a page of them is drawn rather than the whole list.
    private const int PageSize = 24;
    private int pageIndex;
    private int SafePageIndex => Math.Min(pageIndex, Math.Max(0, (FilteredPlaylists.Count() - 1) / PageSize));
    private IEnumerable<PlaylistDetailDto> PagedPlaylists => FilteredPlaylists.Skip(SafePageIndex * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        // Check permission
        if (!await PermissionService.HasPermissionAsync(Permissions.ContentView))
        {
            NavigationManager.NavigateTo("/unauthorized", forceLoad: true);
            return;
        }

        await ModuleState.LoadAsync(ModuleApi);
        if (ModuleState.LoadSucceeded && !ModuleState.ActiveModuleCodes.Contains(ModuleCodes.EngagementCommunications))
        {
            NavigationManager.NavigateTo(BillingLinks.Modules, forceLoad: false);
            return;
        }

        await BranchState.InitializeAsync();
        if (BranchState.CurrentBranchId != Guid.Empty)
        {
            branchId = BranchState.CurrentBranchId;
        }

        canEdit = await PermissionService.HasPermissionAsync(Permissions.ContentEdit);

        await LoadPlaylists();
    }

    private void GoToPlaylists()
    {
        NavigationManager.NavigateTo("/content/signage?tab=playlists");
    }

    private async Task LoadPlaylists()
    {
        isLoading = true;
        var basicPlaylists = await ContentApi.GetPlaylistsAsync(branchId);

        // Load detailed playlist info for each
        playlists = new List<PlaylistDetailDto>();
        foreach (var p in basicPlaylists)
        {
            var detail = await ContentApi.GetPlaylistAsync(p.Id);
            if (detail != null)
            {
                playlists.Add(detail);
            }
        }

        isLoading = false;
    }

    private void ShowScheduleDialog(PlaylistDetailDto playlist)
    {
        selectedPlaylist = playlist;
        scheduleModel = ParseScheduleModel(playlist);
        showScheduleDialog = true;
    }

    private void CloseDialog()
    {
        showScheduleDialog = false;
        selectedPlaylist = null;
    }

    private async Task SaveSchedule()
    {
        if (selectedPlaylist == null) return;

        var schedule = BuildScheduleJson();
        var request = new UpdatePlaylistRequest
        {
            ScheduleType = scheduleModel.ScheduleType,
            Schedule = schedule
        };

        var result = await ContentApi.UpdatePlaylistAsync(selectedPlaylist.Id, request);
        if (result != null)
        {
            NotificationService.Notify(ToastSeverity.Success, "Success", "Schedule updated successfully.");
            showScheduleDialog = false;
            await LoadPlaylists();
        }
        else
        {
            NotificationService.Notify(ToastSeverity.Error, "Error", "Failed to update schedule.");
        }
    }

    private ScheduleEditModel ParseScheduleModel(PlaylistDetailDto playlist)
    {
        var model = new ScheduleEditModel
        {
            ScheduleType = playlist.ScheduleType,
            Priority = 1
        };

        // Initialize all days as active by default
        foreach (var day in daysOfWeek)
        {
            model.ActiveDays[day] = true;
        }

        // Try to parse existing schedule JSON
        if (!string.IsNullOrEmpty(playlist.Schedule))
        {
            try
            {
                // Parse schedule JSON here if needed
                // For now, just use defaults
            }
            catch { }
        }

        return model;
    }

    private string BuildScheduleJson()
    {
        if (scheduleModel.ScheduleType == "always")
        {
            return "{}";
        }
        else if (scheduleModel.ScheduleType == "scheduled")
        {
            var activeDays = scheduleModel.ActiveDays.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
            var schedule = new
            {
                days = activeDays,
                startTime = scheduleModel.StartTime?.ToString("HH:mm"),
                endTime = scheduleModel.EndTime?.ToString("HH:mm"),
                startDate = scheduleModel.StartDate?.ToString("yyyy-MM-dd"),
                endDate = scheduleModel.EndDate?.ToString("yyyy-MM-dd"),
                priority = scheduleModel.Priority
            };
            return System.Text.Json.JsonSerializer.Serialize(schedule);
        }
        else if (scheduleModel.ScheduleType == "conditional")
        {
            var schedule = new
            {
                conditionType = scheduleModel.ConditionType,
                conditionValue = scheduleModel.ConditionValue,
                priority = scheduleModel.Priority
            };
            return System.Text.Json.JsonSerializer.Serialize(schedule);
        }

        return "{}";
    }

    private string GetScheduleBadgeStyle(string scheduleType) => scheduleType switch
    {
        "always" => "success",
        "scheduled" => "primary",
        "conditional" => "warning",
        _ => "light"
    };

    private string GetScheduleTypeLabel(string scheduleType) => scheduleType switch
    {
        "always" => "Always Active",
        "scheduled" => "Scheduled",
        "conditional" => "Conditional",
        _ => scheduleType
    };

    private string FormatSchedule(string? schedule)
    {
        if (string.IsNullOrEmpty(schedule) || schedule == "{}") return "Not configured";

        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(schedule);
            var root = doc.RootElement;

            if (root.TryGetProperty("days", out var days) && root.TryGetProperty("startTime", out var startTime))
            {
                var daysList = days.EnumerateArray().Select(d => d.GetString()?.Substring(0, 3)).ToList();
                var daysStr = string.Join(", ", daysList);
                var timeStr = startTime.GetString();

                if (root.TryGetProperty("endTime", out var endTime))
                {
                    timeStr += " - " + endTime.GetString();
                }

                return $"{daysStr} @ {timeStr}";
            }

            if (root.TryGetProperty("conditionType", out var condType))
            {
                var condValue = root.TryGetProperty("conditionValue", out var cv) ? cv.GetString() : "";
                return $"{condType.GetString()}: {condValue}";
            }
        }
        catch { }

        return "Custom schedule";
    }

    private sealed record ScheduleSlot(PlaylistDetailDto Playlist, string Day, string Band);

    private IReadOnlyList<QWeekGridColumn> WeekColumns => daysOfWeek
        .Select(d => new QWeekGridColumn(d, d[..3], IsToday: d == DateTime.Today.DayOfWeek.ToString())).ToList();

    private static readonly IReadOnlyList<QWeekGridRow> WeekRows = Enumerable.Range(0, 8)
        .Select(i => new QWeekGridRow($"b{i}", $"{i * 3:00}:00", $"to {(i + 1) * 3:00}:00")).ToList();

    private IEnumerable<ScheduleSlot> WeekItems => playlists.Where(p => p.ScheduleType == "scheduled")
        .SelectMany(p => daysOfWeek.SelectMany(day => BandsFor(p, day).Select(b => new ScheduleSlot(p, day, $"b{b}"))));

    private QWeekGridCellState OverlapState(QWeekGridSlot slot)
        => WeekItems.Count(x => x.Day == slot.ColumnKey && x.Band == slot.RowKey) > 1 ? QWeekGridCellState.Warning : QWeekGridCellState.None;

    private string? OverlapTitle(QWeekGridCell<ScheduleSlot> cell)
        => cell.Items.Count > 1 ? $"{cell.Items.Count} playlists overlap here; the one with the higher priority plays." : null;

    /// <summary>The three-hour bands a playlist's schedule touches on a day. An overnight schedule (end before start) wraps.</summary>
    private static List<int> BandsFor(PlaylistDetailDto playlist, string day)
    {
        var bands = new List<int>();
        if (!TryReadSchedule(playlist.Schedule, day, out var start, out var end)) return bands;
        var spans = end > start ? new[] { (start, end) } : new[] { (start, TimeSpan.FromHours(24)), (TimeSpan.Zero, end) };
        for (var band = 0; band < 8; band++)
        {
            var bandStart = TimeSpan.FromHours(band * 3);
            var bandEnd = TimeSpan.FromHours((band + 1) * 3);
            if (spans.Any(x => x.Item1 < bandEnd && x.Item2 > bandStart)) bands.Add(band);
        }
        return bands;
    }

    /// <summary>Whether the schedule JSON runs on the day, and between which times.</summary>
    private static bool TryReadSchedule(string? json, string day, out TimeSpan start, out TimeSpan end)
    {
        start = end = TimeSpan.Zero;
        if (string.IsNullOrEmpty(json) || json == "{}") return false;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("days", out var days) && !days.EnumerateArray().Select(d => d.GetString()).Contains(day)) return false;
            if (!root.TryGetProperty("startTime", out var st) || !root.TryGetProperty("endTime", out var et)) return false;
            start = TimeSpan.Parse(st.GetString() ?? "00:00", System.Globalization.CultureInfo.InvariantCulture);
            end = TimeSpan.Parse(et.GetString() ?? "23:59", System.Globalization.CultureInfo.InvariantCulture);
            return true;
        }
        catch { return false; }
    }

    private class ScheduleEditModel
    {
        public string ScheduleType { get; set; } = "always";
        public Dictionary<string, bool> ActiveDays { get; set; } = new();
        public DateTime? StartTime { get; set; } = DateTime.Today.AddHours(8);
        public DateTime? EndTime { get; set; } = DateTime.Today.AddHours(18);
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string? ConditionType { get; set; }
        public string? ConditionValue { get; set; }
        public int Priority { get; set; } = 1;
    }


    /// <summary>
    /// Subscribe to branch changes. In OnAfterRenderAsync and not OnInitializedAsync on purpose:
    /// branch and auth state are read from localStorage over JS interop, which does not exist
    /// during prerendering and races an uninitialised store on a cold navigation.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await BranchState.InitializeAsync();
        TrackBranch();
    }

    /// <summary>
    /// The branch changed under the page. Without this the page keeps whatever branch it first
    /// read — for a SuperAdmin that is Guid.Empty, which the API answers 404, so the page renders
    /// an empty list with no explanation until the reader reloads by hand.
    /// </summary>
    protected override async Task OnBranchChangedAsync(Guid branchId)
    {
        this.branchId = branchId;
