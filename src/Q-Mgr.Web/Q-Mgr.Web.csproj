<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>QMgr.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 8.x -> 11.x is 3 major versions; researched changelog (ARIA/semantic-HTML
         rendering changes) before bumping. Needs a visual QA pass on Radzen-heavy
         screens (dialogs/notifications/forms) after upgrading, not just a clean build. -->
    <PackageReference Include="Radzen.Blazor" Version="11.2.5" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Q-Mgr.Shared\Q-Mgr.Shared.csproj" />
  </ItemGroup>

</Project>
