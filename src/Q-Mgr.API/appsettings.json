    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/v1/*/tokens",
        "Period": "1m",
        "Limit": 50
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
