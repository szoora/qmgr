# Copy to `.env` in this same directory and fill in real values before any
# non-local deployment. docker-compose reads `.env` automatically.
#
# Generate a real JWT secret with e.g.: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
# Set to Production for any real deployment. Development mode bypasses the
# API's own placeholder-secret rejection check and enables verbose error
# pages that leak stack traces.
ASPNETCORE_ENVIRONMENT=Production
